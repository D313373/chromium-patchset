+async function loadExistingSecretKeys(dashboardHandler) {
+  if (!dashboardHandler?.getDataSecrets) {
+    return [];
+  }
+  const res = await dashboardHandler.getDataSecrets();
+  return Array.isArray(res?.secrets) ?
+      res.secrets.map((entry) => String(entry?.key || '').trim()).filter(Boolean) :
+      [];
+}
+
+async function upsertSecrets(dashboardHandler, secretEntries) {
+  if (!dashboardHandler?.saveDataSecrets) {
+    throw new Error('Secrets API unavailable');
+  }
+  const existing = await dashboardHandler.getDataSecrets?.() ?? {secrets: []};
+  const keys = new Set(
+      (existing.secrets || []).map((entry) => String(entry?.key || '').trim())
+          .filter(Boolean));
+  const updates = [];
+  for (const entry of secretEntries) {
+    const key = String(entry?.key || '').trim();
+    const value = String(entry?.value ?? '');
+    if (!key || !value.trim()) {
+      continue;
+    }
+    keys.add(key);
+    updates.push({key, value});
+  }
+  if (!updates.length) {
+    return {ok: false, error: 'No secret values to save'};
+  }
+  return dashboardHandler.saveDataSecrets({
+    keys: Array.from(keys).sort((a, b) => a.localeCompare(b)),
+    updates,
+  });
+}
+
+function collectPlanFromModal(modal, plan) {
+  const rows = modal.querySelectorAll('.export-secret-name');
+  const used = new Set();
+  const out = [];
+  rows.forEach((input) => {
+    const index = Number(input.dataset.planIndex);
+    const entry = plan[index];
+    if (!entry) {
+      return;
+    }
+    let secretName = String(input.value || '').trim()
+        .replace(/[{}]/g, '')
+        .replace(/[^A-Za-z0-9_#.-]+/g, '');
+    if (!secretName) {
+      secretName = entry.secretName;
+    }
+    let candidate = secretName;
+    let suffix = 2;
+    while (used.has(candidate)) {
+      candidate = `${secretName}${suffix++}`;
+    }
+    used.add(candidate);
+    out.push({
+      secretName: candidate,
+      literal: entry.literal,
+      token: `{${candidate}}`,
+      actionPaths: entry.actionPaths,
+    });
+  });
+  return out;
+}
+
+function buildReplacementsFromPlan(plan) {
+  const replacements = [];
+  for (const entry of plan) {
+    for (const actionPath of entry.actionPaths || []) {
+      replacements.push({
+        actionPath,
+        secretName: entry.secretName,
+        literal: entry.literal,
+      });
+    }
+  }
+  return replacements;
+}
