diff --git a/chrome/browser/resources/dashboard/agent/script_export.js b/chrome/browser/resources/dashboard/agent/script_export.js
new file mode 100644
index 0000000000000..e6949c38e426e
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/script_export.js
@@ -0,0 +1,158 @@
+import {
+  extractTokenReferencesFromScript,
+  scanScriptForExportRisks,
+} from './script_export_guard.js';
+
+function sanitizeFilename(name) {
+  const cleaned = String(name || 'script')
+      .trim()
+      .replace(/[^\w.-]+/g, '_')
+      .replace(/_+/g, '_')
+      .replace(/^_+|_+$/g, '');
+  return cleaned || 'script';
+}
+
+function stripInternalScriptFields(script) {
+  const clone = JSON.parse(JSON.stringify(script || {}));
+  delete clone.__localUnsavedChanges;
+  delete clone.__agent_next_insert_index;
+  return clone;
+}
+
+export function buildScriptExportPackage(script, scriptId, meta = {}) {
+  const cleanedScript = stripInternalScriptFields(script);
+  return {
+    format: 'simulachrome.script-package',
+    version: 1,
+    exportedAt: new Date().toISOString(),
+    scriptId: scriptId || null,
+    name: cleanedScript.name || 'script',
+    script: cleanedScript,
+    requiredTokens: extractTokenReferencesFromScript(cleanedScript),
+    exportRiskAcknowledged: !!meta.exportRiskAcknowledged,
+  };
+}
+
+export function downloadScriptPackage(pkg, filename) {
+  const safeName = sanitizeFilename(filename);
+  const blob = new Blob([JSON.stringify(pkg, null, 2)], {
+    type: 'application/json',
+  });
+  const url = URL.createObjectURL(blob);
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = safeName.endsWith('.json') ? safeName :
+      `${safeName}.simulachrome.json`;
+  anchor.click();
+  URL.revokeObjectURL(url);
+}
+
+function formatFindingReason(reason) {
+  switch (reason) {
+    case 'email':
+      return 'email address';
+    case 'phone_number':
+      return 'phone number';
+    case 'ssn':
+      return 'SSN';
+    case 'api_key':
+      return 'API key';
+    case 'high_entropy_secret':
+      return 'secret-like value';
+    case 'password_field_literal':
+      return 'password/credential field literal';
+    default:
+      return reason;
+  }
+}
+
+function renderFindingsList(findings) {
+  return findings.map((finding) => {
+    const reasons = (finding.reasons || [])
+        .map((reason) => formatFindingReason(reason))
+        .join(', ');
+    return `<li><strong>${finding.path}</strong>: ${reasons} ` +
+        `(preview: <code>${finding.textPreview || '…'}</code>)</li>`;
+  }).join('');
+}
+
+export function promptScriptExport({
+  script,
+  scriptId,
+  documentRef = document,
+  modalId = 'export-script-modal',
+}) {
+  const scan = scanScriptForExportRisks(script);
+  const defaultName = sanitizeFilename(script?.name || scriptId || 'script');
+
+  if (!scan.hasRisks) {
+    const pkg = buildScriptExportPackage(script, scriptId);
+    downloadScriptPackage(pkg, `${defaultName}.simulachrome.json`);
+    return Promise.resolve({ok: true, exported: true, acknowledged: false});
+  }
+
+  return new Promise((resolve) => {
+    let modal = documentRef.getElementById(modalId);
+    if (!modal) {
+      modal = documentRef.createElement('div');
+      modal.id = modalId;
+      modal.className = 'modal-overlay hidden';
+      documentRef.body.appendChild(modal);
+    }
+
+    modal.innerHTML = `
+      <div class="modal-content" style="max-width: 720px;">
+        <h3 class="modal-header">Sensitive data in export</h3>
+        <p>
+          This script contains type actions with values that look like PII or
+          credentials. Before sharing, replace them with secret tokens such as
+          <code>{MyPassword}</code> in Data &gt; Secrets.
+        </p>
+        <ul class="export-risk-list" style="margin: 12px 0 16px 20px;">
+          ${renderFindingsList(scan.findings)}
+        </ul>
+        <label style="display:flex; gap:8px; align-items:flex-start;">
+          <input type="checkbox" id="export-risk-ack" />
+          <span>OK, I understand I'm sharing this info. It's intentional.</span>
+        </label>
+        <div class="modal-actions" style="margin-top: 16px;">
+          <button class="btn" id="export-risk-cancel">Cancel</button>
+          <button class="btn btn-primary" id="export-risk-confirm" disabled>
+            Export anyway
+          </button>
+        </div>
+      </div>
+    `;
+
+    const ack = modal.querySelector('#export-risk-ack');
+    const confirmBtn = modal.querySelector('#export-risk-confirm');
+    const cancelBtn = modal.querySelector('#export-risk-cancel');
+
+    const cleanup = (result) => {
+      modal.classList.add('hidden');
+      modal.innerHTML = '';
+      resolve(result);
+    };
+
+    ack?.addEventListener('change', () => {
+      if (confirmBtn) {
+        confirmBtn.disabled = !ack.checked;
+      }
+    });
+    cancelBtn?.addEventListener('click', () => {
+      cleanup({ok: false, exported: false, cancelled: true});
+    });
+    confirmBtn?.addEventListener('click', () => {
+      if (!ack?.checked) {
+        return;
+      }
+      const pkg = buildScriptExportPackage(script, scriptId, {
+        exportRiskAcknowledged: true,
+      });
+      downloadScriptPackage(pkg, `${defaultName}.simulachrome.json`);
+      cleanup({ok: true, exported: true, acknowledged: true});
+    });
+
+    modal.classList.remove('hidden');
+  });
+}
diff --git a/chrome/browser/resources/dashboard/agent/script_export_guard.js b/chrome/browser/resources/dashboard/agent/script_export_guard.js
new file mode 100644
index 0000000000000..7e3fb258c4800
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/script_export_guard.js
@@ -0,0 +1,221 @@
+import {
+  flattenActionsFromUrlContexts,
+  getKeyDownNestedList,
+  getLoopStepsList,
+  getNestedActionList,
+} from './dashboard_script_state.js';
+
+const TOKEN_ONLY_RE = /^\{[^{}]+\}$/;
+const EMAIL_RE = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i;
+const PHONE_RE =
+    /(?:\+?1[-.\s]?)?(?:\(?\d{3}\)?[-.\s]?)\d{3}[-.\s]?\d{4}\b/;
+const SSN_RE = /\b\d{3}-\d{2}-\d{4}\b/;
+const API_KEY_RE =
+    /\b(?:sk-[A-Za-z0-9]{10,}|ghp_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z\-_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})\b/;
+const HIGH_ENTROPY_RE = /\b[A-Za-z0-9+/=_-]{24,}\b/;
+
+function normalizeActionKind(action) {
+  const kind = String(action?.action || action?.type || '').trim().toLowerCase();
+  if (kind === 'cdp_type') {
+    return 'type';
+  }
+  return kind;
+}
+
+function readActionParams(action) {
+  if (action?.params && typeof action.params === 'object') {
+    return action.params;
+  }
+  return action || {};
+}
+
+function isTokenReference(text) {
+  return TOKEN_ONLY_RE.test(String(text || '').trim());
+}
+
+function locatorsSuggestPassword(locators) {
+  for (const locator of locators || []) {
+    if (!locator || typeof locator !== 'object') {
+      continue;
+    }
+    const type = String(locator.type || '').toUpperCase();
+    const value = String(locator.value || '').toLowerCase();
+    if (!value) {
+      continue;
+    }
+    if (value.includes('password') || value.includes('passwd') ||
+        value.includes('credential') || value.includes('api_key') ||
+        value.includes('apikey') || value.includes('secret') ||
+        value.includes('token')) {
+      return true;
+    }
+    if ((type === 'ID' || type === 'NAME') &&
+        (value.includes('pass') || value.includes('pwd'))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+function redactPreview(text) {
+  const value = String(text || '');
+  if (!value) {
+    return '';
+  }
+  if (value.length <= 4) {
+    return '****';
+  }
+  return `${value.slice(0, 2)}…${value.slice(-1)}`;
+}
+
+function classifySensitiveTypeText(text, locators) {
+  const value = String(text || '');
+  if (!value.trim() || isTokenReference(value)) {
+    return null;
+  }
+
+  const reasons = [];
+  if (EMAIL_RE.test(value)) {
+    reasons.push('email');
+  }
+  if (PHONE_RE.test(value)) {
+    reasons.push('phone_number');
+  }
+  if (SSN_RE.test(value)) {
+    reasons.push('ssn');
+  }
+  if (API_KEY_RE.test(value)) {
+    reasons.push('api_key');
+  }
+  if (HIGH_ENTROPY_RE.test(value) && !EMAIL_RE.test(value)) {
+    reasons.push('high_entropy_secret');
+  }
+  if (locatorsSuggestPassword(locators)) {
+    reasons.push('password_field_literal');
+  }
+
+  if (!reasons.length) {
+    return null;
+  }
+
+  return {
+    reasons,
+    textPreview: redactPreview(value),
+    suggestion:
+        'Replace this literal with a secret token like {MyPassword} and store ' +
+        'the value in Data > Secrets.',
+  };
+}
+
+function collectScriptActions(script) {
+  const actions = [];
+  if (!script || typeof script !== 'object') {
+    return actions;
+  }
+  if (Array.isArray(script.actions) && script.actions.length) {
+    actions.push(...script.actions);
+  } else if (Array.isArray(script.url_contexts)) {
+    actions.push(...flattenActionsFromUrlContexts(script.url_contexts));
+  }
+  return actions.filter((action) => action && typeof action === 'object');
+}
+
+function visitNestedActions(action, visitFn) {
+  const kind = normalizeActionKind(action);
+  if (kind === 'if_condition') {
+    for (const child of getNestedActionList(action, 'then') || []) {
+      visitFn(child);
+    }
+    for (const child of getNestedActionList(action, 'else') || []) {
+      visitFn(child);
+    }
+    return;
+  }
+  if (kind === 'loop') {
+    for (const child of getLoopStepsList(action) || []) {
+      visitFn(child);
+    }
+    return;
+  }
+  if (kind === 'key_down' || kind === 'key') {
+    for (const child of getKeyDownNestedList(action) || []) {
+      visitFn(child);
+    }
+  }
+}
+
+export function scanScriptForExportRisks(script) {
+  const findings = [];
+  const actions = collectScriptActions(script);
+
+  const visit = (action, pathLabel) => {
+    if (!action || typeof action !== 'object') {
+      return;
+    }
+    const kind = normalizeActionKind(action);
+    const params = readActionParams(action);
+
+    if (kind === 'type') {
+      const text = String(params.text || action.text || '');
+      const locators = params.locators || action.locators || [];
+      const classified = classifySensitiveTypeText(text, locators);
+      if (classified) {
+        findings.push({
+          action: 'type',
+          path: pathLabel,
+          ...classified,
+        });
+      }
+    }
+
+    visitNestedActions(action, (child) => {
+      visit(child, `${pathLabel} > ${normalizeActionKind(child) || 'action'}`);
+    });
+  };
+
+  actions.forEach((action, index) => {
+    const label = `step ${index + 1}: ${normalizeActionKind(action) || 'action'}`;
+    visit(action, label);
+  });
+
+  return {
+    findings,
+    hasRisks: findings.length > 0,
+  };
+}
+
+export function extractTokenReferencesFromValue(value, out = new Set()) {
+  if (value == null) {
+    return out;
+  }
+  if (typeof value === 'string') {
+    const matches = value.matchAll(/\{([^{}]+)\}/g);
+    for (const match of matches) {
+      const token = String(match[1] || '').trim();
+      if (token) {
+        out.add(token);
+      }
+    }
+    return out;
+  }
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      extractTokenReferencesFromValue(item, out);
+    }
+    return out;
+  }
+  if (typeof value === 'object') {
+    for (const nested of Object.values(value)) {
+      extractTokenReferencesFromValue(nested, out);
+    }
+  }
+  return out;
+}
+
+export function extractTokenReferencesFromScript(script) {
+  const clone = JSON.parse(JSON.stringify(script || {}));
+  delete clone.__localUnsavedChanges;
+  delete clone.__agent_next_insert_index;
+  return Array.from(extractTokenReferencesFromValue(clone)).sort((a, b) =>
+    a.localeCompare(b));
+}
