+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_EXECUTION_RUN_CONTEXT_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_EXECUTION_RUN_CONTEXT_H_
+
+namespace dashboard {
+
+// Thread-local run flags for the active ScriptExecutor run. Script mode keeps
+// locator-only resolution; agent mode enables APC/page-map pipelines.
+class ExecutionRunContext {
+ public:
+  static ExecutionRunContext& Get();
+
+  void Set(bool is_agent_mode, bool force_native_execution);
+  void Clear();
+
+  bool is_agent_mode() const { return is_agent_mode_; }
+  bool force_native_execution() const { return force_native_execution_; }
+
+  bool ShouldUseUnifiedPageMap() const { return is_agent_mode_; }
+
+  ExecutionRunContext() = default;
+  ~ExecutionRunContext() = default;
+
+ private:
+
+  bool is_agent_mode_ = false;
+  bool force_native_execution_ = false;
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_EXECUTION_RUN_CONTEXT_H_
diff --git a/chrome/browser/ui/webui/dashboard/native_run_activation.cc b/chrome/browser/ui/webui/dashboard/native_run_activation.cc
new file mode 100644
index 0000000000000..20664ac85585e
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/native_run_activation.cc
@@ -0,0 +1,42 @@
+#include "chrome/browser/ui/webui/dashboard/native_run_activation.h"
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_finder.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "content/public/browser/web_contents.h"
+
+namespace dashboard {
+
+void ActivateWebContentsForNativeScriptRun(content::WebContents* web_contents) {
+  if (!web_contents) {
+    return;
+  }
+
+  web_contents->Focus();
+
+  Browser* browser = chrome::FindBrowserWithTab(web_contents);
+  if (!browser) {
+    return;
+  }
+
+  TabStripModel* tabs = browser->tab_strip_model();
+  if (tabs) {
+    const int index = tabs->GetIndexOfWebContents(web_contents);
+    if (index >= 0 && tabs->GetActiveWebContents() != web_contents) {
+      tabs->ActivateTabAt(index);
+    }
+  }
+
+  if (BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser)) {
+    if (browser_view->GetWidget()) {
+      browser_view->GetWidget()->Activate();
+      return;
+    }
+  }
+  if (browser->window()) {
+    browser->window()->Activate();
+  }
+}
+
+}  // namespace dashboard
