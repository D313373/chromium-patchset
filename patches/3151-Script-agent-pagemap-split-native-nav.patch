+#!/usr/bin/env python3
+"""Bridge isolated headless Chromium to native ScriptExecutionService.
+
+The headless browser process loads chrome://dashboard and exposes the same C++
+ScriptExecutionService as the headed instance. This module connects over CDP and
+invokes dashboardAgentRunTimeline / dashboardAgentRefreshPageMap instead of the
+legacy Python CDP DOM shim.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import socket
+import struct
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Dict, List, Optional
+
+DEFAULT_CDP_PORT = 9222
+DEFAULT_DASHBOARD_URL = "chrome://dashboard"
+
+
+def use_native_executor() -> bool:
+  raw = str(os.environ.get("SIMULACHROME_HEADLESS_USE_NATIVE_EXECUTOR", "1")
+            or "1").strip().lower()
+  return raw not in ("0", "false", "no", "off", "legacy")
+
+
+class WebSocketCDP:
+  """Minimal stdlib CDP websocket client."""
+
+  def __init__(self, ws_url: str, timeout: float = 30.0):
+    self._sock: Optional[socket.socket] = None
+    self._timeout = timeout
+    self._next_id = 1
+    self._connect(ws_url)
+
+  def _connect(self, ws_url: str) -> None:
+    parts = urllib.parse.urlparse(ws_url)
+    host = parts.hostname or "127.0.0.1"
+    port = parts.port or 80
+    path = parts.path or "/"
+    if parts.query:
+      path += "?" + parts.query
+
+    sock = socket.create_connection((host, port), timeout=self._timeout)
+    sock.settimeout(self._timeout)
+    key = os.urandom(16)
+    key_b64 = __import__("base64").b64encode(key).decode("ascii")
+    req = (
+        f"GET {path} HTTP/1.1\r\n"
+        f"Host: {host}:{port}\r\n"
+        "Upgrade: websocket\r\n"
+        "Connection: Upgrade\r\n"
+        f"Sec-WebSocket-Key: {key_b64}\r\n"
+        "Sec-WebSocket-Version: 13\r\n"
+        "\r\n"
+    ).encode("utf-8")
+    sock.sendall(req)
+    data = bytearray()
+    while b"\r\n\r\n" not in data:
+      chunk = sock.recv(4096)
+      if not chunk:
+        break
+      data.extend(chunk)
+    if b" 101 " not in data.splitlines()[0]:
+      raise RuntimeError(f"WebSocket handshake failed: {bytes(data)[:200]!r}")
+    self._sock = sock
+
+  def close(self) -> None:
+    if self._sock is not None:
+      try:
+        self._sock.close()
+      except OSError:
+        pass
+      self._sock = None
+
+  def _read_exact(self, n: int) -> bytes:
+    if self._sock is None:
+      raise RuntimeError("WebSocket closed")
+    out = bytearray()
+    while len(out) < n:
+      chunk = self._sock.recv(n - len(out))
+      if not chunk:
+        raise RuntimeError("WebSocket closed while reading")
+      out.extend(chunk)
+    return bytes(out)
+
+  def _send_text(self, text: str) -> None:
+    if self._sock is None:
+      raise RuntimeError("WebSocket closed")
+    payload = text.encode("utf-8")
+    header = bytearray([0x81])
+    length = len(payload)
+    if length < 126:
+      header.append(0x80 | length)
+    elif length <= 0xFFFF:
+      header.append(0x80 | 126)
+      header.extend(struct.pack("!H", length))
+    else:
+      header.append(0x80 | 127)
+      header.extend(struct.pack("!Q", length))
+    mask = os.urandom(4)
+    header.extend(mask)
+    masked = bytearray(payload)
+    for i in range(length):
+      masked[i] ^= mask[i % 4]
+    self._sock.sendall(bytes(header) + bytes(masked))
+
+  def _recv_frame(self) -> bytes:
+    b1, b2 = self._read_exact(2)
+    opcode = b1 & 0x0F
+    masked = (b2 & 0x80) != 0
+    length = b2 & 0x7F
+    if length == 126:
+      length = struct.unpack("!H", self._read_exact(2))[0]
+    elif length == 127:
+      length = struct.unpack("!Q", self._read_exact(8))[0]
+    if masked:
+      mask = self._read_exact(4)
+    else:
+      mask = b""
+    payload = bytearray(self._read_exact(length))
+    if masked:
+      for i in range(length):
+        payload[i] ^= mask[i % 4]
+    if opcode == 0x8:
+      raise RuntimeError("WebSocket closed")
+    if opcode == 0x9:
+      return self._recv_frame()
+    if opcode != 0x1:
+      return self._recv_frame()
+    return bytes(payload)
+
+  def call(self, method: str, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
+    msg_id = self._next_id
+    self._next_id += 1
+    self._send_text(json.dumps({
+        "id": msg_id,
+        "method": method,
+        "params": params or {},
+    }))
+    while True:
+      raw = self._recv_frame().decode("utf-8", errors="replace")
+      payload = json.loads(raw)
+      if payload.get("id") != msg_id:
+        continue
+      if "error" in payload:
+        raise RuntimeError(
+            f"CDP {method} failed: {json.dumps(payload['error'], ensure_ascii=True)}")
+      return payload.get("result") or {}
+
+
+def _http_json(port: int, path: str, method: str = "GET") -> Any:
+  url = f"http://127.0.0.1:{port}{path}"
+  req = urllib.request.Request(url, method=method)
+  with urllib.request.urlopen(req, timeout=10.0) as resp:
+    return json.loads(resp.read().decode("utf-8"))
+
+
+def _wait_for_devtools(port: int, timeout_sec: float) -> None:
+  deadline = time.time() + max(1.0, timeout_sec)
+  last_error: Optional[Exception] = None
+  while time.time() < deadline:
+    try:
+      version = _http_json(port, "/json/version")
+      if version.get("webSocketDebuggerUrl"):
+        return
+    except Exception as exc:
+      last_error = exc
+    time.sleep(0.25)
+  raise RuntimeError(f"DevTools port {port} not ready: {last_error}")
+
+
+def _browser_ws_url(port: int) -> str:
+  version = _http_json(port, "/json/version")
+  ws = str(version.get("webSocketDebuggerUrl") or "")
+  if not ws:
+    raise RuntimeError("Missing browser webSocketDebuggerUrl")
+  return ws
+
+
+def _list_targets(port: int) -> List[Dict[str, Any]]:
+  targets = _http_json(port, "/json/list")
+  return targets if isinstance(targets, list) else []
+
+
+def _find_target(port: int, url_prefix: str) -> Optional[str]:
+  for target in _list_targets(port):
+    url = str(target.get("url") or "")
+    if url.startswith(url_prefix):
+      return str(target.get("id") or "")
+  return None
+
+
+def _target_ws_url(port: int, target_id: str, timeout_sec: float = 15.0) -> str:
+  deadline = time.time() + max(1.0, timeout_sec)
+  while time.time() < deadline:
+    for target in _list_targets(port):
+      if target.get("id") == target_id and target.get("webSocketDebuggerUrl"):
+        return str(target["webSocketDebuggerUrl"])
+    time.sleep(0.1)
+  raise RuntimeError(f"Target websocket not ready for {target_id}")
+
+
+def _create_target(port: int, url: str) -> str:
+  browser = WebSocketCDP(_browser_ws_url(port), timeout=15.0)
+  try:
+    result = browser.call("Target.createTarget", {"url": url})
+  finally:
+    browser.close()
+  target_id = str(result.get("targetId") or "")
+  if not target_id:
+    raise RuntimeError("Target.createTarget returned empty targetId")
+  return target_id
+
+
+def _activate_target(port: int, target_id: str) -> None:
+  browser = WebSocketCDP(_browser_ws_url(port), timeout=15.0)
+  try:
+    browser.call("Target.activateTarget", {"targetId": target_id})
+  finally:
+    browser.close()
+
+
+def _ensure_dashboard_target(port: int,
+                             dashboard_url: str = DEFAULT_DASHBOARD_URL) -> str:
+  existing = _find_target(port, dashboard_url)
+  if existing:
+    return existing
+  return _create_target(port, dashboard_url)
+
+
+def _runtime_eval(ws: WebSocketCDP, expression: str, timeout_sec: float = 60.0) -> Any:
+  deadline = time.time() + max(1.0, timeout_sec)
+  last_error: Optional[Exception] = None
+  while time.time() < deadline:
+    try:
+      result = ws.call("Runtime.evaluate", {
+          "expression": expression,
+          "returnByValue": True,
+          "awaitPromise": True,
+      })
+      if isinstance(result, dict) and result.get("exceptionDetails"):
+        details = json.dumps(result.get("exceptionDetails"), ensure_ascii=True)
+        raise RuntimeError(f"Runtime.evaluate exception: {details[:400]}")
+      return (result.get("result") or {}).get("value")
+    except Exception as exc:
+      last_error = exc
+      msg = str(exc).lower()
+      if "context" in msg or "provisional" in msg or "socket closed" in msg:
+        time.sleep(0.25)
+        continue
+      raise
+  raise RuntimeError(f"Runtime.evaluate timed out: {last_error}")
+
+
+def _wait_for_dashboard_handler(ws: WebSocketCDP, timeout_sec: float = 45.0) -> None:
+  expr = (
+      "Boolean(window.chrome && typeof window.chrome.send === 'function')")
+  deadline = time.time() + max(1.0, timeout_sec)
+  while time.time() < deadline:
+    try:
+      if _runtime_eval(ws, expr, timeout_sec=3.0):
+        return
+    except Exception:
+      pass
+    time.sleep(0.25)
+  raise RuntimeError("Timed out waiting for chrome.send on dashboard tab")
+
+
+def _resolve_active_session_tab_id(ws: WebSocketCDP,
+                                   timeout_sec: float = 15.0) -> int:
+  result = _dashboard_send(
+      ws,
+      "dashboardAgentGetActivePageInfo",
+      {},
+      timeout_sec=timeout_sec,
+  )
+  if not isinstance(result, dict):
+    raise RuntimeError("dashboardAgentGetActivePageInfo returned invalid response")
+  tab_id = result.get("tab_id", result.get("tabId"))
+  if tab_id is None:
+    raise RuntimeError(
+        "dashboardAgentGetActivePageInfo missing tab_id "
+        f"(url={result.get('url')!r})")
+  return int(tab_id)
+
+
+def _dashboard_send(ws: WebSocketCDP,
+                    message: str,
+                    payload: Any,
+                    timeout_sec: float = 120.0) -> Any:
+  timeout_ms = int(max(1000, timeout_sec * 1000))
+  expr = f"""
+(async () => {{
+  const message = {json.dumps(message)};
+  const payload = {json.dumps(payload)};
+  const cb = '__sim_bridge_' + Date.now() + '_' + Math.random().toString(36).slice(2);
+  return await new Promise((resolve, reject) => {{
+    window[cb] = (result) => {{
+      try {{ delete window[cb]; }} catch (_) {{}}
+      if (Array.isArray(result) && result.length === 1) {{
+        resolve(result[0]);
+        return;
+      }}
+      resolve(result);
+    }};
+    if (!window.chrome || typeof window.chrome.send !== 'function') {{
+      reject(new Error('chrome.send unavailable'));
+      return;
+    }}
+    if (payload === null || payload === undefined) {{
+      window.chrome.send(message, [cb]);
+    }} else {{
+      window.chrome.send(message, [cb, payload]);
+    }}
+    setTimeout(() => reject(new Error('dashboard message timeout: ' + message)), {timeout_ms});
+  }});
+}})()
+"""
+  return _runtime_eval(ws, expr, timeout_sec=timeout_sec + 5.0)
+
+
+class HeadlessExecutorBridge:
+  """CDP client that drives ScriptExecutionService inside headless Chromium."""
+
+  def __init__(self,
+               cdp_port: int = DEFAULT_CDP_PORT,
+               dashboard_url: str = DEFAULT_DASHBOARD_URL):
+    self.cdp_port = cdp_port
+    self.dashboard_url = dashboard_url
+    self._dashboard_target_id: Optional[str] = None
+    self._dashboard_ws: Optional[WebSocketCDP] = None
+
+  def connect(self, startup_timeout_sec: float = 60.0) -> None:
+    _wait_for_devtools(self.cdp_port, startup_timeout_sec)
+    self._dashboard_target_id = _ensure_dashboard_target(
+        self.cdp_port, self.dashboard_url)
+    ws_url = _target_ws_url(self.cdp_port, self._dashboard_target_id)
+    self._dashboard_ws = WebSocketCDP(ws_url, timeout=60.0)
+    _wait_for_dashboard_handler(self._dashboard_ws)
+    _dashboard_send(self._dashboard_ws, "dashboardInitialize", None, timeout_sec=30.0)
+
+  def close(self) -> None:
+    if self._dashboard_ws is not None:
+      self._dashboard_ws.close()
+      self._dashboard_ws = None
+
+  def create_work_target(self, url: str) -> str:
+    return _create_target(self.cdp_port, url or "about:blank")
+
+  def activate_target(self, target_id: str) -> None:
+    _activate_target(self.cdp_port, target_id)
+
+  def run_timeline(self,
+                   actions: List[Dict[str, Any]],
+                   *,
+                   work_target_id: Optional[str] = None,
+                   work_tab_id: Optional[int] = None,
+                   wait_for_completion: bool = True,
+                   force_cdp_execution: Optional[bool] = None,
+                   force_native_execution: Optional[bool] = None,
+                   timeout_sec: float = 600.0) -> Dict[str, Any]:
+    if not self._dashboard_ws:
+      raise RuntimeError("HeadlessExecutorBridge is not connected")
+    tab_id = work_tab_id
+    if work_target_id:
+      self.activate_target(work_target_id)
+      time.sleep(0.15)
+      if tab_id is None:
+        tab_id = _resolve_active_session_tab_id(self._dashboard_ws)
+    payload: Dict[str, Any] = {
+        "timeline": actions,
+        "wait_for_completion": wait_for_completion,
+        "is_agent_mode": False,
+    }
+    if tab_id is not None:
+      payload["tab_id"] = tab_id
+    if force_cdp_execution is not None:
+      payload["force_cdp_execution"] = force_cdp_execution
+    if force_native_execution is not None:
+      payload["force_native_execution"] = force_native_execution
+    if self._dashboard_ws is not None:
+      socket_timeout = max(60.0, timeout_sec + 30.0)
+      self._dashboard_ws._timeout = socket_timeout
+      if self._dashboard_ws._sock is not None:
+        self._dashboard_ws._sock.settimeout(socket_timeout)
+    result = _dashboard_send(
+        self._dashboard_ws,
+        "dashboardAgentRunTimeline",
+        payload,
+        timeout_sec=timeout_sec,
+    )
+    if not isinstance(result, dict):
+      return {"ok": False, "error": "invalid dashboard response"}
+    return result
+
+  def refresh_page_map(self, timeout_sec: float = 45.0) -> Dict[str, Any]:
+    if not self._dashboard_ws:
+      raise RuntimeError("HeadlessExecutorBridge is not connected")
+    result = _dashboard_send(
+        self._dashboard_ws,
+        "dashboardAgentRefreshPageMap",
+        {},
+        timeout_sec=timeout_sec,
+    )
+    return result if isinstance(result, dict) else {"ok": False, "error": "invalid response"}
+
+
+def run_actions_on_headless(actions: List[Dict[str, Any]],
+                            *,
+                            cdp_port: int = DEFAULT_CDP_PORT,
+                            work_target_id: Optional[str] = None,
+                            work_tab_id: Optional[int] = None,
+                            work_url: Optional[str] = None,
+                            wait_for_completion: bool = True) -> Dict[str, Any]:
+  """Run Simulachrome timeline actions via native ScriptExecutionService."""
+  bridge = HeadlessExecutorBridge(cdp_port=cdp_port)
+  try:
+    bridge.connect()
+    target_id = work_target_id
+    if not target_id and work_url:
+      target_id = bridge.create_work_target(work_url)
+    return bridge.run_timeline(
+        actions,
+        work_target_id=target_id,
+        work_tab_id=work_tab_id,
+        wait_for_completion=wait_for_completion,
+    )
+  finally:
+    bridge.close()
