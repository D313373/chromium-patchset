+#!/usr/bin/env python3
+"""Run welcome_demo (or any script JSON) with force_native_execution via bridge."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+SRC = Path(__file__).resolve().parents[2]
+BRIDGE_DIR = SRC / "chrome/browser/resources/dashboard"
+DEFAULT_SCRIPT = Path.home() / "Library/Application Support/Simulachrome/Scripts/welcome_demo.json"
+DEFAULT_CHROME = SRC / "out/Default/Chromium.app/Contents/MacOS/Chromium"
+DEFAULT_PROFILE = Path.home() / "Library/Application Support/Simulachrome/DevProfile"
+LOG_FILE = Path("/tmp/glic_welcome_native.log")
+
+
+def load_actions(path: Path) -> list:
+  data = json.loads(path.read_text(encoding="utf-8"))
+  actions = data.get("timeline") or data.get("actions") or []
+  if not isinstance(actions, list):
+    raise RuntimeError(f"No actions in {path}")
+  return [a for a in actions if isinstance(a, dict)]
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--script", type=Path, default=DEFAULT_SCRIPT)
+  parser.add_argument("--cdp-port", type=int, default=9223)
+  parser.add_argument("--timeout-sec", type=float, default=900.0)
+  parser.add_argument("--log-file", type=Path, default=LOG_FILE)
+  parser.add_argument("--start-url", type=str, default="about:blank")
+  args = parser.parse_args()
+
+  sys.path.insert(0, str(BRIDGE_DIR))
+  from headless_executor_bridge import HeadlessExecutorBridge  # noqa: E402
+
+  actions = load_actions(args.script)
+  bridge = HeadlessExecutorBridge(cdp_port=args.cdp_port)
+  bridge.connect(startup_timeout_sec=60.0)
+  try:
+    work_target_id = bridge.create_work_target(args.start_url)
+    print(f"work_target_id={work_target_id}")
+    result = bridge.run_timeline(
+        actions,
+        work_target_id=work_target_id,
+        wait_for_completion=True,
+        force_native_execution=True,
+        timeout_sec=args.timeout_sec,
+    )
+    print(json.dumps(result, indent=2, ensure_ascii=True))
+    return 0 if result.get("ok") else 1
+  finally:
+    bridge.close()
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
