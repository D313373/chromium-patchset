+  BlinkTrollWrapper troll_;
+  AgentContext context_;
+
+  base::RepeatingTimer timer_;
+
+  int model_resource_id_ = -1;
+  bool model_loaded_ = false;
+  bool running_ = false;
+
+  base::TimeDelta interval_ = base::Milliseconds(200);
+};
