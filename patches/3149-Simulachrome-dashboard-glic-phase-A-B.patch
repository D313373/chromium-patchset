+  if (!base::ImportantFileWriter::WriteFileAtomically(path, json)) {
+    LOG(ERROR) << "[Dashboard] WriteScriptToDisk FAILED id=" << id
+               << " path=" << path.AsUTF8Unsafe();
+    return false;
+  }
+  LOG(INFO) << "[Dashboard] WriteScriptToDisk OK id=" << id
+            << " path=" << path.AsUTF8Unsafe();
+  return true;
