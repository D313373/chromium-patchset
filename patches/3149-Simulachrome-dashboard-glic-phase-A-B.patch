+void RecorderController::SetOneShotCaptureClickSuppression(bool armed) {
+  if (!agent_host_ || !devtools_client_)
+    return;
+
+  const std::string js = base::StringPrintf(
+      R"JS((function(armed){
+        try {
+          const key = '__dash_locator_capture_guard__';
+          const state = window[key] || (window[key] = {
+            armed:false,
+            installed:false,
+            handler:null
+          });
+          state.armed = !!armed;
+          if (state.installed) return true;
+          state.handler = function(e) {
+            const s = window[key];
+            if (!s || !s.armed) return;
+            s.armed = false;
+            try { e.preventDefault(); } catch (_) {}
+            try { if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation(); } catch (_) {}
+            try { e.stopPropagation(); } catch (_) {}
+          };
+          const opts = {capture:true, passive:false};
+          document.addEventListener('pointerdown', state.handler, opts);
+          document.addEventListener('mousedown', state.handler, opts);
+          document.addEventListener('click', state.handler, opts);
+          state.installed = true;
+          return true;
+        } catch (_) {
+          return false;
+        }
+      })(%s))JS",
+      armed ? "true" : "false");
+
+  base::Value::Dict params;
+  params.Set("expression", js);
+  params.Set("returnByValue", false);
+  SendCommand("Runtime.evaluate", std::move(params));
+}
