+#include "content/public/renderer/render_frame_observer.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard.mojom.h"
+#include <vector>
+
+namespace dashboard_renderer {
+
+class StealthUserActionTracker : public content::RenderFrameObserver {
+ public:
+  explicit StealthUserActionTracker(content::RenderFrame* frame);
+  ~StealthUserActionTracker() override;
+
+  // content::RenderFrameObserver
+  void OnDestruct() override;
+  void DidFinishLoad() override;
+  // Future: override input event hook when available in this environment.
+
+ private:
+  void MaybeBindRecorderAgent();
+  void OnRecorderAgentDisconnected();
+  void SendAgentStateSnapshot(blink::Element* target,
+                              bool subtree_only,
+                              bool mark_hovered);
+  dashboard::mojom::AgentStateSnapshotPtr BuildSnapshotFromState(
+      const blink::AgentState& state,
+      const std::string& url);
+  raw_ptr<content::RenderFrame> frame_ = nullptr;  // not owned
+  mojo::Remote<dashboard::mojom::RecorderAgent> recorder_agent_;
+  base::WeakPtrFactory<StealthUserActionTracker> weak_factory_{this};
+  std::vector<dashboard::mojom::LocatorPtr> BuildLocatorBundleFromElement(
+      const blink::WebElement& element);
+  blink::WebElement FindElementByLocator(
+      const std::vector<dashboard::mojom::LocatorPtr>& locators);
+  std::string GenerateUniqueSelector(const blink::WebElement& element);
+  std::string GenerateSimpleXPath(const blink::WebElement& element);
+};
+
