+  if (action === 'long_pause') return { key: 'long_pause', label: 'LONG PAUSE', badgeClass: 'dbg-event-badge-sleep' };
+  if (action === 'error') return { key: 'error', label: 'ERROR', badgeClass: 'dbg-event-badge-error' };
