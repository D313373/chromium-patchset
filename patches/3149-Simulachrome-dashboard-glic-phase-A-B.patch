+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Navigation Directory</title>
+  <style>
+    body {
+      font-family: Arial, sans-serif;
+      margin: 20px;
+      /* Helper styles for a full-screen background */
+      background-size: cover;
+      background-position: center;
+      background-attachment: fixed;
+    }
+    #linksContainer {
+      padding: 20px;
+      background-color: rgba(255, 255, 255, 0.9);
+      border-radius: 8px;
+      max-width: 600px;
+    }
+    #linksContainer a {
+      display: block;
+      margin: 10px 0;
+      padding: 15px;
+      text-decoration: none;
+      color: #1a73e8;
+      font-size: 18px;
+      font-weight: bold;
+      background-color: #f0f0f0;
+      border-radius: 4px;
+      border: 2px solid #1a73e8;
+    }
+    #linksContainer a:hover {
+      background-color: #e3f2fd;
+      text-decoration: underline;
+    }
+  </style>
+</head>
+<body>
+  <h1>Navigation Directory</h1>
+  <div id="linksContainer">
+    <!-- Links will be dynamically added here -->
+  </div>
+
+  <script>
+    // Provide minimal shims so messages from the dashboard/recorder don't throw in this interstitial page.
+    window.__dashboardNotifyRecordingStopped = window.__dashboardNotifyRecordingStopped || function(){};
+    window.DashboardScriptsChanged = window.DashboardScriptsChanged || function(){};
+  </script>
+  <script>
+    // Read URL parameters and create navigation link
+    const params = new URLSearchParams(window.location.search);
+    const targetUrl = params.get('url');
+    const linkId = params.get('id') || 'navigate-link';
+
+    console.log('[Directory] URL params:', { targetUrl, linkId });
+
+    if (targetUrl && linkId) {
+      const container = document.getElementById('linksContainer');
+      const existing = document.getElementById(linkId);
+      if (existing && existing.parentNode) {
+        existing.parentNode.removeChild(existing);
+      }
+
+      const link = document.createElement('a');
+      link.id = linkId;
+      link.href = targetUrl;
+      // Navigate within the same tab to keep automation context intact.
+      link.textContent = 'Navigate to ' + targetUrl;
+      container.appendChild(link);
+
+      console.log('[Directory] Created link:', linkId, 'to', targetUrl);
+      console.log('[Directory] Link element:', link);
+    } else {
+      console.error('[Directory] Missing URL parameters: url=' + targetUrl + ', id=' + linkId);
+      const container = document.getElementById('linksContainer');
+      container.innerHTML = '<p style="color: red;">Error: Missing URL parameters</p>';
+    }
+  </script>
+</body>
+</html>
diff --git a/chrome/browser/resources/dashboard/unused/netifydrop/directory_runtime.js b/chrome/browser/resources/dashboard/unused/netifydrop/directory_runtime.js
