+bool EncryptSecretToIniValue(const std::string& plaintext,
+                             std::string* out_ini_value) {
+  if (!out_ini_value)
+    return false;
+  std::string ciphertext;
+  if (!OSCrypt::EncryptString(plaintext, &ciphertext))
+    return false;
+  *out_ini_value = base::Base64Encode(ciphertext);
+  return true;
+}
