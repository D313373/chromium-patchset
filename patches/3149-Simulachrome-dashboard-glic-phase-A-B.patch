@@ -0,0 +1,113 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/dashboard/actions/history_nav_action.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/time/time.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+
+namespace dashboard::actions {
+
+namespace {
+
+constexpr base::TimeDelta kHistoryNavTimeout = base::Seconds(30);
+
+}  // namespace
+
+HistoryNavAction::HistoryNavAction(Profile* profile, Direction direction)
+    : Action(profile), direction_(direction) {}
+
+HistoryNavAction::~HistoryNavAction() = default;
+
+bool HistoryNavAction::SetParams(const base::Value::Dict& params) {
+  // No required params. Keep serialized output canonical.
+  SetSerializedAction(direction_ == Direction::kBack ? "back" : "forward",
+                      base::Value::Dict());
+  return true;
+}
+
+void HistoryNavAction::Execute(content::WebContents* web_contents,
+                               Callback callback) {
+  if (!web_contents) {
+    std::move(callback).Run(false, "WebContents null");
+    return;
+  }
+
+  content::NavigationController& controller = web_contents->GetController();
+  start_entry_index_ = controller.GetLastCommittedEntryIndex();
+
+  const bool can =
+      (direction_ == Direction::kBack) ? controller.CanGoBack()
+                                       : controller.CanGoForward();
+  if (!can) {
+    std::move(callback).Run(
+        false, direction_ == Direction::kBack ? "Cannot go back"
+                                              : "Cannot go forward");
+    return;
+  }
+
+  Observe(web_contents);
+  pending_callback_ = std::move(callback);
+  timeout_timer_.Start(FROM_HERE, kHistoryNavTimeout,
+                       base::BindOnce(&HistoryNavAction::OnTimeout,
+                                      base::Unretained(this)));
+
+  if (direction_ == Direction::kBack) {
+    controller.GoBack();
+  } else {
+    controller.GoForward();
+  }
+}
+
+void HistoryNavAction::DidFinishNavigation(content::NavigationHandle* navigation) {
+  if (!pending_callback_)
+    return;
+  if (!navigation || navigation->GetWebContents() != web_contents())
+    return;
+  if (!navigation->HasCommitted())
+    return;
+  if (!navigation->IsInPrimaryMainFrame())
+    return;
+
+  // History navigation can be same-document (hash changes), so infer completion
+  // by observing the committed entry index change in the requested direction.
+  const int idx = web_contents()->GetController().GetLastCommittedEntryIndex();
+  if (idx < 0)
+    return;
+
+  const bool moved =
+      (direction_ == Direction::kBack) ? (idx < start_entry_index_)
+                                       : (idx > start_entry_index_);
+  if (!moved)
+    return;
+
+  Finish(true, "");
+}
+
+void HistoryNavAction::WebContentsDestroyed() {
+  if (pending_callback_)
+    Finish(false, "WebContents destroyed");
+}
+
+void HistoryNavAction::OnTimeout() {
+  if (pending_callback_)
+    Finish(false, "History navigation timeout");
+}
+
+void HistoryNavAction::Finish(bool success, const std::string& message) {
+  timeout_timer_.Stop();
+  Observe(nullptr);
+  start_entry_index_ = -1;
+  auto cb = std::move(pending_callback_);
+  pending_callback_.Reset();
+  if (cb)
+    std::move(cb).Run(success, message);
+}
+
+}  // namespace dashboard::actions
+
