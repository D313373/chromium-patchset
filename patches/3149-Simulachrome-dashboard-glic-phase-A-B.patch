@@ -0,0 +1,64 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/agent/agent_control_impl.h"
+
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/agent/blink_agent_loop.h"
+
+namespace blink {
+
+AgentControlImpl::AgentControlImpl(LocalFrame* frame) : frame_(frame) {}
+
+void AgentControlImpl::Trace(Visitor* visitor) const {
+  visitor->Trace(frame_);
+  visitor->Trace(events_);
+}
+
+void AgentControlImpl::SetEventPipe(
+    mojo::PendingRemote<simulachrome::mojom::blink::AgentEvents> remote) {
+  events_.Bind(std::move(remote),
+               frame_ ? frame_->GetTaskRunner(TaskType::kInternalDefault)
+                      : nullptr);
+}
+
+void AgentControlImpl::OnStart() {
+  if (auto* loop = frame_ ? frame_->GetAgentLoop() : nullptr)
+    loop->Start();
+  if (events_.is_bound())
+    events_->OnStarted(String());
+}
+
+void AgentControlImpl::OnStop() {
+  if (auto* loop = frame_ ? frame_->GetAgentLoop() : nullptr)
+    loop->Stop();
+  if (events_.is_bound())
+    events_->OnStopped("Stopped");
+}
+
+void AgentControlImpl::OnTickOnce() {
+  if (auto* loop = frame_ ? frame_->GetAgentLoop() : nullptr)
+    loop->TickOnce();
+  if (events_.is_bound())
+    events_->OnStep(0, "Tick");
+}
+
+void AgentControlImpl::OnSetGoal(const String& goal) {
+  if (auto* loop = frame_ ? frame_->GetAgentLoop() : nullptr)
+    loop->SetGoal(goal);
+}
+
+void AgentControlImpl::GetStatus(GetStatusCallback callback) {
+  auto status = simulachrome::mojom::blink::AgentStatus::New();
+  if (auto* loop = frame_ ? frame_->GetAgentLoop() : nullptr) {
+    status->is_running = loop->IsRunning();
+    status->status_text = loop->GetStatus();
+    status->step_index = 0;
+  } else {
+    status->is_running = false;
+  }
+  std::move(callback).Run(std::move(status));
+}
+
+}  // namespace blink
