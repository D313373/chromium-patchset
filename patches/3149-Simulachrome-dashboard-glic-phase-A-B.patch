+std::optional<GURL> ExtractScriptStartUrl(const base::Value::Dict& script) {
+  if (const std::string* explicit_start = script.FindString("startUrl")) {
+    if (!explicit_start->empty()) {
+      GURL gurl(*explicit_start);
+      if (gurl.is_valid())
+        return gurl;
+    }
+  }
+
+  // Primary: infer start URL from the first navigate action in the primary
+  // timeline.
+  base::Value::List timeline = FlattenTimelineForListenerScript(script);
+  for (const auto& step : timeline) {
+    const base::Value::Dict* d = step.GetIfDict();
+    if (!d)
+      continue;
+    const std::string* action = d->FindString("action");
+    if (!action || !base::EqualsCaseInsensitiveASCII(*action, "navigate"))
+      continue;
+    const base::Value::Dict* params = d->FindDict("params");
+    if (!params)
+      continue;
+    const std::string* url = params->FindString("url");
+    if (!url || url->empty())
+      continue;
+    GURL gurl(*url);
+    if (gurl.is_valid())
+      return gurl;
+  }
+
+  // Fallback: legacy context URL hints for older scripts.
+  if (const base::Value::List* contexts = script.FindList("url_contexts")) {
+    for (const auto& ctx : *contexts) {
+      const base::Value::Dict* d = ctx.GetIfDict();
+      if (!d)
+        continue;
+      const std::string* url = d->FindString("url");
+      if (!url || url->empty())
+        continue;
+      GURL gurl(*url);
+      if (gurl.is_valid())
+        return gurl;
+    }
+  }
+  return std::nullopt;
 }
 
