@@ -0,0 +1,23 @@
+#include "chrome/browser/ui/webui/dashboard/recording_suppression.h"
+
+namespace dashboard {
+namespace {
+
+std::atomic<int> g_suppression_depth{0};
+
+}  // namespace
+
+bool IsRecordingSuppressed() {
+  return g_suppression_depth.load(std::memory_order_relaxed) > 0;
+}
+
+ScopedRecordingSuppression::ScopedRecordingSuppression() {
+  g_suppression_depth.fetch_add(1, std::memory_order_relaxed);
+}
+
+ScopedRecordingSuppression::~ScopedRecordingSuppression() {
+  g_suppression_depth.fetch_sub(1, std::memory_order_relaxed);
+}
+
+}  // namespace dashboard
+
