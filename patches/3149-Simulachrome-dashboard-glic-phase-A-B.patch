+std::string NormalizeSignatureToken(std::string s) {
+  base::TrimWhitespaceASCII(s, base::TRIM_ALL, &s);
+  s = base::CollapseWhitespaceASCII(s, true);
+  if (s.size() > 512)
+    s.resize(512);
