+          const sink = window.__aiSinks && window.__aiSinks[requestId];
+          if (res && typeof res.body === 'string' && sink) {
+            sink.append(res.body);
+          }
+          if (sink && typeof sink.done === 'function') {
+            sink.done(!!(res && res.ok), String((res && res.error) || ''), null);
+          }
+        } finally {
+          try { delete window[requestId]; } catch (_) {}
+        }
+      };
+      // C++ proxy call (may stream via DashboardOnAiChunk/Done or call window[id])
+      chrome.send('dashboardAiChatProxy', [requestId, { body, id: requestId }]);
+    } catch (e) {
+      clearAiRequestState(requestId);
+      requestState.canceled = true;
+      outBox.textContent = 'Proxy invoke failed: ' + (e?.message || e);
+      console.error('[AIConsole] proxy invoke threw', e);
+      delete window.__aiSinks[requestId];
+      try { delete window[requestId]; } catch (_) {}
+    }
+  }
+
+  if (isDashboardConsole) {
+    window.dashboardAgentSendPrompt = function(prompt, options = {}) {
+      try {
+        const text = String(prompt || '').trim();
+        if (!text) return {ok: false, error: 'empty_prompt'};
+        sendToOllamaProxy(text, options || {});
+        return {ok: true};
+      } catch (e) {
+        return {ok: false, error: String(e && e.message ? e.message : e)};
+      }
+    };
+  }
+
+  sendBtn.onclick = () => {
+    const prompt = inputEl.value.trim();
+    if (!prompt) return;
+    inputEl.value = '';
+    const includeAndShowContext =
+        !!(contextToggle ? contextToggle.checked : includeDevContext);
+    sendToOllamaProxy(prompt, {
+      forcePageContext: includeAndShowContext,
+      showContextInChat: includeAndShowContext,
+    }); // Call our new proxy function
+  };
+  if (stopBtn) {
+    stopBtn.onclick = () => {
+      cancelActiveAiRequest('stopped by user');
+    };
+  }
+
+  inputEl.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' && !e.shiftKey) {
+      e.preventDefault();
+      sendBtn.click();
+    }
+  });
+
+  // Optional: external Blink agent can call this to surface status/events.
+  // Temporarily disabled: keep the symbol present so any callers don't throw,
+  // but ignore incoming events so the console is not tied to the Blink agent.
+  window.onBlinkAgentEvent = function(_evt) {
+    // no-op while BlinkTroll model is offline
+  };
+}
diff --git a/chrome/browser/resources/dashboard/agent/console/dashboard_ai_shared.js b/chrome/browser/resources/dashboard/agent/console/dashboard_ai_shared.js
new file mode 100644
index 0000000000000000000000000000000000000000..b5b4f29e1aa244db89cffc78d3bbebb925f82357
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/console/dashboard_ai_shared.js
@@ -0,0 +1,140 @@
+export function installDashboardAiSharedUi({
+  windowRef = window,
+  documentRef = document,
+  localStorageRef = localStorage,
+} = {}) {
+  windowRef.__resetSharedAgentChat = function() {
+    try {
+      if (typeof windowRef.dashboardAgentCancelInFlight === 'function') {
+        windowRef.dashboardAgentCancelInFlight('reset');
+      }
+      const sessionId = windowRef.__DASHBOARD_SHARED_CHAT_ID ||
+          'dashboard_shared_chat';
+      const key = `dash.chat.${sessionId}`;
+      localStorageRef.removeItem(key);
+      try {
+        windowRef.__ollamaContexts = windowRef.__ollamaContexts || {};
+        delete windowRef.__ollamaContexts[sessionId];
+      } catch (_) {}
+      try {
+        windowRef.__dashLastContextUrlForChat = null;
+        windowRef.__dashForceNextContextRefresh = false;
+      } catch (_) {}
+      if (windowRef.__aiSinks && windowRef.__aiSinks[sessionId]) {
+        delete windowRef.__aiSinks[sessionId];
+      }
+      const hist = documentRef.getElementById('gemini-console-history') ||
+          documentRef.getElementById('ov-ai-history');
+      if (hist) {
+        hist.innerHTML = '';
+      }
+      const cubby = localStorageRef.getItem('dash.agent.cubby');
+      if (cubby) {
+        const div = documentRef.createElement('div');
+        div.className = 'msg';
+        div.style.cssText =
+            'padding:8px;margin:6px 0;border-radius:6px;white-space:pre-wrap;' +
+            'background:rgba(255,255,255,0.06)';
+        div.textContent = '[Agent] Reset complete. Memento is preserved.';
+        if (hist) {
+          hist.appendChild(div);
+          hist.scrollTop = hist.scrollHeight;
+        }
+      }
+    } catch (e) {
+      console.warn('resetSharedAgentChat failed', e);
+    }
+  };
+
+  if (windowRef.DashboardOnAiChunk) {
+    return;
+  }
+
+  windowRef.__aiSinks = windowRef.__aiSinks || {};
+  windowRef.DashboardOnAiChunk = (id, txt) => {
+    let sink = windowRef.__aiSinks[id];
+    const sharedSessionId =
+        windowRef.__DASHBOARD_SHARED_CHAT_ID || 'dashboard_shared_chat';
+    const belongsToSharedSession = String(id) === sharedSessionId ||
+        String(id).startsWith(`${sharedSessionId}:`);
+    if (!sink && belongsToSharedSession) {
+      const historyEl = documentRef.getElementById('gemini-console-history') ||
+          documentRef.getElementById('ov-ai-history');
+      if (historyEl) {
+        let box = null;
+        windowRef.__aiSinks[id] = sink = {
+          _buf: '',
+          append: (t) => {
+            if (!box) {
+              box = documentRef.createElement('div');
+              box.className = 'msg';
+              box.style.cssText =
+                  'padding:8px;margin:6px 0;border-radius:6px;white-space:pre-wrap;';
+              box.style.background = 'rgba(255,255,255,0.06)';
+              historyEl.appendChild(box);
+            }
+            sink._buf += String(t || '');
+            box.textContent += String(t || '');
+            historyEl.scrollTop = historyEl.scrollHeight;
+          },
+          done: (ok, _err) => {
+            try {
+              const key = `dash.chat.${sharedSessionId}`;
+              const stored = localStorageRef.getItem(key);
+              const arr = stored ? JSON.parse(stored) : [];
+              if (ok && sink._buf) {
+                arr.push({role: 'assistant', content: sink._buf});
+                localStorageRef.setItem(key, JSON.stringify(arr));
+              }
+            } catch (_) {}
+          },
+        };
+      }
+    }
+    if (sink && typeof sink.append === 'function') {
+      sink.append(String(txt || ''));
+    }
+  };
+
+  windowRef.DashboardOnAiDone = (id, ok, err, meta) => {
+    try {
+      if (meta && meta.ollama_context && Array.isArray(meta.ollama_context)) {
+        windowRef.__ollamaContexts = windowRef.__ollamaContexts || {};
+        windowRef.__ollamaContexts[id] = meta.ollama_context;
+      }
+    } catch (_) {}
+    const sink = windowRef.__aiSinks[id];
+    try {
+      if (sink && typeof sink.done === 'function') {
+        sink.done(!!ok, String(err || ''), meta || null);
+      }
+    } catch (_) {}
+    try {
+      delete windowRef.__aiSinks[id];
+    } catch (_) {}
+  };
+
+  if (!windowRef.__aiSinks['pagemap_stream']) {
+    windowRef.__aiSinks['pagemap_stream'] = {
+      append: (txt) => {
+        try {
+          const el = documentRef.getElementById('ov-pm-stream') ||
+              documentRef.getElementById('ai-response') ||
+              documentRef.getElementById('ov-ai-history');
+          if (el) {
+            const div = documentRef.createElement('div');
+            div.className = 'msg';
+            div.style.cssText =
+                'font-family:monospace;font-size:11px;opacity:0.85;white-space:pre;';
+            div.textContent = String(txt || '');
+            el.appendChild(div);
+            el.scrollTop = el.scrollHeight;
+          } else {
+            console.debug('[PageMapStream]', txt);
+          }
+        } catch (_) {}
+      },
+      done: () => {},
+    };
+  }
+}
diff --git a/chrome/browser/resources/dashboard/agent/dashboard_auto_heal.js b/chrome/browser/resources/dashboard/agent/dashboard_auto_heal.js
new file mode 100644
index 0000000000000000000000000000000000000000..87d812312f88e0827688963ac0c79980dbaedf17
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/dashboard_auto_heal.js
@@ -0,0 +1,411 @@
+export function createDashboardAutoHealManager({
+  windowRef = window,
+  dashboardHandler,
+  autoHealState,
+  sendPrompt,
+  queueMax = 120,
+  recentKeysMax = 600,
+}) {
+  if (!windowRef || typeof windowRef !== 'object') {
+    return null;
+  }
+  if (!dashboardHandler || typeof dashboardHandler !== 'object') {
+    return null;
+  }
+  if (!autoHealState || typeof autoHealState !== 'object') {
+    return null;
+  }
+
+  const autoHealKeyFor = (failureLike) => {
+    if (!failureLike || typeof failureLike !== 'object')
+      return '';
+    const incident = failureLike.incident || failureLike;
+    const runId = String(
+        incident.selected_run_id ||
+        incident.run_id ||
+        incident.id ||
+        '').trim();
+    if (runId)
+      return `run:${runId}`;
+    const explicitKey = String(
+        incident.failure_key ||
+        incident.key ||
+        incident.event_key ||
+        '').trim();
+    if (explicitKey)
+      return explicitKey;
+    const scriptId = String(
+        incident.selected_script_id ||
+        incident.script_id ||
+        incident.listener_script_id ||
+        '').trim();
+    const when = Number(
+        incident.selected_start_ms ||
+        incident.ts_ms ||
+        incident.started_ms ||
+        Date.now());
+    return `anon:${scriptId}:${when}`;
+  };
+
+  const rememberAutoHealKey = (key) => {
+    const k = String(key || '').trim();
+    if (!k) return;
+    autoHealState.knownFailureKeys.add(k);
+    if (autoHealState.knownFailureKeys.size > recentKeysMax) {
+      const iter = autoHealState.knownFailureKeys.values();
+      const first = iter.next();
+      if (!first.done) {
+        autoHealState.knownFailureKeys.delete(first.value);
+      }
+    }
+  };
+
+  const enqueueAutoHealIncident = (incident, source = 'manual') => {
+    if (!incident || typeof incident !== 'object')
+      return {ok: false, error: 'invalid_incident'};
+    const key = autoHealKeyFor(incident);
+    if (!key)
+      return {ok: false, error: 'missing_incident_key'};
+    if (autoHealState.knownFailureKeys.has(key)) {
+      return {ok: true, queued: false, duplicate: true, key};
+    }
+    if (autoHealState.queue.some((q) => q && q.key === key)) {
+      return {ok: true, queued: false, duplicate: true, key};
+    }
+    autoHealState.queue.push({
+      key,
+      source: String(source || 'manual'),
+      queuedAt: Date.now(),
+      incident: JSON.parse(JSON.stringify(incident)),
+    });
+    if (autoHealState.queue.length > queueMax) {
+      autoHealState.queue.splice(0, autoHealState.queue.length - queueMax);
+    }
+    rememberAutoHealKey(key);
+    return {ok: true, queued: true, key, queue_len: autoHealState.queue.length};
+  };
+
+  const buildAutoHealPrompt = (task) => {
+    const incident = (task && task.incident && typeof task.incident === 'object')
+      ? task.incident
+      : {};
+    const mode = autoHealState.preferHeadlessInvestigation
+      ? 'headless_preferred'
+      : 'background_tab';
+    const incidentJson = (() => {
+      try {
+        const raw = JSON.stringify(incident, null, 2);
+        return raw.length > 22000 ? `${raw.slice(0, 22000)}\n... [truncated]` : raw;
+      } catch (_) {
+        return '{}';
+      }
+    })();
+    return [
+      'Auto-heal task queued from Debugging timeline.',
+      'Goal: identify failed action, verify URL/DOM conditions, and repair the script timeline to reduce repeated failures.',
+      `Investigation mode: ${mode}.`,
+      'If true headless exploration tool path is unavailable, use non-disruptive background-tab workflow and avoid touching the user active task tab.',
+      'Use dashboard tools to inspect scripts/settings and apply fixes:',
+      '- dashboard_set_view(debugging|dashboard)',
+      '- dashboard_list_timeline_failures()',
+      '- dashboard_select_script(), dashboard_run_script(), dashboard_set_global_setting()',
+      '- call_action(...) only when needed for validation.',
+      'Important: keep changes minimal and explain why in memento via store_memento.',
+      '',
+      'Incident payload:',
+      incidentJson,
+    ].join('\n');
+  };
+
+  const queueStateSnapshot = () => {
+    const summarize = (task) => {
+      const incident = (task && task.incident && typeof task.incident === 'object')
+        ? task.incident
+        : {};
+      const selected = (incident.selected_item && typeof incident.selected_item === 'object')
+        ? incident.selected_item
+        : {};
+      return {
+        key: String(task?.key || ''),
+        source: String(task?.source || ''),
+        queued_at: Number(task?.queuedAt || 0),
+        script_name: String(
+          incident.selected_script_name ||
+          selected.scriptName ||
+          selected.script_name ||
+          ''),
+        error: String(
+          incident.selected_error ||
+          selected.error ||
+          ''),
+        failed_step: Number(incident.selected_failed_step ?? selected.failedStep ?? -1),
+      };
+    };
+    return {
+      enabled: !!autoHealState.autoQueueEnabled,
+      in_flight: !!autoHealState.inFlight,
+      current_key: String(autoHealState.currentTask?.key || ''),
+      queue: (autoHealState.queue || []).map(summarize),
+    };
+  };
+
+  const startAutoHealTask = (task) => {
+    if (typeof sendPrompt !== 'function') {
+      return {ok: false, error: 'agent_console_not_ready'};
+    }
+    const token = ++autoHealState.operationToken;
+    autoHealState.currentTask = task;
+    autoHealState.inFlight = true;
+    const prompt = buildAutoHealPrompt(task);
+    const sendRes = sendPrompt(prompt, {
+      forcePageContext: true,
+      showContextInChat: false,
+    });
+    if (!sendRes || sendRes.ok === false) {
+      if (autoHealState.operationToken === token) {
+        autoHealState.inFlight = false;
+        autoHealState.currentTask = null;
+      }
+      return {ok: false, error: String(sendRes?.error || 'send_prompt_failed')};
+    }
+    windowRef.setTimeout(() => {
+      if (autoHealState.operationToken !== token)
+        return;
+      autoHealState.inFlight = false;
+      autoHealState.currentTask = null;
+      if (autoHealState.autoQueueEnabled && autoHealState.queue.length) {
+        processAutoHealQueue();
+      }
+    }, 45000);
+    return {ok: true, task_key: String(task?.key || '')};
+  };
+
+  const cancelCurrentAutoHeal = (reason = 'user_cancel') => {
+    if (!autoHealState.inFlight) {
+      return {ok: true, canceled: false, reason: 'no_active_task'};
+    }
+    autoHealState.operationToken += 1;
+    const prior = autoHealState.currentTask;
+    autoHealState.inFlight = false;
+    autoHealState.currentTask = null;
+    return {
+      ok: true,
+      canceled: true,
+      reason: String(reason || 'user_cancel'),
+      prior_key: String(prior?.key || ''),
+    };
+  };
+
+  const processAutoHealQueue = () => {
+    if (autoHealState.inFlight) {
+      return {ok: true, status: 'busy', queue_len: autoHealState.queue.length};
+    }
+    if (!autoHealState.queue.length) {
+      return {ok: true, status: 'idle', queue_len: 0};
+    }
+    const task = autoHealState.queue.shift();
+    const started = startAutoHealTask(task);
+    if (!started.ok) {
+      return started;
+    }
+    return {
+      ok: true,
+      status: 'started',
+      task_key: task.key,
+      queue_len: autoHealState.queue.length,
+    };
+  };
+
+  const updateAutoHealSettings = (settingsObj) => {
+    const autoHeal = (settingsObj && typeof settingsObj === 'object')
+      ? (settingsObj.autoHeal || {})
+      : {};
+    autoHealState.autoQueueEnabled = autoHeal.autoQueueFailures === true;
+    autoHealState.preferHeadlessInvestigation =
+      autoHeal.investigateInHeadless !== false;
+  };
+
+  const removeQueueItemByKey = (key) => {
+    const wanted = String(key || '').trim();
+    if (!wanted) return {ok: false, error: 'missing_key'};
+    const before = autoHealState.queue.length;
+    autoHealState.queue = autoHealState.queue.filter((task) => String(task?.key || '') !== wanted);
+    return {ok: true, removed: before - autoHealState.queue.length, queue_len: autoHealState.queue.length};
+  };
+
+  const moveQueueItemByKey = (key, delta) => {
+    const wanted = String(key || '').trim();
+    if (!wanted) return {ok: false, error: 'missing_key'};
+    const step = Number(delta);
+    if (!Number.isFinite(step) || step === 0) return {ok: false, error: 'invalid_delta'};
+    const index = autoHealState.queue.findIndex((task) => String(task?.key || '') === wanted);
+    if (index < 0) return {ok: false, error: 'queue_item_not_found'};
+    const nextIndex = Math.max(0, Math.min(autoHealState.queue.length - 1, index + (step < 0 ? -1 : 1)));
+    if (nextIndex === index) return {ok: true, moved: false};
+    const [task] = autoHealState.queue.splice(index, 1);
+    autoHealState.queue.splice(nextIndex, 0, task);
+    return {ok: true, moved: true, queue_len: autoHealState.queue.length};
+  };
+
+  const prioritizeQueueItem = (key) => {
+    const wanted = String(key || '').trim();
+    if (!wanted) return {ok: false, error: 'missing_key'};
+    const index = autoHealState.queue.findIndex((task) => String(task?.key || '') === wanted);
+    if (index < 0) return {ok: false, error: 'queue_item_not_found'};
+    const [task] = autoHealState.queue.splice(index, 1);
+    const prior = autoHealState.currentTask;
+    if (autoHealState.inFlight) {
+      cancelCurrentAutoHeal('prioritize');
+    }
+    if (prior && prior.key && String(prior.key) !== wanted) {
+      autoHealState.queue.unshift(prior);
+    }
+    autoHealState.queue.unshift(task);
+    return processAutoHealQueue();
+  };
+
+  const clearQueue = () => {
+    autoHealState.queue = [];
+    return {ok: true, queue_len: 0};
+  };
+
+  const buildIncidentFromFailureRow = (rows, row) => {
+    const match = (row && typeof row === 'object') ? row : {};
+    return {
+      source: 'debugging_timeline',
+      selected_item: {
+        kind: match.kind === 'listener_error' ? 'listener_event' : 'run',
+        id: match.run_id || '',
+        scriptId: match.script_id || match.listener_script_id || '',
+        scriptName: match.script_name || match.listener_script_name || '',
+        status: 'error',
+        failedStep: Number(match.failed_step ?? -1),
+        error: String(match.error || match.detail || ''),
+        startMs: Number(match.started_ms || match.ts_ms || 0),
+        endMs: Number(match.ended_ms || match.ts_ms || 0),
+      },
+      selected_run_id: match.run_id || '',
+      selected_script_id: match.script_id || match.listener_script_id || '',
+      selected_script_name: match.script_name || match.listener_script_name || '',
+      selected_status: 'error',
+      selected_failed_step: Number(match.failed_step ?? -1),
+      selected_error: String(match.error || match.detail || ''),
+      selected_start_ms: Number(match.started_ms || match.ts_ms || 0),
+      selected_end_ms: Number(match.ended_ms || match.ts_ms || 0),
+      run_details: null,
+      listener_event: match.kind === 'listener_error' ? (match.raw || match) : null,
+      timeline_failures: Array.isArray(rows) ? rows.slice(0, 120) : [],
+    };
+  };
+
+  const autoQueueFromFailureSnapshot = (snapshotFailures) => {
+    const rows = Array.isArray(snapshotFailures) ? snapshotFailures : [];
+    autoHealState.lastFailures = rows.slice(0, 220);
+    if (!autoHealState.autoQueueEnabled) {
+      return;
+    }
+    for (const row of autoHealState.lastFailures.slice(0, 60)) {
+      const key = autoHealKeyFor(row);
+      if (!key || autoHealState.knownFailureKeys.has(key))
+        continue;
+      const incident = buildIncidentFromFailureRow(autoHealState.lastFailures, row);
+      enqueueAutoHealIncident(incident, 'debugging_timeline');
+    }
+    if (!autoHealState.inFlight && autoHealState.queue.length) {
+      processAutoHealQueue();
+    }
+  };
+
+  const listTimelineFailures = () => {
+    const rows = Array.isArray(autoHealState.lastFailures)
+      ? autoHealState.lastFailures
+      : [];
+    return {
+      ok: true,
+      count: rows.length,
+      queue_len: autoHealState.queue.length,
+      in_flight: !!autoHealState.inFlight,
+      current_key: String(autoHealState.currentTask?.key || ''),
+      rows: rows.slice(0, 120),
+    };
+  };
+
+  const queueAutoHealFromPayload = async (payload = {}) => {
+    const failureKey = String(payload?.failure_key || payload?.key || '').trim();
+    const incident = (payload && typeof payload.incident === 'object')
+      ? payload.incident
+      : null;
+    if (incident) {
+      const enq = enqueueAutoHealIncident(incident, 'agent_command');
+      if (enq.ok && autoHealState.autoQueueEnabled) {
+        processAutoHealQueue();
+      }
+      return enq;
+    }
+    if (!failureKey) {
+      return {ok: false, error: 'missing_failure_key_or_incident'};
+    }
+    const match = (autoHealState.lastFailures || []).find(
+        (row) => String(row?.key || '') === failureKey);
+    if (!match) {
+      return {ok: false, error: `failure_key_not_found:${failureKey}`};
+    }
+    const incidentFromKey = buildIncidentFromFailureRow(autoHealState.lastFailures, match);
+    incidentFromKey.source = 'agent_command';
+    const enq = enqueueAutoHealIncident(incidentFromKey, 'agent_command');
+    if (enq.ok && autoHealState.autoQueueEnabled) {
+      processAutoHealQueue();
+    }
+    return enq;
+  };
+
+  const syncAutoHealSettingsFromBackend = async () => {
+    try {
+      const res = await dashboardHandler.getEffectiveSettings('');
+      const settings = (res && res.settings) ? res.settings : {};
+      updateAutoHealSettings(settings);
+      if (autoHealState.autoQueueEnabled && autoHealState.queue.length) {
+        processAutoHealQueue();
+      }
+    } catch (e) {
+      console.warn('[AutoHeal] failed to load settings', e);
+    }
+  };
+
+  const installAgentApi = () => {
+    windowRef.dashboardAgentListTimelineFailures = () => listTimelineFailures();
+    windowRef.dashboardAgentQueueAutoHeal = async (payload = {}) =>
+      queueAutoHealFromPayload(payload);
+    windowRef.dashboardAgentProcessAutoHealQueue = async () =>
+      processAutoHealQueue();
+    windowRef.dashboardAgentGetAutoHealQueueState = () => ({
+      ok: true,
+      ...queueStateSnapshot(),
+    });
+    windowRef.dashboardAgentCancelCurrentAutoHeal = () =>
+      cancelCurrentAutoHeal('agent_cancel');
+    windowRef.dashboardAgentRemoveAutoHealQueueItem = (key) =>
+      removeQueueItemByKey(key);
+    windowRef.dashboardAgentMoveAutoHealQueueItem = (key, delta) =>
+      moveQueueItemByKey(key, delta);
+    windowRef.dashboardAgentPrioritizeAutoHealQueueItem = (key) =>
+      prioritizeQueueItem(key);
+  };
+
+  return {
+    autoQueueFromFailureSnapshot,
+    cancelCurrentAutoHeal,
+    clearQueue,
+    enqueueAutoHealIncident,
+    installAgentApi,
+    listTimelineFailures,
+    moveQueueItemByKey,
+    prioritizeQueueItem,
+    processAutoHealQueue,
+    queueAutoHealFromPayload,
+    queueStateSnapshot,
+    removeQueueItemByKey,
+    syncAutoHealSettingsFromBackend,
+    updateAutoHealSettings,
+  };
+}
diff --git a/chrome/browser/resources/dashboard/agent/dashboard_persistence.js b/chrome/browser/resources/dashboard/agent/dashboard_persistence.js
new file mode 100644
index 0000000000000000000000000000000000000000..79b39cf7b8269f806b54b775ec10dc660c961545
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/dashboard_persistence.js
@@ -0,0 +1,229 @@
+export function createDashboardPersistenceManager({
+  appState,
+  dashboardHandler,
+  normalizeScriptForSave,
+  normalizeScriptsDict,
+  renderAll,
+  getNestedActionList,
+  getLoopStepsList,
+  getKeyDownNestedList,
+}) {
+  const AUTOSAVE_DEBOUNCE_MS = 450;
+  const autosaveState = {
+    timers: new Map(),
+    inFlight: new Map(),
+    pending: new Set(),
+    inFlightWaiters: new Map(),
+  };
+
+  function resolveInFlightWaiters(scriptId) {
+    const waiters = autosaveState.inFlightWaiters.get(scriptId);
+    if (!waiters || !waiters.size) return;
+    autosaveState.inFlightWaiters.delete(scriptId);
+    for (const resolve of waiters) {
+      try { resolve(true); } catch (_) {}
+    }
+  }
+
+  function waitForInFlightToFinish(scriptId, timeoutMs = 5000) {
+    if (!autosaveState.inFlight.get(scriptId)) {
+      return Promise.resolve(true);
+    }
+    return new Promise((resolve) => {
+      const waiters =
+          autosaveState.inFlightWaiters.get(scriptId) || new Set();
+      autosaveState.inFlightWaiters.set(scriptId, waiters);
+      let settled = false;
+      const done = (ok) => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timerId);
+        waiters.delete(done);
+        if (!waiters.size) {
+          autosaveState.inFlightWaiters.delete(scriptId);
+        }
+        resolve(ok);
+      };
+      waiters.add(done);
+      const timerId = setTimeout(() => done(false), timeoutMs);
+    });
+  }
+
+  function countPersistableActionsInScript(script) {
+    const countList = (list) => {
+      if (!Array.isArray(list)) return 0;
+      let n = 0;
+      for (const a of list) {
+        if (!a || typeof a !== 'object') continue;
+        if (a.__draft) continue;
+        n++;
+        const t = String(a?.action || '').toLowerCase();
+        if (t === 'if_condition') {
+          n += countList(getNestedActionList(a, 'then', false));
+          n += countList(getNestedActionList(a, 'else', false));
+        } else if (t === 'loop') {
+          n += countList(getLoopStepsList(a, false));
+        } else if (t === 'key_down' || t === 'key') {
+          n += countList(getKeyDownNestedList(a, false));
+        }
+      }
+      return n;
+    };
+    if (!script || typeof script !== 'object') return 0;
+    let n = 0;
+    n += countList(script.actions);
+    if (Array.isArray(script.url_contexts)) {
+      for (const ctx of script.url_contexts) {
+        n += countList(ctx?.actions);
+      }
+    }
+    return n;
+  }
+
+  function scriptHasDraftActions(script) {
+    const hasDraftInList = (list) => {
+      if (!Array.isArray(list)) return false;
+      for (const a of list) {
+        if (a && typeof a === 'object' && a.__draft) return true;
+        const t = String(a?.action || '').toLowerCase();
+        if (t === 'if_condition') {
+          if (hasDraftInList(getNestedActionList(a, 'then', false)) ||
+              hasDraftInList(getNestedActionList(a, 'else', false))) return true;
+        } else if (t === 'loop') {
+          if (hasDraftInList(getLoopStepsList(a, false))) return true;
+        } else if (t === 'key_down' || t === 'key') {
+          if (hasDraftInList(getKeyDownNestedList(a, false))) return true;
+        }
+      }
+      return false;
+    };
+    if (!script || typeof script !== 'object') return false;
+    if (hasDraftInList(script.actions)) return true;
+    if (Array.isArray(script.url_contexts)) {
+      for (const ctx of script.url_contexts) {
+        if (hasDraftInList(ctx?.actions)) return true;
+      }
+    }
+    return false;
+  }
+
+  function cancelAutoSaveTimer(scriptId) {
+    if (!scriptId) return;
+    const prev = autosaveState.timers.get(scriptId);
+    if (prev) clearTimeout(prev);
+    autosaveState.timers.delete(scriptId);
+  }
+
+  async function saveScriptById(
+      scriptId, {silent = true, refreshAfter = false} = {}) {
+    if (!scriptId) return false;
+    const currentScript = appState.scripts[scriptId];
+    if (!currentScript) return false;
+
+    const origCount = countPersistableActionsInScript(currentScript);
+    let normalized = null;
+    try {
+      normalized = normalizeScriptForSave(currentScript);
+    } catch (e) {
+      console.error('[DashboardUI] normalizeScriptForSave failed:', e);
+      if (!silent) {
+        try { alert(`Save failed: ${e?.message || e}`); } catch (_) {}
+      }
+      return false;
+    }
+
+    const normCount = countPersistableActionsInScript(normalized);
+    if (normCount < origCount) {
+      console.warn('[DashboardUI] autosave refused: normalization would drop actions',
+                   {origCount, normCount, scriptId});
+      if (!silent) {
+        try {
+          alert(`Save refused: ${origCount - normCount} action(s) are invalid.`);
+        } catch (_) {}
+      }
+      return false;
+    }
+
+    if (!Array.isArray(normalized.url_contexts)) {
+      normalized.url_contexts = [];
+    }
+
+    await dashboardHandler.saveScript(scriptId, normalized);
+
+    if (refreshAfter) {
+      try {
+        const list = await dashboardHandler.getScripts();
+        if (list && list.scripts) {
+          const prevName = appState.scripts[scriptId]?.name || '';
+          appState.scripts = normalizeScriptsDict(list.scripts || {});
+          if (scriptId && appState.scripts[scriptId]) {
+            appState.currentScriptId = scriptId;
+            if (prevName && !appState.scripts[scriptId].name) {
+              appState.scripts[scriptId].name = prevName;
+            }
+          }
+          renderAll();
+        }
+      } catch (e) {
+        console.warn('[DashboardUI] getScripts after save failed', e);
+      }
+    }
+
+    return true;
+  }
+
+  async function performAutoSave(scriptId, reason) {
+    if (!scriptId) return;
+    const s = appState.scripts?.[scriptId];
+    if (scriptHasDraftActions(s)) return;
+    if (autosaveState.inFlight.get(scriptId)) {
+      autosaveState.pending.add(scriptId);
+      return;
+    }
+    autosaveState.inFlight.set(scriptId, true);
+    autosaveState.pending.delete(scriptId);
+    try {
+      await saveScriptById(scriptId, {silent: true, refreshAfter: false});
+    } catch (e) {
+      console.error('[DashboardUI] autosave failed', {scriptId, reason, error: e});
+    } finally {
+      autosaveState.inFlight.set(scriptId, false);
+      resolveInFlightWaiters(scriptId);
+      if (autosaveState.pending.has(scriptId)) {
+        scheduleAutoSave(scriptId, 'pending', AUTOSAVE_DEBOUNCE_MS);
+      }
+    }
+  }
+
+  function scheduleAutoSave(
+      scriptId, reason = 'edit', delayMs = AUTOSAVE_DEBOUNCE_MS) {
+    if (!scriptId) return;
+    cancelAutoSaveTimer(scriptId);
+    const s = appState.scripts?.[scriptId];
+    if (scriptHasDraftActions(s)) return;
+    const t = setTimeout(() => {
+      autosaveState.timers.delete(scriptId);
+      performAutoSave(scriptId, reason);
+    }, Math.max(0, delayMs));
+    autosaveState.timers.set(scriptId, t);
+  }
+
+  async function flushPendingSavesAndSaveNow(scriptId) {
+    if (!scriptId) return false;
+    cancelAutoSaveTimer(scriptId);
+    if (autosaveState.inFlight.get(scriptId)) {
+      await waitForInFlightToFinish(scriptId, 5000);
+    }
+    return await saveScriptById(scriptId, {silent: true, refreshAfter: false});
+  }
+
+  return {
+    AUTOSAVE_DEBOUNCE_MS,
+    cancelAutoSaveTimer,
+    flushPendingSavesAndSaveNow,
+    performAutoSave,
+    saveScriptById,
+    scheduleAutoSave,
+    scriptHasDraftActions,
+  };
+}
diff --git a/chrome/browser/resources/dashboard/agent/dashboard_schema.js b/chrome/browser/resources/dashboard/agent/dashboard_schema.js
new file mode 100644
index 0000000000000000000000000000000000000000..b08d65c2f504e47def778d9764f662ff5040a8da
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/dashboard_schema.js
@@ -0,0 +1,192 @@
+export function installDashboardSchema({
+  windowRef = window,
+  handler = null,
+  actionMetadata = {},
+} = {}) {
+  function validateActionLocal(action, backendErrorHint = '') {
+    const invalid = (msg) => ({valid: false, error: msg});
+    if (!action || typeof action !== 'object') return invalid('Invalid action.');
+    const type = String(action.action || '').toLowerCase();
+    if (!type) return invalid('Action type is missing.');
+    const params = (action.params && typeof action.params === 'object') ?
+      action.params :
+      {};
+
+    const hasNonEmptyLocators = (locs) => {
+      if (!Array.isArray(locs)) return false;
+      return locs.some((l) => {
+        if (!l || typeof l !== 'object') return false;
+        const v = l.value;
+        if (typeof v === 'string') return v.trim().length > 0;
+        if (typeof v === 'number') return Number.isFinite(v);
+        return v != null;
+      });
+    };
+
+    const hasCoordinates = (p) => {
+      const c = (p && typeof p.coordinates === 'object') ? p.coordinates : null;
+      const x = c ? Number(c.x) : Number(p?.x);
+      const y = c ? Number(c.y) : Number(p?.y);
+      return Number.isFinite(x) && Number.isFinite(y);
+    };
+
+    if (type === 'click') {
+      if (!hasNonEmptyLocators(params.locators) && !hasCoordinates(params)) {
+        return invalid('Click requires locators or coordinates.');
+      }
+    }
+
+    if (type === 'listen') {
+      if (!hasNonEmptyLocators(params.locators)) {
+        return invalid('Listen requires at least one locator.');
+      }
+      const cond = String(params.condition || '').trim();
+      if (!cond) return invalid('Listen requires a condition.');
+      const onMatch = String(params.onMatchScriptId || '').trim();
+      if (!onMatch) return invalid("Listen requires 'On Match: Run Script'.");
+      if (cond.includes('text_') || cond === 'new_child_contains') {
+        if (!String(params.text || '').trim()) {
+          return invalid('Listen condition requires text.');
+        }
+      }
+      if (cond.includes('attribute_')) {
+        if (!String(params.attribute || '').trim()) {
+          return invalid('Listen condition requires an attribute.');
+        }
+        if (!String(params.text || '').trim()) {
+          return invalid('Listen condition requires text.');
+        }
+      }
+    }
+
+    const meta = actionMetadata[type];
+    if (!meta || !meta.params) {
+      if (backendErrorHint) {
+        return invalid(
+            `Action could not be validated by backend: ${backendErrorHint}`);
+      }
+      return {valid: true, error: ''};
+    }
+
+    const evalShowIf = (expr, p) => {
+      if (!expr || typeof expr !== 'string') return true;
+      try {
+        const m = expr.match(
+            /\s*([a-zA-Z0-9_]+)\s*===\s*['\"]?([^'\"]+)['\"]?\s*/);
+        if (!m) return true;
+        const key = m[1];
+        const val = m[2];
+        return String(p?.[key]) === val;
+      } catch (_) {
+        return true;
+      }
+    };
+
+    for (const [key, spec] of Object.entries(meta.params)) {
+      if (!spec || spec.required !== true) continue;
+      if (spec.showIf && !evalShowIf(spec.showIf, params)) continue;
+      const v = params[key];
+      if (spec.type === 'locator-list') {
+        if (!hasNonEmptyLocators(v)) {
+          return invalid(`Missing required locators: ${spec.label || key}`);
+        }
+        continue;
+      }
+      if (spec.type === 'select') {
+        if (!String(v || '').trim()) {
+          return invalid(`Missing required field: ${spec.label || key}`);
+        }
+        continue;
+      }
+      if (spec.type === 'number') {
+        const n = Number(v);
+        if (!Number.isFinite(n)) {
+          return invalid(`Missing required number: ${spec.label || key}`);
+        }
+        continue;
+      }
+      if (v == null || String(v).trim() === '') {
+        return invalid(`Missing required field: ${spec.label || key}`);
+      }
+    }
+
+    return {valid: true, error: ''};
+  }
+
+  const schema = {
+    _supportedActions: null,
+    _handler: null,
+
+    init(nextHandler) {
+      this._handler = nextHandler;
+    },
+
+    createAction(type, params = {}) {
+      return {
+        action: String(type || '').toLowerCase(),
+        params,
+        comment: '',
+      };
+    },
+
+    async getActionTemplate(type) {
+      if (!this._handler) {
+        console.error('[DashboardSchema] Handler not initialized');
+        return this.createAction(type);
+      }
+      if (typeof this._handler.getActionTemplate !== 'function') {
+        return this.createAction(type);
+      }
+      try {
+        const result = await this._handler.getActionTemplate(type);
+        return result.actionTemplate || this.createAction(type);
+      } catch (e) {
+        console.error('[DashboardSchema] Failed to get template:', e);
+        return this.createAction(type);
+      }
+    },
+
+    async getSupportedActions() {
+      if (this._supportedActions) return this._supportedActions;
+      if (!this._handler) {
+        console.error('[DashboardSchema] Handler not initialized');
+        return [];
+      }
+      if (typeof this._handler.getSupportedActions !== 'function') {
+        this._supportedActions = [];
+        return this._supportedActions;
+      }
+      try {
+        const result = await this._handler.getSupportedActions();
+        this._supportedActions = result.actions || [];
+        return this._supportedActions;
+      } catch (e) {
+        console.error('[DashboardSchema] Failed to get supported actions:', e);
+        return [];
+      }
+    },
+
+    async validateAction(action) {
+      if (!this._handler) {
+        console.error('[DashboardSchema] Handler not initialized');
+        return validateActionLocal(action);
+      }
+      if (typeof this._handler.validateAction !== 'function') {
+        return validateActionLocal(action);
+      }
+      try {
+        const result = await this._handler.validateAction(action);
+        return {valid: result.valid, error: result.error};
+      } catch (e) {
+        console.error('[DashboardSchema] Failed to validate action:', e);
+        return validateActionLocal(action, e?.message);
+      }
+    },
+  };
+
+  schema.init(handler);
+  if (windowRef && typeof windowRef === 'object') {
+    windowRef.DashboardSchema = schema;
+  }
+  return schema;
+}
diff --git a/chrome/browser/resources/dashboard/agent/dashboard_script_list.js b/chrome/browser/resources/dashboard/agent/dashboard_script_list.js
new file mode 100644
index 0000000000000000000000000000000000000000..546d666f4a0aa96a26787e623275d99d776b768e
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/dashboard_script_list.js
@@ -0,0 +1,526 @@
+export function renderDashboardScriptList({
+  scriptListEl,
+  appState,
+  onRunSelected,
+  onClearSelected,
+  onToggleSelectScript,
+  onSelectScript,
+}) {
+  scriptListEl.innerHTML = '';
+
+  const controls = document.createElement('div');
+  controls.style.cssText = 'display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px;';
+  const selCount = appState.selectedScripts.length;
+  const runBtn = document.createElement('button');
+  runBtn.className = 'btn btn-primary';
+  runBtn.textContent = selCount ? `Run Selected (${selCount})` : 'Run Selected';
+  runBtn.disabled = selCount === 0 || appState.isQueueRunning;
+  runBtn.onclick = () => onRunSelected();
+  controls.appendChild(runBtn);
+
+  const clearBtn = document.createElement('button');
+  clearBtn.className = 'btn btn-secondary';
+  clearBtn.textContent = 'Clear';
+  clearBtn.disabled = selCount === 0 || appState.isQueueRunning;
+  clearBtn.onclick = () => onClearSelected();
+  controls.appendChild(clearBtn);
+  scriptListEl.appendChild(controls);
+
+  for (const scriptId in appState.scripts) {
+    const script = appState.scripts[scriptId];
+    const isMain = (script.kind || 'main') === 'main';
+    const container = document.createElement('div');
+    container.style.cssText =
+      'display:flex;align-items:center;gap:8px;margin-bottom:6px;';
+
+    const badge = document.createElement('div');
+    badge.style.cssText =
+      'min-width:22px;min-height:22px;border-radius:12px;display:flex;' +
+      'align-items:center;justify-content:center;font-size:12px;' +
+      'font-weight:700;cursor:pointer;user-select:none;';
+    const idx = appState.selectedScripts.indexOf(scriptId);
+    if (idx >= 0) {
+      badge.textContent = (idx + 1).toString();
+      badge.style.background = '#2563eb';
+      badge.style.color = 'white';
+      badge.title = 'Click to remove from queue';
+    } else {
+      badge.textContent = '.';
+      badge.style.background = 'transparent';
+      badge.style.border = '1px solid #9ca3af';
+      badge.style.color = '#9ca3af';
+      badge.title = isMain ? 'Click to add to queue' : 'Only main scripts can be queued';
+    }
+    if (isMain && !appState.isQueueRunning) {
+      badge.addEventListener('click', () => onToggleSelectScript(scriptId));
+    } else {
+      badge.style.opacity = '0.5';
+      badge.style.cursor = 'not-allowed';
+    }
+    container.appendChild(badge);
+
+    const button = document.createElement('button');
+    button.className = 'btn text-left w-full';
+    button.style.cssText = 'flex:1;';
+    button.textContent =
+      script.name + (appState.currentlyExecutingId === scriptId ? '  >' : '');
+    button.onclick = () => onSelectScript(scriptId);
+    if (scriptId === appState.currentScriptId) button.classList.add('active');
+    container.appendChild(button);
+    scriptListEl.appendChild(container);
+  }
+}
+
+export function toggleSelectedScript(appState, scriptId) {
+  const i = appState.selectedScripts.indexOf(scriptId);
+  if (i >= 0) {
+    appState.selectedScripts.splice(i, 1);
+  } else {
+    appState.selectedScripts.push(scriptId);
+  }
+}
+
+export async function runSelectedScriptsQueue({
+  appState,
+  playScript,
+  onRender,
+  waitMs = 0,
+}) {
+  if (appState.isQueueRunning || appState.selectedScripts.length === 0) return;
+
+  const yieldToUI = () => new Promise((resolve) => {
+    if (typeof window !== 'undefined' &&
+        typeof window.requestAnimationFrame === 'function') {
+      window.requestAnimationFrame(() => resolve());
+      return;
+    }
+    setTimeout(resolve, 0);
+  });
+
+  appState.isQueueRunning = true;
+  onRender();
+  try {
+    for (let i = 0; i < appState.selectedScripts.length; i++) {
+      const scriptId = appState.selectedScripts[i];
+      appState.currentlyExecutingId = scriptId;
+      onRender();
+      try {
+        await playScript(scriptId);
+      } catch (e) {
+        console.error('playScript failed', e);
+      }
+      const interScriptDelay = Math.max(0, Number(waitMs) || 0);
+      if (interScriptDelay > 0) {
+        await new Promise((r) => setTimeout(r, interScriptDelay));
+      } else {
+        await yieldToUI();
+      }
+    }
+  } finally {
+    appState.isQueueRunning = false;
+    appState.currentlyExecutingId = null;
+    appState.selectedScripts = [];
+    onRender();
+  }
+}
+
+export function createDashboardScriptCrudController({
+  appState,
+  dashboardHandler,
+  renderAll,
+  inputModalTitleEl,
+  inputModal,
+  scriptNameInput,
+  confirmInputBtn,
+  cancelInputBtn,
+  confirmationModal,
+  confirmationText,
+  confirmActionBtn,
+  cancelConfirmBtn,
+}) {
+  const showInputModal = (title, callback) => {
+    if (!inputModalTitleEl || !inputModal || !scriptNameInput ||
+        !confirmInputBtn || !cancelInputBtn) {
+      return;
+    }
+    inputModalTitleEl.textContent = title;
+    scriptNameInput.value = '';
+    inputModal.classList.remove('hidden');
+
+    const confirmHandler = () => {
+      const maybePromise = callback(scriptNameInput.value);
+      Promise.resolve(maybePromise).finally(cleanup);
+    };
+    const cancelHandler = () => {
+      const maybePromise = callback(null);
+      Promise.resolve(maybePromise).finally(cleanup);
+    };
+    const cleanup = () => {
+      inputModal.classList.add('hidden');
+      confirmInputBtn.removeEventListener('click', confirmHandler);
+      cancelInputBtn.removeEventListener('click', cancelHandler);
+    };
+
+    confirmInputBtn.addEventListener('click', confirmHandler);
+    cancelInputBtn.addEventListener('click', cancelHandler);
+  };
+
+  const showConfirmationModal = (message, callback) => {
+    if (!confirmationModal || !confirmationText ||
+        !confirmActionBtn || !cancelConfirmBtn) {
+      return;
+    }
+    confirmationText.textContent = message;
+    confirmationModal.classList.remove('hidden');
+
+    const confirmHandler = () => {
+      const maybePromise = callback(true);
+      Promise.resolve(maybePromise).finally(cleanup);
+    };
+    const cancelHandler = () => {
+      const maybePromise = callback(false);
+      Promise.resolve(maybePromise).finally(cleanup);
+    };
+    const cleanup = () => {
+      confirmationModal.classList.add('hidden');
+      confirmActionBtn.removeEventListener('click', confirmHandler);
+      cancelConfirmBtn.removeEventListener('click', cancelHandler);
+    };
+
+    confirmActionBtn.addEventListener('click', confirmHandler);
+    cancelConfirmBtn.addEventListener('click', cancelHandler);
+  };
+
+  const handleNewScript = async () => {
+    showInputModal('Enter New Script Name', async (name) => {
+      if (!name) {
+        return;
+      }
+      try {
+        console.log('[DashboardUI] handleNewScript name=', name);
+        const response = await dashboardHandler.createNewScript({name});
+        console.log('[DashboardUI] createNewScript response:', response);
+        const newScriptId = response.scriptId;
+        appState.scripts[newScriptId] = {
+          name,
+          actions: [],
+          settings: {},
+          kind: 'main',
+        };
+        appState.currentScriptId = newScriptId;
+        appState.isEditingAction = false;
+        console.log('[DashboardUI] after create, scripts keys:', Object.keys(appState.scripts));
+        renderAll();
+      } catch (error) {
+        console.error('Failed to create new script:', error);
+      }
+    });
+  };
+
+  const handleDeleteScript = () => {
+    const scriptId = appState.currentScriptId;
+    if (!scriptId || !appState.scripts[scriptId]) {
+      return;
+    }
+    const scriptName = appState.scripts[scriptId].name;
+    showConfirmationModal(
+      `Are you sure you want to delete "${scriptName}"?`,
+      (confirmed) => {
+        if (!confirmed) {
+          return;
+        }
+        delete appState.scripts[scriptId];
+        console.log('[DashboardUI] deleteScript id=', scriptId);
+        dashboardHandler.deleteScript(scriptId);
+        appState.currentScriptId = Object.keys(appState.scripts)[0] || null;
+        appState.isEditingAction = false;
+        renderAll();
+      });
+  };
+
+  return {
+    handleDeleteScript,
+    handleNewScript,
+    showConfirmationModal,
+    showInputModal,
+  };
+}
+
+export function createDashboardScriptSettingsController({
+  appState,
+  renderAll,
+  scheduleAutoSave,
+  flushPendingSavesAndSaveNow,
+  documentRef = document,
+  modalId = 'script-settings-modal',
+}) {
+  const byId = (id) => documentRef.getElementById(id);
+
+  const ensureListenerContextStartUrl = (script, startUrl) => {
+    if (!script || (script.kind || 'main') !== 'listener') {
+      return;
+    }
+    script.url_contexts = script.url_contexts || [{url: '', actions: []}];
+    if (!script.url_contexts[0]) {
+      script.url_contexts[0] = {url: '', actions: []};
+    }
+    script.url_contexts[0].url = startUrl;
+  };
+
+  const closeModal = (modal) => {
+    if (!modal) return;
+    modal.innerHTML = '';
+    modal.classList.add('hidden');
+  };
+
+  const persistModalState = async ({
+    scriptId,
+    currentScript,
+    startUrlInput,
+    applyExecutionFrequencyFromControls,
+  }) => {
+    try {
+      applyExecutionFrequencyFromControls();
+      if (startUrlInput) {
+        const nextStartUrl = String(startUrlInput.value || '');
+        currentScript.startUrl = nextStartUrl;
+        ensureListenerContextStartUrl(currentScript, nextStartUrl);
+      }
+      // Serialize with pending autosaves so older in-flight saves cannot
+      // overwrite the latest values when the modal closes quickly.
+      await flushPendingSavesAndSaveNow(scriptId);
+    } catch (_) {
+    }
+  };
+
+  function openScriptSettingsModal() {
+    const modal = byId(modalId);
+    if (!modal) return;
+    const scriptId = appState.currentScriptId;
+    const currentScript = appState.scripts[scriptId];
+    if (!currentScript) return;
+
+    let startUrlInput = null;
+    let applyExecutionFrequencyFromControls = () => {};
+    modal.classList.remove('hidden');
+
+    const content = documentRef.createElement('div');
+    content.className = 'modal-content';
+    content.innerHTML = '<h3 class="modal-header">Script Settings (Overrides)</h3>';
+    const body = documentRef.createElement('div');
+    body.id = 'script-settings-body';
+
+    const kindRow = documentRef.createElement('div');
+    kindRow.style.cssText =
+      'margin-bottom:12px; display:flex; align-items:center; gap:8px;';
+    const kindLabel = documentRef.createElement('label');
+    kindLabel.textContent = 'Script Type:';
+    const kindSelect = documentRef.createElement('select');
+    [
+      {value: 'normal', label: 'normal'},
+      {value: 'login', label: 'key'},
+      {value: 'listener', label: 'listener'},
+    ].forEach(({value, label}) => {
+      const opt = documentRef.createElement('option');
+      opt.value = value;
+      opt.textContent = label;
+      kindSelect.appendChild(opt);
+    });
+    const initialKind =
+      (currentScript.kind === 'main') ? 'normal' : (currentScript.kind || 'normal');
+    kindSelect.value = initialKind;
+    kindRow.appendChild(kindLabel);
+    kindRow.appendChild(kindSelect);
+    body.appendChild(kindRow);
+
+    const keyRow = documentRef.createElement('div');
+    keyRow.style.cssText =
+      'margin-bottom:12px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;';
+    const keyLabel = documentRef.createElement('label');
+    keyLabel.textContent = 'Key Script:';
+    const keySelect = documentRef.createElement('select');
+    const noneOpt = documentRef.createElement('option');
+    noneOpt.value = '';
+    noneOpt.textContent = '(none)';
+    keySelect.appendChild(noneOpt);
+
+    const scripts = appState.scripts || {};
+    const desiredKeyId = String(currentScript.keyScriptId || '').trim();
+    let hasDesired = false;
+    Object.entries(scripts).forEach(([sid, script]) => {
+      if (!script || sid === scriptId) return;
+      const kind = script.kind || 'main';
+      if (kind === 'listener') return;
+      if (sid === desiredKeyId) hasDesired = true;
+      const opt = documentRef.createElement('option');
+      opt.value = sid;
+      const kindTag = kind && kind !== 'main' ? ` [${kind}]` : '';
+      opt.textContent = script.name ? `${script.name}${kindTag}` : `${sid}${kindTag}`;
+      keySelect.appendChild(opt);
+    });
+
+    if (desiredKeyId && !hasDesired) {
+      const missingOpt = documentRef.createElement('option');
+      missingOpt.value = desiredKeyId;
+      missingOpt.textContent = `(missing) ${desiredKeyId}`;
+      keySelect.insertBefore(missingOpt, keySelect.children[1] || null);
+    }
+
+    keySelect.value = desiredKeyId;
+    keySelect.onchange = () => {
+      const value = String(keySelect.value || '').trim();
+      currentScript.keyScriptId = value || undefined;
+      scheduleAutoSave(scriptId, 'key-script', 0);
+    };
+    keyRow.appendChild(keyLabel);
+    keyRow.appendChild(keySelect);
+    body.appendChild(keyRow);
+
+    const kindSpecificRows = documentRef.createElement('div');
+    body.appendChild(kindSpecificRows);
+
+    const renderKindSpecificRows = () => {
+      kindSpecificRows.innerHTML = '';
+      startUrlInput = null;
+      applyExecutionFrequencyFromControls = () => {};
+
+      const currentKind = currentScript.kind || 'main';
+      const isListenerKind = currentKind === 'listener';
+      const isKeyKind = currentKind === 'login';
+
+      if (isKeyKind) {
+        currentScript.keyScriptId = undefined;
+      }
+      keyRow.style.display = isKeyKind ? 'none' : 'flex';
+
+      const urlRow = documentRef.createElement('div');
+      urlRow.style.cssText =
+        'margin:12px 0; display:flex; align-items:center; gap:8px; flex-wrap:wrap;';
+      const urlLabel = documentRef.createElement('label');
+      urlLabel.textContent = isListenerKind ?
+        'Listener Start URL:' :
+        'Start URL (optional):';
+      const urlInput = documentRef.createElement('input');
+      urlInput.type = 'text';
+      urlInput.className = 'input-field';
+      urlInput.style.minWidth = '360px';
+      startUrlInput = urlInput;
+      const legacyContextUrl =
+        (Array.isArray(currentScript.url_contexts) && currentScript.url_contexts[0]) ?
+          String(currentScript.url_contexts[0].url || '') :
+          '';
+      urlInput.value = String(currentScript.startUrl || legacyContextUrl || '');
+      urlInput.placeholder = 'https://… (leave empty to rely on first navigate action)';
+      urlInput.addEventListener('input', () => {
+        const nextStartUrl = String(urlInput.value || '');
+        currentScript.startUrl = nextStartUrl;
+        ensureListenerContextStartUrl(currentScript, nextStartUrl);
+      });
+      urlInput.addEventListener('blur', () => {
+        scheduleAutoSave(
+          scriptId,
+          isListenerKind ? 'listener-start-url' : 'script-start-url');
+      });
+      urlRow.appendChild(urlLabel);
+      urlRow.appendChild(urlInput);
+      kindSpecificRows.appendChild(urlRow);
+      if (isListenerKind || isKeyKind) {
+        return;
+      }
+
+      const freqRow = documentRef.createElement('div');
+      freqRow.style.cssText =
+        'margin:12px 0; display:flex; align-items:center; gap:8px; flex-wrap:wrap;';
+      const freqLabel = documentRef.createElement('label');
+      freqLabel.textContent = 'Execution Frequency:';
+      const prefix = documentRef.createElement('span');
+      prefix.textContent = 'Run this script every';
+      const freqInput = documentRef.createElement('input');
+      freqInput.type = 'number';
+      freqInput.min = '1';
+      freqInput.style.width = '80px';
+      const unitSelect = documentRef.createElement('select');
+      ['minutes', 'hours', 'days'].forEach((unit) => {
+        const opt = documentRef.createElement('option');
+        opt.value = unit;
+        opt.textContent = unit;
+        unitSelect.appendChild(opt);
+      });
+      const ef =
+        (currentScript.settingsOverrides &&
+         currentScript.settingsOverrides.executionFrequency) || null;
+      if (ef && typeof ef.value === 'number') {
+        freqInput.value = String(ef.value);
+      }
+      unitSelect.value = (ef && ef.unit) ? ef.unit : 'minutes';
+      applyExecutionFrequencyFromControls = () => {
+        currentScript.settingsOverrides = currentScript.settingsOverrides || {};
+        const value = parseInt(freqInput.value, 10);
+        if (!isNaN(value) && value > 0) {
+          currentScript.settingsOverrides.executionFrequency = {
+            value,
+            unit: unitSelect.value,
+          };
+        } else {
+          currentScript.settingsOverrides.executionFrequency = null;
+        }
+      };
+      const onChange = () => {
+        applyExecutionFrequencyFromControls();
+        scheduleAutoSave(scriptId, 'exec-frequency', 0);
+      };
+      freqInput.addEventListener('input', onChange);
+      unitSelect.addEventListener('change', onChange);
+      freqRow.appendChild(freqLabel);
+      freqRow.appendChild(prefix);
+      freqRow.appendChild(freqInput);
+      freqRow.appendChild(unitSelect);
+      kindSpecificRows.appendChild(freqRow);
+    };
+
+    kindSelect.onchange = () => {
+      currentScript.kind =
+        (kindSelect.value === 'normal') ? 'main' : kindSelect.value;
+      if ((currentScript.kind || 'main') === 'login') {
+        currentScript.keyScriptId = undefined;
+      }
+      renderKindSpecificRows();
+      scheduleAutoSave(scriptId, 'script-kind', 0);
+      renderAll();
+    };
+
+    renderKindSpecificRows();
+    content.appendChild(body);
+
+    const actions = documentRef.createElement('div');
+    actions.className = 'modal-actions';
+    const closeBtn = documentRef.createElement('button');
+    closeBtn.className = 'btn';
+    closeBtn.textContent = 'Close';
+    const persistAndClose = async () => {
+      await persistModalState({
+        scriptId,
+        currentScript,
+        startUrlInput,
+        applyExecutionFrequencyFromControls,
+      });
+      closeModal(modal);
+    };
+    closeBtn.onclick = () => {
+      void persistAndClose();
+    };
+    actions.appendChild(closeBtn);
+    content.appendChild(actions);
+    modal.innerHTML = '';
+    modal.appendChild(content);
+
+    modal.onclick = (e) => {
+      if (e.target !== modal) return;
+      void persistAndClose();
+    };
+  }
+
+  return {
+    openScriptSettingsModal,
+  };
+}
