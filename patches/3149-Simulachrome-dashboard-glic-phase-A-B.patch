diff --git a/chrome/browser/resources/automation_engine.js b/chrome/browser/resources/automation_engine.js
new file mode 100644
index 0000000000000000000000000000000000000000..257d9b1f79e24e1d2f988ce53702d8fd1274732d
--- /dev/null
+++ b/chrome/browser/resources/automation_engine.js
@@ -0,0 +1,410 @@
+// Automation Engine Enhancement: Selector Generation and Playback with GLIC fallback
+// This script can be injected into a renderer process. It implements recording of DOM selectors
+// with specificity scoring, and a playback loop that attempts to locate elements using a
+// pre‑sorted selector list. If all selectors fail, it captures a lightweight DOM snapshot
+// and queries a GLIC‑powered model for a new selector.
+
+// ---------------------------------------------------------------------------
+// Utility: Get full DOM path for an element (e.g. "html > body > div#main > ul > li.item")
+function getDomPath(element) {
+  if (!element) return '';
+  const parts = [];
+  while (element && element.nodeType === Node.ELEMENT_NODE) {
+    let selector = element.tagName.toLowerCase();
+    if (element.id) {
+      selector += `#${element.id}`;
+    } else {
+      const classList = Array.from(element.classList);
+      if (classList.length) selector += `.${classList.join('.')}`;
+      // Add nth‑child position to make the path explicit
+      const siblingIndex = Array.from(element.parentNode.children).indexOf(element) + 1;
+      selector += `:nth-child(${siblingIndex})`;
+    }
+    parts.unshift(selector);
+    element = element.parentElement;
+  }
+  return parts.join(' > ');
+}
+
+// Utility: Compute specificity score for a selector string
+// ID selectors (=10), direct‑child/explicit‑path selectors (=8), attribute selectors (=6),
+// class selectors (=4), tag selectors (=2)
+function computeSpecificity(selector) {
+  let score = 0;
+  // ID selector
+  if (/#/g.test(selector)) score += 10 * (selector.match(/#/g) || []).length;
+  // Direct‑child selector (>) or explicit path (contains '>')
+  if (/\>/g.test(selector)) score += 8 * (selector.match(/\>/g) || []).length;
+  // Attribute selector
+  if (/\[/g.test(selector)) score += 6 * (selector.match(/\[/g) || []).length;
+  // Class selector
+  if (/\./g.test(selector)) score += 4 * (selector.match(/\./g) || []).length;
+  // Tag selector (any alphanumeric token not preceded by # . [ : > )
+  const tagMatches = selector.match(/(^|\s|\+|\~)([a-zA-Z][a-zA-Z0-9]*)/g);
+  if (tagMatches) score += 2 * tagMatches.length;
+  return score;
+}
+
+// Recording: Generate selector array for a target element and sort by specificity
+function generateSortedSelectors(element) {
+  if (!element) return [];
+  const selectors = new Set();
+  // 1. ID selector (if present)
+  if (element.id) selectors.add(`#${element.id}`);
+  // 2. Class selectors
+  element.classList.forEach(cls => selectors.add(`.${cls}`));
+  // 3. Attribute selectors (data‑*, title, etc.)
+  Array.from(element.attributes).forEach(attr => {
+    if (attr.name.startsWith('data-') || ['title', 'alt', 'name'].includes(attr.name)) {
+      selectors.add(`[${attr.name}="${attr.value}"]`);
+    }
+  });
+  // 4. Tag selector
+  selectors.add(element.tagName.toLowerCase());
+  // 5. Full DOM path (explicit path selector)
+  selectors.add(getDomPath(element));
+
+  // Convert to array and compute specificity for each
+  const scored = Array.from(selectors).map(sel => ({ selector: sel, score: computeSpecificity(sel) }));
+  // Sort descending by specificity score
+  scored.sort((a, b) => b.score - a.score);
+  return scored.map(item => item.selector);
+}
+
+function normalizeLocatorLike(locator) {
+  if (!locator) return null;
+  if (typeof locator === 'string') {
+    const trimmed = locator.trim();
+    if (!trimmed) return null;
+    if (trimmed.startsWith('xpath:')) {
+      return { type: 'XPATH', value: trimmed.slice(6).trim() };
+    }
+    if (trimmed.startsWith('xpath=')) {
+      return { type: 'XPATH', value: trimmed.slice(6).trim() };
+    }
+    return { type: 'CSS_SELECTOR', value: trimmed };
+  }
+  if (typeof locator === 'object') {
+    const t = String(locator.type || '').toUpperCase();
+    const v = String(locator.value || '').trim();
+    if (!v) return null;
+    if (t === 'CSS' || t === 'CSS_SELECTOR' || t === 'SELECTOR') {
+      return { type: 'CSS_SELECTOR', value: v };
+    }
+    if (t === 'XPATH') {
+      return { type: 'XPATH', value: v };
+    }
+  }
+  return null;
+}
+
+function findElementByLocator(locator) {
+  const normalized = normalizeLocatorLike(locator);
+  if (!normalized) return null;
+  if (normalized.type === 'CSS_SELECTOR') {
+    try {
+      return document.querySelector(normalized.value);
+    } catch (_) {
+      return null;
+    }
+  }
+  if (normalized.type === 'XPATH') {
+    try {
+      const x = document.evaluate(
+        normalized.value,
+        document,
+        null,
+        XPathResult.FIRST_ORDERED_NODE_TYPE,
+        null);
+      return x ? x.singleNodeValue : null;
+    } catch (_) {
+      return null;
+    }
+  }
+  return null;
+}
+
+function countLocatorMatches(locator) {
+  const normalized = normalizeLocatorLike(locator);
+  if (!normalized) return -1;
+  if (normalized.type === 'CSS_SELECTOR') {
+    try {
+      return document.querySelectorAll(normalized.value).length;
+    } catch (_) {
+      return -1;
+    }
+  }
+  if (normalized.type === 'XPATH') {
+    try {
+      const result = document.evaluate(
+        normalized.value,
+        document,
+        null,
+        XPathResult.ORDERED_NODE_SNAPSHOT_TYPE,
+        null);
+      return result ? result.snapshotLength : -1;
+    } catch (_) {
+      return -1;
+    }
+  }
+  return -1;
+}
+
+function verifyLocatorUniqueness(locator) {
+  const normalized = normalizeLocatorLike(locator);
+  if (!normalized) {
+    return { unique: false, count: -1, error: 'Invalid locator' };
+  }
+  const count = countLocatorMatches(normalized);
+  if (count < 0) {
+    return { unique: false, count, error: 'Selector evaluation failed' };
+  }
+  return { unique: count === 1, count, error: '' };
+}
+
+function buildMinimalUniqueLocator(locatorBundle) {
+  const locators = Array.isArray(locatorBundle) ? locatorBundle : [];
+  const candidates = [];
+  for (const loc of locators) {
+    const normalized = normalizeLocatorLike(loc);
+    if (!normalized) continue;
+    candidates.push(normalized);
+  }
+  const seen = new Set();
+  const deduped = [];
+  for (const c of candidates) {
+    const key = `${c.type}|${c.value}`;
+    if (seen.has(key)) continue;
+    seen.add(key);
+    deduped.push(c);
+  }
+  deduped.sort((a, b) => {
+    const typeWeightA = a.type === 'CSS_SELECTOR' ? 0 : 1000;
+    const typeWeightB = b.type === 'CSS_SELECTOR' ? 0 : 1000;
+    return (typeWeightA + a.value.length) - (typeWeightB + b.value.length);
+  });
+
+  for (const loc of deduped) {
+    const check = verifyLocatorUniqueness(loc);
+    if (check.unique) {
+      return { ...loc, count: check.count };
+    }
+  }
+  return null;
+}
+
+function insertActionIntoTimeline(timeline, action, index = null) {
+  if (!Array.isArray(timeline) || !action || typeof action !== 'object') {
+    throw new Error('Invalid timeline insertion payload');
+  }
+  const at = Number.isInteger(index) ? Math.max(0, Math.min(index, timeline.length)) : timeline.length;
+  timeline.splice(at, 0, action);
+  return at;
+}
+
+function prependLocatorForPlaybackTarget(target, locator) {
+  if (!target || typeof target !== 'object') return;
+  const normalized = normalizeLocatorLike(locator);
+  if (!normalized) return;
+
+  target.locators = Array.isArray(target.locators) ? target.locators : [];
+  target.locators.unshift({ type: normalized.type, value: normalized.value });
+
+  if (normalized.type === 'CSS_SELECTOR') {
+    target.selectors = Array.isArray(target.selectors) ? target.selectors : [];
+    target.selectors.unshift(normalized.value);
+  }
+}
+
+// Playback: Attempt to locate element using pre‑sorted selectors; fallback to GLIC model
+async function playbackFind(action) {
+  if (!action || !action.target ||
+      (!Array.isArray(action.target.selectors) && !Array.isArray(action.target.locators))) {
+    throw new Error('Invalid action format for playbackFind');
+  }
+  const selectors = Array.isArray(action.target.selectors) ? action.target.selectors : [];
+  const locators = Array.isArray(action.target.locators) ? action.target.locators : [];
+  const locatorAttempts = [...locators, ...selectors];
+  let element = null;
+  // Try each locator in order.
+  for (const loc of locatorAttempts) {
+    element = findElementByLocator(loc);
+    if (element) break;
+  }
+
+  // If not found, perform GLIC fallback
+  if (!element) {
+    const snapshot = getLightDomSnapshot();
+    const payload = {
+      type: 'playback_find',
+      original: action.target, // original target description (could include locator info)
+      currentPage: snapshot,
+    };
+    try {
+      const response = await sendGLICRequest(payload);
+      if (response && (typeof response.selector === 'string' || Array.isArray(response.locators))) {
+        const candidates = [];
+        if (typeof response.selector === 'string') {
+          candidates.push(response.selector);
+        }
+        if (Array.isArray(response.locators)) {
+          candidates.push(...response.locators);
+        }
+
+        const selected = buildMinimalUniqueLocator(candidates);
+        if (!selected) {
+          throw new Error('GLIC selector fallback failed uniqueness check');
+        }
+
+        const newEl = findElementByLocator(selected);
+        if (newEl) {
+          // Prepend the new locator to the playback target for future runs.
+          prependLocatorForPlaybackTarget(action.target, selected);
+          // Optionally update text content for verification
+          if (newEl.textContent) {
+            action.target.text = newEl.textContent.trim();
+          }
+          // Log diagnostic information
+          console.log('GLIC patched selector:', selected);
+          // Record history entry
+          const entry = {
+            timestamp: new Date().toISOString(),
+            selector: selected.value,
+            selectorType: selected.type,
+            success: true,
+            source: 'GLIC',
+          };
+          action.target.history = action.target.history || [];
+          action.target.history.push(entry);
+          element = newEl;
+        } else {
+          // Model returned selector but still not found
+          const entry = {
+            timestamp: new Date().toISOString(),
+            selector: selected.value,
+            selectorType: selected.type,
+            success: false,
+            source: 'GLIC',
+          };
+          action.target.history = action.target.history || [];
+          action.target.history.push(entry);
+          throw new Error(`GLIC returned locator that does not exist: ${selected.value}`);
+        }
+      } else {
+        throw new Error('Invalid response from GLIC model');
+      }
+    } catch (err) {
+      // Record fallback failure and re‑throw to allow script continuation
+      const entry = {
+        timestamp: new Date().toISOString(),
+        selector: null,
+        success: false,
+        source: 'GLIC',
+        error: err.message,
+      };
+      action.target.history = action.target.history || [];
+      action.target.history.push(entry);
+      console.error('GLIC fallback failed:', err);
+      throw err; // Propagate so caller can decide how to continue
+    }
+  }
+  // Return the located element (or null if not found after fallback)
+  return element;
+}
+
+// Lightweight DOM snapshot – captures tag name, id, classes and a few attributes for each element
+function getLightDomSnapshot() {
+  function walk(node) {
+    if (node.nodeType !== Node.ELEMENT_NODE) return null;
+    const obj = {
+      tag: node.tagName.toLowerCase(),
+      id: node.id || null,
+      classes: node.className ? node.className.split(/\s+/) : [],
+      attrs: {},
+      children: [],
+    };
+    // Capture a limited set of attributes that are often useful
+    ['title', 'alt', 'role', 'type', 'name', 'value', 'placeholder'].forEach(name => {
+      if (node.hasAttribute(name)) obj.attrs[name] = node.getAttribute(name);
+    });
+    node.childNodes.forEach(child => {
+      const childObj = walk(child);
+      if (childObj) obj.children.push(childObj);
+    });
+    return obj;
+  }
+  return walk(document.documentElement);
+}
+
+// Messaging wrapper to the native GLIC model. This uses the Chrome extension messaging API.
+function sendGLICRequest(payload) {
+  return new Promise((resolve, reject) => {
+    // The extension side should expose a native messaging port named 'glic'.
+    // For simplicity we use chrome.runtime.sendMessage; the background script must
+    // forward the request to the native host.
+    if (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.sendMessage) {
+      chrome.runtime.sendMessage('glic', payload, response => {
+        if (chrome.runtime.lastError) {
+          reject(new Error(chrome.runtime.lastError.message));
+        } else {
+          resolve(response);
+        }
+      });
+    } else {
+      reject(new Error('Chrome messaging API unavailable'));
+    }
+  });
+}
+
+// Example of how a recorded action might look and be played back.
+// This snippet demonstrates usage but is not executed automatically.
+/*
+const recordedAction = {
+  type: 'click',
+  target: {
+    selectors: generateSortedSelectors(document.querySelector('#myButton')),
+    text: null,
+    history: [],
+  },
+};
+
+(async () => {
+  try {
+    const el = await playbackFind(recordedAction);
+    if (el) el.click();
+  } catch (e) {
+    console.error('Playback failed for action', recordedAction, e);
+  }
+})();
+*/
+
+// Export functions for external use (e.g., unit tests)
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = {
+    getDomPath,
+    computeSpecificity,
+    generateSortedSelectors,
+    normalizeLocatorLike,
+    verifyLocatorUniqueness,
+    buildMinimalUniqueLocator,
+    insertActionIntoTimeline,
+    playbackFind,
+    getLightDomSnapshot,
+    sendGLICRequest,
+  };
+}
+
+if (typeof window !== 'undefined') {
+  window.AutomationEngineUtils = {
+    getDomPath,
+    computeSpecificity,
+    generateSortedSelectors,
+    normalizeLocatorLike,
+    verifyLocatorUniqueness,
+    buildMinimalUniqueLocator,
+    insertActionIntoTimeline,
+    playbackFind,
+    getLightDomSnapshot,
+    sendGLICRequest,
+  };
+}
