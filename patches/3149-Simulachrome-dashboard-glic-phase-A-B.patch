+
+  if (const std::string* t = params.FindString("text"))
+    text_ = *t;
+  if (const std::string* a = params.FindString("attribute"))
+    attribute_ = *a;
+
+  on_match_script_id_.clear();
+  if (const std::string* s = params.FindString("onMatchScriptId"))
+    on_match_script_id_ = *s;
+
+  timeout_ms_ = params.FindInt("timeout_ms").value_or(60000);
+
+  base::Value::Dict out = params.Clone();
+  if (frame_hint_) {
+    out.Set("frame_id", base::StringPrintf("%d,%d", frame_hint_->child_id,
+                                          frame_hint_->frame_routing_id));
+  }
+  out.Set("condition", condition_);
+  out.Set("text", text_);
+  out.Set("attribute", attribute_);
+  out.Set("timeout_ms", timeout_ms_);
+  if (!on_match_script_id_.empty()) {
+    out.Set("onMatchScriptId", on_match_script_id_);
+  }
+  SetSerializedAction("listen", std::move(out));
+  return true;
+}
+
+void ListenAction::Execute(content::WebContents* web_contents, Callback callback) {
+  callback_ = std::move(callback);
+
+  if (!web_contents) {
+    Finish(false, "No web contents");
+    return;
+  }
+
+  content::RenderFrameHost* rfh = nullptr;
+  if (frame_hint_) {
+    rfh = content::RenderFrameHost::FromID(*frame_hint_);
+  }
+  if (!rfh) {
+    rfh = web_contents->GetPrimaryMainFrame();
+  }
+  if (!rfh) {
+    Finish(false, "No render frame for listen target");
+    return;
+  }
+
+  LOG(INFO) << "[ListenAction] Begin condition=" << condition_
+            << " timeout_ms=" << timeout_ms_
+            << " locators=" << locators_.size()
+            << " url="
+            << (web_contents->GetLastCommittedURL().is_valid()
+                    ? web_contents->GetLastCommittedURL().spec()
+                    : std::string("<invalid>"));
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    base::Value::List locators_log;
+    for (const auto& l : locators_) {
+      locators_log.Append(dashboard::LocatorToValue(l));
+    }
+    LOG(INFO) << "[ListenAction] Execute: locators=" << locators_.size()
+              << " condition=" << condition_
+              << " text=" << TruncateForLog(text_, 160)
+              << " attribute=" << attribute_
+              << " timeout_ms=" << timeout_ms_
+              << " frame_id_hint="
+              << (frame_hint_
+                      ? base::StringPrintf("%d,%d", frame_hint_->child_id,
+                                           frame_hint_->frame_routing_id)
+                      : std::string("<primary>"))
+              << " url="
+              << (web_contents->GetLastCommittedURL().is_valid()
+                      ? web_contents->GetLastCommittedURL().spec()
+                      : std::string("<invalid>"))
+              << " locators_json="
+              << ValueToCompactLog(base::Value(locators_log.Clone()), 1400);
+  }
+
+  token_ = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  start_time_ = base::TimeTicks::Now();
+  target_frame_id_ = rfh->GetGlobalId();
+  StartListenerInFrame(rfh);
+}
+
+void ListenAction::StartListenerInFrame(content::RenderFrameHost* rfh) {
+  base::Value::List locs;
+  for (const auto& l : locators_) {
+    locs.Append(dashboard::LocatorToValue(l));
+  }
+  std::string loc_json;
+  base::JSONWriter::Write(locs, &loc_json);
+
+  std::string token_json;
+  base::JSONWriter::Write(base::Value(token_), &token_json);
+  std::string cond_json;
+  base::JSONWriter::Write(base::Value(condition_), &cond_json);
+  std::string text_json;
+  base::JSONWriter::Write(base::Value(text_), &text_json);
+  std::string attr_json;
+  base::JSONWriter::Write(base::Value(attribute_), &attr_json);
+
+  LOG(INFO) << "[ListenAction] Install request token=" << token_
+            << " condition=" << condition_
+            << " timeout_ms=" << timeout_ms_;
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ListenAction] Installing renderer listener: token="
+              << token_ << " timeout_ms=" << timeout_ms_
+              << " condition=" << condition_
+              << " text=" << TruncateForLog(text_, 160)
+              << " attribute=" << attribute_
+              << " locators_json=" << TruncateForLog(loc_json, 1400);
+  }
+
+  // Start the renderer-side observer/promise, but return a synchronous result
+  // so we can confirm installation. Completion is detected by polling a DOM
+  // attribute updated by the promise's `finish()` handler.
+  std::string js = base::StringPrintf(
+      "(function(){"
+      "  try { (%s)(%s, %s, %s, %s, %s, %d); return {ok:true}; }"
+      "  catch(e) { return {ok:false, reason:String(e)}; }"
+      "})()",
+      kListenWaitJs, token_json.c_str(), loc_json.c_str(), cond_json.c_str(),
+      text_json.c_str(), attr_json.c_str(), timeout_ms_);
+
+  rfh->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(js),
+      base::BindOnce(&ListenAction::OnListenerInstalled,
+                     weak_ptr_factory_.GetWeakPtr()),
+      content::ISOLATED_WORLD_ID_CONTENT_END);
+}
+
+void ListenAction::OnListenerInstalled(base::Value result) {
+  LOG(INFO) << "[ListenAction] Install callback raw="
+            << ValueToCompactLog(result, 700);
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ListenAction] Listener install result: "
+              << ValueToCompactLog(result, 1000);
+  }
+
+  bool ok = false;
+  std::string reason;
+  if (const base::Value::Dict* d = result.GetIfDict()) {
+    ok = d->FindBool("ok").value_or(false);
+    if (const std::string* r = d->FindString("reason"))
+      reason = *r;
+  }
+  if (!ok) {
+    LOG(WARNING) << "[ListenAction] Install failed reason="
+                 << (reason.empty() ? std::string("<empty>") : reason);
+    Finish(false, reason.empty() ? "Listen install failed" : reason);
+    return;
+  }
+  LOG(INFO) << "[ListenAction] Install succeeded token=" << token_;
+  PollListenerState();
+}
+
+void ListenAction::PollListenerState() {
+  if (callback_.is_null())
+    return;
+
+  if (timeout_ms_ > 0 &&
+      base::TimeTicks::Now() - start_time_ >
+          base::Milliseconds(timeout_ms_ + 5000)) {
+    Finish(false, "Listen timed out");
+    return;
+  }
+
+  content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(target_frame_id_);
+  if (!rfh) {
+    Finish(false, "Listen target frame disappeared");
+    return;
+  }
+
+  std::string token_json;
+  base::JSONWriter::Write(base::Value(token_), &token_json);
+  std::string js = base::StringPrintf(
+      "(function(token){"
+      "  try {"
+      "    const el = document && document.documentElement;"
+      "    if (!el) return {ok:false, satisfied:false, reason:'no-document'};"
+      "    const t = String(el.getAttribute('data-simulachrome-listen-token') || '');"
+      "    if (t !== String(token || '')) return {ok:false, satisfied:false, reason:'no-state'};"
+      "    const s = String(el.getAttribute('data-simulachrome-listen-state') || '');"
+      "    if (!s) return {ok:false, satisfied:false, reason:'no-state'};"
+      "    return JSON.parse(s);"
+      "  } catch(e) {"
+      "    return {ok:false, satisfied:false, reason:String(e)};"
+      "  }"
+      "})(%s)",
+      token_json.c_str());
+
+  rfh->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(js),
+      base::BindOnce(&ListenAction::OnListenerStatePolled,
+                     weak_ptr_factory_.GetWeakPtr()),
+      content::ISOLATED_WORLD_ID_CONTENT_END);
+}
+
+void ListenAction::OnListenerStatePolled(base::Value result) {
+  const base::Value::Dict* d = result.GetIfDict();
+  if (d) {
+    const std::string reason = d->FindString("reason") ? *d->FindString("reason")
+                                                      : std::string();
+    const bool satisfied = d->FindBool("satisfied").value_or(false);
+    const bool ok = d->FindBool("ok").value_or(false);
+
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      const bool is_idle_poll =
+          (!satisfied && ok && (reason == "armed" || reason.empty())) ||
+          (!satisfied && !ok && reason == "no-state");
+      if (!is_idle_poll) {
+        LOG(INFO) << "[ListenAction] Poll state: "
+                  << ValueToCompactLog(result, 1200);
+      }
+    }
+
+    if (!satisfied && ok && (reason == "armed" || reason.empty())) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&ListenAction::PollListenerState,
+                         weak_ptr_factory_.GetWeakPtr()),
+          base::Milliseconds(250));
+      return;
+    }
+    if (!satisfied && !ok && reason == "no-state") {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&ListenAction::PollListenerState,
+                         weak_ptr_factory_.GetWeakPtr()),
+          base::Milliseconds(250));
+      return;
+    }
+  }
+
+  OnListenerCompleted(std::move(result));
+}
+
+void ListenAction::OnListenerCompleted(base::Value result) {
+  LOG(INFO) << "[ListenAction] Completed raw_state="
+            << ValueToCompactLog(result, 1200);
+
+  bool ok = false;
+  bool satisfied = false;
+  std::string reason;
+  std::optional<bool> exists;
+  std::optional<bool> visible;
+  std::optional<int> child_count;
+  std::string text;
+  std::string attr;
+  std::string author;
+  std::string timestamp;
+  std::string article_text;
+  std::string chosen_type;
+  std::optional<int> chosen_index;
+  std::string chosen_tag;
+  std::string chosen_value;
+  std::string page_url;
+  std::string ready_state;
+  std::string locator_debug_json;
+  std::string match_key;
+  std::vector<std::string> match_keys;
+
+  if (const base::Value::Dict* d = result.GetIfDict()) {
+    ok = d->FindBool("ok").value_or(false);
+    satisfied = d->FindBool("satisfied").value_or(false);
+    if (const std::string* r = d->FindString("reason"))
+      reason = *r;
+    if (std::optional<bool> v = d->FindBool("exists"))
+      exists = *v;
+    if (std::optional<bool> v = d->FindBool("visible"))
+      visible = *v;
+    if (std::optional<int> v = d->FindInt("childCount"))
+      child_count = *v;
+    if (const std::string* v = d->FindString("text"))
+      text = *v;
+    if (const std::string* v = d->FindString("attr"))
+      attr = *v;
+    if (const std::string* v = d->FindString("author"))
+      author = *v;
+    if (const std::string* v = d->FindString("timestamp"))
+      timestamp = *v;
+    if (const std::string* v = d->FindString("articleText"))
+      article_text = *v;
+    if (const std::string* v = d->FindString("chosenType"))
+      chosen_type = *v;
+    if (std::optional<int> v = d->FindInt("chosenIndex"))
+      chosen_index = *v;
+    if (const std::string* v = d->FindString("chosenTag"))
+      chosen_tag = *v;
+    if (const std::string* v = d->FindString("chosenValue"))
+      chosen_value = *v;
+    if (const std::string* v = d->FindString("pageUrl"))
+      page_url = *v;
+    if (const std::string* v = d->FindString("readyState"))
+      ready_state = *v;
+    if (const std::string* v = d->FindString("matchKey"))
+      match_key = *v;
+    if (const base::Value::List* v = d->FindList("matchKeys")) {
+      for (const auto& item : *v) {
+        if (!item.is_string())
+          continue;
+        match_keys.push_back(item.GetString());
+        if (match_keys.size() >= 32u)
+          break;
+      }
+    }
+    if (const base::Value::List* v = d->FindList("locatorDebug")) {
+      base::JSONWriter::Write(*v, &locator_debug_json);
+      locator_debug_json = TruncateForLog(std::move(locator_debug_json), 600);
+    }
+  } else if (result.is_bool()) {
+    // Defensive: treat a bare boolean as satisfied flag.
+    ok = true;
+    satisfied = result.GetBool();
+  }
+
+  if (ok && satisfied) {
+    base::Value::Dict match;
+    match.Set("ok", true);
+    match.Set("satisfied", true);
+    if (exists)
+      match.Set("exists", *exists);
+    if (visible)
+      match.Set("visible", *visible);
+    if (child_count)
+      match.Set("childCount", *child_count);
+    if (!chosen_type.empty())
+      match.Set("chosenType", chosen_type);
+    if (chosen_index)
+      match.Set("chosenIndex", *chosen_index);
+    if (!chosen_tag.empty())
+      match.Set("chosenTag", chosen_tag);
+    if (!chosen_value.empty()) {
+      std::string chosen_value_excerpt = chosen_value;
+      if (chosen_value_excerpt.size() > 180u)
+        chosen_value_excerpt.resize(180u);
+      match.Set("chosenValue", chosen_value_excerpt);
+    }
+    if (!page_url.empty())
+      match.Set("pageUrl", TruncateForLog(page_url, 220));
+    if (!ready_state.empty())
+      match.Set("readyState", ready_state);
+    if (!match_key.empty()) {
+      match.Set("matchKey", match_key);
+    }
+    if (!match_keys.empty()) {
+      base::Value::List match_keys_list;
+      for (const auto& k : match_keys) {
+        match_keys_list.Append(k);
+      }
+      match.Set("matchKeys", std::move(match_keys_list));
+    }
+    if (!locator_debug_json.empty())
+      match.Set("locatorDebug", locator_debug_json);
+    if (!attr.empty()) {
+      std::string attr_excerpt = attr;
+      if (attr_excerpt.size() > 160u)
+        attr_excerpt.resize(160u);
+      match.Set("attr", attr_excerpt);
+    }
+    if (!author.empty()) {
+      std::string author_excerpt = author;
+      if (author_excerpt.size() > 120u)
+        author_excerpt.resize(120u);
+      match.Set("author", author_excerpt);
+    }
+    if (!timestamp.empty()) {
+      std::string timestamp_excerpt = timestamp;
+      if (timestamp_excerpt.size() > 80u)
+        timestamp_excerpt.resize(80u);
+      match.Set("timestamp", timestamp_excerpt);
+    }
+    if (!article_text.empty()) {
+      std::string article_excerpt = article_text;
+      if (article_excerpt.size() > 240u)
+        article_excerpt.resize(240u);
+      match.Set("articleText", article_excerpt);
+    }
+    if (!text.empty()) {
+      std::string text_excerpt = text;
+      if (text_excerpt.size() > 240u)
+        text_excerpt.resize(240u);
+      match.Set("text", text_excerpt);
+    }
+    std::string payload;
+    base::JSONWriter::Write(match, &payload);
+    LOG(INFO) << "[ListenAction] Matched token=" << token_
+              << " payload=" << TruncateForLog(payload, 900);
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "[ListenAction] Satisfied: " << TruncateForLog(payload, 1200);
+    }
+    Finish(true, payload);
+    return;
+  }
+
+  if (!ok && reason.empty()) {
+    reason = "Listen failed";
+  }
+  if (reason.empty()) {
+    reason = "Listen condition not met";
+  }
+
+  if (!exists && !visible && !child_count && text.empty() && attr.empty() &&
+      chosen_type.empty() && !chosen_index && chosen_tag.empty()) {
+    Finish(false, reason);
+    return;
+  }
+
+  std::string text_excerpt = text;
+
+  std::string msg = reason;
+  msg.append(" (");
+  if (exists)
+    msg.append(base::StringPrintf("exists=%d ", *exists ? 1 : 0));
+  if (visible)
+    msg.append(base::StringPrintf("visible=%d ", *visible ? 1 : 0));
+  if (child_count)
+    msg.append(base::StringPrintf("childCount=%d ", *child_count));
+  if (!chosen_type.empty()) {
+    if (chosen_index) {
+      msg.append(base::StringPrintf("chosen=%s[%d] ",
+                                    chosen_type.c_str(), *chosen_index));
+    } else {
+      msg.append(base::StringPrintf("chosen=%s ", chosen_type.c_str()));
+    }
+  }
+  if (!chosen_tag.empty())
+    msg.append(base::StringPrintf("tag=%s ", chosen_tag.c_str()));
+  if (!chosen_value.empty())
+    msg.append(base::StringPrintf("value='%s' ", chosen_value.c_str()));
+  if (!ready_state.empty())
+    msg.append(base::StringPrintf("readyState=%s ", ready_state.c_str()));
+  if (!page_url.empty())
+    msg.append(base::StringPrintf("url='%s' ", page_url.c_str()));
+  if (!attr.empty())
+    msg.append(base::StringPrintf("attr='%s' ", attr.c_str()));
+  if (!text_excerpt.empty())
+    msg.append(base::StringPrintf("text='%s' ", text_excerpt.c_str()));
+  if (!locator_debug_json.empty())
+    msg.append(base::StringPrintf("locatorDebug=%s ", locator_debug_json.c_str()));
+  if (!msg.empty() && msg.back() == ' ')
+    msg.pop_back();
+  msg.push_back(')');
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ListenAction] Not satisfied: " << TruncateForLog(msg, 1400)
+              << " raw_state=" << ValueToCompactLog(result, 1200);
+  }
+  LOG(INFO) << "[ListenAction] Not satisfied token=" << token_
+            << " detail=" << TruncateForLog(msg, 1000);
+
+  Finish(false, msg);
+}
+
+void ListenAction::Finish(bool success, const std::string& message) {
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ListenAction] Finish success=" << (success ? 1 : 0)
+              << " message=" << TruncateForLog(message, 1400);
+  }
+  if (!callback_) {
+    return;
+  }
+  std::move(callback_).Run(success, message);
+}
