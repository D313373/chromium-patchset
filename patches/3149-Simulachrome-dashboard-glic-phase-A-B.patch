diff --git a/third_party/blink/renderer/core/agent/agent_context.cc b/third_party/blink/renderer/core/agent/agent_context.cc
new file mode 100644
index 0000000000000000000000000000000000000000..24c75ea3dfdd64982bf21cfcb579e1e2b21b6bda
--- /dev/null
+++ b/third_party/blink/renderer/core/agent/agent_context.cc
@@ -0,0 +1,48 @@
+#include "third_party/blink/renderer/core/agent/agent_context.h"
+
+namespace blink {
+
+AgentContext::AgentContext() {}
+
+void AgentContext::AddHistory(const AgentState& state,
+                              const AgentAction& action,
+                              bool success) {
+  if (history_.size() >= kMaxHistory)
+    history_.pop_front();
+
+  history_.emplace_back(AgentHistoryStep{state, action, success});
+}
+
+void AgentContext::PushSiteSnapshot(const AgentState& state) {
+  if (site_map_.size() >= kMaxSiteSnapshots)
+    site_map_.EraseAt(0);
+
+  SiteSnapshot snap;
+
+  float mx = 0, my = 0, mw = 0, mh = 0;
+  int count = 0;
+
+  for (const auto& e : state.elements) {
+    snap.element_roles.push_back(e.role);
+    snap.element_tags.push_back(e.tag);
+
+    mx += e.x;
+    my += e.y;
+    mw += e.width;
+    mh += e.height;
+    count++;
+  }
+
+  if (count > 0) {
+    snap.geometry_summary = {
+      mx / count,
+      my / count,
+      mw / count,
+      mh / count
+    };
+  }
+
+  site_map_.push_back(std::move(snap));
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/core/agent/agent_context.h b/third_party/blink/renderer/core/agent/agent_context.h
