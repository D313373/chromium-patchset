diff --git a/chrome/browser/ui/webui/dashboard/run_history_store.cc b/chrome/browser/ui/webui/dashboard/run_history_store.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f2b6f0b3e166a6e0a3573136f55173e24f0994d5
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/run_history_store.cc
@@ -0,0 +1,315 @@
+#include "chrome/browser/ui/webui/dashboard/run_history_store.h"
+
+#include <string>
+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+
+namespace dashboard {
+
+namespace {
+
+constexpr char kRunsDirName[] = "SimulachromeRunHistory";
+constexpr char kIndexFileName[] = "index.jsonl";
+constexpr char kListenerEventsFileName[] = "listener_events.jsonl";
+constexpr char kDetailsDirName[] = "runs";
+
+base::FilePath ListenerEventsPath(Profile* profile) {
+  return RunHistoryStore::RunsDir(profile).AppendASCII(kListenerEventsFileName);
+}
+
+base::Time ExtractTimeMs(const base::Value::Dict& d, const char* key) {
+  if (const std::optional<double> ms = d.FindDouble(key)) {
+    return base::Time::FromMillisecondsSinceUnixEpoch(
+        static_cast<int64_t>(*ms));
+  }
+  if (const std::string* s = d.FindString(key)) {
+    int64_t v = 0;
+    if (base::StringToInt64(*s, &v))
+      return base::Time::FromMillisecondsSinceUnixEpoch(v);
+  }
+  return base::Time();
+}
+
+bool AppendLineToFile(const base::FilePath& path, std::string_view line) {
+  const base::FilePath parent = path.DirName();
+  if (!parent.empty() && !base::CreateDirectory(parent)) {
+    PLOG(ERROR) << "[RunHistoryStore] CreateDirectory failed: "
+                << parent.AsUTF8Unsafe();
+    return false;
+  }
+  base::File file(path, base::File::FLAG_OPEN_ALWAYS | base::File::FLAG_APPEND);
+  if (!file.IsValid()) {
+    PLOG(ERROR) << "[RunHistoryStore] Open append failed: "
+                << path.AsUTF8Unsafe();
+    return false;
+  }
+  if (!file.WriteAtCurrentPosAndCheck(base::as_byte_span(line))) {
+    PLOG(ERROR) << "[RunHistoryStore] Write append failed: "
+                << path.AsUTF8Unsafe();
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+base::FilePath RunHistoryStore::RunsDir(Profile* profile) {
+  if (!profile)
+    return base::FilePath();
+  return profile->GetPath().AppendASCII(kRunsDirName);
+}
+
+base::FilePath RunHistoryStore::IndexPath(Profile* profile) {
+  return RunsDir(profile).AppendASCII(kIndexFileName);
+}
+
+base::FilePath RunHistoryStore::DetailPath(Profile* profile,
+                                           const std::string& run_id) {
+  return RunsDir(profile)
+      .AppendASCII(kDetailsDirName)
+      .AppendASCII(run_id + ".json");
+}
+
+bool RunHistoryStore::AppendSummary(Profile* profile,
+                                   const base::Value::Dict& summary) {
+  const base::FilePath dir = RunsDir(profile);
+  if (dir.empty())
+    return false;
+  if (!base::CreateDirectory(dir)) {
+    PLOG(ERROR) << "[RunHistoryStore] CreateDirectory failed: "
+                << dir.AsUTF8Unsafe();
+    return false;
+  }
+
+  std::string line;
+  if (!base::JSONWriter::Write(summary, &line)) {
+    LOG(ERROR) << "[RunHistoryStore] JSONWriter failed for summary";
+    return false;
+  }
+  line.push_back('\n');
+
+  const base::FilePath path = IndexPath(profile);
+  if (!AppendLineToFile(path, line)) {
+    return false;
+  }
+  return true;
+}
+
+base::Value::List RunHistoryStore::ReadSummaries(Profile* profile,
+                                                 base::Time from,
+                                                 base::Time to,
+                                                 size_t limit) {
+  base::Value::List out;
+  if (!profile || limit == 0)
+    return out;
+
+  std::vector<base::Value::Dict> matches;
+  // Primary: index.jsonl (fast append-only log).
+  const base::FilePath index_path = IndexPath(profile);
+  if (base::PathExists(index_path)) {
+    std::string content;
+    if (!base::ReadFileToString(index_path, &content)) {
+      PLOG(ERROR) << "[RunHistoryStore] ReadFileToString failed: "
+                  << index_path.AsUTF8Unsafe();
+      return out;
+    }
+    const std::string_view all(content);
+    size_t pos = 0;
+    while (pos < all.size()) {
+      size_t next = all.find('\n', pos);
+      if (next == std::string::npos)
+        next = all.size();
+      const std::string_view line = all.substr(pos, next - pos);
+      pos = next + 1;
+      if (line.empty())
+        continue;
+      auto v = base::JSONReader::Read(
+          std::string(line), base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+      if (!v || !v->is_dict())
+        continue;
+      base::Value::Dict dict = v->GetDict().Clone();
+      const base::Time started = ExtractTimeMs(dict, "started_ms");
+      const base::Time ended = ExtractTimeMs(dict, "ended_ms");
+      if (!from.is_null() && ended < from)
+        continue;
+      if (!to.is_null() && started > to)
+        continue;
+      matches.push_back(std::move(dict));
+    }
+  } else {
+    // Fallback: enumerate /runs/*.json (legacy/current-on-disk format).
+    const base::FilePath runs_dir =
+        RunsDir(profile).AppendASCII(kDetailsDirName);
+    if (!base::PathExists(runs_dir))
+      return out;
+
+    base::FileEnumerator it(runs_dir, /*recursive=*/false,
+                            base::FileEnumerator::FILES,
+                            FILE_PATH_LITERAL("*.json"));
+    for (base::FilePath path = it.Next(); !path.empty(); path = it.Next()) {
+      std::string json;
+      if (!base::ReadFileToString(path, &json))
+        continue;
+      auto v =
+          base::JSONReader::Read(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+      if (!v || !v->is_dict())
+        continue;
+      base::Value::Dict dict = v->GetDict().Clone();
+      const base::Time started = ExtractTimeMs(dict, "started_ms");
+      const base::Time ended = ExtractTimeMs(dict, "ended_ms");
+      if (started.is_null() || ended.is_null())
+        continue;
+      if (!from.is_null() && ended < from)
+        continue;
+      if (!to.is_null() && started > to)
+        continue;
+      // Ensure run_id exists even if the file was written without it.
+      if (!dict.FindString("run_id")) {
+        dict.Set("run_id",
+                 path.BaseName().RemoveExtension().MaybeAsASCII());
+      }
+      matches.push_back(std::move(dict));
+    }
+  }
+
+  for (auto it = matches.rbegin(); it != matches.rend(); ++it) {
+    if (out.size() >= limit)
+      break;
+    out.Append(base::Value(std::move(*it)));
+  }
+  return out;
+}
+
+bool RunHistoryStore::AppendListenerEvent(Profile* profile,
+                                         const base::Value::Dict& event) {
+  const base::FilePath dir = RunsDir(profile);
+  if (dir.empty())
+    return false;
+  if (!base::CreateDirectory(dir)) {
+    PLOG(ERROR) << "[RunHistoryStore] CreateDirectory failed: "
+                << dir.AsUTF8Unsafe();
+    return false;
+  }
+
+  std::string line;
+  if (!base::JSONWriter::Write(event, &line)) {
+    LOG(ERROR) << "[RunHistoryStore] JSONWriter failed for listener event";
+    return false;
+  }
+  line.push_back('\n');
+
+  const base::FilePath path = ListenerEventsPath(profile);
+  if (!AppendLineToFile(path, line)) {
+    return false;
+  }
+  return true;
+}
+
+base::Value::List RunHistoryStore::ReadListenerEvents(Profile* profile,
+                                                      base::Time from,
+                                                      base::Time to,
+                                                      size_t limit) {
+  base::Value::List out;
+  if (!profile || limit == 0)
+    return out;
+
+  const base::FilePath path = ListenerEventsPath(profile);
+  if (!base::PathExists(path))
+    return out;
+
+  std::string content;
+  if (!base::ReadFileToString(path, &content)) {
+    PLOG(ERROR) << "[RunHistoryStore] ReadFileToString failed: "
+                << path.AsUTF8Unsafe();
+    return out;
+  }
+
+  std::vector<base::Value::Dict> matches;
+  const std::string_view all(content);
+  size_t pos = 0;
+  while (pos < all.size()) {
+    size_t next = all.find('\n', pos);
+    if (next == std::string::npos)
+      next = all.size();
+    const std::string_view line = all.substr(pos, next - pos);
+    pos = next + 1;
+    if (line.empty())
+      continue;
+    auto v = base::JSONReader::Read(
+        std::string(line), base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (!v || !v->is_dict())
+      continue;
+    base::Value::Dict dict = v->GetDict().Clone();
+    const base::Time ts = ExtractTimeMs(dict, "ts_ms");
+    if (!ts.is_null()) {
+      if (!from.is_null() && ts < from)
+        continue;
+      if (!to.is_null() && ts > to)
+        continue;
+    }
+    matches.push_back(std::move(dict));
+  }
+
+  for (auto it = matches.rbegin(); it != matches.rend(); ++it) {
+    if (out.size() >= limit)
+      break;
+    out.Append(base::Value(std::move(*it)));
+  }
+  return out;
+}
+
+bool RunHistoryStore::WriteRunDetail(Profile* profile,
+                                     const std::string& run_id,
+                                     const base::Value::Dict& detail) {
+  if (!profile || run_id.empty())
+    return false;
+  const base::FilePath dir = RunsDir(profile).AppendASCII(kDetailsDirName);
+  if (!base::CreateDirectory(dir)) {
+    PLOG(ERROR) << "[RunHistoryStore] CreateDirectory failed: "
+                << dir.AsUTF8Unsafe();
+    return false;
+  }
+  const base::FilePath path = DetailPath(profile, run_id);
+  std::string json;
+  if (!base::JSONWriter::Write(detail, &json)) {
+    LOG(ERROR) << "[RunHistoryStore] JSONWriter failed for detail";
+    return false;
+  }
+  const int rv = base::WriteFile(path, base::as_byte_span(json));
+  if (rv <= 0) {
+    PLOG(ERROR) << "[RunHistoryStore] WriteFile failed: " << path.AsUTF8Unsafe();
+    return false;
+  }
+  return true;
+}
+
+bool RunHistoryStore::ReadRunDetail(Profile* profile,
+                                    const std::string& run_id,
+                                    base::Value::Dict* out) {
+  if (!out || !profile || run_id.empty())
+    return false;
+  const base::FilePath path = DetailPath(profile, run_id);
+  if (!base::PathExists(path))
+    return false;
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    PLOG(ERROR) << "[RunHistoryStore] ReadFileToString failed: "
+                << path.AsUTF8Unsafe();
+    return false;
+  }
+  auto v = base::JSONReader::Read(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!v || !v->is_dict())
+    return false;
+  *out = v->GetDict().Clone();
+  return true;
+}
+
+}  // namespace dashboard
