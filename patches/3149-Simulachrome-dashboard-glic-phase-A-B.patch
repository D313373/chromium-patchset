+    lines.push('Use content_node_id values from the context when selecting elements.');
+    lines.push('IMPORTANT: target_id MUST be an integer content_node_id taken from the current Page context elements[].id list.');
+    lines.push('Do NOT invent ids (e.g. "password_field"). Do NOT use strings. Any non-integer or unknown id will be rejected.');
+    lines.push('For typing, prefer form_type FORM_CONTROL_TYPE_INPUT_* (or a matching placeholder/field_name).');
+    lines.push('For login flows, type username/email FIRST, then type the password, then submit with Enter (preferred) or click a Log In/Sign In button.');
+    lines.push('Do NOT include action results (e.g., success=true/false, status, reason) in click/hover/type/scroll JSON.');
+    lines.push('Respond with a single JSON object only, using EXACTLY one of the following shapes (no extra keys):');
+    lines.push('{"action":"click","target_id":123}');
+    lines.push('{"action":"hover","target_id":123}');
+    lines.push('{"action":"type","target_id":123,"text":"..."}');
+    lines.push('{"action":"scroll","target_id":123,"distance":600}');
+    lines.push('{"action":"request_context"}');
+    lines.push('Use {"action":"request_context"} only when you need a fresh Page context snapshot.');
+    lines.push('When finished, respond with {"action":"complete"}.');
+    lines.push('If you cannot finish, respond with {"action":"complete","success":false,"reason":"..."}.');
+    lines.push('Do not include any other text.');
