@@ -0,0 +1,49 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_CONTEXT_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_CONTEXT_H_
+
+#include <string>
+#include "third_party/blink/renderer/platform/wtf/deque.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+#include "third_party/blink/renderer/core/agent/agent_state.h"
+#include "third_party/blink/renderer/core/agent/agent_action.h"
+
+namespace blink {
+
+static constexpr int kMaxHistory = 20;
+static constexpr int kMaxSiteSnapshots = 100;
+
+struct AgentHistoryStep {
+  AgentState state;
+  AgentAction action;
+  bool success = true;
+};
+
+struct SiteSnapshot {
+  Vector<std::string> element_roles;
+  Vector<std::string> element_tags;
+  Vector<float> geometry_summary;
+};
+
+class AgentContext {
+ public:
+  AgentContext();
+
+  void SetGoal(const std::string& g) { goal_ = g; }
+  const std::string& goal() const { return goal_; }
+
+  void AddHistory(const AgentState&, const AgentAction&, bool success);
+  const Deque<AgentHistoryStep>& history() const { return history_; }
+
+  void PushSiteSnapshot(const AgentState& state);
+  const Vector<SiteSnapshot>& site_map() const { return site_map_; }
+
+ private:
+  std::string goal_;
+  Deque<AgentHistoryStep> history_;
+  Vector<SiteSnapshot> site_map_;
+};
+
+}  // namespace blink
+
+#endif
