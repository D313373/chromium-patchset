+// ==============================================
+// LayerEditor - Reusable component for managing "layer" hints
+// These are *not* element locators. They help route element resolution to the
+// right iframe / shadow layer and reduce exhaustive traversal.
+// Stored in action params as:
+//   frame_id: string
+//   shadow_chain: string
+//   resource_path: string
+// ==============================================
+
+function makeGroup(labelText, paramKey, placeholder) {
+  const group = document.createElement('div');
+  group.className = 'form-group mt-2';
+  group.dataset.paramKey = paramKey;
+
+  const label = document.createElement('label');
+  label.textContent = labelText;
+
+  const input = document.createElement('smart-input');
+  input.className = 'input-field';
+  if (placeholder) input.setAttribute('placeholder', placeholder);
+  input.setAttribute('title', placeholder || labelText);
+
+  group.appendChild(label);
+  group.appendChild(input);
+  return { group, input };
+}
+
+export function renderLayerEditor(container, params) {
+  container.textContent = '';
+
+  const header = document.createElement('div');
+  header.className = 'help-text';
+  header.textContent =
+      'Layer hints (optional). These route actions to the right iframe/shadow context and are not used as primary locators.';
+
+  const { group: frameGroup, input: frameInput } =
+      makeGroup('Frame ID (hint)', 'frame_id',
+                'Optional: stable frame token / GlobalRenderFrameHostId');
+  const { group: shadowGroup, input: shadowInput } =
+      makeGroup('Shadow Chain (hint)', 'shadow_chain',
+                'Optional: shadow host chain (open shadow roots only)');
+  const { group: resourceGroup, input: resourceInput } =
+      makeGroup('Resource Path (hint)', 'resource_path',
+                'Optional: diagnostics/disambiguation hint');
+
+  frameInput.value = String(params?.frame_id || '');
+  shadowInput.value = String(params?.shadow_chain || '');
+  resourceInput.value = String(params?.resource_path || '');
+
+  container.appendChild(header);
+  container.appendChild(frameGroup);
+  container.appendChild(shadowGroup);
+  container.appendChild(resourceGroup);
+
+  // Return a tiny interface for callers that want it.
+  return {
+    setValue(next) {
+      frameInput.value = String(next?.frame_id || '');
+      shadowInput.value = String(next?.shadow_chain || '');
+      resourceInput.value = String(next?.resource_path || '');
+    },
+    getValue() {
+      return {
+        frame_id: String(frameInput.value || '').trim(),
+        shadow_chain: String(shadowInput.value || '').trim(),
+        resource_path: String(resourceInput.value || '').trim(),
+      };
+    },
+  };
+}
+
