@@ -0,0 +1,62 @@
+import {
+  renderDashboardScriptList,
+  toggleSelectedScript,
+  runSelectedScriptsQueue,
+} from '../dashboard_script_list.js';
+
+export function createDashboardScriptQueueController({
+  appState,
+  dashboardHandler,
+  scriptListEl,
+  renderAll,
+}) {
+  if (!appState || !dashboardHandler || !scriptListEl ||
+      typeof renderAll !== 'function') {
+    return null;
+  }
+
+  const renderScriptList = () => {
+    renderDashboardScriptList({
+      scriptListEl,
+      appState,
+      onRunSelected: () => {
+        console.log('[DashboardUI] RunSelected button clicked');
+        void handleRunSelected();
+      },
+      onClearSelected: () => {
+        appState.selectedScripts = [];
+        renderScriptList();
+      },
+      onToggleSelectScript: (scriptId) => toggleSelectScript(scriptId),
+      onSelectScript: (scriptId) => {
+        appState.currentScriptId = scriptId;
+        appState.isEditingAction = false;
+        renderAll();
+      },
+    });
+  };
+
+  const toggleSelectScript = (scriptId) => {
+    toggleSelectedScript(appState, scriptId);
+    renderScriptList();
+  };
+
+  const handleRunSelected = async () => {
+    await runSelectedScriptsQueue({
+      appState,
+      playScript: async (scriptId) => {
+        console.log(
+          '[DashboardUI] RunSelected -> playScript', scriptId,
+          `(${appState.selectedScripts.indexOf(scriptId) + 1}/${appState.selectedScripts.length})`);
+        await dashboardHandler.playScript(scriptId);
+      },
+      onRender: () => renderScriptList(),
+    });
+  };
+
+  return {
+    handleRunSelected,
+    renderScriptList,
+    toggleSelectScript,
+  };
+}
diff --git a/chrome/browser/resources/dashboard/agent/timeline/dashboard_timeline_dragdrop.js b/chrome/browser/resources/dashboard/agent/timeline/dashboard_timeline_dragdrop.js
new file mode 100644
index 0000000000000000000000000000000000000000..3fbf24a03debaa2e57cc60d8ad932d32ceef837f
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/timeline/dashboard_timeline_dragdrop.js
@@ -0,0 +1,161 @@
+function parseActionDragPayload(e) {
+  if (!e?.dataTransfer) return null;
+  const json =
+    e.dataTransfer.getData('application/x-dashboard-action') ||
+    e.dataTransfer.getData('application/json');
+  if (!json) return null;
+  try {
+    const parsed = JSON.parse(json);
+    if (!parsed || typeof parsed !== 'object') return null;
+    if (parsed.kind !== 'existing_action') return null;
+    return parsed;
+  } catch (_) {
+    return null;
+  }
+}
+
+export function installDashboardTimelineDragDrop({
+  actionMenuEl,
+  timelineEl,
+  appState,
+  nestedRuleViolationMessage,
+  resolveTargetList,
+  resolveTargetListByPath,
+  createNewActionFromType,
+  markDraftAction,
+  cancelAutoSaveTimer,
+  scheduleAutoSave,
+  renderAll,
+  alertFn = (msg) => alert(msg),
+}) {
+  if (!actionMenuEl || !timelineEl || !appState) {
+    return {dispose() {}};
+  }
+
+  let draggedActionType = null;
+
+  const handleActionMenuDragStart = (e) => {
+    if (e.target.classList.contains('action-menu-item')) {
+      draggedActionType = e.target.dataset.actionType;
+      e.dataTransfer.setData('text/plain', draggedActionType);
+    }
+  };
+
+  const handleTimelineDragOver = (e) => {
+    e.preventDefault();
+    const target = e.target.closest('.plus-button, .timeline-branch, .loop-container');
+    if (!target) return;
+    const dragPayload = parseActionDragPayload(e);
+    const draggedType = dragPayload?.actionType || draggedActionType;
+    const listPath = target.dataset.listPath || '';
+    const violation = nestedRuleViolationMessage(draggedType, listPath);
+    if (violation) {
+      e.dataTransfer.dropEffect = 'none';
+      return;
+    }
+    e.dataTransfer.dropEffect = 'move';
+    target.style.backgroundColor = 'rgba(0, 255, 65, 0.3)';
+  };
+
+  const handleTimelineDragLeave = (e) => {
+    const target = e.target.closest('.plus-button, .timeline-branch, .loop-container');
+    if (target) target.style.backgroundColor = '';
+  };
+
+  const handleTimelineDrop = async (e) => {
+    e.preventDefault();
+    const dragPayload = parseActionDragPayload(e);
+    const actionType = dragPayload?.actionType || e.dataTransfer.getData('text/plain');
+    draggedActionType = null;
+    const plusButton = e.target.closest('.plus-button');
+    const branch = e.target.closest('.timeline-branch, .loop-container');
+    const currentScript = appState.scripts[appState.currentScriptId];
+    if (!currentScript) return;
+
+    let targetList;
+    let index;
+    let parentType;
+    let parentIndex;
+    let scopeType;
+    let scopeIndex;
+    let listPath;
+    const dropTarget = plusButton || branch;
+
+    if (dropTarget) {
+      dropTarget.style.backgroundColor = '';
+      index = plusButton ? parseInt(plusButton.dataset.index, 10) : 0;
+      parentType = dropTarget.dataset.parentType;
+      parentIndex = parseInt(dropTarget.dataset.parentIndex, 10);
+      scopeType = dropTarget.dataset.scopeType || 'main';
+      scopeIndex = parseInt(dropTarget.dataset.scopeIndex ?? '-1', 10);
+      listPath = dropTarget.dataset.listPath || null;
+      const violation = nestedRuleViolationMessage(actionType, listPath);
+      if (violation) {
+        alertFn(violation);
+        return;
+      }
+      if (!scopeType) scopeType = 'main';
+      if (!Number.isFinite(scopeIndex)) scopeIndex = -1;
+      targetList = resolveTargetList(
+        parentType, parentIndex, scopeType, scopeIndex, listPath);
+    }
+
+    if (!targetList) return;
+
+    if (dragPayload && dragPayload.kind === 'existing_action') {
+      const sourcePath = Array.isArray(dragPayload.listPath) ? dragPayload.listPath : null;
+      const sourceIndex = Number(dragPayload.index);
+      const sourceList = resolveTargetListByPath(currentScript, sourcePath, false);
+      if (!sourceList || !Number.isInteger(sourceIndex) ||
+          sourceIndex < 0 || sourceIndex >= sourceList.length) {
+        return;
+      }
+      const movingAction = sourceList[sourceIndex];
+      if (!movingAction) return;
+      let targetIndex = Number.isInteger(index) ? index : 0;
+      if (sourceList === targetList && sourceIndex < targetIndex) {
+        targetIndex -= 1;
+      }
+      targetIndex = Math.max(0, Math.min(targetList.length, targetIndex));
+      sourceList.splice(sourceIndex, 1);
+      targetList.splice(targetIndex, 0, movingAction);
+      scheduleAutoSave(appState.currentScriptId, 'move-action', 0);
+      renderAll();
+      return;
+    }
+
+    const newAction = markDraftAction(await createNewActionFromType(actionType));
+    targetList.splice(index, 0, newAction);
+
+    // Prevent persisting incomplete draft actions before the editor saves.
+    cancelAutoSaveTimer(appState.currentScriptId);
+    appState.isEditingAction = true;
+    appState.editingActionData = {
+      action: newAction,
+      index,
+      parentType,
+      parentIndex,
+      scopeType,
+      scopeIndex,
+      listPath,
+      isNewAction: true,
+      original: null,
+      editorAddedDraftFlag: false,
+    };
+    renderAll();
+  };
+
+  actionMenuEl.addEventListener('dragstart', handleActionMenuDragStart);
+  timelineEl.addEventListener('dragover', handleTimelineDragOver);
+  timelineEl.addEventListener('dragleave', handleTimelineDragLeave);
+  timelineEl.addEventListener('drop', handleTimelineDrop);
+
+  return {
+    dispose() {
+      actionMenuEl.removeEventListener('dragstart', handleActionMenuDragStart);
+      timelineEl.removeEventListener('dragover', handleTimelineDragOver);
+      timelineEl.removeEventListener('dragleave', handleTimelineDragLeave);
+      timelineEl.removeEventListener('drop', handleTimelineDrop);
+    },
+  };
+}
diff --git a/chrome/browser/resources/dashboard/agent/ui/dashboard_auto_heal_callbacks.js b/chrome/browser/resources/dashboard/agent/ui/dashboard_auto_heal_callbacks.js
new file mode 100644
index 0000000000000000000000000000000000000000..546d5f0fdad7801aeec25eaf86d81c3f514bf6b6
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/ui/dashboard_auto_heal_callbacks.js
@@ -0,0 +1,71 @@
+export function createDashboardAutoHealViewCallbacks({
+  autoHealState,
+  autoQueueFromFailureSnapshot,
+  queueStateSnapshot,
+  enqueueAutoHealIncident,
+  processAutoHealQueue,
+  cancelCurrentAutoHeal,
+  clearAutoHealQueue,
+  removeQueueItemByKey,
+  moveQueueItemByKey,
+  prioritizeQueueItem,
+  alertFn = (msg) => alert(msg),
+} = {}) {
+  return {
+    onDebugDataSnapshot: (snapshot) => {
+      try {
+        const failures = Array.isArray(snapshot?.failures) ?
+          snapshot.failures :
+          [];
+        autoQueueFromFailureSnapshot(failures);
+      } catch (_) {}
+    },
+    getAutoHealQueueState: () => queueStateSnapshot(),
+    onQueueAutoHeal: (incident, view) => {
+      const res = enqueueAutoHealIncident(incident, 'debugging_ui');
+      if (!res.ok) {
+        alertFn(res.error || 'Failed to queue auto-heal incident.');
+        return;
+      }
+      if (res.duplicate) {
+        alertFn('Failure already queued recently.');
+      } else {
+        alertFn('Queued for auto-heal.');
+      }
+      if (autoHealState.autoQueueEnabled) {
+        processAutoHealQueue();
+      }
+      view.dispatchEvent(new CustomEvent('dbg-refresh', {bubbles: true}));
+    },
+    onAutoHealProcessNext: (view) => {
+      const res = processAutoHealQueue();
+      if (!res.ok) {
+        alertFn(res.error || 'Failed to start auto-heal.');
+      }
+      view.dispatchEvent(new CustomEvent('dbg-refresh', {bubbles: true}));
+    },
+    onAutoHealCancelCurrent: (view) => {
+      cancelCurrentAutoHeal('ui_cancel');
+      view.dispatchEvent(new CustomEvent('dbg-refresh', {bubbles: true}));
+    },
+    onAutoHealClearQueue: (view) => {
+      clearAutoHealQueue();
+      view.dispatchEvent(new CustomEvent('dbg-refresh', {bubbles: true}));
+    },
+    onAutoHealRemoveQueueItem: (key, view) => {
+      removeQueueItemByKey(key);
+      view.dispatchEvent(new CustomEvent('dbg-refresh', {bubbles: true}));
+    },
+    onAutoHealMoveQueueItem: (key, delta, view) => {
+      moveQueueItemByKey(key, delta);
+      view.dispatchEvent(new CustomEvent('dbg-refresh', {bubbles: true}));
+    },
+    onAutoHealPrioritizeQueueItem: (key, view) => {
+      const res = prioritizeQueueItem(key);
+      if (!res.ok) {
+        alertFn(res.error || 'Failed to prioritize auto-heal task.');
+      }
+      view.dispatchEvent(new CustomEvent('dbg-refresh', {bubbles: true}));
+    },
+  };
+}
diff --git a/chrome/browser/resources/dashboard/agent/ui/dashboard_bootstrap.js b/chrome/browser/resources/dashboard/agent/ui/dashboard_bootstrap.js
new file mode 100644
