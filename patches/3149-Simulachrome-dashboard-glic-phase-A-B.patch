+++ b/chrome/browser/ui/webui/dashboard/failure_replay_recorder.cc
@@ -0,0 +1,223 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/dashboard/failure_replay_recorder.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/files/file_util.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/stringprintf.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "ui/gfx/codec/png_codec.h"
+
+namespace dashboard {
+
+namespace {
+
+constexpr int kMaxOutputWidthPx = 960;
+constexpr int kMaxOutputHeightPx = 540;
+
+base::TimeDelta IntervalForFps(int fps) {
+  if (fps <= 0)
+    return base::Seconds(1);
+  return base::Milliseconds(std::max(1, 1000 / fps));
+}
+
+size_t MaxFramesFor(int fps, base::TimeDelta max_duration) {
+  if (fps <= 0 || max_duration.is_zero())
+    return 0;
+  const double frames = std::ceil(max_duration.InSecondsF() * fps);
+  return static_cast<size_t>(std::max(1.0, frames));
+}
+
+}  // namespace
+
+FailureReplayRecorder::FailureReplayRecorder(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents) {}
+
+FailureReplayRecorder::~FailureReplayRecorder() = default;
+
+FailureReplayRecorder::Frame::Frame() = default;
+FailureReplayRecorder::Frame::Frame(Frame&&) = default;
+FailureReplayRecorder::Frame& FailureReplayRecorder::Frame::operator=(Frame&&) =
+    default;
+FailureReplayRecorder::Frame::~Frame() = default;
+
+void FailureReplayRecorder::Start(int fps, base::TimeDelta max_duration) {
+  fps_ = fps;
+  max_duration_ = max_duration;
+  max_frames_ = MaxFramesFor(fps_, max_duration_);
+  frames_.clear();
+  started_at_ = base::TimeTicks::Now();
+  capture_in_flight_ = false;
+
+  if (max_frames_ == 0 || !web_contents())
+    return;
+
+  timer_.Start(FROM_HERE, IntervalForFps(fps_),
+               base::BindRepeating(&FailureReplayRecorder::CaptureTick,
+                                   weak_factory_.GetWeakPtr()));
+  CaptureTick();
+}
+
+void FailureReplayRecorder::Stop() {
+  timer_.Stop();
+  // If a capture callback is already in-flight, we must prevent it from running
+  // after `Stop()` returns. Otherwise `SaveToDisk()` may read `frames_` while
+  // the UI thread is still appending to it.
+  weak_factory_.InvalidateWeakPtrs();
+  capture_in_flight_ = false;
+}
+
+bool FailureReplayRecorder::HasFrames() const {
+  return !frames_.empty();
+}
+
+void FailureReplayRecorder::WebContentsDestroyed() {
+  Stop();
+}
+
+gfx::Size FailureReplayRecorder::ComputeOutputSize(
+    content::RenderWidgetHostView* view) const {
+  if (!view)
+    return gfx::Size();
+
+  const gfx::Size src = view->GetViewBounds().size();
+  if (src.IsEmpty())
+    return gfx::Size();
+
+  const double scale_w =
+      static_cast<double>(kMaxOutputWidthPx) / std::max(1, src.width());
+  const double scale_h =
+      static_cast<double>(kMaxOutputHeightPx) / std::max(1, src.height());
+  const double scale = std::min({scale_w, scale_h, 1.0});
+  const int out_w =
+      std::max(1, static_cast<int>(std::floor(src.width() * scale)));
+  const int out_h =
+      std::max(1, static_cast<int>(std::floor(src.height() * scale)));
+  return gfx::Size(out_w, out_h);
+}
+
+void FailureReplayRecorder::CaptureTick() {
+  if (!web_contents())
+    return;
+
+  content::RenderWidgetHostView* view = web_contents()->GetRenderWidgetHostView();
+  if (!view || !view->IsSurfaceAvailableForCopy())
+    return;
+  if (capture_in_flight_)
+    return;
+
+  const gfx::Size output_size = ComputeOutputSize(view);
+  if (output_size.IsEmpty())
+    return;
+
+  capture_in_flight_ = true;
+  view->CopyFromSurface(
+      gfx::Rect(), output_size,
+      base::BindOnce(&FailureReplayRecorder::OnCaptureResult,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void FailureReplayRecorder::OnCaptureResult(
+    const viz::CopyOutputBitmapWithMetadata& result) {
+  capture_in_flight_ = false;
+
+  const SkBitmap& bitmap = result.bitmap;
+  if (bitmap.drawsNothing())
+    return;
+
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, /*discard_transparency=*/false);
+  if (!png) {
+    return;
+  }
+
+  Frame frame;
+  frame.captured_at = base::TimeTicks::Now();
+  frame.size_px = gfx::Size(bitmap.width(), bitmap.height());
+  frame.png_bytes = std::move(*png);
+  frames_.push_back(std::move(frame));
+
+  while (frames_.size() > max_frames_) {
+    frames_.pop_front();
+  }
+}
+
+bool FailureReplayRecorder::SaveToDisk(const base::FilePath& replay_dir,
+                                       std::string* error) {
+  if (replay_dir.empty()) {
+    if (error)
+      *error = "replay_dir is empty";
+    return false;
+  }
+  if (frames_.empty()) {
+    if (error)
+      *error = "no frames captured";
+    return false;
+  }
+
+  if (!base::CreateDirectory(replay_dir)) {
+    if (error)
+      *error = "failed to create replay directory";
+    PLOG(ERROR) << "[FailureReplayRecorder] CreateDirectory failed: "
+                << replay_dir.AsUTF8Unsafe();
+    return false;
+  }
+
+  base::Value::Dict manifest;
+  manifest.Set("version", 1);
+  manifest.Set("fps", fps_);
+  manifest.Set("max_seconds", max_duration_.InSecondsF());
+
+  base::Value::List frames;
+  const base::TimeTicks first_ts = frames_.front().captured_at;
+  for (size_t i = 0; i < frames_.size(); ++i) {
+    const auto& f = frames_[i];
+    const std::string filename = base::StringPrintf("frame_%03zu.png", i);
+    const base::FilePath frame_path = replay_dir.AppendASCII(filename);
+    const int rv = base::WriteFile(frame_path, f.png_bytes);
+    if (rv <= 0) {
+      if (error)
+        *error = "failed to write frame png";
+      PLOG(ERROR) << "[FailureReplayRecorder] WriteFile failed: "
+                  << frame_path.AsUTF8Unsafe();
+      return false;
+    }
+
+    base::Value::Dict entry;
+    entry.Set("file", filename);
+    entry.Set("t_ms", (f.captured_at - first_ts).InMillisecondsF());
+    entry.Set("w", f.size_px.width());
+    entry.Set("h", f.size_px.height());
+    frames.Append(std::move(entry));
+  }
+  manifest.Set("frames", std::move(frames));
+
+  std::string json;
+  if (!base::JSONWriter::WriteWithOptions(
+          manifest, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json)) {
+    if (error)
+      *error = "failed to serialize manifest";
+    return false;
+  }
+  const base::FilePath manifest_path = replay_dir.AppendASCII("manifest.json");
+  const int rv = base::WriteFile(manifest_path, base::as_byte_span(json));
+  if (rv <= 0) {
+    if (error)
+      *error = "failed to write manifest";
+    PLOG(ERROR) << "[FailureReplayRecorder] WriteFile failed: "
+                << manifest_path.AsUTF8Unsafe();
+    return false;
+  }
+
+  return true;
+}
+
+}  // namespace dashboard
