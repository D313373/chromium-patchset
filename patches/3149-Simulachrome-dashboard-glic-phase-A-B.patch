+  ~AgentLoop();
+
+  void Start();
+  void Stop();
+  bool IsRunning() const { return running_; }
+
+  void SetGoal(const std::string& g) { context_.SetGoal(g); }
+  const std::string& Goal() const { return context_.goal(); }
+
