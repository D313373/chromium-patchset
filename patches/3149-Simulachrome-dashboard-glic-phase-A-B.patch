@@ -0,0 +1,32 @@
+// Lightweight action descriptor used by the Simulachrome agent.
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_ACTION_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_ACTION_H_
+
+#include <string>
+
+namespace blink {
+
+enum class AgentActionType {
+  kNone = 0,
+  kClickElement,
+  kFocusElement,
+  kTypeText,
+  kScrollBy,
+  kNavigate,
+};
+
+struct AgentAction {
+  AgentActionType type = AgentActionType::kNone;
+
+  int element_id = -1;      // For click, focus, type.
+  std::string text;         // For type.
+  float scroll_dx = 0;      // For scroll.
+  float scroll_dy = 0;
+  std::string url;          // For navigation.
+
+  bool IsValid() const { return type != AgentActionType::kNone; }
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_ACTION_H_
diff --git a/third_party/blink/renderer/core/agent/agent_action_dispatcher.cc b/third_party/blink/renderer/core/agent/agent_action_dispatcher.cc
new file mode 100644
index 0000000000000000000000000000000000000000..181c9efc6c55510d359c2582507c2ac232bfaaca
--- /dev/null
+++ b/third_party/blink/renderer/core/agent/agent_action_dispatcher.cc
@@ -0,0 +1,95 @@
+#include "third_party/blink/renderer/core/agent/agent_action_dispatcher.h"
+
+#include "base/logging.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/dom/element_traversal.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+Element* AgentActionDispatcher::FindElement(LocalFrame* frame, int element_id) {
+  if (!frame || element_id <= 0)
+    return nullptr;
+
+  Document* doc = frame->GetDocument();
+  if (!doc)
+    return nullptr;
+
+  int counter = 1;
+  for (Element* el = ElementTraversal::FirstWithin(*doc);
+       el; el = ElementTraversal::Next(*el)) {
+    if (counter++ == element_id)
+      return el;
+  }
+  return nullptr;
+}
+
+void AgentActionDispatcher::DoClick(Element* el, LocalFrame*) {
+  if (!el) return;
+  el->Focus();
+}
+
+void AgentActionDispatcher::DoFocus(Element* el, LocalFrame*) {
+  if (!el) return;
+  el->Focus();
+}
+
+void AgentActionDispatcher::DoType(Element* el, LocalFrame* frame,
+                                   const std::string& text) {
+  if (!el || !frame)
+    return;
+
+  el->Focus();
+  el->setTextContent(String::FromUTF8(text.c_str()));
+}
+
+void AgentActionDispatcher::DoScroll(LocalFrame* frame,
+                                     float dx, float dy) {
+  // Stubbed scroll; no-op for now.
+}
+
+void AgentActionDispatcher::DoNavigate(LocalFrame* frame,
+                                      const std::string&) {
+  // Navigation action is stubbed out for now.
+}
+
+void AgentActionDispatcher::Dispatch(const AgentAction& action,
+                                     LocalFrame* frame) {
+  if (!frame || !action.IsValid())
+    return;
+
+  Element* target = nullptr;
+
+  if (action.element_id > 0)
+    target = FindElement(frame, action.element_id);
+
+  switch (action.type) {
+    case AgentActionType::kClickElement:
+      DoClick(target, frame);
+      break;
+
+    case AgentActionType::kFocusElement:
+      DoFocus(target, frame);
+      break;
+
+    case AgentActionType::kTypeText:
+      DoType(target, frame, action.text);
+      break;
+
+    case AgentActionType::kScrollBy:
+      DoScroll(frame, action.scroll_dx, action.scroll_dy);
+      break;
+
+    case AgentActionType::kNavigate:
+      DoNavigate(frame, action.url);
+      break;
+
+    default:
+      break;
+  }
+}
+
+}  // namespace blink
