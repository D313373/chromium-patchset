+  } else {
+    row.innerHTML = `
+      <input class="input-field data-key" value="" placeholder="Key (e.g. FirstName)"/>
+      <input class="input-field data-val" value="" placeholder="Value"/>
+      <button class="btn btn-danger data-remove" title="Remove">✕</button>
