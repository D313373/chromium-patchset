+          badgeClass: 'dbg-event-badge-scheduled',
+          detail: 'scheduled start window',
+          selectItem: {
+            kind: 'scheduled',
+            id: eventKey,
+            scriptId,
+            scriptName,
+            status: 'scheduled',
+            startMs: t,
+            endMs: t + (2 * 60 * 1000),
