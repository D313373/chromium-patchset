+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_BLINK_AGENT_LOOP_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_BLINK_AGENT_LOOP_H_
+
+
+#include "third_party/blink/renderer/core/agent/agent_action.h"
+#include "third_party/blink/renderer/core/agent/agent_blink_state.h"
+#include "third_party/blink/renderer/core/agent/agent_context.h"
+#include "third_party/blink/renderer/core/agent/agent_state.h"
+#include "third_party/blink/renderer/platform/blink_troll/blink_troll_wrapper.h"
+#include "third_party/blink/renderer/platform/blink_troll/resources/blink_troll_resource_ids.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/heap/member.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+class LocalFrame;
+
+// Core execution loop for the Simulachrome agent. The full inference pipeline
+// (vectorizer → TFLite → decoder → dispatcher) can be reintroduced incrementally;
+// for now this provides lifecycle hooks and status plumbing so the renderer
+// continues to build and the mojo bridge remains live.
+class BlinkAgentLoop final : public GarbageCollected<BlinkAgentLoop> {
+ public:
+  explicit BlinkAgentLoop(LocalFrame* frame);
+
+  void Trace(Visitor* visitor) const;
+
+  void Start();
+  void Stop();
+  void TickOnce();
+  void SetGoal(const String& goal);
+  void SetModelResource(int resource_id);
+
+  bool IsRunning() const { return running_; }
+  String GetStatus() const { return status_text_; }
+
+ private:
+  bool LoadModelIfNeeded();
+  void Tick();
+
+  Member<LocalFrame> frame_;
+  BlinkTrollWrapper troll_;
+  AgentContext context_;
+
+  bool running_ = false;
+  bool model_loaded_ = false;
+  int model_resource_id_ = blink_troll_resources::kBlinkTrollModel;
+  String current_goal_;
+  String status_text_ = "idle";
+  AgentBlinkState last_state_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_BLINK_AGENT_LOOP_H_
