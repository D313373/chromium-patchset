+  if (had_snapshot_data && !has_new_matching_elements) {
+    st->info.status = "listening";
+    st->info.status_detail = "No new matching elements; waiting for refresh…";
+    ScheduleRefreshAndRearm(script_id, seq, st->refresh_interval);
+    return;
+  }
+
+  ArmListenNowImpl(script_id, seq);
+}
+
+void ListenerManager::OnListenCompleted(const std::string& script_id,
+                                        uint64_t seq,
+                                        bool success,
+                                        const std::string& message) {
+  auto it = active_listeners_.find(script_id);
+  if (it == active_listeners_.end() || !it->second)
+    return;
+  ActiveListener* st = it->second.get();
+  if (st->seq != seq)
+    return;
 
+  st->listen_action.reset();
+  if (st->stop_requested)
+    return;
+
+  if (!success) {
+    // Timeout or transient failure: keep monitoring.
+    LOG(INFO) << "[ListenerManager] listen not satisfied: script=" << script_id
+              << " message=" << message;
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "[ListenerManager] listen not satisfied verbose: script="
+                << script_id << " auto_refresh=" << (st->auto_refresh ? 1 : 0)
+                << " will_rearm=1 detail="
+                << TruncateForLog(message, 1800);
+    }
+    st->info.status = "listening";
+    if (!message.empty())
+      st->info.status_detail = message;
+    if (!message.empty())
+      st->info.last_error = message;
+    if (st->auto_refresh) {
+      // When auto-refresh is enabled, a listen timeout means the refresh period
+      // already elapsed. Refresh immediately, then re-arm after navigation.
+      LogListenerEvent(script_id, *st, "refresh",
+                       "listen-timeout-refresh");
+      RefreshPageAndRearm(script_id, seq);
+    } else {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&ListenerManager::ArmListen,
+                         weak_ptr_factory_.GetWeakPtr(), script_id, seq),
+          base::Milliseconds(150));
+    }
+    return;
+  }
+
+  const std::vector<std::string> match_signatures = BuildMatchSignatures(message);
+  std::string selected_match_signature;
+  if (kEnableInSessionMatchDedupe) {
+    for (const auto& candidate : match_signatures) {
+      if (std::find(st->recent_match_signatures.begin(),
+                    st->recent_match_signatures.end(),
+                    candidate) == st->recent_match_signatures.end()) {
+        selected_match_signature = candidate;
+        break;
+      }
+    }
+    if (selected_match_signature.empty() && !match_signatures.empty()) {
+      LOG(INFO) << "[ListenerManager] duplicate match skipped for listener="
+                << script_id << " signatures="
+                << base::JoinString(match_signatures, ",");
+      st->info.status = "listening";
+      st->info.status_detail = "Duplicate match skipped.";
+      if (st->auto_refresh) {
+        ScheduleRefreshAndRearm(script_id, seq, st->refresh_interval);
+      } else {
+        ArmListen(script_id, seq);
+      }
+      return;
+    }
+  } else if (!match_signatures.empty()) {
+    selected_match_signature = match_signatures.front();
+  }
+  LOG(INFO) << "[ListenerManager] listen matched: script=" << script_id
+            << " trigger_script=" << st->on_match_script_id
+            << " detail=" << message;
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ListenerManager] listen matched verbose: script=" << script_id
+              << " trigger_script=" << st->on_match_script_id
+              << " auto_refresh=" << (st->auto_refresh ? 1 : 0)
+              << " detail=" << TruncateForLog(message, 1800);
+  }
+
+  // Condition satisfied: run trigger script, but throttle by the listener's
+  // own execution frequency setting.
+  const std::string trigger_id = st->on_match_script_id;
+  if (trigger_id.empty()) {
+    if (st->auto_refresh) {
+      ScheduleRefreshAndRearm(script_id, seq, st->refresh_interval);
+    } else {
+      ArmListen(script_id, seq);
+    }
+    return;
+  }
+
+  const base::Time now = base::Time::Now();
+  const base::TimeDelta throttle =
+      st->refresh_interval.is_positive() ? st->refresh_interval
+                                         : kDefaultAutoRefreshInterval;
+  if (!st->last_triggered.is_null()) {
+    const base::TimeDelta elapsed = now - st->last_triggered;
+    if (elapsed < throttle) {
+      const base::TimeDelta remaining = throttle - elapsed;
+      st->info.status = "listening";
+      st->info.status_detail = "Listener throttle active…";
+      if (st->auto_refresh) {
+        ScheduleRefreshAndRearm(script_id, seq, remaining);
+      } else {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+            FROM_HERE,
+            base::BindOnce(&ListenerManager::ArmListen,
+                           weak_ptr_factory_.GetWeakPtr(), script_id, seq),
+            remaining);
+      }
+      return;
+    }
+  }
+
+  base::Value::Dict trigger_script = dashboard_->LoadScript(trigger_id);
+  if (trigger_script.empty()) {
+    LOG(ERROR) << "[ListenerManager] trigger script missing id=" << trigger_id;
+    st->info.status = "error";
+    st->info.status_detail = "Trigger script missing.";
+    st->info.last_error = st->info.status_detail;
+    if (st->auto_refresh) {
+      ScheduleRefreshAndRearm(script_id, seq, st->refresh_interval);
+    } else {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&ListenerManager::ArmListen,
+                         weak_ptr_factory_.GetWeakPtr(), script_id, seq),
+          base::Milliseconds(250));
+    }
+    return;
+  }
+
+  base::Value::List flat = FlattenTimeline(trigger_script);
+  base::flat_set<std::string> visiting;
+  base::Value::List expanded = ExpandCallScripts(dashboard_, flat, &visiting);
+  const std::string trigger_initial_url = ReadInitialUrlFromScript(trigger_script);
+  std::optional<GURL> trigger_start_url =
+      NormalizeListenerStartUrl(trigger_initial_url);
+  // If the trigger script has no explicit context URL, prefer its first
+  // navigate target instead of defaulting to about:blank.
+  if (!trigger_start_url) {
+    trigger_start_url = ReadFirstNavigateUrl(expanded);
+  }
+  base::Value::List trigger_key_timeline;
+  const std::string trigger_key_script_id = ReadKeyScriptId(trigger_script);
+  if (!trigger_key_script_id.empty()) {
+    base::Value::Dict trigger_key_script =
+        dashboard_->LoadScript(trigger_key_script_id);
+    if (!trigger_key_script.empty()) {
+      base::Value::List key_flat = FlattenTimeline(trigger_key_script);
+      base::flat_set<std::string> key_visiting;
+      trigger_key_timeline =
+          ExpandCallScripts(dashboard_, key_flat, &key_visiting);
+    }
+  }
+
+  auto* exec_service =
+      dashboard::ScriptExecutionServiceFactory::GetForProfile(profile_);
+  if (!exec_service) {
+    LOG(ERROR) << "[ListenerManager] no ScriptExecutionService for trigger";
+    st->info.status = "error";
+    st->info.status_detail = "No ScriptExecutionService.";
+    st->info.last_error = st->info.status_detail;
+    ArmListen(script_id, seq);
+    return;
+  }
+
+  auto ensure_trigger_web_contents =
+      [&](ActiveListener* listener, std::optional<GURL> preferred_start_url)
+      -> content::WebContents* {
+    if (!listener)
+      return nullptr;
+    if (listener->trigger_web_contents)
+      return listener->trigger_web_contents;
+
+    Browser* trigger_browser = listener->browser;
+    if (!trigger_browser)
+      trigger_browser = chrome::FindLastActiveWithProfile(profile_);
+    if (!trigger_browser)
+      return nullptr;
+
+    const GURL initial_url = preferred_start_url.value_or(GURL("about:blank"));
+    NavigateParams trigger_np(trigger_browser, initial_url,
+                              ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    trigger_np.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    Navigate(&trigger_np);
+    content::WebContents* trigger_wc = trigger_np.navigated_or_inserted_contents;
+    if (!trigger_wc)
+      return nullptr;
+
+    listener->browser = trigger_browser;
+    listener->trigger_web_contents = trigger_wc;
+    listener->trigger_tab_observer.Watch(trigger_wc);
+    return trigger_wc;
+  };
+
+  content::WebContents* trigger_wc =
+      ensure_trigger_web_contents(st, trigger_start_url);
+  if (!trigger_wc) {
+    LOG(ERROR) << "[ListenerManager] failed to create/reuse trigger tab for listener="
+               << script_id;
+    st->info.status = "error";
+    st->info.status_detail = "Failed to create trigger background tab.";
+    st->info.last_error = st->info.status_detail;
+    LogListenerEvent(script_id, *st, "error", st->info.last_error);
+    if (st->auto_refresh) {
+      ScheduleRefreshAndRearm(script_id, seq, st->refresh_interval);
+    } else {
+      ArmListen(script_id, seq);
+    }
+    return;
+  }
+
+  st->last_triggered = now;
+  st->info.status = "trigger";
+  st->info.status_detail = "Running trigger script…";
+  st->info.running_kind = "trigger";
+
+  st->current_execution_id =
+      exec_service->StartScriptRun(
+          trigger_id, expanded, trigger_wc,
+          trigger_key_timeline.empty() ? nullptr : &trigger_key_timeline,
+          base::BindOnce(&ListenerManager::OnTriggerScriptCompleted,
+                         weak_ptr_factory_.GetWeakPtr(), script_id, seq));
+  st->info.execution_id = st->current_execution_id;
+  if (st->current_execution_id.empty()) {
+    st->info.status = "error";
+    st->info.status_detail = "Failed to start trigger script.";
+    st->info.last_error = st->info.status_detail;
+    st->info.running_kind.clear();
+    LogListenerEvent(script_id, *st, "error", st->info.last_error);
+    if (st->auto_refresh) {
+      ScheduleRefreshAndRearm(script_id, seq, st->refresh_interval);
+    } else {
+      ArmListen(script_id, seq);
+    }
+    return;
+  }
+  if (kEnableInSessionMatchDedupe && !selected_match_signature.empty()) {
+    RememberRecentMatchSignature(&st->recent_match_signatures,
+                                 selected_match_signature);
+    if (kEnableCrossRunMatchDedupe) {
+      PersistRecentMatchSignaturesAsync(profile_, dashboard_, script_id,
+                                        st->recent_match_signatures);
+    }
+  }
+
+  // Persist a marker event for the Debugging timeline.
+  {
+    base::Value::Dict ev;
+    ev.Set("ts_ms", static_cast<double>(now.InMillisecondsSinceUnixEpoch()));
+    ev.Set("action", "trigger");
+    ev.Set("listener_script_id", script_id);
+    ev.Set("listener_script_name", st->info.script_name);
+    ev.Set("trigger_script_id", trigger_id);
+    ev.Set("trigger_script_name", GetScriptName(trigger_id));
+    ev.Set("run_id", st->current_execution_id);
+    const std::string* cond = st->listen_params.FindString("condition");
+    if (cond)
+      ev.Set("condition", *cond);
+    base::ThreadPool::PostTask(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(
+            [](Profile* profile, base::Value::Dict ev) {
+              (void)dashboard::RunHistoryStore::AppendListenerEvent(profile, ev);
+            },
+            base::Unretained(profile_), ev.Clone()));
+  }
+}
+
+void ListenerManager::ScheduleRefreshAndRearm(const std::string& script_id,
+                                              uint64_t seq,
+                                              base::TimeDelta delay) {
+  auto it = active_listeners_.find(script_id);
+  if (it == active_listeners_.end() || !it->second)
+    return;
+  ActiveListener* st = it->second.get();
+  if (st->seq != seq || st->stop_requested)
+    return;
+  const base::TimeDelta wait =
+      delay.is_positive() ? delay : kDefaultAutoRefreshInterval;
+  st->info.status = "listening";
+  st->info.status_detail = "Waiting for refresh…";
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ListenerManager::RefreshPageAndRearm,
+                     weak_ptr_factory_.GetWeakPtr(), script_id, seq),
+      wait);
+}
+
+void ListenerManager::RefreshPageAndRearm(const std::string& script_id,
+                                          uint64_t seq) {
+  auto it = active_listeners_.find(script_id);
+  if (it == active_listeners_.end() || !it->second)
+    return;
+  ActiveListener* st = it->second.get();
+  if (st->seq != seq || st->stop_requested)
+    return;
+  if (!st->web_contents) {
+    st->info.status = "error";
+    st->info.status_detail = "Listener tab was closed.";
+    st->info.last_error = st->info.status_detail;
+    return;
+  }
+
+  CollectSnapshotKeys(
+      st->web_contents, st->listen_params,
+      base::BindOnce(&ListenerManager::OnPreRefreshSnapshotCollected,
+                     weak_ptr_factory_.GetWeakPtr(), script_id, seq));
+}
+
+void ListenerManager::OnPreRefreshSnapshotCollected(
+    const std::string& script_id,
+    uint64_t seq,
+    std::vector<std::string> pre_keys) {
+  auto it = active_listeners_.find(script_id);
+  if (it == active_listeners_.end() || !it->second)
+    return;
+  ActiveListener* st = it->second.get();
+  if (st->seq != seq || st->stop_requested)
+    return;
+  if (!st->web_contents) {
+    st->info.status = "error";
+    st->info.status_detail = "Listener tab was closed.";
+    st->info.last_error = st->info.status_detail;
+    return;
+  }
+
+  st->pre_refresh_snapshot_keys = std::move(pre_keys);
+  st->awaiting_post_refresh_snapshot = true;
+  st->jitter_due_after_refresh = st->refresh_jitter_enabled;
+  st->info.status = "listening";
+  st->info.status_detail = "Refreshing listener page…";
+  LogListenerEvent(script_id, *st, "refresh", "reload");
+  st->web_contents->GetController().Reload(content::ReloadType::NORMAL, false);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ListenerManager::ArmListen,
+                     weak_ptr_factory_.GetWeakPtr(), script_id, seq),
+      kPostRefreshSettleDelay);
+}
+
+void ListenerManager::CollectSnapshotKeys(
+    content::WebContents* web_contents,
+    const base::Value::Dict& listen_params,
+    base::OnceCallback<void(std::vector<std::string>)> callback) {
+  if (!web_contents) {
+    std::move(callback).Run({});
+    return;
+  }
+  content::RenderFrameHost* rfh = web_contents->GetPrimaryMainFrame();
+  if (!rfh) {
+    std::move(callback).Run({});
+    return;
+  }
+  const bool lifecycle_allows_js =
+      rfh->IsInLifecycleState(
+          content::RenderFrameHost::LifecycleState::kActive) ||
+      rfh->IsInLifecycleState(
+          content::RenderFrameHost::LifecycleState::kPrerendering);
+  if (!lifecycle_allows_js) {
+    VLOG(1) << "[ListenerManager] Snapshot skipped: lifecycle disallows JS";
+    std::move(callback).Run({});
+    return;
+  }
+  // Avoid injecting during transient navigation states.
+  if (!rfh->IsRenderFrameLive() || !rfh->IsActive() || web_contents->IsLoading()) {
+    VLOG(1) << "[ListenerManager] Snapshot skipped: rfh_live="
+            << rfh->IsRenderFrameLive() << " rfh_active=" << rfh->IsActive()
+            << " loading=" << web_contents->IsLoading();
+    std::move(callback).Run({});
+    return;
+  }
+
+  const base::Value::List* locators = listen_params.FindList("locators");
+  if (!locators || locators->empty()) {
+    std::move(callback).Run({});
+    return;
+  }
+
+  std::string locators_json = "[]";
+  base::JSONWriter::Write(*locators, &locators_json);
+  std::string cond_json = "\"\"";
+  std::string text_json = "\"\"";
+  std::string attr_json = "\"\"";
+  base::JSONWriter::Write(
+      base::Value(listen_params.FindString("condition")
+                      ? *listen_params.FindString("condition")
+                      : std::string()),
+      &cond_json);
+  base::JSONWriter::Write(
+      base::Value(listen_params.FindString("text")
+                      ? *listen_params.FindString("text")
+                      : std::string()),
+      &text_json);
+  base::JSONWriter::Write(
+      base::Value(listen_params.FindString("attribute")
+                      ? *listen_params.FindString("attribute")
+                      : std::string()),
+      &attr_json);
+
+  const std::string js = base::StringPrintf(
+      R"JS((function(locators, condition, needle, attribute){
+            function norm(s){ return String(s||'').replace(/\s+/g, ' ').trim(); }
+            function safeQueryAll(sel){ try { return Array.from(document.querySelectorAll(String(sel||''))); } catch(e) { return []; } }
+            function byXPath(xpath){
+              try {
+                const snap=document.evaluate(String(xpath||''), document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);
+                const out=[]; for(let i=0;i<snap.snapshotLength;i++) out.push(snap.snapshotItem(i)); return out;
+              } catch(e) { return []; }
+            }
+            function parseCoords(v){
+              try {
+                if (v && typeof v === 'object') {
+                  const x = Number(v.x), y = Number(v.y);
+                  if (Number.isFinite(x) && Number.isFinite(y)) return {x, y};
+                }
+                const s = String(v||'').trim();
+                const i = s.indexOf(',');
+                if (i > 0) {
+                  const x = Number(s.slice(0, i).trim());
+                  const y = Number(s.slice(i + 1).trim());
+                  if (Number.isFinite(x) && Number.isFinite(y)) return {x, y};
+                }
+              } catch(e) {}
+              return null;
+            }
+            function matchesFor(loc){
+              switch(String((loc && loc.type) || '')){
+                case 'ID': return [document.getElementById(loc.value)].filter(Boolean);
+                case 'CSS_SELECTOR': return safeQueryAll(loc.value);
+                case 'NAME': try { return Array.from(document.getElementsByName(String(loc.value||''))); } catch(e){ return []; }
+                case 'CLASS_NAME': return Array.from(document.getElementsByClassName(String(loc.value||'')));
+                case 'TAG_NAME': return Array.from(document.getElementsByTagName(String(loc.value||'')));
+                case 'XPATH': return byXPath(loc.value);
+                case 'LINK_TEXT': {
+                  const out=[]; const all=document.getElementsByTagName('a'); const want=String(loc.value||'').trim();
+                  for (let i=0;i<all.length;i++) { const t=norm(all[i].innerText || all[i].textContent || ''); if (t===want) out.push(all[i]); }
+                  return out;
+                }
+                case 'PARTIAL_LINK_TEXT': {
+                  const out=[]; const all=document.getElementsByTagName('a'); const want=String(loc.value||'').trim();
+                  for (let i=0;i<all.length;i++) { const t=norm(all[i].innerText || all[i].textContent || ''); if (want && t.includes(want)) out.push(all[i]); }
+                  return out;
+                }
+                case 'TEXT_CONTENT': {
+                  const out=[]; const all=document.getElementsByTagName('*'); const want=String(loc.value||'').trim();
+                  for (let i=0;i<all.length;i++) { const t=norm(all[i].innerText || all[i].textContent || ''); if (t===want) out.push(all[i]); }
+                  return out;
+                }
+                case 'VISUAL_COORDS': {
+                  const c = parseCoords(loc.value);
+                  if (!c) return [];
+                  try { const el = document.elementFromPoint(c.x, c.y); return el ? [el] : []; } catch(e) { return []; }
+                }
+                default: return [];
+              }
+            }
+            function visible(el){
+              if (!el) return false;
+              try {
+                const r = el.getBoundingClientRect();
+                if (!r || r.width <= 0 || r.height <= 0) return false;
+                const cs = window.getComputedStyle(el);
+                if (!cs) return true;
+                if (cs.display === 'none') return false;
+                if (cs.visibility === 'hidden' || cs.visibility === 'collapse') return false;
+                const op = parseFloat(cs.opacity || '1');
+                if (!Number.isNaN(op) && op <= 0.01) return false;
+              } catch(e) { return false; }
+              return true;
+            }
+            function textFor(el){
+              if (!el) return '';
+              try {
+                const tag = String(el.tagName || '').toLowerCase();
+                if (tag === 'input' || tag === 'textarea') return norm(el.value || '');
+              } catch(e) {}
+              return norm(el.innerText || el.textContent || '');
+            }
+            function attrFor(el){ try { return String((el && attribute) ? (el.getAttribute(String(attribute)) || '') : ''); } catch(e) { return ''; } }
+            function matchesCondition(el){
+              const cond = String(condition || '').toLowerCase();
+              const want = norm(needle || '');
+              if (!el) return false;
+              if (cond === 'visible') return visible(el);
+              if (cond === 'hidden') return !visible(el);
+              if (cond === 'text_contains' || cond === 'contains_text') return !!want && textFor(el).includes(want);
+              if (cond === 'text_equals' || cond === 'text_is') return !!want && textFor(el) === want;
+              if (cond === 'attribute_contains') return !!attribute && !!want && attrFor(el).includes(want);
+              if (cond === 'attribute_equals') return !!attribute && !!want && norm(attrFor(el)) === want;
+              // Transition-based conditions are resolved by diffing snapshots.
+              return true;
+            }
+            function articleMetaFor(el){
+              let author='', timestamp='', articleText='';
+              try {
+                const article = el && el.closest ? el.closest('[role="article"], article') : null;
+                if (!article) return {author, timestamp, articleText};
+                const authorNode = article.querySelector('[data-testid="User-Name"], [data-author], [itemprop="author"], a[rel="author"]');
+                if (authorNode) author = norm((authorNode.getAttribute && authorNode.getAttribute('data-author')) || authorNode.innerText || authorNode.textContent || '');
+                const timeNode = article.querySelector('time,[datetime],[data-time]');
+                if (timeNode) timestamp = norm((timeNode.getAttribute && (timeNode.getAttribute('datetime') || timeNode.getAttribute('data-time'))) || timeNode.innerText || timeNode.textContent || '');
+                articleText = norm(article.innerText || article.textContent || '').slice(0, 220);
+              } catch(e) {}
+              return {author, timestamp, articleText};
+            }
+            function attrVal(node, name){
+              try { return norm(node && node.getAttribute ? (node.getAttribute(name) || '') : ''); } catch (e) {}
+              return '';
+            }
+            function domPath(node){
+              const parts = [];
+              let cur = node;
+              let depth = 0;
+              while (cur && cur.nodeType === 1 && depth < 6) {
+                const tagName = String(cur.tagName || '').toLowerCase();
+                if (!tagName) break;
+                let index = 1;
+                try {
+                  let sib = cur.previousElementSibling;
+                  while (sib) {
+                    if (String(sib.tagName || '').toLowerCase() === tagName) index++;
+                    sib = sib.previousElementSibling;
+                  }
+                } catch (e) {}
+                parts.push(tagName + ':' + String(index));
+                cur = cur.parentElement;
+                depth++;
+              }
+              return parts.join('>');
+            }
+            function keyFor(el){
+              const meta = articleMetaFor(el);
+              if (meta.author || meta.timestamp || meta.articleText) {
+                return 'a|' + meta.author + '|' + meta.timestamp + '|' + meta.articleText;
+              }
+              const tag = String(el.tagName || '').toLowerCase();
+              const id = norm(el.id || '');
+              const cls = norm(el.className || '');
+              const href = attrVal(el, 'href');
+              const src = attrVal(el, 'src');
+              const dataId = attrVal(el, 'data-id') || attrVal(el, 'data-testid') ||
+                             attrVal(el, 'data-urn') || attrVal(el, 'data-item-id');
+              const dateTime = attrVal(el, 'datetime');
+              const aria = attrVal(el, 'aria-label');
+              const role = attrVal(el, 'role');
+              const path = domPath(el);
+              const text = textFor(el).slice(0, 180);
+              const childCount = (el && el.children && Number.isFinite(el.children.length)) ? el.children.length : 0;
+              return 'e|' + tag + '|' + id + '|' + cls + '|' + dataId + '|' + href + '|' + src +
+                     '|' + dateTime + '|' + aria + '|' + role + '|' + path + '|' +
+                     childCount + '|' + text;
+            }
+            const out=[]; const seen=new Set();
+            const inputLocators = Array.isArray(locators) ? locators : [];
+            for (let i=0; i<inputLocators.length; i++) {
+              const arr = matchesFor(inputLocators[i]) || [];
+              for (let j=0; j<arr.length; j++) {
+                const el = arr[j];
+                if (!el || el.nodeType !== 1) continue;
+                if (!matchesCondition(el)) continue;
+                const k = keyFor(el);
+                if (!k || seen.has(k)) continue;
+                seen.add(k);
+                out.push(k);
+                if (out.length >= 512) return out;
+              }
+            }
+            return out;
+          })(%s, %s, %s, %s);)JS",
+      locators_json.c_str(), cond_json.c_str(), text_json.c_str(),
+      attr_json.c_str());
+
+  rfh->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(js),
+      base::BindOnce(
+          [](base::OnceCallback<void(std::vector<std::string>)> cb,
+             base::Value result) {
+            std::vector<std::string> keys;
+            const base::Value::List* list = result.GetIfList();
+            if (!list && result.is_dict()) {
+              list = result.GetDict().FindList("value");
+            }
+            if (list) {
+              base::flat_set<std::string> dedupe;
+              for (const auto& v : *list) {
+                std::string s;
+                if (v.is_string())
+                  s = v.GetString();
+                else
+                  s = v.DebugString();
+                if (s.empty() || dedupe.contains(s))
+                  continue;
+                dedupe.insert(s);
+                keys.push_back(std::move(s));
+              }
+            }
+            std::move(cb).Run(std::move(keys));
+          },
+          std::move(callback)),
+      content::ISOLATED_WORLD_ID_CONTENT_END);
+}
+
+void ListenerManager::OnTriggerScriptCompleted(const std::string& script_id,
+                                               uint64_t seq,
+                                               bool success,
+                                               int /*failed_step*/,
+                                               std::string message) {
+  auto it = active_listeners_.find(script_id);
+  if (it == active_listeners_.end() || !it->second)
+    return;
+  ActiveListener* st = it->second.get();
+  if (st->seq != seq)
+    return;
+  const std::string completed_execution_id = st->current_execution_id;
+  st->current_execution_id.clear();
+  if (st->stop_requested)
+    return;
+  if (!success) {
+    LOG(WARNING) << "[ListenerManager] triggered script failed for listener="
+                 << script_id << " message=" << message;
+    st->info.last_error = message.empty() ? "Triggered script failed" : message;
+    st->info.status_detail = st->info.last_error;
+    LogListenerEvent(script_id, *st, "error", st->info.last_error,
+                     completed_execution_id);
+  }
+  st->info.execution_id.clear();
+  st->info.running_kind.clear();
+  if (st->auto_refresh) {
+    ScheduleRefreshAndRearm(script_id, seq, st->refresh_interval);
+  } else {
+    ArmListen(script_id, seq);
+  }
+}
+
+void ListenerManager::OnListenerTabDestroyed(const std::string& script_id,
+                                             uint64_t seq) {
+  auto it = active_listeners_.find(script_id);
+  if (it == active_listeners_.end() || !it->second)
+    return;
+  if (it->second->seq != seq)
+    return;
+  std::string ignored;
+  StopListener(script_id, &ignored);
+}
+
+void ListenerManager::PerformEvasiveInteraction(content::WebContents* web_contents) {
+  if (!web_contents)
+    return;
+  content::RenderFrameHost* rfh = web_contents->GetPrimaryMainFrame();
+  if (!rfh)
+    return;
+  const bool lifecycle_allows_js =
+      rfh->IsInLifecycleState(
+          content::RenderFrameHost::LifecycleState::kActive) ||
+      rfh->IsInLifecycleState(
+          content::RenderFrameHost::LifecycleState::kPrerendering);
+  if (!lifecycle_allows_js)
+    return;
+  if (!rfh->IsRenderFrameLive() || !rfh->IsActive() || web_contents->IsLoading())
+    return;
+
+  const int x = base::RandInt(10, 1200);
+  const int y = base::RandInt(10, 800);
+  const int scroll = base::RandInt(kEvasiveScrollMinPx, kEvasiveScrollMaxPx);
+  const std::string js = base::StringPrintf(
+      "(function(){"
+      "  try {"
+      "    const w = Math.max(1, window.innerWidth || 1);"
+      "    const h = Math.max(1, window.innerHeight || 1);"
+      "    const x = Math.min(%d, Math.max(0, w - 1));"
+      "    const y = Math.min(%d, Math.max(0, h - 1));"
+      "    document.dispatchEvent(new MouseEvent('mousemove', {"
+      "      bubbles: true, cancelable: true, clientX: x, clientY: y"
+      "    }));"
+      "    window.scrollBy({top:%d,left:0,behavior:'instant'});"
+      "  } catch (e) {}"
+      "})();",
+      x, y, scroll);
+  rfh->ExecuteJavaScriptInIsolatedWorld(base::UTF8ToUTF16(js),
+                                        base::NullCallback(),
+                                        content::ISOLATED_WORLD_ID_CONTENT_END);
+}
+
+void ListenerManager::LogListenerEvent(const std::string& script_id,
+                                       const ActiveListener& listener,
+                                       const std::string& action,
+                                       const std::string& detail,
+                                       const std::string& execution_id) {
+  base::Value::Dict ev;
+  const base::Time now = base::Time::Now();
+  ev.Set("ts_ms", static_cast<double>(now.InMillisecondsSinceUnixEpoch()));
+  ev.Set("listener_script_id", script_id);
+  ev.Set("listener_script_name", listener.info.script_name);
+  ev.Set("action", action);
+  if (!execution_id.empty())
+    ev.Set("run_id", execution_id);
+  if (!detail.empty())
+    ev.Set("detail", detail);
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(
+          [](Profile* profile, base::Value::Dict ev) {
+            (void)dashboard::RunHistoryStore::AppendListenerEvent(profile, ev);
+          },
+          base::Unretained(profile_), std::move(ev)));
+  DashboardUIMessageHandler::NotifyListenersChanged();
+}
+
+}  // namespace dashboard
