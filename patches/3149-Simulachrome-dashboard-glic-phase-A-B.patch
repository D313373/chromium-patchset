+void RecorderController::QueueClickFallback(int x_css, int y_css) {
+  if (!is_recording_)
+    return;
+  pending_click_fallback_point_ = gfx::Point(x_css, y_css);
+  pending_click_fallback_timer_.Stop();
+  pending_click_fallback_timer_.Start(
+      FROM_HERE, base::Milliseconds(250),
+      base::BindOnce(
+          [](base::WeakPtr<RecorderController> weak) {
+            if (!weak || !weak->is_recording_)
+              return;
+            if (!weak->pending_click_fallback_point_)
+              return;
+            const gfx::Point pt = *weak->pending_click_fallback_point_;
+            weak->pending_click_fallback_point_.reset();
+
+            base::Value::Dict action;
+            action.Set("action", "click");
+            base::Value::Dict params;
+            base::Value::Dict coords;
+            coords.Set("x", pt.x());
+            coords.Set("y", pt.y());
+            params.Set("coordinates", std::move(coords));
+            params.Set("x", pt.x());
+            params.Set("y", pt.y());
+
+            base::Value::List locators;
+            std::set<std::pair<std::string, std::string>> seen;
+            {
+              base::Value::Dict l;
+              l.Set("type", "VISUAL_COORDS");
+              l.Set("value", base::StringPrintf("%d,%d", pt.x(), pt.y()));
+              locators.Append(std::move(l));
+              seen.insert({"VISUAL_COORDS",
+                           base::StringPrintf("%d,%d", pt.x(), pt.y())});
+            }
+
+            // Best-effort enrichment: if we have an AgentStateSnapshot from the
+            // target page, synthesize richer locators (a11y/text/css/xpath)
+            // for this point. This keeps the recorder log useful even when
+            // the renderer resolver is unavailable/slow.
+            {
+              base::Value::Dict click;
+              click.Set("x", static_cast<double>(pt.x()));
+              click.Set("y", static_cast<double>(pt.y()));
+              const dashboard::mojom::AgentElementInfo* el =
+                  weak->FindMatchingAgentElement(click);
+              if (!el && weak->last_agent_state_snapshot_) {
+                // Some snapshots may report element bounds in page coordinates
+                // while the click comes in viewport coordinates. Try a
+                // scroll-adjusted lookup as a fallback.
+                base::Value::Dict click_page;
+                click_page.Set(
+                    "x", static_cast<double>(pt.x()) +
+                             static_cast<double>(
+                                 weak->last_agent_state_snapshot_->scroll_x));
+                click_page.Set(
+                    "y", static_cast<double>(pt.y()) +
+                             static_cast<double>(
+                                 weak->last_agent_state_snapshot_->scroll_y));
+                el = FindBestElementMatch(weak->last_agent_state_snapshot_.get(),
+                                          click_page);
+              }
+              if (el) {
+                AppendUniqueLocator(locators, seen, "FRAME_ID", el->frame_token);
+                AppendUniqueLocator(locators, seen, "ACCESSIBILITY_NAME",
+                                    el->accessibility_name);
+                if (!el->text.empty()) {
+                  AppendUniqueLocator(
+                      locators, seen, "TEXT_CONTENT",
+                      TrimForLocatorValue(el->text, 120u));
+                }
+                if (el->tag == "a" && !el->text.empty()) {
+                  AppendUniqueLocator(
+                      locators, seen, "LINK_TEXT",
+                      TrimForLocatorValue(el->text, 120u));
+                  AppendUniqueLocator(
+                      locators, seen, "PARTIAL_LINK_TEXT",
+                      TrimForLocatorValue(el->text, 40u));
+                }
+                AppendUniqueLocator(locators, seen, "ID", el->id_attr);
+                AppendUniqueLocator(locators, seen, "NAME", el->name_attr);
+                AppendUniqueLocator(locators, seen, "CSS_SELECTOR",
+                                    el->css_selector);
+                AppendUniqueLocator(locators, seen, "XPATH", el->xpath);
+                AppendUniqueLocator(locators, seen, "SHADOW_DOM",
+                                    el->shadow_chain_selector);
+                AppendUniqueLocator(locators, seen, "RESOURCE_TREE",
+                                    el->resource_path);
+                AppendUniqueLocator(locators, seen, "TAG_NAME", el->tag);
+                AppendUniqueLocator(locators, seen, "CLASS_NAME", el->class_attr);
+              }
+            }
+
+            {
+              base::Value::Dict l;
+              l.Set("type", "JS_EVAL");
+              l.Set("value",
+                    base::StringPrintf(
+                        "document.elementFromPoint(%d,%d)", pt.x(), pt.y()));
+              locators.Append(std::move(l));
+            }
+            params.Set("locators", std::move(locators));
