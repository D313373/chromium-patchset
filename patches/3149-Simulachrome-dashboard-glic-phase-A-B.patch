@@ -0,0 +1,66 @@
+#!/bin/bash
+# Launch Glic dev in tmux with a dedicated headless-log window.
+
+set -euo pipefail
+
+SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
+CHROME_DIR="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
+
+SESSION_NAME="${SESSION_NAME:-glic-dev}"
+HEADLESS_LOG_DIR="${HEADLESS_LOG_DIR:-$HOME/.simulachrome}"
+HEADLESS_LAUNCH_LOG="${HEADLESS_LAUNCH_LOG:-$HEADLESS_LOG_DIR/headless_listener_launch.log}"
+HEADLESS_EVENTS_LOG="${HEADLESS_EVENTS_LOG:-$HEADLESS_LOG_DIR/headless_listener_events.jsonl}"
+
+q() {
+  printf "%q" "$1"
+}
+
+if ! command -v tmux >/dev/null 2>&1; then
+  echo "ERROR: tmux is not installed. Install tmux or use start_glic_dev.sh directly."
+  exit 1
+fi
+
+EXTRA_ARGS=()
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --session|-s)
+      SESSION_NAME="$2"
+      shift 2
+      ;;
+    *)
+      EXTRA_ARGS+=("$1")
+      shift
+      ;;
+  esac
+done
+
+if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
+  echo "tmux session '$SESSION_NAME' already exists, attaching."
+  exec tmux attach -t "$SESSION_NAME"
+fi
+
+mkdir -p "$HEADLESS_LOG_DIR"
+touch "$HEADLESS_LAUNCH_LOG" "$HEADLESS_EVENTS_LOG"
+
+ARGS_STR=""
+for arg in "${EXTRA_ARGS[@]}"; do
+  ARGS_STR+=" $(q "$arg")"
+done
+
+MAIN_CMD="cd $(q "$CHROME_DIR") && STREAM_HEADLESS_LOGS=0 $(q "$SCRIPT_DIR/start_glic_dev.sh")$ARGS_STR"
+LAUNCH_TAIL_CMD="cd $(q "$CHROME_DIR") && tail -n 200 -F $(q "$HEADLESS_LAUNCH_LOG") | sed -u 's/^/[headless-launch] /'"
+EVENTS_TAIL_CMD="cd $(q "$CHROME_DIR") && tail -n 200 -F $(q "$HEADLESS_EVENTS_LOG") | sed -u 's/^/[headless-event]  /'"
+
+tmux new-session -d -s "$SESSION_NAME" -n main "$MAIN_CMD"
+tmux new-window -t "$SESSION_NAME:" -n headless-logs "$LAUNCH_TAIL_CMD"
+tmux split-window -v -t "$SESSION_NAME:headless-logs" "$EVENTS_TAIL_CMD"
+tmux select-layout -t "$SESSION_NAME:headless-logs" even-vertical
+tmux select-window -t "$SESSION_NAME:main"
+
+echo "Session '$SESSION_NAME' started."
+echo "  Window 1 (main): Chromium + proxy launcher"
+echo "  Window 2 (headless-logs): launch log + events log tails"
+echo "Switch windows with Ctrl-b n / Ctrl-b p."
+echo "Detach with Ctrl-b d."
+
+exec tmux attach -t "$SESSION_NAME"
diff --git a/chrome/test/data/webui/glic/test_client/start_proxy.sh b/chrome/test/data/webui/glic/test_client/start_proxy.sh
