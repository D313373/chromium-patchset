+// StealthUserActionTracker: renderer-side stub that will forward user clicks
+// to the browser via dashboard.mojom.RecorderAgent. This initial version binds
+// the mojo remote; a follow-up will hook input events and send real clicks.
+
+#ifndef CHROME_RENDERER_DASHBOARD_STEALTH_USER_ACTION_TRACKER_H_
+#define CHROME_RENDERER_DASHBOARD_STEALTH_USER_ACTION_TRACKER_H_
