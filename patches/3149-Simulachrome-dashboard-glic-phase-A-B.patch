+            } else if (!host_result.error.empty()) {
+              VLOG(1) << "[Dashboard] headless relay poll warning: "
+                      << host_result.error;
+              ScheduleHeadlessRelayPoll(profile, kHeadlessRelayErrorBackoff);
+            }
+          },
+          base::Unretained(profile)));
