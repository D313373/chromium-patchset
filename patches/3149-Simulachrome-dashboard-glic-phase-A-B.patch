+
+void RecorderController::OnHoverSnapshotCaptured(
+    gfx::Point hover_point,
+    std::string pre_hover_signature,
+    base::TimeTicks queued_at,
+    dashboard::mojom::AgentStateSnapshotPtr snapshot) {
+  if (!is_recording_ || !snapshot) {
+    return;
+  }
+
+  const std::string post_signature =
+      BuildHoverTransitionSignature(snapshot.get());
+  if (post_signature.empty() || post_signature == pre_hover_signature) {
+    return;
+  }
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (post_signature == last_hover_transition_signature_ &&
+      !last_hover_recorded_at_.is_null() &&
+      now - last_hover_recorded_at_ < kHoverTransitionMinRecordInterval) {
+    return;
+  }
+
+  const dashboard::mojom::AgentElementInfo* target =
+      FindSnapshotTargetElement(snapshot.get());
+  if (!target) {
+    return;
+  }
+
+  base::Value::List locators;
+  std::set<std::pair<std::string, std::string>> seen;
+  AppendUniqueLocator(locators, seen, "VISUAL_COORDS",
+                      base::StringPrintf("%d,%d", hover_point.x(),
+                                         hover_point.y()));
+  AppendUniqueLocator(locators, seen, "TAG_NAME", target->tag);
+  AppendUniqueLocator(locators, seen, "ID", target->id_attr);
+  AppendUniqueLocator(locators, seen, "CLASS_NAME", target->class_attr);
+  AppendUniqueLocator(locators, seen, "NAME", target->name_attr);
+  AppendUniqueLocator(locators, seen, "TEXT_CONTENT",
+                      TrimForLocatorValue(target->text, 120u));
+  AppendUniqueLocator(locators, seen, "CSS_SELECTOR", target->css_selector);
+  AppendUniqueLocator(locators, seen, "XPATH", target->xpath);
+
+  base::Value::Dict hover_click;
+  hover_click.Set("x", hover_point.x());
+  hover_click.Set("y", hover_point.y());
+  hover_click.Set("click_count", 0);
+  hover_click.Set("text", target->text);
+  if (!target->css_selector.empty())
+    hover_click.Set("css", target->css_selector);
+  if (!target->xpath.empty())
+    hover_click.Set("xpath", target->xpath);
+  if (!target->frame_token.empty())
+    hover_click.Set("frame_id", target->frame_token);
+  hover_click.Set("locators", std::move(locators));
+  hover_click.Set("accessibility_name", target->accessibility_name);
+  hover_click.Set("role", target->role);
+  hover_click.Set("is_disabled", target->disabled);
+  OnUserClickFromRenderer(std::move(hover_click));
+
+  const int wait_ms = queued_at.is_null()
+                          ? 0
+                          : static_cast<int>((now - queued_at).InMilliseconds());
+  if (wait_ms > 0) {
+    base::Value::Dict wait_action;
+    wait_action.Set("action", "wait");
+    base::Value::Dict params;
+    params.Set("waitType", "time");
+    params.Set("time", wait_ms);
+    params.Set("time_ms", wait_ms);
+    params.Set("semantic_source", "hover_transition");
+    params.Set("exclude_humanized_padding", true);
+    wait_action.Set("params", std::move(params));
+    AppendRecordedAction(std::move(wait_action));
+  }
+
+  last_hover_transition_signature_ = post_signature;
+  last_hover_recorded_at_ = now;
+}
