diff --git a/third_party/blink/renderer/core/agent/agent_loop.cc b/third_party/blink/renderer/core/agent/agent_loop.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b5959deadd214bf27d3cdc72f0ae9d5749ecb8c2
--- /dev/null
+++ b/third_party/blink/renderer/core/agent/agent_loop.cc
@@ -0,0 +1,131 @@
+#include "third_party/blink/renderer/core/agent/agent_loop.h"
+
+#include "base/logging.h"
+#include "third_party/blink/renderer/core/agent/agent_state_extractor.h"
+#include "third_party/blink/renderer/core/agent/agent_vectorizer.h"
+#include "third_party/blink/renderer/core/agent/agent_decoder.h"
+#include "third_party/blink/renderer/core/agent/agent_action_dispatcher.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+
+namespace blink {
+
+AgentLoop::AgentLoop(LocalFrame* frame)
+    : frame_(frame) {}
+
+AgentLoop::~AgentLoop() {
+  Stop();
+}
+
+bool AgentLoop::LoadModelIfNeeded() {
+  if (model_loaded_)
+    return true;
+
+  if (model_resource_id_ < 0) {
+    LOG(ERROR) << "[AgentLoop] Model resource ID not set.";
+    return false;
+  }
+
+  if (!troll_.LoadEmbeddedModel(model_resource_id_)) {
+    LOG(ERROR) << "[AgentLoop] Model load failed.";
+    return false;
+  }
+
+  model_loaded_ = true;
+  return true;
+}
+
+void AgentLoop::Start() {
+  if (running_)
+    return;
+
+  if (!LoadModelIfNeeded())
+    return;
+
+  running_ = true;
+  ScheduleNext();
+
+  LOG(INFO) << "[AgentLoop] Started.";
+}
+
+void AgentLoop::Stop() {
+  if (!running_)
+    return;
+
+  timer_.Stop();
+  running_ = false;
+
+  LOG(INFO) << "[AgentLoop] Stopped.";
+}
+
+void AgentLoop::ScheduleNext() {
+  timer_.Start(
+      FROM_HERE, interval_,
+      base::BindRepeating(&AgentLoop::Tick,
+                          base::Unretained(this)));
+}
+
+void AgentLoop::TickOnce() {
+  Tick();
+}
+
+void AgentLoop::Tick() {
+  if (!running_ || !frame_)
+    return;
+
+  // 1. Extract page state.
+  AgentState state = AgentStateExtractor::Extract(frame_);
+  if (state.elements.empty()) {
+    context_.AddHistory(state, AgentAction{}, false);
+    return;
+  }
+
+  context_.PushSiteSnapshot(state);
+
+  // 2. Vectorize
+  std::vector<float> input = AgentVectorizer::Vectorize(state);
+
+  if (static_cast<int>(input.size()) != troll_.input_size()) {
+    LOG(ERROR) << "[AgentLoop] Input tensor mismatch.";
+    context_.AddHistory(state, AgentAction{}, false);
+    return;
+  }
+
+  // 3. Inference
+  std::vector<float> output;
+  if (!troll_.RunInference(input, output)) {
+    LOG(ERROR) << "[AgentLoop] Inference failed.";
+    context_.AddHistory(state, AgentAction{}, false);
+    return;
+  }
+
+  if (static_cast<int>(output.size()) != troll_.output_size()) {
+    LOG(ERROR) << "[AgentLoop] Output size mismatch.";
+    context_.AddHistory(state, AgentAction{}, false);
+    return;
+  }
+
+  // 4. Decode
+  AgentAction action = AgentDecoder::Decode(output, state);
+  if (!action.IsValid()) {
+    context_.AddHistory(state, action, false);
+    return;
+  }
+
+  // Loop-prevention heuristic
+  if (context_.history().size() >= 3) {
+    auto& h = context_.history();
+    if (h[h.size()-1].action.type == action.type &&
+        h[h.size()-2].action.type == action.type &&
+        h[h.size()-3].action.type == action.type) {
+      LOG(WARNING) << "[AgentLoop] Loop detected.";
+      context_.AddHistory(state, action, false);
+      return;
+    }
+  }
+
+  // 5. Execute
+  AgentActionDispatcher::Dispatch(action, frame_);
+  context_.AddHistory(state, action, true);
+}
+
+}  // namespace blink
