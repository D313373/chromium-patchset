+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_HISTORY_NAV_ACTION_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_HISTORY_NAV_ACTION_H_
+
+#include <string>
+
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/webui/dashboard/actions/action_base.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace dashboard::actions {
+
+// Executes a single-step back/forward history navigation using the browser's
+// NavigationController (trusted).
+class HistoryNavAction : public Action, public content::WebContentsObserver {
+ public:
+  enum class Direction { kBack, kForward };
+
+  HistoryNavAction(Profile* profile, Direction direction);
+  ~HistoryNavAction() override;
+
+  // dashboard::actions::Action
+  void Execute(content::WebContents* web_contents, Callback callback) override;
+  bool SetParams(const base::Value::Dict& params) override;
+
+  // content::WebContentsObserver
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+  void WebContentsDestroyed() override;
+
+ private:
+  void OnTimeout();
+  void Finish(bool success, const std::string& message);
+
+  const Direction direction_;
+  int start_entry_index_ = -1;
+  Callback pending_callback_;
+  base::OneShotTimer timeout_timer_;
+};
+
+}  // namespace dashboard::actions
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_HISTORY_NAV_ACTION_H_
