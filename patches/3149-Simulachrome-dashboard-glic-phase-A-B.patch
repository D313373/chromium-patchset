+namespace dashboard {
+class LocatorResolver;
+}  // namespace dashboard
+
+// A listener action that waits until a condition becomes true for a target
+// element. The actual detection happens in the renderer (MutationObserver /
+// IntersectionObserver / input events). The browser side polls a small DOM
+// attribute to learn when the condition is satisfied, since the production
+// ExecuteJavaScript APIs do not resolve Promises.
+class ListenAction : public dashboard::actions::Action {
+ public:
+  explicit ListenAction(Profile* profile);
+  ~ListenAction() override;
+
+  ListenAction(const ListenAction&) = delete;
+  ListenAction& operator=(const ListenAction&) = delete;
+
+  bool SetParams(const base::Value::Dict& params) override;
+  void Execute(content::WebContents* web_contents, Callback callback) override;
+
+ private:
+  void StartListenerInFrame(content::RenderFrameHost* rfh);
+  void OnListenerInstalled(base::Value result);
+
+  void PollListenerState();
+  void OnListenerStatePolled(base::Value result);
+
+  void OnListenerCompleted(base::Value state);
+  void Finish(bool success, const std::string& message);
+
+  std::vector<dashboard::Locator> locators_;
+  std::optional<content::GlobalRenderFrameHostId> frame_hint_;
+  std::string condition_;
+  std::string text_;
+  std::string attribute_;
+  std::string on_match_script_id_;
+  int timeout_ms_ = 60000;
+  std::string token_;
+  content::GlobalRenderFrameHostId target_frame_id_;
+  base::TimeTicks start_time_;
+  Callback callback_;
+
+  base::WeakPtrFactory<ListenAction> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_LISTEN_ACTION_H_
