+        }
+        publishSmartInputCatalogNow();
+      } else {
+        secretsStatusEl.textContent = 'Save failed.';
+      }
+    } catch (err) {
+      secretsStatusEl.textContent = 'Save failed.';
+    }
+  });
+}
