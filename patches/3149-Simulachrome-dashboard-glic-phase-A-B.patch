@@ -0,0 +1,47 @@
+#!/bin/bash
+# Simple script to start just the proxy server for debugging
+# Run this in one terminal, then launch Chrome manually in another
+
+set -e
+
+# Colors
+GREEN='\033[0;32m'
+YELLOW='\033[1;33m'
+RED='\033[0;31m'
+NC='\033[0m'
+
+echo -e "${GREEN}Starting Glic Proxy Server${NC}"
+
+# Determine paths
+SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
+CHROME_DIR="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
+SRC_DIR="$(cd "$CHROME_DIR/.." && pwd)"
+OUT_DIR="${OUT_DIR:-$SRC_DIR/out/Default}"
+
+echo -e "${YELLOW}Configuration:${NC}"
+echo "  Script dir: $SCRIPT_DIR"
+echo "  Chrome dir: $CHROME_DIR"
+echo "  Build dir:  $OUT_DIR"
+
+# Check if build directory exists
+if [ ! -d "$OUT_DIR" ]; then
+    echo -e "${RED}ERROR: Build directory not found: $OUT_DIR${NC}"
+    echo "Set OUT_DIR environment variable or build Chrome first"
+    exit 1
+fi
+
+# Check if generated files exist
+GEN_DIR="$OUT_DIR/gen/chrome/test/data/webui/glic"
+if [ ! -d "$GEN_DIR" ]; then
+    echo -e "${YELLOW}WARNING: Generated files not found at $GEN_DIR${NC}"
+    echo -e "${YELLOW}Building test files...${NC}"
+    cd "$SRC_DIR"
+    autoninja -C out/Default chrome/test/data/webui/glic:generate_test_files
+fi
+
+echo -e "\n${GREEN}Starting proxy server on http://localhost:8000${NC}"
+echo -e "${YELLOW}Press Ctrl+C to stop${NC}\n"
+
+cd "$CHROME_DIR"
+exec python3 "$SCRIPT_DIR/serve.py" -C "$OUT_DIR"
+
diff --git a/chrome/test/data/webui/glic/test_client/test_sanitization.py b/chrome/test/data/webui/glic/test_client/test_sanitization.py
new file mode 100644
index 0000000000000000000000000000000000000000..b4c9df73eddc3f3f26f529bcea3603d72fa72eae
--- /dev/null
+++ b/chrome/test/data/webui/glic/test_client/test_sanitization.py
@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""
+Unit tests for payload sanitization logic.
+Run this to verify the sanitization is working correctly.
+"""
+
+import json
+import sys
+import os
+
+# Add the current directory to path to import serve module
+sys.path.insert(0, os.path.dirname(__file__))
+
+from serve import sanitize_openai_payload, strip_html_tags
+
+
+def test_screenshot_removal():
+    """Test that base64 screenshot data is removed."""
+    print("\n[TEST] Screenshot Removal")
+    
+    payload = {
+        "messages": [
+            {
+                "role": "user",
+                "content": "Test message",
+                "screenshot": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==" * 1000,
+                "imageData": "base64encodeddata" * 500
+            }
+        ]
+    }
+    
+    original = json.dumps(payload)
+    sanitized = sanitize_openai_payload(original)
+    result = json.loads(sanitized)
+    
+    assert 'screenshot' not in result['messages'][0], "Screenshot should be removed"
+    assert 'imageData' not in result['messages'][0], "ImageData should be removed"
+    assert len(sanitized) < len(original) * 0.1, "Sanitized payload should be much smaller"
+    
+    print("  ✅ Screenshot removal working correctly")
+    print(f"  Original: {len(original):,} bytes")
+    print(f"  Sanitized: {len(sanitized):,} bytes")
+    print(f"  Reduction: {(1 - len(sanitized)/len(original))*100:.1f}%")
+
+
+def test_node_id_preservation():
+    """Test that node IDs are preserved during sanitization."""
+    print("\n[TEST] Node ID Preservation")
+    
+    payload = {
+        "messages": [
+            {
+                "role": "user",
+                "content": "Click the button",
+                "page_elements": [
+                    {
+                        "backend_node_id": 12345,
+                        "ax_node_id": 67890,
+                        "role": "button",
+                        "name": "Submit",
+                        "screenshot": "base64data" * 1000
+                    }
+                ]
+            }
+        ]
+    }
+    
+    original = json.dumps(payload)
+    sanitized = sanitize_openai_payload(original)
+    result = json.loads(sanitized)
+
+    # Debug: print the actual structure
+    print(f"  Result structure: {json.dumps(result, indent=2)[:500]}")
+
+    # The system prompt is inserted at index 0, so user message is now at index 1
+    assert len(result['messages']) >= 2, "Should have system prompt + user message"
+    user_message = result['messages'][1]  # User message is now second
+
+    element = user_message['page_elements'][0]
+    assert element['backend_node_id'] == 12345, "backend_node_id should be preserved"
+    assert element['ax_node_id'] == 67890, "ax_node_id should be preserved"
+    assert element['role'] == "button", "role should be preserved"
+    assert element['name'] == "Submit", "name should be preserved"
+    assert 'screenshot' not in element, "screenshot should be removed"
+    
+    print("  ✅ Node IDs preserved correctly")
+    print(f"  backend_node_id: {element['backend_node_id']}")
+    print(f"  ax_node_id: {element['ax_node_id']}")
+
+
+def test_html_stripping():
+    """Test that HTML is stripped to plain text."""
+    print("\n[TEST] HTML Stripping")
+    
+    html = """
+    <html>
+        <head><title>Test Page</title></head>
+        <body>
+            <h1>Welcome</h1>
+            <p>This is a <strong>test</strong> page with <a href="#">links</a>.</p>
+            <div class="content">
+                <ul>
+                    <li>Item 1</li>
+                    <li>Item 2</li>
+                </ul>
+            </div>
+        </body>
+    </html>
+    """
+    
+    stripped = strip_html_tags(html)
+    
+    assert '<' not in stripped, "HTML tags should be removed"
+    assert '>' not in stripped, "HTML tags should be removed"
+    assert 'Welcome' in stripped, "Text content should be preserved"
+    assert 'test' in stripped, "Text content should be preserved"
+    assert 'Item 1' in stripped, "List items should be preserved"
+    
+    print("  ✅ HTML stripping working correctly")
+    print(f"  Original: {len(html)} chars")
+    print(f"  Stripped: {len(stripped)} chars")
+    print(f"  Result: {stripped[:100]}...")
+
+
+def test_large_html_truncation():
+    """Test that large HTML content is truncated."""
+    print("\n[TEST] Large HTML Truncation")
+    
+    large_html = "<p>" + ("Lorem ipsum dolor sit amet. " * 2000) + "</p>"
+    
+    payload = {
+        "messages": [
+            {
+                "role": "user",
+                "content": "Summarize this page",
+                "page_content": large_html
+            }
+        ]
+    }
+    
+    original = json.dumps(payload)
+    sanitized = sanitize_openai_payload(original)
+    result = json.loads(sanitized)
+
+    # System prompt is at index 0, user message at index 1
+    user_message = result['messages'][1]
+    page_content = user_message['page_content']
+    
+    assert len(page_content) <= 24100, "Content should be truncated to ~24K chars"
+    assert '[TRUNCATED]' in page_content, "Should indicate truncation"
+    assert '<' not in page_content, "HTML tags should be stripped"
+    
+    print("  ✅ Large HTML truncation working correctly")
+    print(f"  Original HTML: {len(large_html):,} chars")
+    print(f"  Sanitized: {len(page_content):,} chars")
+
+
+def test_system_prompt_injection():
+    """Test that Actor system prompt is injected."""
+    print("\n[TEST] System Prompt Injection")
+    
+    payload = {
+        "messages": [
+            {
+                "role": "user",
+                "content": "Click the button"
+            }
+        ]
+    }
+    
+    original = json.dumps(payload)
+    sanitized = sanitize_openai_payload(original)
+    result = json.loads(sanitized)
+    
+    assert len(result['messages']) == 2, "System prompt should be added"
+    assert result['messages'][0]['role'] == 'system', "First message should be system"
+    assert 'content_node_id' in result['messages'][0]['content'], "System prompt should mention node IDs"
+    assert 'action' in result['messages'][0]['content'], "System prompt should mention actions"
+    
+    print("  ✅ System prompt injection working correctly")
+    print(f"  System prompt: {result['messages'][0]['content'][:100]}...")
+
+
+def run_all_tests():
+    """Run all sanitization tests."""
+    print("="*80)
+    print("PAYLOAD SANITIZATION TESTS")
+    print("="*80)
+    
+    try:
+        test_screenshot_removal()
+        test_node_id_preservation()
+        test_html_stripping()
+        test_large_html_truncation()
+        test_system_prompt_injection()
+        
+        print("\n" + "="*80)
+        print("✅ ALL TESTS PASSED")
+        print("="*80)
+        return 0
+    
+    except AssertionError as e:
+        print(f"\n❌ TEST FAILED: {e}")
+        import traceback
+        traceback.print_exc()
+        return 1
+    
+    except Exception as e:
+        print(f"\n❌ ERROR: {e}")
+        import traceback
+        traceback.print_exc()
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(run_all_tests())
