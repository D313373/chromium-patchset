+#include "third_party/blink/public/web/web_frame.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_element.h"
+#include "third_party/blink/public/web/web_element_collection.h"
+#include "third_party/blink/public/web/web_ax_object.h"
+#include "third_party/blink/renderer/core/agent/agent_state_extractor.h"
+#include "ui/accessibility/ax_enum_util.h"
+#include "ui/accessibility/ax_mode.h"
+#include "ui/accessibility/ax_node_data.h"
+#include <string>
+#include <vector>
+
+namespace dashboard_renderer {
+
+namespace {
+
+struct AXSnapshot {
+  blink::WebAXObject ax;
+  bool valid = false;
+  bool ignored = false;
+  bool clickable = false;
+  bool focusable = false;
+  bool disabled = false;
+  std::string name;
+  std::string role;
+};
+
+AXSnapshot GetAXSnapshot(const blink::WebElement& el) {
+  AXSnapshot out;
+  if (el.IsNull())
+    return out;
+  out.ax = blink::WebAXObject::FromWebNode(el);
+  if (out.ax.IsNull() || out.ax.IsDetached())
+    return out;
+  out.valid = true;
+  out.ignored = out.ax.IsIgnored();
+  if (out.ignored || !out.ax.IsIncludedInTree())
+    return out;
+  out.clickable = out.ax.IsClickable();
+
+  ui::AXNodeData data;
+  ui::AXMode mode(ui::AXMode::kWebContents | ui::AXMode::kInlineTextBoxes |
+                  ui::AXMode::kExtendedProperties);
+  out.ax.Serialize(&data, mode);
+  out.disabled =
+      data.GetRestriction() == ax::mojom::Restriction::kDisabled;
+  out.focusable = data.HasState(ax::mojom::State::kFocusable);
+  out.role = ui::ToString(data.role);
+
+  ax::mojom::NameFrom name_from = ax::mojom::NameFrom::kNone;
+  std::vector<blink::WebAXObject> name_objects;
+  out.name = out.ax.GetName(name_from, name_objects).Utf8();
+  return out;
+}
+
+}  // namespace
+
+StealthUserActionTracker::StealthUserActionTracker(content::RenderFrame* frame)
+    : content::RenderFrameObserver(frame), frame_(frame) {
+  MaybeBindRecorderAgent();
+}
+
+StealthUserActionTracker::~StealthUserActionTracker() = default;
+
+void StealthUserActionTracker::OnDestruct() {
+  delete this;
+}
+
+void StealthUserActionTracker::DidFinishLoad() {
+  // Full-frame snapshot on load for baseline enrichment; targeted snapshots can
+  // be requested during actions as needed.
+  SendAgentStateSnapshot(nullptr, /*subtree_only=*/false,
+                         /*mark_hovered=*/false);
+}
+
+void StealthUserActionTracker::MaybeBindRecorderAgent() {
+  if (!frame_)
+    return;
+  if (recorder_agent_.is_bound() && recorder_agent_.is_connected())
+    return;
+  recorder_agent_.reset();
+  frame_->GetBrowserInterfaceBroker().GetInterface(
+      recorder_agent_.BindNewPipeAndPassReceiver());
+  recorder_agent_.set_disconnect_handler(base::BindOnce(
+      &StealthUserActionTracker::OnRecorderAgentDisconnected,
+      weak_factory_.GetWeakPtr()));
+}
+
+void StealthUserActionTracker::OnRecorderAgentDisconnected() {
+  recorder_agent_.reset();
+  MaybeBindRecorderAgent();
+}
+
+void StealthUserActionTracker::SendAgentStateSnapshot(
+    blink::Element* target,
+    bool subtree_only,
+    bool mark_hovered) {
+  MaybeBindRecorderAgent();
+  if (!recorder_agent_.is_connected())
+    return;
+  if (!frame_)
+    return;
+  blink::WebLocalFrame* local_frame = frame_->GetWebFrame();
+  if (!local_frame)
+    return;
+  blink::WebDocument doc = local_frame->GetDocument();
+  if (doc.IsNull())
+    return;
+
+  const std::string frame_token = local_frame->GetLocalFrameToken().ToString();
+
+  dashboard::mojom::AgentStateSnapshotPtr snapshot;
+
+  // Prefer the shared AgentStateExtractor (with AX delegate when present) to
+  // keep renderer snapshots consistent with the browser-side PageMap pipeline.
+  {
+    blink::AgentState state;
+    if (target) {
+      state = blink::AgentStateExtractor::ExtractForAction(
+          local_frame, target, subtree_only, mark_hovered);
+    } else {
+      state = blink::AgentStateExtractor::Extract(local_frame);
+    }
+    snapshot = BuildSnapshotFromState(state, doc.Url().GetString().Utf8());
+  }
+
+  // Fallback to legacy DOM walk if extraction failed to produce any elements.
+  if (!snapshot || snapshot->elements.empty()) {
+    auto build_element_info = [](const blink::WebElement& el,
+                                 const std::string& frame_token,
+                                 bool is_target) {
+      auto info = dashboard::mojom::AgentElementInfo::New();
+      info->id = 0;
+      info->frame_token = frame_token;
+      info->tag = el.TagName().Utf8();
+      info->role = std::string();
+      info->accessibility_name = std::string();
+      info->text = base::UTF16ToUTF8(el.TextContent().Utf16());
+      AXSnapshot ax = GetAXSnapshot(el);
+      if (ax.valid && !ax.ignored) {
+        info->role = ax.role;
+        info->accessibility_name = ax.name;
+        if (!info->accessibility_name.empty())
+          info->text = info->accessibility_name;
+        info->disabled = ax.disabled;
+        info->focusable = ax.focusable;
+        info->clickable = ax.clickable;
+      }
+      info->id_attr = base::UTF16ToUTF8(el.GetIdAttribute().Utf16());
+      info->class_attr = base::UTF16ToUTF8(
+          el.GetAttribute(blink::WebString::FromUTF8("class")).Utf16());
+      info->name_attr = base::UTF16ToUTF8(
+          el.GetAttribute(blink::WebString::FromUTF8("name")).Utf16());
+
+      gfx::Rect bounds = el.BoundsInWidget();
+      info->x = bounds.x();
+      info->y = bounds.y();
+      info->width = bounds.width();
+      info->height = bounds.height();
+
+      info->visible = !bounds.IsEmpty();
+      info->editable = el.IsEditable();
+      if (!info->disabled)
+        info->disabled =
+            el.HasAttribute(blink::WebString::FromUTF8("disabled"));
+      if (!info->focusable)
+        info->focusable =
+            el.IsFormControlElement() ||
+            el.HasAttribute(blink::WebString::FromUTF8("tabindex"));
+      if (!info->clickable)
+        info->clickable =
+            info->focusable ||
+            el.HasHTMLTagName(blink::WebString::FromUTF8("a")) ||
+            el.HasHTMLTagName(blink::WebString::FromUTF8("button"));
+
+      info->in_shadow_tree =
+          !el.OwnerShadowHost().IsNull() || el.IsInUserAgentShadowRoot();
+
+      if (!info->id_attr.empty()) {
+        info->css_selector = "#" + info->id_attr;
+        info->xpath = "//*[@id='" + info->id_attr + "']";
+      } else if (!info->class_attr.empty()) {
+        std::string css = ".";
+        for (char c : info->class_attr)
+          css += (c == ' ') ? '.' : c;
+        info->css_selector = css;
+        std::string tag_lower = base::ToLowerASCII(info->tag);
+        info->xpath = "//" + tag_lower;
+      } else {
+        std::string tag_lower = base::ToLowerASCII(info->tag);
+        info->css_selector = tag_lower;
+        info->xpath = "//" + tag_lower;
+      }
+
+      info->is_target = is_target;
+      return info;
+    };
+
+    snapshot = dashboard::mojom::AgentStateSnapshot::New();
+    snapshot->url = doc.Url().GetString().Utf8();
+    snapshot->frame_token = frame_token;
+    snapshot->timestamp_ms =
+        base::Time::Now().InMillisecondsFSinceUnixEpoch();
+
+    blink::WebElementCollection elements = doc.All();
+    int next_id = 1;
+    for (blink::WebElement el = elements.FirstItem();
+         !el.IsNull(); el = elements.NextItem()) {
+      AXSnapshot ax = GetAXSnapshot(el);
+      if (ax.valid && ax.ignored)
+        continue;
+      auto info = build_element_info(el, frame_token, /*is_target=*/false);
+      info->id = next_id++;
+      snapshot->elements.push_back(std::move(info));
+    }
+  }
+
+  recorder_agent_->OnAgentStateSnapshot(std::move(snapshot));
+}
+
+dashboard::mojom::AgentStateSnapshotPtr
+StealthUserActionTracker::BuildSnapshotFromState(
+    const blink::AgentState& state,
+    const std::string& url) {
+  auto out = dashboard::mojom::AgentStateSnapshot::New();
+  out->url = url;
+  if (!state.elements.empty() && !state.elements.front().frame_token.empty())
+    out->frame_token = state.elements.front().frame_token;
+  out->timestamp_ms =
+      base::Time::Now().InMillisecondsFSinceUnixEpoch();
+  out->viewport_width = state.viewport_width;
+  out->viewport_height = state.viewport_height;
+  out->scroll_x = state.scroll_x;
+  out->scroll_y = state.scroll_y;
+
+  for (const auto& e : state.elements) {
+    auto info = dashboard::mojom::AgentElementInfo::New();
+    info->id = e.id;
+    info->frame_token = e.frame_token;
+    info->tag = e.tag;
+    info->role = e.role;
+    info->text = e.text;
+    info->accessibility_name = e.accessibility_name;
+    info->id_attr = e.id_attr;
+    info->class_attr = e.class_attr;
+    info->name_attr = e.name_attr;
+    info->css_selector = e.css_selector;
+    info->xpath = e.xpath;
+    info->shadow_chain_selector = e.shadow_chain_selector;
+    info->resource_path = e.resource_path;
+    info->x = e.x;
+    info->y = e.y;
+    info->width = e.width;
+    info->height = e.height;
+    info->visible = e.visible;
+    info->clickable = e.clickable;
+    info->focusable = e.focusable;
+    info->editable = e.editable;
+    info->disabled = e.disabled;
+    info->in_shadow_tree = e.in_shadow_tree;
+    out->elements.push_back(std::move(info));
+  }
+  return out;
+}
+
+// -----------------------------------------------------------------------------
+// THE CORE RESOLVER: The single source of truth for element identity.
+// -----------------------------------------------------------------------------
+std::vector<dashboard::mojom::LocatorPtr>
+StealthUserActionTracker::BuildLocatorBundleFromElement(
+    const blink::WebElement& element) {
+  std::vector<dashboard::mojom::LocatorPtr> locators;
+  if (element.IsNull()) return locators;
+
+  // Priority 1: ID
+  std::string id = base::UTF16ToUTF8(element.GetIdAttribute().Utf16());
+  if (!id.empty()) locators.push_back(dashboard::mojom::Locator::New("ID", id));
+
+  // Priority 2: name attribute
+  std::string name = base::UTF16ToUTF8(
+      element.GetAttribute(blink::WebString::FromUTF8("name")).Utf16());
+  if (!name.empty()) locators.push_back(dashboard::mojom::Locator::New("ATTR_NAME", name));
+
+  // Priority 3: test id attributes
+  std::string test_id = base::UTF16ToUTF8(
+      element.GetAttribute(blink::WebString::FromUTF8("data-testid")).Utf16());
+  if (test_id.empty()) {
+    test_id = base::UTF16ToUTF8(
+        element.GetAttribute(blink::WebString::FromUTF8("data-cy")).Utf16());
+  }
+  if (!test_id.empty())
+    locators.push_back(dashboard::mojom::Locator::New("ATTR_DATA_TESTID", test_id));
+
+  // Priority 4: ARIA Label
+  std::string aria_label = base::UTF16ToUTF8(
+      element.GetAttribute(blink::WebString::FromUTF8("aria-label")).Utf16());
+  if (!aria_label.empty())
+    locators.push_back(dashboard::mojom::Locator::New("ARIA_LABEL", aria_label));
+
+  // Priority 5: classes and tag
+  std::string classes = base::UTF16ToUTF8(
+      element.GetAttribute(blink::WebString::FromUTF8("class")).Utf16());
+  if (!classes.empty()) {
+    std::string css = ".";
+    for (char c : classes) css += (c==' ')?'.':c;
+    locators.push_back(dashboard::mojom::Locator::New("CSS_SELECTOR", css));
+  }
+  std::string tag = base::UTF16ToUTF8(element.TagName().Utf16());
+  std::transform(tag.begin(), tag.end(), tag.begin(), ::tolower);
+  if (!tag.empty()) locators.push_back(dashboard::mojom::Locator::New("TAG", tag));
+
+  return locators;
+}
+
+// -----------------------------------------------------------------------------
+// HELPER: The inverse of the core resolver.
+// -----------------------------------------------------------------------------
+blink::WebElement StealthUserActionTracker::FindElementByLocator(
+    const std::vector<dashboard::mojom::LocatorPtr>& locators) {
+  if (!frame_ || !frame_->GetWebFrame()) {
+    return blink::WebElement();
+  }
+
+  blink::WebDocument doc = frame_->GetWebFrame()->GetDocument();
+
+  for (const auto& locator : locators) {
+    const std::string& t = locator->type;
+    const std::string& v = locator->value;
+    if (t == "ID") {
+      blink::WebElement el = doc.GetElementById(blink::WebString::FromUTF8(v));
+      if (!el.IsNull()) return el;
+    } else if (t == "CSS_SELECTOR") {
+      blink::WebElement el = doc.QuerySelector(blink::WebString::FromUTF8(v));
+      if (!el.IsNull()) return el;
+    } else if (t == "ATTR_NAME") {
+      std::string css = "[name='" + v + "']";
+      blink::WebElement el = doc.QuerySelector(blink::WebString::FromUTF8(css));
+      if (!el.IsNull()) return el;
+    } else if (t == "ATTR_DATA_TESTID") {
+      std::string css = "[data-testid='" + v + "']";
+      blink::WebElement el = doc.QuerySelector(blink::WebString::FromUTF8(css));
+      if (!el.IsNull()) return el;
+    } else if (t == "ARIA_LABEL") {
+      std::string css = "[aria-label='" + v + "']";
+      blink::WebElement el = doc.QuerySelector(blink::WebString::FromUTF8(css));
+      if (!el.IsNull()) return el;
+    } else if (t == "TAG") {
+      blink::WebElement el = doc.QuerySelector(blink::WebString::FromUTF8(v));
+      if (!el.IsNull()) return el;
+    }
+  }
+  return blink::WebElement(); // Not found
+}
+
+std::string StealthUserActionTracker::GenerateUniqueSelector(const blink::WebElement& element) {
+  // TODO: Implement a proper unique CSS selector generator.
+  if (element.IsNull()) return "";
+  std::string tag = base::UTF16ToUTF8(element.TagName().Utf16());
+  std::transform(tag.begin(), tag.end(), tag.begin(), ::tolower);
+  return tag;
+}
+
+std::string StealthUserActionTracker::GenerateSimpleXPath(const blink::WebElement& element) {
+  if (element.IsNull()) return std::string();
+  std::string id = base::UTF16ToUTF8(element.GetIdAttribute().Utf16());
+  if (!id.empty()) return std::string("//*[@id='") + id + "']";
+  std::string tag = base::UTF16ToUTF8(element.TagName().Utf16());
+  std::transform(tag.begin(), tag.end(), tag.begin(), ::tolower);
+  if (!tag.empty()) return std::string("//") + tag;
+  return std::string();
+}
+
+}  // namespace dashboard_renderer
