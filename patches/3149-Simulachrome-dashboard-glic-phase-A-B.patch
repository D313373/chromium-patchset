+#!/usr/bin/env python3
+"""
+Debug script to analyze Chrome Glic payloads and identify size issues.
+Run this to intercept and inspect payloads before they hit your LLM.
+"""
+
+import json
+import sys
+from collections import defaultdict
+
+
+def analyze_payload(payload_data):
+    """Analyze a JSON payload and report size breakdown."""
+    
+    def get_size_recursive(obj, path="root"):
+        """Recursively calculate sizes of all fields."""
+        sizes = defaultdict(int)
+        
+        if isinstance(obj, dict):
+            for key, value in obj.items():
+                current_path = f"{path}.{key}"
+                value_str = json.dumps(value)
+                sizes[current_path] = len(value_str)
+                
+                # Recurse into nested structures
+                nested_sizes = get_size_recursive(value, current_path)
+                sizes.update(nested_sizes)
+        
+        elif isinstance(obj, list):
+            for i, item in enumerate(obj):
+                current_path = f"{path}[{i}]"
+                item_str = json.dumps(item)
+                sizes[current_path] = len(item_str)
+                
+                nested_sizes = get_size_recursive(item, current_path)
+                sizes.update(nested_sizes)
+        
+        return sizes
+    
+    try:
+        payload = json.loads(payload_data) if isinstance(payload_data, str) else payload_data
+        
+        total_size = len(json.dumps(payload))
+        print(f"\n{'='*80}")
+        print(f"PAYLOAD ANALYSIS")
+        print(f"{'='*80}")
+        print(f"Total Size: {total_size:,} bytes ({total_size/1024:.1f} KB)")
+        
+        # Get all field sizes
+        sizes = get_size_recursive(payload)
+        
+        # Sort by size descending
+        sorted_sizes = sorted(sizes.items(), key=lambda x: x[1], reverse=True)
+        
+        print(f"\nTop 20 Largest Fields:")
+        print(f"{'-'*80}")
+        for path, size in sorted_sizes[:20]:
+            percentage = (size / total_size) * 100
+            print(f"  {size:>10,} bytes ({percentage:>5.1f}%) - {path}")
+        
+        # Identify problematic fields
+        print(f"\n{'='*80}")
+        print(f"PROBLEMATIC FIELDS (>10KB):")
+        print(f"{'='*80}")
+        
+        large_fields = [(path, size) for path, size in sorted_sizes if size > 10240]
+        
+        for path, size in large_fields:
+            print(f"\n  Field: {path}")
+            print(f"  Size: {size:,} bytes ({size/1024:.1f} KB)")
+            
+            # Try to identify the type of data
+            parts = path.split('.')
+            obj = payload
+            for part in parts[1:]:  # Skip 'root'
+                if '[' in part:
+                    key = part.split('[')[0]
+                    idx = int(part.split('[')[1].rstrip(']'))
+                    obj = obj[key][idx]
+                else:
+                    obj = obj.get(part, {})
+            
+            if isinstance(obj, str):
+                preview = obj[:100] + "..." if len(obj) > 100 else obj
+                
+                # Check if it's base64
+                if len(obj) > 1000 and all(c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=' for c in obj[:100]):
+                    print(f"  Type: BASE64 ENCODED DATA (likely screenshot)")
+                    print(f"  ⚠️  CRITICAL: This will cause timeout with text-only LLMs!")
+                
+                # Check if it's HTML
+                elif '<' in preview and '>' in preview:
+                    print(f"  Type: HTML/XML content")
+                    print(f"  Preview: {preview}")
+                    print(f"  ⚠️  Should be stripped to plain text")
+                
+                else:
+                    print(f"  Type: String")
+                    print(f"  Preview: {preview}")
+        
+        # Estimate token count (rough approximation: 1 token ≈ 4 chars)
+        estimated_tokens = total_size // 4
+        print(f"\n{'='*80}")
+        print(f"Estimated Token Count: ~{estimated_tokens:,} tokens")
+        
+        if estimated_tokens > 8000:
+            print(f"⚠️  WARNING: Exceeds typical 8K context window!")
+        if estimated_tokens > 32000:
+            print(f"🚨 CRITICAL: Exceeds even extended 32K context windows!")
+        
+        print(f"{'='*80}\n")
+        
+    except Exception as e:
+        print(f"Error analyzing payload: {e}")
+        import traceback
+        traceback.print_exc()
+
+
+if __name__ == '__main__':
+    if len(sys.argv) > 1:
+        # Read from file
+        with open(sys.argv[1], 'r') as f:
+            payload_data = f.read()
+    else:
+        # Read from stdin
+        print("Reading payload from stdin (paste JSON and press Ctrl+D)...")
+        payload_data = sys.stdin.read()
+    
+    analyze_payload(payload_data)
+
