+}
+
+#automationToolsPopover .popover-body {
+  display: block;
+}
+
+#automationToolsPopover .row:last-child {
+  border-bottom: none;
+}
+
+#automationToolsPopover .row .label {
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+#automationToolsPopover .savebar {
