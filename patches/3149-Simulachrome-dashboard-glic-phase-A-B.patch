+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/agent/blink_agent_loop.h"
+
+#include "base/logging.h"
+#include "base/files/file_path.h"
+#include "base/logging.h"
+#include <vector>
+#include "third_party/blink/renderer/core/agent/agent_action_dispatcher.h"
+#include "third_party/blink/renderer/core/agent/agent_decoder.h"
+#include "third_party/blink/renderer/core/agent/agent_state_extractor.h"
+#include "third_party/blink/renderer/core/agent/agent_vectorizer.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "ui/base/resource/resource_bundle.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+namespace blink {
+
+BlinkAgentLoop::BlinkAgentLoop(LocalFrame* frame) : frame_(frame) {}
+
+void BlinkAgentLoop::Trace(Visitor* visitor) const {
+  visitor->Trace(frame_);
+}
+void BlinkAgentLoop::Start() {
+  if (running_)
+    return;
+
+  if (!LoadModelIfNeeded())
+    return;
+
+  const int sz = troll_.input_size();
+  if (!sz) {
+    LOG(ERROR) << "[BlinkAgentLoop] Test inference failed: input_size unset";
+    return;
+  }
+
+  std::vector<float> in(sz, 0.0f);
+  std::vector<float> out;
+  if (troll_.RunInference(in, out) && out.size() >= 4) {
+    LOG(INFO) << "[BlinkAgentLoop] Test inference ok: out[0..3]="
+              << out[0] << "," << out[1] << "," << out[2] << "," << out[3];
+  } else {
+    LOG(ERROR) << "[BlinkAgentLoop] Test inference failed";
+  }
+
+  running_ = true;
+  status_text_ = "running";
+  LOG(INFO) << "[BlinkAgentLoop] Start goal=" << current_goal_.Utf8();
+}
+
+void BlinkAgentLoop::Stop() {
+  if (!running_)
+    return;
+  running_ = false;
+  status_text_ = "stopped";
+  LOG(INFO) << "[BlinkAgentLoop] Stop";
+}
+
+void BlinkAgentLoop::TickOnce() {
+  Tick();
+}
+
+void BlinkAgentLoop::SetGoal(const String& goal) {
+  current_goal_ = goal;
+  status_text_ = "goal set";
+  LOG(INFO) << "[BlinkAgentLoop] New goal: " << goal.Utf8();
+}
+
+void BlinkAgentLoop::SetModelResource(int resource_id) {
+  model_resource_id_ = resource_id;
+  // Model resource is optional for our current workflows; suppress noisy logs.
+}
+
+bool BlinkAgentLoop::LoadModelIfNeeded() {
+  if (model_loaded_)
+    return true;
+
+  if (model_resource_id_ < 0) {
+    return false;
+  }
+
+  if (!troll_.LoadEmbeddedModel(model_resource_id_)) {
+    status_text_ = "model_load_failed";
+    return false;
+  }
+
+  model_loaded_ = true;
+  status_text_ = "model_loaded";
+  return true;
+}
+
+void BlinkAgentLoop::Tick() {
+  if (!running_ || !frame_)
+    return;
+
+  AgentState state = AgentStateExtractor::Extract(frame_);
+  if (state.elements.empty()) {
+    context_.AddHistory(state, AgentAction{}, false);
+    status_text_ = "no_elements";
+    return;
+  }
+
+  // Vectorize.
+  Vector<float> input = AgentVectorizer::Vectorize(state);
+  if (troll_.input_size() &&
+      static_cast<int>(input.size()) != troll_.input_size()) {
+    LOG(ERROR) << "[BlinkAgentLoop] Input size mismatch: have "
+               << input.size() << " expected " << troll_.input_size();
+    status_text_ = "input_mismatch";
+    context_.AddHistory(state, AgentAction{}, false);
+    return;
+  }
+
+  // Inference.
+  std::vector<float> input_std(input.begin(), input.end());
+  std::vector<float> output_std;
+  if (!troll_.RunInference(input_std, output_std)) {
+    status_text_ = "inference_failed";
+    context_.AddHistory(state, AgentAction{}, false);
+    return;
+  }
+  Vector<float> output;
+  output.ReserveInitialCapacity(output_std.size());
+  for (float v : output_std)
+    output.push_back(v);
+
+  // Decode and dispatch.
+  AgentAction action = AgentDecoder::Decode(output, state);
+  if (!action.IsValid()) {
+    status_text_ = "no_action";
+    context_.AddHistory(state, action, false);
+    return;
+  }
+
+  AgentActionDispatcher::Dispatch(action, frame_);
+  status_text_ = "action_dispatched";
+  context_.AddHistory(state, action, true);
+}
+
+}  // namespace blink
