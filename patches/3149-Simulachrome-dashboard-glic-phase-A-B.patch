diff --git a/third_party/blink/renderer/core/agent/agent_decoder.cc b/third_party/blink/renderer/core/agent/agent_decoder.cc
new file mode 100644
index 0000000000000000000000000000000000000000..cc74d5cdc4763c557642f56f3e29d5035fd67c06
--- /dev/null
+++ b/third_party/blink/renderer/core/agent/agent_decoder.cc
@@ -0,0 +1,77 @@
+#include "third_party/blink/renderer/core/agent/agent_decoder.h"
+#include <algorithm>
+
+namespace blink {
+
+int AgentDecoder::ArgMax(const Vector<float>& v,
+                         int start, int end) {
+  int best = start;
+  float maxv = v[start];
+  for (int i = start + 1; i < end; i++) {
+    if (v[i] > maxv) {
+      maxv = v[i];
+      best = i;
+    }
+  }
+  return best;
+}
+
+float AgentDecoder::Clamp(float v, float lo, float hi) {
+  return std::max(lo, std::min(v, hi));
+}
+
+AgentAction AgentDecoder::Decode(const Vector<float>& logits,
+                                 const AgentState& state) {
+  AgentAction action;
+
+  if (logits.empty() || state.elements.empty())
+    return action;
+
+  constexpr int kActionCount = 6;
+
+  int action_type_idx = ArgMax(logits, 0, kActionCount);
+
+  switch (action_type_idx) {
+    case 0: action.type = AgentActionType::kClickElement; break;
+    case 1: action.type = AgentActionType::kFocusElement; break;
+    case 2: action.type = AgentActionType::kTypeText; break;
+    case 3: action.type = AgentActionType::kScrollBy; break;
+    case 4: action.type = AgentActionType::kNavigate; break;
+    default: return action;
+  }
+
+  if (action.type == AgentActionType::kClickElement ||
+      action.type == AgentActionType::kFocusElement ||
+      action.type == AgentActionType::kTypeText) {
+
+    constexpr int kElemOff = kActionCount;
+    constexpr int kMaxElem = 256;
+
+    int pick = ArgMax(logits, kElemOff, kElemOff + kMaxElem);
+    int idx = pick - kElemOff;
+
+    if (idx >= 0 && idx < (int)state.elements.size())
+      action.element_id = state.elements[idx].id;
+    else
+      return AgentAction{};
+  }
+
+  if (action.type == AgentActionType::kScrollBy) {
+    int sx = 6 + 256;
+    int sy = sx + 1;
+    action.scroll_dx = Clamp(logits[sx] * 500.f, -500.f, 500.f);
+    action.scroll_dy = Clamp(logits[sy] * 500.f, -500.f, 500.f);
+  }
+
+  if (action.type == AgentActionType::kTypeText) {
+    action.text = "hello";  // placeholder
+  }
+
+  if (action.type == AgentActionType::kNavigate) {
+    action.url = "https://example.com";
+  }
+
+  return action;
+}
+
+}  // namespace blink
