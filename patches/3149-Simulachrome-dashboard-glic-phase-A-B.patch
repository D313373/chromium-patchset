+    return false;
+  if (!base::EndsWith(s, ".png", base::CompareCase::SENSITIVE))
+    return false;
+  const std::string middle = s.substr(sizeof("frame_") - 1,
+                                      s.size() - (sizeof("frame_") - 1) - 4);
+  if (middle.empty() || middle.size() > 8)
+    return false;
+  for (char c : middle) {
+    if (!base::IsAsciiDigit(c))
+      return false;
+  }
+  return true;
+}
