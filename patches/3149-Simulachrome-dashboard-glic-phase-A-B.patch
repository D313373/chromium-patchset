+
+std::string TrimForLocatorValue(std::string in, size_t max_len) {
+  if (in.size() <= max_len)
+    return in;
+  in.resize(max_len);
+  in.append("…");
+  return in;
+}
+
+void AppendUniqueLocator(base::Value::List& locators,
+                         std::set<std::pair<std::string, std::string>>& seen,
+                         const char* type,
+                         std::string value) {
+  const std::string type_str = type ? std::string(type) : std::string();
+  if (type_str.empty() || value.empty()) {
+    return;
+  }
+  std::pair<std::string, std::string> key{type_str, std::move(value)};
+  if (!seen.insert(key).second) {
+    return;
+  }
+  base::Value::Dict d;
+  d.Set("type", key.first);
+  d.Set("value", key.second);
+  locators.Append(std::move(d));
+}
+
+base::Value::List BuildLocatorBundleFromClickDict(const base::Value::Dict& click) {
+  if (const base::Value::List* locs = click.FindList("locators")) {
+    return locs->Clone();
+  }
+
+  base::Value::List out;
+  if (auto xi = click.FindInt("x")) {
+    if (auto yi = click.FindInt("y")) {
+      base::Value::Dict l;
+      l.Set("type", "VISUAL_COORDS");
+      l.Set("value", base::StringPrintf("%d,%d", *xi, *yi));
+      out.Append(std::move(l));
+    }
+  }
+  if (const std::string* css = click.FindString("css")) {
+    base::Value::Dict l;
+    l.Set("type", "CSS_SELECTOR");
+    l.Set("value", *css);
+    out.Append(std::move(l));
+  }
+  if (const std::string* xp = click.FindString("xpath")) {
+    base::Value::Dict l;
+    l.Set("type", "XPATH");
+    l.Set("value", *xp);
+    out.Append(std::move(l));
+  }
+  if (const std::string* text = click.FindString("text")) {
+    std::string value = TrimForLocatorValue(*text, 120u);
+    if (!value.empty()) {
+      base::Value::Dict l;
+      l.Set("type", "TEXT_CONTENT");
+      l.Set("value", value);
+      out.Append(std::move(l));
+    }
+  }
+  return out;
+}
+
+const dashboard::mojom::AgentElementInfo* FindSnapshotTargetElement(
+    const dashboard::mojom::AgentStateSnapshot* snapshot) {
+  if (!snapshot) {
+    return nullptr;
+  }
+  const dashboard::mojom::AgentElementInfo* fallback = nullptr;
+  for (const auto& el_ptr : snapshot->elements) {
+    if (!el_ptr) {
+      continue;
+    }
+    const auto& el = *el_ptr;
+    if (el.is_target) {
+      return &el;
+    }
+    if (!fallback && (el.clickable || el.focusable || el.editable)) {
+      fallback = &el;
+    }
+  }
+  return fallback;
+}
+
+std::string BuildHoverTransitionSignature(
+    const dashboard::mojom::AgentStateSnapshot* snapshot) {
+  if (!snapshot) {
+    return std::string();
+  }
+  std::string signature = snapshot->url;
+  signature.append("|n=");
+  signature.append(base::NumberToString(snapshot->elements.size()));
+  int visible_count = 0;
+  int clickable_count = 0;
+  int focusable_count = 0;
+  int editable_count = 0;
+  uint64_t digest_xor = 0;
+  uint64_t digest_sum = 0;
+  for (const auto& el_ptr : snapshot->elements) {
+    if (!el_ptr) {
+      continue;
+    }
+    const auto& el = *el_ptr;
+    const uint64_t flags =
+        (el.visible ? 1ull : 0ull) | (el.clickable ? 2ull : 0ull) |
+        (el.focusable ? 4ull : 0ull) | (el.editable ? 8ull : 0ull) |
+        (el.disabled ? 16ull : 0ull);
+    const uint64_t token =
+        static_cast<uint64_t>(static_cast<uint32_t>(el.id)) * 1315423911ull +
+        flags * 2654435761ull;
+    digest_xor ^= token;
+    digest_sum += token;
+    visible_count += el.visible ? 1 : 0;
+    clickable_count += el.clickable ? 1 : 0;
+    focusable_count += el.focusable ? 1 : 0;
+    editable_count += el.editable ? 1 : 0;
+  }
+  signature.append("|visible=");
+  signature.append(base::NumberToString(visible_count));
+  signature.append("|clickable=");
+  signature.append(base::NumberToString(clickable_count));
+  signature.append("|focusable=");
+  signature.append(base::NumberToString(focusable_count));
+  signature.append("|editable=");
+  signature.append(base::NumberToString(editable_count));
+  signature.append("|xor=");
+  signature.append(base::NumberToString(digest_xor));
+  signature.append("|sum=");
+  signature.append(base::NumberToString(digest_sum));
+  return signature;
+}
