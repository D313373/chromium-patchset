+#!/usr/bin/env python3
+"""Simulachrome headless listener host.
+
+Supports two entry modes:
+1) CLI command mode used by browser C++ glue:
+   --command <start_headless_listener|stop_headless_listener|sync_session|list_active|poll_events|capture_screenshot>
+2) Native messaging host mode (default, stdin/stdout framed JSON).
+
+This host manages a singleton headless browser process on port 9222 and
+per-listener worker processes that run refresh/diff loops against individual
+CDP targets.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import os
+import random
+import re
+import shutil
+import signal
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+# Script ids in Simulachrome are often UUID-like ("a-b-c"), so allow hyphen.
+# Keep a strict whitelist to prevent traversal/injection-style payloads.
+SCRIPT_ID_RE = re.compile(r"^[a-zA-Z0-9_-]{1,128}$")
+CDP_BASE = "http://127.0.0.1:9222"
+STATE_PATH = Path.home() / ".simulachrome" / "headless_listener_state.json"
+EVENTS_PATH = Path.home() / ".simulachrome" / "headless_listener_events.jsonl"
+LAUNCH_LOG_PATH = Path.home() / ".simulachrome" / "headless_listener_launch.log"
+SCREENSHOTS_DIR = Path.home() / ".simulachrome" / "headless_listener_screenshots"
+DEFAULT_PROFILE = Path.home() / ".simulachrome" / "profile"
+SHARED_PROFILE = Path.home() / ".simulachrome" / "headless_shared"
+DEFAULT_SCRIPTS_DIR = Path.home() / ".simulachrome" / "scripts"
+HEADLESS_STARTUP_TIMEOUT_SEC = float(
+    os.environ.get("SIMULACHROME_HEADLESS_STARTUP_TIMEOUT_SEC", "75"))
+HEADLESS_STARTUP_RETRIES = int(
+    os.environ.get("SIMULACHROME_HEADLESS_STARTUP_RETRIES", "2"))
+HEADLESS_TARGET_CREATE_TIMEOUT_SEC = float(
+    os.environ.get("SIMULACHROME_HEADLESS_TARGET_CREATE_TIMEOUT_SEC", "25"))
+HEADLESS_WORKER_ATTACH_GRACE_SEC = float(
+    os.environ.get("SIMULACHROME_HEADLESS_WORKER_ATTACH_GRACE_SEC", "5"))
+HEADLESS_STARTING_ENTRY_GRACE_SEC = float(
+    os.environ.get("SIMULACHROME_HEADLESS_STARTING_ENTRY_GRACE_SEC", "45"))
+RECENT_MATCH_SIGNATURES_KEY = "listenerRecentMatchSignatures"
+MAX_RECENT_MATCH_SIGNATURES = 3
+ENABLE_CROSS_RUN_MATCH_DEDUPE = False
+
+
+@dataclass
+class ListenerConfig:
+  script_id: str
+  start_url: str
+  refresh_seconds: int
+  auto_refresh: bool
+  refresh_jitter: bool
+  extreme_evasion: bool
+  locators: List[Dict[str, Any]]
+  condition: str
+  needle: str
+  attribute: str
+  on_match_script_id: str
+  recent_match_signatures: List[str]
+  owner_pid: int
+
+
+class WebSocketCDP:
+  def __init__(self, ws_url: str, timeout: float = 20.0):
+    self._sock: Optional[socket.socket] = None
+    self._timeout = timeout
+    self._next_id = 1
+    self._connect(ws_url)
+
+  def _connect(self, ws_url: str) -> None:
+    parts = urllib.parse.urlparse(ws_url)
+    if parts.scheme != "ws":
+      raise RuntimeError(f"Unsupported websocket scheme: {parts.scheme}")
+    host = parts.hostname or "127.0.0.1"
+    port = parts.port or 80
+    path = parts.path or "/"
+    if parts.query:
+      path += "?" + parts.query
+
+    sock = socket.create_connection((host, port), timeout=self._timeout)
+    key = base64.b64encode(os.urandom(16)).decode("ascii")
+    req = (
+        f"GET {path} HTTP/1.1\r\n"
+        f"Host: {host}:{port}\r\n"
+        "Origin: http://127.0.0.1\r\n"
+        "Upgrade: websocket\r\n"
+        "Connection: Upgrade\r\n"
+        f"Sec-WebSocket-Key: {key}\r\n"
+        "Sec-WebSocket-Version: 13\r\n"
+        "\r\n"
+    ).encode("utf-8")
+    sock.sendall(req)
+    resp = self._recv_http_headers(sock)
+    lines = resp.splitlines()
+    if not lines:
+      raise RuntimeError("WebSocket handshake failed: empty HTTP response")
+    if b" 101 " not in lines[0]:
+      raise RuntimeError(f"WebSocket handshake failed: {resp[:200]!r}")
+    self._sock = sock
+
+  def _recv_http_headers(self, sock: socket.socket) -> bytes:
+    data = bytearray()
+    while b"\r\n\r\n" not in data:
+      chunk = sock.recv(4096)
+      if not chunk:
+        break
+      data.extend(chunk)
+    return bytes(data)
+
+  def close(self) -> None:
+    if self._sock is not None:
+      try:
+        self._sock.close()
+      except OSError:
+        pass
+      self._sock = None
+
+  def _send_text(self, text: str) -> None:
+    if self._sock is None:
+      raise RuntimeError("socket is closed")
+    payload = text.encode("utf-8")
+    fin_opcode = 0x81
+    mask_bit = 0x80
+    length = len(payload)
+    header = bytearray([fin_opcode])
+    if length < 126:
+      header.append(mask_bit | length)
+    elif length <= 0xFFFF:
+      header.append(mask_bit | 126)
+      header.extend(struct.pack("!H", length))
+    else:
+      header.append(mask_bit | 127)
+      header.extend(struct.pack("!Q", length))
+    mask = os.urandom(4)
+    header.extend(mask)
+    masked = bytearray(payload)
+    for i in range(length):
+      masked[i] ^= mask[i % 4]
+    self._sock.sendall(bytes(header) + bytes(masked))
+
+  def _recv_frame(self) -> bytes:
+    if self._sock is None:
+      raise RuntimeError("socket is closed")
+    b1_b2 = self._read_exact(2)
+    b1, b2 = b1_b2[0], b1_b2[1]
+    opcode = b1 & 0x0F
+    masked = (b2 & 0x80) != 0
+    length = b2 & 0x7F
+    if length == 126:
+      length = struct.unpack("!H", self._read_exact(2))[0]
+    elif length == 127:
+      length = struct.unpack("!Q", self._read_exact(8))[0]
+    mask = self._read_exact(4) if masked else b""
+    payload = bytearray(self._read_exact(length))
+    if masked:
+      for i in range(length):
+        payload[i] ^= mask[i % 4]
+    if opcode == 0x8:
+      raise RuntimeError("websocket closed")
+    if opcode == 0x9:
+      # Ping -> Pong
+      self._send_control(0xA, bytes(payload))
+      return self._recv_frame()
+    if opcode != 0x1:
+      return self._recv_frame()
+    return bytes(payload)
+
+  def _send_control(self, opcode: int, payload: bytes) -> None:
+    if self._sock is None:
+      raise RuntimeError("socket is closed")
+    frame = bytearray([0x80 | (opcode & 0x0F)])
+    frame.append(0x80 | len(payload))
+    mask = os.urandom(4)
+    frame.extend(mask)
+    masked = bytearray(payload)
+    for i in range(len(masked)):
+      masked[i] ^= mask[i % 4]
+    frame.extend(masked)
+    self._sock.sendall(bytes(frame))
+
+  def _read_exact(self, n: int) -> bytes:
+    if self._sock is None:
+      raise RuntimeError("socket is closed")
+    data = bytearray()
+    while len(data) < n:
+      chunk = self._sock.recv(n - len(data))
+      if not chunk:
+        raise RuntimeError("socket closed during read")
+      data.extend(chunk)
+    return bytes(data)
+
+  def call(self, method: str, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
+    req_id = self._next_id
+    self._next_id += 1
+    msg = {"id": req_id, "method": method, "params": params or {}}
+    self._send_text(json.dumps(msg))
+    while True:
+      payload = self._recv_frame()
+      obj = json.loads(payload.decode("utf-8", errors="replace"))
+      if obj.get("id") != req_id:
+        continue
+      if "error" in obj:
+        raise RuntimeError(f"CDP {method} failed: {obj['error']}")
+      return obj.get("result", {})
+
+
+def _ensure_parent(path: Path) -> None:
+  path.parent.mkdir(parents=True, exist_ok=True)
+
+
+def _read_json(path: Path, default: Any) -> Any:
+  try:
+    if not path.exists():
+      return default
+    return json.loads(path.read_text(encoding="utf-8"))
+  except Exception:
+    return default
+
+
+def _write_json(path: Path, obj: Any) -> None:
+  _ensure_parent(path)
+  tmp = path.with_suffix(path.suffix + ".tmp")
+  tmp.write_text(json.dumps(obj, ensure_ascii=True), encoding="utf-8")
+  tmp.replace(path)
+
+
+def _append_event(event: Dict[str, Any]) -> None:
+  _ensure_parent(EVENTS_PATH)
+  with EVENTS_PATH.open("a", encoding="utf-8") as f:
+    f.write(json.dumps(event, ensure_ascii=True) + "\n")
+
+
+def _append_launch_log(message: str) -> None:
+  try:
+    _ensure_parent(LAUNCH_LOG_PATH)
+    ts = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())
+    with LAUNCH_LOG_PATH.open("a", encoding="utf-8") as f:
+      f.write(f"[{ts}] {message}\n")
+  except Exception:
+    # Never fail listener startup due to diagnostics logging.
+    pass
+
+
+def _pid_is_alive(pid: int) -> bool:
+  if pid <= 1:
+    return False
+  try:
+    os.kill(pid, 0)
+    return True
+  except OSError:
+    return False
+
+
+def _now_ms() -> int:
+  return int(time.time() * 1000)
+
+
+def _http_json(path: str, method: str = "GET") -> Any:
+  req = urllib.request.Request(CDP_BASE + path, method=method)
+  with urllib.request.urlopen(req, timeout=8) as r:
+    data = r.read()
+  return json.loads(data.decode("utf-8", errors="replace"))
+
+
+def _debug_port_live() -> bool:
+  try:
+    _http_json("/json/version")
+    return True
+  except Exception:
+    return False
+
+
+def _resolve_profile_paths(profile_dir: Path) -> tuple[Path, Path]:
+  profile_dir = profile_dir.expanduser()
+  # Accept either a user-data-dir root (contains "Default") or a profile dir.
+  if (profile_dir / "Default").exists():
+    return profile_dir, profile_dir / "Default"
+  if (profile_dir / "Preferences").exists() or profile_dir.name == "Default":
+    return profile_dir.parent, profile_dir
+  if profile_dir.name.startswith("Profile "):
+    return profile_dir.parent, profile_dir
+  return profile_dir, profile_dir / "Default"
+
+
+def _dedupe_paths(paths: List[Path]) -> List[Path]:
+  out: List[Path] = []
+  seen: set[str] = set()
+  for p in paths:
+    key = str(p)
+    if key in seen:
+      continue
+    seen.add(key)
+    out.append(p)
+  return out
+
+
+def _resolve_browser_binary(browser_bin: str) -> str:
+  raw = (browser_bin or os.environ.get("SIMULACHROME_BIN") or "Chromium").strip()
+  if not raw:
+    raw = "Chromium"
+  path = Path(raw).expanduser()
+
+  candidates: List[Path] = []
+  if raw:
+    candidates.append(path)
+
+  # If caller passed an .app bundle, use its executable.
+  if path.suffix == ".app":
+    candidates.append(path / "Contents" / "MacOS" / path.stem)
+
+  # If caller passed a naked binary name/path on macOS, try sibling .app bundle.
+  if path.name and path.suffix != ".app":
+    candidates.append(path.parent / f"{path.name}.app" / "Contents" / "MacOS" /
+                      path.name)
+
+  # Common macOS install/build locations.
+  common = [
+      Path("/Applications/Chromium.app/Contents/MacOS/Chromium"),
+      Path("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"),
+      Path("/Applications/Simulachrome.app/Contents/MacOS/Simulachrome"),
+      Path.cwd() / "out" / "Default" / "Chromium.app" / "Contents" / "MacOS" /
+      "Chromium",
+  ]
+  candidates.extend(common)
+  candidates = _dedupe_paths(candidates)
+
+  for c in candidates:
+    try:
+      if c.exists() and c.is_file():
+        return str(c)
+    except Exception:
+      continue
+
+  # Fall back to raw value for PATH lookup.
+  return raw
+
+
+def _warm_sync(src_profile: Path, dst_profile: Path) -> None:
+  dst_profile.mkdir(parents=True, exist_ok=True)
+  def _copy_file_with_sidecars(src_file: Path, dst_file: Path) -> None:
+    dst_file.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(src_file, dst_file)
+    # SQLite sidecars are optional but help keep a coherent snapshot.
+    for suffix in ("-wal", "-shm", "-journal"):
+      side_src = Path(str(src_file) + suffix)
+      side_dst = Path(str(dst_file) + suffix)
+      if side_src.exists():
+        shutil.copy2(side_src, side_dst)
+
+  copy_paths = [
+      # Legacy cookie DB location.
+      (src_profile / "Cookies", dst_profile / "Default" / "Cookies"),
+      # Modern Chromium cookie DB location.
+      (src_profile / "Network" / "Cookies",
+       dst_profile / "Default" / "Network" / "Cookies"),
+      (src_profile / "Local Storage", dst_profile / "Default" / "Local Storage"),
+      (src_profile / "Network Action Predictor",
+       dst_profile / "Default" / "Network Action Predictor"),
+  ]
+  for src, dst in copy_paths:
+    try:
+      if not src.exists():
+        continue
+      dst.parent.mkdir(parents=True, exist_ok=True)
+      if src.is_dir():
+        if dst.exists():
+          shutil.rmtree(dst)
+        shutil.copytree(src, dst)
+      else:
+        _copy_file_with_sidecars(src, dst)
+    except Exception:
+      # best effort warm sync
+      pass
+
+
+def _launch_headless(shared_profile: Path, browser_bin: str) -> int:
+  browser = _resolve_browser_binary(browser_bin)
+  base_args = [
+      "--remote-debugging-port=9222",
+      "--remote-debugging-address=127.0.0.1",
+      "--remote-allow-origins=*",
+      "--no-first-run",
+      "--no-startup-window",
+      "--disable-gpu",
+      "--disable-gpu-vsync",
+      "--disable-service-worker",
+      f"--user-data-dir={shared_profile}",
+  ]
+  last_error = ""
+  _ensure_parent(LAUNCH_LOG_PATH)
+  log_file = None
+  try:
+    log_file = LAUNCH_LOG_PATH.open("ab")
+  except Exception:
+    log_file = None
+  with (log_file if log_file is not None else open(os.devnull, "wb")) as launch_log_file:
+    for headless_flag in ("--headless=new", "--headless"):
+      cmd = [browser, headless_flag, *base_args]
+      # Ensure at least one page target exists even when /json/new is blocked.
+      cmd.append("about:blank")
+      _append_launch_log("Launching headless: " + " ".join(cmd))
+      try:
+        proc = subprocess.Popen(
+            cmd,
+            stdout=launch_log_file,
+            stderr=launch_log_file,
+            start_new_session=True,
+        )
+      except Exception as e:
+        last_error = str(e)
+        _append_launch_log(f"Launch failed immediately for {headless_flag}: {e}")
+        continue
+
+      # If it exits immediately, try the next mode.
+      time.sleep(0.35)
+      rc = proc.poll()
+      if rc is None:
+        return proc.pid
+      last_error = f"process exited quickly rc={rc} flag={headless_flag}"
+      _append_launch_log(f"Headless process exited quickly: {last_error}")
+
+  raise RuntimeError(
+      "Unable to launch headless browser process. Last error: " + last_error)
+
+
+def _ensure_headless_instance(profile_dir: Path, browser_bin: str = "") -> int:
+  state = _read_json(STATE_PATH, {})
+  existing_pid = int(state.get("browser_pid", 0) or 0)
+  if _debug_port_live():
+    # Another process may already own the CDP endpoint (or prior state may
+    # have been cleared). Preserve liveness to avoid immediately pruning
+    # listeners as "browser missing".
+    if existing_pid <= 1 or not _pid_is_alive(existing_pid):
+      state["browser_pid"] = -1
+      state.setdefault("listeners", {})
+      _write_json(STATE_PATH, state)
+      return -1
+    return existing_pid
+
+  _, source_profile = _resolve_profile_paths(profile_dir)
+  attempts: List[str] = []
+
+  retries = max(1, HEADLESS_STARTUP_RETRIES)
+  timeout_sec = max(10.0, HEADLESS_STARTUP_TIMEOUT_SEC)
+
+  for attempt in range(retries):
+    if attempt >= 1:
+      # Retry with a clean shared profile if initial startup failed.
+      _append_launch_log("Headless startup retry: rebuilding shared profile")
+      try:
+        if SHARED_PROFILE.exists():
+          shutil.rmtree(SHARED_PROFILE)
+      except Exception:
+        pass
+    _warm_sync(source_profile, SHARED_PROFILE)
+
+    pid = _launch_headless(SHARED_PROFILE, browser_bin)
+    deadline = time.time() + timeout_sec
+    while time.time() < deadline:
+      if _debug_port_live():
+        state["browser_pid"] = pid
+        state.setdefault("listeners", {})
+        _write_json(STATE_PATH, state)
+        return pid
+      time.sleep(0.25)
+
+    attempts.append(f"attempt={attempt + 1}: CDP port 9222 did not open")
+    _append_launch_log("Headless startup attempt failed: " + attempts[-1])
+    _stop_pid(pid)
+
+  extra = ""
+  if LAUNCH_LOG_PATH.exists():
+    extra = f" See launch log: {LAUNCH_LOG_PATH}"
+  raise RuntimeError(
+      "Headless browser did not open remote debugging port 9222 after retry."
+      + extra)
+
+
+def _cdp_create_target(url: str) -> Dict[str, Any]:
+  raw_url = url or "about:blank"
+  safe_url = urllib.parse.quote(raw_url, safe="")
+  last_error: Optional[Exception] = None
+  json_new_candidates = [
+      f"/json/new?{safe_url}",
+      f"/json/new?url={safe_url}",
+      "/json/new",
+      "/json/new/",
+  ]
+  methods = ("PUT", "POST", "GET")
+  for path in json_new_candidates:
+    for method in methods:
+      try:
+        return _http_json(path, method=method)
+      except Exception as exc:
+        last_error = exc
+  try:
+    # Some variants may only allow opening a blank page.
+    for method in methods:
+      try:
+        return _http_json("/json/new", method=method)
+      except Exception as exc:
+        last_error = exc
+  except Exception:
+    pass
+
+  # Some builds reject /json/new (405). Fall back to browser-level CDP.
+  cdp_error: Optional[Exception] = None
+  try:
+    version = _http_json("/json/version", method="GET")
+    ws_url = str(version.get("webSocketDebuggerUrl") or "")
+    if not ws_url:
+      raise RuntimeError("missing webSocketDebuggerUrl from /json/version")
+    cdp = WebSocketCDP(ws_url, timeout=10.0)
+    try:
+      result = cdp.call("Target.createTarget", {"url": url or "about:blank"})
+    finally:
+      cdp.close()
+    target_id = str(result.get("targetId") or "")
+    if not target_id:
+      raise RuntimeError("Target.createTarget returned empty targetId")
+    return {"id": target_id}
+  except Exception as exc:
+    cdp_error = exc
+
+  # Last fallback: reuse an existing page target.
+  try:
+    targets = _list_targets()
+    for t in targets:
+      if str(t.get("type") or "") != "page":
+        continue
+      tid = str(t.get("id") or "")
+      if tid:
+        return {"id": tid}
+  except Exception:
+    pass
+
+  if last_error is not None:
+    raise RuntimeError(
+        f"Failed to create target via /json/new ({last_error}) and "
+        f"Target.createTarget ({cdp_error})") from cdp_error
+  if cdp_error is not None:
+    raise cdp_error
+  raise RuntimeError("Failed to create CDP target")
+
+
+def _cdp_close_target(target_id: str) -> None:
+  try:
+    _http_json(f"/json/close/{urllib.parse.quote(target_id, safe='')}", method="GET")
+    return
+  except Exception:
+    pass
+  try:
+    version = _http_json("/json/version", method="GET")
+    ws_url = str(version.get("webSocketDebuggerUrl") or "")
+    if not ws_url:
+      return
+    cdp = WebSocketCDP(ws_url, timeout=10.0)
+    try:
+      cdp.call("Target.closeTarget", {"targetId": target_id})
+    finally:
+      cdp.close()
+  except Exception:
+    pass
+
+
+def _cdp_close_browser() -> bool:
+  try:
+    version = _http_json("/json/version", method="GET")
+    ws_url = str(version.get("webSocketDebuggerUrl") or "")
+    if not ws_url:
+      return False
+    cdp = WebSocketCDP(ws_url, timeout=10.0)
+    try:
+      cdp.call("Browser.close", {})
+    finally:
+      cdp.close()
+    return True
+  except Exception:
+    return False
+
+
+def _list_targets() -> List[Dict[str, Any]]:
+  try:
+    return _http_json("/json/list", method="GET")
+  except Exception:
+    return []
+
+
+def _target_ws_url(target_id: str) -> str:
+  for t in _list_targets():
+    if t.get("id") == target_id and t.get("webSocketDebuggerUrl"):
+      return str(t["webSocketDebuggerUrl"])
+  raise RuntimeError(f"Target not found: {target_id}")
+
+
+def _target_ws_url_with_retry(target_id: str, timeout_sec: float = 3.0) -> str:
+  deadline = time.time() + max(0.5, timeout_sec)
+  last_error: Optional[Exception] = None
+  while time.time() < deadline:
+    try:
+      return _target_ws_url(target_id)
+    except Exception as exc:
+      last_error = exc
+      time.sleep(0.1)
+  if last_error is not None:
+    raise RuntimeError(f"Target not found: {target_id}") from last_error
+  raise RuntimeError(f"Target not found: {target_id}")
+
+
+def _load_script(script_id: str, script_path: Optional[Path]) -> Dict[str, Any]:
+  if script_path and script_path.exists():
+    return _read_json(script_path, {})
+  return _read_json(DEFAULT_SCRIPTS_DIR / f"{script_id}.json", {})
+
+
+def _top_level_actions(script: Dict[str, Any]) -> List[Dict[str, Any]]:
+  out: List[Dict[str, Any]] = []
+  actions = script.get("actions")
+  if isinstance(actions, list):
+    for action in actions:
+      if isinstance(action, dict):
+        out.append(action)
+  if out:
+    return out
+
+  contexts = script.get("url_contexts")
+  if not isinstance(contexts, list):
+    return out
+  for ctx in contexts:
+    if not isinstance(ctx, dict):
+      continue
+    actions = ctx.get("actions")
+    if not isinstance(actions, list):
+      continue
+    for action in actions:
+      if isinstance(action, dict):
+        out.append(action)
+  return out
+
+
+def _read_key_script_id(script: Dict[str, Any]) -> str:
+  return str(script.get("keyScriptId") or "")
+
+
+def _is_transient_cdp_error(exc: Exception) -> bool:
+  msg = str(exc).lower()
+  transient_needles = (
+      "broken pipe",
+      "socket closed",
+      "connection reset",
+      "target not found",
+      "websocket",
+      "context was destroyed",
+      "execution context",
+      "provisional",
+      "timed out",
+      "timeout",
+  )
+  return any(needle in msg for needle in transient_needles)
+
+
+def _listener_setup_actions(script: Dict[str, Any]) -> List[Dict[str, Any]]:
+  """Return top-level actions that appear before the first listen action."""
+  out: List[Dict[str, Any]] = []
+  for action in _top_level_actions(script):
+    kind = str(action.get("action") or "").lower()
+    if kind == "listen":
+      return out
+    out.append(action)
+  return out
+
+
+def _normalize_data_key(key: str) -> str:
+  k = str(key or "").strip()
+  if len(k) >= 2 and k[0] == "{" and k[-1] == "}":
+    k = k[1:-1].strip()
+  return k
+
+
+def _read_key_value_ini(path: Path) -> Dict[str, str]:
+  out: Dict[str, str] = {}
+  try:
+    if not path.exists():
+      return out
+    for raw in path.read_text(encoding="utf-8").splitlines():
+      line = raw.rstrip("\r")
+      stripped = line.strip()
+      if not stripped or stripped.startswith("#") or stripped.startswith(";"):
+        continue
+      eq = line.find("=")
+      if eq <= 0:
+        continue
+      key = _normalize_data_key(line[:eq])
+      value = line[eq + 1:]
+      if key:
+        out[key] = value
+  except Exception:
+    return out
+  return out
+
+
+def _parse_tag_ref(tag: str) -> Tuple[str, str, Optional[int]]:
+  raw = str(tag or "").strip()
+  if not raw:
+    return "", "", None
+  grouped = raw
+  order: Optional[int] = None
+
+  suffix_begin = len(raw)
+  while suffix_begin > 0 and raw[suffix_begin - 1].isdigit():
+    suffix_begin -= 1
+  if suffix_begin > 0 and suffix_begin < len(raw):
+    prefix = raw[:suffix_begin]
+    suffix = raw[suffix_begin:]
+    try:
+      parsed = int(suffix)
+      if parsed >= 0 and prefix:
+        grouped = prefix
+        order = parsed
+    except Exception:
+      pass
+  return raw, grouped, order
+
+
+def _parse_tag_token_value(raw_value: str) -> Tuple[str, bool]:
+  value = str(raw_value or "")
+  if len(value) >= 2 and ((value[0] == '"' and value[-1] == '"') or
+                          (value[0] == "'" and value[-1] == "'")):
+    return value[1:-1], True
+  return value, False
+
+
+def _append_unique_tag_value(
+    tag_values: Dict[str, List[Tuple[str, Optional[int], int, bool]]],
+    tag: str,
+    raw_value: str,
+    order: Optional[int],
+    sequence: int) -> None:
+  clean_tag = str(tag or "").strip()
+  if not clean_tag:
+    return
+  parsed_value, no_delimiter = _parse_tag_token_value(raw_value)
+  items = tag_values.setdefault(clean_tag, [])
+  if any(existing[0] == parsed_value for existing in items):
+    return
+  items.append((parsed_value, order, sequence, no_delimiter))
+
+
+def _join_tag_values(
+    values: List[Tuple[str, Optional[int], int, bool]]) -> str:
+  if not values:
+    return ""
+  sorted_values = sorted(
+      values,
+      key=lambda item: (
+          0 if item[1] is not None else 1,
+          item[1] if item[1] is not None else 0,
+          item[2],
+      ),
+  )
+  no_delimiter = any(item[3] for item in sorted_values)
+  delimiter = "" if no_delimiter else ","
+  return delimiter.join(item[0] for item in sorted_values)
+
+
+def _parse_tagged_key(raw_key: str) -> Optional[
+    Tuple[str, str, List[Tuple[str, str, Optional[int]]]]]:
+  clean = _normalize_data_key(raw_key)
+  if not clean:
+    return None
+  parts = [p.strip() for p in clean.split("#") if p.strip()]
+  if not parts:
+    return None
+  base = parts[0]
+  if not base:
+    return None
+  tags: List[Tuple[str, str, Optional[int]]] = []
+  seen_raw: set[str] = set()
+  for tag in parts[1:]:
+    raw, grouped, order = _parse_tag_ref(tag)
+    if not raw or raw in seen_raw:
+      continue
+    tags.append((raw, grouped, order))
+    seen_raw.add(raw)
+  return clean, base, tags
+
+
+def _build_token_map(profile_dir: Path) -> Dict[str, str]:
+  data_dir = profile_dir / "SimulachromeData"
+  token_map: Dict[str, str] = {}
+  tag_values: Dict[str, List[Tuple[str, Optional[int], int, bool]]] = {}
+  tag_sequence = 0
+
+  def ingest(src: Dict[str, str], allow_overwrite: bool) -> None:
+    nonlocal tag_sequence
+    for raw_key, value in src.items():
+      parsed = _parse_tagged_key(raw_key)
+      if not parsed:
+        continue
+      clean_key, base_key, tags = parsed
+      if allow_overwrite or clean_key not in token_map:
+        token_map[clean_key] = value
+      if allow_overwrite or base_key not in token_map:
+        token_map[base_key] = value
+      for raw_tag, grouped_tag, order in tags:
+        _append_unique_tag_value(tag_values, raw_tag, value, None, tag_sequence)
+        tag_sequence += 1
+        if grouped_tag and grouped_tag != raw_tag:
+          _append_unique_tag_value(tag_values, grouped_tag, value, order,
+                                   tag_sequence)
+          tag_sequence += 1
+
+  ingest(_read_key_value_ini(data_dir / "variables.ini"), allow_overwrite=True)
+  ingest(_read_key_value_ini(data_dir / "secrets.ini"), allow_overwrite=False)
+  for tag, values in tag_values.items():
+    if tag and values:
+      token_map[tag] = _join_tag_values(values)
+  return token_map
+
+
+def _expand_tokens_once(value: str, token_map: Dict[str, str]) -> str:
+  text = str(value or "")
+  if not token_map or "{" not in text:
+    return text
+
+  def repl(match: re.Match[str]) -> str:
+    key = _normalize_data_key(match.group(1))
+    if not key:
+      return match.group(0)
+    return token_map.get(key, match.group(0))
+
+  return re.sub(r"\{([^{}]+)\}", repl, text)
+
+
+def _runtime_eval_value(ws: WebSocketCDP,
+                        expression: str,
+                        timeout_sec: float = 20.0) -> Any:
+  deadline = time.time() + max(1.0, timeout_sec)
+  last_error: Optional[Exception] = None
+  while time.time() < deadline:
+    try:
+      result = ws.call("Runtime.evaluate", {
+          "expression": expression,
+          "returnByValue": True,
+          "awaitPromise": True,
+      })
+      if isinstance(result, dict) and result.get("exceptionDetails"):
+        txt = json.dumps(result.get("exceptionDetails"), ensure_ascii=True)
+        raise RuntimeError(f"Runtime.evaluate exception: {txt[:280]}")
+      return (result.get("result") or {}).get("value")
+    except Exception as exc:
+      last_error = exc
+      msg = str(exc).lower()
+      # Navigations can transiently invalidate execution contexts.
+      if ("provisional" in msg or "context" in msg or
+          "target not found" in msg or "socket closed" in msg):
+        time.sleep(0.25)
+        continue
+      raise
+
+  if last_error is not None:
+    raise RuntimeError(f"Runtime.evaluate timed out: {last_error}") from last_error
+  raise RuntimeError("Runtime.evaluate timed out")
+
+
+def _wait_for_document_ready(ws: WebSocketCDP, timeout_sec: float = 20.0) -> None:
+  deadline = time.time() + max(1.0, timeout_sec)
+  while time.time() < deadline:
+    try:
+      state = str(_runtime_eval_value(
+          ws, "(() => document.readyState)()", timeout_sec=2.0) or "")
+      if state in ("interactive", "complete"):
+        return
+    except Exception:
+      pass
+    time.sleep(0.2)
+
+
+def _js_locator_op(locators: List[Dict[str, Any]], op: str, text: str = "") -> str:
+  payload = json.dumps({
+      "locators": [l for l in (locators or []) if isinstance(l, dict)],
+      "op": op,
+      "text": text,
+  }, ensure_ascii=True)
+  return r"""
+(() => {
+  const cfg = """ + payload + r""";
+  const norm = (s) => String(s || '').replace(/\s+/g, ' ').trim().toLowerCase();
+  const textFor = (el) => norm(el && (el.innerText || el.textContent || ''));
+  const byXPath = (xpath) => {
+    try {
+      const snap = document.evaluate(String(xpath || ''), document, null,
+          XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);
+      const out = [];
+      for (let i = 0; i < snap.snapshotLength; i++) out.push(snap.snapshotItem(i));
+      return out;
+    } catch (e) { return []; }
+  };
+  const parseCoords = (v) => {
+    try {
+      if (v && typeof v === 'object') {
+        const x = Number(v.x), y = Number(v.y);
+        if (Number.isFinite(x) && Number.isFinite(y)) return {x, y};
+      }
+      const s = String(v || '').trim();
+      const i = s.indexOf(',');
+      if (i > 0) {
+        const x = Number(s.slice(0, i).trim());
+        const y = Number(s.slice(i + 1).trim());
+        if (Number.isFinite(x) && Number.isFinite(y)) return {x, y};
+      }
+    } catch (e) {}
+    return null;
+  };
+  const matchesFor = (loc) => {
+    const typ = String((loc && loc.type) || '');
+    const val = String((loc && loc.value) || '');
+    switch (typ) {
+      case 'ID': {
+        const el = document.getElementById(val);
+        return el ? [el] : [];
+      }
+      case 'CSS_SELECTOR':
+        try { return Array.from(document.querySelectorAll(val)); } catch (e) { return []; }
+      case 'NAME':
+        try { return Array.from(document.getElementsByName(val)); } catch (e) { return []; }
+      case 'CLASS_NAME':
+        return Array.from(document.getElementsByClassName(val));
+      case 'TAG_NAME':
+        return Array.from(document.getElementsByTagName(val));
+      case 'XPATH':
+        return byXPath(val);
+      case 'LINK_TEXT':
+        return Array.from(document.querySelectorAll('a')).filter((a) => textFor(a) === norm(val));
+      case 'PARTIAL_LINK_TEXT':
+        return Array.from(document.querySelectorAll('a')).filter((a) => textFor(a).includes(norm(val)));
+      case 'TEXT_CONTENT':
+        return Array.from(document.querySelectorAll('*')).filter((el) => textFor(el).includes(norm(val)));
+      case 'JS_EVAL': {
+        try {
+          const fn = new Function('return (' + String(val || '') + ')');
+          const res = fn();
+          if (res && res.nodeType === 1) return [res];
+          if (Array.isArray(res)) return res.filter((e) => e && e.nodeType === 1);
+        } catch (e) {}
+        return [];
+      }
+      case 'VISUAL_COORDS': {
+        const c = parseCoords(val);
+        if (!c) return [];
+        try {
+          const el = document.elementFromPoint(c.x, c.y);
+          return el ? [el] : [];
+        } catch (e) { return []; }
+      }
+      default:
+        return [];
+    }
+  };
+  const pickFirst = () => {
+    const locs = Array.isArray(cfg.locators) ? cfg.locators : [];
+    for (const loc of locs) {
+      const arr = matchesFor(loc);
+      for (const el of arr) {
+        if (el && el.nodeType === 1) return el;
+      }
+    }
+    return null;
+  };
+
+  let el = pickFirst();
+  if (cfg.op === 'exists') {
+    return {ok: !!el};
+  }
+  if (cfg.op === 'contains_text') {
+    const base = el || document.body;
+    return {ok: textFor(base).includes(norm(String(cfg.text || '')))};
+  }
+  if (cfg.op === 'click') {
+    if (!el) return {ok: false, error: 'no_match'};
+    try { el.scrollIntoView({block: 'center', inline: 'center'}); } catch (e) {}
+    try { el.focus && el.focus(); } catch (e) {}
+    try {
+      el.dispatchEvent(new MouseEvent('mousedown', {bubbles: true, cancelable: true, view: window}));
+      el.dispatchEvent(new MouseEvent('mouseup', {bubbles: true, cancelable: true, view: window}));
+      if (typeof el.click === 'function') el.click();
+      else el.dispatchEvent(new MouseEvent('click', {bubbles: true, cancelable: true, view: window}));
+      return {ok: true};
+    } catch (e) {
+      return {ok: false, error: String(e)};
+    }
+  }
+  if (cfg.op === 'type') {
+    const t = String(cfg.text || '');
+    let target = el || document.activeElement;
+    if (!target) return {ok: false, error: 'no_target'};
+    try { target.focus && target.focus(); } catch (e) {}
+    try {
+      if ('value' in target) {
+        target.value = String(target.value || '') + t;
+      } else if (target.isContentEditable) {
+        target.textContent = String(target.textContent || '') + t;
+      } else {
+        return {ok: false, error: 'not_typable'};
+      }
+      target.dispatchEvent(new Event('input', {bubbles: true}));
+      target.dispatchEvent(new Event('change', {bubbles: true}));
+      return {ok: true};
+    } catch (e) {
+      return {ok: false, error: String(e)};
+    }
+  }
+  return {ok: false, error: 'unsupported_op'};
+})()
+"""
+
+
+def _locator_priority(loc_type: str) -> int:
+  # Prefer stable, semantic selectors first. Keep visual/coord hints as fallback.
+  order = {
+      "CSS_SELECTOR": 0,
+      "XPATH": 1,
+      "ID": 2,
+      "NAME": 3,
+      "LINK_TEXT": 4,
+      "PARTIAL_LINK_TEXT": 5,
+      "TEXT_CONTENT": 6,
+      "CLASS_NAME": 7,
+      "TAG_NAME": 8,
+      "JS_EVAL": 9,
+      "VISUAL_COORDS": 50,
+  }
+  return order.get(str(loc_type or "").upper(), 100)
+
+
+def _prioritize_locators(raw_locators: Any) -> List[Dict[str, Any]]:
+  if not isinstance(raw_locators, list):
+    return []
+  indexed: List[tuple[int, int, Dict[str, Any]]] = []
+  for idx, loc in enumerate(raw_locators):
+    if not isinstance(loc, dict):
+      continue
+    indexed.append((_locator_priority(loc.get("type") or ""), idx, loc))
+  indexed.sort(key=lambda item: (item[0], item[1]))
+  return [item[2] for item in indexed]
+
+
+def _execute_key_script_actions(ws: WebSocketCDP,
+                                actions: List[Dict[str, Any]],
+                                scripts_dir: Path,
+                                token_map: Dict[str, str],
+                                listener_script_id: str,
+                                depth: int = 0,
+                                visited: Optional[set[str]] = None) -> None:
+  if depth > 4:
+    raise RuntimeError("key script recursion depth exceeded")
+  if visited is None:
+    visited = set()
+
+  def as_params(action: Dict[str, Any]) -> Dict[str, Any]:
+    params = action.get("params")
+    return dict(params) if isinstance(params, dict) else {}
+
+  def as_int(v: Any, default: int = 0) -> int:
+    try:
+      return int(v)
+    except Exception:
+      return default
+
+  for action in actions:
+    if not isinstance(action, dict):
+      continue
+    kind = str(action.get("action") or "").lower()
+    params = as_params(action)
+
+    if kind == "navigate":
+      url = _expand_tokens_once(str(params.get("url") or ""), token_map).strip()
+      if not url:
+        continue
+      ws.call("Page.navigate", {"url": url})
+      _wait_for_document_ready(ws, timeout_sec=25.0)
+      time.sleep(0.25)
+      continue
+
+    if kind == "wait":
+      wait_type = str(params.get("waitType") or "time").lower()
+      if wait_type == "element":
+        locators = _prioritize_locators(params.get("locators"))
+        timeout_ms = as_int(params.get("timeout") or params.get("waitTimeout") or 15000, 15000)
+        deadline = time.time() + max(1.0, timeout_ms / 1000.0)
+        while time.time() < deadline:
+          res = _runtime_eval_value(ws, _js_locator_op(locators, "exists"), timeout_sec=3.0)
+          if isinstance(res, dict) and bool(res.get("ok")):
+            break
+          time.sleep(0.25)
+        else:
+          raise RuntimeError("key script wait(element) timed out")
+      else:
+        ms = as_int(params.get("time"), 0)
+        time.sleep(max(0, ms) / 1000.0)
+      continue
+
+    if kind == "click":
+      locators = _prioritize_locators(params.get("locators"))
+      timeout_ms = as_int(params.get("waitTimeout") or 15000, 15000)
+      deadline = time.time() + max(1.0, timeout_ms / 1000.0)
+      last_err = "no_match"
+      while time.time() < deadline:
+        res = _runtime_eval_value(
+            ws, _js_locator_op(locators, "click"), timeout_sec=8.0)
+        if isinstance(res, dict) and bool(res.get("ok")):
+          last_err = ""
+          break
+        last_err = res.get("error") if isinstance(res, dict) else "no_match"
+        time.sleep(0.25)
+      if last_err:
+        raise RuntimeError(f"key script click failed: {last_err}")
+      time.sleep(0.15)
+      continue
+
+    if kind == "type":
+      text = _expand_tokens_once(str(params.get("text") or ""), token_map)
+      locators = _prioritize_locators(params.get("locators"))
+      res = _runtime_eval_value(ws, _js_locator_op(locators, "type", text), timeout_sec=8.0)
+      if not (isinstance(res, dict) and bool(res.get("ok"))):
+        err = res.get("error") if isinstance(res, dict) else "no_target"
+        raise RuntimeError(f"key script type failed: {err}")
+      time.sleep(0.1)
+      continue
+
+    if kind == "if_condition":
+      cond_type = str(params.get("conditionType") or "").lower()
+      locators = _prioritize_locators(params.get("locators"))
+      condition_ok = False
+      if cond_type == "element_exists":
+        res = _runtime_eval_value(ws, _js_locator_op(locators, "exists"), timeout_sec=4.0)
+        condition_ok = isinstance(res, dict) and bool(res.get("ok"))
+      elif cond_type == "text_contains":
+        needle = _expand_tokens_once(str(params.get("text") or ""), token_map)
+        res = _runtime_eval_value(
+            ws, _js_locator_op(locators, "contains_text", needle), timeout_sec=4.0)
+        condition_ok = isinstance(res, dict) and bool(res.get("ok"))
+      then_actions = params.get("then")
+      else_actions = params.get("else")
+      branch_actions = then_actions if condition_ok else else_actions
+      if isinstance(branch_actions, list):
+        _execute_key_script_actions(
+            ws,
+            [a for a in branch_actions if isinstance(a, dict)],
+            scripts_dir,
+            token_map,
+            listener_script_id,
+            depth=depth + 1,
+            visited=visited,
+        )
+      continue
+
+    if kind == "loop":
+      nested = action.get("steps")
+      if isinstance(nested, list):
+        # Mirror current C++ LoopAction behavior: execute nested steps once.
+        _execute_key_script_actions(
+            ws,
+            [a for a in nested if isinstance(a, dict)],
+            scripts_dir,
+            token_map,
+            listener_script_id,
+            depth=depth + 1,
+            visited=visited,
+        )
+      continue
+
+    if kind == "call_script":
+      script_id = str(params.get("scriptId") or "").strip()
+      if not script_id or script_id in visited:
+        continue
+      visited.add(script_id)
+      callee = _load_script(script_id, scripts_dir / f"{script_id}.json")
+      if not callee:
+        raise RuntimeError(f"key script call_script target not found: {script_id}")
+      _execute_key_script_actions(
+          ws,
+          _top_level_actions(callee),
+          scripts_dir,
+          token_map,
+          listener_script_id,
+          depth=depth + 1,
+          visited=visited,
+      )
+      continue
+
+    # Unknown/unsupported key-script action: log and continue.
+    _append_event({
+        "ts_ms": _now_ms(),
+        "action": "warning",
+        "listener_script_id": listener_script_id,
+        "detail": f"key_script_unsupported_action:{kind or 'unknown'}",
+    })
+
+
+def _run_key_script_for_listener(script_id: str,
+                                 listener_script: Dict[str, Any],
+                                 target_id: str,
+                                 profile_dir: Path,
+                                 script_path: Optional[Path]) -> None:
+  key_script_id = _read_key_script_id(listener_script)
+
+  scripts_dir = script_path.parent if script_path else DEFAULT_SCRIPTS_DIR
+  setup_actions: List[Dict[str, Any]] = []
+  setup_label = ""
+  if key_script_id:
+    key_script = _load_script(key_script_id, scripts_dir / f"{key_script_id}.json")
+    if not key_script:
+      raise RuntimeError(f"key script not found: {key_script_id}")
+    setup_actions = _top_level_actions(key_script)
+    setup_label = key_script_id
+  else:
+    # Headful listener setup runs actions in the listener script before "listen".
+    # Mirror that behavior in headless mode when no explicit key script is set.
+    setup_actions = _listener_setup_actions(listener_script)
+    if not setup_actions:
+      return
+    setup_label = "inline_setup_actions"
+
+  token_map = _build_token_map(profile_dir)
+  _append_event({
+      "ts_ms": _now_ms(),
+      "action": "key_script",
+      "listener_script_id": script_id,
+      "detail": f"start:{setup_label}",
+  })
+
+  last_error: Optional[Exception] = None
+  for attempt in range(3):
+    ws: Optional[WebSocketCDP] = None
+    try:
+      ws = WebSocketCDP(_target_ws_url_with_retry(target_id, timeout_sec=4.0))
+      ws.call("Page.enable", {})
+      _wait_for_document_ready(ws, timeout_sec=10.0)
+      _append_event({
+          "ts_ms": _now_ms(),
+          "action": "key_script",
+          "listener_script_id": script_id,
+          "detail": f"running_unconditionally:{setup_label}",
+      })
+      _execute_key_script_actions(
+          ws,
+          setup_actions,
+          scripts_dir,
+          token_map,
+          listener_script_id=script_id,
+          depth=0,
+          visited={key_script_id} if key_script_id else set(),
+      )
+      last_error = None
+      break
+    except Exception as exc:
+      last_error = exc
+      retryable = _is_transient_cdp_error(exc) and attempt < 2
+      if retryable:
+        _append_event({
+            "ts_ms": _now_ms(),
+            "action": "warning",
+            "listener_script_id": script_id,
+            "detail": f"key_script_retry:{attempt + 1}:{exc}",
+        })
+        time.sleep(0.35 * (attempt + 1))
+        continue
+      _append_event({
+          "ts_ms": _now_ms(),
+          "action": "error",
+          "listener_script_id": script_id,
+          "detail": f"key_script_failed:{exc}",
+      })
+      raise
+    finally:
+      if ws is not None:
+        ws.close()
+
+  if last_error is not None:
+    raise last_error
+
+  _append_event({
+      "ts_ms": _now_ms(),
+      "action": "key_script",
+      "listener_script_id": script_id,
+      "detail": f"completed:{setup_label}",
+  })
+
+
+def _cdp_create_target_with_retry(url: str,
+                                  profile_dir: Optional[Path] = None,
+                                  browser_bin: str = "") -> Dict[str, Any]:
+  deadline = time.time() + max(5.0, HEADLESS_TARGET_CREATE_TIMEOUT_SEC)
+  last_error: Optional[Exception] = None
+  while time.time() < deadline:
+    if not _debug_port_live():
+      try:
+        _ensure_headless_instance(profile_dir or DEFAULT_PROFILE, browser_bin)
+      except Exception as exc:
+        last_error = exc
+        time.sleep(0.5)
+        continue
+    try:
+      target = _cdp_create_target(url)
+      target_id = str(target.get("id") or "")
+      if target_id:
+        _target_ws_url_with_retry(target_id, timeout_sec=3.0)
+        return target
+      last_error = RuntimeError("target created without id")
+    except Exception as exc:
+      last_error = exc
+    time.sleep(0.5)
+
+  if last_error is not None:
+    raise RuntimeError(
+        f"Failed to create CDP target after retry window: {last_error}") from last_error
+  raise RuntimeError("Failed to create CDP target after retry window")
+
+
+def _parse_frequency_seconds(listen_params: Dict[str, Any],
+                             all_listen_params: Optional[List[Dict[str, Any]]] = None) -> int:
+  def _to_int(value: Any) -> int:
+    try:
+      return int(value)
+    except Exception:
+      return 0
+
+  all_ms: List[int] = []
+  ms = _to_int(listen_params.get("executionFrequencyMs"))
+  if ms > 0:
+    all_ms.append(ms)
+  if isinstance(all_listen_params, list):
+    for params in all_listen_params:
+      if not isinstance(params, dict):
+        continue
+      candidate_ms = _to_int(params.get("executionFrequencyMs"))
+      if candidate_ms > 0:
+        all_ms.append(candidate_ms)
+  if all_ms:
+    # Listener scripts can temporarily hold duplicate listen definitions while
+    # edits are being reconciled between root actions and url_contexts. Use the
+    # fastest configured cadence to avoid effectively "paused" listeners.
+    return max(1, int(round(min(all_ms) / 1000.0)))
+  return 60
+
+
+def _parse_bool_param(listen_params: Dict[str, Any],
+                      key: str,
+                      default: bool) -> bool:
+  if key in listen_params:
+    value = listen_params.get(key)
+    if isinstance(value, bool):
+      return value
+    if isinstance(value, (int, float)):
+      return bool(value)
+    if isinstance(value, str):
+      s = value.strip().lower()
+      if s in ("1", "true", "yes", "on"):
+        return True
+      if s in ("0", "false", "no", "off"):
+        return False
+  return default
+
+
+def _normalize_signature_token(value: str) -> str:
+  s = re.sub(r"\s+", " ", str(value or "")).strip().lower()
+  if len(s) > 240:
+    s = s[:240]
+  return s
+
+
+def _read_recent_match_signatures(script: Dict[str, Any]) -> List[str]:
+  raw = script.get(RECENT_MATCH_SIGNATURES_KEY)
+  if not isinstance(raw, list):
+    return []
+  out: List[str] = []
+  for item in raw:
+    if not isinstance(item, str):
+      continue
+    normalized = _normalize_signature_token(item)
+    if not normalized or normalized in out:
+      continue
+    out.append(normalized)
+    if len(out) >= MAX_RECENT_MATCH_SIGNATURES:
+      break
+  return out
+
+
+def _remember_recent_match_signature(signatures: List[str], signature: str) -> None:
+  normalized = _normalize_signature_token(signature)
+  if not normalized:
+    return
+  try:
+    signatures.remove(normalized)
+  except ValueError:
+    pass
+  signatures.insert(0, normalized)
+  del signatures[MAX_RECENT_MATCH_SIGNATURES:]
+
+
+def _resolve_listener_script_path(script_id: str,
+                                  entry: Dict[str, Any]) -> Path:
+  script_path = str(entry.get("script_path") or "").strip()
+  if script_path:
+    return Path(script_path)
+  return DEFAULT_SCRIPTS_DIR / f"{script_id}.json"
+
+
+def _persist_recent_match_signatures(script_id: str,
+                                     entry: Dict[str, Any],
+                                     signatures: List[str]) -> None:
+  path = _resolve_listener_script_path(script_id, entry)
+  script = _read_json(path, {})
+  if not isinstance(script, dict):
+    return
+
+  cleaned: List[str] = []
+  for signature in signatures:
+    normalized = _normalize_signature_token(signature)
+    if not normalized or normalized in cleaned:
+      continue
+    cleaned.append(normalized)
+    if len(cleaned) >= MAX_RECENT_MATCH_SIGNATURES:
+      break
+  script[RECENT_MATCH_SIGNATURES_KEY] = cleaned
+  _write_json(path, script)
+
+
+def _parse_start_url(script: Dict[str, Any]) -> str:
+  explicit = str(script.get("startUrl") or "").strip()
+  if explicit:
+    return explicit
+  inferred = _first_navigate_url(_top_level_actions(script))
+  if inferred:
+    return inferred
+  contexts = script.get("url_contexts") or []
+  for c in contexts:
+    if isinstance(c, dict) and c.get("url"):
+      return str(c.get("url"))
+  return "about:blank"
+
+
+def _first_navigate_url(actions: List[Dict[str, Any]]) -> str:
+  for action in _iter_nested_actions(actions):
+    kind = str(action.get("action") or "").lower()
+    if kind != "navigate":
+      continue
+    params = action.get("params")
+    if not isinstance(params, dict):
+      continue
+    url = str(params.get("url") or "").strip()
+    if url:
+      return url
+  return ""
+
+
+def _iter_nested_actions(actions: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+  out: List[Dict[str, Any]] = []
+  stack: List[Dict[str, Any]] = [a for a in reversed(actions) if isinstance(a, dict)]
+  while stack:
+    action = stack.pop()
+    out.append(action)
+
+    child_lists: List[Any] = [
+        action.get("steps"),
+        action.get("then"),
+        action.get("else"),
+        action.get("nested"),
+    ]
+    for child_list in child_lists:
+      if not isinstance(child_list, list):
+        continue
+      for child in reversed(child_list):
+        if isinstance(child, dict):
+          stack.append(child)
+  return out
+
+
+def _first_listen_params(script: Dict[str, Any]) -> Dict[str, Any]:
+  for action in _iter_nested_actions(_top_level_actions(script)):
+    kind = str(action.get("action") or "").lower()
+    if kind != "listen":
+      continue
+    params = action.get("params")
+    if isinstance(params, dict):
+      return dict(params)
+    return {}
+  return {}
+
+
+def _all_listen_params(script: Dict[str, Any]) -> List[Dict[str, Any]]:
+  out: List[Dict[str, Any]] = []
+
+  def append_from_actions(actions: Any) -> None:
+    if not isinstance(actions, list):
+      return
+    dict_actions = [a for a in actions if isinstance(a, dict)]
+    for action in _iter_nested_actions(dict_actions):
+      kind = str(action.get("action") or "").lower()
+      if kind != "listen":
+        continue
+      params = action.get("params")
+      if isinstance(params, dict):
+        out.append(dict(params))
+
+  append_from_actions(script.get("actions"))
+  contexts = script.get("url_contexts")
+  if isinstance(contexts, list):
+    for ctx in contexts:
+      if not isinstance(ctx, dict):
+        continue
+      append_from_actions(ctx.get("actions"))
+  return out
+
+
+def _parse_listener_config(script_id: str, script: Dict[str, Any]) -> ListenerConfig:
+  listen_params = _first_listen_params(script)
+  all_listen_params = _all_listen_params(script)
+  locators = listen_params.get("locators")
+  if not isinstance(locators, list):
+    locators = []
+  return ListenerConfig(
+      script_id=script_id,
+      start_url=_parse_start_url(script),
+      refresh_seconds=_parse_frequency_seconds(listen_params, all_listen_params),
+      auto_refresh=_parse_bool_param(listen_params, "autoRefresh", False),
+      refresh_jitter=_parse_bool_param(listen_params, "refreshJitter", True),
+      extreme_evasion=_parse_bool_param(listen_params, "extremeEvasion", True),
+      locators=[l for l in locators if isinstance(l, dict)],
+      condition=str(listen_params.get("condition") or ""),
+      needle=str(listen_params.get("text") or ""),
+      attribute=str(listen_params.get("attribute") or ""),
+      on_match_script_id=str(listen_params.get("onMatchScriptId") or ""),
+      recent_match_signatures=(
+          _read_recent_match_signatures(script)
+          if ENABLE_CROSS_RUN_MATCH_DEDUPE else []
+      ),
+      owner_pid=0,
+  )
+
+def _expand_listener_config_tokens(config: ListenerConfig,
+                                   token_map: Dict[str, str]) -> ListenerConfig:
+  expanded_locators: List[Dict[str, Any]] = []
+  for loc in config.locators or []:
+    if not isinstance(loc, dict):
+      continue
+    loc_copy = dict(loc)
+    value = loc_copy.get("value")
+    if isinstance(value, str):
+      loc_copy["value"] = _expand_tokens_once(value, token_map)
+    expanded_locators.append(loc_copy)
+
+  return ListenerConfig(
+      script_id=config.script_id,
+      start_url=_expand_tokens_once(config.start_url, token_map),
+      refresh_seconds=config.refresh_seconds,
+      auto_refresh=config.auto_refresh,
+      refresh_jitter=config.refresh_jitter,
+      extreme_evasion=config.extreme_evasion,
+      locators=expanded_locators,
+      condition=config.condition,
+      needle=_expand_tokens_once(config.needle, token_map),
+      attribute=_expand_tokens_once(config.attribute, token_map),
+      on_match_script_id=config.on_match_script_id,
+      recent_match_signatures=list(config.recent_match_signatures or []),
+      owner_pid=config.owner_pid,
+  )
+
+
+def _has_unresolved_token(text: str) -> bool:
+  s = str(text or "")
+  m = re.search(r"\{([^{}]+)\}", s)
+  if not m:
+    return False
+  token = str(m.group(1) or "").strip()
+  return bool(token)
+
+
+def _validate_listener_config(config: ListenerConfig) -> None:
+  if not config.locators:
+    raise RuntimeError("Listen action requires at least one locator.")
+  for loc in config.locators:
+    if not isinstance(loc, dict):
+      continue
+    loc_type = str(loc.get("type") or "").strip().upper()
+    value = str(loc.get("value") or "").strip()
+    if not value:
+      raise RuntimeError("Listen locator contains an empty value.")
+    if _has_unresolved_token(value):
+      raise RuntimeError(
+          "Listen locator contains unresolved {token}. Set the token in Data "
+          "variables/secrets, or use a literal locator value.")
+    if loc_type == "CSS_SELECTOR" and value == "#":
+      raise RuntimeError("Listen locator CSS selector '#' is invalid.")
+
+
+def _js_collect_snapshot_keys(locators: List[Dict[str, Any]],
+                              condition: str,
+                              needle: str,
+                              attribute: str) -> str:
+  payload = json.dumps({
+      "locators": locators or [],
+      "condition": condition or "",
+      "needle": needle or "",
+      "attribute": attribute or "",
+  }, ensure_ascii=True)
+  return r"""
+(() => {
+  const cfg = """ + payload + r""";
+  const cond = String(cfg.condition || '').toLowerCase();
+  const want = String(cfg.needle || '').replace(/\s+/g, ' ').trim();
+  const wantFold = want.toLowerCase();
+  const attrName = String(cfg.attribute || '').trim();
+  const norm = (s) => String(s || '').replace(/\s+/g, ' ').trim();
+  function byXPath(xpath) {
+    try {
+      const snap = document.evaluate(String(xpath || ''), document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);
+      const out = [];
+      for (let i = 0; i < snap.snapshotLength; i++) out.push(snap.snapshotItem(i));
+      return out;
+    } catch (e) { return []; }
+  }
+  function parseCoords(v){
+    try {
+      if (v && typeof v === 'object') {
+        const x = Number(v.x), y = Number(v.y);
+        if (Number.isFinite(x) && Number.isFinite(y)) return {x, y};
+      }
+      const s = String(v || '').trim();
+      const i = s.indexOf(',');
+      if (i > 0) {
+        const x = Number(s.slice(0, i).trim());
+        const y = Number(s.slice(i + 1).trim());
+        if (Number.isFinite(x) && Number.isFinite(y)) return {x, y};
+      }
+    } catch (e) {}
+    return null;
+  }
+  function matchesFor(loc){
+    switch(String((loc && loc.type) || '')){
+      case 'ID': return [document.getElementById(loc.value)].filter(Boolean);
+      case 'CSS_SELECTOR': try { return Array.from(document.querySelectorAll(String(loc.value || ''))); } catch (e) { return []; }
+      case 'NAME': try { return Array.from(document.getElementsByName(String(loc.value || ''))); } catch (e) { return []; }
+      case 'CLASS_NAME': return Array.from(document.getElementsByClassName(String(loc.value || '')));
+      case 'TAG_NAME': return Array.from(document.getElementsByTagName(String(loc.value || '')));
+      case 'XPATH': return byXPath(loc.value);
+      case 'VISUAL_COORDS': {
+        const c = parseCoords(loc.value);
+        if (!c) return [];
+        try { const el = document.elementFromPoint(c.x, c.y); return el ? [el] : []; } catch (e) { return []; }
+      }
+      default: return [];
+    }
+  }
+  function isVisible(el){
+    if (!el) return false;
+    try {
+      const r = el.getBoundingClientRect();
+      if (!r || r.width <= 0 || r.height <= 0) return false;
+      const cs = window.getComputedStyle(el);
+      if (!cs) return true;
+      if (cs.display === 'none') return false;
+      if (cs.visibility === 'hidden' || cs.visibility === 'collapse') return false;
+      const op = parseFloat(cs.opacity || '1');
+      if (!Number.isNaN(op) && op <= 0.01) return false;
+    } catch (e) { return false; }
+    return true;
+  }
+  function textFor(el){
+    if (!el) return '';
+    try {
+      const tag = String(el.tagName || '').toLowerCase();
+      if (tag === 'input' || tag === 'textarea') return norm(el.value || '');
+    } catch (e) {}
+    return norm(el.innerText || el.textContent || '');
+  }
+  function attrFor(el){
+    try { return String((el && attrName) ? (el.getAttribute(attrName) || '') : ''); } catch (e) { return ''; }
+  }
+  function includesFold(haystack){
+    const h = String(haystack || '');
+    if (!h || !want) return false;
+    return h.includes(want) || h.toLowerCase().includes(wantFold);
+  }
+  function equalsFold(haystack){
+    const h = norm(haystack || '');
+    if (!h || !want) return false;
+    return h === want || h.toLowerCase() === wantFold;
+  }
+  function matchesCondition(el){
+    if (!el) return false;
+    if (cond === 'visible') return isVisible(el);
+    if (cond === 'hidden') return !isVisible(el);
+    if (cond === 'text_contains' || cond === 'contains_text') return includesFold(textFor(el));
+    if (cond === 'text_equals' || cond === 'text_is') return equalsFold(textFor(el));
+    if (cond === 'attribute_contains') return !!attrName && includesFold(attrFor(el));
+    if (cond === 'attribute_equals') return !!attrName && equalsFold(attrFor(el));
+    return true;
+  }
+  function articleMetaFor(el){
+    let author = '', timestamp = '', articleText = '';
+    try {
+      const article = el && el.closest ? el.closest('[role="article"], article') : null;
+      if (!article) return {author, timestamp, articleText};
+      const authorNode = article.querySelector('[data-testid="User-Name"], [data-author], [itemprop="author"], a[rel="author"]');
+      if (authorNode) author = norm((authorNode.getAttribute && authorNode.getAttribute('data-author')) || authorNode.innerText || authorNode.textContent || '');
+      const timeNode = article.querySelector('time,[datetime],[data-time]');
+      if (timeNode) timestamp = norm((timeNode.getAttribute && (timeNode.getAttribute('datetime') || timeNode.getAttribute('data-time'))) || timeNode.innerText || timeNode.textContent || '');
+      articleText = norm(article.innerText || article.textContent || '').slice(0, 220);
+    } catch (e) {}
+    return {author, timestamp, articleText};
+  }
+  function keyFor(el){
+    const meta = articleMetaFor(el);
+    if (meta.author || meta.timestamp || meta.articleText) {
+      return 'a|' + meta.author + '|' + meta.timestamp + '|' + meta.articleText;
+    }
+    const tag = String(el.tagName || '').toLowerCase();
+    const id = norm(el.id || '');
+    const cls = norm(el.className || '');
+    const txt = textFor(el).slice(0, 180);
+    const childCount = (el && el.children && Number.isFinite(el.children.length)) ? el.children.length : 0;
+    return 'e|' + tag + '|' + id + '|' + cls + '|' + childCount + '|' + txt;
+  }
+  const out = [];
+  const seen = new Set();
+  const locators = Array.isArray(cfg.locators) ? cfg.locators : [];
+  for (let i = 0; i < locators.length; i++) {
+    const arr = matchesFor(locators[i]) || [];
+    for (let j = 0; j < arr.length; j++) {
+      const el = arr[j];
+      if (!el || el.nodeType !== 1) continue;
+      if (!matchesCondition(el)) continue;
+      const key = keyFor(el);
+      if (!key || seen.has(key)) continue;
+      seen.add(key);
+      out.push(key);
+      if (out.length >= 512) return out;
+    }
+  }
+  return out;
+})()
+"""
+
+
+def _js_evasive_interaction() -> str:
+  return r"""
+(() => {
+  const w = Math.max(1, window.innerWidth || 1);
+  const h = Math.max(1, window.innerHeight || 1);
+  const x = Math.floor(Math.random() * w);
+  const y = Math.floor(Math.random() * h);
+  document.dispatchEvent(new MouseEvent('mousemove', {
+    bubbles: true,
+    cancelable: true,
+    clientX: x,
+    clientY: y,
+  }));
+  const dy = 100 + Math.floor(Math.random() * 201);
+  window.scrollBy({top: dy, left: 0, behavior: 'instant'});
+  return {x, y, dy};
+})()
+"""
+
+
+def _worker_loop(script_id: str, target_id: str, config: ListenerConfig) -> None:
+  recent_signatures = [
+      _normalize_signature_token(s)
+      for s in ((config.recent_match_signatures or [])
+                if ENABLE_CROSS_RUN_MATCH_DEDUPE else [])
+  ]
+  recent_signatures = [s for s in recent_signatures if s][:MAX_RECENT_MATCH_SIGNATURES]
+  seen_keys: set[str] = set(recent_signatures)
+  next_sleep_at = time.time() + random.randint(8 * 3600, 12 * 3600)
+  last_triggered_at = 0.0
+  attached_to_state = False
+  attach_deadline = time.monotonic() + max(0.0, HEADLESS_WORKER_ATTACH_GRACE_SEC)
+
+  while True:
+    # Check shutdown request by state file ownership.
+    st = _read_json(STATE_PATH, {})
+    listeners = st.get("listeners", {}) if isinstance(st, dict) else {}
+    entry = listeners.get(script_id) if isinstance(listeners, dict) else None
+    if not isinstance(entry, dict):
+      # Startup race: worker may begin before start command persists the
+      # listener entry in state. Give it a brief attach window.
+      if not attached_to_state and time.monotonic() < attach_deadline:
+        time.sleep(0.1)
+        continue
+      return
+    attached_to_state = True
+    owner_pid = int(entry.get("owner_pid") or config.owner_pid or 0)
+    if owner_pid > 1 and not _pid_is_alive(owner_pid):
+      listeners.pop(script_id, None)
+      st["listeners"] = listeners
+      if not listeners:
+        browser_pid = int(st.get("browser_pid") or 0)
+        if browser_pid > 1:
+          _stop_pid(browser_pid)
+        st["browser_pid"] = 0
+      _write_json(STATE_PATH, st)
+      _append_event({
+          "ts_ms": _now_ms(),
+          "action": "error",
+          "listener_script_id": script_id,
+          "detail": "owner_browser_exited",
+      })
+      return
+
+    ws: Optional[WebSocketCDP] = None
+    try:
+      ws_url = _target_ws_url_with_retry(target_id, timeout_sec=3.0)
+      ws = WebSocketCDP(ws_url)
+      if config.auto_refresh and config.extreme_evasion and time.time() >= next_sleep_at:
+        sleep_secs = random.randint(4 * 3600, 6 * 3600)
+        _append_event({
+            "ts_ms": _now_ms(),
+            "action": "long_pause",
+            "listener_script_id": script_id,
+            "detail": f"sleep={sleep_secs}s",
+        })
+        time.sleep(sleep_secs)
+        next_sleep_at = time.time() + random.randint(8 * 3600, 12 * 3600)
+
+      if config.auto_refresh:
+        ws.call("Page.reload", {"ignoreCache": False})
+        _append_event({
+            "ts_ms": _now_ms(),
+            "action": "refresh",
+            "listener_script_id": script_id,
+            "detail": "reload",
+        })
+        time.sleep(2.0)
+        # Apply one jitter interaction per refresh cycle (not continuously).
+        if config.refresh_jitter:
+          jitter = random.uniform(1.0, 3.0)
+          time.sleep(jitter)
+          ws.call("Runtime.evaluate", {
+              "expression": _js_evasive_interaction(),
+              "returnByValue": True
+          })
+          _append_event({
+              "ts_ms": _now_ms(),
+              "action": "jitter",
+              "listener_script_id": script_id,
+              "detail": f"jitter={jitter:.2f}s",
+          })
+      else:
+        # Non-refresh listeners should stay quiet and only poll snapshots.
+        time.sleep(0.5)
+
+      result = ws.call("Runtime.evaluate", {
+          "expression": _js_collect_snapshot_keys(
+              config.locators,
+              config.condition,
+              config.needle,
+              config.attribute),
+          "returnByValue": True,
+      })
+      value = result.get("result", {}).get("value", [])
+      keys: set[str] = set()
+      for item in value:
+        if item is None:
+          continue
+        normalized = _normalize_signature_token(str(item))
+        if normalized:
+          keys.add(normalized)
+      new_keys = [k for k in keys if k not in seen_keys]
+      if new_keys:
+        now = time.time()
+        if (last_triggered_at <= 0.0 or
+            (now - last_triggered_at) >= max(1, config.refresh_seconds)):
+          event = {
+              "ts_ms": _now_ms(),
+              "action": "trigger",
+              "listener_script_id": script_id,
+              "detail": f"new_matches={len(new_keys)}",
+          }
+          if config.on_match_script_id:
+            event["trigger_script_id"] = config.on_match_script_id
+          _append_event(event)
+          if ENABLE_CROSS_RUN_MATCH_DEDUPE:
+            for key in sorted(new_keys):
+              _remember_recent_match_signature(recent_signatures, key)
+            try:
+              _persist_recent_match_signatures(script_id, entry, recent_signatures)
+            except Exception as persist_err:
+              _append_event({
+                  "ts_ms": _now_ms(),
+                  "action": "error",
+                  "listener_script_id": script_id,
+                  "detail": f"persist_recent_matches_failed: {persist_err}",
+              })
+          last_triggered_at = now
+      seen_keys |= keys
+    except Exception as e:
+      _append_event({
+          "ts_ms": _now_ms(),
+          "action": "error",
+          "listener_script_id": script_id,
+          "detail": str(e),
+      })
+      time.sleep(3.0)
+    finally:
+      if ws is not None:
+        ws.close()
+
+    delay = config.refresh_seconds
+    if config.auto_refresh and config.extreme_evasion:
+      # Keep short-cadence listeners responsive. Large "stealth" pauses only
+      # make sense for already-slow monitors.
+      if delay >= 300:
+        delay += random.randint(60, 20 * 60)
+      else:
+        delay += random.uniform(0.5, 3.0)
+    time.sleep(max(1, delay))
+
+
+def _spawn_worker(script_id: str, target_id: str, config: ListenerConfig) -> int:
+  cmd = [
+      sys.executable,
+      __file__,
+      "--worker",
+      "--script-id",
+      script_id,
+      "--target-id",
+      target_id,
+      "--listener-config-json",
+      json.dumps({
+          "script_id": config.script_id,
+          "start_url": config.start_url,
+          "refresh_seconds": config.refresh_seconds,
+          "auto_refresh": config.auto_refresh,
+          "refresh_jitter": config.refresh_jitter,
+          "extreme_evasion": config.extreme_evasion,
+          "locators": config.locators,
+          "condition": config.condition,
+          "needle": config.needle,
+          "attribute": config.attribute,
+          "on_match_script_id": config.on_match_script_id,
+          "recent_match_signatures": config.recent_match_signatures,
+          "owner_pid": config.owner_pid,
+      }),
+  ]
+  with LAUNCH_LOG_PATH.open("ab", buffering=0) as launch_log_file:
+    proc = subprocess.Popen(
+        cmd,
+        stdin=subprocess.DEVNULL,
+        stdout=launch_log_file,
+        stderr=launch_log_file,
+        start_new_session=True,
+    )
+  return proc.pid
+
+
+def _tail_launch_log(max_chars: int = 400) -> str:
+  try:
+    if not LAUNCH_LOG_PATH.exists():
+      return ""
+    raw = LAUNCH_LOG_PATH.read_text(encoding="utf-8", errors="replace")
+    raw = raw.strip()
+    if not raw:
+      return ""
+    return raw[-max_chars:]
+  except Exception:
+    return ""
+
+
+def _stop_pid(pid: int) -> None:
+  try:
+    os.kill(pid, signal.SIGTERM)
+  except Exception:
+    pass
+
+
+def _prune_dead_listeners(state: Dict[str, Any]) -> bool:
+  listeners_raw = state.get("listeners", {})
+  listeners = listeners_raw if isinstance(listeners_raw, dict) else {}
+  changed = False
+  now_ms = _now_ms()
+
+  browser_pid = int(state.get("browser_pid") or 0)
+  # If browser_pid is unknown/sentinel (<=1), fall back to checking CDP
+  # endpoint liveness. This prevents false pruning when a valid headless
+  # process exists but pid tracking was lost across restarts/crashes.
+  browser_alive = _pid_is_alive(browser_pid) if browser_pid > 1 else _debug_port_live()
+
+  starting_grace_ms = int(max(1.0, HEADLESS_STARTING_ENTRY_GRACE_SEC) * 1000)
+
+  for listener_id, entry in list(listeners.items()):
+    if not isinstance(entry, dict):
+      listeners.pop(listener_id, None)
+      changed = True
+      continue
+
+    is_starting = bool(entry.get("starting"))
+    started_ms = int(entry.get("started_ms") or 0)
+    age_ms = max(0, now_ms - started_ms) if started_ms > 0 else 0
+
+    if is_starting:
+      # Startup is asynchronous. Keep provisional entries during grace even if
+      # the browser process/port is not yet visible to concurrent pollers.
+      if age_ms <= starting_grace_ms:
+        continue
+      target_id = str(entry.get("target_id") or "")
+      if target_id:
+        _cdp_close_target(target_id)
+      listeners.pop(listener_id, None)
+      changed = True
+      _append_event({
+          "ts_ms": now_ms,
+          "action": "error",
+          "listener_script_id": listener_id,
+          "detail": "stale_listener_pruned_start_timeout",
+      })
+      continue
+
+    if not browser_alive:
+      target_id = str(entry.get("target_id") or "")
+      if target_id:
+        _cdp_close_target(target_id)
+      listeners.pop(listener_id, None)
+      changed = True
+      _append_event({
+          "ts_ms": _now_ms(),
+          "action": "error",
+          "listener_script_id": listener_id,
+          "detail": "stale_listener_pruned_browser_missing",
+      })
+      continue
+
+    worker_pid = int(entry.get("worker_pid") or 0)
+    if worker_pid > 1 and _pid_is_alive(worker_pid):
+      continue
+    target_id = str(entry.get("target_id") or "")
+    if target_id:
+      _cdp_close_target(target_id)
+    listeners.pop(listener_id, None)
+    changed = True
+    _append_event({
+        "ts_ms": _now_ms(),
+        "action": "error",
+        "listener_script_id": listener_id,
+        "detail": "stale_listener_pruned_worker_missing",
+    })
+
+  if not listeners:
+    if browser_pid > 1 and browser_alive:
+      _stop_pid(browser_pid)
+      changed = True
+    elif _debug_port_live():
+      # PID tracking can be lost across crashes/restarts. In that case we may
+      # still own a singleton headless browser on :9222 with no active
+      # listeners. Close it through CDP so orphan instances don't linger.
+      if _cdp_close_browser():
+        changed = True
+    if int(state.get("browser_pid") or 0) != 0:
+      state["browser_pid"] = 0
+      changed = True
+
+  if state.get("listeners") is not listeners:
+    state["listeners"] = listeners
+    changed = True
+  return changed
+
+
+def _validate_script_id(script_id: str) -> None:
+  if not SCRIPT_ID_RE.fullmatch(script_id or ""):
+    raise RuntimeError("Invalid script_id. Expected ^[a-zA-Z0-9_-]{1,128}$")
+
+
+def cmd_start_headless_listener(script_id: str,
+                                profile_dir: Path,
+                                script_path: Optional[Path],
+                                browser_bin: str = "") -> Dict[str, Any]:
+  _validate_script_id(script_id)
+
+  state = _read_json(STATE_PATH, {"listeners": {}})
+  if _prune_dead_listeners(state):
+    _write_json(STATE_PATH, state)
+  listeners = state.setdefault("listeners", {})
+  if script_id in listeners:
+    return {"ok": True, "already_running": True}
+
+  # If no listeners are active, recycle the singleton headless process so each
+  # listener start gets a fresh warm-sync of session/cookie state.
+  existing_browser_pid = int(state.get("browser_pid") or 0)
+  if not listeners and existing_browser_pid > 1 and _pid_is_alive(existing_browser_pid):
+    _stop_pid(existing_browser_pid)
+    state["browser_pid"] = 0
+    _write_json(STATE_PATH, state)
+    time.sleep(0.2)
+
+  owner_pid = os.getppid()
+  listeners[script_id] = {
+      "starting": True,
+      "target_id": "",
+      "worker_pid": 0,
+      "started_ms": _now_ms(),
+      "start_url": "",
+      "current_url": "",
+      "script_path": str(script_path) if script_path else "",
+      "owner_pid": owner_pid,
+  }
+  _write_json(STATE_PATH, state)
+
+  target_id = ""
+  try:
+    script = _load_script(script_id, script_path)
+    cfg = _parse_listener_config(script_id, script)
+    token_map = _build_token_map(profile_dir)
+    cfg = _expand_listener_config_tokens(cfg, token_map)
+    _validate_listener_config(cfg)
+    key_script_id = _read_key_script_id(script)
+    if key_script_id:
+      scripts_dir = script_path.parent if script_path else DEFAULT_SCRIPTS_DIR
+      key_script = _load_script(key_script_id, scripts_dir / f"{key_script_id}.json")
+      if isinstance(key_script, dict):
+        key_nav_url = _first_navigate_url(_top_level_actions(key_script))
+        if key_nav_url:
+          cfg.start_url = key_nav_url
+    cfg.owner_pid = owner_pid
+
+    listeners[script_id]["start_url"] = cfg.start_url
+    listeners[script_id]["current_url"] = cfg.start_url
+    _write_json(STATE_PATH, state)
+
+    _ensure_headless_instance(profile_dir, browser_bin)
+    target = _cdp_create_target_with_retry(
+        cfg.start_url, profile_dir=profile_dir, browser_bin=browser_bin)
+    target_id = str(target.get("id") or "")
+    if not target_id:
+      raise RuntimeError("Failed to create CDP target")
+
+    listeners[script_id]["target_id"] = target_id
+    _write_json(STATE_PATH, state)
+
+    try:
+      _run_key_script_for_listener(
+          script_id=script_id,
+          listener_script=script,
+          target_id=target_id,
+          profile_dir=profile_dir,
+          script_path=script_path,
+      )
+    except Exception as exc:
+      # Inline setup actions are best-effort in headless mode. Keep listener
+      # startup alive and let the worker continue polling/listening.
+      if key_script_id:
+        _cdp_close_target(target_id)
+        raise
+      _append_event({
+          "ts_ms": _now_ms(),
+          "action": "warning",
+          "listener_script_id": script_id,
+          "detail": f"inline_setup_nonfatal:{exc}",
+      })
+
+    worker_pid = _spawn_worker(script_id, target_id, cfg)
+    time.sleep(0.2)
+    if worker_pid > 1 and not _pid_is_alive(worker_pid):
+      _cdp_close_target(target_id)
+      tail = _tail_launch_log()
+      if tail:
+        raise RuntimeError(f"Headless listener worker exited immediately. Tail: {tail}")
+      raise RuntimeError("Headless listener worker exited immediately.")
+    listeners[script_id] = {
+        "target_id": target_id,
+        "worker_pid": worker_pid,
+        "started_ms": _now_ms(),
+        "start_url": cfg.start_url,
+        "current_url": cfg.start_url,
+        "script_path": str(script_path) if script_path else "",
+        "owner_pid": cfg.owner_pid,
+    }
+    _write_json(STATE_PATH, state)
+    _append_event({
+        "ts_ms": _now_ms(),
+        "action": "refresh",
+        "listener_script_id": script_id,
+        "detail": "listener_started",
+    })
+    return {"ok": True, "target_id": target_id, "worker_pid": worker_pid}
+  except Exception:
+    fresh_state = _read_json(STATE_PATH, {"listeners": {}})
+    fresh_listeners = fresh_state.get("listeners", {})
+    if isinstance(fresh_listeners, dict):
+      entry = fresh_listeners.get(script_id)
+      if isinstance(entry, dict) and bool(entry.get("starting")):
+        existing_target_id = str(entry.get("target_id") or target_id or "")
+        if existing_target_id:
+          _cdp_close_target(existing_target_id)
+        fresh_listeners.pop(script_id, None)
+        fresh_state["listeners"] = fresh_listeners
+        _write_json(STATE_PATH, fresh_state)
+    raise
+
+
+def cmd_stop_headless_listener(script_id: str) -> Dict[str, Any]:
+  _validate_script_id(script_id)
+  state = _read_json(STATE_PATH, {"listeners": {}})
+  if _prune_dead_listeners(state):
+    _write_json(STATE_PATH, state)
+  listeners = state.get("listeners", {})
+  entry = listeners.pop(script_id, None)
+  if not entry:
+    return {"ok": True, "already_stopped": True}
+
+  worker_pid = int(entry.get("worker_pid") or 0)
+  target_id = str(entry.get("target_id") or "")
+  if worker_pid > 1:
+    _stop_pid(worker_pid)
+  if target_id:
+    _cdp_close_target(target_id)
+
+  _append_event({
+      "ts_ms": _now_ms(),
+      "action": "refresh",
+      "listener_script_id": script_id,
+      "detail": "listener_stopped",
+  })
+
+  state["listeners"] = listeners
+  if not listeners:
+    browser_pid = int(state.get("browser_pid") or 0)
+    if browser_pid > 1:
+      _stop_pid(browser_pid)
+    state["browser_pid"] = 0
+  _write_json(STATE_PATH, state)
+  return {"ok": True}
+
+
+def cmd_list_active() -> Dict[str, Any]:
+  state = _read_json(STATE_PATH, {"listeners": {}})
+  if _prune_dead_listeners(state):
+    _write_json(STATE_PATH, state)
+  listeners = state.get("listeners", {})
+  return {"ok": True, "listeners": listeners}
+
+
+def _drain_events_file() -> List[Dict[str, Any]]:
+  if not EVENTS_PATH.exists():
+    return []
+  raw = EVENTS_PATH.read_text(encoding="utf-8")
+  if not raw.strip():
+    return []
+  lines = raw.splitlines()
+  events: List[Dict[str, Any]] = []
+  for line in lines:
+    try:
+      parsed = json.loads(line)
+      if isinstance(parsed, dict):
+        events.append(parsed)
+    except Exception:
+      continue
+  # Clear only after successful read/parse pass so producers can continue
+  # appending without losing events.
+  EVENTS_PATH.write_text("", encoding="utf-8")
+  return events
+
+
+def cmd_poll_events(wait_ms: int = 0) -> Dict[str, Any]:
+  state = _read_json(STATE_PATH, {"listeners": {}})
+  if _prune_dead_listeners(state):
+    _write_json(STATE_PATH, state)
+
+  wait_ms = max(0, int(wait_ms or 0))
+  if wait_ms <= 0:
+    return {"ok": True, "events": _drain_events_file()}
+
+  deadline = time.monotonic() + (wait_ms / 1000.0)
+  while True:
+    events = _drain_events_file()
+    if events:
+      return {"ok": True, "events": events}
+    now = time.monotonic()
+    if now >= deadline:
+      return {"ok": True, "events": []}
+    time.sleep(min(0.1, max(0.01, deadline - now)))
+
+
+def cmd_sync_session(cookies: List[Dict[str, Any]], browser_bin: str = "") -> Dict[str, Any]:
+  _ensure_headless_instance(DEFAULT_PROFILE, browser_bin)
+  state = _read_json(STATE_PATH, {"listeners": {}})
+  listeners = state.get("listeners", {})
+  target_id = ""
+  for _, entry in listeners.items():
+    target_id = str(entry.get("target_id") or "")
+    if target_id:
+      break
+  temp_target = False
+  if not target_id:
+    target = _cdp_create_target("about:blank")
+    target_id = str(target.get("id") or "")
+    temp_target = True
+  if not target_id:
+    raise RuntimeError("No CDP target available for cookie sync")
+
+  ws = WebSocketCDP(_target_ws_url_with_retry(target_id, timeout_sec=3.0))
+  try:
+    ws.call("Network.enable", {})
+    ws.call("Network.setCookies", {"cookies": cookies or []})
+  finally:
+    ws.close()
+    if temp_target:
+      _cdp_close_target(target_id)
+  return {"ok": True, "count": len(cookies or [])}
+
+
+def cmd_capture_screenshot(script_id: str) -> Dict[str, Any]:
+  _validate_script_id(script_id)
+  state = _read_json(STATE_PATH, {"listeners": {}})
+  if _prune_dead_listeners(state):
+    _write_json(STATE_PATH, state)
+  listeners = state.get("listeners", {})
+  entry = listeners.get(script_id)
+  if not isinstance(entry, dict):
+    raise RuntimeError("Listener is not active in headless mode.")
+
+  target_id = str(entry.get("target_id") or "")
+  if not target_id:
+    raise RuntimeError("Headless listener has no active target.")
+
+  ws = WebSocketCDP(_target_ws_url_with_retry(target_id, timeout_sec=4.0))
+  try:
+    ws.call("Page.enable", {})
+    result = ws.call("Page.captureScreenshot", {
+        "format": "png",
+        "fromSurface": True,
+        "captureBeyondViewport": True,
+    })
+  finally:
+    ws.close()
+
+  image_base64 = str(result.get("data") or "")
+  if not image_base64:
+    raise RuntimeError("Page.captureScreenshot returned no image data.")
+
+  ts_ms = _now_ms()
+  screenshot_path = SCREENSHOTS_DIR / f"{script_id}_{ts_ms}.png"
+  try:
+    _ensure_parent(screenshot_path)
+    screenshot_path.write_bytes(base64.b64decode(image_base64))
+  except Exception as exc:
+    raise RuntimeError(f"Failed to persist screenshot: {exc}") from exc
+
+  _append_event({
+      "ts_ms": ts_ms,
+      "action": "screenshot",
+      "listener_script_id": script_id,
+      "detail": "manual_capture",
+      "path": str(screenshot_path),
+  })
+
+  return {
+      "ok": True,
+      "script_id": script_id,
+      "target_id": target_id,
+      "ts_ms": ts_ms,
+      "path": str(screenshot_path),
+      "image_base64": image_base64,
+      "current_url": str(entry.get("current_url") or entry.get("start_url") or ""),
+  }
+
+
+def run_command(command: str,
+                script_id: str = "",
+                profile_dir: Optional[Path] = None,
+                script_path: Optional[Path] = None,
+                cookies: Optional[List[Dict[str, Any]]] = None,
+                browser_bin: str = "",
+                wait_ms: int = 0) -> Dict[str, Any]:
+  profile = profile_dir or DEFAULT_PROFILE
+  if command == "start_headless_listener":
+    return cmd_start_headless_listener(script_id, profile, script_path, browser_bin)
+  if command == "stop_headless_listener":
+    return cmd_stop_headless_listener(script_id)
+  if command == "sync_session":
+    return cmd_sync_session(cookies or [], browser_bin)
+  if command == "list_active":
+    return cmd_list_active()
+  if command == "poll_events":
+    return cmd_poll_events(wait_ms=wait_ms)
+  if command == "capture_screenshot":
+    return cmd_capture_screenshot(script_id)
+  raise RuntimeError(f"Unknown command: {command}")
+
+
+def _read_native_message() -> Optional[Dict[str, Any]]:
+  raw_len = sys.stdin.buffer.read(4)
+  if not raw_len:
+    return None
+  if len(raw_len) < 4:
+    raise RuntimeError("Invalid native message length")
+  msg_len = struct.unpack("<I", raw_len)[0]
+  data = sys.stdin.buffer.read(msg_len)
+  if len(data) != msg_len:
+    raise RuntimeError("Truncated native message")
+  return json.loads(data.decode("utf-8"))
+
+
+def _write_native_message(payload: Dict[str, Any]) -> None:
+  data = json.dumps(payload).encode("utf-8")
+  sys.stdout.buffer.write(struct.pack("<I", len(data)))
+  sys.stdout.buffer.write(data)
+  sys.stdout.buffer.flush()
+
+
+def run_native_loop() -> int:
+  while True:
+    msg = _read_native_message()
+    if msg is None:
+      return 0
+    try:
+      cmd = str(msg.get("type") or "")
+      script_id = str(msg.get("script_id") or msg.get("scriptId") or "")
+      profile_dir = Path(str(msg.get("profile_dir") or DEFAULT_PROFILE))
+      script_path_str = msg.get("script_path")
+      script_path = Path(str(script_path_str)) if script_path_str else None
+      cookies = msg.get("cookies") if isinstance(msg.get("cookies"), list) else []
+      browser_bin = str(msg.get("browser_bin") or "")
+      wait_ms = int(msg.get("wait_ms") or msg.get("waitMs") or 0)
+      result = run_command(
+          cmd,
+          script_id=script_id,
+          profile_dir=profile_dir,
+          script_path=script_path,
+          cookies=cookies,
+          browser_bin=browser_bin,
+          wait_ms=wait_ms,
+      )
+      if "request_id" in msg:
+        result["request_id"] = msg["request_id"]
+      _write_native_message(result)
+    except Exception as e:
+      err = {"ok": False, "error": str(e)}
+      if "request_id" in msg:
+        err["request_id"] = msg["request_id"]
+      _write_native_message(err)
+
+
+def parse_args() -> argparse.Namespace:
+  p = argparse.ArgumentParser()
+  p.add_argument("--command", default="")
+  p.add_argument("--script-id", default="")
+  p.add_argument("--profile-dir", default=str(DEFAULT_PROFILE))
+  p.add_argument("--script-path", default="")
+  p.add_argument("--cookies-json", default="")
+  p.add_argument("--browser-bin", default="")
+  p.add_argument("--wait-ms", default=0, type=int)
+  p.add_argument("--worker", action="store_true")
+  p.add_argument("--target-id", default="")
+  p.add_argument("--listener-config-json", default="")
+  return p.parse_args()
+
+
+def main() -> int:
+  args = parse_args()
+
+  if args.worker:
+    cfg_raw = json.loads(args.listener_config_json or "{}")
+    recent_match_signatures_raw = cfg_raw.get("recent_match_signatures") or []
+    recent_match_signatures: List[str] = []
+    if isinstance(recent_match_signatures_raw, list):
+      for value in recent_match_signatures_raw:
+        if not isinstance(value, str):
+          continue
+        normalized = _normalize_signature_token(value)
+        if not normalized or normalized in recent_match_signatures:
+          continue
+        recent_match_signatures.append(normalized)
+        if len(recent_match_signatures) >= MAX_RECENT_MATCH_SIGNATURES:
+          break
+    cfg = ListenerConfig(
+        script_id=str(cfg_raw.get("script_id") or args.script_id),
+        start_url=str(cfg_raw.get("start_url") or "about:blank"),
+        refresh_seconds=int(cfg_raw.get("refresh_seconds") or 60),
+        auto_refresh=bool(cfg_raw.get("auto_refresh", False)),
+        refresh_jitter=bool(cfg_raw.get("refresh_jitter", True)),
+        extreme_evasion=bool(cfg_raw.get("extreme_evasion", True)),
+        locators=[l for l in (cfg_raw.get("locators") or []) if isinstance(l, dict)],
+        condition=str(cfg_raw.get("condition") or ""),
+        needle=str(cfg_raw.get("needle") or ""),
+        attribute=str(cfg_raw.get("attribute") or ""),
+        on_match_script_id=str(cfg_raw.get("on_match_script_id") or ""),
+        recent_match_signatures=recent_match_signatures,
+        owner_pid=int(cfg_raw.get("owner_pid") or 0),
+    )
+    _worker_loop(cfg.script_id, args.target_id, cfg)
+    return 0
+
+  if args.command:
+    try:
+      cookies = []
+      if args.cookies_json:
+        parsed = json.loads(args.cookies_json)
+        if isinstance(parsed, list):
+          cookies = parsed
+      result = run_command(
+          args.command,
+          script_id=args.script_id,
+          profile_dir=Path(args.profile_dir),
+          script_path=Path(args.script_path) if args.script_path else None,
+          cookies=cookies,
+          browser_bin=args.browser_bin,
+          wait_ms=args.wait_ms,
+      )
+      sys.stdout.write(json.dumps(result))
+      return 0
+    except Exception as e:
+      sys.stdout.write(json.dumps({"ok": False, "error": str(e)}))
+      return 1
+
+  return run_native_loop()
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
