--- /dev/null
+++ b/third_party/blink/renderer/core/agent/agent_state.h
@@ -0,0 +1,56 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_STATE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_STATE_H_
+
+#include <string>
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+namespace blink {
+
+struct AgentElement {
+  int id = 0;
+
+  // DOM metadata
+  std::string frame_token;
+  std::string tag;
+  std::string role;
+  std::string text;
+  std::string accessibility_name;
+  std::string id_attr;
+  std::string class_attr;
+  std::string name_attr;
+  std::string css_selector;
+  std::string xpath;
+  std::string shadow_chain_selector;
+  std::string resource_path;
+
+  // Geometry
+  float x = 0;
+  float y = 0;
+  float width = 0;
+  float height = 0;
+
+  // Interaction flags
+  bool visible = false;
+  bool clickable = false;
+  bool focusable = false;
+  bool editable = false;
+  bool disabled = false;
+  bool has_pointer_events = false;
+  bool in_shadow_tree = false;
+  bool is_target = false;
+
+  int frame_depth = 0;
+};
+
+struct AgentState {
+  Vector<AgentElement> elements;
+
+  float viewport_width = 0;
+  float viewport_height = 0;
+  float scroll_x = 0;
+  float scroll_y = 0;
+};
+
+}  // namespace blink
+
+#endif
diff --git a/third_party/blink/renderer/core/agent/agent_state_extractor.cc b/third_party/blink/renderer/core/agent/agent_state_extractor.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7bff88bdfb6fa4ed0f5c30d5c7f033aa2553760b
--- /dev/null
+++ b/third_party/blink/renderer/core/agent/agent_state_extractor.cc
@@ -0,0 +1,460 @@
+#include "third_party/blink/renderer/core/agent/agent_state_extractor.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "third_party/blink/renderer/core/agent/agent_vectorizer.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/dom/element_traversal.h"
+#include "third_party/blink/renderer/core/dom/shadow_root.h"
+#include "third_party/blink/renderer/core/editing/editing_utilities.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/html_names.h"
+#include "third_party/blink/renderer/core/layout/layout_object.h"
+#include "third_party/blink/renderer/core/paint/paint_layer_scrollable_area.h"
+#include "third_party/blink/public/web/web_frame.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_vector.h"
+#include "third_party/blink/renderer/platform/heap/member.h"
+#include "third_party/blink/renderer/platform/wtf/casting.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "base/containers/flat_set.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+namespace {
+
+namespace html = blink::html_names;
+blink::AgentStateExtractor::Delegate* g_delegate = nullptr;
+
+std::string LowerTagName(const blink::Element& element) {
+  std::string tag = element.tagName().Utf8().data();
+  return base::ToLowerASCII(tag);
+}
+
+std::string BuildShadowChainSelector(blink::Element& element) {
+  std::vector<std::string> segments;
+  blink::Element* current = &element;
+  while (current) {
+    if (auto* root = current->ContainingShadowRoot()) {
+      blink::Element& host = root->host();
+      segments.push_back(LowerTagName(host));
+      current = &host;
+    } else {
+      break;
+    }
+  }
+  if (segments.empty())
+    return std::string();
+  std::reverse(segments.begin(), segments.end());
+  return base::JoinString(segments, " >> ");
+}
+
+int IndexAmongSameTagSiblings(const blink::Element& element) {
+  int index = 1;
+  for (const blink::Element* sibling = blink::ElementTraversal::PreviousSibling(element);
+       sibling; sibling = blink::ElementTraversal::PreviousSibling(*sibling)) {
+    if (sibling->tagName() == element.tagName())
+      ++index;
+  }
+  return index;
+}
+
+bool SafeHasAttribute(const blink::Element& element,
+                      const blink::QualifiedName& name) {
+  // Element::FastHasAttribute DCHECKs for some namespace/name combinations
+  // (e.g. svg/@href). Prefer the general attribute path for safety.
+  return element.hasAttribute(name);
+}
+
+std::string BuildResourcePath(const blink::Element& element) {
+  std::vector<std::string> segments;
+  const blink::Node* node = &element;
+  while (node) {
+    const blink::Element* el = blink::DynamicTo<blink::Element>(node);
+    if (!el)
+      break;
+    std::string tag = LowerTagName(*el);
+    int index = IndexAmongSameTagSiblings(*el);
+    segments.push_back(tag + "[" + base::NumberToString(index) + "]");
+    node = el->ParentOrShadowHostNode();
+  }
+  if (segments.empty())
+    return std::string();
+  std::reverse(segments.begin(), segments.end());
+  return std::string("/") + base::JoinString(segments, "/");
+}
+
+bool IsInterestingElement(const blink::Element& element,
+                          const std::string& lower_role,
+                          const std::string& lower_tag) {
+  // Always drop aria-hidden.
+  if (SafeHasAttribute(element, html::kAriaHiddenAttr))
+    return false;
+
+  // Explicit ARIA role list we care about.
+  static const base::flat_set<std::string>* kInterestingRoles = [] {
+    return new base::flat_set<std::string>({
+        "button", "link", "menuitem", "menuitemcheckbox", "menuitemradio",
+        "checkbox", "radio", "combobox", "textbox", "searchbox", "slider",
+        "switch", "tab", "tablist", "option", "listbox", "treeitem", "img",
+        "image", "heading", "generic", "gridcell"});
+  }();
+
+  if (!lower_role.empty() && kInterestingRoles->contains(lower_role))
+    return true;
+
+  // Tag-based heuristics.
+  if (lower_tag == "button" || lower_tag == "a" ||
+      lower_tag == "select" || lower_tag == "option" ||
+      lower_tag == "textarea" || lower_tag == "input" ||
+      lower_tag == "summary" || lower_tag == "details") {
+    return true;
+  }
+
+  // Data-attribute hooks we know often correspond to actions.
+  if (SafeHasAttribute(element, html::kOnclickAttr))
+    return true;
+
+  return false;
+}
+
+bool ShouldKeepText(const std::string& text,
+                    const std::string& role_or_tag) {
+  if (text.empty())
+    return false;
+  constexpr size_t kMaxLen = 80;
+  if (text.size() <= kMaxLen)
+    return true;
+  // Allow slightly longer text for primary actionable roles.
+  if (role_or_tag == "button" || role_or_tag == "link" ||
+      role_or_tag == "menuitem" || role_or_tag == "tab") {
+    return text.size() <= 140;
+  }
+  return false;
+}
+
+std::string ShortTextForElement(const blink::Element& element,
+                                const std::string& role_or_tag) {
+  std::string raw = element.textContent().Utf8().data();
+  std::string collapsed = base::CollapseWhitespaceASCII(raw, true);
+  if (ShouldKeepText(collapsed, role_or_tag))
+    return collapsed;
+  return std::string();
+}
+
+bool IsDashboardOverlayElement(const blink::Element& element) {
+  const blink::Element* current = &element;
+  while (current) {
+    if (current->GetIdAttribute() == "overlay-root")
+      return true;
+    current = current->ParentOrShadowHostElement();
+  }
+  return false;
+}
+
+}  // namespace
+
+namespace blink {
+
+// static
+void AgentStateExtractor::SetDelegate(Delegate* delegate) {
+  g_delegate = delegate;
+}
+
+AgentState AgentStateExtractor::Extract(WebLocalFrame* frame) {
+  if (!frame)
+    return AgentState();
+  if (Frame* core_frame = WebFrame::ToCoreFrame(*frame)) {
+    if (LocalFrame* local = DynamicTo<LocalFrame>(core_frame))
+      return Extract(local);
+  }
+  return AgentState();
+}
+
+AgentState AgentStateExtractor::ExtractForAction(WebLocalFrame* frame,
+                                                 Element* target,
+                                                 bool subtree_only,
+                                                 bool mark_hovered) {
+  if (!frame)
+    return AgentState();
+  if (Frame* core_frame = WebFrame::ToCoreFrame(*frame)) {
+    if (LocalFrame* local = DynamicTo<LocalFrame>(core_frame))
+      return ExtractForAction(local, target, subtree_only, mark_hovered);
+  }
+  return AgentState();
+}
+
+AgentState AgentStateExtractor::Extract(LocalFrame* frame) {
+  if (g_delegate) {
+    AgentState delegated;
+    if (g_delegate->Extract(frame, &delegated))
+      return delegated;
+  }
+  AgentState state;
+  if (!frame)
+    return state;
+
+  LocalFrameView* view = frame->View();
+  if (view) {
+    gfx::Rect rect = view->FrameRect();
+    state.viewport_width = rect.width();
+    state.viewport_height = rect.height();
+    // Scroll offsets are exposed via LayoutViewport when available.
+    if (auto* viewport = view->LayoutViewport()) {
+      auto offset = viewport->GetWebExposedScrollOffset();
+      state.scroll_x = offset.x();
+      state.scroll_y = offset.y();
+    }
+  }
+
+  Document* doc = frame->GetDocument();
+  if (!doc)
+    return state;
+
+  const std::string frame_token = frame->GetLocalFrameToken().ToString();
+
+  int next_id = 1;
+  for (Element* el = ElementTraversal::FirstWithin(*doc);
+       el; el = ElementTraversal::Next(*el)) {
+    if (!el->GetLayoutObject())
+      continue;
+    if (IsDashboardOverlayElement(*el))
+      continue;
+    std::string tag = LowerTagName(*el);
+    std::string role_attr =
+        base::ToLowerASCII(el->getAttribute(html::kRoleAttr).Utf8().data());
+    if (!IsInterestingElement(*el, role_attr, tag))
+      continue;
+
+    AgentElement item;
+    item.id = next_id++;
+    item.frame_token = frame_token;
+    item.tag = tag;
+    item.role = role_attr.empty() ? tag : role_attr;
+
+    // Accessible-ish name fallback chain.
+    std::string aria_label =
+        base::CollapseWhitespaceASCII(
+            el->getAttribute(html::kAriaLabelAttr).Utf8().data(), true);
+    std::string title_attr =
+        base::CollapseWhitespaceASCII(
+            el->getAttribute(html::kTitleAttr).Utf8().data(), true);
+    std::string alt_attr =
+        base::CollapseWhitespaceASCII(
+            el->getAttribute(html::kAltAttr).Utf8().data(), true);
+
+    if (!aria_label.empty())
+      item.accessibility_name = aria_label;
+    else if (!title_attr.empty())
+      item.accessibility_name = title_attr;
+    else if (!alt_attr.empty())
+      item.accessibility_name = alt_attr;
+
+    std::string short_text =
+        ShortTextForElement(*el, item.role.empty() ? tag : item.role);
+    if (!short_text.empty())
+      item.text = short_text;
+
+    item.id_attr = el->GetIdAttribute().Utf8().data();
+    item.class_attr = el->getAttribute(html::kClassAttr).Utf8().data();
+    item.name_attr = el->getAttribute(html::kNameAttr).Utf8().data();
+
+    gfx::RectF rect = el->GetLayoutObject()->AbsoluteBoundingBoxRectF();
+    item.x = rect.x();
+    item.y = rect.y();
+    item.width = rect.width();
+    item.height = rect.height();
+    item.visible = !rect.IsEmpty();
+    item.editable = IsEditable(*el);
+    item.focusable = el->IsFocusable();
+    bool has_href = SafeHasAttribute(*el, html::kHrefAttr);
+    item.clickable = item.focusable || has_href ||
+                     tag == "button" || tag == "a" ||
+                     SafeHasAttribute(*el, html::kOnclickAttr);
+    item.disabled = false;
+    item.in_shadow_tree = el->IsInShadowTree();
+    item.shadow_chain_selector = BuildShadowChainSelector(*el);
+    item.resource_path = BuildResourcePath(*el);
+
+    if (!item.id_attr.empty()) {
+      item.css_selector = "#" + item.id_attr;
+      item.xpath = "//*[@id='" + item.id_attr + "']";
+    } else if (!item.class_attr.empty()) {
+      std::string css = ".";
+      for (char c : item.class_attr)
+        css += (c == ' ') ? '.' : c;
+      item.css_selector = css;
+      item.xpath = "//" + item.tag;
+    } else {
+      item.css_selector = item.tag;
+      item.xpath = "//" + item.tag;
+    }
+
+    state.elements.push_back(std::move(item));
+    if (next_id > AgentVectorizer::kMaxElements)
+      break;
+  }
+
+  return state;
+}
+
+AgentState AgentStateExtractor::ExtractForAction(LocalFrame* frame,
+                                                 Element* target,
+                                                 bool subtree_only,
+                                                 bool mark_hovered) {
+  if (g_delegate) {
+    AgentState delegated;
+    if (g_delegate->ExtractForAction(frame, target, subtree_only, mark_hovered,
+                                     &delegated)) {
+      return delegated;
+    }
+  }
+  if (!frame || !target)
+    return AgentState();
+
+  AgentState state;
+
+  LocalFrameView* view = frame->View();
+  if (view) {
+    gfx::Rect rect = view->FrameRect();
+    state.viewport_width = rect.width();
+    state.viewport_height = rect.height();
+    if (auto* viewport = view->LayoutViewport()) {
+      auto offset = viewport->GetWebExposedScrollOffset();
+      state.scroll_x = offset.x();
+      state.scroll_y = offset.y();
+    }
+  }
+
+  Document* doc = frame->GetDocument();
+  if (!doc)
+    return state;
+
+  const std::string frame_token = frame->GetLocalFrameToken().ToString();
+
+  HeapVector<Member<Element>> to_visit;
+  auto collect_subtree = [&](Element* root) {
+    if (!root)
+      return;
+    to_visit.push_back(root);
+    for (Element* el = ElementTraversal::FirstWithin(*root); el;
+         el = ElementTraversal::Next(*el)) {
+      to_visit.push_back(el);
+    }
+  };
+
+  // Always include the target subtree.
+  collect_subtree(target);
+
+  // Optionally include ancestors for context.
+  if (!subtree_only) {
+    for (Element* ancestor = target->ParentOrShadowHostElement(); ancestor;
+         ancestor = ancestor->ParentOrShadowHostElement()) {
+      // Avoid duplicates: skip if already in to_visit.
+      bool seen = false;
+      for (const auto& e : to_visit) {
+        if (e.Get() == ancestor) {
+          seen = true;
+          break;
+        }
+      }
+      if (!seen)
+        to_visit.push_back(ancestor);
+    }
+  }
+
+  int next_id = 1;
+  for (const auto& member_el : to_visit) {
+    Element* el = member_el.Get();
+    if (!el || !el->GetLayoutObject())
+      continue;
+    if (IsDashboardOverlayElement(*el))
+      continue;
+
+    std::string tag = LowerTagName(*el);
+    std::string role_attr =
+        base::ToLowerASCII(el->getAttribute(html::kRoleAttr).Utf8().data());
+    if (!IsInterestingElement(*el, role_attr, tag))
+      continue;
+
+    AgentElement item;
+    item.id = next_id++;
+    item.frame_token = frame_token;
+    item.is_target = (el == target);
+    if (mark_hovered && item.is_target)
+      item.has_pointer_events = true;
+
+    item.tag = tag;
+
+    std::string aria_label =
+        base::CollapseWhitespaceASCII(
+            el->getAttribute(html::kAriaLabelAttr).Utf8().data(), true);
+    std::string title_attr =
+        base::CollapseWhitespaceASCII(
+            el->getAttribute(html::kTitleAttr).Utf8().data(), true);
+    std::string alt_attr =
+        base::CollapseWhitespaceASCII(
+            el->getAttribute(html::kAltAttr).Utf8().data(), true);
+
+    if (!aria_label.empty())
+      item.accessibility_name = aria_label;
+    else if (!title_attr.empty())
+      item.accessibility_name = title_attr;
+    else if (!alt_attr.empty())
+      item.accessibility_name = alt_attr;
+
+    std::string short_text =
+        ShortTextForElement(*el, role_attr.empty() ? tag : role_attr);
+    if (!short_text.empty())
+      item.text = short_text;
+    item.id_attr = el->GetIdAttribute().Utf8().data();
+    item.class_attr = el->getAttribute(html::kClassAttr).Utf8().data();
+    item.name_attr = el->getAttribute(html::kNameAttr).Utf8().data();
+    item.role = role_attr.empty() ? tag : role_attr;
+
+    gfx::RectF rect = el->GetLayoutObject()->AbsoluteBoundingBoxRectF();
+    item.x = rect.x();
+    item.y = rect.y();
+    item.width = rect.width();
+    item.height = rect.height();
+
+    item.focusable = el->IsFocusable();
+    bool has_href = SafeHasAttribute(*el, html::kHrefAttr);
+    item.clickable = item.focusable || has_href || tag == "button" ||
+                     tag == "a" ||
+                     SafeHasAttribute(*el, html::kOnclickAttr);
+    item.visible = !rect.IsEmpty();
+    item.editable = IsEditable(*el);
+    item.disabled = false;
+    item.in_shadow_tree = el->IsInShadowTree();
+    item.shadow_chain_selector = BuildShadowChainSelector(*el);
+    item.resource_path = BuildResourcePath(*el);
+
+    if (!item.id_attr.empty()) {
+      item.css_selector = "#" + item.id_attr;
+      item.xpath = "//*[@id='" + item.id_attr + "']";
+    } else if (!item.class_attr.empty()) {
+      std::string css = ".";
+      for (char c : item.class_attr)
+        css += (c == ' ') ? '.' : c;
+      item.css_selector = css;
+      item.xpath = "//" + String(el->tagName()).LowerASCII().Utf8();
+    } else {
+      item.css_selector = String(el->tagName()).LowerASCII().Utf8();
+      item.xpath = "//" + item.css_selector;
+    }
+
+    state.elements.push_back(std::move(item));
+    if (next_id > AgentVectorizer::kMaxElements)
+      break;
+  }
+
+  return state;
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/core/agent/agent_state_extractor.h b/third_party/blink/renderer/core/agent/agent_state_extractor.h
new file mode 100644
index 0000000000000000000000000000000000000000..b23430a9b16808eb5b8b29efbd272edabbd27544
--- /dev/null
+++ b/third_party/blink/renderer/core/agent/agent_state_extractor.h
@@ -0,0 +1,52 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_STATE_EXTRACTOR_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_AGENT_AGENT_STATE_EXTRACTOR_H_
+
+#include "base/functional/callback.h"
+#include "third_party/blink/renderer/core/agent/agent_state.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+class LocalFrame;
+class Element;
+class WebLocalFrame;
+
+class CORE_EXPORT AgentStateExtractor {
+ public:
+  // Delegate interface implemented in blink_modules to supply AX-based
+  // snapshots without introducing a layering dependency from core on modules.
+  class Delegate {
+   public:
+    virtual ~Delegate() = default;
+    virtual bool Extract(LocalFrame* frame, AgentState* out) = 0;
+    virtual bool ExtractForAction(LocalFrame* frame,
+                                  Element* target,
+                                  bool subtree_only,
+                                  bool mark_hovered,
+                                  AgentState* out) = 0;
+  };
+
+  // Registration is optional; when null, the extractor falls back to its
+  // DOM-based implementation.
+  static void SetDelegate(Delegate* delegate);
+
+  // Public overloads for embedders that only have access to WebLocalFrame.
+  static AgentState Extract(WebLocalFrame* frame);
+  static AgentState ExtractForAction(WebLocalFrame* frame,
+                                     Element* target,
+                                     bool subtree_only = true,
+                                     bool mark_hovered = false);
+
+  static AgentState Extract(LocalFrame* frame);
+  // Targeted extraction used by action logging: restricts traversal to the
+  // target element (and its subtree), marking it as the action target. When
+  // subtree_only is false, ancestors of |target| are also included for context.
+  static AgentState ExtractForAction(LocalFrame* frame,
+                                     Element* target,
+                                     bool subtree_only = true,
+                                     bool mark_hovered = false);
+};
+
+}  // namespace blink
+
+#endif
diff --git a/third_party/blink/renderer/core/agent/agent_vectorizer.cc b/third_party/blink/renderer/core/agent/agent_vectorizer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..bbd87b7a9a939492f98c8c5ab0c969725d63e862
--- /dev/null
+++ b/third_party/blink/renderer/core/agent/agent_vectorizer.cc
@@ -0,0 +1,64 @@
+// Simple featureizer for AgentState -> flat float vector.
+#include "third_party/blink/renderer/core/agent/agent_vectorizer.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace blink {
+
+float AgentVectorizer::HashString(const std::string& s, float range) {
+  uint32_t h = 2166136261u;
+  for (unsigned char c : s)
+    h = (h ^ c) * 16777619u;
+  return static_cast<float>(h % 1024) / 1024.0f * range;
+}
+
+void AgentVectorizer::VectorizeOne(const AgentElement& e,
+                                   Vector<float>& out,
+                                   int base,
+                                   float vpw,
+                                   float vph) {
+  int idx = 0;
+  auto put = [&](float v) { out[base + idx++] = v; };
+
+  put(vpw > 0 ? e.x / vpw : 0.0f);
+  put(vph > 0 ? e.y / vph : 0.0f);
+  put(vpw > 0 ? e.width / vpw : 0.0f);
+  put(vph > 0 ? e.height / vph : 0.0f);
+  put(static_cast<float>(e.frame_depth) / 4.0f);
+
+  put(e.visible ? 1.0f : 0.0f);
+  put(e.clickable ? 1.0f : 0.0f);
+  put(e.focusable ? 1.0f : 0.0f);
+  put(e.editable ? 1.0f : 0.0f);
+  put(e.disabled ? 1.0f : 0.0f);
+  put(e.has_pointer_events ? 1.0f : 0.0f);
+  put(e.in_shadow_tree ? 1.0f : 0.0f);
+
+  // Hash categorical fields into [0,1].
+  put(HashString(e.tag));
+  put(HashString(e.role));
+  put(HashString(e.class_attr));
+  put(HashString(e.id_attr));
+  put(HashString(e.name_attr));
+
+  // Pad remaining dims with zeros.
+  while (idx < kFeatureDim)
+    put(0.0f);
+}
+
+Vector<float> AgentVectorizer::Vectorize(const AgentState& state) {
+  Vector<float> out;
+  out.resize(kMaxElements * kFeatureDim);
+  std::fill(out.begin(), out.end(), 0.0f);
+
+    const int count = std::min(static_cast<int>(state.elements.size()),
+                               kMaxElements);
+  for (int i = 0; i < count; ++i) {
+    VectorizeOne(state.elements[i], out, i * kFeatureDim, state.viewport_width,
+                 state.viewport_height);
+  }
+  return out;
+}
+
+}  // namespace blink
