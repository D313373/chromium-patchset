+function sanitizeUnsignedInteger(
+    value: number|undefined, defaultValue: number,
+    maxValue = Number.MAX_SAFE_INTEGER): number {
+  if (value === undefined) {
+    return defaultValue;
+  }
+  if (!Number.isFinite(value)) {
+    return defaultValue;
+  }
+  const normalized = Math.floor(value);
+  if (normalized <= 0) {
+    return 0;
+  }
+  return Math.min(maxValue, normalized);
+}
