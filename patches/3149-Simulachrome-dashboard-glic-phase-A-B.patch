+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_FAILURE_REPLAY_RECORDER_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_FAILURE_REPLAY_RECORDER_H_
+
+#include <deque>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace viz {
+struct CopyOutputBitmapWithMetadata;
+}  // namespace viz
+
+namespace content {
+class RenderWidgetHostView;
+class WebContents;
+}  // namespace content
+
+namespace dashboard {
+
+// Captures a small ring-buffer "replay" of the most recent frames (PNG) from a
+// WebContents. Frames are only written to disk on failure.
+class FailureReplayRecorder : public content::WebContentsObserver {
+ public:
+  explicit FailureReplayRecorder(content::WebContents* web_contents);
+  ~FailureReplayRecorder() override;
+
+  FailureReplayRecorder(const FailureReplayRecorder&) = delete;
+  FailureReplayRecorder& operator=(const FailureReplayRecorder&) = delete;
+
+  void Start(int fps, base::TimeDelta max_duration);
+  void Stop();
+
+  bool HasFrames() const;
+
+  // Writes:
+  //   replay_dir/manifest.json
+  //   replay_dir/frame_000.png ...
+  //
+  // Returns true on success. On failure, |error| (if non-null) contains a
+  // human-readable description.
+  bool SaveToDisk(const base::FilePath& replay_dir, std::string* error);
+
+  // content::WebContentsObserver:
+ void WebContentsDestroyed() override;
+
+ private:
+  struct Frame {
+    Frame();
+    Frame(Frame&&);
+    Frame& operator=(Frame&&);
+    ~Frame();
+
+    Frame(const Frame&) = delete;
+    Frame& operator=(const Frame&) = delete;
+
+    base::TimeTicks captured_at;
+    gfx::Size size_px;
+    std::vector<uint8_t> png_bytes;
+  };
+
+  void CaptureTick();
+  gfx::Size ComputeOutputSize(content::RenderWidgetHostView* view) const;
+  void OnCaptureResult(const viz::CopyOutputBitmapWithMetadata& result);
+
+  int fps_ = 0;
+  base::TimeDelta max_duration_;
+  size_t max_frames_ = 0;
+
+  base::RepeatingTimer timer_;
+  bool capture_in_flight_ = false;
+
+  base::TimeTicks started_at_;
+  std::deque<Frame> frames_;
+
+  base::WeakPtrFactory<FailureReplayRecorder> weak_factory_{this};
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_FAILURE_REPLAY_RECORDER_H_
