diff --git a/chrome/browser/resources/dashboard/agent/recorder_bridge.js b/chrome/browser/resources/dashboard/agent/recorder_bridge.js
new file mode 100644
index 0000000000000000000000000000000000000000..cb0c4c09d9c9a2d962c68ba9218cc4ac0cb0184c
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/recorder_bridge.js
@@ -0,0 +1,330 @@
+export function registerDashboardRecorderBridge({
+  windowRef = window,
+  insertAction,
+  saveScript,
+  getCurrentScriptId,
+  getLoopProfile,
+  normalizeLoopProfile,
+  sendMessageWithCallback,
+}) {
+  if (!windowRef || typeof windowRef !== 'object') {
+    return null;
+  }
+
+  const sendWithCallback = (message, args = [], timeoutMs = 35000) => {
+    if (typeof sendMessageWithCallback === 'function') {
+      return sendMessageWithCallback(message, args, timeoutMs);
+    }
+    return new Promise((resolve) => {
+      const cb = `dashBridgeCb_${Date.now()}_${Math.random().toString(36).slice(2)}`;
+      let settled = false;
+      const finish = (payload) => {
+        if (settled)
+          return;
+        settled = true;
+        try {
+          delete windowRef[cb];
+        } catch (_) {}
+        resolve(payload && typeof payload === 'object' ? payload : {ok: false});
+      };
+      windowRef[cb] = (payload) => finish(payload);
+      try {
+        const sender = windowRef && windowRef.chrome
+          ? windowRef.chrome.send
+          : null;
+        if (typeof sender !== 'function') {
+          finish({ok: false, error: 'chrome.send_unavailable'});
+          return;
+        }
+        sender.call(windowRef.chrome, message, [cb, ...args]);
+      } catch (e) {
+        finish({ok: false, error: String(e && e.message ? e.message : e)});
+        return;
+      }
+      windowRef.setTimeout(() => {
+        finish({ok: false, error: 'timeout'});
+      }, timeoutMs);
+    });
+  };
+
+  windowRef.dashboardAgentRecordAction = async function(payload = {}) {
+    const sourcePayload =
+        (payload && typeof payload === 'object') ? payload : {};
+    const action = sourcePayload.action || sourcePayload.timeline_action ||
+        sourcePayload;
+
+    const inserted = insertAction(action);
+    if (!inserted || inserted.ok === false) {
+      return inserted || {ok: false, error: 'record_insert_failed'};
+    }
+
+    const save = sourcePayload.save !== false;
+    let saved = false;
+    if (save) {
+      try {
+        const sid = inserted.scriptId || getCurrentScriptId() || '';
+        saved = !!(await saveScript(
+            sid, {silent: true, refreshAfter: false}));
+      } catch (e) {
+        return {
+          ok: false,
+          script_id: inserted.scriptId || '',
+          index: inserted.index,
+          error: String(e && e.message ? e.message : e),
+        };
+      }
+    }
+
+    return {
+      ok: true,
+      script_id: inserted.scriptId || '',
+      index: inserted.index,
+      saved,
+    };
+  };
+
+  windowRef.__dashboardGlicRecorderBridge =
+      windowRef.__dashboardGlicRecorderBridge || {};
+  windowRef.__dashboardGlicRecorderBridge.recordAction = function(payload = {}) {
+    return windowRef.dashboardAgentRecordAction(payload);
+  };
+  windowRef.__dashboardGlicRecorderBridge.saveCurrentScript = function() {
+    const sid = getCurrentScriptId() || '';
+    return saveScript(sid, {silent: true, refreshAfter: false});
+  };
+  windowRef.__dashboardGlicRecorderBridge.executeAction = async function(
+      payload = {}) {
+    const sourcePayload =
+        (payload && typeof payload === 'object') ? payload : {};
+    let actionName = '';
+    let params = {};
+    if (typeof sourcePayload.action === 'string') {
+      actionName = sourcePayload.action;
+      params = (sourcePayload.params && typeof sourcePayload.params === 'object')
+        ? sourcePayload.params
+        : {};
+    } else if (sourcePayload.action && typeof sourcePayload.action === 'object') {
+      actionName = String(sourcePayload.action.action || '').trim();
+      params = (sourcePayload.action.params &&
+                typeof sourcePayload.action.params === 'object')
+        ? sourcePayload.action.params
+        : {};
+    }
+    if (!actionName) {
+      return {ok: false, error: 'missing_action'};
+    }
+    return sendWithCallback(
+        'dashboardAgentCallAction',
+        [actionName, params],
+        60000);
+  };
+  windowRef.__dashboardGlicRecorderBridge.getLoopProfile = function() {
+    const current = (typeof getLoopProfile === 'function')
+      ? getLoopProfile()
+      : '';
+    return (typeof normalizeLoopProfile === 'function')
+      ? normalizeLoopProfile(current)
+      : current;
+  };
+
+  return windowRef.dashboardAgentRecordAction;
+}
+
+export function installDashboardLocatorCaptureBridge({
+  windowRef = window,
+  documentRef = document,
+  sendMessageWithCallback,
+  extractCapturedLocatorsFromPayload,
+  copyTextToClipboardBestEffort,
+  setLocatorCaptureButtonsBusy,
+  alertFn = (msg) => alert(msg),
+}) {
+  let sequence = 0;
+  let pollInFlight = false;
+  let primeInFlight = false;
+  let pollTimer = 0;
+  let failureStreak = 0;
+  let disposed = false;
+
+  const clearPollTimer = () => {
+    if (pollTimer) {
+      windowRef.clearTimeout(pollTimer);
+      pollTimer = 0;
+    }
+  };
+
+  const hasArmedEditor = () => {
+    const bridge = windowRef.dashboardLocatorCapture;
+    return !!(bridge &&
+              typeof bridge.hasArmedEditor === 'function' &&
+              bridge.hasArmedEditor());
+  };
+
+  const computeNextDelayMs = ({hadCapture = false, hadError = false} = {}) => {
+    if (hadCapture) {
+      failureStreak = 0;
+      return 100;
+    }
+    if (hadError) {
+      failureStreak = Math.min(failureStreak + 1, 6);
+    } else {
+      failureStreak = 0;
+    }
+    const base = documentRef.hidden ? 1400 : 450;
+    return Math.min(4000, Math.round(base * Math.pow(1.6, failureStreak)));
+  };
+
+  const scheduleNextPoll = (delayMs) => {
+    if (disposed) return;
+    clearPollTimer();
+    pollTimer = windowRef.setTimeout(() => {
+      pollTimer = 0;
+      void pollForExternalCapture();
+    }, Math.max(0, Number(delayMs) || 0));
+  };
+
+  const updateSequenceFromResponse = (response) => {
+    const seqNum = Number(response?.sequence);
+    if (Number.isFinite(seqNum) && seqNum > sequence) {
+      sequence = seqNum;
+    }
+  };
+
+  const copyFallbackLocators = async (locators) => {
+    const payload = JSON.stringify(locators, null, 2);
+    const copied = await copyTextToClipboardBestEffort(payload);
+    if (!copied) {
+      windowRef.__lastCapturedLocators = locators;
+    }
+  };
+
+  const primeSequence = async () => {
+    if (primeInFlight || disposed) return;
+    primeInFlight = true;
+    try {
+      const response = await sendMessageWithCallback(
+          'dashboardPollLocatorCapture', [sequence], 8000);
+      if (response && response.ok) {
+        updateSequenceFromResponse(response);
+      }
+    } catch (_) {
+    } finally {
+      primeInFlight = false;
+    }
+  };
+
+  const pollForExternalCapture = async () => {
+    if (disposed || pollInFlight) return;
+    if (!hasArmedEditor()) {
+      clearPollTimer();
+      return;
+    }
+
+    pollInFlight = true;
+    let hadCapture = false;
+    let hadError = false;
+    try {
+      const response = await sendMessageWithCallback(
+          'dashboardPollLocatorCapture', [sequence], 8000);
+      if (!response || !response.ok) {
+        hadError = true;
+        return;
+      }
+
+      updateSequenceFromResponse(response);
+      if (!response.hasCapture || !response.result ||
+          typeof response.result !== 'object') {
+        return;
+      }
+
+      const locators = extractCapturedLocatorsFromPayload(response);
+      if (!locators.length) {
+        return;
+      }
+      hadCapture = true;
+
+      const bridge = windowRef.dashboardLocatorCapture;
+      const applied = bridge &&
+          typeof bridge.applyCapturedLocators === 'function'
+        ? bridge.applyCapturedLocators(locators, {mode: 'replace'})
+        : {ok: false};
+      if (!applied || !applied.ok) {
+        await copyFallbackLocators(locators);
+      }
+    } catch (_) {
+      hadError = true;
+    } finally {
+      pollInFlight = false;
+      if (hasArmedEditor()) {
+        scheduleNextPoll(computeNextDelayMs({hadCapture, hadError}));
+      } else {
+        clearPollTimer();
+      }
+    }
+  };
+
+  windowRef.dashboardStartLocatorCapture = async function(source = 'ui') {
+    setLocatorCaptureButtonsBusy(true);
+    try {
+      const response = await sendMessageWithCallback(
+          'dashboardArmLocatorCapture', [String(source || 'ui')]);
+      if (!response || !response.ok) {
+        const error = String(response?.error || 'locator_capture_failed');
+        alertFn(`Locator capture failed: ${error}`);
+        return {ok: false, error};
+      }
+
+      updateSequenceFromResponse(response);
+      const locators = extractCapturedLocatorsFromPayload(response);
+      if (!locators.length) {
+        alertFn('No locators were captured from the clicked element.');
+        return {ok: false, error: 'empty_locators'};
+      }
+
+      const bridge = windowRef.dashboardLocatorCapture;
+      const applied = bridge && typeof bridge.applyCapturedLocators === 'function'
+        ? bridge.applyCapturedLocators(locators, {mode: 'replace'})
+        : {ok: false};
+      if (applied && applied.ok) {
+        return {ok: true, mode: 'editor', count: locators.length};
+      }
+
+      const payload = JSON.stringify(locators, null, 2);
+      const copied = await copyTextToClipboardBestEffort(payload);
+      if (copied) {
+        alertFn('Captured locators copied to clipboard. Arm a locator editor and try again to inject directly.');
+      } else {
+        alertFn('Captured locators (clipboard unavailable). Open console and use window.__lastCapturedLocators.');
+        windowRef.__lastCapturedLocators = locators;
+      }
+      return {ok: true, mode: 'clipboard', count: locators.length};
+    } finally {
+      setLocatorCaptureButtonsBusy(false);
+    }
+  };
+
+  windowRef.dashboardNotifyLocatorCaptureArmed = function() {
+    void primeSequence();
+    scheduleNextPoll(0);
+  };
+
+  const onVisibilityOrFocus = () => {
+    if (disposed) return;
+    if (hasArmedEditor()) {
+      scheduleNextPoll(120);
+    }
+  };
+  documentRef.addEventListener('visibilitychange', onVisibilityOrFocus);
+  windowRef.addEventListener('focus', onVisibilityOrFocus);
+  void primeSequence();
+
+  return {
+    dispose() {
+      if (disposed) return;
+      disposed = true;
+      clearPollTimer();
+      documentRef.removeEventListener('visibilitychange', onVisibilityOrFocus);
+      windowRef.removeEventListener('focus', onVisibilityOrFocus);
+    },
+  };
+}
diff --git a/chrome/browser/resources/dashboard/agent/script/dashboard_script_queue_controller.js b/chrome/browser/resources/dashboard/agent/script/dashboard_script_queue_controller.js
