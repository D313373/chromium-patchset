+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_RUN_HISTORY_STORE_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_RUN_HISTORY_STORE_H_
+
+#include <cstddef>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+class Profile;
+
+namespace dashboard {
+
+// Lightweight persistence for script run summaries and (optionally) per-run
+// detailed traces. This is intended for the Dashboard "Debugging" tab.
+class RunHistoryStore {
+ public:
+  // Base directory for run history data.
+  static base::FilePath RunsDir(Profile* profile);
+
+  // Append a run summary to the index (JSONL).
+  // |summary| must contain at least: run_id, script_id, started_ms, ended_ms,
+  // status.
+  static bool AppendSummary(Profile* profile, const base::Value::Dict& summary);
+
+  // Read summaries in [from, to]. Returned list is newest-first and limited.
+  static base::Value::List ReadSummaries(Profile* profile,
+                                         base::Time from,
+                                         base::Time to,
+                                         size_t limit);
+
+  // Append a listener trigger event (JSONL).
+  // |event| should contain at least: ts_ms, listener_script_id, trigger_script_id.
+  static bool AppendListenerEvent(Profile* profile, const base::Value::Dict& event);
+
+  // Read listener trigger events in [from, to]. Returned list is newest-first.
+  static base::Value::List ReadListenerEvents(Profile* profile,
+                                              base::Time from,
+                                              base::Time to,
+                                              size_t limit);
+
+  // Write a per-run details JSON file.
+  static bool WriteRunDetail(Profile* profile,
+                             const std::string& run_id,
+                             const base::Value::Dict& detail);
+
+  // Read a per-run details JSON file into |out|. Returns true on success.
+  static bool ReadRunDetail(Profile* profile,
+                            const std::string& run_id,
+                            base::Value::Dict* out);
+
+ private:
+  static base::FilePath IndexPath(Profile* profile);
+  static base::FilePath DetailPath(Profile* profile, const std::string& run_id);
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_RUN_HISTORY_STORE_H_
