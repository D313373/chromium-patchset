+              const overlayState = window[overlayKey] || (window[overlayKey] = {
+                enabled: false,
+                root: null,
+                hover: null,
+                prediction: null,
+                selected: null,
+                tip: null,
+                selectedBoxMap: new Map(),
+                selectedNodeMap: new Map(),
+                pendingSelectionPayload: null,
+                nextNodeToken: 0,
+              });
+
+              const escCss = function(value) {
+                const raw = String(value || '');
+                try {
+                  if (window.CSS && typeof window.CSS.escape === 'function') {
+                    return window.CSS.escape(raw);
+                  }
+                } catch (_) {}
+                return raw.replace(/[^a-zA-Z0-9_-]/g, '\\$&');
