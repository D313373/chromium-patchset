@@ -0,0 +1,58 @@
+#!/bin/bash
+# Build Chromium if needed, launch the Glic dev environment, run one Dashboard
+# script noninteractively, print changed scrape outputs, and exit.
+
+set -euo pipefail
+
+SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
+CHROME_DIR="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
+SRC_DIR="$(cd "$CHROME_DIR/.." && pwd)"
+
+OUT_DIR="${OUT_DIR:-$SRC_DIR/out/Default}"
+SCRIPT_NAME="${SCRIPT_NAME:-devon1}"
+RUN_TIMEOUT_SEC="${RUN_TIMEOUT_SEC:-600}"
+SCRIPT_ITERATIONS="${SCRIPT_ITERATIONS:-1}"
+SKIP_BUILD=0
+START_ARGS=()
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --script)
+      SCRIPT_NAME="$2"
+      shift 2
+      ;;
+    --iterations)
+      SCRIPT_ITERATIONS="$2"
+      shift 2
+      ;;
+    --timeout-sec)
+      RUN_TIMEOUT_SEC="$2"
+      shift 2
+      ;;
+    --outdir|-C)
+      OUT_DIR="$2"
+      shift 2
+      ;;
+    --nobuild|-n)
+      SKIP_BUILD=1
+      shift
+      ;;
+    *)
+      START_ARGS+=("$1")
+      shift
+      ;;
+  esac
+done
+
+if [[ "$SKIP_BUILD" != "1" ]]; then
+  echo "Building Chromium in $OUT_DIR"
+  autoninja -C "$OUT_DIR" chrome
+fi
+
+"$SCRIPT_DIR/start_glic_dev.sh" \
+  --outdir "$OUT_DIR" \
+  --run-dashboard-script "$SCRIPT_NAME" \
+  --dashboard-script-iterations "$SCRIPT_ITERATIONS" \
+  --dashboard-script-timeout-sec "$RUN_TIMEOUT_SEC" \
+  --exit-after-dashboard-script \
+  "${START_ARGS[@]:+${START_ARGS[@]}}"
