+content::WebContents* ResolveLiveHeadlessTaskWebContents(
+    HeadlessTaskState* state) {
+  if (!state || !state->browser || !state->web_contents) {
+    return nullptr;
+  }
+  TabStripModel* tabs = state->browser->tab_strip_model();
+  if (!tabs) {
+    return nullptr;
+  }
+  if (tabs->GetIndexOfWebContents(state->web_contents) < 0) {
+    return nullptr;
+  }
+  return state->web_contents;
+}
