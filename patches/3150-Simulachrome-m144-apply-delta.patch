+            try {
+              const s = window[key];
+              if (!s || !s.enabled || !e || e.defaultPrevented) return;
+              if (isGlicUiTarget(e)) {
+                return;
+              }
+              if (typeof e.button === 'number' && e.button !== 0) return;
+              const event_type = String(e.type || '');
+              const t = e.target && e.target.closest ? e.target.closest('a[href]') : null;
+              if (!t) return;
+              const href = String(t.href || t.getAttribute('href') || '').trim();
+              if (!href || href.startsWith('javascript:') || href.startsWith('#')) return;
+              const block_all = !!s.blockAllAnchorNavigation;
