+                if (tag === 'input' || tag === 'textarea' || tag === 'select') score += 120;
+                if (id) {
+                  score += 80;
+                  if (count('#' + id) === 1) score += 20;
+                }
+                if (name) {
+                  score += 60;
+                  if (count('[name="' + esc(name) + '"]') === 1) score += 15;
+                }
+                if (tag === 'textarea' && count('textarea') === 1) score += 40;
+                if (tag === 'input' && count('input') === 1) score += 20;
+                if (tag === 'label') score += 10;
