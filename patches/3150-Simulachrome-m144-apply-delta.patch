+base::Value::Dict ExtractProbeAxMetadata(const base::Value::List* nodes,
+                                         int backend_node_id) {
+  base::Value::Dict out;
+  if (!nodes) {
+    return out;
+  }
+
+  struct AxNodeSummary {
+    std::string id;
+    std::string parent_id;
+    int backend_id = -1;
+    std::string role;
+    std::string name;
+    bool ignored = false;
+  };
+
+  std::map<std::string, AxNodeSummary> by_id;
+  std::vector<std::string> order;
+  std::optional<std::string> target_id;
+
+  for (const base::Value& value : *nodes) {
+    const base::Value::Dict* node = value.GetIfDict();
+    if (!node) {
+      continue;
+    }
+    AxNodeSummary summary;
+    if (const std::string* id = node->FindString("nodeId")) {
+      summary.id = *id;
+    } else if (const base::Value* id_value = node->Find("nodeId")) {
+      if (id_value->is_int()) {
+        summary.id = base::NumberToString(id_value->GetInt());
+      } else if (id_value->is_double()) {
+        summary.id = base::NumberToString(
+            static_cast<int>(id_value->GetDouble()));
+      }
+    }
+    if (summary.id.empty()) {
+      continue;
+    }
+    if (const std::string* parent = node->FindString("parentId")) {
+      summary.parent_id = *parent;
+    } else if (const base::Value* parent_value = node->Find("parentId")) {
+      if (parent_value->is_int()) {
+        summary.parent_id = base::NumberToString(parent_value->GetInt());
+      } else if (parent_value->is_double()) {
+        summary.parent_id = base::NumberToString(
+            static_cast<int>(parent_value->GetDouble()));
+      }
+    }
+    summary.backend_id =
+        node->FindInt("backendDOMNodeId")
+            .value_or(node->FindInt("backendNodeId").value_or(-1));
+    summary.role = NormalizeAxRoleString(ReadNestedStringValue(*node, "role"));
+    summary.name = ReadNestedStringValue(*node, "name");
+    summary.ignored = node->FindBool("ignored").value_or(false);
+    if (summary.backend_id == backend_node_id && !target_id.has_value()) {
+      target_id = summary.id;
+    }
+    order.push_back(summary.id);
+    by_id.emplace(summary.id, std::move(summary));
+  }
+
+  if (!target_id.has_value()) {
+    for (const std::string& id : order) {
+      const auto it = by_id.find(id);
+      if (it == by_id.end() || it->second.ignored) {
+        continue;
+      }
+      if (!it->second.role.empty() || !it->second.name.empty()) {
+        target_id = id;
+        break;
+      }
+    }
+  }
+  if (!target_id.has_value()) {
+    return out;
+  }
+
+  const AxNodeSummary* target = nullptr;
+  auto target_it = by_id.find(*target_id);
+  if (target_it != by_id.end()) {
+    target = &target_it->second;
+  }
+  if (!target) {
+    return out;
+  }
+
+  if (!target->role.empty()) {
+    out.Set("ax_role", target->role);
+  }
+  if (!target->name.empty()) {
+    out.Set("ax_name", target->name);
+  }
+  if (target->backend_id > 0) {
+    out.Set("backend_node_id", target->backend_id);
+  }
+
+  std::string current_id = target->parent_id;
+  while (!current_id.empty()) {
+    auto it = by_id.find(current_id);
+    if (it == by_id.end()) {
+      break;
+    }
+    if (IsInteractiveAxRole(it->second.role)) {
+      out.Set("interactive_ancestor_role", it->second.role);
+      break;
+    }
+    current_id = it->second.parent_id;
+  }
+
+  return out;
+}
