+-window.verifyAgentSelectorUniqueness = function(locator) {
+-  const type = String(locator?.type || '').toUpperCase();
+-  const value = String(locator?.value || '');
+-  if (!value || (type !== 'CSS_SELECTOR' && type !== 'XPATH')) {
+-    return Promise.resolve({
+-      ok: false,
+-      unique: false,
+-      count: -1,
+-      error: 'Unsupported selector locator type',
+-    });
+-  }
+-
+-  const expression = String.raw`(function(type,value){
+-    try{
+-      let count = 0;
+-      if (type === 'CSS_SELECTOR') {
+-        count = document.querySelectorAll(value).length;
+-      } else if (type === 'XPATH') {
+-        const res = document.evaluate(
+-          value,
+-          document,
+-          null,
+-          XPathResult.ORDERED_NODE_SNAPSHOT_TYPE,
+-          null);
+-        count = res ? res.snapshotLength : 0;
+-      } else {
+-        return JSON.stringify({error:'unsupported_type'});
+-      }
+-      return JSON.stringify({count});
+-    }catch(e){
+-      return JSON.stringify({error: String(e && e.message ? e.message : e)});
+-    }
+-  })(${JSON.stringify(type)}, ${JSON.stringify(value)})`;
+-
+-  return new Promise((resolve) => {
+-    const cb = 'dashSelUniq_' + Date.now() + Math.random().toString(36).slice(2);
+-    window[cb] = (res) => {
+-      try { delete window[cb]; } catch (_) {}
+-
+-      let count = null;
+-      const parseCandidates = [];
+-      if (typeof res === 'string') parseCandidates.push(res);
+-      if (typeof res?.result === 'string') parseCandidates.push(res.result);
+-      if (typeof res?.value === 'string') parseCandidates.push(res.value);
+-      if (typeof res?.result?.value === 'string') parseCandidates.push(res.result.value);
+-
+-      for (const candidate of parseCandidates) {
+-        try {
+-          const parsed = JSON.parse(candidate);
+-          if (typeof parsed?.count === 'number') {
+-            count = parsed.count;
+-            break;
+-          }
+-          if (typeof parsed?.result?.value === 'number') {
+-            count = parsed.result.value;
+-            break;
+-          }
+-          if (typeof parsed?.value === 'number') {
+-            count = parsed.value;
+-            break;
+-          }
+-        } catch (_) {
+-          const asNum = Number(candidate);
+-          if (Number.isFinite(asNum)) {
+-            count = asNum;
+-            break;
+-          }
+-        }
+-      }
+-
+-      if (!Number.isFinite(count)) {
+-        resolve({
+-          ok: false,
+-          unique: false,
+-          count: -1,
+-          error: 'Unable to parse selector count from probe result',
+-        });
+-        return;
+-      }
+-
+-      resolve({
+-        ok: true,
+-        unique: count === 1,
+-        count,
+-        error: '',
+-      });
+-    };
+-    try {
+-      chrome.send('dashboardAgentEval', [cb, expression]);
+-    } catch (e) {
+-      try { delete window[cb]; } catch (_) {}
+-      resolve({
+-        ok: false,
+-        unique: false,
+-        count: -1,
+-        error: String(e),
+-      });
+-    }
+-  });
+-};
