+
+void LoopAction::OnCssSelectorQueryFallbackReady(const std::string& reason,
+                                                 bool success,
+                                                 const std::string& error,
+                                                 base::Value::Dict result) {
+  if (!success) {
+    Complete(false, error.empty() ? reason : error);
+    return;
+  }
+  const base::Value::Dict* runtime_result = result.FindDict("result");
+  const base::Value* value = runtime_result ? runtime_result->Find("value") : nullptr;
+  const base::Value::Dict* value_dict = value ? value->GetIfDict() : nullptr;
+  const base::Value::List* targets = value_dict ? value_dict->FindList("targets")
+                                                : nullptr;
+  for_each_targets_.clear();
+  if (targets) {
+    for (const auto& entry : *targets) {
+      const base::Value::Dict* dict = entry.GetIfDict();
+      if (!dict) {
+        continue;
+      }
+      LoopTarget target;
+      target.x = dict->FindInt("x").value_or(0);
+      target.y = dict->FindInt("y").value_or(0);
+      if (const base::Value::List* locators = dict->FindList("locators")) {
+        target.locators = dashboard::ConvertLocators(*locators);
+      }
+      if (target.x == 0 && target.y == 0) {
+        continue;
+      }
+      for_each_targets_.push_back(std::move(target));
+      if (static_cast<int>(for_each_targets_.size()) >= max_iterations_) {
+        break;
+      }
+    }
+  }
+  if (for_each_targets_.empty()) {
+    Complete(false, reason.empty()
+                        ? "No loop targets matched the recorded locator bundle"
+                        : reason);
+    return;
+  }
+  LOG(INFO) << "[LoopAction] Collected " << for_each_targets_.size()
+            << " loop targets from CSS query fallback";
+  if (for_each_strategy_ == ForEachStrategy::kRequeryEachIteration) {
+    std::optional<LoopTarget> next_target;
+    for (const auto& t : for_each_targets_) {
+      const std::string key = base::StringPrintf(
+          "%d,%d,%s", t.x, t.y,
+          t.locators.empty() ? "" : t.locators.front().value.c_str());
+      if (for_each_seen_target_keys_.contains(key)) {
+        continue;
+      }
+      for_each_seen_target_keys_.insert(key);
+      next_target = t;
+      break;
+    }
+    if (!next_target.has_value()) {
+      Complete(true, "");
+      return;
+    }
+    for_each_targets_.clear();
+    for_each_targets_.push_back(*next_target);
+    RunNextAction(0);
+    return;
+  }
+  EvaluateAndRunNextIteration();
+}
+
+void LoopAction::OnForEachTargetsCollected(
+    dashboard::UnifiedPageMapResult result) {
+  if (!result.ok) {
+    StartResolverPageMapFallback(result.error.empty()
+                                     ? "Failed to collect native loop targets"
+                                     : result.error);
