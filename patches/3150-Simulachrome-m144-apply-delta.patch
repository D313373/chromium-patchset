+void RecorderController::SetGuidedLoopSameTabNavigationGuard(
+    bool enabled,
+    bool block_all_anchor_navigation) {
+  if (!agent_host_ || !devtools_client_)
+    return;
+
+  const std::string js = base::StringPrintf(
+      R"JS((function(enabled, blockAllAnchorNavigation){
+        try {
+          const key = '__dash_guided_same_tab_guard__';
+          const state = window[key] || (window[key] = {
+            enabled:false,
+            blockAllAnchorNavigation:false,
+            installed:false,
+            handler:null,
+            origOpen:null
+          });
+          state.enabled = !!enabled;
+          state.blockAllAnchorNavigation = !!blockAllAnchorNavigation;
+          if (state.installed) return true;
+          if (!state.origOpen && typeof window.open === 'function') {
+            state.origOpen = window.open.bind(window);
+          }
+          window.open = function(url, target, features) {
+            try {
+              const s = window[key];
+              if (s && s.enabled && typeof url === 'string' && url) {
+                window.location.assign(url);
+                return null;
+              }
+            } catch (_) {}
+            if (state.origOpen) {
+              return state.origOpen.apply(window, arguments);
+            }
+            return null;
+          };
+          const isGlicUiTarget = function(eventOrNode) {
+            try {
+              const uiSelector =
+                  '#automationTools,#automationTools *,#automationToolsPopover,#automationToolsPopover *,#glic-app-container,#glic-app-container *,#panelContainer,#panelContainer *,#webviewHeader,#webviewHeader *,#automation-loop-next,#automation-loop-next *,#automation-loop-guided,#automation-loop-guided *,#automation-capture-locators,#automation-capture-locators *,#automation-record-toggle,#automation-record-toggle *';
+              const matchesNode = function(node) {
+                if (!node || node.nodeType !== 1) {
+                  return false;
+                }
+                if (typeof node.matches === 'function' &&
+                    node.matches(uiSelector)) {
+                  return true;
+                }
+                return typeof node.closest === 'function' &&
+                    !!node.closest(uiSelector);
+              };
+              if (eventOrNode &&
+                  typeof eventOrNode.composedPath === 'function') {
+                const path = eventOrNode.composedPath();
+                if (Array.isArray(path)) {
+                  for (const node of path) {
+                    if (matchesNode(node)) {
+                      return true;
+                    }
+                  }
+                }
+              }
+              let node = eventOrNode && eventOrNode.target ? eventOrNode.target :
+                                                              eventOrNode;
+              if (node && node.nodeType !== 1 && node.parentElement) {
+                node = node.parentElement;
+              }
+              for (let depth = 0; node && depth < 8; ++depth) {
+                if (matchesNode(node)) {
+                  return true;
+                }
+                const root = typeof node.getRootNode === 'function' ?
+                    node.getRootNode() :
+                    null;
+                const host = root && root.host ? root.host : null;
+                if (!host || host === node) {
+                  break;
+                }
+                node = host;
+              }
