+
+namespace {
+
+std::string PathLabel(ActionExecutionPath path) {
+  return std::string(ToActionExecutionPathString(path));
+}
+
+}  // namespace
+
+ExecutionFailoverAction::ExecutionFailoverAction(
+    Profile* profile,
+    std::string kind,
+    std::unique_ptr<Action> primary_action,
+    ActionExecutionPath primary_path,
+    std::unique_ptr<Action> fallback_action,
+    ActionExecutionPath fallback_path)
+    : Action(profile),
+      kind_(std::move(kind)),
+      primary_action_(std::move(primary_action)),
+      fallback_action_(std::move(fallback_action)),
+      primary_path_(primary_path),
+      fallback_path_(fallback_path) {
+  SetSerializedAction(kind_, base::Value::Dict());
+}
+
+ExecutionFailoverAction::~ExecutionFailoverAction() = default;
+
+bool ExecutionFailoverAction::SetParams(const base::Value::Dict& params) {
+  bool ok = false;
+  if (primary_action_) {
+    ok = primary_action_->SetParams(params);
+  }
+  if (fallback_action_) {
+    ok = fallback_action_->SetParams(params) || ok;
+  }
+  if (ok) {
+    SetSerializedAction(kind_, params.Clone());
+  }
+  return ok;
+}
+
+void ExecutionFailoverAction::Execute(content::WebContents* web_contents,
+                                      Callback callback) {
+  last_completed_action_ = nullptr;
+  if (!primary_action_) {
+    if (fallback_action_) {
+      fallback_action_->Execute(web_contents, std::move(callback));
+      return;
+    }
+    std::move(callback).Run(false, "No execution path available for " + kind_);
+    return;
+  }
+
+  primary_action_->Execute(
+      web_contents,
+      base::BindOnce(&ExecutionFailoverAction::OnPrimaryCompleted,
+                     base::Unretained(this), web_contents, std::move(callback)));
+}
+
+void ExecutionFailoverAction::SerializeInto(base::Value::Dict* out) const {
+  if (!out) {
+    return;
+  }
+
+  auto serialize_if_known = [&](const Action* action) -> bool {
+    if (!action) {
+      return false;
+    }
+    base::Value::Dict tmp;
+    action->SerializeInto(&tmp);
+    const std::string* kind = tmp.FindString("action");
+    if (!kind || kind->empty() || *kind == "unknown") {
+      return false;
+    }
+    *out = std::move(tmp);
+    return true;
+  };
+
+  if (serialize_if_known(last_completed_action_)) {
+    return;
+  }
+  if (serialize_if_known(primary_action_.get())) {
+    return;
+  }
+  if (serialize_if_known(fallback_action_.get())) {
+    return;
+  }
+  Action::SerializeInto(out);
+}
+
+void ExecutionFailoverAction::OnPrimaryCompleted(content::WebContents* web_contents,
+                                                 Callback callback,
+                                                 bool success,
+                                                 const std::string& message) {
+  if (success || !fallback_action_ ||
+      fallback_path_ == ActionExecutionPath::kUnset) {
+    if (success) {
+      last_completed_action_ = primary_action_.get();
+    }
+    std::move(callback).Run(success, message);
+    return;
+  }
+
+  LOG(WARNING) << "[ExecutionFailoverAction] Primary path failed for kind="
+               << kind_ << " primary=" << PathLabel(primary_path_)
+               << " fallback=" << PathLabel(fallback_path_)
+               << " error=" << message;
+
+  fallback_action_->Execute(
+      web_contents,
+      base::BindOnce(&ExecutionFailoverAction::OnFallbackCompleted,
+                     base::Unretained(this), std::move(callback), message));
+}
+
+void ExecutionFailoverAction::OnFallbackCompleted(Callback callback,
+                                                  std::string primary_error,
+                                                  bool success,
+                                                  const std::string& message) {
+  if (success) {
+    last_completed_action_ = fallback_action_.get();
+    std::move(callback).Run(true, message);
+    return;
+  }
+
+  std::move(callback).Run(
+      false, "Primary " + PathLabel(primary_path_) + " failed: " +
+                 primary_error + " | Fallback " + PathLabel(fallback_path_) +
+                 " failed: " + message);
+}
+
+}  // namespace dashboard::actions
