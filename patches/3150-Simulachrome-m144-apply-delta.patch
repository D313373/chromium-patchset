++                                     : std::string("count");
++  const std::string mode = base::ToLowerASCII(mode_raw);
++  if (mode == "for_each" || mode == "while_element_exists") {
++    const base::Value::List* locators = params->FindList("locators");
++    if (!locators || locators->empty()) {
