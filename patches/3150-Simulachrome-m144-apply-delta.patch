+-function sendActionViaScriptExecutor(payload, cb) {
+-  const timeline = Array.isArray(payload?.timeline)
+-      ? payload.timeline
+-      : (Array.isArray(payload?.actions) ? payload.actions : null);
+-  if (timeline) {
+-    chrome.send('dashboardAgentRunTimeline', [cb, timeline]);
+-    return;
+-  }
+-
+-  const actionObj = payload?.action;
+-  if (actionObj && typeof actionObj === 'object') {
+-    const action = String(actionObj.action || actionObj.type || '');
+-    const params = (actionObj.params && typeof actionObj.params === 'object')
+-        ? actionObj.params
+-        : ((actionObj.parameters && typeof actionObj.parameters === 'object')
+-              ? actionObj.parameters
+-              : {});
+-    chrome.send('dashboardAgentCallAction', [cb, action, params]);
+-    return;
+-  }
+-
+-  if (typeof payload?.action === 'string') {
+-    chrome.send('dashboardAgentCallAction', [
+-      cb,
+-      payload.action,
+-      (payload.params && typeof payload.params === 'object') ? payload.params : {}
+-    ]);
+-    return;
+-  }
+-
+-  chrome.send('dashboard.performAgentAction', [cb, payload]);
+-}
