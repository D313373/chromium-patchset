+-function ingestPageMapPayload(type, payload, sourceTag) {
+-  const snapshot = extractPageMap(payload);
+-  if (!snapshot) return;
+-  // Keep the on-screen view compact while retaining the full snapshot in
+-  // globalSiteMap for agent context / training.
+-  let displaySnapshot = snapshot;
+-  try {
+-    const maxElements = 30;
+-    const frames = Array.isArray(snapshot.frames) ? snapshot.frames : [];
+-    if (frames.length) {
+-      displaySnapshot = {
+-        ...snapshot,
+-        frames: frames.map((f) => {
+-          if (!f || typeof f !== 'object') return f;
+-          const els = Array.isArray(f.elements) ? f.elements : [];
+-          const trimmed =
+-              els.length > maxElements ? els.slice(0, maxElements) : els;
+-          return { ...f, elements: trimmed };
+-        }),
+-      };
+-    }
+-  } catch (_) {}
+-  const sig = `${type || 'pm'}|${snapshot.url || snapshot.metadata?.url || ''}|${snapshot.timestamp || snapshot.metadata?.timestamp || snapshot.ts || ''}`;
+-  if (sig && sig === lastRenderedPagemapSig) return;
+-  if (sig) lastRenderedPagemapSig = sig;
+-  stashPageMapInGlobalState(type, snapshot);
+-  renderOverlayPageMap(type, displaySnapshot || snapshot, sourceTag);
+-  const frames = Array.isArray(snapshot?.frames) ? snapshot.frames : [];
+-  const hasElements = (frames.some(f => (f.elements?.length || 0) > 0) || (Array.isArray(snapshot?.elements) && snapshot.elements.length));
+-  if (!hasElements) maybeProbeMinimalPageMap(snapshot);
+-}
