+  size_t token_pos = selector_lower.find(kNthChildToken);
+  size_t token_len = sizeof(kNthChildToken) - 1;
+  if (token_pos == std::string::npos) {
+    token_pos = selector_lower.find(kNthOfTypeToken);
+    token_len = sizeof(kNthOfTypeToken) - 1;
+  }
+  if (token_pos == std::string::npos) {
+    return std::nullopt;
+  }
