+            const name = el.getAttribute ? String(el.getAttribute('name') || '') : '';
+            const ariaLabel = el.getAttribute ? String(el.getAttribute('aria-label') || '') : '';
+            let css = '';
+            if (id && count('#' + id) === 1) css = '#' + id;
+            else if (name && count('[name="' + esc(name) + '"]') === 1)
+              css = '[name="' + esc(name) + '"]';
+            else if (tag && count(tag) === 1) css = tag;
+            else css = tag;
+            let xpath = '';
+            if (id) xpath = '//*[@id="' + id.replace(/"/g, '') + '"]';
+            else if (name) xpath = '//*[@name="' + name.replace(/"/g, '') + '"]';
+            else if (tag && count(tag) === 1) xpath = '//' + tag;
+            return { tag, id, name, css, xpath, accessibilityName: ariaLabel };
+          } catch (e) {
+            return null;
+          }
+        })())JS",
+        x, y);
