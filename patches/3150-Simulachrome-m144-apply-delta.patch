+-// Helper to coerce whatever we got into the payload shape the C++ handler expects
+-function buildAgentPayload(actionOrPayload) {
+-  if (!actionOrPayload) {
+-    return { timeline: [] };
+-  }
+-
+-  // String -> treat as simple action name with no params.
+-  if (typeof actionOrPayload === 'string') {
+-    return { action: { action: actionOrPayload, params: {} } };
+-  }
+-
+-  if (typeof actionOrPayload !== 'object') {
+-    return { timeline: [] };
+-  }
+-
+-  // Already in explicit timeline/ actions shape
+-  if (Array.isArray(actionOrPayload.timeline) ||
+-      Array.isArray(actionOrPayload.actions)) {
+-    return actionOrPayload;
+-  }
+-
+-  // Full action object: { action: 'click', params: {...} }
+-  if (actionOrPayload.action) {
+-    return { action: actionOrPayload };
+-  }
+-
+-  // Fallback: treat the object itself as `{action:..., params:...}`-ish
+-  return { action: actionOrPayload };
+-}
