+              const force_same_tab = target === '_blank' || modifier_open;
+              if (!force_same_tab) return;
+              e.preventDefault();
+              if (typeof e.stopImmediatePropagation === 'function') {
+                e.stopImmediatePropagation();
+              }
+              e.stopPropagation();
