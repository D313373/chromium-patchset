+          document.addEventListener('pointerdown', state.handler, {
+            capture: true,
+            passive: false,
+          });
+          document.addEventListener('mousedown', state.handler, {
+            capture: true,
+            passive: false,
+          });
+          document.addEventListener('click', state.handler, {
