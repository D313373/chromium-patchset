+#include "chrome/browser/ui/webui/dashboard/devtools_client_manager.h"
+
+#include "content/public/browser/web_contents.h"
+
+DevToolsClientManager::DevToolsClientManager(content::WebContents* wc)
+    : content::WebContentsObserver(wc), web_contents_(wc) {
+  client_ = std::make_unique<dashboard::DashboardDevToolsClient>(wc);
+}
+
+DevToolsClientManager::~DevToolsClientManager() = default;
+
+void DevToolsClientManager::WebContentsDestroyed() {
+  web_contents_ = nullptr;
+  if (client_) {
+    client_->Detach();
+    client_.reset();
+  }
+}
