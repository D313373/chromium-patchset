+HeadlessTaskState* FindHeadlessTask(Profile* profile,
+                                    const std::string& task_id) {
+  auto& by_profile = HeadlessInvestigateTasks();
+  auto profile_it = by_profile.find(profile);
+  if (profile_it == by_profile.end()) {
+    return nullptr;
+  }
+  auto task_it = profile_it->second.find(task_id);
+  if (task_it == profile_it->second.end() || !task_it->second) {
+    return nullptr;
+  }
+  return task_it->second.get();
+}
