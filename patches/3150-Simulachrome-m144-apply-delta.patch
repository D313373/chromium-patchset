+-export function installDashboardOverlayControls({
+-  documentRef = document,
+-  overlayToggleBtn = null,
+-  captureLocatorsBtn = null,
+-  onCaptureLocators = null,
+-} = {}) {
+-  let overlayVisible = false;
+-
+-  const applyOverlayButtonState = () => {
+-    if (!overlayToggleBtn) return;
+-    overlayToggleBtn.classList.toggle('active', overlayVisible);
+-    overlayToggleBtn.textContent = overlayVisible ? 'Hide Overlay' : 'Show Overlay';
+-  };
+-
+-  const sendOverlayCommand = (message) => {
+-    if (!globalThis.chrome?.send) {
+-      return;
+-    }
+-    globalThis.chrome.send(message, []);
+-  };
+-
+-  const toggleOverlay = () => {
+-    try {
+-      if (!overlayVisible) {
+-        sendOverlayCommand('dashboardRecorderShowOverlay');
+-        overlayVisible = true;
+-      } else {
+-        sendOverlayCommand('dashboardRecorderCloseOverlay');
+-        overlayVisible = false;
+-      }
+-      applyOverlayButtonState();
+-    } catch (e) {
+-      console.error('toggleOverlay failed', e);
+-    }
+-  };
+-
+-  const handleOverlayClick = () => toggleOverlay();
+-  const handleCaptureClick = () => {
+-    if (typeof onCaptureLocators === 'function') {
+-      void onCaptureLocators();
+-    }
+-  };
+-  const handleKeyDown = (e) => {
+-    if (e.shiftKey && (e.code === 'Space' || e.key === ' ')) {
+-      e.preventDefault();
+-      toggleOverlay();
+-    }
+-  };
+-
+-  applyOverlayButtonState();
+-  if (overlayToggleBtn) {
+-    overlayToggleBtn.addEventListener('click', handleOverlayClick);
+-  }
+-  if (captureLocatorsBtn) {
+-    captureLocatorsBtn.addEventListener('click', handleCaptureClick);
+-  }
+-  documentRef.addEventListener('keydown', handleKeyDown);
+-
+-  return {
+-    dispose() {
+-      if (overlayToggleBtn) {
+-        overlayToggleBtn.removeEventListener('click', handleOverlayClick);
+-      }
+-      if (captureLocatorsBtn) {
+-        captureLocatorsBtn.removeEventListener('click', handleCaptureClick);
+-      }
+-      documentRef.removeEventListener('keydown', handleKeyDown);
+-    },
+-  };
+-}
