+std::string TryRepairTruncatedJsonObject(const std::string& input) {
+  std::string repaired =
+      std::string(base::TrimWhitespaceASCII(input, base::TRIM_ALL));
+  if (repaired.empty() || repaired.front() != '{') {
+    return std::string();
+  }
+  int brace_balance = 0;
+  int bracket_balance = 0;
+  bool in_string = false;
+  bool escape = false;
+  for (char ch : repaired) {
+    if (escape) {
+      escape = false;
+      continue;
+    }
+    if (ch == '\\') {
+      escape = true;
+      continue;
+    }
+    if (ch == '"') {
+      in_string = !in_string;
+      continue;
+    }
+    if (in_string) {
+      continue;
+    }
+    if (ch == '{') {
+      ++brace_balance;
+    } else if (ch == '}') {
+      --brace_balance;
+    } else if (ch == '[') {
+      ++bracket_balance;
+    } else if (ch == ']') {
+      --bracket_balance;
+    }
+  }
+  if (in_string) {
+    repaired.push_back('"');
+  }
+  while (bracket_balance > 0) {
+    repaired.push_back(']');
+    --bracket_balance;
+  }
+  while (brace_balance > 0) {
+    repaired.push_back('}');
+    --brace_balance;
+  }
+  return repaired;
+}
