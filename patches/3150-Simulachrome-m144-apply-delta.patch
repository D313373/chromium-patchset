+  const base::Value::Dict* first = candidates->front().GetIfDict();
+  const base::Value::Dict* content = first ? first->FindDict("content") : nullptr;
+  const base::Value::List* parts = content ? content->FindList("parts") : nullptr;
+  if (!parts) {
