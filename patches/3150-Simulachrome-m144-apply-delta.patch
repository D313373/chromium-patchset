+std::optional<int> ParseIntLikeValue(const base::Value* value) {
+  if (!value) {
+    return std::nullopt;
+  }
+  if (value->is_int()) {
+    return value->GetInt();
+  }
+  if (value->is_double()) {
+    return static_cast<int>(value->GetDouble());
+  }
+  if (value->is_string()) {
+    int parsed = 0;
+    if (base::StringToInt(value->GetString(), &parsed)) {
+      return parsed;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<bool> ParseBoolLikeValue(const base::Value* value) {
+  if (!value) {
+    return std::nullopt;
+  }
+  if (value->is_bool()) {
+    return value->GetBool();
+  }
+  if (value->is_int()) {
+    return value->GetInt() != 0;
+  }
+  if (value->is_double()) {
+    return value->GetDouble() != 0.0;
+  }
+  if (value->is_string()) {
+    std::string lowered = base::ToLowerASCII(value->GetString());
+    if (lowered == "1" || lowered == "true" || lowered == "yes" ||
+        lowered == "on") {
+      return true;
+    }
+    if (lowered == "0" || lowered == "false" || lowered == "no" ||
+        lowered == "off") {
+      return false;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<int> ReadRequestedTabId(const base::Value::Dict& payload) {
+  if (std::optional<int> tab_id = ParseIntLikeValue(payload.Find("tab_id"));
+      tab_id.has_value()) {
+    return tab_id;
+  }
+  if (std::optional<int> tab_id = ParseIntLikeValue(payload.Find("tabId"));
+      tab_id.has_value()) {
+    return tab_id;
+  }
+  if (const base::Value::Dict* options = payload.FindDict("options")) {
+    if (std::optional<int> tab_id = ParseIntLikeValue(options->Find("tab_id"));
+        tab_id.has_value()) {
+      return tab_id;
+    }
+    if (std::optional<int> tab_id = ParseIntLikeValue(options->Find("tabId"));
+        tab_id.has_value()) {
+      return tab_id;
+    }
+  }
+  return std::nullopt;
+}
+
+Browser* FindBrowserForWebContents(Profile* profile,
+                                   content::WebContents* target_wc) {
+  if (!profile || !target_wc) {
+    return nullptr;
+  }
+  for (Browser* browser : *BrowserList::GetInstance()) {
+    if (!browser || browser->profile() != profile) {
+      continue;
+    }
+    TabStripModel* tabs = browser->tab_strip_model();
+    if (!tabs) {
+      continue;
+    }
+    if (tabs->GetIndexOfWebContents(target_wc) >= 0) {
+      return browser;
+    }
+  }
+  return nullptr;
+}
+
+content::WebContents* FindWebContentsForTabId(Profile* profile, int tab_id) {
+  if (!profile || tab_id <= 0) {
+    return nullptr;
+  }
+  for (Browser* browser : *BrowserList::GetInstance()) {
+    if (!browser || browser->profile() != profile) {
+      continue;
+    }
+    TabStripModel* tab_strip = browser->tab_strip_model();
+    if (!tab_strip) {
+      continue;
+    }
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      content::WebContents* wc = tab_strip->GetWebContentsAt(i);
+      if (!wc) {
+        continue;
+      }
+      if (sessions::SessionTabHelper::IdForTab(wc).id() == tab_id) {
+        return wc;
+      }
+    }
+  }
+  return nullptr;
+}
