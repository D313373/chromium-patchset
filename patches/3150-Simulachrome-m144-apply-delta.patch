+std::string NormalizeDataKey(std::string key) {
+  base::TrimWhitespaceASCII(key, base::TRIM_ALL, &key);
+  if (key.size() >= 2 && key.front() == '{' && key.back() == '}') {
+    key = key.substr(1, key.size() - 2);
+    base::TrimWhitespaceASCII(key, base::TRIM_ALL, &key);
+  }
+  return key;
+}
