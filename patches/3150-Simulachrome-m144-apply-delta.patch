@@ -0,0 +1,531 @@
+#!/usr/bin/env python3
+"""Launches a Dashboard script through Chromium DevTools.
+
+This helper opens `chrome://dashboard`, resolves a script by id or name, runs
+it one or more times, and reports new/changed scrape outputs after each run.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import socket
+import struct
+import sys
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+
+def _http_json(port: int, path: str, method: str = "GET") -> Any:
+  url = f"http://127.0.0.1:{port}{path}"
+  req = urllib.request.Request(url, method=method)
+  with urllib.request.urlopen(req, timeout=10.0) as resp:
+    return json.loads(resp.read().decode("utf-8"))
+
+
+class WebSocketCDP:
+  """Tiny stdlib-only CDP websocket client."""
+
+  def __init__(self, ws_url: str, timeout: float = 20.0):
+    self._sock: Optional[socket.socket] = None
+    self._timeout = timeout
+    self._next_id = 1
+    self._connect(ws_url)
+
+  def _connect(self, ws_url: str) -> None:
+    parts = urllib.parse.urlparse(ws_url)
+    if parts.scheme != "ws":
+      raise RuntimeError(f"Unsupported websocket scheme: {parts.scheme}")
+    host = parts.hostname or "127.0.0.1"
+    port = parts.port or 80
+    path = parts.path or "/"
+    if parts.query:
+      path += "?" + parts.query
+
+    sock = socket.create_connection((host, port), timeout=self._timeout)
+    sock.settimeout(self._timeout)
+    key = os.urandom(16)
+    key_b64 = __import__("base64").b64encode(key).decode("ascii")
+    req = (
+        f"GET {path} HTTP/1.1\r\n"
+        f"Host: {host}:{port}\r\n"
+        "Origin: http://127.0.0.1\r\n"
+        "Upgrade: websocket\r\n"
+        "Connection: Upgrade\r\n"
+        f"Sec-WebSocket-Key: {key_b64}\r\n"
+        "Sec-WebSocket-Version: 13\r\n"
+        "\r\n"
+    ).encode("utf-8")
+    sock.sendall(req)
+    response = self._recv_http_headers(sock)
+    lines = response.splitlines()
+    if not lines or b" 101 " not in lines[0]:
+      raise RuntimeError(f"WebSocket handshake failed: {response[:200]!r}")
+    self._sock = sock
+
+  def _recv_http_headers(self, sock: socket.socket) -> bytes:
+    data = bytearray()
+    while b"\r\n\r\n" not in data:
+      chunk = sock.recv(4096)
+      if not chunk:
+        break
+      data.extend(chunk)
+    return bytes(data)
+
+  def close(self) -> None:
+    if self._sock is not None:
+      try:
+        self._sock.close()
+      except OSError:
+        pass
+      self._sock = None
+
+  def _read_exact(self, n: int) -> bytes:
+    if self._sock is None:
+      raise RuntimeError("WebSocket is closed")
+    out = bytearray()
+    while len(out) < n:
+      chunk = self._sock.recv(n - len(out))
+      if not chunk:
+        raise RuntimeError("WebSocket closed while reading")
+      out.extend(chunk)
+    return bytes(out)
+
+  def _send_text(self, text: str) -> None:
+    if self._sock is None:
+      raise RuntimeError("WebSocket is closed")
+    payload = text.encode("utf-8")
+    header = bytearray([0x81])
+    length = len(payload)
+    if length < 126:
+      header.append(0x80 | length)
+    elif length <= 0xFFFF:
+      header.append(0x80 | 126)
+      header.extend(struct.pack("!H", length))
+    else:
+      header.append(0x80 | 127)
+      header.extend(struct.pack("!Q", length))
+    mask = os.urandom(4)
+    header.extend(mask)
+    masked = bytearray(payload)
+    for i in range(length):
+      masked[i] ^= mask[i % 4]
+    self._sock.sendall(bytes(header) + bytes(masked))
+
+  def _recv_frame(self) -> bytes:
+    b1, b2 = self._read_exact(2)
+    opcode = b1 & 0x0F
+    masked = (b2 & 0x80) != 0
+    length = b2 & 0x7F
+    if length == 126:
+      length = struct.unpack("!H", self._read_exact(2))[0]
+    elif length == 127:
+      length = struct.unpack("!Q", self._read_exact(8))[0]
+    mask = self._read_exact(4) if masked else b""
+    payload = bytearray(self._read_exact(length))
+    if masked:
+      for i in range(length):
+        payload[i] ^= mask[i % 4]
+    if opcode == 0x8:
+      raise RuntimeError("WebSocket closed")
+    if opcode == 0x9:
+      self._send_pong(bytes(payload))
+      return self._recv_frame()
+    if opcode != 0x1:
+      return self._recv_frame()
+    return bytes(payload)
+
+  def _send_pong(self, payload: bytes = b"") -> None:
+    if self._sock is None:
+      return
+    header = bytearray([0x8A])
+    length = len(payload)
+    if length < 126:
+      header.append(0x80 | length)
+    elif length <= 0xFFFF:
+      header.append(0x80 | 126)
+      header.extend(struct.pack("!H", length))
+    else:
+      header.append(0x80 | 127)
+      header.extend(struct.pack("!Q", length))
+    mask = os.urandom(4)
+    header.extend(mask)
+    masked = bytearray(payload)
+    for i in range(length):
+      masked[i] ^= mask[i % 4]
+    self._sock.sendall(bytes(header) + bytes(masked))
+
+  def call(self, method: str, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
+    msg_id = self._next_id
+    self._next_id += 1
+    self._send_text(json.dumps({
+        "id": msg_id,
+        "method": method,
+        "params": params or {},
+    }))
+    while True:
+      raw = self._recv_frame().decode("utf-8", errors="replace")
+      payload = json.loads(raw)
+      if payload.get("id") != msg_id:
+        continue
+      if "error" in payload:
+        raise RuntimeError(
+            f"CDP {method} failed: {json.dumps(payload['error'], ensure_ascii=True)}")
+      return payload.get("result") or {}
+
+
+def _wait_for_devtools(port: int, timeout_sec: float) -> None:
+  deadline = time.time() + max(1.0, timeout_sec)
+  last_error: Optional[Exception] = None
+  while time.time() < deadline:
+    try:
+      version = _http_json(port, "/json/version")
+      if version.get("webSocketDebuggerUrl"):
+        return
+    except Exception as exc:
+      last_error = exc
+    time.sleep(0.25)
+  if last_error is not None:
+    raise RuntimeError(
+        f"DevTools endpoint on port {port} did not come up: {last_error}") from last_error
+  raise RuntimeError(f"DevTools endpoint on port {port} did not come up")
+
+
+def _create_target(port: int, url: str) -> str:
+  version = _http_json(port, "/json/version")
+  browser_ws = str(version.get("webSocketDebuggerUrl") or "")
+  if not browser_ws:
+    raise RuntimeError("Missing browser webSocketDebuggerUrl from /json/version")
+  browser_cdp = WebSocketCDP(browser_ws, timeout=10.0)
+  try:
+    result = browser_cdp.call("Target.createTarget", {"url": url})
+  finally:
+    browser_cdp.close()
+  target_id = str(result.get("targetId") or "")
+  if not target_id:
+    raise RuntimeError("Target.createTarget returned empty targetId")
+  return target_id
+
+
+def _close_target(port: int, target_id: str) -> None:
+  try:
+    _http_json(port, f"/json/close/{urllib.parse.quote(target_id, safe='')}")
+  except Exception:
+    pass
+
+
+def _target_ws_url(port: int, target_id: str, timeout_sec: float = 10.0) -> str:
+  deadline = time.time() + max(1.0, timeout_sec)
+  last_error: Optional[Exception] = None
+  while time.time() < deadline:
+    try:
+      targets = _http_json(port, "/json/list")
+      for target in targets:
+        if target.get("id") == target_id and target.get("webSocketDebuggerUrl"):
+          return str(target["webSocketDebuggerUrl"])
+    except Exception as exc:
+      last_error = exc
+    time.sleep(0.1)
+  if last_error is not None:
+    raise RuntimeError(f"Target {target_id} websocket not ready: {last_error}") from last_error
+  raise RuntimeError(f"Target {target_id} websocket not ready")
+
+
+def _runtime_eval(ws: WebSocketCDP, expression: str, timeout_sec: float = 20.0) -> Any:
+  deadline = time.time() + max(1.0, timeout_sec)
+  last_error: Optional[Exception] = None
+  while time.time() < deadline:
+    try:
+      result = ws.call("Runtime.evaluate", {
+          "expression": expression,
+          "returnByValue": True,
+          "awaitPromise": True,
+      })
+      if isinstance(result, dict) and result.get("exceptionDetails"):
+        details = json.dumps(result.get("exceptionDetails"), ensure_ascii=True)
+        raise RuntimeError(f"Runtime.evaluate exception: {details[:320]}")
+      return (result.get("result") or {}).get("value")
+    except Exception as exc:
+      last_error = exc
+      message = str(exc).lower()
+      if ("context" in message or "provisional" in message or
+          "socket closed" in message or "target not found" in message):
+        time.sleep(0.25)
+        continue
+      raise
+  if last_error is not None:
+    raise RuntimeError(f"Runtime.evaluate timed out: {last_error}") from last_error
+  raise RuntimeError("Runtime.evaluate timed out")
+
+
+def _wait_for_document_ready(ws: WebSocketCDP, timeout_sec: float) -> None:
+  deadline = time.time() + max(1.0, timeout_sec)
+  while time.time() < deadline:
+    try:
+      state = _runtime_eval(ws, "document.readyState", timeout_sec=2.0)
+      if state in ("interactive", "complete"):
+        return
+    except Exception:
+      pass
+    time.sleep(0.2)
+  raise RuntimeError("Timed out waiting for document.readyState")
+
+
+def _wait_for_dashboard_handler(ws: WebSocketCDP, timeout_sec: float) -> None:
+  deadline = time.time() + max(1.0, timeout_sec)
+  expr = (
+      "Boolean(window.dashboardHandler && "
+      "typeof window.dashboardHandler.initialize === 'function' && "
+      "typeof window.dashboardHandler.getScripts === 'function' && "
+      "typeof window.dashboardHandler.playScript === 'function' && "
+      "typeof window.dashboardHandler.getRunHistory === 'function')")
+  while time.time() < deadline:
+    try:
+      if _runtime_eval(ws, expr, timeout_sec=2.0):
+        return
+    except Exception:
+      pass
+    time.sleep(0.2)
+  raise RuntimeError("Timed out waiting for window.dashboardHandler")
+
+
+def _resolve_script(ws: WebSocketCDP, query: str) -> Dict[str, str]:
+  expr = f"""
+(async () => {{
+  const query = {json.dumps(query)};
+  const handler = window.dashboardHandler;
+  await handler.initialize();
+  const res = await handler.getScripts();
+  const scripts = (res && typeof res.scripts === 'object' && res.scripts) ? res.scripts : {{}};
+  const entries = Object.entries(scripts);
+  const trimmed = String(query || '').trim();
+  const lowered = trimmed.toLowerCase();
+  let match = entries.find(([id, script]) =>
+      id === trimmed || String((script && script.name) || '').trim() === trimmed);
+  if (!match) {{
+    match = entries.find(([id, script]) =>
+      String(id || '').toLowerCase() === lowered ||
+      String((script && script.name) || '').trim().toLowerCase() === lowered);
+  }}
+  if (!match) {{
+    return {{
+      ok: false,
+      error: `No script matched "${{trimmed}}"`,
+      available: entries.slice(0, 200).map(([id, script]) => ({{
+        id,
+        name: String((script && script.name) || ''),
+      }})),
+    }};
+  }}
+  return {{
+    ok: true,
+    id: String(match[0] || ''),
+    name: String((match[1] && match[1].name) || ''),
+  }};
+}})()
+"""
+  result = _runtime_eval(ws, expr, timeout_sec=30.0)
+  if not isinstance(result, dict) or not result.get("ok"):
+    available = result.get("available") if isinstance(result, dict) else None
+    hint = ""
+    if isinstance(available, list) and available:
+      sample = ", ".join(
+          f"{item.get('name') or '(unnamed)'} [{item.get('id')}]"
+          for item in available[:8] if isinstance(item, dict))
+      if sample:
+        hint = f" Available: {sample}"
+    error = result.get("error") if isinstance(result, dict) else "Unknown error"
+    raise RuntimeError(f"{error}.{hint}")
+  return {
+      "id": str(result.get("id") or ""),
+      "name": str(result.get("name") or ""),
+  }
+
+
+def _latest_run(ws: WebSocketCDP, script_id: str) -> Optional[Dict[str, Any]]:
+  expr = f"""
+(async () => {{
+  const handler = window.dashboardHandler;
+  await handler.initialize();
+  const res = await handler.getRunHistory({json.dumps(script_id)}, '', '', 20);
+  const runs = Array.isArray(res && res.runs) ? res.runs.slice() : [];
+  runs.sort((a, b) => {{
+    const aTs = Number(a?.ended_ms ?? a?.started_ms ?? 0);
+    const bTs = Number(b?.ended_ms ?? b?.started_ms ?? 0);
+    return bTs - aTs;
+  }});
+  return runs.length ? runs[0] : null;
+}})()
+"""
+  result = _runtime_eval(ws, expr, timeout_sec=20.0)
+  return result if isinstance(result, dict) else None
+
+
+def _play_script(ws: WebSocketCDP, script_id: str) -> None:
+  expr = f"""
+(async () => {{
+  const handler = window.dashboardHandler;
+  await handler.initialize();
+  void handler.playScript({json.dumps(script_id)});
+  return true;
+}})()
+"""
+  _runtime_eval(ws, expr, timeout_sec=30.0)
+
+
+def _wait_for_completed_run(ws: WebSocketCDP,
+                            script_id: str,
+                            previous_run_id: str,
+                            timeout_sec: float,
+                            poll_interval_sec: float) -> Dict[str, Any]:
+  deadline = time.time() + max(1.0, timeout_sec)
+  while time.time() < deadline:
+    latest = _latest_run(ws, script_id)
+    if latest:
+      run_id = str(latest.get("run_id") or "")
+      if run_id and run_id != previous_run_id:
+        return latest
+    time.sleep(max(0.1, poll_interval_sec))
+  raise RuntimeError(
+      f"Timed out waiting for Dashboard run completion for script {script_id}")
+
+
+def _snapshot_scrape_dir(scrape_dir: Optional[Path]) -> Dict[str, Dict[str, Any]]:
+  if not scrape_dir or not scrape_dir.is_dir():
+    return {}
+  snapshot: Dict[str, Dict[str, Any]] = {}
+  for entry in scrape_dir.iterdir():
+    if not entry.is_file():
+      continue
+    try:
+      stat = entry.stat()
+    except OSError:
+      continue
+    snapshot[str(entry)] = {
+        "mtime_ns": stat.st_mtime_ns,
+        "size": stat.st_size,
+    }
+  return snapshot
+
+
+def _diff_scrape_dir(before: Dict[str, Dict[str, Any]],
+                     after: Dict[str, Dict[str, Any]]) -> List[str]:
+  changed: List[str] = []
+  for path, meta in after.items():
+    prev = before.get(path)
+    if prev != meta:
+      changed.append(path)
+  changed.sort(key=lambda p: (after[p]["mtime_ns"], p), reverse=True)
+  return changed
+
+
+def _print_changed_scrapes(changed: List[str]) -> None:
+  if not changed:
+    print("  scrape outputs: no new or modified files detected")
+    return
+  print("  scrape outputs:")
+  for path in changed[:8]:
+    print(f"    {path}")
+
+
+def _wait_for_scrape_outputs(scrape_dir: Optional[Path],
+                             before_scrapes: Dict[str, Dict[str, Any]],
+                             timeout_sec: float,
+                             poll_interval_sec: float,
+                             stable_sec: float = 10.0) -> List[str]:
+  if scrape_dir is None:
+    raise RuntimeError("scrape_dir is required for scrape-output completion mode")
+
+  deadline = time.time() + max(1.0, timeout_sec)
+  last_changed: List[str] = []
+  last_after_scrapes: Optional[Dict[str, Dict[str, Any]]] = None
+  stable_since: Optional[float] = None
+
+  while time.time() < deadline:
+    after_scrapes = _snapshot_scrape_dir(scrape_dir)
+    changed = _diff_scrape_dir(before_scrapes, after_scrapes)
+    if changed:
+      if changed != last_changed or last_after_scrapes != after_scrapes:
+        last_changed = changed
+        last_after_scrapes = after_scrapes
+        stable_since = time.time()
+      elif stable_since is not None and (time.time() - stable_since) >= stable_sec:
+        return changed
+    time.sleep(max(0.1, poll_interval_sec))
+
+  raise RuntimeError(
+      f"Timed out waiting for scrape output changes in {scrape_dir}")
+
+
+def main(argv: List[str]) -> int:
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--devtools-port", type=int, required=True)
+  parser.add_argument("--script", required=True,
+                      help="Dashboard script id or name")
+  parser.add_argument("--iterations", type=int, default=1)
+  parser.add_argument("--dashboard-url", default="chrome://dashboard")
+  parser.add_argument("--startup-timeout-sec", type=float, default=60.0)
+  parser.add_argument("--run-timeout-sec", type=float, default=600.0)
+  parser.add_argument("--poll-interval-sec", type=float, default=1.0)
+  parser.add_argument("--scrape-dir", default="",
+                      help="Optional scrape directory to diff after each run")
+  parser.add_argument("--keep-target-open", action="store_true")
+  args = parser.parse_args(argv)
+
+  if args.iterations < 1:
+    raise SystemExit("--iterations must be >= 1")
+
+  scrape_dir = Path(args.scrape_dir).expanduser() if args.scrape_dir else None
+  _wait_for_devtools(args.devtools_port, args.startup_timeout_sec)
+  target_id = _create_target(args.devtools_port, args.dashboard_url)
+  target_ws = _target_ws_url(args.devtools_port, target_id,
+                             timeout_sec=args.startup_timeout_sec)
+  ws = WebSocketCDP(target_ws, timeout=20.0)
+
+  try:
+    _wait_for_document_ready(ws, args.startup_timeout_sec)
+    _wait_for_dashboard_handler(ws, args.startup_timeout_sec)
+    script = _resolve_script(ws, args.script)
+    script_id = script["id"]
+    script_name = script["name"] or script_id
+    print(f"Dashboard script resolved: {script_name} [{script_id}]", flush=True)
+
+    for i in range(args.iterations):
+      print(f"Iteration {i + 1}/{args.iterations}", flush=True)
+      before_scrapes = _snapshot_scrape_dir(scrape_dir)
+      previous = _latest_run(ws, script_id)
+      previous_run_id = str(previous.get("run_id") or "") if previous else ""
+      _play_script(ws, script_id)
+      latest = _wait_for_completed_run(
+          ws,
+          script_id,
+          previous_run_id,
+          timeout_sec=args.run_timeout_sec,
+          poll_interval_sec=args.poll_interval_sec)
+      status = str(latest.get("status") or "unknown")
+      run_id = str(latest.get("run_id") or "")
+      error = str(latest.get("error") or "")
+      print(f"  run: {run_id or '(unknown)'}", flush=True)
+      print(f"  status: {status}", flush=True)
+      if error:
+        print(f"  error: {error}", flush=True)
+      after_scrapes = _snapshot_scrape_dir(scrape_dir)
+      _print_changed_scrapes(_diff_scrape_dir(before_scrapes, after_scrapes))
+      if status.lower() != "success":
+        return 2
+    return 0
+  finally:
+    try:
+      ws.close()
+    finally:
+      if not args.keep_target_open:
+        _close_target(args.devtools_port, target_id)
+
+
+if __name__ == "__main__":
+  raise SystemExit(main(sys.argv[1:]))
