+  std::vector<dashboard::Locator> locators_;
+  bool has_direct_coords_ = false;
+  int direct_x_ = 0;
+  int direct_y_ = 0;
+  int wait_timeout_ms_ = 5000;
+  int click_count_ = 1;
+
+  std::unique_ptr<ElementReadinessChecker> checker_;
+  base::WeakPtrFactory<CdpClickAction> weak_ptr_factory_{this};
+};
