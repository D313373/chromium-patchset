+std::string NormalizeSignatureToken(std::string token) {
+  base::TrimWhitespaceASCII(token, base::TRIM_ALL, &token);
+  if (token.empty()) {
+    return std::string();
+  }
+  token = base::ToLowerASCII(token);
+  for (char& ch : token) {
+    if (!base::IsAsciiAlpha(ch) && !base::IsAsciiDigit(ch) &&
+        ch != '_' && ch != '-') {
+      ch = '_';
+    }
+  }
+  return token;
+}
