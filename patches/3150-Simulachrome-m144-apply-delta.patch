+bool ClassListContainsToken(const std::string& class_attr,
+                            const std::string& wanted_lower) {
+  std::vector<std::string> tokens =
+      base::SplitString(class_attr, " \t\r\n", base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_NONEMPTY);
+  for (const std::string& token : tokens) {
+    if (Lower(token) == wanted_lower) {
+      return true;
+    }
+  }
+  return false;
+}
