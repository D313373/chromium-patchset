+                badge.textContent = label;
+                badge.style.display = 'block';
+                badge.style.background = phase === 1 ?
+                    'rgba(120,53,15,0.95)' :
+                    'rgba(8,47,73,0.95)';
+                badge.style.borderColor = phase === 1 ?
+                    'rgba(251,191,36,0.5)' :
+                    'rgba(56,189,248,0.5)';
+                badge.style.color = phase === 1 ? '#fde68a' : '#bae6fd';
+                badge.style.transform =
+                    `translate(${Number(state.lastPointerX || 0) + 16}px, ${Number(state.lastPointerY || 0) + 18}px)`;
+              } catch (_) {}
+            };
+            const updatePointerVisuals = function(e) {
+              try {
+                if (!e) return;
+                state.lastPointerX = Number(e.clientX || 0);
+                state.lastPointerY = Number(e.clientY || 0);
+                applyCursorBadge();
+              } catch (_) {}
+            };
+	          const applyCaptureCursor = function(mode) {
+	            try {
+	              const docEl = document.documentElement || null;
+	              const body = document.body || null;
+	              const nextMode = String(mode || 'off');
+		              if (nextMode === 'off') {
+		                if (state.cursorApplied) {
+		                  if (docEl && docEl.style) {
+		                    docEl.style.setProperty(
+		                        'cursor', String(state.prevDocCursor || ''), 'important');
+                  }
+                  if (body && body.style) {
+                    body.style.setProperty(
+                        'cursor', String(state.prevBodyCursor || ''), 'important');
+                  }
+	                }
+	                state.cursorApplied = false;
+	                return;
+	              }
+	              const cursorValue = nextMode === 'wait' ? 'wait' : 'crosshair';
+	              if (!state.cursorApplied) {
+		                state.prevDocCursor = docEl && docEl.style ?
+		                    String(docEl.style.cursor || '') : '';
+		                state.prevBodyCursor = body && body.style ?
+		                    String(body.style.cursor || '') : '';
+		              }
+		              if (docEl && docEl.style) {
+		                docEl.style.setProperty('cursor', cursorValue, 'important');
+		              }
+	              if (body && body.style) {
+	                body.style.setProperty('cursor', cursorValue, 'important');
+	              }
+	              state.lastCursor = nextMode;
+	              state.cursorApplied = true;
+                applyCursorBadge();
+	            } catch (e) {
+	              try {
+	                state.lastError = String((e && e.message) ? e.message : e);
+	              } catch (_) {}
+	            }
+	          };
+	          applyCaptureCursor(
+	              state.armed && !state.persistent
+	                  ? (state.captureInFlight ? 'wait' : 'crosshair')
