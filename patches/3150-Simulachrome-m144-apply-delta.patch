+  private normalizeGeneratedScriptAction(step: any): any|null {
+    if (!step || typeof step !== 'object') {
+      return null;
+    }
+    const action = String(step.action || '').trim().toLowerCase();
+    if (!action) {
+      return null;
+    }
+
+    if (action === 'navigate') {
+      const url = String(step?.params?.url || step?.url || '').trim();
+      if (!url) {
+        return null;
+      }
+      return {action: 'navigate', params: {url}};
+    }
+
+    if (action === 'type' || action === 'click' || action === 'hover') {
+      const params: any = {};
+      const locators = this.collectLocatorsFromStep(step);
+      if (locators.length) {
+        params.locators = locators;
+      }
+      if (action === 'type') {
+        const text = String(step?.params?.text ?? step?.text ?? step?.value ?? '')
+                         .trim();
+        if (!text) {
+          return null;
+        }
+        params.text = text;
+      }
+      if (action === 'click') {
+        const clickCountRaw = Number(
+            step?.params?.clickCount ?? step?.clickCount ?? 1);
+        const clickCount = Number.isFinite(clickCountRaw) ?
+            Math.max(1, Math.min(3, Math.round(clickCountRaw))) :
+            1;
+        params.clickCount = clickCount;
+      }
+      return {action, params};
+    }
+
+    if (step?.params && typeof step.params === 'object') {
+      return {action, params: step.params};
+    }
+    return {action, params: {}};
+  }
