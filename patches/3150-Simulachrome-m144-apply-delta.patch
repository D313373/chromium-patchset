+              << " ax_name="
+              << (dict.FindString("ax_name") ? *dict.FindString("ax_name")
+                                              : std::string("<none>"))
+              << " locators=" << (locs ? locs->size() : 0)
+              << " [" << SummarizeLocatorTypesForLog(locs) << "]";
