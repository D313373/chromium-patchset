+  const ClickCoordinateSnapshot snapshot =
+      SnapshotClickCoordinates(web_contents, view, x, y);
+  NativePlaybackOverlayHost::Get().Update(
+      web_contents, snapshot.screen_from_root, click_pulse);
+}
