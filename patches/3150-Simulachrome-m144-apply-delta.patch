+              const trimText = function(value, maxLen) {
+                const text = String(value || '').replace(/\s+/g, ' ').trim();
+                if (!text) return '';
+                const limit = Number(maxLen) > 0 ? Number(maxLen) : 120;
+                return text.length > limit ? text.slice(0, limit) : text;
+              };
+              const pushLocator = function(locators, seen, type, value) {
+                const t = String(type || '').trim();
+                const v = String(value || '').trim();
+                if (!t || !v) return;
+                const key = `${t}:${v}`;
+                if (seen.has(key)) return;
+                seen.add(key);
+                locators.push({type: t, value: v});
+              };
+              const buildCssPath = function(node) {
+                try {
+                  if (!node || node.nodeType !== 1) return '';
+                  if (node.id) return `#${escCss(node.id)}`;
+                  const segments = [];
+                  let cur = node;
+                  let depth = 0;
+                  while (cur && cur.nodeType === 1 && depth < 6) {
+                    const tag = String(cur.tagName || '').toLowerCase();
