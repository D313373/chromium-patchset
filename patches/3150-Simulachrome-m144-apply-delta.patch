+    params.Set("expression", js);
+    params.Set("returnByValue", true);
+    SendCommandExpectResponse(
+        "Runtime.evaluate", std::move(params),
+        base::BindOnce(
+            [](base::WeakPtr<RecorderController> weak, base::Value::Dict fallback,
+               int x, int y, std::string res_json, std::string /*err_json*/) {
+              if (!weak) {
+                return;
+              }
+              std::optional<base::Value> parsed = base::JSONReader::Read(
+                  res_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+              const base::Value::Dict* value = nullptr;
