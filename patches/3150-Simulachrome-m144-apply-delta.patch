+-const dashboard::mojom::AgentElementInfo* FindBestElementMatch(
+-    const dashboard::mojom::AgentStateSnapshot* snapshot,
+-    const base::Value::Dict& click) {
+-  if (!snapshot)
+-    return nullptr;
+-
+-  const std::string* frame_id = click.FindString("frame_id");
+-  const std::string* shadow = click.FindString("shadow_chain");
+-  const std::string* css = click.FindString("css");
+-  const std::string* xpath = click.FindString("xpath");
+-  auto find_num = [&](const char* key) -> std::optional<double> {
+-    if (auto d = click.FindDouble(key))
+-      return *d;
+-    if (auto i = click.FindInt(key))
+-      return static_cast<double>(*i);
+-    return std::nullopt;
+-  };
+-  std::optional<double> x = find_num("x");
+-  std::optional<double> y = find_num("y");
+-
+-  int best_score = -1;
+-  bool best_contains = false;
+-  bool best_is_root = true;
+-  bool best_clickable = false;
+-  bool best_has_text = false;
+-  double best_area = std::numeric_limits<double>::infinity();
+-  const dashboard::mojom::AgentElementInfo* best = nullptr;
+-  for (const auto& el_ptr : snapshot->elements) {
+-    if (!el_ptr)
+-      continue;
+-    const auto& el = *el_ptr;
+-    int score = 0;
+-    if (frame_id && !frame_id->empty() && el.frame_token == *frame_id)
+-      score += 5;
+-    if (shadow && !shadow->empty() && el.shadow_chain_selector == *shadow)
+-      score += 4;
+-    if (css && !css->empty() && el.css_selector == *css)
+-      score += 3;
+-    if (xpath && !xpath->empty() && el.xpath == *xpath)
+-      score += 2;
+-
+-    bool contains = false;
+-    double area = std::numeric_limits<double>::infinity();
+-    if (x && y) {
+-      gfx::RectF bounds(el.x, el.y, el.width, el.height);
+-      if (!bounds.IsEmpty() &&
+-          bounds.Contains(static_cast<float>(*x), static_cast<float>(*y))) {
+-        score += 3;
+-        contains = true;
+-        area = static_cast<double>(bounds.width()) *
+-               static_cast<double>(bounds.height());
+-      }
+-    }
+-    if (score <= 0)
+-      continue;
+-
+-    const bool is_root = (el.tag == "body" || el.tag == "html");
+-    const bool clickable = el.clickable;
+-    const bool has_text = !el.text.empty() || !el.accessibility_name.empty();
+-
+-    bool better = false;
+-    if (score > best_score) {
+-      better = true;
+-    } else if (score == best_score) {
+-      // Tie-break toward the most specific element at the point.
+-      if (best_is_root && !is_root) {
+-        better = true;
+-      } else if (best_is_root == is_root) {
+-        if (!best_clickable && clickable) {
+-          better = true;
+-        } else if (best_clickable == clickable) {
+-          if (!best_contains && contains) {
+-            better = true;
+-          } else if (best_contains == contains) {
+-            if (contains && area < best_area) {
+-              better = true;
+-            } else if (area == best_area) {
+-              if (!best_has_text && has_text)
+-                better = true;
+-            }
+-          }
+-        }
+-      }
+-    }
+-
+-    if (better) {
+-      best_score = score;
+-      best_contains = contains;
+-      best_is_root = is_root;
+-      best_clickable = clickable;
+-      best_has_text = has_text;
+-      best_area = area;
+-      best = el_ptr.get();
+-    }
+-  }
+-  return best;
+-}
