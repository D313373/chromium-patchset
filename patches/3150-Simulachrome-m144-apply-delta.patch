+-window.performAgentActionWithScriptExecutor = function(actionOrPayload) {
+-  const payload = buildAgentPayload(actionOrPayload);
+-
+-  return new Promise((resolve) => {
+-    const cb = 'agentPerformCb_' + Date.now() + Math.random().toString(36).slice(2);
+-    window[cb] = (res) => {
+-      try { delete window[cb]; } catch (_) {}
+-      resolve({
+-        ...(res || { ok: false }),
+-        api: 'scriptExecutor',
+-      });
+-    };
+-
+-    try {
+-      sendActionViaScriptExecutor(payload, cb);
+-    } catch (e) {
+-      console.error('[Agent] performAgentActionWithScriptExecutor failed', e);
+-      try { delete window[cb]; } catch (_) {}
+-      resolve({ ok: false, error: String(e), api: 'scriptExecutor' });
+-    }
+-  });
+-};
+-
+-window.performAgentAction = function(actionOrPayload) {
+-  return window.performAgentActionWithScriptExecutor(actionOrPayload);
