+  }
+  const std::string lower = base::ToLowerASCII(token);
+  if (base::StartsWith(lower, "css-") || base::StartsWith(lower, "jsx-") ||
+      base::StartsWith(lower, "sc-") || base::StartsWith(lower, "r-") ||
+      base::StartsWith(lower, "id__") || base::StartsWith(lower, "_")) {
+    return true;
