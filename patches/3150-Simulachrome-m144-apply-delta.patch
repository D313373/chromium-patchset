+  base::Value::Dict payload;
+  if (timeline)
+    payload.Set("timeline", timeline->Clone());
+  base::Value::List forwarded_args;
+  forwarded_args.Append(cb);
+  forwarded_args.Append(std::move(payload));
+  HandlePerformAgentAction(forwarded_args);
+}
