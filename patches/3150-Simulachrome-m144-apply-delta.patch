+UnifiedAgentOrchestrator::UnifiedAgentOrchestrator(GlicKeyedService* service)
+    : service_(service), context_adapter_(service) {}
+
+UnifiedAgentOrchestrator::~UnifiedAgentOrchestrator() = default;
+
+UnifiedAgentRunRecord* UnifiedAgentOrchestrator::FindRun(
+    const std::string& run_id) {
+  auto it = runs_.find(run_id);
+  return it == runs_.end() ? nullptr : &it->second;
+}
+
+const UnifiedAgentRunRecord* UnifiedAgentOrchestrator::FindRun(
+    const std::string& run_id) const {
+  auto it = runs_.find(run_id);
+  return it == runs_.end() ? nullptr : &it->second;
+}
+
+void UnifiedAgentOrchestrator::RememberRecentRun(const std::string& run_id) {
+  auto existing =
+      std::find(recent_run_ids_.begin(), recent_run_ids_.end(), run_id);
+  if (existing != recent_run_ids_.end()) {
+    recent_run_ids_.erase(existing);
+  }
+  recent_run_ids_.push_front(run_id);
+  while (recent_run_ids_.size() > kMaxStoredRuns) {
+    recent_run_ids_.pop_back();
+  }
+}
+
+void UnifiedAgentOrchestrator::TrimStoredRuns() {
+  while (runs_.size() > kMaxStoredRuns && !recent_run_ids_.empty()) {
+    const std::string run_id = recent_run_ids_.back();
+    recent_run_ids_.pop_back();
+    runs_.erase(run_id);
+  }
+}
+
+bool UnifiedAgentOrchestrator::NeedsContextRefresh(
+    const UnifiedAgentRunRecord& run,
+    bool force_refresh) const {
+  if (force_refresh || run.context_snapshots.empty()) {
+    return true;
+  }
+  return base::Time::Now() - run.context_snapshots.back().captured_at >
+         kContextStaleAfter;
+}
+
+void UnifiedAgentOrchestrator::AppendToolTrace(UnifiedAgentRunRecord& run,
+                                               UnifiedToolCallRecord call,
+                                               UnifiedToolResultRecord result) {
+  run.updated_at = result.finished_at;
+  run.issued_commands.push_back(std::move(call));
+  run.command_results.push_back(std::move(result));
+}
+
+void UnifiedAgentOrchestrator::StartRun(mojom::StartAgentRunRequestPtr request,
+                                        StartRunCallback callback) {
+  UnifiedAgentRunRecord run;
+  run.run_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  run.goal = request->goal;
+  run.profile = request->profile;
+  run.run_state = mojom::AgentRunState::kRunning;
+  run.allow_actor_fallback = request->allow_actor_fallback;
+  run.requested_tab_id = request->tab_id;
+  run.context_policy = request->initial_context_policy;
+  run.started_at = base::Time::Now();
+  run.updated_at = run.started_at;
+
+  const std::string run_id = run.run_id;
+  runs_.insert_or_assign(run_id, std::move(run));
+  RememberRecentRun(run_id);
+  TrimStoredRuns();
+
+  UnifiedToolCallRecord call{
+      .tool = "page.refresh_context",
+      .payload_json =
+          BuildRefreshPayloadJson(request->tab_id, request->initial_context_policy),
+  };
+  const base::Time started_at = base::Time::Now();
+  context_adapter_.CaptureContextSnapshot(
+      request->profile, request->tab_id, request->initial_context_policy,
+      base::BindOnce(
+          [](base::WeakPtr<UnifiedAgentOrchestrator> self, std::string run_id,
+             UnifiedToolCallRecord call, base::Time started_at,
+             StartRunCallback callback,
+             UnifiedAgentContextAdapter::CaptureResult result) {
+            auto response = mojom::StartAgentRunResponse::New();
+            if (!self) {
+              response->ok = false;
+              response->run_id = std::move(run_id);
+              response->run_state = mojom::AgentRunState::kCanceled;
+              response->error = "orchestrator_unavailable";
+              std::move(callback).Run(std::move(response));
+              return;
+            }
+            UnifiedAgentRunRecord* run = self->FindRun(run_id);
+            if (!run) {
+              response->ok = false;
+              response->run_id = std::move(run_id);
+              response->run_state = mojom::AgentRunState::kCanceled;
+              response->error = "run_not_found";
+              std::move(callback).Run(std::move(response));
+              return;
+            }
+
+            if (result.ok) {
+              run->context_refresh_count++;
+              run->context_snapshots.push_back(std::move(result.snapshot));
+              self->AppendToolTrace(
+                  *run, std::move(call),
+                  BuildToolResult(
+                      true, "page.refresh_context",
+                      mojom::AgentFailureStage::kNone, std::string(),
+                      false, started_at,
+                      base::StringPrintf(
+                          "Captured initial context for %s.",
+                          run->context_snapshots.back().url.spec().c_str()),
+                      "initial_context_ready"));
+              response->ok = true;
+              response->run_id = run->run_id;
+              response->run_state = run->run_state;
+              response->trace_summary = BuildMojomRunTraceSummary(*run);
+              response->context_snapshot =
+                  BuildMojomContextSnapshot(run->context_snapshots.back());
+              response->error.clear();
+              std::move(callback).Run(std::move(response));
+              return;
+            }
+
+            run->run_state = mojom::AgentRunState::kFailed;
+            run->failure_stage = result.failure_stage;
+            run->error_class = result.error_class;
+            run->final_outcome = result.message;
+            self->AppendToolTrace(
+                *run, std::move(call),
+                BuildToolResult(false, "page.refresh_context",
+                                result.failure_stage, result.error_class,
+                                /*retryable=*/true, started_at, result.message,
+                                "initial_context_failed"));
+            response->ok = false;
+            response->run_id = run->run_id;
+            response->run_state = run->run_state;
+            response->trace_summary = BuildMojomRunTraceSummary(*run);
+            response->error = result.message;
+            std::move(callback).Run(std::move(response));
+          },
+          weak_ptr_factory_.GetWeakPtr(), run_id, std::move(call), started_at,
+          std::move(callback)));
+}
+
+void UnifiedAgentOrchestrator::SendTurn(mojom::AgentTurnRequestPtr request,
+                                        SendTurnCallback callback) {
+  UnifiedAgentRunRecord* run = FindRun(request->run_id);
+  auto response = mojom::AgentTurnResponse::New();
+  if (!run) {
+    response->assistant_text = "Unified agent run not found.";
+    response->run_state = mojom::AgentRunState::kFailed;
+    response->failure_stage = mojom::AgentFailureStage::kDispatch;
+    response->error_class = "run_not_found";
+    response->retryable = false;
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+
+  if (request->requested_profile_override.has_value()) {
+    run->profile = *request->requested_profile_override;
+  }
+  run->updated_at = base::Time::Now();
+  run->run_state = mojom::AgentRunState::kRunning;
+
+  if (std::optional<ParsedToolTurn> parsed_tool =
+          ParseToolTurnRequest(request->user_message);
+      parsed_tool.has_value()) {
+    UnifiedToolCallRecord call{
+        .tool = parsed_tool->tool,
+        .payload_json = WriteJsonDict(parsed_tool->payload.Clone()),
+    };
+    response->issued_commands.push_back(
+        mojom::UnifiedToolCall::New(call.tool, call.payload_json));
+
+    if (parsed_tool->tool == "script.select") {
+      Profile* profile = service_ ? service_->profile() : nullptr;
+      const std::optional<std::string> requested_script_id =
+          ReadStringOption(parsed_tool->payload, "script_id", "scriptId");
+      if (!profile) {
+        run->failure_stage = mojom::AgentFailureStage::kDispatch;
+        run->error_class = "profile_unavailable";
+        run->final_outcome = "profile_unavailable";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kDispatch,
+                            "profile_unavailable", false, base::Time::Now(),
+                            "Script selection failed: profile unavailable.",
+                            "dispatch_failed"));
+        response->assistant_text = "Script selection failed: profile unavailable.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+      if (!requested_script_id.has_value() || requested_script_id->empty()) {
+        run->failure_stage = mojom::AgentFailureStage::kPlanning;
+        run->error_class = "missing_script_id";
+        run->final_outcome = "missing_script_id";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kPlanning,
+                            "missing_script_id", false, base::Time::Now(),
+                            "Script selection requires payload.script_id.",
+                            "planning_failed"));
+        response->assistant_text = "Script selection requires payload.script_id.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      base::Value::Dict script;
+      if (!dashboard::ScriptStore::Read(profile, *requested_script_id, &script)) {
+        run->failure_stage = mojom::AgentFailureStage::kScriptIo;
+        run->error_class = "script_not_found";
+        run->final_outcome = "script_not_found";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kScriptIo,
+                            "script_not_found", false, base::Time::Now(),
+                            base::StrCat({"Script not found: ", *requested_script_id}),
+                            "script_select_failed"));
+        response->assistant_text =
+            base::StrCat({"Script not found: ", *requested_script_id});
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      run->selected_script_id = *requested_script_id;
+      UnifiedToolResultRecord result = BuildToolResult(
+          true, parsed_tool->tool, mojom::AgentFailureStage::kNone,
+          std::string(), false, base::Time::Now(),
+          base::StrCat({"Selected script ", *requested_script_id, "."}),
+          "script_selected");
+      result.artifacts_json =
+          BuildScriptArtifactsJson(*requested_script_id, script.Clone());
+      AppendToolTrace(*run, std::move(call), std::move(result));
+      run->final_outcome = "script_selected";
+      response->assistant_text =
+          base::StrCat({"Selected script ", *requested_script_id, "."});
+      response->run_state = run->run_state;
+      response->failure_stage = mojom::AgentFailureStage::kNone;
+      response->error_class.clear();
+      response->retryable = false;
+      response->trace_summary = BuildMojomRunTraceSummary(*run);
+      std::move(callback).Run(std::move(response));
+      return;
+    }
+
+    if (parsed_tool->tool == "script.get") {
+      Profile* profile = service_ ? service_->profile() : nullptr;
+      if (!profile) {
+        run->failure_stage = mojom::AgentFailureStage::kDispatch;
+        run->error_class = "profile_unavailable";
+        run->final_outcome = "profile_unavailable";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kDispatch,
+                            "profile_unavailable", false, base::Time::Now(),
+                            "Script read failed: profile unavailable.",
+                            "dispatch_failed"));
+        response->assistant_text = "Script read failed: profile unavailable.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      std::optional<std::string> requested_script_id =
+          ReadStringOption(parsed_tool->payload, "script_id", "scriptId");
+      if ((!requested_script_id.has_value() || requested_script_id->empty()) &&
+          !run->selected_script_id.empty()) {
+        requested_script_id = run->selected_script_id;
+      }
+
+      if (!requested_script_id.has_value() || requested_script_id->empty()) {
+        base::Value::Dict all_scripts = dashboard::ScriptStore::LoadAll(profile);
+        UnifiedToolResultRecord result = BuildToolResult(
+            true, parsed_tool->tool, mojom::AgentFailureStage::kNone,
+            std::string(), false, base::Time::Now(),
+            base::StringPrintf("Loaded %zu script(s).", all_scripts.size()),
+            "script_inventory_loaded");
+        result.artifacts_json =
+            BuildScriptSummaryArtifactsJson(all_scripts.Clone());
+        AppendToolTrace(*run, std::move(call), std::move(result));
+        run->final_outcome = "script_inventory_loaded";
+        response->assistant_text = base::StringPrintf(
+            "Loaded %zu script(s).", all_scripts.size());
+        response->run_state = run->run_state;
+        response->failure_stage = mojom::AgentFailureStage::kNone;
+        response->error_class.clear();
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      base::Value::Dict script;
+      if (!dashboard::ScriptStore::Read(profile, *requested_script_id, &script)) {
+        run->failure_stage = mojom::AgentFailureStage::kScriptIo;
+        run->error_class = "script_not_found";
+        run->final_outcome = "script_not_found";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kScriptIo,
+                            "script_not_found", false, base::Time::Now(),
+                            base::StrCat({"Script not found: ", *requested_script_id}),
+                            "script_get_failed"));
+        response->assistant_text =
+            base::StrCat({"Script not found: ", *requested_script_id});
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      run->selected_script_id = *requested_script_id;
+      UnifiedToolResultRecord result = BuildToolResult(
+          true, parsed_tool->tool, mojom::AgentFailureStage::kNone,
+          std::string(), false, base::Time::Now(),
+          base::StrCat({"Loaded script ", *requested_script_id, "."}),
+          "script_loaded");
+      result.artifacts_json =
+          BuildScriptArtifactsJson(*requested_script_id, script.Clone());
+      AppendToolTrace(*run, std::move(call), std::move(result));
+      run->final_outcome = "script_loaded";
+      response->assistant_text =
+          base::StrCat({"Loaded script ", *requested_script_id, "."});
+      response->run_state = run->run_state;
+      response->failure_stage = mojom::AgentFailureStage::kNone;
+      response->error_class.clear();
+      response->retryable = false;
+      response->trace_summary = BuildMojomRunTraceSummary(*run);
+      std::move(callback).Run(std::move(response));
+      return;
+    }
+
+    if (parsed_tool->tool == "script.save") {
+      Profile* profile = service_ ? service_->profile() : nullptr;
+      if (!profile) {
+        run->failure_stage = mojom::AgentFailureStage::kDispatch;
+        run->error_class = "profile_unavailable";
+        run->final_outcome = "profile_unavailable";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kDispatch,
+                            "profile_unavailable", false, base::Time::Now(),
+                            "Script save failed: profile unavailable.",
+                            "dispatch_failed"));
+        response->assistant_text = "Script save failed: profile unavailable.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      std::optional<std::string> requested_script_id =
+          ReadStringOption(parsed_tool->payload, "script_id", "scriptId");
+      if ((!requested_script_id.has_value() || requested_script_id->empty()) &&
+          !run->selected_script_id.empty()) {
+        requested_script_id = run->selected_script_id;
+      }
+      const base::Value::Dict* script = parsed_tool->payload.FindDict("script");
+      if (!requested_script_id.has_value() || requested_script_id->empty() ||
+          !script) {
+        run->failure_stage = mojom::AgentFailureStage::kPlanning;
+        run->error_class = "missing_script_payload";
+        run->final_outcome = "missing_script_payload";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kPlanning,
+                            "missing_script_payload", false, base::Time::Now(),
+                            "Script save requires payload.script_id and payload.script.",
+                            "planning_failed"));
+        response->assistant_text =
+            "Script save requires payload.script_id and payload.script.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      base::Value::Dict canonical = dashboard::ScriptSchema::CanonicalizeForSave(
+          script->Clone(), *requested_script_id, base::Time::Now());
+      if (!dashboard::ScriptStore::Write(profile, *requested_script_id, canonical)) {
+        run->failure_stage = mojom::AgentFailureStage::kScriptIo;
+        run->error_class = "script_write_failed";
+        run->final_outcome = "script_write_failed";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kScriptIo,
+                            "script_write_failed", true, base::Time::Now(),
+                            base::StrCat({"Failed to save script ", *requested_script_id, "."}),
+                            "script_save_failed"));
+        response->assistant_text =
+            base::StrCat({"Failed to save script ", *requested_script_id, "."});
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = true;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      run->selected_script_id = *requested_script_id;
+      UnifiedToolResultRecord result = BuildToolResult(
+          true, parsed_tool->tool, mojom::AgentFailureStage::kNone,
+          std::string(), false, base::Time::Now(),
+          base::StrCat({"Saved script ", *requested_script_id, "."}),
+          "script_saved");
+      result.artifacts_json =
+          BuildScriptArtifactsJson(*requested_script_id, canonical.Clone());
+      AppendToolTrace(*run, std::move(call), std::move(result));
+      run->final_outcome = "script_saved";
+      response->assistant_text =
+          base::StrCat({"Saved script ", *requested_script_id, "."});
+      response->run_state = run->run_state;
+      response->failure_stage = mojom::AgentFailureStage::kNone;
+      response->error_class.clear();
+      response->retryable = false;
+      response->trace_summary = BuildMojomRunTraceSummary(*run);
+      std::move(callback).Run(std::move(response));
+      return;
+    }
+
+    if (parsed_tool->tool == "executor.run_action" ||
+        parsed_tool->tool == "executor.run_timeline") {
+      Profile* profile = service_ ? service_->profile() : nullptr;
+      if (!profile) {
+        run->failure_stage = mojom::AgentFailureStage::kDispatch;
+        run->error_class = "profile_unavailable";
+        run->final_outcome = "profile_unavailable";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kDispatch,
+                            "profile_unavailable", false, base::Time::Now(),
+                            "Executor dispatch failed: profile unavailable.",
+                            "dispatch_failed"));
+        response->assistant_text = "Executor dispatch failed: profile unavailable.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = false;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      base::Value::List timeline;
+      if (parsed_tool->tool == "executor.run_action") {
+        const base::Value::Dict* action = parsed_tool->payload.FindDict("action");
+        if (!action) {
+          run->failure_stage = mojom::AgentFailureStage::kPlanning;
+          run->error_class = "missing_action";
+          run->final_outcome = "missing_action";
+          AppendToolTrace(
+              *run, std::move(call),
+              BuildToolResult(false, parsed_tool->tool,
+                              mojom::AgentFailureStage::kPlanning,
+                              "missing_action", false, base::Time::Now(),
+                              "Executor action request missing payload.action.",
+                              "planning_failed"));
+          response->assistant_text =
+              "Executor action request missing payload.action.";
+          response->run_state = mojom::AgentRunState::kFailed;
+          response->failure_stage = run->failure_stage;
+          response->error_class = run->error_class;
+          response->retryable = false;
+          response->trace_summary = BuildMojomRunTraceSummary(*run);
+          std::move(callback).Run(std::move(response));
+          return;
+        }
+        timeline.Append(action->Clone());
+      } else {
+        const base::Value::List* requested_timeline =
+            parsed_tool->payload.FindList("timeline");
+        if (!requested_timeline || requested_timeline->empty()) {
+          run->failure_stage = mojom::AgentFailureStage::kPlanning;
+          run->error_class = "missing_timeline";
+          run->final_outcome = "missing_timeline";
+          AppendToolTrace(
+              *run, std::move(call),
+              BuildToolResult(false, parsed_tool->tool,
+                              mojom::AgentFailureStage::kPlanning,
+                              "missing_timeline", false, base::Time::Now(),
+                              "Executor timeline request missing payload.timeline.",
+                              "planning_failed"));
+          response->assistant_text =
+              "Executor timeline request missing payload.timeline.";
+          response->run_state = mojom::AgentRunState::kFailed;
+          response->failure_stage = run->failure_stage;
+          response->error_class = run->error_class;
+          response->retryable = false;
+          response->trace_summary = BuildMojomRunTraceSummary(*run);
+          std::move(callback).Run(std::move(response));
+          return;
+        }
+        timeline = requested_timeline->Clone();
+      }
+
+      const std::optional<int> requested_tab_id =
+          ReadRequestedTabId(parsed_tool->payload);
+      content::WebContents* target_wc =
+          requested_tab_id.has_value()
+              ? FindWebContentsForTabId(profile, *requested_tab_id)
+              : nullptr;
+      if (!target_wc && run->requested_tab_id > 0) {
+        target_wc = FindWebContentsForTabId(profile, run->requested_tab_id);
+      }
+      if (!target_wc) {
+        if (Browser* browser = chrome::FindLastActiveWithProfile(profile)) {
+          target_wc = browser->tab_strip_model()->GetActiveWebContents();
+        }
+      }
+      if (!target_wc) {
+        run->failure_stage = mojom::AgentFailureStage::kDispatch;
+        run->error_class = "no_active_tab";
+        run->final_outcome = "no_active_tab";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kDispatch,
+                            "no_active_tab", true, base::Time::Now(),
+                            "Executor dispatch failed: no active tab.",
+                            "dispatch_failed"));
+        response->assistant_text = "Executor dispatch failed: no active tab.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = true;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      dashboard::ScriptExecutionService* exec_service =
+          dashboard::ScriptExecutionServiceFactory::GetForProfile(profile);
+      if (!exec_service) {
+        run->failure_stage = mojom::AgentFailureStage::kDispatch;
+        run->error_class = "execution_service_unavailable";
+        run->final_outcome = "execution_service_unavailable";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kDispatch,
+                            "execution_service_unavailable", true,
+                            base::Time::Now(),
+                            "Executor dispatch failed: execution service unavailable.",
+                            "dispatch_failed"));
+        response->assistant_text =
+            "Executor dispatch failed: execution service unavailable.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = true;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      const bool wait_for_completion = ReadBoolOption(
+          parsed_tool->payload, "wait_for_completion", "waitForCompletion",
+          false);
+      const base::Time started_at = base::Time::Now();
+      run->used_executor = true;
+      if (wait_for_completion) {
+        auto execution_id_ref = std::make_shared<std::string>();
+        std::string execution_id = exec_service->StartAdHocRun(
+            timeline, target_wc,
+            base::BindOnce(
+                [](base::WeakPtr<UnifiedAgentOrchestrator> self,
+                   std::string run_id, std::shared_ptr<std::string> run_exec_id,
+                   UnifiedToolCallRecord call, base::Time started_at,
+                   SendTurnCallback callback, bool success, int failed_step,
+                   std::string message) {
+                  auto response = mojom::AgentTurnResponse::New();
+                  if (!self) {
+                    response->assistant_text = "Unified orchestrator unavailable.";
+                    response->run_state = mojom::AgentRunState::kCanceled;
+                    response->failure_stage =
+                        mojom::AgentFailureStage::kDispatch;
+                    response->error_class = "orchestrator_unavailable";
+                    response->retryable = false;
+                    std::move(callback).Run(std::move(response));
+                    return;
+                  }
+                  UnifiedAgentRunRecord* run = self->FindRun(run_id);
+                  if (!run) {
+                    response->assistant_text = "Unified agent run not found.";
+                    response->run_state = mojom::AgentRunState::kFailed;
+                    response->failure_stage =
+                        mojom::AgentFailureStage::kDispatch;
+                    response->error_class = "run_not_found";
+                    response->retryable = false;
+                    std::move(callback).Run(std::move(response));
+                    return;
+                  }
+
+                  response->issued_commands.push_back(
+                      mojom::UnifiedToolCall::New(call.tool, call.payload_json));
+                  UnifiedToolResultRecord result = BuildToolResult(
+                      success, call.tool,
+                      success ? mojom::AgentFailureStage::kNone
+                              : mojom::AgentFailureStage::kExecution,
+                      success ? std::string() : "executor_run_failed",
+                      !success, started_at,
+                      success ? "Executor run completed."
+                              : base::StrCat({"Executor run failed: ", message}),
+                      success ? "executor_completed" : "executor_failed");
+                  result.artifacts_json = BuildExecutorArtifactsJson(
+                      run_exec_id ? *run_exec_id : std::string(),
+                      /*queued=*/true, /*completed=*/true);
+                  self->AppendToolTrace(*run, std::move(call), std::move(result));
+
+                  if (success) {
+                    run->final_outcome = "executor_completed";
+                    response->assistant_text =
+                        run_exec_id && !run_exec_id->empty()
+                            ? base::StringPrintf(
+                                  "Executor completed run %s.",
+                                  run_exec_id->c_str())
+                            : "Executor completed run.";
+                    response->run_state = run->run_state;
+                    response->failure_stage = mojom::AgentFailureStage::kNone;
+                    response->error_class.clear();
+                    response->retryable = false;
+                  } else {
+                    run->retry_count++;
+                    run->failure_stage = mojom::AgentFailureStage::kExecution;
+                    run->error_class = "executor_run_failed";
+                    run->final_outcome = message;
+                    response->assistant_text = base::StrCat(
+                        {"Executor run failed", failed_step >= 0
+                                                      ? base::StringPrintf(
+                                                            " at step %d", failed_step)
+                                                      : std::string(),
+                         message.empty() ? "." : base::StrCat({": ", message})});
+                    response->run_state = mojom::AgentRunState::kFailed;
+                    response->failure_stage = run->failure_stage;
+                    response->error_class = run->error_class;
+                    response->retryable = true;
+                  }
+                  response->trace_summary = BuildMojomRunTraceSummary(*run);
+                  std::move(callback).Run(std::move(response));
+                },
+                weak_ptr_factory_.GetWeakPtr(), run->run_id, execution_id_ref,
+                std::move(call), started_at, std::move(callback)));
+        if (execution_id.empty()) {
+          run->failure_stage = mojom::AgentFailureStage::kDispatch;
+          run->error_class = "executor_queue_failed";
+          run->final_outcome = "executor_queue_failed";
+          AppendToolTrace(
+              *run, UnifiedToolCallRecord{.tool = parsed_tool->tool,
+                                          .payload_json = WriteJsonDict(
+                                              parsed_tool->payload.Clone())},
+              BuildToolResult(false, parsed_tool->tool,
+                              mojom::AgentFailureStage::kDispatch,
+                              "executor_queue_failed", true, started_at,
+                              "Failed to queue executor run.",
+                              "queue_failed"));
+          response->assistant_text = "Failed to queue executor run.";
+          response->run_state = mojom::AgentRunState::kFailed;
+          response->failure_stage = run->failure_stage;
+          response->error_class = run->error_class;
+          response->retryable = true;
+          response->trace_summary = BuildMojomRunTraceSummary(*run);
+          std::move(callback).Run(std::move(response));
+          return;
+        }
+        *execution_id_ref = execution_id;
+        return;
+      }
+
+      const std::string execution_id = exec_service->StartAdHocRun(timeline, target_wc);
+      if (execution_id.empty()) {
+        run->failure_stage = mojom::AgentFailureStage::kDispatch;
+        run->error_class = "executor_queue_failed";
+        run->final_outcome = "executor_queue_failed";
+        AppendToolTrace(
+            *run, std::move(call),
+            BuildToolResult(false, parsed_tool->tool,
+                            mojom::AgentFailureStage::kDispatch,
+                            "executor_queue_failed", true, started_at,
+                            "Failed to queue executor run.", "queue_failed"));
+        response->assistant_text = "Failed to queue executor run.";
+        response->run_state = mojom::AgentRunState::kFailed;
+        response->failure_stage = run->failure_stage;
+        response->error_class = run->error_class;
+        response->retryable = true;
+        response->trace_summary = BuildMojomRunTraceSummary(*run);
+        std::move(callback).Run(std::move(response));
+        return;
+      }
+
+      UnifiedToolResultRecord result = BuildToolResult(
+          true, parsed_tool->tool, mojom::AgentFailureStage::kNone,
+          std::string(), false, started_at,
+          base::StringPrintf("Queued executor run %s with %zu step(s).",
+                             execution_id.c_str(), timeline.size()),
+          "executor_queued");
+      result.artifacts_json =
+          BuildExecutorArtifactsJson(execution_id, /*queued=*/true,
+                                     /*completed=*/false);
+      AppendToolTrace(*run, std::move(call), std::move(result));
+      run->final_outcome = "executor_queued";
+      response->assistant_text = base::StringPrintf(
+          "Queued executor run %s with %zu step(s).", execution_id.c_str(),
+          timeline.size());
+      response->run_state = run->run_state;
+      response->failure_stage = mojom::AgentFailureStage::kNone;
+      response->error_class.clear();
+      response->retryable = false;
+      response->trace_summary = BuildMojomRunTraceSummary(*run);
+      std::move(callback).Run(std::move(response));
+      return;
+    }
+
+    run->failure_stage = mojom::AgentFailureStage::kPlanning;
+    run->error_class = "unsupported_tool";
+    run->final_outcome = "unsupported_tool";
+    AppendToolTrace(
+        *run, std::move(call),
+        BuildToolResult(false, parsed_tool->tool,
+                        mojom::AgentFailureStage::kPlanning,
+                        "unsupported_tool", false, base::Time::Now(),
+                        base::StrCat({"Unsupported tool: ", parsed_tool->tool}),
+                        "planning_failed"));
+    response->assistant_text =
+        base::StrCat({"Unsupported unified tool: ", parsed_tool->tool});
+    response->run_state = mojom::AgentRunState::kFailed;
+    response->failure_stage = run->failure_stage;
+    response->error_class = run->error_class;
+    response->retryable = false;
+    response->trace_summary = BuildMojomRunTraceSummary(*run);
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+
+  if (!NeedsContextRefresh(*run, request->force_context_refresh)) {
+    UnifiedToolCallRecord call{
+        .tool = "page.inspect",
+        .payload_json = BuildInspectPayloadJson(
+            run->context_snapshots.back().snapshot_id),
+    };
+    AppendToolTrace(
+        *run, call,
+        BuildToolResult(
+            true, "page.inspect", mojom::AgentFailureStage::kNone,
+            std::string(), false, base::Time::Now(),
+            base::StringPrintf("Reused context snapshot %s for %s.",
+                               run->context_snapshots.back().snapshot_id.c_str(),
+                               run->context_snapshots.back().url.spec().c_str()),
+            "context_reused"));
+    response->assistant_text = base::StringPrintf(
+        "Context ready for %s using %s.",
+        run->context_snapshots.back().url.spec().c_str(),
+        AgentProfileToString(run->profile).c_str());
+    response->issued_commands.push_back(
+        mojom::UnifiedToolCall::New(call.tool, call.payload_json));
+    response->run_state = run->run_state;
+    response->failure_stage = mojom::AgentFailureStage::kNone;
+    response->error_class.clear();
+    response->retryable = false;
+    response->trace_summary = BuildMojomRunTraceSummary(*run);
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+
+  UnifiedToolCallRecord call{
+      .tool = "page.refresh_context",
+      .payload_json = BuildRefreshPayloadJson(
+          run->requested_tab_id,
+          request->force_context_refresh
+              ? mojom::AgentContextPolicy::kForceRefresh
+              : mojom::AgentContextPolicy::kRefreshIfStale),
+  };
+  const base::Time started_at = base::Time::Now();
+  const mojom::AgentContextPolicy policy =
+      request->force_context_refresh
+          ? mojom::AgentContextPolicy::kForceRefresh
+          : mojom::AgentContextPolicy::kRefreshIfStale;
+  context_adapter_.CaptureContextSnapshot(
+      run->profile, run->requested_tab_id, policy,
+      base::BindOnce(
+          [](base::WeakPtr<UnifiedAgentOrchestrator> self, std::string run_id,
+             UnifiedToolCallRecord call, base::Time started_at,
+             SendTurnCallback callback,
+             UnifiedAgentContextAdapter::CaptureResult result) {
+            auto response = mojom::AgentTurnResponse::New();
+            if (!self) {
+              response->assistant_text = "Unified orchestrator unavailable.";
+              response->run_state = mojom::AgentRunState::kCanceled;
+              response->failure_stage = mojom::AgentFailureStage::kDispatch;
+              response->error_class = "orchestrator_unavailable";
+              response->retryable = false;
+              std::move(callback).Run(std::move(response));
+              return;
+            }
+            UnifiedAgentRunRecord* run = self->FindRun(run_id);
+            if (!run) {
+              response->assistant_text = "Unified agent run not found.";
+              response->run_state = mojom::AgentRunState::kFailed;
+              response->failure_stage = mojom::AgentFailureStage::kDispatch;
+              response->error_class = "run_not_found";
+              response->retryable = false;
+              std::move(callback).Run(std::move(response));
+              return;
+            }
+
+            response->issued_commands.push_back(
+                mojom::UnifiedToolCall::New(call.tool, call.payload_json));
+            if (result.ok) {
+              run->context_refresh_count++;
+              run->context_snapshots.push_back(std::move(result.snapshot));
+              self->AppendToolTrace(
+                  *run, std::move(call),
+                  BuildToolResult(
+                      true, "page.refresh_context",
+                      mojom::AgentFailureStage::kNone, std::string(), false,
+                      started_at,
+                      base::StringPrintf(
+                          "Refreshed context for %s.",
+                          run->context_snapshots.back().url.spec().c_str()),
+                      "context_refreshed"));
+              response->assistant_text = base::StringPrintf(
+                  "Context refreshed for %s using %s.",
+                  run->context_snapshots.back().url.spec().c_str(),
+                  AgentProfileToString(run->profile).c_str());
+              response->run_state = run->run_state;
+              response->failure_stage = mojom::AgentFailureStage::kNone;
+              response->error_class.clear();
+              response->retryable = false;
+              response->trace_summary = BuildMojomRunTraceSummary(*run);
+              std::move(callback).Run(std::move(response));
+              return;
+            }
+
+            run->failure_stage = result.failure_stage;
+            run->error_class = result.error_class;
+            run->retry_count++;
+            run->final_outcome = result.message;
+            self->AppendToolTrace(
+                *run, std::move(call),
+                BuildToolResult(false, "page.refresh_context",
+                                result.failure_stage, result.error_class,
+                                /*retryable=*/true, started_at, result.message,
+                                "context_refresh_failed"));
+            response->assistant_text = result.message;
+            response->run_state = run->run_state;
+            response->failure_stage = result.failure_stage;
+            response->error_class = result.error_class;
+            response->retryable = true;
+            response->trace_summary = BuildMojomRunTraceSummary(*run);
+            std::move(callback).Run(std::move(response));
+          },
+          weak_ptr_factory_.GetWeakPtr(), run->run_id, std::move(call),
+          started_at, std::move(callback)));
+}
+
+void UnifiedAgentOrchestrator::CancelRun(const std::string& run_id,
+                                         CancelRunCallback callback) {
+  auto response = mojom::AgentCancelResponse::New();
+  UnifiedAgentRunRecord* run = FindRun(run_id);
+  if (!run) {
+    response->canceled = false;
+    response->run_state = mojom::AgentRunState::kFailed;
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+  run->run_state = mojom::AgentRunState::kCanceled;
+  run->updated_at = base::Time::Now();
+  run->final_outcome = "canceled_by_user";
+  response->canceled = true;
+  response->run_state = run->run_state;
+  std::move(callback).Run(std::move(response));
+}
+
+void UnifiedAgentOrchestrator::GetRunTrace(const std::string& run_id,
+                                           GetTraceCallback callback) const {
+  const UnifiedAgentRunRecord* run = FindRun(run_id);
+  std::move(callback).Run(run ? BuildMojomRunTrace(*run) : nullptr);
+}
+
+void UnifiedAgentOrchestrator::ListRecentRuns(ListRunsCallback callback) const {
+  std::vector<mojom::AgentRunTraceSummaryPtr> out;
+  out.reserve(recent_run_ids_.size());
+  for (const auto& run_id : recent_run_ids_) {
+    const UnifiedAgentRunRecord* run = FindRun(run_id);
+    if (!run) {
+      continue;
+    }
+    out.push_back(BuildMojomRunTraceSummary(*run));
+  }
+  std::move(callback).Run(std::move(out));
+}
+
+void UnifiedAgentOrchestrator::ExpandElementRefs(
+    const std::string& run_id,
+    const std::string& snapshot_id,
+    const std::vector<std::string>& element_refs,
+    ExpandElementRefsCallback callback) const {
+  const UnifiedAgentRunRecord* run = FindRun(run_id);
+  if (!run) {
+    std::move(callback).Run({});
+    return;
+  }
+  const UnifiedAgentContextSnapshotRecord* snapshot = nullptr;
+  for (const auto& candidate : run->context_snapshots) {
+    if (candidate.snapshot_id == snapshot_id) {
+      snapshot = &candidate;
+      break;
+    }
+  }
+  if (!snapshot) {
+    std::move(callback).Run({});
+    return;
+  }
+
+  std::vector<mojom::ElementRefBundlePtr> out;
+  for (const auto& requested_ref : element_refs) {
+    for (const auto& element : snapshot->elements) {
+      if (element.element_ref != requested_ref) {
+        continue;
+      }
+      out.push_back(BuildMojomElementRefBundle(element));
+      break;
+    }
+  }
+  std::move(callback).Run(std::move(out));
+}
+
+}  // namespace glic
