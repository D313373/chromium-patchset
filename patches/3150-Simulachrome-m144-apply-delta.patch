+-void DashboardUIMessageHandler::HandleAgentConsoleProxy(
+-    const base::Value::List& args) {
+-  const std::string cb =
+-      (args.size() > 0 && args[0].is_string()) ? args[0].GetString() : std::string();
+-  const base::Value::Dict* payload =
+-      (args.size() > 1 && args[1].is_dict()) ? &args[1].GetDict() : nullptr;
+-
+-  base::Value::Dict out;
+-  if (!payload) {
+-    out.Set("ok", false);
+-    out.Set("error", "missing payload");
+-    ResolveCallback(cb, out);
+-    return;
+-  }
+-
+-  std::string body_json;
+-  const base::Value* body_val = payload->Find("body");
+-  if (!body_val) {
+-    out.Set("ok", false);
+-    out.Set("error", "missing body");
+-    ResolveCallback(cb, out);
+-    return;
+-  }
+-
+-  if (body_val->is_dict() || body_val->is_list()) {
+-    base::JSONWriter::Write(*body_val, &body_json);
+-  } else if (body_val->is_string()) {
+-    body_json = body_val->GetString();
+-  } else {
+-    out.Set("ok", false);
+-    out.Set("error", "unsupported body type");
+-    ResolveCallback(cb, out);
+-    return;
+-  }
+-
+-  auto request = std::make_unique<network::ResourceRequest>();
+-  request->method = "POST";
+-  request->url = GURL("http://127.0.0.1:11434/api/chat");
+-  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+-  request->headers.SetHeader("Content-Type", "application/json");
+-  request->headers.SetHeader("Accept", "application/json");
+-
+-  auto loader = network::SimpleURLLoader::Create(std::move(request),
+-                                                 TRAFFIC_ANNOTATION_FOR_TESTS);
+-  loader->AttachStringForUpload(body_json, "application/json");
+-
+-  auto* partition = profile_->GetDefaultStoragePartition();
+-  auto factory = partition->GetURLLoaderFactoryForBrowserProcess();
+-
+-  // Stream results to the JS console as they arrive.
+-  class OllamaStreamConsumer : public network::SimpleURLLoaderStreamConsumer {
+-   public:
+-    OllamaStreamConsumer(base::WeakPtr<DashboardUIMessageHandler> owner,
+-                         std::string cb,
+-                         std::unique_ptr<network::SimpleURLLoader> loader)
+-        : owner_(std::move(owner)), cb_(std::move(cb)), loader_(std::move(loader)) {}
+-    ~OllamaStreamConsumer() override = default;
+-
+-    void OnDataReceived(std::string_view data, base::OnceClosure resume) override {
+-      buffer_.append(data.data(), data.size());
+-      size_t pos = 0;
+-      for (;;) {
+-        size_t nl = buffer_.find('\n', pos);
+-        if (nl == std::string::npos)
+-          break;
+-        std::string line = buffer_.substr(pos, nl - pos);
+-        pos = nl + 1;
+-        if (line.empty()) continue;
+-        std::optional<base::Value> v = base::JSONReader::Read(
+-            line, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+-        if (!v || !v->is_dict()) continue;
+-        const base::Value::Dict& d = v->GetDict();
+-        const std::string* s = nullptr;
+-        if (const base::Value::Dict* msg = d.FindDict("message")) s = msg->FindString("content");
+-        if (!s) s = d.FindString("response");
+-        if (!s) s = d.FindString("delta");
+-        if (s && owner_) {
+-          // Broadcast to all open dashboard/overlay instances so chats mirror.
+-          DashboardUIMessageHandler::BroadcastAiChunk(cb_, *s);
+-        }
+-        if (const base::Value::List* ctx = d.FindList("context")) {
+-          last_context_ = ctx->Clone();
+-        }
+-        if (d.FindBool("done").value_or(false) && owner_ && !done_sent_) {
+-          done_sent_ = true;
+-          base::Value::Dict meta;
+-          if (!last_context_.empty())
+-            meta.Set("ollama_context", last_context_.Clone());
+-          DashboardUIMessageHandler::BroadcastAiDone(cb_, /*ok=*/true, /*err=*/"",
+-                                                     meta);
+-        }
+-      }
+-      if (pos > 0 && pos <= buffer_.size()) buffer_.erase(0, pos);
+-      std::move(resume).Run();
+-    }
+-    void OnComplete(bool success) override {
+-      if (owner_) {
+-        if (!buffer_.empty()) {
+-          std::optional<base::Value> v = base::JSONReader::Read(
+-              buffer_, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+-          if (v && v->is_dict()) {
+-            const base::Value::Dict& d = v->GetDict();
+-            const std::string* s = nullptr;
+-            if (const base::Value::Dict* msg = d.FindDict("message")) s = msg->FindString("content");
+-            if (!s) s = d.FindString("response");
+-            if (!s) s = d.FindString("delta");
+-            if (s) DashboardUIMessageHandler::BroadcastAiChunk(cb_, *s);
+-            if (const base::Value::List* ctx = d.FindList("context")) {
+-              last_context_ = ctx->Clone();
+-            }
+-          }
+-        }
+-        if (!done_sent_) {
+-          base::Value::Dict meta;
+-          if (!last_context_.empty())
+-            meta.Set("ollama_context", last_context_.Clone());
+-          DashboardUIMessageHandler::BroadcastAiDone(cb_, /*ok=*/success,
+-                                                     /*err=*/"",
+-                                                     meta);
+-        }
+-      }
+-      delete this;
+-    }
+-    void OnRetry(base::OnceClosure start_retry) override {
+-      buffer_.clear();
+-      done_sent_ = false;
+-      last_context_.clear();
+-      std::move(start_retry).Run();
+-    }
+-   private:
+-    base::WeakPtr<DashboardUIMessageHandler> owner_;
+-    std::string cb_;
+-    std::string buffer_;
+-    bool done_sent_ = false;
+-    base::Value::List last_context_;
+-    std::unique_ptr<network::SimpleURLLoader> loader_;
+-  };
+-
+-  loader->DownloadAsStream(factory.get(),
+-                           new OllamaStreamConsumer(weak_ptr_factory_.GetWeakPtr(), cb,
+-                                                    std::move(loader)));
+-}
