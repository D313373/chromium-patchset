+if ! wait "$CHROME_PID"; then
+    CHROME_WAIT_EXIT=$?
+fi
+
+if [[ "$AUTO_DASHBOARD_SCRIPT_EXIT" != "0" ]]; then
+    exit "$AUTO_DASHBOARD_SCRIPT_EXIT"
+fi
+
+if [[ "$EXIT_AFTER_DASHBOARD_SCRIPT" == "1" && "$CHROME_WAIT_EXIT" == "143" ]]; then
+    CHROME_WAIT_EXIT=0
+fi
+
+if [[ "$CHROME_WAIT_EXIT" != "0" ]]; then
+    exit "$CHROME_WAIT_EXIT"
+fi
 
