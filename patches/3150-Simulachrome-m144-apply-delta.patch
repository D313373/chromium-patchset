+
+std::string BuildResourcePath(const Element& element) {
+  std::vector<std::string> segments;
+  const Node* node = &element;
+  while (node) {
+    const Element* el = DynamicTo<Element>(node);
+    if (!el) {
+      break;
+    }
+    segments.push_back(LowerTagName(*el) + "[" +
+                       base::NumberToString(IndexAmongSameTagSiblings(*el)) +
+                       "]");
+    node = el->ParentOrShadowHostNode();
+  }
+  if (segments.empty()) {
+    return std::string();
+  }
+  std::reverse(segments.begin(), segments.end());
+  return std::string("/") + base::JoinString(segments, "/");
