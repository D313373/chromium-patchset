+void CaptureHeadlessTaskContext(
+    Profile* profile,
+    const std::string& task_id,
+    const base::Value::Dict& request,
+    HeadlessInvestigationCallback callback) {
+  base::Value::Dict out;
+  out.Set("entrypoint", "GetContext");
+  out.Set("task_id", task_id);
+  out.Set("taskId", task_id);
+
+  HeadlessTaskState* state = FindHeadlessTask(profile, task_id);
+  content::WebContents* wc = ResolveLiveHeadlessTaskWebContents(state);
+  if (!wc) {
+    out.Set("ok", false);
+    out.Set("error", "Task target tab is unavailable.");
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+
+  const int tab_id = sessions::SessionTabHelper::IdForTab(wc).id();
+  out.Set("ok", true);
+  out.Set("tab_id", tab_id);
+  out.Set("tabId", tab_id);
+  out.Set("url", wc->GetLastCommittedURL().spec());
+  out.Set("title", base::UTF16ToUTF8(wc->GetTitle()));
+  out.Set("ready_state", wc->IsLoading() ? "loading" : "complete");
+  out.Set("element_count", 0);
+  out.Set("inner_text_excerpt", std::string());
+  out.Set("links", base::Value::List());
+  out.Set("inputs", base::Value::List());
+  out.Set("buttons", base::Value::List());
+  out.Set("screenshot_path", std::string());
+  out.Set("screenshot_image_base64", std::string());
+
+  if (request.FindDict("probe")) {
+    base::Value::Dict probe;
+    probe.Set("supported", false);
+    probe.Set("reason",
+              "Probe extraction is not implemented for task entrypoint mode "
+              "yet.");
+    out.Set("locator_probe", std::move(probe));
+  } else {
+    out.Set("locator_probe", base::Value::Dict());
+  }
+
+  FetchUnifiedPageMapSnapshot(
+      wc,
+      base::BindOnce(
+          [](base::Value::Dict out, HeadlessInvestigationCallback callback,
+             UnifiedPageMapResult result) {
+            if (!result.ok) {
+              out.Set("ok", false);
+              out.Set("error", result.error.empty()
+                                   ? std::string("unified_page_map_failed")
+                                   : result.error);
+              std::move(callback).Run(std::move(out));
+              return;
+            }
+            const base::Value::Dict* metadata =
+                result.page_map.FindDict("metadata");
+            int element_count = 0;
+            if (metadata) {
+              element_count =
+                  metadata->FindInt("interactiveCount").value_or(0);
+            }
+            out.Set("element_count", element_count);
+            out.Set("page_map", result.page_map.Clone());
+            out.Set("pageMap", std::move(result.page_map));
+            std::move(callback).Run(std::move(out));
+          },
+          std::move(out), std::move(callback)),
+      dashboard::mojom::SearchScope::kAll);
+}
+
+void PerformHeadlessTaskActions(Profile* profile,
+                                const std::string& task_id,
+                                base::Value::List actions,
+                                const ScriptExecutionService::RunOptions& options,
+                                InvestigateActionsCompletionCallback callback) {
+  HeadlessTaskState* state = FindHeadlessTask(profile, task_id);
+  content::WebContents* wc = ResolveLiveHeadlessTaskWebContents(state);
+  if (!wc) {
+    base::Value::Dict out;
+    out.Set("entrypoint", "PerformActions");
+    out.Set("ok", false);
+    out.Set("error", "Task target tab is unavailable.");
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+  if (actions.empty()) {
+    base::Value::Dict out;
+    out.Set("entrypoint", "PerformActions");
+    out.Set("ok", true);
+    out.Set("message", "No actions to perform.");
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+
+  ScriptExecutionService* exec_service =
+      ScriptExecutionServiceFactory::GetForProfile(profile);
+  if (!exec_service) {
+    base::Value::Dict out;
+    out.Set("entrypoint", "PerformActions");
+    out.Set("ok", false);
+    out.Set("error", "Execution service unavailable.");
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+
+  if (!state->active_execution_id.empty()) {
+    exec_service->StopRun(state->active_execution_id,
+                          "headless task preempted by new action batch");
+    state->active_execution_id.clear();
+  }
+
+  auto execution_id_ref = std::make_shared<std::string>();
+  std::string execution_id = exec_service->StartAdHocRunWithOptions(
+      actions, wc, options,
+      base::BindOnce(
+          [](Profile* profile, std::string task_id,
+             std::shared_ptr<std::string> execution_id_ref,
+             InvestigateActionsCompletionCallback callback, bool success,
+             int failed_step, std::string message) {
+            if (HeadlessTaskState* task = FindHeadlessTask(profile, task_id)) {
+              if (execution_id_ref &&
+                  task->active_execution_id == *execution_id_ref) {
+                task->active_execution_id.clear();
+              }
+            }
+            base::Value::Dict out;
+            out.Set("entrypoint", "PerformActions");
+            out.Set("ok", success);
+            if (execution_id_ref && !execution_id_ref->empty()) {
+              out.Set("execution_id", *execution_id_ref);
+              out.Set("executionId", *execution_id_ref);
+            }
+            if (failed_step >= 0) {
+              out.Set("failed_step", failed_step);
+              out.Set("failedStep", failed_step);
+            }
+            if (!message.empty()) {
+              out.Set(success ? "message" : "error", message);
+            }
+            std::move(callback).Run(std::move(out));
+          },
+          base::Unretained(profile), task_id, execution_id_ref,
+          std::move(callback)));
+  if (execution_id.empty()) {
+    base::Value::Dict out;
+    out.Set("entrypoint", "PerformActions");
+    out.Set("ok", false);
+    out.Set("error", "Failed to queue action batch.");
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+  *execution_id_ref = execution_id;
+  state->active_execution_id = execution_id;
+}
+
+base::Value::Dict CreateHeadlessTask(Profile* profile,
+                                     const base::Value::Dict& request,
+                                     std::string* out_task_id) {
+  base::Value::Dict out;
+  out.Set("entrypoint", "CreateTask");
+
+  if (!profile) {
+    out.Set("ok", false);
+    out.Set("error", "Missing profile.");
+    return out;
+  }
+
+  content::WebContents* target_wc = nullptr;
+  Browser* target_browser = nullptr;
+  bool owns_tab = false;
+
+  const std::optional<int> requested_tab_id = ReadRequestedTabId(request);
+  if (requested_tab_id.has_value()) {
+    target_wc = FindWebContentsForTabId(profile, *requested_tab_id);
+    target_browser = FindBrowserForWebContents(profile, target_wc);
+    if (!target_wc || !target_browser) {
+      out.Set("ok", false);
+      out.Set("error",
+              base::StringPrintf("No tab found for tab_id=%d",
+                                 *requested_tab_id));
+      return out;
+    }
+  } else {
+    target_browser = chrome::FindLastActiveWithProfile(profile);
+    if (!target_browser) {
+      out.Set("ok", false);
+      out.Set("error", "No active browser to create investigation tab.");
+      return out;
+    }
+
+    NavigateParams np(target_browser, GURL("about:blank"),
+                      ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    np.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    Navigate(&np);
+    target_wc = np.navigated_or_inserted_contents;
+    owns_tab = true;
+
+    if (!target_wc) {
+      out.Set("ok", false);
+      out.Set("error", "Failed to create investigation tab.");
+      return out;
+    }
+  }
+
+  std::string task_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  auto read_non_empty = [&request](std::initializer_list<const char*> keys) {
+    for (const char* key : keys) {
+      const std::string* s = request.FindString(key);
+      if (s && !s->empty()) {
+        return *s;
+      }
+    }
+    return std::string();
+  };
+  const std::string preferred_url =
+      read_non_empty({"url", "start_url", "startUrl"});
+  const std::string open_reason =
+      read_non_empty({"open_reason", "openReason", "reason", "purpose",
+                      "source"});
+  const std::string display_label =
+      read_non_empty({"label", "name", "task_label", "taskLabel"});
+  auto task_state = std::make_unique<HeadlessTaskState>();
+  task_state->browser = target_browser;
+  task_state->web_contents = target_wc;
+  task_state->owns_tab = owns_tab;
+  task_state->open_reason =
+      open_reason.empty() ? "agentic script repair" : open_reason;
+  task_state->display_label =
+      display_label.empty() ? "Investigation" : display_label;
+  task_state->preferred_url = preferred_url;
+  task_state->observer->Watch(target_wc);
+
+  auto& by_profile = HeadlessInvestigateTasks();
+  by_profile[profile][task_id] = std::move(task_state);
+
+  const int tab_id = sessions::SessionTabHelper::IdForTab(target_wc).id();
+  out.Set("ok", true);
+  out.Set("task_id", task_id);
+  out.Set("taskId", task_id);
+  out.Set("tab_id", tab_id);
+  out.Set("tabId", tab_id);
+  out.Set("owns_tab", owns_tab);
+  out.Set("ownsTab", owns_tab);
+  out.Set("url", target_wc->GetLastCommittedURL().spec());
+
+  if (out_task_id) {
+    *out_task_id = task_id;
+  }
+  return out;
+}
