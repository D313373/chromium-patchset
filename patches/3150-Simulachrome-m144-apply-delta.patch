+-function locatorRank(type) {
+-  // Prefer "rich" locators (a11y/text) over raw selectors so it's obvious when
+-  // we are harvesting enhanced locator bundles.
+-  switch (String(type || '').toUpperCase()) {
+-    case 'ACCESSIBILITY_NAME':
+-      return 0;
+-    case 'LINK_TEXT':
+-      return 1;
+-    case 'PARTIAL_LINK_TEXT':
+-      return 2;
+-    case 'TEXT_CONTENT':
+-      return 3;
+-    case 'ID':
+-      return 4;
+-    case 'NAME':
+-      return 5;
+-    case 'CSS_SELECTOR':
+-      return 6;
+-    case 'XPATH':
+-      return 7;
+-    case 'SHADOW_DOM':
+-      return 8;
+-    case 'CLASS_NAME':
+-      return 9;
+-    case 'TAG_NAME':
+-      return 10;
+-    case 'JS_EVAL':
+-      return 11;
+-    case 'VISUAL_COORDS':
+-      return 12;
+-    case 'VISUAL_AI':
+-      return 13;
+-    default:
+-      return 99;
+-  }
+-}
