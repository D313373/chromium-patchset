+base::Value::List BuildInvestigateActions(const base::Value::Dict& payload) {
+  base::Value::List merged;
+
+  const base::Value::Dict* action_payload = &payload;
+  const base::Value::Dict* url_payload = &payload;
+  std::optional<base::Value::Dict> single_action_step;
+  if (const std::string* command = payload.FindString("command")) {
+    if (const base::Value::Dict* nested_payload = payload.FindDict("payload")) {
+      if (*command == "call_action") {
+        if (const std::string* nested_action =
+                nested_payload->FindString("action")) {
+          single_action_step.emplace();
+          single_action_step->Set("action", *nested_action);
+          if (const base::Value::Dict* params = nested_payload->FindDict("params")) {
+            single_action_step->Set("params", params->Clone());
+          } else {
+            single_action_step->Set("params", base::Value::Dict());
+          }
+        }
+      } else if (*command == "run_timeline") {
+        action_payload = nested_payload;
+      }
+      action_payload = nested_payload;
+      url_payload = &payload;
+    }
+  }
+
+  const std::string* url = url_payload->FindString("url");
+  if (!url || url->empty()) {
+    url = url_payload->FindString("start_url");
+  }
+  if ((!url || url->empty()) && url_payload != action_payload) {
+    url = action_payload->FindString("url");
+    if (!url || url->empty()) {
+      url = action_payload->FindString("start_url");
+    }
+  }
+  if (url && !url->empty()) {
+    GURL start_url(*url);
+    if (start_url.is_valid()) {
+      base::Value::Dict navigate_step;
+      navigate_step.Set("action", "navigate");
+      base::Value::Dict params;
+      params.Set("url", start_url.spec());
+      navigate_step.Set("params", std::move(params));
+      merged.Append(std::move(navigate_step));
+    }
+  }
+  if (const base::Value::List* timeline = action_payload->FindList("timeline")) {
+    for (const auto& step : *timeline) {
+      if (step.is_dict()) {
+        merged.Append(step.Clone());
+      }
+    }
+    return merged;
+  }
+  if (const base::Value::List* actions = action_payload->FindList("actions")) {
+    for (const auto& step : *actions) {
+      if (step.is_dict()) {
+        merged.Append(step.Clone());
+      }
+    }
+    return merged;
+  }
+  if (single_action_step.has_value()) {
+    merged.Append(std::move(*single_action_step));
+  } else if (const std::string* action_name = action_payload->FindString("action")) {
+    base::Value::Dict step;
+    step.Set("action", *action_name);
+    if (const base::Value::Dict* params = action_payload->FindDict("params")) {
+      step.Set("params", params->Clone());
+    } else {
+      step.Set("params", base::Value::Dict());
+    }
+    merged.Append(std::move(step));
+  }
+  return merged;
+}
+
+ScriptExecutionService::RunOptions BuildInvestigateRunOptions(
+    const base::Value::Dict& payload) {
+  ScriptExecutionService::RunOptions options;
+  auto read_force_cdp = [](const base::Value::Dict& dict) -> std::optional<bool> {
+    if (std::optional<bool> force =
+            ParseBoolLikeValue(dict.Find("force_cdp_execution"));
+        force.has_value()) {
+      return force;
+    }
+    if (std::optional<bool> force =
+            ParseBoolLikeValue(dict.Find("forceCdpExecution"));
+        force.has_value()) {
+      return force;
+    }
+    if (const base::Value::Dict* execution = dict.FindDict("execution")) {
+      if (const std::string* primary = execution->FindString("primary")) {
+        if (base::EqualsCaseInsensitiveASCII(*primary, "cdp")) {
+          return true;
+        }
+      }
+    }
+    return std::nullopt;
+  };
+
+  if (std::optional<bool> force = read_force_cdp(payload); force.has_value()) {
+    options.force_cdp_execution = *force;
+    return options;
+  }
+  if (const base::Value::Dict* nested_options = payload.FindDict("options")) {
+    if (std::optional<bool> force = read_force_cdp(*nested_options);
+        force.has_value()) {
+      options.force_cdp_execution = *force;
+    }
+  }
+  return options;
+}
