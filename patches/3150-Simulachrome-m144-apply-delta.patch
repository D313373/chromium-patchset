+  params->Remove("frameId");
+  params->Remove("resource_path");
+  params->Remove("shadow_chain");
+  if (const base::Value::List* existing = params->FindList("locators")) {
+    base::Value::List filtered;
+    for (const auto& locator :
+         BuildTypingFocusLocators(dashboard::ConvertLocators(*existing))) {
+      filtered.Append(dashboard::LocatorToValue(locator));
