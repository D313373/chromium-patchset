+void RecorderController::OnScrollSnapshotEvaluated(std::string res_json,
+                                                   std::string err_json) {
+  if (!is_recording_ || dashboard::IsRecordingSuppressed())
+    return;
+
+  std::optional<base::Value> val = ExtractRuntimeValue(res_json);
+  if (!val || !val->is_dict()) {
+    if (!err_json.empty()) {
+      VLOG(1) << "[Recorder] scroll snapshot eval error: " << err_json;
+    }
+    return;
+  }
+
+  const base::Value::Dict& dict = val->GetDict();
+  const double percent_y =
+      std::clamp(dict.FindDouble("percentY").value_or(0.0), 0.0, 100.0);
+  const double percent_x =
+      std::clamp(dict.FindDouble("percentX").value_or(0.0), 0.0, 100.0);
+  const double scroll_y = std::max(0.0, dict.FindDouble("scrollY").value_or(0.0));
+
+  constexpr double kMinPercentDelta = 0.15;
+  constexpr double kMinPixelDelta = 10.0;
+  if (last_recorded_scroll_percent_y_ && last_recorded_scroll_percent_x_) {
+    const double dy = std::abs(percent_y - *last_recorded_scroll_percent_y_);
+    const double dx = std::abs(percent_x - *last_recorded_scroll_percent_x_);
+    const double pixel_delta = last_recorded_scroll_y_
+                                   ? std::abs(scroll_y - *last_recorded_scroll_y_)
+                                   : 0.0;
+    if (dy < kMinPercentDelta && dx < kMinPercentDelta &&
+        pixel_delta < kMinPixelDelta) {
+      return;
+    }
+  }
+  const std::optional<double> prev_scroll_y = last_recorded_scroll_y_;
+  last_recorded_scroll_percent_y_ = percent_y;
+  last_recorded_scroll_percent_x_ = percent_x;
+  last_recorded_scroll_y_ = scroll_y;
+  if (!prev_scroll_y) {
+    return;
+  }
+
+  const double delta = scroll_y - *prev_scroll_y;
+  if (std::abs(delta) < kMinPixelDelta) {
+    return;
+  }
+
+  base::Value::Dict action;
+  action.Set("action", "scroll");
+  base::Value::Dict params;
+  params.Set("element", "window");
+  params.Set("distance", static_cast<int>(std::lround(delta)));
+  params.Set("percentY", percent_y);
+  params.Set("percentX", percent_x);
+  action.Set("params", std::move(params));
+  AppendRecordedAction(std::move(action));
+}
