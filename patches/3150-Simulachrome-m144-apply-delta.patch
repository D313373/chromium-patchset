+    } else if (base::EqualsCaseInsensitiveASCII(*type, "PLACEHOLDER")) {
+      hint = base::StrCat({"placeholder=", TruncateForPrompt(*value, 48u)});
+    }
+    if (hint.empty() || !seen.insert(hint).second) {
+      continue;
