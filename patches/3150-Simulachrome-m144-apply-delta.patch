+std::string SanitizeSavedScriptName(std::string name) {
+  name = std::string(base::TrimWhitespaceASCII(name, base::TRIM_ALL));
+  if (name.empty()) {
+    return "Saved Agent Script";
+  }
+  if (name.size() > 80u) {
+    name.resize(80u);
+  }
+  return name;
+}
+
+base::Value::Dict BuildScreenshotRequestMetadata(
+    const base::Value::Dict* element,
+    const base::Value::Dict& payload) {
+  base::Value::Dict metadata;
+  metadata.Set("scope", element ? "targeted" : "viewport");
+  if (payload.FindBool("fullPage").value_or(false)) {
+    metadata.Set("requested_full_page", true);
+  }
+  if (!element) {
+    return metadata;
+  }
+  if (const std::string* id = element->FindString("id"); id && !id->empty()) {
+    metadata.Set("snapshotId", *id);
+  }
+  if (const std::string* label = payload.FindString("label");
+      label && !label->empty()) {
+    metadata.Set("label", *label);
+  }
+  if (const std::string* text = element->FindString("text");
+      text && !text->empty()) {
+    metadata.Set("text", TruncateForPrompt(*text, 120u));
+  } else if (const std::string* ax_name =
+                 element->FindString("accessibilityName");
+             ax_name && !ax_name->empty()) {
+    metadata.Set("text", TruncateForPrompt(*ax_name, 120u));
+  }
+  if (const std::string* role = element->FindString("role");
+      role && !role->empty()) {
+    metadata.Set("role", *role);
+  }
+  return metadata;
+}
+
+std::pair<std::optional<gfx::RectF>, base::Value::Dict> ResolveScreenshotRequest(
+    const base::Value::Dict& payload,
+    const base::Value::List& focus_areas,
+    const base::Value::Dict& page_map) {
+  if (payload.FindBool("fullPage").value_or(false)) {
+    return {std::nullopt, BuildScreenshotRequestMetadata(nullptr, payload)};
+  }
+
+  const base::Value::Dict* element = nullptr;
+  for (const char* key :
+       {"snapshotId", "snapshot_id", "elementId", "element_id", "id"}) {
+    if (const std::string* snapshot_id = payload.FindString(key);
+        snapshot_id && !snapshot_id->empty()) {
+      element = FindElementBySnapshotId(page_map, *snapshot_id);
+      if (element) {
+        break;
+      }
+    }
+  }
+  if (!element) {
+    if (const std::string* label = payload.FindString("label");
+        label && !label->empty()) {
+      if (const base::Value::Dict* area = FindFocusAreaByLabel(focus_areas, *label)) {
+        if (const base::Value::List* locators = area->FindList("locators")) {
+          element = FindElementByLocators(page_map, *locators);
+        }
+      }
+    }
+  }
+  if (!element) {
+    if (const base::Value::List* locators = payload.FindList("locators")) {
+      element = FindElementByLocators(page_map, *locators);
+    }
+  }
+  if (!element && payload.empty() && focus_areas.size() == 1u) {
+    const base::Value::Dict* area = focus_areas.front().GetIfDict();
+    const base::Value::List* locators = area ? area->FindList("locators")
+                                             : nullptr;
+    if (locators) {
+      element = FindElementByLocators(page_map, *locators);
+    }
+  }
+
+  base::Value::Dict metadata = BuildScreenshotRequestMetadata(element, payload);
+  if (!element) {
+    return {std::nullopt, std::move(metadata)};
+  }
+  return {ReadElementBounds(*element), std::move(metadata)};
+}
+
+base::Value::Dict NormalizeModelActionPayload(std::string_view command_name,
+                                              const base::Value::Dict* payload) {
+  base::Value::Dict wrapper;
+  const std::string command_lower = base::ToLowerASCII(command_name);
+  std::string action_name(command_name);
+  base::Value::Dict params = payload ? payload->Clone() : base::Value::Dict();
+
+  if (command_lower == "fill") {
+    action_name = "type";
+  } else if (command_lower == "click_element") {
+    action_name = "click";
+  } else if (command_lower == "get_element_text") {
+    action_name = "scrape_element";
+    if (!params.Find("variableName")) {
+      params.Set("variableName", "__agent_scraped_text");
+    }
+    if (!params.Find("dataType")) {
+      params.Set("dataType", "text");
+    }
+  } else if (command_lower == "wait_for_element") {
+    action_name = "wait";
+    if (!params.Find("waitType")) {
+      params.Set("waitType", "element");
+    }
+  }
+
+  if (base::EqualsCaseInsensitiveASCII(action_name, "wait")) {
+    if (!params.Find("waitType")) {
+      params.Set("waitType", "time");
+    }
+    if (!params.Find("time")) {
+      if (std::optional<int> timeout_ms = params.FindInt("timeout_ms")) {
+        params.Set("time", *timeout_ms);
+        params.Remove("timeout_ms");
+      } else if (std::optional<int> timeout = params.FindInt("timeout")) {
+        params.Set("time", *timeout);
+      }
+    }
+  }
+
+  if (!params.Find("locators")) {
+    if (const std::string* selector = params.FindString("selector");
+        selector && !selector->empty()) {
+      base::Value::List locators;
+      base::Value::Dict locator;
+      locator.Set("type", "CSS_SELECTOR");
+      locator.Set("value", *selector);
+      locators.Append(std::move(locator));
+      params.Set("locators", std::move(locators));
+      params.Remove("selector");
+    }
+  }
+
+  wrapper.Set("action", action_name);
+  wrapper.Set("params", std::move(params));
+  return wrapper;
+}
+
+base::Value::Dict ResolveElementIdTargetsInCommand(
+    const base::Value::Dict& command,
+    const base::Value::Dict& page_map) {
+  base::Value::Dict resolved = command.Clone();
+  base::Value::Dict* payload = resolved.FindDict("payload");
+  if (!payload) {
+    return resolved;
+  }
+  base::Value::Dict* params = payload->FindDict("params");
+  if (!params) {
+    return resolved;
+  }
+  const base::Value::List* locators = params->FindList("locators");
+  if (locators && !locators->empty()) {
+    return resolved;
+  }
+  std::string snapshot_id;
+  for (const char* key : {"element_id", "elementId", "snapshot_id", "snapshotId", "id"}) {
+    if (const std::string* value = params->FindString(key);
+        value && !value->empty()) {
+      snapshot_id = *value;
+      break;
+    }
+  }
+  if (snapshot_id.empty()) {
+    return resolved;
+  }
+  const base::Value::Dict* element = FindElementBySnapshotId(page_map, snapshot_id);
+  if (!element) {
+    return resolved;
+  }
+  base::Value::List resolved_locators = BuildLocatorsFromElementSelectors(*element);
+  if (resolved_locators.empty()) {
+    return resolved;
+  }
+  params->Set("locators", std::move(resolved_locators));
+  params->Remove("element_id");
+  params->Remove("elementId");
+  params->Remove("snapshot_id");
+  params->Remove("snapshotId");
+  params->Remove("id");
+  return resolved;
+}
+
+base::Value::Dict ResolveFocusAreaLabelTargetsInCommand(
+    const base::Value::Dict& command,
+    const base::Value::List& focus_areas) {
+  base::Value::Dict resolved = command.Clone();
+  base::Value::Dict* payload = resolved.FindDict("payload");
+  if (!payload) {
+    return resolved;
+  }
+  const std::string* action_name = payload->FindString("action");
+  base::Value::Dict* params = payload->FindDict("params");
+  if (!params) {
+    return resolved;
+  }
+  const base::Value::List* locators = params->FindList("locators");
+  if (locators && !locators->empty()) {
+    return resolved;
+  }
+
+  const std::string* label = params->FindString("label");
+  if (!label || label->empty()) {
+    return resolved;
+  }
+  const base::Value::Dict* area = FindFocusAreaByLabel(focus_areas, *label);
+  if (!area) {
+    return resolved;
+  }
+  const base::Value::List* area_locators = area->FindList("locators");
+  if (!area_locators || area_locators->empty()) {
+    return resolved;
+  }
+  base::Value::List sanitized = SanitizeLocatorsForAgentExecution(*area_locators);
+  if (sanitized.empty()) {
+    return resolved;
+  }
+  params->Set("locators", std::move(sanitized));
+  if (action_name && base::EqualsCaseInsensitiveASCII(*action_name, "scrape_element")) {
+    if (!params->Find("variableName")) {
+      params->Set("variableName", "__agent_scraped_text");
+    }
+    if (!params->Find("dataType")) {
+      params->Set("dataType", "text");
+    }
+  }
+  params->Remove("label");
+  return resolved;
+}
+
+base::Value::Dict NormalizeAgentCommandForExecution(
+    const base::Value::Dict& command) {
+  const std::string* command_name = command.FindString("command");
+  if (!command_name || command_name->empty()) {
+    return command.Clone();
+  }
+  if (*command_name == "call_action" || *command_name == "run_timeline" ||
+      *command_name == "refresh_pagemap" ||
+      *command_name == "request_more_context" ||
+      *command_name == "request_more_controls" ||
+      *command_name == "request_primary_options" ||
+      *command_name == "request_screenshot" ||
+      *command_name == "reload_page" ||
+      *command_name == "inspect_element" ||
+      *command_name == "save_task_script" ||
+      *command_name == "save_recent_actions_as_script" ||
+      *command_name == "promote_span_to_macro" ||
+      *command_name == "screenshot" ||
+      *command_name == "inspect_image" ||
+      *command_name == "call_macro" ||
+      *command_name == "request_full_context" ||
+      *command_name == "agent_finish") {
+    base::Value::Dict normalized = command.Clone();
+    if (*command_name == "request_full_context") {
+      normalized.Set("command", "request_more_context");
+    } else if (*command_name == "screenshot" ||
+               *command_name == "inspect_image") {
+      normalized.Set("command", "request_screenshot");
+    } else if (*command_name == "save_recent_actions_as_script" ||
+               *command_name == "promote_span_to_macro") {
+      normalized.Set("command", "save_task_script");
+    } else if (*command_name == "call_macro") {
+      normalized.Set("command", "call_action");
+      base::Value::Dict* payload = normalized.FindDict("payload");
+      if (!payload) {
+        normalized.Set("payload", base::Value::Dict());
+        payload = normalized.FindDict("payload");
+      }
+      std::string script_id;
+      if (const std::string* existing = payload->FindString("scriptId")) {
+        script_id = *existing;
+      }
+      payload->Set("action", "call_script");
+      base::Value::Dict params;
+      if (!script_id.empty()) {
+        params.Set("scriptId", script_id);
+      }
+      payload->Set("params", std::move(params));
+    }
+    if (*command_name == "call_action") {
+      if (base::Value::Dict* payload = normalized.FindDict("payload")) {
+        if (const std::string* action_name = payload->FindString("action")) {
+          base::Value::Dict wrapper =
+              NormalizeModelActionPayload(*action_name, payload->FindDict("params"));
+          if (const std::string* normalized_action =
+                  wrapper.FindString("action")) {
+            payload->Set("action", *normalized_action);
+          }
+          if (const base::Value::Dict* params = wrapper.FindDict("params")) {
+            base::Value::Dict sanitized_params = params->Clone();
+            SanitizeAgentActionParams(
+                payload->FindString("action")
+                    ? *payload->FindString("action")
+                    : std::string(),
+                &sanitized_params);
+            payload->Set("params", std::move(sanitized_params));
+          }
+        }
+      }
+    } else if (*command_name == "run_timeline") {
+      base::Value::List* top_level = normalized.FindList("payload");
+      base::Value::List* timeline = nullptr;
+      if (top_level) {
+        timeline = top_level;
+      } else if (base::Value::Dict* payload = normalized.FindDict("payload")) {
+        timeline = payload->FindList("timeline");
+      }
+      if (timeline) {
+        for (base::Value& action_value : *timeline) {
+          base::Value::Dict* action = action_value.GetIfDict();
+          base::Value::Dict* params = action ? action->FindDict("params") : nullptr;
+          const std::string* action_name =
+              action ? action->FindString("action") : nullptr;
+          if (!action || !params || !action_name) {
+            continue;
+          }
+          SanitizeAgentActionParams(*action_name, params);
+        }
+      }
+    }
+    return normalized;
+  }
+
+  base::Value::Dict normalized;
+  normalized.Set("command", "call_action");
+  normalized.Set("payload",
+                 NormalizeModelActionPayload(*command_name,
+                                             command.FindDict("payload")));
+  return normalized;
+}
+
+bool ActionLikelyChangesPageFocusOrInteractiveState(const std::string& action) {
+  return action == "click" || action == "type" || action == "focus" ||
+         action == "hover" || action == "key_press" ||
+         action == "call_script";
+}
+
+bool TimelineLikelyChangesPageFocusOrInteractiveState(
+    const base::Value::Dict& payload) {
+  const base::Value::List* timeline = payload.FindList("timeline");
+  if (!timeline) {
+    return false;
+  }
+  for (const base::Value& action_value : *timeline) {
+    const base::Value::Dict* action = action_value.GetIfDict();
+    const std::string* action_name = action ? action->FindString("action")
+                                            : nullptr;
+    if (action_name &&
+        ActionLikelyChangesPageFocusOrInteractiveState(*action_name)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool CommandNeedsInteractiveSurfaceProbe(const content::WebContents* web_contents,
+                                         const base::Value::Dict& command) {
+  if (!web_contents) {
+    return false;
+  }
+  const GURL url = web_contents->GetLastCommittedURL();
+  if (!url.is_valid() ||
+      !(base::EqualsCaseInsensitiveASCII(url.host(), "x.com") ||
+        base::EqualsCaseInsensitiveASCII(url.host(), "www.x.com"))) {
+    return false;
+  }
+  const std::string* command_name = command.FindString("command");
+  if (!command_name) {
+    return false;
+  }
+  if (*command_name == "call_action") {
+    const base::Value::Dict* payload = command.FindDict("payload");
+    const std::string* action_name = payload ? payload->FindString("action")
+                                             : nullptr;
+    return action_name &&
+           ActionLikelyChangesPageFocusOrInteractiveState(*action_name);
+  }
+  if (*command_name == "run_timeline") {
+    const base::Value::Dict* payload = command.FindDict("payload");
+    return payload && TimelineLikelyChangesPageFocusOrInteractiveState(*payload);
+  }
+  return false;
+}
+
+base::Value::List ExtractDispatchProbeLocators(const base::Value::Dict& command) {
+  base::Value::List locators;
+  const std::string* command_name = command.FindString("command");
+  if (!command_name) {
+    return locators;
+  }
+  if (*command_name == "call_action") {
+    const base::Value::Dict* payload = command.FindDict("payload");
+    const base::Value::Dict* params = payload ? payload->FindDict("params")
+                                              : nullptr;
+    const base::Value::List* existing = params ? params->FindList("locators")
+                                               : nullptr;
+    if (existing) {
+      return SanitizeLocatorsForAgentExecution(*existing);
+    }
+    return locators;
+  }
+  if (*command_name == "run_timeline") {
+    const base::Value::Dict* payload = command.FindDict("payload");
+    const base::Value::List* timeline = payload ? payload->FindList("timeline")
+                                                : nullptr;
+    if (!timeline) {
+      return locators;
+    }
+    for (const base::Value& action_value : *timeline) {
+      const base::Value::Dict* action = action_value.GetIfDict();
+      const std::string* action_name = action ? action->FindString("action")
+                                              : nullptr;
+      const base::Value::Dict* params = action ? action->FindDict("params")
+                                               : nullptr;
+      if (!action_name || !params ||
+          !ActionLikelyChangesPageFocusOrInteractiveState(*action_name)) {
+        continue;
+      }
+      const base::Value::List* existing = params->FindList("locators");
+      if (existing) {
+        return SanitizeLocatorsForAgentExecution(*existing);
+      }
+      break;
+    }
+  }
+  return locators;
+}
+
+std::string BuildInteractiveDispatchProbeJs(const base::Value::List& locators) {
+  std::string locators_json = "[]";
+  base::JSONWriter::Write(locators, &locators_json);
+  return base::StrCat(
+      {R"JS((function(locators){
+          try {
+          function visible(el) {
+            if (!el || el.nodeType !== 1) return false;
+            try {
+              const rect = el.getBoundingClientRect();
+              if (!rect || rect.width <= 1 || rect.height <= 1) return false;
+              const style = getComputedStyle(el);
+              if (!style || style.visibility === 'hidden' || style.display === 'none' || style.pointerEvents === 'none')
+                return false;
+              return rect.bottom > 0 && rect.right > 0 &&
+                     rect.top < (window.innerHeight || document.documentElement.clientHeight || 0) &&
+                     rect.left < (window.innerWidth || document.documentElement.clientWidth || 0);
+            } catch (e) {
+              return false;
+            }
+          }
+          function byXPath(xpath) {
+            try {
+              const snap = document.evaluate(xpath, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);
+              const out = [];
+              for (let i = 0; i < snap.snapshotLength; ++i) out.push(snap.snapshotItem(i));
+              return out;
+            } catch (e) {
+              return [];
+            }
+          }
+          function matchesFor(loc) {
+            if (!loc || !loc.type) return [];
+            const type = String(loc.type || '');
+            const value = String(loc.value || '');
+            try {
+              switch (type) {
+                case 'CSS_SELECTOR': return Array.from(document.querySelectorAll(value));
+                case 'ID': { const el = document.getElementById(value); return el ? [el] : []; }
+                case 'NAME': return Array.from(document.querySelectorAll('[name=\"' + value.replace(/\"/g, '\\\\\"') + '\"]'));
+                case 'TAG_NAME': return Array.from(document.getElementsByTagName(value));
+                case 'XPATH': return byXPath(value);
+                default: return [];
+              }
+            } catch (e) {
+              return [];
+            }
+          }
+          const host = String(location && location.host || '');
+          const readyState = String(document && document.readyState || '');
+          const bodyPresent = !!(document && document.body);
+          const domReady = readyState !== 'loading';
+          const targetVisible = Array.isArray(locators) && locators.length
+              ? locators.some(loc => matchesFor(loc).some(visible))
+              : false;
+          let xSurfaceReady = false;
+          if (/(^|\\.)x\\.com$/i.test(host)) {
+            const selectors = [
+              '[data-testid=\"tweetTextarea_0\"]',
+              '[data-testid=\"tweetButtonInline\"]',
+              '[data-testid=\"tweetButton\"]',
+              'main[role=\"main\"]',
+              '[data-testid=\"primaryColumn\"]'
+            ];
+            xSurfaceReady = selectors.some(sel => {
+              try {
+                return Array.from(document.querySelectorAll(sel)).some(visible);
+              } catch (e) {
+                return false;
+              }
+            });
+          }
+          return JSON.stringify({
+            ready: bodyPresent && domReady && (targetVisible || xSurfaceReady),
+            readyState: readyState,
+            bodyPresent: bodyPresent,
+            domReady: domReady,
+            targetVisible: targetVisible,
+            xSurfaceReady: xSurfaceReady,
+            url: String(location && location.href || '')
+          });
+          } catch (e) {
+            return JSON.stringify({
+              ready: false,
+              error: String(e),
+              readyState: String(document && document.readyState || ''),
+              bodyPresent: !!(document && document.body),
+              domReady: String(document && document.readyState || '') !== 'loading',
+              targetVisible: false,
+              xSurfaceReady: false,
+              url: String(location && location.href || '')
+            });
+          }
+        })JS",
+       "(", locators_json, ")"});
+}
+
+std::optional<base::Value::Dict> ParseInteractiveProbeResult(base::Value result) {
+  if (base::Value::Dict* dict = result.GetIfDict()) {
+    return dict->Clone();
+  }
+  const std::string* text = result.GetIfString();
+  if (!text || text->empty()) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      *text, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed.has_value() || !parsed->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(parsed->GetDict());
+}
+
+std::optional<gfx::RectF> FindViewportBounds(const base::Value::Dict& page_map) {
+  const base::Value::List* frames = page_map.FindList("frames");
+  if (!frames) {
+    return std::nullopt;
+  }
+  std::optional<gfx::RectF> best;
+  for (const base::Value& frame_value : *frames) {
+    const base::Value::Dict* frame = frame_value.GetIfDict();
+    if (!frame) {
+      continue;
+    }
+    const base::Value::List* elements = frame->FindList("elements");
+    if (!elements) {
+      continue;
+    }
+    for (const base::Value& element_value : *elements) {
+      const base::Value::Dict* element = element_value.GetIfDict();
+      const base::Value::Dict* bounds = element ? element->FindDict("bounds")
+                                                : nullptr;
+      if (!bounds) {
+        continue;
+      }
+      const double x = bounds->FindDouble("x").value_or(0.0);
+      const double y = bounds->FindDouble("y").value_or(0.0);
+      const double w = bounds->FindDouble("w").value_or(0.0);
+      const double h = bounds->FindDouble("h").value_or(0.0);
+      if (w <= 0.0 || h <= 0.0) {
+        continue;
+      }
+      gfx::RectF rect(x, y, w, h);
+      if (!best.has_value() || rect.width() * rect.height() >
+                                   best->width() * best->height()) {
+        best = rect;
+      }
+    }
+  }
+  return best;
+}
+
+std::string BuildOverlayLabel(const base::Value::Dict& element) {
+  for (const char* key : {"accessibilityName", "text", "type", "role", "tag"}) {
+    if (const std::string* value = element.FindString(key);
+        value && !value->empty()) {
+      return TruncateForPrompt(*value, 120u);
+    }
+  }
+  if (const base::Value::Dict* selectors = element.FindDict("selectors")) {
+    for (const char* key : {"css", "resourcePath", "xpath"}) {
+      if (const std::string* value = selectors->FindString(key);
+          value && !value->empty()) {
+        return TruncateForPrompt(*value, 120u);
+      }
+    }
+  }
+  return "unknown overlay";
+}
+
+std::string FindProminentOverlaySummary(const base::Value::Dict& page_map) {
+  const std::optional<gfx::RectF> viewport = FindViewportBounds(page_map);
+  if (!viewport.has_value() || viewport->width() <= 0.0f ||
+      viewport->height() <= 0.0f) {
+    return std::string();
+  }
+
+  const float viewport_center_x = viewport->x() + viewport->width() / 2.0f;
+  const float viewport_center_y = viewport->y() + viewport->height() / 2.0f;
+  const base::Value::List* frames = page_map.FindList("frames");
+  if (!frames) {
+    return std::string();
+  }
+
+  static constexpr const char* kOverlayNeedles[] = {
+      "dialog", "modal", "popover", "sheet", "keyboard shortcuts",
+      "shortcut help", "keyboard_shortcuts", "drawer", "menu",
+  };
+
+  const base::Value::Dict* best_element = nullptr;
+  float best_score = 0.0f;
+  for (const base::Value& frame_value : *frames) {
+    const base::Value::Dict* frame = frame_value.GetIfDict();
+    if (!frame) {
+      continue;
+    }
+    const base::Value::List* elements = frame->FindList("elements");
+    if (!elements) {
+      continue;
+    }
+    for (const base::Value& element_value : *elements) {
+      const base::Value::Dict* element = element_value.GetIfDict();
+      const base::Value::Dict* bounds = element ? element->FindDict("bounds")
+                                                : nullptr;
+      if (!element || !bounds) {
+        continue;
+      }
+      const float x = bounds->FindDouble("x").value_or(0.0);
+      const float y = bounds->FindDouble("y").value_or(0.0);
+      const float w = bounds->FindDouble("w").value_or(0.0);
+      const float h = bounds->FindDouble("h").value_or(0.0);
+      if (w <= viewport->width() * 0.18f || h <= viewport->height() * 0.12f) {
+        continue;
+      }
+      const float center_x = x + w / 2.0f;
+      const float center_y = y + h / 2.0f;
+      const float dx = std::abs(center_x - viewport_center_x);
+      const float dy = std::abs(center_y - viewport_center_y);
+      const bool centered = dx <= viewport->width() * 0.28f &&
+                            dy <= viewport->height() * 0.28f;
+      const bool overlay_like = DictContainsAnySubstring(*element, kOverlayNeedles);
+      if (!centered && !overlay_like) {
+        continue;
+      }
+      float score = (w * h) / (viewport->width() * viewport->height());
+      if (overlay_like) {
+        score += 1.0f;
+      }
+      if (score > best_score) {
+        best_score = score;
+        best_element = element;
+      }
+    }
+  }
+
+  if (!best_element || best_score < 0.15f) {
+    return std::string();
+  }
+  return BuildOverlayLabel(*best_element);
+}
+
+std::string BuildAutonomousFollowupPrompt(const base::Value::Dict& command,
+                                          const base::Value::Dict& result,
+                                          int step,
+                                          int max_steps,
+                                          bool include_page_context,
+                                          const std::string& page_context) {
+  std::string command_json = "{}";
+  std::string result_json = "{}";
+  base::JSONWriter::Write(command, &command_json);
+  base::JSONWriter::Write(result, &result_json);
+
+  std::string followup = base::StringPrintf(
+      "Autonomous continuation step %d/%d.\n"
+      "Last command:\n%s\n\n"
+      "Command result:\n%s\n\n"
+      "Continue working toward the primary user goal without waiting for "
+      "another user message.\n"
+      "If the issue is solved OR you cannot solve it with available tools, "
+      "respond with plain text only and no JSON command block.\n"
+      "Otherwise, return exactly one JSON command block.\n\n",
+      step + 1, max_steps, command_json.c_str(), result_json.c_str());
+  if (result.FindBool("significant_mutation").value_or(false)) {
+    followup = base::StrCat(
+        {"Important: the page state changed significantly after the last "
+         "action. Re-plan from the updated page context before issuing the "
+         "next command.\n\n",
+         followup});
+  }
+  if (include_page_context && !page_context.empty()) {
+    followup = page_context + followup;
+  }
+  return followup;
+}
+
+std::string BuildFinalMessage(const std::string& prefix,
+                              const base::FilePath& trace_path,
+                              const std::string& detail) {
+  std::string message = prefix;
+  if (!detail.empty()) {
+    message = base::StrCat({message, ": ", detail});
+  }
+  return base::StrCat(
+      {message, "\n[Agent Trace] ", trace_path.AsUTF8Unsafe()});
+}
+
+std::string ClipForFinalMessage(const std::string& text) {
+  return TruncateForPrompt(text, kMaxFinalResponseChars);
+}
+
+std::string BuildHttpFailureMessage(int http_status,
+                                    const std::string& status_text,
+                                    const std::string& response_body) {
+  std::string message = base::StrCat(
+      {"Dashboard model request failed: HTTP ",
+       base::NumberToString(http_status)});
+  if (!status_text.empty()) {
+    message = base::StrCat({message, " ", status_text});
+  }
+  const std::string trimmed_body =
+      std::string(base::TrimWhitespaceASCII(response_body, base::TRIM_ALL));
+  if (!trimmed_body.empty()) {
+    message = base::StrCat(
+        {message, ": ", ClipForFinalMessage(trimmed_body)});
+  }
+  return message;
+}
