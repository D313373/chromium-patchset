+std::string WriteJsonDict(base::Value::Dict dict) {
+  std::string out;
+  base::JSONWriter::Write(dict, &out);
+  return out;
+}
+
+std::string BuildRefreshPayloadJson(int32_t tab_id,
+                                    mojom::AgentContextPolicy policy) {
+  base::Value::Dict payload;
+  if (tab_id > 0) {
+    payload.Set("tab_id", tab_id);
+  }
+  payload.Set("policy", AgentContextPolicyToString(policy));
+  return WriteJsonDict(std::move(payload));
+}
+
+std::string BuildInspectPayloadJson(const std::string& snapshot_id) {
+  base::Value::Dict payload;
+  payload.Set("snapshot_id", snapshot_id);
+  return WriteJsonDict(std::move(payload));
+}
+
+std::string BuildExecutorArtifactsJson(const std::string& execution_id,
+                                       bool queued,
+                                       bool completed) {
+  base::Value::Dict artifacts;
+  artifacts.Set("queued", queued);
+  artifacts.Set("completed", completed);
+  if (!execution_id.empty()) {
+    artifacts.Set("execution_id", execution_id);
+  }
+  return WriteJsonDict(std::move(artifacts));
+}
+
+std::string BuildScriptArtifactsJson(const std::string& script_id,
+                                     base::Value::Dict script) {
+  base::Value::Dict artifacts;
+  artifacts.Set("script_id", script_id);
+  artifacts.Set("script", std::move(script));
+  return WriteJsonDict(std::move(artifacts));
+}
+
+std::string BuildScriptSummaryArtifactsJson(base::Value::Dict scripts_by_id) {
+  base::Value::Dict artifacts;
+  artifacts.Set("scripts", std::move(scripts_by_id));
+  return WriteJsonDict(std::move(artifacts));
+}
+
+std::optional<int> ParseIntLikeValue(const base::Value* value) {
+  if (!value) {
+    return std::nullopt;
+  }
+  if (value->is_int()) {
+    return value->GetInt();
+  }
+  if (value->is_double()) {
+    return static_cast<int>(value->GetDouble());
+  }
+  if (value->is_string()) {
+    int parsed = 0;
+    if (base::StringToInt(value->GetString(), &parsed)) {
+      return parsed;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<int> ReadRequestedTabId(const base::Value::Dict& payload) {
+  if (std::optional<int> tab_id = ParseIntLikeValue(payload.Find("tab_id"));
+      tab_id.has_value()) {
+    return tab_id;
+  }
+  if (std::optional<int> tab_id = ParseIntLikeValue(payload.Find("tabId"));
+      tab_id.has_value()) {
+    return tab_id;
+  }
+  if (const base::Value::Dict* options = payload.FindDict("options")) {
+    if (std::optional<int> tab_id =
+            ParseIntLikeValue(options->Find("tab_id"));
+        tab_id.has_value()) {
+      return tab_id;
+    }
+    if (std::optional<int> tab_id = ParseIntLikeValue(options->Find("tabId"));
+        tab_id.has_value()) {
+      return tab_id;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> ReadStringOption(const base::Value::Dict& payload,
+                                            std::string_view key,
+                                            std::string_view alt_key) {
+  if (const std::string* direct = payload.FindString(key)) {
+    return *direct;
+  }
+  if (const std::string* direct_alt = payload.FindString(alt_key)) {
+    return *direct_alt;
+  }
+  if (const base::Value::Dict* options = payload.FindDict("options")) {
+    if (const std::string* from_options = options->FindString(key)) {
+      return *from_options;
+    }
+    if (const std::string* from_options_alt = options->FindString(alt_key)) {
+      return *from_options_alt;
+    }
+  }
+  return std::nullopt;
+}
+
+bool ReadBoolOption(const base::Value::Dict& payload,
+                    std::string_view key,
+                    std::string_view alt_key,
+                    bool default_value) {
+  if (std::optional<bool> direct = payload.FindBool(key); direct.has_value()) {
+    return *direct;
+  }
+  if (std::optional<bool> direct_alt = payload.FindBool(alt_key);
+      direct_alt.has_value()) {
+    return *direct_alt;
+  }
+  if (const base::Value::Dict* options = payload.FindDict("options")) {
+    if (std::optional<bool> from_options = options->FindBool(key);
+        from_options.has_value()) {
+      return *from_options;
+    }
+    if (std::optional<bool> from_options_alt = options->FindBool(alt_key);
+        from_options_alt.has_value()) {
+      return *from_options_alt;
+    }
+  }
+  return default_value;
+}
+
+content::WebContents* FindWebContentsForTabId(Profile* profile, int tab_id) {
+  if (!profile || tab_id <= 0) {
+    return nullptr;
+  }
+  for (Browser* browser : *BrowserList::GetInstance()) {
+    if (!browser || browser->profile() != profile) {
+      continue;
+    }
+    TabStripModel* tab_strip = browser->tab_strip_model();
+    if (!tab_strip) {
+      continue;
+    }
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      content::WebContents* wc = tab_strip->GetWebContentsAt(i);
+      if (!wc) {
+        continue;
+      }
+      if (sessions::SessionTabHelper::IdForTab(wc).id() == tab_id) {
+        return wc;
+      }
+    }
+  }
+  return nullptr;
+}
+
+struct ParsedToolTurn {
+  std::string tool;
+  base::Value::Dict payload;
+};
+
+std::optional<ParsedToolTurn> ParseToolTurnRequest(
+    const std::string& user_message) {
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(user_message, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return std::nullopt;
+  }
+
+  base::Value::Dict& request_dict = parsed->GetDict();
+  const std::string* tool = request_dict.FindString("tool");
+  if (!tool || tool->empty()) {
+    return std::nullopt;
+  }
+
+  ParsedToolTurn turn;
+  turn.tool = *tool;
+  if (base::Value::Dict* payload = request_dict.FindDict("payload")) {
+    turn.payload = payload->Clone();
+    return turn;
+  }
+  if (const std::string* payload_json = request_dict.FindString("payload_json")) {
+    std::optional<base::Value> parsed_payload =
+        base::JSONReader::Read(*payload_json, base::JSON_PARSE_RFC);
+    if (parsed_payload && parsed_payload->is_dict()) {
+      turn.payload = std::move(parsed_payload->GetDict());
+    }
+    return turn;
+  }
+  return turn;
+}
+
+UnifiedToolResultRecord BuildToolResult(
+    bool ok,
+    std::string tool,
+    mojom::AgentFailureStage failure_stage,
+    std::string error_class,
+    bool retryable,
+    base::Time started_at,
+    std::string summary,
+    std::string verification_summary) {
+  UnifiedToolResultRecord result;
+  result.ok = ok;
+  result.tool = std::move(tool);
+  result.failure_stage = failure_stage;
+  result.error_class = std::move(error_class);
+  result.retryable = retryable;
+  result.started_at = started_at;
+  result.finished_at = base::Time::Now();
+  result.duration_ms = static_cast<uint32_t>(
+      std::max<int64_t>(0, (result.finished_at - result.started_at).InMilliseconds()));
+  result.summary = std::move(summary);
+  result.artifacts_json = "{}";
+  result.verification_summary = std::move(verification_summary);
+  return result;
+}
