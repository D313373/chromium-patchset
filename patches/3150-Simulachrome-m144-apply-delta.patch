+-function bestLocatorSummary(locs) {
+-  if (!Array.isArray(locs) || !locs.length) return '';
+-  let best = null;
+-  let bestRank = 1e9;
+-  for (const l of locs) {
+-    if (!l || typeof l !== 'object') continue;
+-    const rank = locatorRank(l.type);
+-    if (rank < bestRank) {
+-      bestRank = rank;
+-      best = l;
+-    }
+-  }
+-  if (!best) return '';
+-  const t = String(best.type || '').toUpperCase();
+-  const v = String(best.value || '').trim();
+-  const shown = v.length > 80 ? v.slice(0, 80) + '…' : v;
+-  const extra = locs.length > 1 ? ` +${locs.length - 1}` : '';
+-  return t ? `${t}${shown ? `=${shown}` : ''}${extra}` : '';
+-}
+-
+-function extractPageMap(payload) {
+-  if (!payload || typeof payload !== 'object') return null;
+-  if (payload.detail && typeof payload.detail === 'object') return payload.detail;
+-  if (payload.pagemap && typeof payload.pagemap === 'object') return payload.pagemap;
+-  return payload;
+-}
+-
+-function summarizePageMap(snapshot) {
+-  const frames = Array.isArray(snapshot?.frames) ? snapshot.frames : [];
+-  if (frames.length) {
+-    let elements = 0;
+-    try {
+-      frames.forEach(f => {
+-        elements += (f.elements?.length || 0);
+-        (f.shadowRoots || []).forEach(sr => { elements += (sr.elements?.length || 0); });
+-      });
+-    } catch (_) {}
+-    return { frames: frames.length, elements };
+-  }
+-  const elements = Array.isArray(snapshot?.elements) ? snapshot.elements.length : 0;
+-  return { frames: frames.length || (elements ? 1 : 0), elements };
+-}
+-
+-function renderOverlayPageMap(type, snapshot, sourceTag) {
+-  if (!snapshot || typeof snapshot !== 'object') return;
+-  const summary = summarizePageMap(snapshot);
+-  const pmStream = document.getElementById('ov-pm-stream');
+-  if (pmStream) {
+-    const div = document.createElement('div');
+-    div.style.cssText = 'font-family:monospace;font-size:11px;opacity:0.85;white-space:pre;';
+-    const src = sourceTag ? ` [${sourceTag}]` : '';
+-    div.textContent = `${type || 'pagemap'}${src} frames=${summary.frames} elements≈${summary.elements}`;
+-    pmStream.appendChild(div);
+-    pmStream.scrollTop = pmStream.scrollHeight;
+-  }
+-  const pmJson = document.getElementById('ov-pm-json');
+-  if (pmJson) {
+-    try {
+-      const pretty = JSON.stringify(snapshot, null, 2);
+-      const limit = 8000;
+-      pmJson.textContent = pretty.length > limit ? (pretty.slice(0, limit) + '\n… [truncated]') : pretty;
+-    } catch (e) {
+-      pmJson.textContent = '[Error serializing PageMap JSON: ' + String(e) + ']';
+-    }
+-  }
+-}
