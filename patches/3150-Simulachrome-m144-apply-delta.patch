+void AIPageContentAgent::ContentBuilder::EnsureSelectorMetadataForFrame(
+    LocalFrame& frame) {
+  Document* document = frame.GetDocument();
+  if (!document) {
+    selector_metadata_.clear();
+    selector_metadata_document_ = nullptr;
+    return;
+  }
+  if (selector_metadata_document_ == document) {
+    return;
+  }
+
+  selector_metadata_document_ = document;
+  selector_metadata_.clear();
+
+  for (Element* element = ElementTraversal::FirstWithin(*document); element;
+       element = ElementTraversal::Next(*element)) {
+    if (!element->GetLayoutObject()) {
+      continue;
+    }
+    const DOMNodeId dom_node_id = DOMNodeIds::IdForNode(element);
+    if (dom_node_id == kInvalidDOMNodeId) {
+      continue;
+    }
+
+    SelectorMetadata metadata;
+    metadata.id_attr = element->GetIdAttribute().Utf8().data();
+    metadata.class_attr = element->getAttribute(html_names::kClassAttr)
+                              .Utf8()
+                              .data();
+    metadata.name_attr = element->getAttribute(html_names::kNameAttr)
+                             .Utf8()
+                             .data();
+
+    const std::string tag = LowerTagName(*element);
+    const PreferredSelectorChoice preferred =
+        ChoosePreferredSelector(*element, metadata.id_attr, metadata.class_attr);
+    metadata.css_selector = preferred.css.empty() ? tag : preferred.css;
+    metadata.xpath = preferred.xpath.empty() ? ("//" + tag) : preferred.xpath;
+
+    const String aria_label =
+        element->FastGetAttribute(html_names::kAriaLabelAttr);
+    const String title_attr = element->FastGetAttribute(html_names::kTitleAttr);
+    const String alt_attr = element->FastGetAttribute(html_names::kAltAttr);
+    if (!aria_label.IsNull() && !aria_label.ContainsOnlyWhitespaceOrEmpty()) {
+      metadata.accessibility_name =
+          base::CollapseWhitespaceASCII(aria_label.Utf8().data(), true);
+    } else if (!title_attr.IsNull() &&
+               !title_attr.ContainsOnlyWhitespaceOrEmpty()) {
+      metadata.accessibility_name =
+          base::CollapseWhitespaceASCII(title_attr.Utf8().data(), true);
+    } else if (!alt_attr.IsNull() && !alt_attr.ContainsOnlyWhitespaceOrEmpty()) {
+      metadata.accessibility_name =
+          base::CollapseWhitespaceASCII(alt_attr.Utf8().data(), true);
+    }
+    metadata.in_shadow_tree = element->IsInShadowTree();
+    metadata.shadow_chain_selector = BuildShadowChainSelector(*element);
+    metadata.resource_path = BuildResourcePath(*element);
+    metadata.interactive_ancestor_role = FindInteractiveAncestorRole(*element);
+    selector_metadata_.insert(dom_node_id, std::move(metadata));
+  }
+}
+
+void AIPageContentAgent::ContentBuilder::AddSelectorMetadata(
+    const LayoutObject& object,
+    mojom::blink::AIPageContentAttributes& attributes) {
+  if (!actionable_mode() || !attributes.dom_node_id.has_value()) {
+    return;
+  }
+
+  LocalFrame* frame = object.GetDocument().GetFrame();
+  if (!frame) {
+    return;
+  }
+  EnsureSelectorMetadataForFrame(*frame);
+
+  auto it = selector_metadata_.find(*attributes.dom_node_id);
+  if (it == selector_metadata_.end()) {
+    return;
+  }
+
+  const SelectorMetadata& selector = it->value;
+  if (!selector.id_attr.empty()) {
+    attributes.id_attr = String::FromUTF8(selector.id_attr);
+  }
+  if (!selector.class_attr.empty()) {
+    attributes.class_attr = String::FromUTF8(selector.class_attr);
+  }
+  if (!selector.name_attr.empty()) {
+    attributes.name_attr = String::FromUTF8(selector.name_attr);
+  }
+  if (!selector.css_selector.empty()) {
+    attributes.css_selector = String::FromUTF8(selector.css_selector);
+  }
+  if (!selector.xpath.empty()) {
+    attributes.xpath = String::FromUTF8(selector.xpath);
+  }
+  if (!selector.shadow_chain_selector.empty()) {
+    attributes.shadow_chain_selector =
+        String::FromUTF8(selector.shadow_chain_selector);
+  }
+  if (!selector.resource_path.empty()) {
+    attributes.resource_path = String::FromUTF8(selector.resource_path);
+  }
+  if (!selector.accessibility_name.empty()) {
+    attributes.accessibility_name =
+        String::FromUTF8(selector.accessibility_name);
+  }
+  if (!selector.interactive_ancestor_role.empty()) {
+    attributes.interactive_ancestor_role =
+        String::FromUTF8(selector.interactive_ancestor_role);
+  }
+  attributes.in_shadow_tree = selector.in_shadow_tree;
+}
