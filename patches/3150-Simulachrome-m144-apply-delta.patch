+#include "chrome/browser/ui/webui/dashboard/dashboard_automation_controller.h"
+
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/webui/dashboard/devtools_client_manager.h"
+#include "content/public/browser/web_contents.h"
+
+DashboardAutomationController::DashboardAutomationController() = default;
+
+DashboardAutomationController::~DashboardAutomationController() = default;
+
+dashboard::DashboardDevToolsClient*
+DashboardAutomationController::GetDevToolsClientForTab(
+    content::WebContents* web_contents) {
+  if (!web_contents || web_contents->IsBeingDestroyed()) {
+    return nullptr;
+  }
+
+  for (auto it = clients_.begin(); it != clients_.end();) {
+    if (!it->second || !it->second->client()) {
+      it = clients_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+
+  auto it = clients_.find(web_contents);
+  if (it == clients_.end()) {
+    auto mgr = std::make_unique<DevToolsClientManager>(web_contents);
+    it = clients_.emplace(web_contents, std::move(mgr)).first;
+  }
+  return it->second->client();
+}
+
+dashboard::DashboardDevToolsClient* GetOrCreateDashboardDevToolsClientForTab(
+    content::WebContents* web_contents) {
+  static base::NoDestructor<DashboardAutomationController>
+      automation_controller;
+  return automation_controller->GetDevToolsClientForTab(web_contents);
+}
