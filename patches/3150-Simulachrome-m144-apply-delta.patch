+class GlicKeyedService;
+
+class UnifiedAgentOrchestrator {
+ public:
+  explicit UnifiedAgentOrchestrator(GlicKeyedService* service);
+  UnifiedAgentOrchestrator(const UnifiedAgentOrchestrator&) = delete;
+  UnifiedAgentOrchestrator& operator=(const UnifiedAgentOrchestrator&) = delete;
+  ~UnifiedAgentOrchestrator();
+
+  using StartRunCallback =
+      base::OnceCallback<void(mojom::StartAgentRunResponsePtr)>;
+  using SendTurnCallback =
+      base::OnceCallback<void(mojom::AgentTurnResponsePtr)>;
+  using CancelRunCallback =
+      base::OnceCallback<void(mojom::AgentCancelResponsePtr)>;
+  using GetTraceCallback =
+      base::OnceCallback<void(mojom::AgentRunTracePtr)>;
+  using ListRunsCallback =
+      base::OnceCallback<void(std::vector<mojom::AgentRunTraceSummaryPtr>)>;
+  using ExpandElementRefsCallback =
+      base::OnceCallback<void(std::vector<mojom::ElementRefBundlePtr>)>;
+
+  void StartRun(mojom::StartAgentRunRequestPtr request,
+                StartRunCallback callback);
+  void SendTurn(mojom::AgentTurnRequestPtr request, SendTurnCallback callback);
+  void CancelRun(const std::string& run_id, CancelRunCallback callback);
+  void GetRunTrace(const std::string& run_id, GetTraceCallback callback) const;
+  void ListRecentRuns(ListRunsCallback callback) const;
+  void ExpandElementRefs(const std::string& run_id,
+                         const std::string& snapshot_id,
+                         const std::vector<std::string>& element_refs,
+                         ExpandElementRefsCallback callback) const;
+
+ private:
+  UnifiedAgentRunRecord* FindRun(const std::string& run_id);
+  const UnifiedAgentRunRecord* FindRun(const std::string& run_id) const;
+  void RememberRecentRun(const std::string& run_id);
+  void TrimStoredRuns();
+  bool NeedsContextRefresh(const UnifiedAgentRunRecord& run,
+                           bool force_refresh) const;
+  void AppendToolTrace(UnifiedAgentRunRecord& run,
+                       UnifiedToolCallRecord call,
+                       UnifiedToolResultRecord result);
+
+  raw_ptr<GlicKeyedService> service_;
+  UnifiedAgentContextAdapter context_adapter_;
+  base::flat_map<std::string, UnifiedAgentRunRecord> runs_;
+  std::deque<std::string> recent_run_ids_;
+  base::WeakPtrFactory<UnifiedAgentOrchestrator> weak_ptr_factory_{this};
+};
+
+}  // namespace glic
