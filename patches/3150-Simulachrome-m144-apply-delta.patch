+                if (const base::Value::Dict* remote =
+                        parsed->GetDict().FindDict("result")) {
+                  value = remote->FindDict("value");
+                }
+              }
+              if (value) {
+                base::Value::Dict repaired = fallback.Clone();
+                const std::string* tag = value->FindString("tag");
+                const std::string* id = value->FindString("id");
+                const std::string* name = value->FindString("name");
+                const std::string* css = value->FindString("css");
+                const std::string* xpath = value->FindString("xpath");
+                const std::string* ax_name = value->FindString("accessibilityName");
+                base::Value::List locs;
+                auto push = [&](const char* type, const std::string* v) {
+                  if (!v || v->empty()) return;
+                  base::Value::Dict loc;
+                  loc.Set("type", type);
+                  loc.Set("value", *v);
+                  locs.Append(std::move(loc));
+                };
+                push("ID", id);
+                push("NAME", name);
+                push("CSS_SELECTOR", css);
+                push("XPATH", xpath);
+                push("TAG_NAME", tag);
+                if (ax_name && !ax_name->empty()) {
+                  base::Value::Dict loc;
+                  loc.Set("type", "ACCESSIBILITY_NAME");
+                  loc.Set("value", *ax_name);
+                  locs.Append(std::move(loc));
+                  repaired.Set("ax_name", *ax_name);
+                  repaired.Set("accessibility_name", *ax_name);
+                }
+                if (!locs.empty()) {
+                  repaired.Set("locators",
+                               ReorderRecordedLocatorBundle(std::move(locs)));
+                  if (css && !css->empty()) repaired.Set("css", *css);
+                  if (xpath && !xpath->empty()) repaired.Set("xpath", *xpath);
+                  if (tag && !tag->empty()) repaired.Set("tag", *tag);
+                  repaired.Set("__source", "devtools_reprobe");
+                  repaired.Set("x", x);
+                  repaired.Set("y", y);
+                  weak->OnUserClickFromRenderer(std::move(repaired));
+                  return;
+                }
+              }
+              weak->OnUserClickFromRenderer(std::move(fallback));
+            },
+            weak_factory_.GetWeakPtr(), dict.Clone(), x, y));
+    return;
+  }
+
+  if (locator_capture_armed_) {
+    const base::Value::List* locs = dict.FindList("locators");
+    LOG(INFO) << "[LocatorCapture] devtools_attributes css="
+              << (css.empty() ? std::string("<empty>") : css)
+              << " tag="
+              << (local_name.empty() ? std::string("<empty>") : local_name)
+              << " ax_role="
+              << (dict.FindString("ax_role") ? *dict.FindString("ax_role")
