+void AppendCandidatesFromElementList(const base::Value::List* elements,
+                                     const std::string& frame_id,
+                                     int max_candidates,
+                                     std::vector<NativePageMapCandidate>* out) {
+  if (!elements || !out) {
+    return;
+  }
+  for (const auto& element_value : *elements) {
+    if (max_candidates > 0 &&
+        static_cast<int>(out->size()) >= max_candidates) {
+      return;
+    }
+    const base::Value::Dict* element = element_value.GetIfDict();
+    if (!element) {
+      continue;
+    }
+    std::optional<NativePageMapCandidate> candidate =
+        CandidateFromValue(*element, frame_id);
+    if (candidate.has_value()) {
+      out->push_back(std::move(*candidate));
+    }
+  }
+}
