+mojom::GetTabContextOptions BuildLightweightContextOptions(
+    mojom::AgentProfile profile) {
+  mojom::GetTabContextOptions options;
+  options.include_viewport_screenshot = false;
+  options.include_pdf = false;
+  options.include_annotated_page_content = true;
+  options.max_meta_tags = 8;
+  options.annotated_page_content_mode =
+      optimization_guide::proto::
+          ANNOTATED_PAGE_CONTENT_MODE_ACTIONABLE_ELEMENTS;
+  options.include_inner_text =
+      profile == mojom::AgentProfile::kScriptDebugger ||
+      profile == mojom::AgentProfile::kScriptBuilder;
+  options.inner_text_bytes_limit = options.include_inner_text ? 4096u : 0u;
+  return options;
+}
+
+std::string WriteJson(base::Value::Dict dict) {
+  std::string out;
+  base::JSONWriter::Write(base::Value(std::move(dict)), &out);
+  return out;
+}
+
+std::string ShortText(std::string text, size_t max_len = 96u) {
+  text = base::CollapseWhitespaceASCII(text, true);
+  if (text.size() <= max_len) {
+    return text;
+  }
+  text.resize(max_len);
+  text.append("...");
+  return text;
+}
+
+base::Value::List BuildLocatorBundleFromPageMapElement(
+    const base::Value::Dict& element) {
+  if (const base::Value::Dict* selectors = element.FindDict("selectors")) {
+    if (const base::Value::List* locators = selectors->FindList("locators")) {
+      return locators->Clone();
+    }
+  }
+
+  base::Value::List locators;
+  if (const base::Value::Dict* selectors = element.FindDict("selectors")) {
+    if (const std::string* css = selectors->FindString("css")) {
+      base::Value::Dict locator;
+      locator.Set("type", "CSS_SELECTOR");
+      locator.Set("value", *css);
+      locators.Append(std::move(locator));
+    }
+    if (const std::string* xpath = selectors->FindString("xpath")) {
+      base::Value::Dict locator;
+      locator.Set("type", "XPATH");
+      locator.Set("value", *xpath);
+      locators.Append(std::move(locator));
+    }
+    if (const std::string* shadow = selectors->FindString("shadowChain")) {
+      base::Value::Dict locator;
+      locator.Set("type", "SHADOW_DOM");
+      locator.Set("value", *shadow);
+      locators.Append(std::move(locator));
+    }
+  }
+  if (const std::string* frame_id = element.FindString("frameId")) {
+    base::Value::Dict locator;
+    locator.Set("type", "FRAME_ID");
+    locator.Set("value", *frame_id);
+    locators.Append(std::move(locator));
+  }
+  return locators;
+}
+
+void AppendElementRecords(const base::Value::List* elements,
+                          const std::string& frame_ref,
+                          const base::Value::Dict& page_map_metadata,
+                          const std::string& source,
+                          std::vector<UnifiedAgentElementRefRecord>* out) {
+  if (!elements) {
+    return;
+  }
+  for (const auto& value : *elements) {
+    const base::Value::Dict* element = value.GetIfDict();
+    if (!element) {
+      continue;
+    }
+    UnifiedAgentElementRefRecord record;
+    const std::string* role = element->FindString("role");
+    const std::string* tag = element->FindString("tag");
+    const std::string* accessibility_name =
+        element->FindString("accessibilityName");
+    const std::string* text = element->FindString("text");
+    const std::string* id = element->FindString("id");
+    record.role = role ? *role : std::string();
+    record.label = accessibility_name ? *accessibility_name
+                                      : (text ? *text : std::string());
+    record.short_text = ShortText(text ? *text : record.label);
+    record.candidate_kind =
+        element->FindBool("clickable").value_or(false)
+            ? std::string("interactive")
+            : (tag ? *tag : record.role);
+    record.frame_ref = frame_ref;
+    record.element_ref =
+        frame_ref + ":" + (id ? *id : ShortText(record.label, 48u));
+    record.score = record.label.empty() ? 0.4 : 1.0;
+    record.locator_bundle = BuildLocatorBundleFromPageMapElement(*element);
+    record.page_map_metadata = page_map_metadata.Clone();
+    record.source = source;
+    out->push_back(std::move(record));
+  }
+}
+
+void PopulateSnapshotElementsFromPageMap(const base::Value::Dict& page_map,
+                                         UnifiedAgentContextSnapshotRecord* out) {
+  if (!out) {
+    return;
+  }
+  const base::Value::Dict* metadata = page_map.FindDict("metadata");
+  base::Value::Dict page_map_metadata = metadata ? metadata->Clone()
+                                                 : base::Value::Dict();
+  const std::string source = metadata && metadata->FindString("source")
+                                 ? *metadata->FindString("source")
+                                 : "unified_page_map";
+  const base::Value::List* frames = page_map.FindList("frames");
+  if (!frames) {
+    return;
+  }
+  for (const auto& frame_value : *frames) {
+    const base::Value::Dict* frame = frame_value.GetIfDict();
+    if (!frame) {
+      continue;
+    }
+    const std::string frame_ref = frame->FindString("frameId")
+                                      ? *frame->FindString("frameId")
+                                      : std::string("root");
+    AppendElementRecords(frame->FindList("elements"), frame_ref, page_map_metadata,
+                         source, &out->elements);
+    if (const base::Value::List* shadow_roots = frame->FindList("shadowRoots")) {
+      for (const auto& shadow_value : *shadow_roots) {
+        const base::Value::Dict* shadow = shadow_value.GetIfDict();
+        if (!shadow) {
+          continue;
+        }
+        AppendElementRecords(shadow->FindList("elements"), frame_ref,
+                             page_map_metadata, source, &out->elements);
+      }
+    }
+  }
+}
+
+std::vector<optimization_guide::AIPageContentSelectorEntry>
+ConvertSelectorSidecar(const glic::mojom::AnnotatedPageDataPtr& annotated_page) {
+  std::vector<optimization_guide::AIPageContentSelectorEntry> out;
+  if (!annotated_page) {
+    return out;
+  }
+  out.reserve(annotated_page->selector_sidecar.size());
+  for (const auto& entry : annotated_page->selector_sidecar) {
+    if (!entry) {
+      continue;
+    }
+    optimization_guide::AIPageContentSelectorEntry selector;
+    selector.document_identifier = entry->document_identifier;
+    selector.frame_id = entry->frame_id;
+    selector.dom_node_id = entry->dom_node_id;
+    selector.id_attr = entry->id_attr;
+    selector.class_attr = entry->class_attr;
+    selector.name_attr = entry->name_attr;
+    selector.css_selector = entry->css_selector;
+    selector.xpath = entry->xpath;
+    selector.shadow_chain_selector = entry->shadow_chain_selector;
+    selector.resource_path = entry->resource_path;
+    selector.accessibility_name = entry->accessibility_name;
+    selector.interactive_ancestor_role = entry->interactive_ancestor_role;
+    selector.in_shadow_tree = entry->in_shadow_tree;
+    out.push_back(std::move(selector));
+  }
+  return out;
+}
+
+}  // namespace
+
+UnifiedAgentContextAdapter::CaptureResult::CaptureResult() = default;
+UnifiedAgentContextAdapter::CaptureResult::CaptureResult(
+    CaptureResult&&) noexcept = default;
+UnifiedAgentContextAdapter::CaptureResult&
+UnifiedAgentContextAdapter::CaptureResult::operator=(
+    CaptureResult&&) noexcept = default;
+UnifiedAgentContextAdapter::CaptureResult::~CaptureResult() = default;
+
+UnifiedAgentContextAdapter::UnifiedAgentContextAdapter(
+    GlicKeyedService* service)
+    : service_(service) {}
+
+UnifiedAgentContextAdapter::~UnifiedAgentContextAdapter() = default;
+
+void UnifiedAgentContextAdapter::CaptureContextSnapshot(
+    mojom::AgentProfile profile,
+    int32_t requested_tab_id,
+    mojom::AgentContextPolicy policy,
+    CaptureCallback callback) {
+  CHECK(service_);
+  tabs::TabHandle tab_handle = tabs::TabHandle::Null();
+  const bool use_actor_context = requested_tab_id > 0;
+  if (requested_tab_id > 0) {
+    tab_handle = tabs::TabHandle(requested_tab_id);
+  } else {
+    FocusedTabData ftd = service_->sharing_manager().GetFocusedTabData();
+    if (ftd.unfocused_tab() || !ftd.focus()) {
+      CaptureResult result;
+      result.ok = false;
+      result.failure_stage = mojom::AgentFailureStage::kGrounding;
+      result.error_class = "no_focused_tab";
+      result.message = "No focused tab is available for unified agent context.";
+      std::move(callback).Run(std::move(result));
+      return;
+    }
+    tab_handle = ftd.focus()->GetHandle();
+  }
+
+  tabs::TabInterface* tab = tab_handle.Get();
+  if (!tab || !tab->GetContents()) {
+    CaptureResult result;
+    result.ok = false;
+    result.failure_stage = mojom::AgentFailureStage::kGrounding;
+    result.error_class = "tab_unavailable";
+    result.message = "The requested tab is no longer available.";
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  content::WebContents* target_web_contents = tab->GetContents();
+
+  mojom::GetTabContextOptions options = BuildLightweightContextOptions(profile);
+  auto finish_capture = base::BindOnce(
+      [](mojom::AgentProfile profile, mojom::AgentContextPolicy policy,
+         content::WebContents* target_web_contents, CaptureCallback callback,
+         GlicGetContextResult result) {
+        CaptureResult out;
+        if (!result.has_value()) {
+          out.ok = false;
+          out.failure_stage = mojom::AgentFailureStage::kGrounding;
+          out.error_class = "context_fetch_failed";
+          out.message = result.error().message;
+          std::move(callback).Run(std::move(out));
+          return;
+        }
+        if (!result.value()->is_tab_context()) {
+          out.ok = false;
+          out.failure_stage = mojom::AgentFailureStage::kGrounding;
+          out.error_class = "context_fetch_error";
+          out.message = result.value()->is_error_reason()
+                            ? result.value()->get_error_reason()
+                            : "Unified agent context fetch failed.";
+          std::move(callback).Run(std::move(out));
+          return;
+        }
+
+        const mojom::TabContextPtr& tab_context = result.value()->get_tab_context();
+        out.ok = true;
+        out.snapshot.snapshot_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+        out.snapshot.url = tab_context->tab_data->url;
+        out.snapshot.title = tab_context->tab_data->title.value_or("");
+        out.snapshot.profile = profile;
+        out.snapshot.captured_at = base::Time::Now();
+        out.snapshot.scripts_summary_json = "{}";
+        out.snapshot.recent_failures_json = "[]";
+        base::Value::Dict settings_summary;
+        settings_summary.Set("context_policy", AgentContextPolicyToString(policy));
+        settings_summary.Set("include_inner_text",
+                             static_cast<bool>(tab_context->web_page_data));
+        out.snapshot.settings_summary_json = WriteJson(std::move(settings_summary));
+
+        if (tab_context->web_page_data &&
+            !tab_context->web_page_data->main_document->inner_text.empty()) {
+          base::Value::Dict scripts_summary;
+          scripts_summary.Set(
+              "inner_text_bytes",
+              static_cast<int>(
+                  tab_context->web_page_data->main_document->inner_text.size()));
+          scripts_summary.Set(
+              "inner_text_truncated",
+              tab_context->web_page_data->main_document->inner_text_truncated);
+          out.snapshot.scripts_summary_json = WriteJson(std::move(scripts_summary));
+        }
+
+        if (!target_web_contents || !tab_context->annotated_page_data ||
+            !tab_context->annotated_page_data->annotated_page_content) {
+          std::move(callback).Run(std::move(out));
+          return;
+        }
+
+        std::optional<optimization_guide::proto::AnnotatedPageContent> apc =
+            tab_context->annotated_page_data->annotated_page_content
+                ->As<optimization_guide::proto::AnnotatedPageContent>();
+        if (!apc.has_value()) {
+          std::move(callback).Run(std::move(out));
+          return;
+        }
+
+        auto selector_sidecar =
+            ConvertSelectorSidecar(tab_context->annotated_page_data);
+        dashboard::BuildUnifiedPageMapFromAnnotatedPageContent(
+            target_web_contents, std::move(*apc), out.snapshot.url,
+            selector_sidecar,
+            base::BindOnce([](CaptureCallback callback, CaptureResult out,
+                              dashboard::UnifiedPageMapResult page_map) {
+              if (page_map.ok) {
+                PopulateSnapshotElementsFromPageMap(page_map.page_map,
+                                                    &out.snapshot);
+              }
+              std::move(callback).Run(std::move(out));
+            },
+                           std::move(callback), std::move(out)));
+      },
+      profile, policy, target_web_contents, std::move(callback));
+
+  if (use_actor_context) {
+    service_->sharing_manager().GetContextForActorFromTab(
+        tab_handle, options, std::move(finish_capture));
+    return;
+  }
+  service_->sharing_manager().GetContextFromTab(
+      tab_handle, options, std::move(finish_capture));
+}
+
+}  // namespace glic
