+std::string BuildPreflightTroubleshootingHint(
+    const ActionValidationFailure& failure) {
+  const std::string kind = base::ToLowerASCII(failure.kind);
+  if (kind == "unknown" || failure.error.find("Unknown action type") !=
+                               std::string::npos) {
+    return "Open the script in the timeline editor and inspect the failing "
+           "step for a deprecated or corrupted action type.";
+  }
+  if (kind == "drag" || kind == "cdp_drag") {
+    return "Check the drag step in the timeline editor. Older scripts may "
+           "still use deprecated CDP drag action names that need migration.";
+  }
+  if (kind == "type" || kind == "key_press" || kind == "key_down") {
+    return "Inspect the action params in the timeline editor and confirm the "
+           "locator and required fields were preserved.";
+  }
+  return "Open the script in the timeline editor and review the failing step "
+         "shown in the run error.";
+}
