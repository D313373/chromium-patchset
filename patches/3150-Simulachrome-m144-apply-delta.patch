+    }
+    return false;
+  }
+
+  std::vector<dashboard::NativePageMapCandidate> selected_rows;
+  selected_rows.reserve(row_indices_zero_based.size());
+  for (int row_index_zero_based : row_indices_zero_based) {
+    if (row_index_zero_based < 0 ||
+        row_index_zero_based >= static_cast<int>(rows->size())) {
+      if (error_out) {
+        *error_out = "One or more requested row indices are out of range";
+      }
+      return false;
+    }
+    selected_rows.push_back((*rows)[static_cast<size_t>(row_index_zero_based)]);
+  }
+  *rows = std::move(selected_rows);
+  return true;
+}
+
+base::Value::List BuildRowsJsonFromCandidateMatches(
+    const std::vector<dashboard::ScrapeTableField>& fields,
+    const std::vector<dashboard::NativePageMapCandidate>& rows,
+    const std::vector<dashboard::NativePageMapCandidate>& all_candidates,
+    const std::vector<std::vector<dashboard::NativePageMapCandidate>>&
+        field_matches) {
+  base::Value::List rows_json;
+  const bool guided_single_record_mode =
+      rows.size() == 1u && CandidateIsRootLike(rows.front());
+  if (rows.empty()) {
+    base::Value::Dict row_dict;
+    bool has_data = false;
+    for (size_t i = 0; i < fields.size(); ++i) {
+      std::string value;
+      if (i < field_matches.size() && !field_matches[i].empty()) {
+        value = BestCandidateValue(field_matches[i].front());
+      }
+      value =
+          ApplyFindReplaceRules(std::move(value), fields[i].find_replace_rules);
+      row_dict.Set(fields[i].name, value);
+      if (!value.empty()) {
+        has_data = true;
+      }
+    }
+    if (has_data) {
+      rows_json.Append(std::move(row_dict));
+    }
+    return rows_json;
+  }
+
+  for (const auto& row : rows) {
+    base::Value::Dict row_dict;
+    bool has_data = false;
+    for (size_t i = 0; i < fields.size(); ++i) {
+      std::string value;
+      if (i < field_matches.size()) {
+        std::optional<dashboard::NativePageMapCandidate> field_candidate;
+        if (guided_single_record_mode) {
+          field_candidate =
+              BestFieldCandidateForGuidedSingleRecord(fields[i],
+                                                     field_matches[i]);
+        } else {
+          field_candidate = BestFieldCandidateForRow(row, field_matches[i]);
+        }
+        if (field_candidate.has_value()) {
+          value = BestCandidateValue(*field_candidate);
+        } else if (std::optional<int> nth_index =
+                       ParseFieldNthSingleIndexOneBased(fields[i]);
+                   nth_index.has_value()) {
+          if (std::optional<dashboard::NativePageMapCandidate> cell_candidate =
+                  PickRowCellForVisualColumn(row, all_candidates, *nth_index)) {
+            value = BestCandidateValue(*cell_candidate);
+          }
+        }
+      }
+      value =
+          ApplyFindReplaceRules(std::move(value), fields[i].find_replace_rules);
+      row_dict.Set(fields[i].name, value);
+      if (!value.empty()) {
+        has_data = true;
+      }
+    }
+    if (has_data) {
+      rows_json.Append(std::move(row_dict));
+    }
+  }
+  return rows_json;
+}
+
+base::Value::List LocatorsToValueList(
+    const std::vector<dashboard::Locator>& locators) {
+  base::Value::List out;
+  for (const auto& locator : locators) {
+    out.Append(dashboard::LocatorToValue(locator));
+  }
+  return out;
+}
+
+base::Value::List BuildLocatorSetsForSemanticResolve(
+    const std::vector<dashboard::Locator>& row_locators,
+    const std::vector<dashboard::ScrapeTableField>& fields) {
+  base::Value::List sets;
+  if (!row_locators.empty()) {
+    sets.Append(LocatorsToValueList(row_locators));
+  }
+  for (const auto& field : fields) {
+    sets.Append(LocatorsToValueList(field.locators));
+  }
+  return sets;
+}
+
+bool TryReadIntLike(const base::Value::Dict& dict, const char* key, int* out) {
+  if (!out) {
+    return false;
+  }
+  if (std::optional<int> value = dict.FindInt(key)) {
+    *out = *value;
+    return true;
+  }
+  if (std::optional<double> value = dict.FindDouble(key)) {
+    *out = static_cast<int>(*value);
+    return true;
+  }
+  return false;
+}
+
+std::optional<dashboard::NativePageMapCandidate> CandidateFromSemanticResultDict(
+    const base::Value::Dict& dict,
+    const std::string& frame_id) {
+  auto find_string_or_empty = [&dict](const char* key) -> std::string {
+    const std::string* value = dict.FindString(key);
+    return value ? *value : std::string();
+  };
+
+  dashboard::NativePageMapCandidate candidate;
+  candidate.frame_id = frame_id;
+  candidate.tag = find_string_or_empty("tag");
+  candidate.text = find_string_or_empty("text");
+  candidate.accessibility_name = find_string_or_empty("accessibilityName");
+  candidate.role = find_string_or_empty("role");
+  candidate.id_attr = find_string_or_empty("idAttr");
+  candidate.class_attr = find_string_or_empty("classAttr");
+  candidate.name_attr = find_string_or_empty("nameAttr");
+  candidate.css_selector = find_string_or_empty("cssSelector");
+  candidate.xpath = find_string_or_empty("xpath");
+  candidate.resource_path = find_string_or_empty("resourcePath");
+  candidate.visible = dict.FindBool("visible").value_or(false);
+  candidate.clickable = dict.FindBool("clickable").value_or(false);
+  candidate.focusable = dict.FindBool("focusable").value_or(false);
+  candidate.editable = dict.FindBool("editable").value_or(false);
+  candidate.disabled = dict.FindBool("disabled").value_or(false);
+
+  TryReadIntLike(dict, "x", &candidate.x);
+  TryReadIntLike(dict, "y", &candidate.y);
+  TryReadIntLike(dict, "width", &candidate.width);
+  TryReadIntLike(dict, "height", &candidate.height);
+  TryReadIntLike(dict, "rowIndex", &candidate.row_index);
+  TryReadIntLike(dict, "colIndex", &candidate.col_index);
+  TryReadIntLike(dict, "rowSpan", &candidate.row_span);
+  TryReadIntLike(dict, "colSpan", &candidate.col_span);
+  candidate.row_span = std::max(1, candidate.row_span);
+  candidate.col_span = std::max(1, candidate.col_span);
+  if (candidate.width <= 0 || candidate.height <= 0) {
+    return std::nullopt;
+  }
+  return candidate;
+}
+
+void AppendSemanticResultMatchesForFrame(
+    const std::string& frame_id,
+    const base::Value& result_value,
+    std::vector<std::vector<dashboard::NativePageMapCandidate>>* set_matches) {
+  if (!set_matches) {
+    return;
+  }
+  const base::Value::Dict* result_dict = result_value.GetIfDict();
+  if (!result_dict) {
+    return;
+  }
+  const base::Value::List* sets = result_dict->FindList("sets");
+  if (!sets) {
+    return;
+  }
+  for (size_t set_index = 0;
+       set_index < sets->size() && set_index < set_matches->size();
+       ++set_index) {
+    const base::Value::List* matches = (*sets)[set_index].GetIfList();
+    if (!matches) {
+      continue;
+    }
+    for (const auto& match_value : *matches) {
+      const base::Value::Dict* match_dict = match_value.GetIfDict();
+      if (!match_dict) {
+        continue;
+      }
+      std::optional<dashboard::NativePageMapCandidate> candidate =
+          CandidateFromSemanticResultDict(*match_dict, frame_id);
+      if (candidate.has_value()) {
+        (*set_matches)[set_index].push_back(std::move(*candidate));
+      }
+    }
+  }
+}
+
+const char kSemanticLocatorResolverJs[] = R"JS(
+(function(locatorSets){
+  const norm = (v) => String(v == null ? '' : v).replace(/\s+/g, ' ').trim();
+  const lower = (v) => norm(v).toLowerCase();
+  const safeQsa = (sel, root) => {
+    try {
+      return Array.from((root || document).querySelectorAll(String(sel || '')));
+    } catch (_) {
+      return [];
+    }
+  };
+  const byXPath = (xp, root) => {
+    try {
+      const doc = (root && root.ownerDocument) ? root.ownerDocument : document;
+      const snapshot = doc.evaluate(
+          String(xp || ''),
+          root || doc,
+          null,
+          XPathResult.ORDERED_NODE_SNAPSHOT_TYPE,
+          null);
+      const out = [];
+      for (let i = 0; i < snapshot.snapshotLength; ++i) {
+        out.push(snapshot.snapshotItem(i));
+      }
+      return out;
+    } catch (_) {
+      return [];
+    }
+  };
+  const uniqNodes = (nodes) => {
+    const out = [];
+    const seen = new Set();
+    for (const node of nodes || []) {
+      if (!node || node.nodeType !== 1 || seen.has(node)) {
+        continue;
+      }
+      seen.add(node);
+      out.push(node);
+    }
+    return out;
+  };
+  const allElements = () => Array.from(document.querySelectorAll('*'));
+  const textFor = (el) => norm(el ? (el.innerText || el.textContent || '') : '');
+  const ariaNameFor = (el) => {
+    if (!el) {
+      return '';
+    }
+    const aria = el.getAttribute('aria-label');
+    if (aria) {
+      return norm(aria);
+    }
+    return textFor(el);
+  };
+  const byShadowChain = (chain) => {
+    const parts = String(chain || '').split('>>').map((s) => s.trim()).filter(Boolean);
+    if (!parts.length) {
+      return [];
+    }
+    let nodes = [document];
+    for (let i = 0; i < parts.length; ++i) {
+      const part = parts[i];
+      const next = [];
+      for (const node of nodes) {
+        if (i === 0) {
+          next.push(...safeQsa(part, node));
+          continue;
+        }
+        const root = node && node.shadowRoot;
+        if (root) {
+          next.push(...safeQsa(part, root));
+        }
+      }
+      nodes = uniqNodes(next);
+      if (!nodes.length) {
+        break;
+      }
+    }
+    return nodes;
+  };
+  const parseCoords = (raw) => {
+    const match = String(raw || '').match(/(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)/);
+    if (!match) {
+      return null;
+    }
+    return {x: Number(match[1]), y: Number(match[2])};
+  };
+  const findByText = (value, partial) => {
+    const needle = lower(value);
+    if (!needle) {
+      return [];
+    }
+    return allElements().filter((el) => {
+      const hay = lower(textFor(el));
+      return partial ? hay.includes(needle) : hay === needle;
+    });
+  };
+  const findByAria = (value) => {
+    const needle = lower(value);
+    if (!needle) {
+      return [];
+    }
+    return allElements().filter((el) => lower(ariaNameFor(el)) === needle);
+  };
+  const cssPath = (el) => {
+    if (!el || el.nodeType !== 1) {
+      return '';
+    }
+    const parts = [];
+    let cur = el;
+    while (cur && cur.nodeType === 1) {
+      let part = String(cur.tagName || '').toLowerCase();
+      if (!part) {
+        break;
+      }
+      if (cur.id) {
+        part += `#${cur.id}`;
+        parts.unshift(part);
+        break;
+      }
+      let index = 1;
+      let sib = cur.previousElementSibling;
+      while (sib) {
+        if (sib.tagName === cur.tagName) {
+          ++index;
+        }
+        sib = sib.previousElementSibling;
+      }
+      part += `:nth-of-type(${index})`;
+      parts.unshift(part);
+      cur = cur.parentElement;
+    }
+    return parts.join(' > ');
+  };
+  const xpathFor = (el) => {
+    if (!el || el.nodeType !== 1) {
+      return '';
+    }
+    const segments = [];
+    let cur = el;
+    while (cur && cur.nodeType === 1) {
+      const tag = String(cur.tagName || '').toLowerCase();
+      if (!tag) {
+        break;
+      }
+      let index = 1;
+      let sib = cur.previousElementSibling;
+      while (sib) {
+        if (sib.tagName === cur.tagName) {
+          ++index;
+        }
+        sib = sib.previousElementSibling;
+      }
+      segments.unshift(`${tag}[${index}]`);
+      cur = cur.parentElement;
+    }
+    return '/' + segments.join('/');
+  };
+  const resourcePathFor = (el) => {
+    if (!el || el.nodeType !== 1) {
+      return '';
+    }
+    const parts = [];
+    let cur = el;
+    while (cur && cur.nodeType === 1) {
+      const tag = String(cur.tagName || '').toLowerCase();
+      if (!tag) {
+        break;
+      }
+      let index = 1;
+      let sib = cur.previousElementSibling;
+      while (sib) {
+        if (sib.tagName === cur.tagName) {
+          ++index;
+        }
+        sib = sib.previousElementSibling;
+      }
+      parts.unshift(`${tag}[${index}]`);
+      cur = cur.parentElement;
+    }
+    return parts.join('/');
+  };
+  const elementToCandidate = (el) => {
+    if (!el || el.nodeType !== 1) {
+      return null;
+    }
+    const rect = el.getBoundingClientRect();
+    if (!rect || rect.width <= 0 || rect.height <= 0) {
+      return null;
+    }
+    const style = window.getComputedStyle(el);
+    const tag = String(el.tagName || '').toLowerCase();
+    const disabled = !!(el.disabled || el.getAttribute('aria-disabled') === 'true');
+    const visible = !!style &&
+      style.visibility !== 'hidden' &&
+      style.display !== 'none' &&
+      Number(style.opacity || '1') > 0 &&
+      rect.width > 0 && rect.height > 0;
+    const clickable = !!el.onclick ||
+      el.hasAttribute('onclick') ||
+      tag === 'a' || tag === 'button' || tag === 'summary';
+    const hasTabIndex = el.hasAttribute('tabindex');
+    const tabIndex = Number(el.getAttribute('tabindex'));
+    const focusable = !disabled &&
+      (el.isContentEditable ||
+       tag === 'input' || tag === 'textarea' || tag === 'select' ||
+       tag === 'button' || tag === 'a' ||
+       (hasTabIndex && Number.isFinite(tabIndex) && tabIndex >= 0));
+    const editable = !disabled &&
+      (el.isContentEditable || tag === 'textarea' ||
+       (tag === 'input' && String(el.type || '').toLowerCase() !== 'hidden'));
+    const rawRowSpan = Number(el.getAttribute('rowspan') || el.rowSpan || 1);
+    const rawColSpan = Number(el.getAttribute('colspan') || el.colSpan || 1);
+    const rawAriaRowIndex = Number(el.getAttribute('aria-rowindex') || 0);
+    const rawAriaColIndex = Number(el.getAttribute('aria-colindex') || 0);
+    return {
+      tag,
+      text: textFor(el),
+      accessibilityName: ariaNameFor(el),
+      role: norm(el.getAttribute('role') || ''),
+      idAttr: el.id || '',
+      classAttr: norm(el.className || ''),
+      nameAttr: el.getAttribute('name') || '',
+      cssSelector: cssPath(el),
+      xpath: xpathFor(el),
+      resourcePath: resourcePathFor(el),
+      x: Math.round(rect.left),
+      y: Math.round(rect.top),
+      width: Math.round(rect.width),
+      height: Math.round(rect.height),
+      rowIndex: Number.isFinite(rawAriaRowIndex) && rawAriaRowIndex > 0 ?
+        Math.round(rawAriaRowIndex) : 0,
+      colIndex: Number.isFinite(rawAriaColIndex) && rawAriaColIndex > 0 ?
+        Math.round(rawAriaColIndex) : 0,
+      rowSpan: Number.isFinite(rawRowSpan) && rawRowSpan > 0 ?
+        Math.round(rawRowSpan) : 1,
+      colSpan: Number.isFinite(rawColSpan) && rawColSpan > 0 ?
+        Math.round(rawColSpan) : 1,
+      visible,
+      clickable,
+      focusable,
+      editable,
+      disabled
+    };
+  };
+  const resolveLocator = (loc) => {
+    const type = String(loc && loc.type || '').toUpperCase();
+    const value = String(loc && loc.value || '');
+    switch (type) {
+      case 'CSS_SELECTOR':
+        return safeQsa(value);
+      case 'ID': {
+        const byId = document.getElementById(value);
+        return byId ? [byId] : [];
+      }
+      case 'NAME':
+        return safeQsa(`[name="${value.replace(/"/g, '\\"')}"]`);
+      case 'CLASS_NAME':
+        return value ? Array.from(document.getElementsByClassName(value)) : [];
+      case 'TAG_NAME':
+        return value ? Array.from(document.getElementsByTagName(value)) : [];
+      case 'XPATH':
+        return byXPath(value);
+      case 'LINK_TEXT':
+        return safeQsa('a').filter((el) => textFor(el) === norm(value));
+      case 'PARTIAL_LINK_TEXT': {
+        const needle = lower(value);
+        if (!needle) {
+          return [];
+        }
+        return safeQsa('a').filter((el) => lower(textFor(el)).includes(needle));
+      }
+      case 'TEXT_CONTENT':
+        return findByText(value, true);
+      case 'ACCESSIBILITY_NAME':
+        return findByAria(value);
+      case 'SHADOW_DOM':
+        return byShadowChain(value);
+      case 'VISUAL_COORDS': {
+        const coords = parseCoords(value);
+        if (!coords) {
+          return [];
+        }
+        const at = document.elementFromPoint(coords.x, coords.y);
+        return at ? [at] : [];
+      }
+      case 'JS_EVAL':
+        try {
+          const out = (0, eval)(value);
+          if (Array.isArray(out)) {
+            return out.filter((n) => n && n.nodeType === 1);
+          }
+          return out && out.nodeType === 1 ? [out] : [];
+        } catch (_) {
+          return [];
+        }
+      default:
+        return [];
+    }
+  };
+  const resolveSet = (setLocators) => {
+    const merged = [];
+    for (const loc of (Array.isArray(setLocators) ? setLocators : [])) {
+      merged.push(...resolveLocator(loc));
+    }
+    return uniqNodes(merged).map(elementToCandidate).filter(Boolean);
+  };
+
+  const sets = Array.isArray(locatorSets) ? locatorSets : [];
+  return {ok: true, sets: sets.map(resolveSet)};
+})
+)JS";
