+  int digits = 0;
+  int letters = 0;
+  int hyphens = 0;
+  for (char c : token) {
+    const unsigned char uc = static_cast<unsigned char>(c);
+    if (std::isdigit(uc)) {
+      ++digits;
+    } else if (std::isalpha(uc)) {
+      ++letters;
+    } else if (c == '-' || c == '_') {
+      ++hyphens;
+    }
+  }
+  if (token.size() >= 8 && digits >= 3) {
+    return true;
