+#!/usr/bin/env python3
+"""Ask a local Ollama model to generate a Simulachrome scrape_table script, then run it."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+import urllib.request
+from pathlib import Path
+
+SRC = Path(__file__).resolve().parents[2]
+BRIDGE_DIR = SRC / "chrome/browser/resources/dashboard"
+SCRIPTS_DIR = Path.home() / "Library/Application Support/Simulachrome/Scripts"
+DEFAULT_OUT = SCRIPTS_DIR / "agent_generated_practice_table_scrape.json"
+OLLAMA_URL = "http://127.0.0.1:11434/api/chat"
+MODEL = "qwen3-coder-next"
+
+SYSTEM = """You write Simulachrome scripts as JSON only (one object).
+Keep steps short. Prefer {"action":"...","params":{"url"|"sel"|"text"|...}}.
+waitType is time|element only. Adapter expands sel -> locators.
+Use navigate, wait, scrape_table. No Playwright/Selenium.
+"""
+
+USER = """Create a script that:
+1) navigates to https://practicetestautomation.com/practice-test-table/
+2) waits for #courses_table tbody tr (waitType element)
+3) scrapes all rows from #courses_table with fields:
+   id (td[data-col='id']), course (td[data-col='course']), language (td[data-col='language']),
+   level (td[data-col='level']), enrollments (td[data-col='enrollments']),
+   link_text (td[data-col='link'] a)
+Save CSV as agent_generated_practice_courses.csv and variableName automation_courses.
+id should be agent_generated_practice_table_scrape.
+"""
+
+
+def extract_json_block(text: str) -> dict:
+  raw = text or ""
+  m = re.search(r"```json\s*(.*?)\s*```", raw, re.DOTALL | re.IGNORECASE)
+  candidate = m.group(1).strip() if m else raw.strip()
+  # Fallback: first {...} object
+  if not candidate.startswith("{"):
+    start = candidate.find("{")
+    end = candidate.rfind("}")
+    if start >= 0 and end > start:
+      candidate = candidate[start : end + 1]
+  data = json.loads(candidate)
+  if not isinstance(data, dict):
+    raise RuntimeError("model did not return a JSON object")
+  return data
+
+
+def ask_ollama(model: str, endpoint: str) -> dict:
+  body = {
+      "model": model,
+      "stream": False,
+      "messages": [
+          {"role": "system", "content": SYSTEM},
+          {"role": "user", "content": USER},
+      ],
+  }
+  req = urllib.request.Request(
+      endpoint,
+      data=json.dumps(body).encode("utf-8"),
+      headers={"Content-Type": "application/json", "Accept": "application/json"},
+      method="POST",
+  )
+  with urllib.request.urlopen(req, timeout=300) as resp:
+    payload = json.loads(resp.read().decode("utf-8"))
+  content = (
+      (payload.get("message") or {}).get("content")
+      or payload.get("response")
+      or ""
+  )
+  return extract_json_block(content)
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--out", type=Path, default=DEFAULT_OUT)
+  parser.add_argument("--model", default=MODEL)
+  parser.add_argument("--endpoint", default=OLLAMA_URL)
+  parser.add_argument("--cdp-port", type=int, default=9223)
+  parser.add_argument("--timeout-sec", type=float, default=180.0)
+  parser.add_argument("--run", action="store_true", help="Execute generated script via bridge")
+  parser.add_argument("--skip-generate", action="store_true", help="Reuse --out without calling model")
+  args = parser.parse_args()
+
+  if args.skip_generate:
+    script = json.loads(args.out.read_text(encoding="utf-8"))
+  else:
+    print(f"[agent] requesting script from {args.model}…", flush=True)
+    script = ask_ollama(args.model, args.endpoint)
+    if not script.get("id"):
+      script["id"] = "agent_generated_practice_table_scrape"
+    if not script.get("name"):
+      script["name"] = "Agent Generated Practice Table Scrape"
+    script.setdefault("kind", "main")
+    script.setdefault("schema_version", "1.0.0")
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(script, indent=2) + "\n", encoding="utf-8")
+    print(f"[agent] wrote {args.out}", flush=True)
+    print(json.dumps({"actions": script.get("actions")}, indent=2)[:2000], flush=True)
+
+  if not args.run:
+    return 0
+
+  sys.path.insert(0, str(BRIDGE_DIR))
+  from headless_executor_bridge import HeadlessExecutorBridge  # noqa: E402
+
+  actions = script.get("timeline") or script.get("actions") or []
+  if not isinstance(actions, list) or not actions:
+    raise RuntimeError("generated script has no actions")
+
+  bridge = HeadlessExecutorBridge(cdp_port=args.cdp_port)
+  bridge.connect(startup_timeout_sec=60.0)
+  try:
+    work_target_id = bridge.create_work_target("about:blank")
+    print(f"work_target_id={work_target_id}", flush=True)
+    result = bridge.run_timeline(
+        [a for a in actions if isinstance(a, dict)],
+        work_target_id=work_target_id,
+        wait_for_completion=True,
+        force_native_execution=True,
+        timeout_sec=args.timeout_sec,
+    )
+    print(json.dumps(result, indent=2, ensure_ascii=True), flush=True)
+    return 0 if result.get("ok") else 1
+  finally:
+    bridge.close()
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
