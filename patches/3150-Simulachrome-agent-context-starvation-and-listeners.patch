+#include "chrome/browser/ui/webui/dashboard/actions/call_script_action.h"
+#include "chrome/browser/ui/webui/dashboard/script_executor.h"
+#include "chrome/browser/ui/webui/dashboard/script_store.h" // Based on your includes
+#include "chrome/browser/profiles/profile.h"
+
+namespace dashboard {
+namespace actions {
+
+CallScriptAction::CallScriptAction(Profile* profile) : Action(profile) {}
+CallScriptAction::~CallScriptAction() = default;
+
+bool CallScriptAction::SetParams(const base::Value::Dict& params) {
+  const std::string* id = params.FindString("scriptId");
+  if (!id) return false;
+  script_id_ = *id;
+  return true;
+}
+
+void CallScriptAction::Execute(
+    content::WebContents* web_contents,
+    base::OnceCallback<void(bool, const std::string&)> callback) {
+  
+  // 1. Fetch the script from your store
+  // Assuming ScriptStore is a KeyedService or similar global access pattern
+  auto* store = ScriptStore::GetForProfile(profile_);
+  const base::Value::Dict* script_data = store ? store->GetScript(script_id_) : nullptr;
+
+  if (!script_data) {
+    std::move(callback).Run(false, "Script not found: " + script_id_);
+    return;
+  }
+
+  const base::Value::List* timeline = script_data->FindList("timeline");
+  if (!timeline) {
+    std::move(callback).Run(false, "Script has no timeline: " + script_id_);
+    return;
+  }
+
+  // 2. Access the ScriptExecutor
+  // Note: Usually, the action is currently BEING RUN by the ScriptExecutor.
+  // We want to tell the executor to "expand" this script into the current queue.
+  auto* executor = ScriptExecutor::GetForProfile(profile_);
+  if (!executor) {
+    std::move(callback).Run(false, "Executor unavailable");
+    return;
+  }
+
+  // 3. Injection Logic
+  // We append the actions from the sub-script into the active executor.
+  for (const auto& action_value : *timeline) {
+    if (action_value.is_dict()) {
+      executor->AppendAction(action_value.GetDict().Clone());
+    }
+  }
+
+  // Success: The "CallScript" action itself is done once it has 
+  // successfully queued the sub-actions.
+  std::move(callback).Run(true, "Injected " + std::to_string(timeline->size()) + " actions");
 }
 
 }  // namespace actions
