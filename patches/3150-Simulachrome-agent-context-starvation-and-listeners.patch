+#include "chrome/browser/ui/webui/dashboard/actions/cdp/cdp_action_base.h"
+
+#include "base/containers/flat_map.h"
+#include "base/json/json_string_value_serializer.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard_automation_controller.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard_devtools_client.h"
+
+CdpActionBase::CdpActionBase(Profile* profile)
+    : dashboard::actions::Action(profile) {
+  std::random_device rd;
+  random_engine_.seed(rd());
+}
+
+CdpActionBase::~CdpActionBase() = default;
+
+namespace {
+
+using SessionStateMap =
+    base::flat_map<content::WebContents*, CdpActionBase::SessionState>;
+
+SessionStateMap& GetSessionStateMap() {
+  static base::NoDestructor<SessionStateMap> state_map;
+  return *state_map;
+}
+
+}  // namespace
+
+void CdpActionBase::ExecuteCdpCommand(
+    dashboard::DashboardDevToolsClient* client,
+    const std::string& method,
+    base::Value::Dict params,
+    CdpCallback callback) {
+  if (!client) {
+    std::move(callback).Run(false, "DevTools client not available");
+    return;
+  }
+  const int id = client->SendCommand(
+      method, std::move(params),
+      base::BindOnce(&CdpActionBase::OnCdpCommandComplete,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+  if (id == 0) {
+    return;
+  }
+}
+
+dashboard::DashboardDevToolsClient* CdpActionBase::GetDevToolsClient(
+    content::WebContents* web_contents) {
+  return GetOrCreateDashboardDevToolsClientForTab(web_contents);
+}
+
+int CdpActionBase::GetRandomRange(int min, int max) const {
+  std::uniform_int_distribution<int> dist(min, max);
+  return dist(random_engine_);
+}
+
+double CdpActionBase::GetRandomDouble(double min, double max) const {
+  std::uniform_real_distribution<double> dist(min, max);
+  return dist(random_engine_);
+}
+
+double CdpActionBase::GetRandomGaussian(double mean, double std_dev) const {
+  std::normal_distribution<double> dist(mean, std_dev);
+  return dist(random_engine_);
+}
+
+bool CdpActionBase::RollProbability(double chance_percent) const {
+  return GetRandomDouble(0.0, 100.0) <= chance_percent;
+}
+
+CdpActionBase::SessionState& CdpActionBase::GetSessionState(
+    content::WebContents* web_contents) const {
+  return GetSessionStateMap()[web_contents];
+}
+
+void CdpActionBase::OnCdpCommandComplete(CdpCallback callback,
+                                         bool success,
+                                         const std::string& error) {
+  std::move(callback).Run(success, error);
+}
