+void TypeAction::Execute(content::WebContents* web_contents, Callback callback) {
+  if (!web_contents) {
+    std::move(callback).Run(false, "No web contents");
+    return;
+  }
+
+  if (!locators_.empty()) {
+    const std::vector<dashboard::Locator> scoped_locators =
+        BuildScopedTypingLocators(locators_, frame_hint_locators_);
+    focus_click_action_ = std::make_unique<ClickAction>(profile_);
+    focus_click_action_->SetExecutionPathLabel("native");
+    if (focus_click_action_->SetParams(
+            BuildTypeFocusClickParams(scoped_locators, wait_timeout_ms_,
+                                      IsForceNativeRun()))) {
+      focus_click_action_->Execute(
+          web_contents,
+          base::BindOnce(&TypeAction::OnFocusClickComplete,
+                         weak_ptr_factory_.GetWeakPtr(), web_contents,
+                         std::move(callback)));
+      return;
+    }
+    focus_click_action_.reset();
+  }
+
+  const std::vector<dashboard::Locator> runtime_locators =
+      locators_.empty() ? std::vector<dashboard::Locator>()
+                        : BuildScopedTypingLocators(locators_,
+                                                    frame_hint_locators_);
+  type_handler_ = std::make_unique<TypeHandler>(web_contents);
+  type_handler_->ExecuteTypeAsync(
+      runtime_locators, text_to_type_, wait_timeout_ms_,
+      base::BindOnce(&TypeAction::OnTypeComplete,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void TypeAction::OnFocusClickComplete(content::WebContents* web_contents,
+                                      Callback callback,
+                                      bool success,
+                                      const std::string& message) {
+  focus_click_action_.reset();
+  if (!success) {
+    std::move(callback).Run(false, "Type focus click failed: " + message);
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&TypeAction::StartTypingAfterFocusClick,
+                     weak_ptr_factory_.GetWeakPtr(), web_contents,
+                     std::move(callback)),
+      base::Milliseconds(120));
+}
+
+void TypeAction::StartTypingAfterFocusClick(content::WebContents* web_contents,
+                                            Callback callback) {
+  type_handler_ = std::make_unique<TypeHandler>(web_contents);
+  type_handler_->ExecuteTypeAsync(
+      {}, text_to_type_, wait_timeout_ms_,
+      base::BindOnce(&TypeAction::OnTypeComplete,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void TypeAction::OnTypeComplete(Callback callback,
+                                bool success,
+                                const dashboard::ResolvedElement& element,
+                                const std::string& error) {
+  if (success) {
+    dashboard::PromoteActionParamsFromResolvedElement(&serialized_params_,
+                                                      element);
+    SanitizeSerializedTypeParams(&serialized_params_);
+  }
+  std::move(callback).Run(success, error);
+}
