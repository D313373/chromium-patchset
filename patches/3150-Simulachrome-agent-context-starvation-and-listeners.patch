+// Minimum interval: 5 minutes
+constexpr int64_t kMinIntervalMs = 5 * 60 * 1000;
+
+// Maximum interval: 365 days
+constexpr int64_t kMaxIntervalMs = 365LL * 24 * 60 * 60 * 1000;
+
+std::string TimeToIso8601(base::Time time) {
+  base::Time::Exploded exploded;
+  time.UTCExplode(&exploded);
+  return base::StringPrintf("%04d-%02d-%02dT%02d:%02d:%02d.%03dZ",
+                            exploded.year, exploded.month, exploded.day_of_month,
+                            exploded.hour, exploded.minute, exploded.second,
+                            exploded.millisecond);
+}
+
+base::Time Iso8601ToTime(const std::string& iso) {
+  base::Time time;
+  if (!base::Time::FromString(iso.c_str(), &time)) {
+    return base::Time();
+  }
+  return time;
+}
