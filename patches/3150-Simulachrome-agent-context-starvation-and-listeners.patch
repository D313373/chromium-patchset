+bool ReadBool(const base::Value::Dict* dict,
+              std::string_view key,
+              bool default_value) {
+  if (!dict) {
+    return default_value;
+  }
+  if (const std::optional<bool> value = dict->FindBool(key)) {
+    return *value;
+  }
+  return default_value;
+}
+
+int ReadInt(const base::Value::Dict* dict,
+            std::string_view key,
+            int default_value) {
+  if (!dict) {
+    return default_value;
+  }
+  if (const std::optional<int> value = dict->FindInt(key)) {
+    return *value;
+  }
+  return default_value;
+}
+
+std::string ReadString(const base::Value::Dict* dict,
+                       std::string_view key,
+                       std::string_view default_value) {
+  if (!dict) {
+    return std::string(default_value);
+  }
+  if (const std::string* value = dict->FindString(key);
+      value && !value->empty()) {
+    return *value;
+  }
+  return std::string(default_value);
+}
