@@ -0,0 +1,271 @@
+import {createDashboardCommandDispatcher} from './command_dispatcher.js';
+import {
+  buildSystemPromptForLoopProfile,
+  normalizeAgentCommandForExecution,
+} from './loop_profiles.js';
+
+function extractJsonCommandFromText(text) {
+  const raw = String(text || '');
+  let searchPos = 0;
+  while (searchPos < raw.length) {
+    const blockStart = raw.indexOf('```json', searchPos);
+    if (blockStart < 0) {
+      break;
+    }
+    const payloadStart = raw.indexOf('\n', blockStart);
+    if (payloadStart < 0) {
+      break;
+    }
+    const blockEnd = raw.indexOf('```', payloadStart + 1);
+    if (blockEnd < 0) {
+      break;
+    }
+    const candidate = raw.slice(payloadStart + 1, blockEnd).trim();
+    try {
+      const parsed = JSON.parse(candidate);
+      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+        return parsed;
+      }
+    } catch (_) {}
+    searchPos = blockEnd + 3;
+  }
+  const trimmed = raw.trim();
+  if (!trimmed) {
+    return null;
+  }
+  // Prefer a bare JSON object even without fences (local models often skip them).
+  const start = trimmed.indexOf('{');
+  const end = trimmed.lastIndexOf('}');
+  if (start >= 0 && end > start) {
+    try {
+      const parsed = JSON.parse(trimmed.slice(start, end + 1));
+      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+        return parsed;
+      }
+    } catch (_) {}
+  }
+  return null;
+}
+
+function extractOllamaAssistantText(payload) {
+  if (!payload || typeof payload !== 'object') {
+    return '';
+  }
+  const message = payload.message;
+  if (message && typeof message === 'object') {
+    return String(message.content || '');
+  }
+  return String(payload.response || '');
+}
+
+async function requestOllamaChat({
+  endpoint,
+  model,
+  systemPrompt,
+  messages,
+  dashboardHandler,
+}) {
+  const payload = {
+    endpoint: String(endpoint || 'http://127.0.0.1:11434').replace(/\/+$/, ''),
+    model: String(model || 'qwen3-coder-next'),
+    system_prompt: String(systemPrompt || ''),
+    messages: Array.isArray(messages) ? messages : [],
+  };
+  if (dashboardHandler && typeof dashboardHandler.agentOllamaChat === 'function') {
+    const res = await dashboardHandler.agentOllamaChat(payload);
+    const httpStatus = Number(res?.http_status || res?.httpStatus || 0);
+    const bodyText = String(res?.body || res?.error || '');
+    if (!res?.ok) {
+      throw new Error(`ollama_http_${httpStatus || 0}:${bodyText.slice(0, 240)}`);
+    }
+    let parsed = null;
+    try {
+      parsed = JSON.parse(bodyText);
+    } catch (e) {
+      throw new Error(`ollama_invalid_json:${String(e && e.message ? e.message : e)}`);
+    }
+    return extractOllamaAssistantText(parsed);
+  }
+
+  // Fallback for non-dashboard contexts only. WebUI pages must proxy via the
+  // browser process; direct fetch to http:// can kill the renderer.
+  const base = payload.endpoint;
+  const url = `${base}/api/chat`;
+  const body = {
+    model: payload.model,
+    stream: false,
+    messages: [
+      {role: 'system', content: payload.system_prompt},
+      ...payload.messages,
+    ],
+  };
+  const response = await fetch(url, {
+    method: 'POST',
+    headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
+    body: JSON.stringify(body),
+  });
+  const text = await response.text();
+  if (!response.ok) {
+    throw new Error(`ollama_http_${response.status}:${text.slice(0, 240)}`);
+  }
+  let parsed = null;
+  try {
+    parsed = JSON.parse(text);
+  } catch (e) {
+    throw new Error(`ollama_invalid_json:${String(e && e.message ? e.message : e)}`);
+  }
+  return extractOllamaAssistantText(parsed);
+}
+
+export function createDashboardAutoHealAgentRunner({
+  windowRef = window,
+  dashboardHandler,
+  chromeSend,
+  preferHeadlessInvestigation = true,
+  getPreferHeadlessInvestigation = null,
+  maxTurns = 18,
+}) {
+  const noop = () => {};
+  const dispatcher = createDashboardCommandDispatcher({
+    appendMessage: noop,
+    historyEl: null,
+    chromeSend: chromeSend || ((name, args) => windowRef.chrome.send(name, args)),
+    parseVisualCoords: () => null,
+    formatVisualCoords: () => '',
+    cubbyRead: () => '',
+    cubbyWrite: noop,
+    onResetAgent: noop,
+    onRefreshPageMapRequested: noop,
+    windowRef,
+  });
+  if (!dispatcher || typeof dispatcher.sendCommandToAgent !== 'function') {
+    return null;
+  }
+
+  const runAutoHealPrompt = async (prompt, options = {}) => {
+    const onProgress = typeof options?.onProgress === 'function' ?
+      options.onProgress :
+      null;
+    const report = (patch) => {
+      try {
+        if (onProgress) {
+          onProgress(patch);
+        }
+      } catch (_) {}
+    };
+    const preferHeadless = typeof getPreferHeadlessInvestigation === 'function' ?
+      !!getPreferHeadlessInvestigation() :
+      !!preferHeadlessInvestigation;
+    const settingsRes = await dashboardHandler.getEffectiveSettings('');
+    const settings = (settingsRes && settingsRes.settings) ? settingsRes.settings : {};
+    const agent = (settings && settings.agent && typeof settings.agent === 'object') ?
+      settings.agent :
+      {};
+    const endpoint = String(
+        agent.ollamaEndpoint || windowRef.__DASH_OLLAMA_ENDPOINT || 'http://127.0.0.1:11434');
+    const model = String(agent.model || windowRef.__DASH_OLLAMA_MODEL || 'qwen3-coder-next');
+    const systemPrompt = [
+      buildSystemPromptForLoopProfile('dashboard_assistant'),
+      '',
+      preferHeadless ?
+        'Auto-heal: investigate (keep tab open) -> small script edit -> verify.' :
+        'Auto-heal: small script edit -> verify. Prefer non-disruptive checks.',
+    ].join('\n');
+
+    const messages = [{
+      role: 'user',
+      content: String(prompt || ''),
+    }];
+    const trace = [];
+
+    for (let turn = 0; turn < maxTurns; turn += 1) {
+      report({
+        phase: 'waiting_model',
+        turn: turn + 1,
+        max_turns: maxTurns,
+        command: '',
+        detail: `Waiting on local model (turn ${turn + 1}/${maxTurns})…`,
+      });
+      const assistantText = await requestOllamaChat({
+        endpoint,
+        model,
+        systemPrompt,
+        messages,
+        dashboardHandler,
+      });
+      messages.push({role: 'assistant', content: assistantText});
+      const rawCommand = extractJsonCommandFromText(assistantText);
+      const command = rawCommand ?
+        normalizeAgentCommandForExecution(rawCommand) :
+        null;
+      if (!command || !command.command) {
+        trace.push({turn, type: 'assistant_text', text: assistantText});
+        report({
+          phase: 'completed',
+          turn: turn + 1,
+          max_turns: maxTurns,
+          command: '',
+          detail: 'Model returned no command; ending heal.',
+        });
+        return {
+          ok: true,
+          status: 'completed_without_command',
+          assistant_text: assistantText,
+          trace,
+        };
+      }
+      report({
+        phase: 'executing_command',
+        turn: turn + 1,
+        max_turns: maxTurns,
+        command: String(command.command || ''),
+        detail: `Executing ${command.command}…`,
+      });
+      const commandResult = await dispatcher.sendCommandToAgent(command);
+      trace.push({turn, command, commandResult});
+      report({
+        phase: 'command_result',
+        turn: turn + 1,
+        max_turns: maxTurns,
+        command: String(command.command || ''),
+        detail: commandResult?.ok === false ?
+          `Command ${command.command} failed: ${String(commandResult?.error || 'error')}` :
+          `Command ${command.command} ok`,
+      });
+      if (command.command === 'agent_finish') {
+        return {
+          ok: commandResult?.ok !== false,
+          status: String(command.payload?.status || commandResult?.status || 'done'),
+          summary: String(command.payload?.summary || commandResult?.summary || ''),
+          trace,
+        };
+      }
+      const resultJson = (() => {
+        try {
+          return JSON.stringify(commandResult || {}, null, 2);
+        } catch (_) {
+          return '{}';
+        }
+      })();
+      messages.push({
+        role: 'user',
+        content: [
+          `Command result for ${command.command}:`,
+          resultJson.length > 12000 ? `${resultJson.slice(0, 12000)}\n... [truncated]` : resultJson,
+          '',
+          'Continue auto-heal. Return the next ```json``` command block or agent_finish.',
+        ].join('\n'),
+      });
+    }
+    report({
+      phase: 'failed',
+      turn: maxTurns,
+      max_turns: maxTurns,
+      command: '',
+      detail: 'Turn budget exceeded',
+    });
+    return {ok: false, error: 'auto_heal_turn_budget_exceeded', trace};
+  };
+
+  return {runAutoHealPrompt};
+}
