+bool KeyPressAction::BuildKeySpec(KeyPressAction::KeySpec* spec,
+                                  std::string* error) const {
+  if (!spec) {
+    if (error) {
+      *error = "Missing key spec output";
+    }
+    return false;
+  }
+
+  const std::string normalized = base::ToLowerASCII(key_);
+  if (key_.size() == 1) {
+    const char c = key_[0];
+    if (c == '\t') {
+      spec->key = "Tab";
+      spec->code = "Tab";
+      spec->key_code = ui::VKEY_TAB;
+      spec->send_char_event = false;
+      spec->text_char = 0;
+      return true;
+    }
+    if (c == '\n' || c == '\r') {
+      spec->key = "Enter";
+      spec->code = "Enter";
+      spec->key_code = ui::VKEY_RETURN;
+      spec->send_char_event = true;
+      spec->text_char = '\r';
+      return true;
+    }
+
+    const unsigned char uc = static_cast<unsigned char>(c);
+    spec->key = std::string(1, c);
+    spec->code = KeyCodeForPrintableChar(c);
+    spec->send_char_event = true;
+    spec->text_char = c;
+    if (std::isalpha(uc)) {
+      const char upper =
+          static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+      spec->key_code = static_cast<int>(ui::VKEY_A + (upper - 'A'));
+    } else if (std::isdigit(uc)) {
+      spec->key_code = static_cast<int>(ui::VKEY_0 + (c - '0'));
+    } else {
+      spec->key_code = static_cast<int>(uc);
+    }
+    return true;
+  }
+
+  spec->send_char_event = false;
+  spec->text_char = 0;
+
+  if (normalized == "enter" || normalized == "return") {
+    spec->key = "Enter";
+    spec->code = "Enter";
+    spec->key_code = ui::VKEY_RETURN;
+    spec->send_char_event = true;
+    spec->text_char = '\r';
+    return true;
+  }
+  if (normalized == "tab") {
+    spec->key = "Tab";
+    spec->code = "Tab";
+    spec->key_code = ui::VKEY_TAB;
+    return true;
+  }
+  if (normalized == "space" || normalized == "spacebar") {
+    spec->key = " ";
+    spec->code = "Space";
+    spec->key_code = ui::VKEY_SPACE;
+    spec->send_char_event = true;
+    spec->text_char = ' ';
+    return true;
+  }
+  if (normalized == "escape" || normalized == "esc") {
+    spec->key = "Escape";
+    spec->code = "Escape";
+    spec->key_code = ui::VKEY_ESCAPE;
+    return true;
+  }
+  if (normalized == "backspace") {
+    spec->key = "Backspace";
+    spec->code = "Backspace";
+    spec->key_code = ui::VKEY_BACK;
+    return true;
+  }
+  if (normalized == "delete") {
+    spec->key = "Delete";
+    spec->code = "Delete";
+    spec->key_code = ui::VKEY_DELETE;
+    return true;
+  }
+  if (normalized == "arrowup" || normalized == "up") {
+    spec->key = "ArrowUp";
+    spec->code = "ArrowUp";
+    spec->key_code = ui::VKEY_UP;
+    return true;
+  }
+  if (normalized == "arrowdown" || normalized == "down") {
+    spec->key = "ArrowDown";
+    spec->code = "ArrowDown";
+    spec->key_code = ui::VKEY_DOWN;
+    return true;
+  }
+  if (normalized == "arrowleft" || normalized == "left") {
+    spec->key = "ArrowLeft";
+    spec->code = "ArrowLeft";
+    spec->key_code = ui::VKEY_LEFT;
+    return true;
+  }
+  if (normalized == "arrowright" || normalized == "right") {
+    spec->key = "ArrowRight";
+    spec->code = "ArrowRight";
+    spec->key_code = ui::VKEY_RIGHT;
+    return true;
+  }
+  if (normalized == "home") {
+    spec->key = "Home";
+    spec->code = "Home";
+    spec->key_code = ui::VKEY_HOME;
+    return true;
+  }
+  if (normalized == "end") {
+    spec->key = "End";
+    spec->code = "End";
+    spec->key_code = ui::VKEY_END;
+    return true;
+  }
+  if (normalized == "pageup") {
+    spec->key = "PageUp";
+    spec->code = "PageUp";
+    spec->key_code = ui::VKEY_PRIOR;
+    return true;
+  }
+  if (normalized == "pagedown") {
+    spec->key = "PageDown";
+    spec->code = "PageDown";
+    spec->key_code = ui::VKEY_NEXT;
+    return true;
+  }
+
+  if (normalized.size() == 2 && normalized[0] == 'f' &&
+      std::isdigit(static_cast<unsigned char>(normalized[1]))) {
+    const int n = normalized[1] - '0';
+    if (n >= 1 && n <= 9) {
+      spec->key = "F" + std::to_string(n);
+      spec->code = "F" + std::to_string(n);
+      spec->key_code = ui::VKEY_F1 + (n - 1);
+      return true;
+    }
+  }
+  if (normalized == "f10") {
+    spec->key = "F10";
+    spec->code = "F10";
+    spec->key_code = ui::VKEY_F10;
+    return true;
+  }
+  if (normalized == "f11") {
+    spec->key = "F11";
+    spec->code = "F11";
+    spec->key_code = ui::VKEY_F11;
+    return true;
+  }
+  if (normalized == "f12") {
+    spec->key = "F12";
+    spec->code = "F12";
+    spec->key_code = ui::VKEY_F12;
+    return true;
+  }
+
+  if (error) {
+    *error = "Unknown key: " + key_;
+  }
+  return false;
+}
+
+void KeyPressAction::SendNativeKeyEvent(content::RenderWidgetHost* rwh,
+                                        content::RenderWidgetHostView* rwhv,
+                                        const KeySpec& spec,
+                                        blink::WebInputEvent::Type type,
+                                        char ch) const {
+  if (!rwh || !rwhv || !rwhv->GetNativeView()) {
+    return;
+  }
+  blink::WebKeyboardEvent event(type, blink::WebInputEvent::kNoModifiers,
+                                base::TimeTicks::Now());
+  event.windows_key_code = spec.key_code;
+  event.native_key_code = spec.key_code;
+  if (type == blink::WebInputEvent::Type::kChar && ch != 0) {
+    event.text[0] = ch;
