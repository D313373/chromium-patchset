+void RecorderController::WaitForOneShotCaptureReady(
+    base::TimeDelta timeout,
+    base::OnceCallback<void(bool, std::string)> callback) {
+  if (!locator_capture_armed_) {
+    std::move(callback).Run(false, "locator_capture_not_armed");
+    return;
