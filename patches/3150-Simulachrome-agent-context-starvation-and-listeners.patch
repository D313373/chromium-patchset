+  const std::string js = base::StringPrintf(
+      R"JS((function(enabled, blockAllAnchorNavigation){
+        try {
+          const key = '__dash_guided_same_tab_guard__';
+          const state = window[key] || (window[key] = {
+            enabled:false,
+            blockAllAnchorNavigation:false,
+            installed:false,
+            handler:null,
+            origOpen:null
