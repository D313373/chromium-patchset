+          state.enabled = !!enabled;
+          state.blockAllAnchorNavigation = !!blockAllAnchorNavigation;
+          if (state.installed) return true;
+          if (!state.origOpen && typeof window.open === 'function') {
+            state.origOpen = window.open.bind(window);
+          }
+          window.open = function(url, target, features) {
