+def _parse_sample_seconds(refresh_seconds: int) -> float:
+  # Headless listeners do not have the in-page mutation observer used by the
+  # native listener path. Keep snapshot polling bounded and separate from the
+  # much slower page refresh cadence so long refresh intervals do not make the
+  # listener effectively blind.
+  default_seconds = max(1.0, HEADLESS_LISTENER_SAMPLE_SECONDS)
+  if refresh_seconds > 0:
+    return float(max(1.0, min(float(refresh_seconds), default_seconds)))
+  return float(default_seconds)
+
