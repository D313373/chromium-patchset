new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/dashboard/unused/headless_listener_background.js
@@ -0,0 +1,133 @@
+// Background bridge for headless listener native host integration.
+// Intended for extension/service-worker usage.
+
+const NATIVE_HOST = 'com.simulachrome.headless_listener';
+let nativePort = null;
+let nextRequestId = 1;
+const pending = new Map();
+let pollLoopActive = false;
+
+const LONG_POLL_WAIT_MS = 30000;
+const POLL_ERROR_BACKOFF_MS = 2000;
+
+function ensurePort() {
+  if (nativePort) return nativePort;
+  nativePort = chrome.runtime.connectNative(NATIVE_HOST);
+  nativePort.onMessage.addListener((msg) => {
+    const rid = msg && msg.request_id;
+    if (rid && pending.has(rid)) {
+      const {resolve} = pending.get(rid);
+      pending.delete(rid);
+      resolve(msg);
+      return;
+    }
+    if (msg && Array.isArray(msg.events)) {
+      for (const ev of msg.events) {
+        chrome.runtime.sendMessage({
+          type: 'dashboard_headless_listener_event',
+          event: ev,
+        });
+      }
+    }
+  });
+  nativePort.onDisconnect.addListener(() => {
+    const err = chrome.runtime.lastError && chrome.runtime.lastError.message
+      ? chrome.runtime.lastError.message
+      : 'native_port_disconnected';
+    for (const [, entry] of pending) entry.reject(new Error(err));
+    pending.clear();
+    nativePort = null;
+  });
+  return nativePort;
+}
+
+function callNative(payload) {
+  return new Promise((resolve, reject) => {
+    const port = ensurePort();
+    const requestId = `${Date.now()}_${nextRequestId++}`;
+    pending.set(requestId, {resolve, reject});
+    try {
+      port.postMessage({
+        ...payload,
+        request_id: requestId,
+      });
+    } catch (e) {
+      pending.delete(requestId);
+      reject(e);
+    }
+  });
+}
+
+async function pollHeadlessEvents() {
+  try {
+    const res = await callNative({type: 'poll_events', wait_ms: LONG_POLL_WAIT_MS});
+    if (!res || !Array.isArray(res.events)) return;
+    for (const ev of res.events) {
+      chrome.runtime.sendMessage({
+        type: 'dashboard_headless_listener_event',
+        event: ev,
+      });
+    }
+    return true;
+  } catch (e) {
+    // Keep polling best-effort.
+    return false;
+  }
+}
+
+function scheduleNextPoll(delayMs) {
+  if (!pollLoopActive) return;
+  setTimeout(async () => {
+    if (!pollLoopActive) return;
+    const ok = await pollHeadlessEvents();
+    scheduleNextPoll(ok ? 0 : POLL_ERROR_BACKOFF_MS);
+  }, Math.max(0, Number(delayMs) || 0));
+}
+
+function ensurePolling() {
+  if (pollLoopActive) return;
+  pollLoopActive = true;
+  scheduleNextPoll(0);
+}
+
+chrome.runtime.onMessage.addListener((message, _sender, sendResponse) => {
+  if (!message || typeof message !== 'object') return;
+  const type = String(message.type || '');
+
+  if (type === 'dashboard_headless_start') {
+    ensurePolling();
+    callNative({
+      type: 'start_headless_listener',
+      script_id: message.script_id || message.scriptId || '',
+      script_path: message.script_path || message.scriptPath || '',
+      profile_dir: message.profile_dir || message.profileDir || '',
+    }).then(sendResponse).catch((e) => sendResponse({ok: false, error: String(e)}));
+    return true;
+  }
+
+  if (type === 'dashboard_headless_stop') {
+    callNative({
+      type: 'stop_headless_listener',
+      script_id: message.script_id || message.scriptId || '',
+      profile_dir: message.profile_dir || message.profileDir || '',
+    }).then(sendResponse).catch((e) => sendResponse({ok: false, error: String(e)}));
+    return true;
+  }
+
+  if (type === 'dashboard_headless_sync_session') {
+    callNative({
+      type: 'sync_session',
+      cookies: Array.isArray(message.cookies) ? message.cookies : [],
+      profile_dir: message.profile_dir || message.profileDir || '',
+    }).then(sendResponse).catch((e) => sendResponse({ok: false, error: String(e)}));
+    return true;
+  }
+
+  if (type === 'dashboard_headless_list') {
+    callNative({type: 'list_active'}).then(sendResponse)
+      .catch((e) => sendResponse({ok: false, error: String(e)}));
+    return true;
+  }
+});
+
+ensurePolling();
