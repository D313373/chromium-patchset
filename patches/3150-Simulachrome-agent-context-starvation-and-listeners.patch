+TEST(AgentModelContractTest, NormalizePlaywrightNavigateStep) {
+  base::Value::Dict step;
+  step.Set("type", "goto");
+  step.Set("url", "https://example.com/table");
+
+  auto normalized = AgentModelContract::NormalizeScriptAction(step);
+  ASSERT_TRUE(normalized);
+  EXPECT_EQ("navigate", *normalized->FindString("action"));
+  const base::Value::Dict* params = normalized->FindDict("params");
+  ASSERT_TRUE(params);
+  EXPECT_EQ("https://example.com/table", *params->FindString("url"));
+}
+
+TEST(AgentModelContractTest, NormalizeSelectorShorthandToLocators) {
+  base::Value::Dict params;
+  params.Set("sel", "#courses_table");
+  auto wrapper =
+      AgentModelContract::NormalizeModelActionPayload("click", &params);
+  EXPECT_EQ("click", *wrapper.FindString("action"));
+  const base::Value::Dict* out = wrapper.FindDict("params");
+  ASSERT_TRUE(out);
+  const base::Value::List* locators = out->FindList("locators");
+  ASSERT_TRUE(locators);
+  ASSERT_EQ(1u, locators->size());
+  const base::Value::Dict* loc = (*locators)[0].GetIfDict();
+  ASSERT_TRUE(loc);
+  EXPECT_EQ("CSS_SELECTOR", *loc->FindString("type"));
+  EXPECT_EQ("#courses_table", *loc->FindString("value"));
+}
+
+TEST(AgentModelContractTest, NormalizeWaitVisibleAlias) {
+  base::Value::Dict step;
+  step.Set("action", "wait");
+  base::Value::Dict params;
+  params.Set("waitType", "visible");
+  params.Set("selector", "table");
+  step.Set("params", std::move(params));
+
+  auto normalized = AgentModelContract::NormalizeScriptAction(step);
+  ASSERT_TRUE(normalized);
+  EXPECT_EQ("wait", *normalized->FindString("action"));
+  const base::Value::Dict* out = normalized->FindDict("params");
+  ASSERT_TRUE(out);
+  EXPECT_EQ("element", *out->FindString("waitType"));
+  const base::Value::List* locators = out->FindList("locators");
+  ASSERT_TRUE(locators);
+  ASSERT_FALSE(locators->empty());
+}
+
+TEST(AgentModelContractTest, NormalizeLooseDoClickWithId) {
+  base::Value::Dict command;
+  command.Set("do", "click");
+  command.Set("id", 12);
+
+  auto normalized =
+      AgentModelContract::NormalizeAgentCommandForExecution(command);
+  EXPECT_EQ("call_action", *normalized.FindString("command"));
+  const base::Value::Dict* action = normalized.FindDict("payload");
+  ASSERT_TRUE(action);
+  EXPECT_EQ("click", *action->FindString("action"));
+  const base::Value::Dict* params = action->FindDict("params");
+  ASSERT_TRUE(params);
+  EXPECT_EQ("12", *params->FindString("id"));
+}
+
+TEST(AgentModelContractTest, NormalizeLooseDoDone) {
+  base::Value::Dict command;
+  command.Set("do", "done");
+  command.Set("why", "form submitted");
+
+  auto normalized =
+      AgentModelContract::NormalizeAgentCommandForExecution(command);
+  EXPECT_EQ("agent_finish", *normalized.FindString("command"));
+  const base::Value::Dict* payload = normalized.FindDict("payload");
+  ASSERT_TRUE(payload);
+  EXPECT_EQ("form submitted", *payload->FindString("summary"));
+  EXPECT_EQ("solved", *payload->FindString("status"));
+}
+
+TEST(AgentModelContractTest, NormalizeLooseDoLookAndInvestigate) {
+  base::Value::Dict look;
+  look.Set("do", "look");
+  EXPECT_EQ("refresh_pagemap",
+            *AgentModelContract::NormalizeAgentCommandForExecution(look)
+                 .FindString("command"));
+
+  base::Value::Dict investigate;
+  investigate.Set("do", "investigate");
+  investigate.Set("url", "https://example.com");
+  auto normalized =
+      AgentModelContract::NormalizeAgentCommandForExecution(investigate);
+  EXPECT_EQ("dashboard_investigate_page", *normalized.FindString("command"));
+}
+
+TEST(AgentModelContractTest, SystemPromptIsShortAndSimple) {
+  const std::string glic = AgentModelContract::BuildSystemPromptForLoopProfile(
+      AgentModelContract::kLoopProfileGlicTask);
+  EXPECT_LT(glic.size(), 1100u);
+  EXPECT_NE(std::string::npos, glic.find("{\"do\":\"click\""));
+  EXPECT_EQ(std::string::npos, glic.find("params.locators"));
+  EXPECT_EQ(std::string::npos, glic.find("dashboard_configure_listener_match"));
+
+  const std::string dash = AgentModelContract::BuildSystemPromptForLoopProfile(
+      AgentModelContract::kLoopProfileDashboardAssistant);
+  EXPECT_LT(dash.size(), 1400u);
+  EXPECT_NE(std::string::npos, dash.find("{\"do\":\"investigate\""));
+  EXPECT_EQ(std::string::npos, dash.find("dashboard_configure_listener_match"));
+}
