new file mode 100644
--- /dev/null
+++ b/tools/simulachrome/cherrypick_upstream_actor_apc.sh
@@ -0,0 +1,97 @@
+#!/usr/bin/env bash
+# Cherry-pick upstream APC + Glic Actor reliability commits onto Simulachrome M144.
+#
+# Usage:
+#   ./tools/simulachrome/cherrypick_upstream_actor_apc.sh wave1
+#   ./tools/simulachrome/cherrypick_upstream_actor_apc.sh wave2
+#   ./tools/simulachrome/cherrypick_upstream_actor_apc.sh all
+#   ./tools/simulachrome/cherrypick_upstream_actor_apc.sh status
+#
+# Run from chromium/src. Requires full upstream object database (commits present locally).
+
+set -euo pipefail
+
+ROOT="$(git rev-parse --show-toplevel)"
+cd "$ROOT"
+
+WAVE1=(
+  # APC geometry / selector stability (older, smaller diffs)
+  "6b7247341b28f7d52babcbbde257523c43b019e5"  # [APC] Align outer bounding box mapping with visible rect
+  "d0035d661509b0286398b95cf31d7e8b2a44fc2b"  # [APC] Promote AIPageContentOuterBoxMapToAncestorSpace to stable
+  "7c306242a7c1da5de70f7b5cc89e9614d8f48cf4"  # page_content_annotations: on-demand APC extraction
+)
+
+WAVE2=(
+  # Actor execution reliability
+  "a30dbf28342faa609711137bab682ce20564692e"  # Do not skip user-edited fields during Glic-triggered filling
+  "1883243951aeb0893ff728319f38f25b59c27e75"  # Add Autofill Dialog Events to Glic API
+  "c32b2366db54d762b532046b88d9021fbb82d10a"  # Enqueue click before attempt form filling (GlicActorAutofillPreClick)
+)
+
+WAVE3=(
+  # Context / diagnostics (lower risk, helpful for debugging inconsistent actor runs)
+  "0da453474857000e3be991d50b2fe67ef2b7acdf"  # glic: Restrict Actor tab context sharing to valid schemes
+  "d6fe6823647420df52ca9fc250bb51e795eb5b1d"  # [Glic] Add telemetry for actuation capability checks
+)
+
+cherrypick_one() {
+  local sha="$1"
+  if git merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
+    echo "[skip] already contains ${sha:0:12}"
+    return 0
+  fi
+  if git log --grep="cherry picked from commit ${sha}" -1 --oneline >/dev/null 2>&1; then
+    echo "[skip] cherry-pick recorded for ${sha:0:12}"
+    return 0
+  fi
+  echo "[pick] ${sha:0:12} $(git show -s --format='%s' "$sha")"
+  git cherry-pick -x "$sha"
+}
+
+cherrypick_list() {
+  local label="$1"
+  shift
+  local commits=("$@")
+  echo "=== ${label} (${#commits[@]} commits) ==="
+  for sha in "${commits[@]}"; do
+    cherrypick_one "$sha"
+  done
+}
+
+print_status() {
+  echo "Branch: $(git branch --show-current)"
+  echo
+  for entry in \
+    "6b7247341b28:APC outer box align" \
+    "d0035d661509:APC OuterBoxMap stable" \
+    "7c306242a7c1:APC on-demand extraction" \
+    "a30dbf28342f:Autofill skip user-edited fields" \
+    "1883243951aeb:Autofill dialog events" \
+    "c32b2366db54:Actor pre-click before form fill" \
+    "0da453474857:Actor tab context scheme guard" \
+    "d6fe68236474:Actuation capability telemetry" \
+    "b76c73365396:Actor page stability min wait (baseline)"; do
+    sha="${entry%%:*}"
+    desc="${entry#*:}"
+    if git merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
+      echo "  HAVE  ${sha:0:12}  ${desc}"
+    elif git log --grep="cherry picked from commit ${sha}" -1 --oneline 2>/dev/null | grep -q .; then
+      echo "  HAVE  ${sha:0:12}  ${desc} (cherry-picked)"
+    else
+      echo "  NEED  ${sha:0:12}  ${desc}"
+    fi
+  done
+}
+
+cmd="${1:-status}"
+case "$cmd" in
+  wave1) cherrypick_list "Wave 1 — APC" "${WAVE1[@]}" ;;
+  wave2) cherrypick_list "Wave 2 — Actor autofill" "${WAVE2[@]}" ;;
+  wave3) cherrypick_list "Wave 3 — Context + telemetry" "${WAVE3[@]}" ;;
+  all)
+    cherrypick_list "Wave 1 — APC" "${WAVE1[@]}"
+    cherrypick_list "Wave 2 — Actor autofill" "${WAVE2[@]}"
+    cherrypick_list "Wave 3 — Context + telemetry" "${WAVE3[@]}"
+    ;;
+  status|*) print_status ;;
+esac
diff --git a/tools/simulachrome/headless_mcp_server.py b/tools/simulachrome/headless_mcp_server.py
new file mode 100644
--- /dev/null
+++ b/tools/simulachrome/headless_mcp_server.py
@@ -0,0 +1,399 @@
+#!/usr/bin/env python3
+"""MCP-style stdio server for Simulachrome headless ScriptExecutionService bridge.
+
+Exposes tools an agent can call to navigate and act in the isolated headless
+Chromium instance (CDP :9222) using native dashboard execution, not the legacy
+Python CDP DOM shim.
+
+Usage:
+  python3 tools/simulachrome/headless_mcp_server.py
+
+Configure in Cursor MCP settings with command pointing to this script.
+Requires the headless listener host to have started Chromium on port 9222.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+SRC_DIR = Path(__file__).resolve().parents[2]
+BRIDGE_DIR = SRC_DIR / "chrome" / "browser" / "resources" / "dashboard"
+if str(BRIDGE_DIR) not in sys.path:
+  sys.path.insert(0, str(BRIDGE_DIR))
+
+from headless_executor_bridge import HeadlessExecutorBridge  # noqa: E402
+
+
+TOOLS = [
+    {
+        "name": "headless_navigate",
+        "description": (
+            "Open a URL in the isolated headless Simulachrome browser and "
+            "return the CDP target id."
+        ),
+        "inputSchema": {
+            "type": "object",
+            "properties": {
+                "url": {"type": "string"},
+            },
+            "required": ["url"],
+        },
+    },
+    {
+        "name": "headless_run_timeline",
+        "description": (
+            "Run Simulachrome timeline actions through native "
+            "ScriptExecutionService in the headless browser."
+        ),
+        "inputSchema": {
+            "type": "object",
+            "properties": {
+                "actions": {
+                    "type": "array",
+                    "items": {"type": "object"},
+                },
+                "target_id": {"type": "string"},
+                "url": {"type": "string"},
+                "wait_for_completion": {"type": "boolean"},
+            },
+            "required": ["actions"],
+        },
+    },
+    {
+        "name": "headless_refresh_page_map",
+        "description": (
+            "Capture APC/page map from the active tab in the headless browser."
+        ),
+        "inputSchema": {
+            "type": "object",
+            "properties": {},
+        },
+    },
+    {
+        "name": "headless_run_script_step",
+        "description": (
+            "Run a single dashboard action (navigate, click, type, wait, etc.) "
+            "via native ScriptExecutionService."
+        ),
+        "inputSchema": {
+            "type": "object",
+            "properties": {
+                "action": {"type": "string"},
+                "params": {"type": "object"},
+                "target_id": {"type": "string"},
+                "url": {"type": "string"},
+            },
+            "required": ["action"],
+        },
+    },
+    {
+        "name": "headless_get_session",
+        "description": (
+            "Return the persisted headless investigation session (target id, "
+            "url, notes) so an interrupted agent can resume."
+        ),
+        "inputSchema": {"type": "object", "properties": {}},
+    },
+    {
+        "name": "headless_save_session",
+        "description": (
+            "Persist investigation state (target_id, url, task notes) for "
+            "resumable agent loops."
+        ),
+        "inputSchema": {
+            "type": "object",
+            "properties": {
+                "target_id": {"type": "string"},
+                "url": {"type": "string"},
+                "task_id": {"type": "string"},
+                "notes": {"type": "string"},
+                "timeline_checkpoint": {"type": "array", "items": {"type": "object"}},
+            },
+        },
+    },
+    {
+        "name": "headless_load_session",
+        "description": (
+            "Load a saved session and reconnect the bridge to the stored target."
+        ),
+        "inputSchema": {
+            "type": "object",
+            "properties": {
+                "task_id": {"type": "string"},
+            },
+        },
+    },
+]
+
+
+class HeadlessMcpServer:
+  def __init__(self, cdp_port: int = 9222):
+    self.cdp_port = cdp_port
+    self._bridge: Optional[HeadlessExecutorBridge] = None
+    self._default_target_id: Optional[str] = None
+    self._session_path = Path(
+        os.environ.get(
+            "SIMULACHROME_HEADLESS_MCP_SESSION",
+            str(Path.home() / "Library/Application Support/Simulachrome/Headless/mcp_session.json"),
+        ))
+
+  def _read_session(self) -> Dict[str, Any]:
+    if not self._session_path.is_file():
+      return {}
+    try:
+      loaded = json.loads(self._session_path.read_text(encoding="utf-8"))
+      return loaded if isinstance(loaded, dict) else {}
+    except Exception:
+      return {}
+
+  def _write_session(self, data: Dict[str, Any]) -> None:
+    self._session_path.parent.mkdir(parents=True, exist_ok=True)
+    payload = dict(data)
+    payload["updated_ms"] = int(time.time() * 1000)
+    self._session_path.write_text(
+        json.dumps(payload, indent=2, ensure_ascii=False),
+        encoding="utf-8",
+    )
+
+  def _touch_session(self, **fields: Any) -> Dict[str, Any]:
+    session = self._read_session()
+    session.update({k: v for k, v in fields.items() if v is not None})
+    if self._default_target_id:
+      session["target_id"] = self._default_target_id
+    self._write_session(session)
+    return session
+
+  def _bridge_connected(self) -> HeadlessExecutorBridge:
+    if self._bridge is None:
+      self._bridge = HeadlessExecutorBridge(cdp_port=self.cdp_port)
+      self._bridge.connect()
+    return self._bridge
+
+  def _resolve_target(self, arguments: Dict[str, Any]) -> Optional[str]:
+    target_id = str(arguments.get("target_id") or "").strip()
+    if target_id:
+      self._default_target_id = target_id
+      return target_id
+    if self._default_target_id:
+      return self._default_target_id
+    url = str(arguments.get("url") or "").strip()
+    if url:
+      target_id = self._bridge_connected().create_work_target(url)
+      self._default_target_id = target_id
+      return target_id
+    return None
+
+  def handle_tool(self, name: str, arguments: Dict[str, Any]) -> Dict[str, Any]:
+    bridge = self._bridge_connected()
+
+    if name == "headless_navigate":
+      url = str(arguments.get("url") or "").strip()
+      if not url:
+        return {"ok": False, "error": "url is required"}
+      target_id = bridge.create_work_target(url)
+      self._default_target_id = target_id
+      bridge.activate_target(target_id)
+      session = self._touch_session(url=url, target_id=target_id)
+      return {"ok": True, "target_id": target_id, "url": url, "session": session}
+
+    if name == "headless_run_timeline":
+      actions = arguments.get("actions")
+      if not isinstance(actions, list):
+        return {"ok": False, "error": "actions must be a list"}
+      target_id = self._resolve_target(arguments)
+      wait = bool(arguments.get("wait_for_completion", True))
+      result = bridge.run_timeline(
+          [a for a in actions if isinstance(a, dict)],
+          work_target_id=target_id,
+          wait_for_completion=wait,
+      )
+      result["target_id"] = target_id
+      self._touch_session(
+          target_id=target_id,
+          last_timeline=actions,
+          last_result=result,
+      )
+      return result
+
+    if name == "headless_run_script_step":
+      action = str(arguments.get("action") or "").strip()
+      if not action:
+        return {"ok": False, "error": "action is required"}
+      params = arguments.get("params")
+      if not isinstance(params, dict):
+        params = {}
+      step = {"action": action, "params": params}
+      target_id = self._resolve_target(arguments)
+      result = bridge.run_timeline(
+          [step],
+          work_target_id=target_id,
+          wait_for_completion=True,
+      )
+      result["target_id"] = target_id
+      self._touch_session(
+          target_id=target_id,
+          last_timeline=actions,
+          last_result=result,
+      )
+      return result
+
+    if name == "headless_refresh_page_map":
+      target_id = self._resolve_target(arguments)
+      if target_id:
+        bridge.activate_target(target_id)
+      return bridge.refresh_page_map()
+
+    if name == "headless_get_session":
+      session = self._read_session()
+      if self._default_target_id and not session.get("target_id"):
+        session["target_id"] = self._default_target_id
+      return {"ok": True, "session": session}
+
+    if name == "headless_save_session":
+      session = self._touch_session(
+          target_id=str(arguments.get("target_id") or "") or None,
+          url=str(arguments.get("url") or "") or None,
+          task_id=str(arguments.get("task_id") or "") or None,
+          notes=str(arguments.get("notes") or "") or None,
+          timeline_checkpoint=arguments.get("timeline_checkpoint"),
+      )
+      return {"ok": True, "session": session}
+
+    if name == "headless_load_session":
+      session = self._read_session()
+      task_id = str(arguments.get("task_id") or "").strip()
+      if task_id and str(session.get("task_id") or "") != task_id:
+        return {"ok": False, "error": f"no session for task_id={task_id}"}
+      target_id = str(session.get("target_id") or "").strip()
+      url = str(session.get("url") or "").strip()
+      if target_id:
+        self._default_target_id = target_id
+        bridge.activate_target(target_id)
+      elif url:
+        target_id = bridge.create_work_target(url)
+        self._default_target_id = target_id
+        bridge.activate_target(target_id)
+        session["target_id"] = target_id
+        self._write_session(session)
+      else:
+        return {"ok": False, "error": "session missing target_id and url"}
+      return {"ok": True, "session": session, "target_id": target_id}
+
+    return {"ok": False, "error": f"unknown tool: {name}"}
+
+
+def _write_message(payload: Dict[str, Any]) -> None:
+  raw = json.dumps(payload, ensure_ascii=True).encode("utf-8")
+  sys.stdout.buffer.write(struct_pack_uint32(len(raw)))
+  sys.stdout.buffer.write(raw)
+  sys.stdout.buffer.flush()
+
+
+def struct_pack_uint32(value: int) -> bytes:
+  return value.to_bytes(4, byteorder="little")
+
+
+def _read_message() -> Optional[Dict[str, Any]]:
+  header = sys.stdin.buffer.read(4)
+  if not header:
+    return None
+  if len(header) != 4:
+    return None
+  length = int.from_bytes(header, byteorder="little")
+  if length <= 0:
+    return None
+  body = sys.stdin.buffer.read(length)
+  if len(body) != length:
+    return None
+  return json.loads(body.decode("utf-8"))
+
+
+def _handle_request(server: HeadlessMcpServer, request: Dict[str, Any]) -> Dict[str, Any]:
+  req_id = request.get("id")
+  method = str(request.get("method") or "")
+
+  if method == "initialize":
+    return {
+        "jsonrpc": "2.0",
+        "id": req_id,
+        "result": {
+            "protocolVersion": "2024-11-05",
+            "capabilities": {"tools": {}},
+            "serverInfo": {
+                "name": "simulachrome-headless",
+                "version": "0.1.0",
+            },
+        },
+    }
+
+  if method == "tools/list":
+    return {
+        "jsonrpc": "2.0",
+        "id": req_id,
+        "result": {"tools": TOOLS},
+    }
+
+  if method == "tools/call":
+    params = request.get("params")
+    if not isinstance(params, dict):
+      params = {}
+    name = str(params.get("name") or "")
+    arguments = params.get("arguments")
+    if not isinstance(arguments, dict):
+      arguments = {}
+    try:
+      result = server.handle_tool(name, arguments)
+      return {
+          "jsonrpc": "2.0",
+          "id": req_id,
+          "result": {
+              "content": [{
+                  "type": "text",
+                  "text": json.dumps(result, indent=2, ensure_ascii=False),
+              }],
+              "isError": not bool(result.get("ok", True)),
+          },
+      }
+    except Exception as exc:
+      return {
+          "jsonrpc": "2.0",
+          "id": req_id,
+          "result": {
+              "content": [{
+                  "type": "text",
+                  "text": json.dumps({"ok": False, "error": str(exc)}),
+              }],
+              "isError": True,
+          },
+      }
+
+  return {
+      "jsonrpc": "2.0",
+      "id": req_id,
+      "error": {"code": -32601, "message": f"Method not found: {method}"},
+  }
+
+
+def main() -> int:
+  port = int(os.environ.get("SIMULACHROME_HEADLESS_CDP_PORT", "9222"))
+  server = HeadlessMcpServer(cdp_port=port)
+  while True:
+    request = _read_message()
+    if request is None:
+      break
+    if not isinstance(request, dict):
+      continue
+    response = _handle_request(server, request)
+    _write_message(response)
+  if server._bridge is not None:
+    server._bridge.close()
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff --git a/tools/simulachrome/run_native_welcome_test.py b/tools/simulachrome/run_native_welcome_test.py
new file mode 100644
--- /dev/null
+++ b/tools/simulachrome/run_native_welcome_test.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Run welcome_demo (or any script JSON) with force_native_execution via bridge."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+SRC = Path(__file__).resolve().parents[2]
+BRIDGE_DIR = SRC / "chrome/browser/resources/dashboard"
+DEFAULT_SCRIPT = Path.home() / "Library/Application Support/Simulachrome/Scripts/welcome_demo.json"
+DEFAULT_CHROME = SRC / "out/Default/Chromium.app/Contents/MacOS/Chromium"
+DEFAULT_PROFILE = Path.home() / "Library/Application Support/Simulachrome/DevProfile"
+LOG_FILE = Path("/tmp/glic_welcome_native.log")
+
+
+def load_actions(path: Path) -> list:
+  data = json.loads(path.read_text(encoding="utf-8"))
+  actions = data.get("timeline") or data.get("actions") or []
+  if not isinstance(actions, list):
+    raise RuntimeError(f"No actions in {path}")
+  return [a for a in actions if isinstance(a, dict)]
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--script", type=Path, default=DEFAULT_SCRIPT)
+  parser.add_argument("--cdp-port", type=int, default=9223)
+  parser.add_argument("--timeout-sec", type=float, default=900.0)
+  parser.add_argument("--log-file", type=Path, default=LOG_FILE)
+  parser.add_argument("--start-url", type=str, default="about:blank")
+  args = parser.parse_args()
+
+  sys.path.insert(0, str(BRIDGE_DIR))
+  from headless_executor_bridge import HeadlessExecutorBridge  # noqa: E402
