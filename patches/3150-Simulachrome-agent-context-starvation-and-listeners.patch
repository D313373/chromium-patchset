+bool HasPathPrefix(const std::string& parent, const std::string& child) {
+  if (parent.empty() || child.empty()) {
+    return false;
+  }
+  if (child == parent) {
+    return true;
+  }
+  return base::StartsWith(child, parent + "/",
+                          base::CompareCase::SENSITIVE);
+}
