+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * Script collection helpers (WebUI).
+ *
+ * Disk layout: Scripts/<collection>/<id>.json  → logical id "collection/id"
+ * Listener trigger may also be "collection:<name>" to run every main script
+ * in that collection (sequentially).
+ */
+
+export const COLLECTION_REF_PREFIX = 'collection:';
+
+export function isCollectionRef(value) {
+  const raw = String(value || '').trim();
+  return raw.toLowerCase().startsWith(COLLECTION_REF_PREFIX);
+}
+
+export function parseCollectionRef(value) {
+  const raw = String(value || '').trim();
+  if (!isCollectionRef(raw)) {
+    return '';
+  }
+  return raw.slice(COLLECTION_REF_PREFIX.length).trim();
+}
+
+export function formatCollectionRef(collectionName) {
+  const name = String(collectionName || '').trim();
+  return name ? `${COLLECTION_REF_PREFIX}${name}` : '';
+}
+
+export function splitScriptId(scriptId) {
+  const id = String(scriptId || '').trim();
+  const slash = id.lastIndexOf('/');
+  if (slash <= 0 || slash === id.length - 1) {
+    return {collection: '', basename: id};
+  }
+  return {
+    collection: id.slice(0, slash),
+    basename: id.slice(slash + 1),
+  };
+}
+
+export function collectionOfScriptId(scriptId) {
+  return splitScriptId(scriptId).collection;
+}
+
+export function isValidCollectionName(name) {
+  const n = String(name || '').trim();
+  if (!n || n.length > 64) {
+    return false;
+  }
+  if (n === '.' || n === '..') {
+    return false;
+  }
+  return /^[A-Za-z0-9._-]+$/.test(n);
+}
+
+export function isValidScriptId(scriptId) {
+  const id = String(scriptId || '').trim();
+  if (!id || id.includes('..') || id.startsWith('/') || id.endsWith('/')) {
+    return false;
+  }
+  const parts = id.split('/');
+  if (parts.length > 2) {
+    return false;
+  }
+  return parts.every((part) => isValidCollectionName(part));
+}
+
+export function listScriptsInCollection(scriptsMap, collectionName) {
+  const wanted = String(collectionName || '').trim();
+  const scripts = (scriptsMap && typeof scriptsMap === 'object') ? scriptsMap : {};
+  return Object.entries(scripts)
+      .filter(([id, script]) => {
+        if (collectionOfScriptId(id) !== wanted) {
+          return false;
+        }
+        const kind = String(script?.kind || 'main').toLowerCase();
+        return kind === 'main';
+      })
+      .map(([id, script]) => ({
+        id,
+        name: script?.name || id,
+        kind: script?.kind || 'main',
+      }))
+      .sort((a, b) => a.name.localeCompare(b.name));
+}
+
+export function listCollectionsFromScripts(scriptsMap) {
+  const scripts = (scriptsMap && typeof scriptsMap === 'object') ? scriptsMap : {};
+  const names = new Set();
+  for (const id of Object.keys(scripts)) {
+    const collection = collectionOfScriptId(id);
+    if (collection) {
+      names.add(collection);
+    }
+  }
+  return [...names].sort((a, b) => a.localeCompare(b));
+}
+
+/**
+ * Resolve a timeline step by flattened 0-based index (top-level actions only).
+ * Nested loop/if children are not flattened here — matches failed_step from
+ * the top-level executor index used by playback auto-heal.
+ */
+export function getTopLevelAction(script, stepIndex) {
+  const actions = Array.isArray(script?.actions) ? script.actions : [];
+  const idx = Number(stepIndex);
+  if (!Number.isFinite(idx) || idx < 0 || idx >= actions.length) {
+    return {ok: false, error: 'step_out_of_range', action_count: actions.length};
+  }
+  return {
+    ok: true,
+    step_index: idx,
+    action_count: actions.length,
+    action: actions[idx],
+  };
+}
