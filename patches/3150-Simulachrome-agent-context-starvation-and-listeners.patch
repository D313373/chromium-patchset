+bool KeyPressAction::SetParams(const base::Value::Dict& params) {
+  const std::string* key = params.FindString("key");
+  if (!key) {
+    key = params.FindString("value");
+  }
+  if (!key) {
+    return false;
+  }
+  key_ = base::TrimWhitespaceASCII(*key, base::TRIM_ALL);
+  if (key_.empty()) {
+    return false;
+  }
+  original_key_ = key_;
+  count_ = std::max(1, params.FindInt("count").value_or(1));
+  original_count_ = count_;
+
+  base::Value::Dict params_dict = params.Clone();
+  params_dict.Set("key", key_);
+  params_dict.Set("count", count_);
+  SetSerializedAction("key_press", std::move(params_dict));
+  return true;
+}
+
+void KeyPressAction::SerializeInto(base::Value::Dict* out) const {
+  if (!out) {
+    return;
+  }
+
+  const std::string* serialized_key = serialized_params_.FindString("key");
+  const std::string key =
+      !key_.empty()
+          ? key_
+          : (!original_key_.empty()
+                 ? original_key_
+                 : std::string(base::TrimWhitespaceASCII(
+                       serialized_key ? *serialized_key : std::string(),
+                       base::TRIM_ALL)));
+  const int count = std::max(
+      1, count_ > 0 ? count_
+                    : (original_count_ > 0
+                           ? original_count_
+                           : serialized_params_.FindInt("count").value_or(1)));
+
+  if (key.empty()) {
+    Action::SerializeInto(out);
+    return;
+  }
+
+  base::Value::Dict params = serialized_params_.Clone();
+  params.Set("key", key);
+  params.Set("count", count);
+  out->Set("action", "key_press");
+  out->Set("params", std::move(params));
+  out->Set("executedAt", static_cast<double>(
+                           base::Time::Now().InMillisecondsSinceUnixEpoch()));
+}
