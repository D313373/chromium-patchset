+std::string BuildChoiceMenuEntryJson(base::Value::Dict entry) {
+  std::string serialized = "{}";
+  if (!base::JSONWriter::Write(entry, &serialized) || serialized.empty()) {
+    return "{}";
+  }
+  return TruncateForPrompt(std::move(serialized), 700u);
