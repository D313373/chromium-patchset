diff --git a/chrome/browser/ui/webui/dashboard/actions/action_metadata_promotion.cc b/chrome/browser/ui/webui/dashboard/actions/action_metadata_promotion.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/action_metadata_promotion.cc
@@ -0,0 +1,284 @@
+#include "chrome/browser/ui/webui/dashboard/actions/action_metadata_promotion.h"
+
+#include <set>
+#include <tuple>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace dashboard {
+namespace {
+
+using LocatorKey = std::tuple<int, std::string>;
+
+LocatorKey BuildLocatorKey(const Locator& locator) {
+  return std::make_tuple(static_cast<int>(locator.type), locator.value);
+}
+
+void MergeLocators(base::Value::Dict* params,
+                   const std::vector<Locator>& promoted_locators) {
+  if (!params || promoted_locators.empty()) {
+    return;
+  }
+
+  std::set<LocatorKey> seen;
+  std::vector<Locator> merged;
+  if (const base::Value::List* existing = params->FindList("locators")) {
+    merged = ConvertLocators(*existing);
+    for (const Locator& locator : merged) {
+      seen.insert(BuildLocatorKey(locator));
+    }
+  }
+
+  for (const Locator& locator : promoted_locators) {
+    if (!seen.insert(BuildLocatorKey(locator)).second) {
+      continue;
+    }
+    merged.push_back(locator);
+  }
+
+  base::Value::List locators_list;
+  for (const Locator& locator : merged) {
+    locators_list.Append(LocatorToValue(locator));
+  }
+  params->Set("locators", std::move(locators_list));
+}
+
+void SetNonEmptyString(base::Value::Dict* params,
+                       const char* key,
+                       const std::string& value) {
+  if (!params || value.empty()) {
+    return;
+  }
+  params->Set(key, value);
+}
+
+int LocatorStrength(LocatorType type) {
+  switch (type) {
+    case LocatorType::FRAME_ID:
+      return 140;
+    case LocatorType::SHADOW_DOM:
+      return 135;
+    case LocatorType::RESOURCE_TREE:
+      return 125;
+    case LocatorType::ID:
+      return 120;
+    case LocatorType::NAME:
+      return 100;
+    case LocatorType::ACCESSIBILITY_NAME:
+      return 95;
+    case LocatorType::CSS_SELECTOR:
+      return 75;
+    case LocatorType::XPATH:
+      return 65;
+    case LocatorType::CLASS_NAME:
+      return 45;
+    case LocatorType::TAG_NAME:
+      return 30;
+    default:
+      return 20;
+  }
+}
+
+bool IsStrongLocator(LocatorType type) {
+  return LocatorStrength(type) >= 95;
+}
+
+struct PromotionScore {
+  int total = 0;
+  int strong_locator_count = 0;
+};
+
+PromotionScore ScoreActionParams(const base::Value::Dict& params) {
+  PromotionScore score;
+
+  if (const std::string* frame_id = params.FindString("frame_id");
+      frame_id && !frame_id->empty()) {
+    score.total += 80;
+  }
+  if (const std::string* shadow_chain = params.FindString("shadow_chain");
+      shadow_chain && !shadow_chain->empty()) {
+    score.total += 70;
+  }
+  if (const std::string* resource_path = params.FindString("resource_path");
+      resource_path && !resource_path->empty()) {
+    score.total += 65;
+  }
+  if (const std::string* ax_role = params.FindString("ax_role");
+      ax_role && !ax_role->empty()) {
+    score.total += 35;
+  }
+  if (const std::string* ax_name = params.FindString("ax_name");
+      ax_name && !ax_name->empty()) {
+    score.total += 45;
+  }
+  if (const std::string* interactive_role =
+          params.FindString("interactive_ancestor_role");
+      interactive_role && !interactive_role->empty()) {
+    score.total += 20;
+  }
+
+  if (const base::Value::List* locators = params.FindList("locators")) {
+    for (const Locator& locator : ConvertLocators(*locators)) {
+      if (locator.value.empty()) {
+        continue;
+      }
+      score.total += LocatorStrength(locator.type);
+      if (IsStrongLocator(locator.type)) {
+        ++score.strong_locator_count;
+      }
+    }
+  }
+  return score;
+}
+
+std::set<LocatorKey> CollectLocatorKeys(const base::Value::Dict& params,
+                                        bool strong_only) {
+  std::set<LocatorKey> keys;
+  if (const base::Value::List* locators = params.FindList("locators")) {
+    for (const Locator& locator : ConvertLocators(*locators)) {
+      if (locator.value.empty()) {
+        continue;
+      }
+      if (strong_only && !IsStrongLocator(locator.type)) {
+        continue;
+      }
+      keys.insert(BuildLocatorKey(locator));
+    }
+  }
+  return keys;
+}
+
+bool HasNonEmptyValue(const base::Value::Dict& params, const char* key) {
+  const std::string* value = params.FindString(key);
+  return value && !value->empty();
+}
+
+int CountAddedStrongSignals(const base::Value::Dict& existing_params,
+                            const base::Value::Dict& promoted_params) {
+  int count = 0;
+  for (const char* key : {"frame_id", "shadow_chain", "resource_path",
+                          "ax_role", "ax_name",
+                          "interactive_ancestor_role"}) {
+    if (!HasNonEmptyValue(existing_params, key) &&
+        HasNonEmptyValue(promoted_params, key)) {
+      ++count;
+    }
+  }
+
+  std::set<LocatorKey> existing_strong =
+      CollectLocatorKeys(existing_params, /*strong_only=*/true);
+  std::set<LocatorKey> promoted_strong =
+      CollectLocatorKeys(promoted_params, /*strong_only=*/true);
+  for (const LocatorKey& key : promoted_strong) {
+    if (!existing_strong.contains(key)) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+std::vector<Locator> BuildPromotedLocatorsFromResolvedElement(
+    const ResolvedElement& element) {
+  if (!element.locators.empty()) {
+    return element.locators;
+  }
+
+  std::vector<Locator> locators;
+  auto append = [&](LocatorType type, const std::string& value) {
+    if (value.empty()) {
+      return;
+    }
+    Locator locator;
+    locator.type = type;
+    locator.value = value;
+    locators.push_back(std::move(locator));
+  };
+
+  append(LocatorType::SHADOW_DOM, element.shadow_chain_selector);
+  append(LocatorType::ID, element.id_attr);
+  append(LocatorType::NAME, element.name_attr);
+  append(LocatorType::ACCESSIBILITY_NAME, element.accessibility_name);
+  append(LocatorType::CSS_SELECTOR, element.css_selector);
+  append(LocatorType::XPATH, element.xpath);
+  return locators;
+}
+
+}  // namespace
+
+void PromoteActionParamsFromResolvedElement(base::Value::Dict* params,
+                                            const ResolvedElement& element) {
+  if (!params) {
+    return;
+  }
+
+  if (element.frame_id != content::GlobalRenderFrameHostId()) {
+    params->Set("frame_id",
+                base::NumberToString(element.frame_id.child_id) + "," +
+                    base::NumberToString(element.frame_id.frame_routing_id));
+  }
+  SetNonEmptyString(params, "shadow_chain", element.shadow_chain_selector);
+  SetNonEmptyString(params, "resource_path", element.resource_path);
+  SetNonEmptyString(params, "ax_role", element.role);
+  SetNonEmptyString(params, "ax_name", element.accessibility_name);
+  MergeLocators(params, BuildPromotedLocatorsFromResolvedElement(element));
+}
+
+void PromoteActionParamsFromPageMapCandidate(
+    base::Value::Dict* params,
+    const NativePageMapCandidate& candidate) {
+  if (!params) {
+    return;
+  }
+
+  SetNonEmptyString(params, "frame_id", candidate.frame_id);
+  SetNonEmptyString(params, "shadow_chain", candidate.shadow_chain_selector);
+  SetNonEmptyString(params, "resource_path", candidate.resource_path);
+  SetNonEmptyString(params, "ax_role", candidate.role);
+  SetNonEmptyString(params, "ax_name", candidate.accessibility_name);
+  SetNonEmptyString(params, "interactive_ancestor_role",
+                    candidate.interactive_ancestor_role);
+  MergeLocators(params, candidate.locators);
+}
+
+bool ShouldPersistPromotedActionParams(const base::Value::Dict& existing_params,
+                                       const base::Value::Dict& promoted_params,
+                                       std::string* reason) {
+  if (existing_params == promoted_params) {
+    return false;
+  }
+
+  const PromotionScore existing_score = ScoreActionParams(existing_params);
+  const PromotionScore promoted_score = ScoreActionParams(promoted_params);
+  const int added_strong_signals =
+      CountAddedStrongSignals(existing_params, promoted_params);
+  const int score_delta = promoted_score.total - existing_score.total;
+
+  if (promoted_score.total <= existing_score.total &&
+      added_strong_signals == 0) {
+    if (reason) {
+      *reason = "promotion not stronger than existing params";
+    }
+    return false;
+  }
+
+  const bool materially_stronger =
+      score_delta >= 90 || added_strong_signals >= 2 ||
+      promoted_score.strong_locator_count > existing_score.strong_locator_count;
+  if (!materially_stronger) {
+    if (reason) {
+      *reason = "promotion delta too small to persist";
+    }
+    return false;
+  }
+
+  if (reason) {
+    *reason = "score_delta=" + base::NumberToString(score_delta) +
+              " added_strong_signals=" +
+              base::NumberToString(added_strong_signals);
+  }
+  return true;
+}
+
+}  // namespace dashboard
