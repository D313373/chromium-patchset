+dashboard::mojom::ScheduleConfigPtr ScheduleConfig::ToMojo() const {
+  auto mojo = dashboard::mojom::ScheduleConfig::New();
+  mojo->enabled = enabled;
+  mojo->interval_days = interval_days;
+  mojo->interval_hours = interval_hours;
+  mojo->interval_minutes = interval_minutes;
+  mojo->next_run_iso = TimeToIso8601(next_run);
+  return mojo;
+}
+
+ScheduleConfig ScheduleConfig::FromMojo(const dashboard::mojom::ScheduleConfig& mojo) {
+  ScheduleConfig config;
+  config.enabled = mojo.enabled;
+  config.interval_days = mojo.interval_days;
+  config.interval_hours = mojo.interval_hours;
+  config.interval_minutes = mojo.interval_minutes;
+  config.next_run = Iso8601ToTime(mojo.next_run_iso);
+  return config;
+}
+
+int64_t ScheduleConfig::GetIntervalMs() const {
+  int64_t total_ms = 0;
+  total_ms += static_cast<int64_t>(interval_days) * 24 * 60 * 60 * 1000;
+  total_ms += static_cast<int64_t>(interval_hours) * 60 * 60 * 1000;
+  total_ms += static_cast<int64_t>(interval_minutes) * 60 * 1000;
+  return total_ms;
+}
+
+bool ScheduleConfig::IsValid() const {
+  int64_t interval = GetIntervalMs();
+  return interval >= kMinIntervalMs && interval <= kMaxIntervalMs;
+}
