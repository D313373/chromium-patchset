+  // This engine is required for the GetRandom utilities
+  mutable std::mt19937 random_engine_;
+
+  // Required for safe asynchronous CDP callbacks
+  base::WeakPtrFactory<CdpActionBase> weak_ptr_factory_{this};
+};
