+#include <cctype>
+
+#include "chrome/browser/ui/webui/dashboard/click_handler.h"
+#include "chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/navigation_controller.h"
+#include "ui/base/page_transition_types.h"
+#include "base/files/file_util.h"
+
+namespace dashboard {
+namespace actions {
+
+// Convert URL to a safe ID string (alphanumeric + underscores only)
+std::string MakeSafeIdFromUrl(const std::string& url) {
+    std::string id = url;
+    std::replace_if(id.begin(), id.end(), [](char c) {
+        return !(std::isalnum(static_cast<unsigned char>(c)) || c == '_');
+    }, '_');
+
+    // Optional: truncate to max 32 chars
+    if (id.size() > 32)
+        id.resize(32);
+
+    return id;
+}
+
+NavigateHandler::NavigateHandler(Profile* profile) : profile_(profile) {}
+NavigateHandler::~NavigateHandler() = default;
+
+bool NavigateHandler::SetUrl(const std::string& url) {
+    if (!GURL(url).is_valid())
+        return false;
+    url_ = url;
+    return true;
+}
+
+void NavigateHandler::Execute(content::WebContents* web_contents, Callback callback) {
+    if (!web_contents) {
+        std::move(callback).Run(false, "WebContents is null");
+        return;
+    }
+
+    // Create a safe ID for the link
+    std::string link_id = MakeSafeIdFromUrl(url_);
+
+    // Create a temporary directory.html file in the profile path
+    base::FilePath dir_html = profile_->GetPath().AppendASCII("directory.html");
+
+    std::string html_content = "<!DOCTYPE html><html><body>"
+                               "<a id=\"" + link_id + "\" href=\"" + url_ + "\">go</a>"
+                               "</body></html>";
+
+    if (!base::WriteFile(dir_html, html_content)) {
+        std::move(callback).Run(false, "Failed to write directory.html");
+        return;
+    }
+
+    // Navigate to the local directory.html
+    GURL local_url = GURL("file://" + dir_html.AsUTF8Unsafe());
+    web_contents->GetController().LoadURL(local_url, content::Referrer(),
+                                          ui::PAGE_TRANSITION_TYPED, std::string());
+
+    // Wait for the link to be ready, then click it using ClickHandler
+    auto ready_checker = std::make_unique<ElementReadinessChecker>(profile_);
+    ready_checker->WaitForElement(
+        web_contents,
+        dashboard::mojom::Locator::New("CSS_SELECTOR", "#" + link_id),
+        base::BindOnce(
+            [](Profile* profile,
+               std::string link_id,
+               content::WebContents* web_contents,
+               Callback callback,
+               bool ready,
+               const std::string& err) {
+              if (!ready) {
+                std::move(callback).Run(false, "Link not ready: " + err);
+                return;
+              }
+              ClickHandler click_handler(profile);
+              click_handler.SetLocator("CSS_SELECTOR", "#" + link_id);
+              click_handler.Execute(web_contents, std::move(callback));
+            },
+            profile_, link_id, web_contents, std::move(callback)));
+}
+
+}  // namespace actions
+}  // namespace dashboard
+
