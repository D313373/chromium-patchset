+  void Schedule(Profile* profile) {
+    if (!profile || scheduled_) {
+      return;
+    }
+    const base::Value::Dict& settings = GlobalSettingsStore();
+    const base::Value::Dict* agent = settings.FindDict("agent");
+    if (!ReadBool(agent, "autoStartTaskOnLaunch", false)) {
+      LOG(INFO) << "[StartupAgent] autoStartTaskOnLaunch disabled";
+      return;
+    }
+
+    scheduled_ = true;
+    const int delay_ms = std::max(0, ReadInt(agent, "autoStartDelayMs", 5000));
+    const std::string prompt =
+        ReadString(agent, "autoStartPrompt", kDefaultStartupPrompt);
+
+    LOG(INFO) << "[StartupAgent] Scheduling launch in " << delay_ms << "ms";
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&StartupAgentLauncher::Launch,
+                       weak_factory_.GetWeakPtr(), profile, prompt),
+        base::Milliseconds(delay_ms));
+  }
+
+ private:
+  friend class base::NoDestructor<StartupAgentLauncher>;
+  StartupAgentLauncher() = default;
+
+  void Launch(Profile* profile, std::string prompt) {
+    if (!profile || launched_) {
+      return;
+    }
+    launched_ = true;
+
+    Browser* browser = chrome::FindLastActiveWithProfile(profile);
+    if (!browser) {
+      LOG(WARNING) << "[StartupAgent] No browser window yet; retrying once";
+      launched_ = false;
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&StartupAgentLauncher::Launch,
+                         weak_factory_.GetWeakPtr(), profile, std::move(prompt)),
+          base::Seconds(2));
+      return;
+    }
+
+    NavigateParams np(browser, GURL("about:blank"),
+                      ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    np.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&np);
+    content::WebContents* target_wc = np.navigated_or_inserted_contents;
+    if (!target_wc) {
+      LOG(ERROR) << "[StartupAgent] Failed to open startup agent tab";
+      return;
+    }
+
+    ScriptExecutionService* exec =
+        ScriptExecutionServiceFactory::GetForProfile(profile);
+    if (!exec) {
+      LOG(ERROR) << "[StartupAgent] ScriptExecutionService unavailable";
+      return;
+    }
+
+    base::Value::List timeline = BuildStartupAgentTimeline(prompt);
+    ScriptExecutionService::RunOptions options;
+    options.is_agent_mode = true;
+    const std::string run_id = exec->StartAdHocRunWithOptions(
+        timeline, target_wc, options);
+    if (run_id.empty()) {
+      LOG(ERROR) << "[StartupAgent] Failed to queue glic_prompt run";
+      return;
+    }
+    LOG(INFO) << "[StartupAgent] Started ad-hoc run id=" << run_id
+              << " prompt_chars=" << prompt.size();
+  }
+
+  bool scheduled_ = false;
+  bool launched_ = false;
+  base::WeakPtrFactory<StartupAgentLauncher> weak_factory_{this};
+};
+
+}  // namespace
+
+void MaybeScheduleStartupAgentTask(Profile* profile) {
+  StartupAgentLauncher::GetInstance().Schedule(profile);
+}
