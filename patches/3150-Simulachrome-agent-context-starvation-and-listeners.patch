+std::vector<HeadlessInvestigateTaskSnapshot> GetHeadlessInvestigateTaskSnapshots(
+    Profile* profile) {
+  std::vector<HeadlessInvestigateTaskSnapshot> snapshots;
+  auto profile_it = HeadlessInvestigateTasks().find(profile);
+  if (profile_it == HeadlessInvestigateTasks().end()) {
+    return snapshots;
+  }
+  snapshots.reserve(profile_it->second.size());
+  for (const auto& [task_id, task_state_ptr] : profile_it->second) {
+    if (task_id.empty() || !task_state_ptr) {
+      continue;
+    }
+    HeadlessInvestigateTaskSnapshot snapshot;
+    snapshot.task_id = task_id;
+    snapshot.current_url = task_state_ptr->preferred_url;
+    if (content::WebContents* live_wc =
+            ResolveLiveHeadlessTaskWebContents(task_state_ptr.get())) {
+      const std::string live_url = live_wc->GetLastCommittedURL().spec();
+      if (!live_url.empty()) {
+        snapshot.current_url = live_url;
+      }
+    }
+    snapshot.open_reason = task_state_ptr->open_reason.empty()
+                               ? "agentic script repair"
+                               : task_state_ptr->open_reason;
+    snapshot.display_label = task_state_ptr->display_label.empty()
+                                 ? "Investigation"
+                                 : task_state_ptr->display_label;
+    snapshot.preferred_url = task_state_ptr->preferred_url;
+    snapshot.owns_tab = task_state_ptr->owns_tab;
+    snapshots.push_back(std::move(snapshot));
+  }
+  return snapshots;
+}
