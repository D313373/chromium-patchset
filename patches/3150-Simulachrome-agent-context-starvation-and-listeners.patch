+    checker_ = std::make_unique<ElementReadinessChecker>(web_contents);
+    checker_->WaitForElementReadyAsync(
+        locators_,
+        dashboard::SearchScope::kAll,
+        timeout_ms_,
+        base::BindOnce(&WaitAction::OnElementReady,
+                       weak_ptr_factory_.GetWeakPtr(),
+                       std::move(callback)));
+    return;
+  }
+
+  // Default to failure if type is unknown
+  LOG(ERROR) << "[WaitAction] Invalid wait type";
+  std::move(callback).Run(false, "Wait condition failed");
