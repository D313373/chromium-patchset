+/**
+ * Canonical model <-> Simulachrome agent contract (WebUI twin).
+ *
+ * Keep in sync with:
+ *   chrome/browser/ui/webui/dashboard/agent_model_contract.h
+ *   chrome/browser/ui/webui/dashboard/agent_model_contract.cc
+ *
+ * Local-CPU design: teach a tiny {"do":...} dialect. The adapter expands to
+ * canonical {command,payload} / {action,params} / locators.
+ */
+
+export const AI_LOOP_PROFILES = Object.freeze({
+  DASHBOARD_ASSISTANT: 'dashboard_assistant',
+  GLIC_TASK: 'glic_task',
+  INVESTIGATOR: 'investigator',
+});
+
+export function normalizeAiLoopProfile(profile) {
+  const raw = String(profile || '').trim().toLowerCase();
+  if (raw === AI_LOOP_PROFILES.GLIC_TASK) {
+    return AI_LOOP_PROFILES.GLIC_TASK;
+  }
+  if (raw === AI_LOOP_PROFILES.INVESTIGATOR) {
+    return AI_LOOP_PROFILES.INVESTIGATOR;
+  }
+  return AI_LOOP_PROFILES.DASHBOARD_ASSISTANT;
+}
+
+export function buildActionShapePromptBlock() {
+  return `Targeting: prefer {"id":"<from context>"} or {"sel":"css"}.
+Adapter expands shorthand. Do not invent long locator arrays.`;
+}
+
+export function buildCoreCommandSchemaPromptBlock() {
+  return `One JSON object per turn (markdown optional):
+{"do":"click","id":"..."}
+{"do":"type","id":"...","text":"..."}
+{"do":"wait","ms":1000}
+{"do":"goto","url":"https://..."}
+{"do":"look"}
+{"do":"more"}
+{"do":"see"}
+{"do":"done","why":"..."}
+Verbs: click type wait goto look more see done. One move only.`;
+}
+
+export function buildDashboardCommandSchemaPromptBlock() {
+  return `${buildCoreCommandSchemaPromptBlock()}
+Script tools:
+{"do":"list_scripts"}
+{"do":"get_step","step":2}
+{"do":"update_step","step":2,"id":"username"}
+{"do":"get_script"}
+{"do":"save_script","script_json":{...}}
+{"do":"run_script"}
+{"do":"investigate","url":"..."}
+Prefer get_step/update_step for one failed action. Do not call heal while healing.`;
+}
+
+export function buildScriptJsonReferencePromptBlock() {
+  return `Saved script shape: {"name":"...","actions":[{"action":"navigate","params":{"url":"..."}},{"action":"click","params":{"sel":"button"}}]}
+Shorthand sel/id is fine; adapter canonicalizes.`;
+}
+
+export function buildSystemPromptForLoopProfile(loopProfile) {
+  const profile = normalizeAiLoopProfile(loopProfile);
+
+  if (profile === AI_LOOP_PROFILES.GLIC_TASK) {
+    return `Browser agent. Complete the user goal with the fewest moves.
+Context is a trimmed accessibility list (not full DOM). After goto, call look if login/reward controls are missing from CURRENT context before typing. Never type credentials without a visible login control in context. Between username/password/submit, keep acting without requesting more context unless blocked.
