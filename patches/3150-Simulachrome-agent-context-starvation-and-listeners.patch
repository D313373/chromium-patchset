-                         ? std::string()
-                         : std::string(" listener=") +
-                               dispatch.listener_script_id)
-                 << ": " << trigger_error;
-    } else {
-      LOG(INFO) << "[Dashboard] " << log_prefix << " "
-                << dispatch.trigger_script_id
-                << (dispatch.listener_script_id.empty()
-                        ? std::string()
-                        : std::string(" listener=") +
-                              dispatch.listener_script_id)
