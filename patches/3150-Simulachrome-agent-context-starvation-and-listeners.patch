+void WaitAction::Execute(content::WebContents* web_contents,
+                         Callback callback) {
+  LOG(INFO) << "[WaitAction::Execute] type='" << wait_type_ << "' time_ms_=" << time_ms_;
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "WaitAction: type='" << wait_type_ << "'";
+  }
+  if (wait_type_ == "time") {
+    LOG(INFO) << "[WaitAction::Execute] Posting delayed task for " << time_ms_ << "ms";
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "WaitAction: sleeping " << time_ms_ << "ms";
+    }
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(std::move(callback), true, ""),
+        base::Milliseconds(time_ms_));
+    return;
+  }
+
+  if (wait_type_ == "element") {
+    if (dashboard::IsVerboseLoggingEnabled()) {
