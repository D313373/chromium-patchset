+bool NearPointManhattan(const gfx::Point& a, const gfx::Point& b, int max_dist) {
+  const int dx = std::abs(a.x() - b.x());
+  const int dy = std::abs(a.y() - b.y());
+  return (dx + dy) <= max_dist;
+}
+
+std::string ReadNestedStringValue(const base::Value::Dict& dict,
+                                  const char* key) {
+  if (const std::string* direct = dict.FindString(key)) {
+    return *direct;
+  }
+  if (const base::Value::Dict* nested = dict.FindDict(key)) {
+    if (const std::string* value = nested->FindString("value")) {
+      return *value;
+    }
+  }
+  return std::string();
+}
