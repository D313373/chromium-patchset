+++ b/chrome/browser/ui/webui/dashboard/actions/native_page_map_matcher.cc
@@ -0,0 +1,693 @@
+#include "chrome/browser/ui/webui/dashboard/actions/native_page_map_matcher.h"
+
+#include <algorithm>
+#include <cctype>
+#include <iterator>
+#include <tuple>
+#include <unordered_map>
+#include <utility>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace dashboard {
+
+NativePageMapCandidate::NativePageMapCandidate() = default;
+NativePageMapCandidate::~NativePageMapCandidate() = default;
+NativePageMapCandidate::NativePageMapCandidate(
+    const NativePageMapCandidate&) = default;
+NativePageMapCandidate& NativePageMapCandidate::operator=(
+    const NativePageMapCandidate&) = default;
+NativePageMapCandidate::NativePageMapCandidate(
+    NativePageMapCandidate&&) noexcept = default;
+NativePageMapCandidate& NativePageMapCandidate::operator=(
+    NativePageMapCandidate&&) noexcept = default;
+PageMapMatchOptions::PageMapMatchOptions() = default;
+PageMapMatchOptions::~PageMapMatchOptions() = default;
+PageMapMatchOptions::PageMapMatchOptions(const PageMapMatchOptions&) = default;
+PageMapMatchOptions& PageMapMatchOptions::operator=(
+    const PageMapMatchOptions&) = default;
+PageMapMatchOptions::PageMapMatchOptions(PageMapMatchOptions&&) noexcept =
+    default;
+PageMapMatchOptions& PageMapMatchOptions::operator=(
+    PageMapMatchOptions&&) noexcept = default;
+
+namespace {
+
+std::string NormalizeText(std::string text) {
+  return base::CollapseWhitespaceASCII(std::move(text), true);
+}
+
+std::string Lower(std::string text) {
+  return base::ToLowerASCII(std::move(text));
+}
+
+std::string NormalizeRole(std::string text) {
+  return Lower(NormalizeText(std::move(text)));
+}
+
+bool TryReadInt(const base::Value::Dict& dict, const char* key, int* out) {
+  if (!out) {
+    return false;
+  }
+  if (std::optional<int> value = dict.FindInt(key)) {
+    *out = *value;
+    return true;
+  }
+  if (std::optional<double> value = dict.FindDouble(key)) {
+    *out = static_cast<int>(*value);
+    return true;
+  }
+  return false;
+}
+
+bool ClassListContainsToken(const std::string& class_attr,
+                            const std::string& wanted_lower) {
+  std::vector<std::string> tokens =
+      base::SplitString(class_attr, " \t\r\n", base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_NONEMPTY);
+  for (const std::string& token : tokens) {
+    if (Lower(token) == wanted_lower) {
+      return true;
+    }
+  }
+  return false;
+}
+
+int ScoreLocatorMatch(const NativePageMapCandidate& candidate,
+                      const Locator& locator) {
+  const std::string value = NormalizeText(locator.value);
+  const std::string value_lower = Lower(value);
+  switch (locator.type) {
+    case LocatorType::FRAME_ID:
+      return candidate.frame_id == locator.value ? 30 : -1;
+    case LocatorType::CSS_SELECTOR:
+      return candidate.css_selector == locator.value ? 160 : -1;
+    case LocatorType::XPATH:
+      return candidate.xpath == locator.value ? 160 : -1;
+    case LocatorType::SHADOW_DOM:
+      return candidate.shadow_chain_selector == locator.value ? 145 : -1;
+    case LocatorType::RESOURCE_TREE:
+      return candidate.resource_path == locator.value ? 145 : -1;
+    case LocatorType::ID:
+      return candidate.id_attr == locator.value ? 150 : -1;
+    case LocatorType::NAME:
+      return candidate.name_attr == locator.value ? 140 : -1;
+    case LocatorType::CLASS_NAME:
+      return ClassListContainsToken(candidate.class_attr, value_lower) ? 125
+                                                                       : -1;
+    case LocatorType::TAG_NAME:
+      return Lower(candidate.tag) == value_lower ? 70 : -1;
+    case LocatorType::ACCESSIBILITY_NAME:
+      return NormalizeText(candidate.accessibility_name) == value ? 135 : -1;
+    case LocatorType::TEXT_CONTENT: {
+      const std::string text = NormalizeText(candidate.text);
+      if (text == value) {
+        return 130;
+      }
+      if (!value.empty() &&
+          base::ToLowerASCII(text).find(value_lower) != std::string::npos) {
+        return 90;
+      }
+      return -1;
+    }
+    case LocatorType::LINK_TEXT: {
+      const std::string text = NormalizeText(candidate.text);
+      return text == value ? 130 : -1;
+    }
+    case LocatorType::PARTIAL_LINK_TEXT: {
+      const std::string text = NormalizeText(candidate.text);
+      return (!value.empty() &&
+              base::ToLowerASCII(text).find(value_lower) != std::string::npos)
+                 ? 85
+                 : -1;
+    }
+    case LocatorType::VISUAL_COORDS:
+    case LocatorType::VISUAL_AI:
+    case LocatorType::JS_EVAL:
+      return -1;
+  }
+  return -1;
+}
+
+int ScoreCandidate(const NativePageMapCandidate& candidate,
+                   const std::vector<Locator>& locators) {
+  if (locators.empty()) {
+    int score = 0;
+    if (candidate.visible) {
+      score += 40;
+    }
+    if (candidate.clickable) {
+      score += 20;
+    }
+    if (candidate.focusable) {
+      score += 15;
+    }
+    if (candidate.editable) {
+      score += 15;
+    }
+    if (candidate.width > 1 && candidate.height > 1) {
+      score += 10;
+    }
+    if (candidate.disabled) {
+      score -= 30;
+    }
+    return score;
+  }
+
+  int score = 0;
+  bool matched = false;
+  for (const Locator& locator : locators) {
+    const int locator_score = ScoreLocatorMatch(candidate, locator);
+    if (locator_score < 0) {
+      continue;
+    }
+    matched = true;
+    score += locator_score;
+  }
+  if (!matched) {
+    return -1;
+  }
+  if (candidate.visible) {
+    score += 40;
+  }
+  if (candidate.clickable) {
+    score += 20;
+  }
+  if (candidate.focusable) {
+    score += 15;
+  }
+  if (candidate.editable) {
+    score += 15;
+  }
+  if (candidate.width > 1 && candidate.height > 1) {
+    score += 10;
+  }
+  if (candidate.disabled) {
+    score -= 30;
+  }
+  return score;
+}
+
+void AppendLocatorIfPresent(std::vector<Locator>* out,
+                            LocatorType type,
+                            const std::string& value) {
+  if (!out || value.empty()) {
+    return;
+  }
+  Locator locator;
+  locator.type = type;
+  locator.value = value;
+  out->push_back(std::move(locator));
+}
+
+void PopulateCandidateLocators(NativePageMapCandidate* candidate) {
+  if (!candidate) {
+    return;
+  }
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::FRAME_ID,
+                         candidate->frame_id);
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::ID,
+                         candidate->id_attr);
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::NAME,
+                         candidate->name_attr);
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::CLASS_NAME,
+                         candidate->class_attr);
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::TAG_NAME,
+                         Lower(candidate->tag));
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::ACCESSIBILITY_NAME,
+                         NormalizeText(candidate->accessibility_name));
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::TEXT_CONTENT,
+                         NormalizeText(candidate->text));
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::CSS_SELECTOR,
+                         candidate->css_selector);
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::XPATH,
+                         candidate->xpath);
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::SHADOW_DOM,
+                         candidate->shadow_chain_selector);
+  AppendLocatorIfPresent(&candidate->locators, LocatorType::RESOURCE_TREE,
+                         candidate->resource_path);
+}
+
+std::optional<NativePageMapCandidate> CandidateFromValue(
+    const base::Value::Dict& element,
+    const std::string& frame_id) {
+  NativePageMapCandidate candidate;
+  candidate.frame_id = frame_id;
+  if (const std::string* tag = element.FindString("tag")) {
+    candidate.tag = *tag;
+  }
+  if (const std::string* text = element.FindString("text")) {
+    candidate.text = *text;
+  }
+  if (const std::string* ax_name = element.FindString("accessibilityName")) {
+    candidate.accessibility_name = *ax_name;
+  }
+  if (candidate.accessibility_name.empty()) {
+    if (const std::string* ax_name =
+            element.FindString("accessibility_name")) {
+      candidate.accessibility_name = *ax_name;
+    }
+  }
+  if (const std::string* role = element.FindString("role")) {
+    candidate.role = *role;
+  }
+  if (const std::string* id_attr = element.FindString("idAttr")) {
+    candidate.id_attr = *id_attr;
+  }
+  if (const std::string* class_attr = element.FindString("classAttr")) {
+    candidate.class_attr = *class_attr;
+  }
+  if (const std::string* name_attr = element.FindString("nameAttr")) {
+    candidate.name_attr = *name_attr;
+  }
+  if (const std::string* css = element.FindString("cssSelector")) {
+    candidate.css_selector = *css;
+  }
+  if (const std::string* xpath = element.FindString("xpath")) {
+    candidate.xpath = *xpath;
+  }
+  if (const std::string* shadow = element.FindString("shadowChainSelector")) {
+    candidate.shadow_chain_selector = *shadow;
+  }
+  if (const std::string* resource = element.FindString("resourcePath")) {
+    candidate.resource_path = *resource;
+  }
+  if (const std::string* interactive_role =
+          element.FindString("interactiveAncestorRole")) {
+    candidate.interactive_ancestor_role = *interactive_role;
+  }
+  if (candidate.interactive_ancestor_role.empty()) {
+    if (const std::string* interactive_role =
+            element.FindString("interactive_ancestor_role")) {
+      candidate.interactive_ancestor_role = *interactive_role;
+    }
+  }
+
+  candidate.visible = element.FindBool("visible").value_or(false);
+  candidate.clickable = element.FindBool("clickable").value_or(false);
+  candidate.focusable = element.FindBool("focusable").value_or(false);
+  candidate.editable = element.FindBool("editable").value_or(false);
+  candidate.disabled = element.FindBool("disabled").value_or(false);
+
+  if (const base::Value::Dict* bounds = element.FindDict("bounds")) {
+    TryReadInt(*bounds, "x", &candidate.x);
+    TryReadInt(*bounds, "y", &candidate.y);
+    TryReadInt(*bounds, "w", &candidate.width);
+    TryReadInt(*bounds, "h", &candidate.height);
+  } else {
+    TryReadInt(element, "x", &candidate.x);
+    TryReadInt(element, "y", &candidate.y);
+    TryReadInt(element, "width", &candidate.width);
+    TryReadInt(element, "height", &candidate.height);
+  }
+
+  TryReadInt(element, "rowIndex", &candidate.row_index);
+  TryReadInt(element, "colIndex", &candidate.col_index);
+  TryReadInt(element, "rowSpan", &candidate.row_span);
+  TryReadInt(element, "colSpan", &candidate.col_span);
+  candidate.row_span = std::max(1, candidate.row_span);
+  candidate.col_span = std::max(1, candidate.col_span);
+
+  if (candidate.width <= 0 || candidate.height <= 0) {
+    return std::nullopt;
+  }
+
+  if (const base::Value::Dict* selectors = element.FindDict("selectors")) {
+    if (candidate.css_selector.empty()) {
+      if (const std::string* css = selectors->FindString("css")) {
+        candidate.css_selector = *css;
+      }
+    }
+    if (candidate.xpath.empty()) {
+      if (const std::string* xpath = selectors->FindString("xpath")) {
+        candidate.xpath = *xpath;
+      }
+    }
+    if (candidate.shadow_chain_selector.empty()) {
+      if (const std::string* shadow = selectors->FindString("shadowChain")) {
+        candidate.shadow_chain_selector = *shadow;
+      }
+    }
+    if (candidate.resource_path.empty()) {
+      if (const std::string* resource =
+              selectors->FindString("resourcePath")) {
+        candidate.resource_path = *resource;
+      }
+    }
+    if (const base::Value::List* extra = selectors->FindList("locators")) {
+      std::vector<Locator> extra_locators = ConvertLocators(*extra);
+      candidate.locators.insert(candidate.locators.end(),
+                                std::make_move_iterator(extra_locators.begin()),
+                                std::make_move_iterator(extra_locators.end()));
+    }
+  }
+
+  PopulateCandidateLocators(&candidate);
+  return candidate;
+}
+
+void AppendCandidatesFromElementList(const base::Value::List* elements,
+                                     const std::string& frame_id,
+                                     int max_candidates,
+                                     std::vector<NativePageMapCandidate>* out) {
+  if (!elements || !out) {
+    return;
+  }
+  for (const auto& element_value : *elements) {
+    if (max_candidates > 0 &&
+        static_cast<int>(out->size()) >= max_candidates) {
+      return;
+    }
+    const base::Value::Dict* element = element_value.GetIfDict();
+    if (!element) {
+      continue;
+    }
+    std::optional<NativePageMapCandidate> candidate =
+        CandidateFromValue(*element, frame_id);
+    if (candidate.has_value()) {
+      out->push_back(std::move(*candidate));
+    }
+  }
+}
+
+struct LocatorMetadataHints {
+  std::string frame_id;
+  std::string shadow_chain;
+  std::string resource_path;
+  std::string id_attr;
+  std::string name_attr;
+  std::string ax_name;
+};
+
+LocatorMetadataHints DeriveLocatorMetadataHints(
+    const std::vector<Locator>& locators) {
+  LocatorMetadataHints hints;
+  for (const Locator& locator : locators) {
+    switch (locator.type) {
+      case LocatorType::FRAME_ID:
+        if (hints.frame_id.empty()) {
+          hints.frame_id = locator.value;
+        }
+        break;
+      case LocatorType::SHADOW_DOM:
+        if (hints.shadow_chain.empty()) {
+          hints.shadow_chain = locator.value;
+        }
+        break;
+      case LocatorType::RESOURCE_TREE:
+        if (hints.resource_path.empty()) {
+          hints.resource_path = locator.value;
+        }
+        break;
+      case LocatorType::ID:
+        if (hints.id_attr.empty()) {
+          hints.id_attr = locator.value;
+        }
+        break;
+      case LocatorType::NAME:
+        if (hints.name_attr.empty()) {
+          hints.name_attr = locator.value;
+        }
+        break;
+      case LocatorType::ACCESSIBILITY_NAME:
+        if (hints.ax_name.empty()) {
+          hints.ax_name = locator.value;
+        }
+        break;
+      default:
+        break;
+    }
+  }
+  return hints;
+}
+
+struct CandidateBuckets {
+  std::vector<size_t> all_indices;
+  std::unordered_map<std::string, std::vector<size_t>> by_frame_id;
+  std::unordered_map<std::string, std::vector<size_t>> by_shadow_chain;
+  std::unordered_map<std::string, std::vector<size_t>> by_resource_path;
+  std::unordered_map<std::string, std::vector<size_t>> by_id_attr;
+  std::unordered_map<std::string, std::vector<size_t>> by_name_attr;
+  std::unordered_map<std::string, std::vector<size_t>> by_ax_name;
+};
+
+void AppendBucket(std::unordered_map<std::string, std::vector<size_t>>* bucket,
+                  const std::string& key,
+                  size_t index) {
+  if (!bucket || key.empty()) {
+    return;
+  }
+  (*bucket)[key].push_back(index);
+}
+
+CandidateBuckets BuildCandidateBuckets(
+    const std::vector<NativePageMapCandidate>& candidates) {
+  CandidateBuckets buckets;
+  buckets.all_indices.reserve(candidates.size());
+  for (size_t i = 0; i < candidates.size(); ++i) {
+    const NativePageMapCandidate& candidate = candidates[i];
+    buckets.all_indices.push_back(i);
+    AppendBucket(&buckets.by_frame_id, candidate.frame_id, i);
+    AppendBucket(&buckets.by_shadow_chain, candidate.shadow_chain_selector, i);
+    AppendBucket(&buckets.by_resource_path, candidate.resource_path, i);
+    AppendBucket(&buckets.by_id_attr, candidate.id_attr, i);
+    AppendBucket(&buckets.by_name_attr, Lower(candidate.name_attr), i);
+    AppendBucket(&buckets.by_ax_name,
+                 Lower(NormalizeText(candidate.accessibility_name)), i);
+  }
+  return buckets;
+}
+
+std::vector<size_t> IntersectSortedIndices(const std::vector<size_t>& a,
+                                           const std::vector<size_t>& b) {
+  std::vector<size_t> out;
+  out.reserve(std::min(a.size(), b.size()));
+  std::set_intersection(a.begin(), a.end(), b.begin(), b.end(),
+                        std::back_inserter(out));
+  return out;
+}
+
+void TryApplyBucketFilter(
+    std::vector<size_t>* current,
+    const std::unordered_map<std::string, std::vector<size_t>>& bucket,
+    const std::string& key) {
+  if (!current || key.empty()) {
+    return;
+  }
+  const auto it = bucket.find(key);
+  if (it == bucket.end() || it->second.empty()) {
+    return;
+  }
+  std::vector<size_t> intersection = IntersectSortedIndices(*current, it->second);
+  if (!intersection.empty()) {
+    *current = std::move(intersection);
+  }
+}
+
+template <typename Predicate>
+void TryApplyPredicateFilter(const std::vector<NativePageMapCandidate>& candidates,
+                             std::vector<size_t>* current,
+                             Predicate predicate) {
+  if (!current || current->empty()) {
+    return;
+  }
+  std::vector<size_t> filtered;
+  filtered.reserve(current->size());
+  for (size_t index : *current) {
+    if (index < candidates.size() && predicate(candidates[index])) {
+      filtered.push_back(index);
+    }
+  }
+  if (!filtered.empty()) {
+    *current = std::move(filtered);
+  }
+}
+
+PageMapMatchOptions MergeMatchOptions(const std::vector<Locator>& locators,
+                                      const PageMapMatchOptions& options) {
+  PageMapMatchOptions merged = options;
+  const LocatorMetadataHints hints = DeriveLocatorMetadataHints(locators);
+  if (merged.frame_id.empty()) {
+    merged.frame_id = hints.frame_id;
+  }
+  if (merged.shadow_chain.empty()) {
+    merged.shadow_chain = hints.shadow_chain;
+  }
+  if (merged.resource_path.empty()) {
+    merged.resource_path = hints.resource_path;
+  }
+  if (merged.ax_name.empty()) {
+    merged.ax_name = hints.ax_name;
+  }
+  return merged;
+}
+
+std::vector<size_t> ApplyWaterfallFilters(
+    const std::vector<NativePageMapCandidate>& candidates,
+    const std::vector<Locator>& locators,
+    const PageMapMatchOptions& options) {
+  const LocatorMetadataHints locator_hints = DeriveLocatorMetadataHints(locators);
+  const CandidateBuckets buckets = BuildCandidateBuckets(candidates);
+  std::vector<size_t> current = buckets.all_indices;
+
+  TryApplyBucketFilter(&current, buckets.by_frame_id, options.frame_id);
+  TryApplyBucketFilter(&current, buckets.by_shadow_chain, options.shadow_chain);
+  TryApplyBucketFilter(&current, buckets.by_resource_path, options.resource_path);
+  TryApplyBucketFilter(&current, buckets.by_id_attr, locator_hints.id_attr);
+  TryApplyBucketFilter(&current, buckets.by_name_attr,
+                       Lower(locator_hints.name_attr));
+  TryApplyBucketFilter(&current, buckets.by_ax_name,
+                       Lower(NormalizeText(options.ax_name)));
+
+  const std::string wanted_role = NormalizeRole(options.ax_role);
+  if (!wanted_role.empty()) {
+    TryApplyPredicateFilter(
+        candidates, &current,
+        [&](const NativePageMapCandidate& candidate) {
+          const std::string role = NormalizeRole(candidate.role);
+          return role == wanted_role ||
+                 base::StartsWith(role, wanted_role,
+                                  base::CompareCase::SENSITIVE);
+        });
+  }
+
+  const std::string wanted_interactive_role =
+      NormalizeRole(options.interactive_ancestor_role);
+  if (!wanted_interactive_role.empty()) {
+    TryApplyPredicateFilter(
+        candidates, &current,
+        [&](const NativePageMapCandidate& candidate) {
+          const std::string role =
+              NormalizeRole(candidate.interactive_ancestor_role);
+          return role == wanted_interactive_role ||
+                 base::StartsWith(role, wanted_interactive_role,
+                                  base::CompareCase::SENSITIVE);
+        });
+  }
+
+  if (options.prefer_visible) {
+    TryApplyPredicateFilter(candidates, &current,
+                            [](const NativePageMapCandidate& candidate) {
+                              return candidate.visible;
+                            });
+  }
+
+  return current;
+}
