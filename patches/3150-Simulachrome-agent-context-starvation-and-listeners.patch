+    std::move(callback).Run(false, "No web contents for resolver fallback");
+    return;
+  }
+
+  resolver_page_map_fallback_attempted_ = true;
+  resolver_page_map_extractor_ = std::make_unique<dashboard::PageMapExtractor>();
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ScrapeTable] APC page-map was insufficient (" << reason
+              << "), trying native resolver page-map fallback";
+  }
+
+  resolver_page_map_extractor_->Run(
+      web_contents,
+      base::BindOnce(&ScrapeTableAction::OnResolverPageMapFallbackReady,
+                     weak_ptr_factory_.GetWeakPtr(), web_contents,
+                     std::move(callback), reason),
+      /*greedy=*/false,
+      /*is_agent_mode=*/false,
+      /*timeout_ms=*/4000);
+}
+
+void ScrapeTableAction::OnResolverPageMapFallbackReady(
+    content::WebContents* web_contents,
+    Callback callback,
+    const std::string& reason,
+    base::Value::Dict resolver_page_map) {
+  resolver_page_map_extractor_.reset();
+
+  if (resolver_page_map.empty()) {
+    StartSemanticLocatorFallback(
+        web_contents, std::move(callback), resolver_page_map,
+        "Resolver page-map was empty after APC mismatch: " + reason);
+    return;
+  }
+
+  ScrapeExtractionAttempt attempt = ExtractRowsFromPageMap(
+      resolver_page_map, row_locators_, fields_, row_index_mode_,
+      row_indices_zero_based_);
+  if (attempt.success) {
+    if (!attempt.output_fields.empty()) {
+      fields_ = std::move(attempt.output_fields);
+    }
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "[ScrapeTable] Resolver page-map fallback succeeded";
+    }
+    FinalizeRowsPayload(std::move(callback), std::move(attempt.rows_json),
+                        /*used_semantic_fallback=*/false);
+    return;
+  }
+  if (attempt.hard_error) {
+    std::move(callback).Run(false, attempt.reason);
+    return;
+  }
+
+  StartSemanticLocatorFallback(
+      web_contents, std::move(callback), resolver_page_map,
+      "Resolver page-map also missed table data: " + attempt.reason +
+          " (APC reason: " + reason + ")");
+}
+
+void ScrapeTableAction::StartSemanticLocatorFallback(
+    content::WebContents* web_contents,
+    Callback callback,
+    const base::Value::Dict& page_map,
+    const std::string& reason) {
+  if (!dashboard::IsJavaScriptExecutionEnabled() &&
+      dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ScrapeTable] JS action fallback is disabled globally, but "
+                 "scrape_table is using internal semantic DOM matching for "
+                 "reliability. Native reason: "
+              << reason;
+  }
+  if (!web_contents) {
+    std::move(callback).Run(false, "No web contents for semantic fallback");
+    return;
+  }
+
+  base::Value::List locator_sets =
+      BuildLocatorSetsForSemanticResolve(row_locators_, fields_);
+  if (locator_sets.empty()) {
+    std::move(callback).Run(false,
+                            "No locators available for semantic fallback");
+    return;
+  }
+
+  std::string locator_sets_json;
+  base::JSONWriter::Write(locator_sets, &locator_sets_json);
+  if (locator_sets_json.empty()) {
+    std::move(callback).Run(
+        false, "Failed to serialize locators for semantic fallback");
+    return;
+  }
+
+  std::string script = std::string(kSemanticLocatorResolverJs) + "(" +
+                       locator_sets_json + ")";
+
+  std::vector<content::RenderFrameHost*> frames;
+  content::RenderFrameHost* primary = web_contents->GetPrimaryMainFrame();
+  content::Page* primary_page = nullptr;
+  if (primary && primary->IsActive()) {
+    frames.push_back(primary);
+    primary_page = &primary->GetPage();
+  }
+  web_contents->ForEachRenderFrameHost(
+      [&frames, primary, primary_page](content::RenderFrameHost* rfh) {
+        if (!rfh || rfh == primary || !rfh->IsActive()) {
+          return;
+        }
+        if (primary_page && &rfh->GetPage() != primary_page) {
+          return;
+        }
+        frames.push_back(rfh);
+      });
+
+  if (frames.empty()) {
+    std::move(callback).Run(false,
+                            "No live frames available for semantic fallback");
+    return;
+  }
+
+  semantic_fallback_active_ = true;
+  semantic_fallback_reason_ = reason;
+  semantic_page_map_ = page_map.Clone();
+  semantic_set_matches_.assign(locator_sets.size(), {});
+  semantic_pending_frames_ = 0;
+  semantic_callback_ = std::move(callback);
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ScrapeTable] page-map match insufficient (" << reason
+              << "), starting semantic DOM fallback across " << frames.size()
+              << " frame(s)";
+  }
+
+  for (content::RenderFrameHost* frame : frames) {
+    if (!frame || !frame->IsRenderFrameLive()) {
+      continue;
+    }
+    ++semantic_pending_frames_;
+    const std::string frame_id = frame->GetFrameToken().ToString();
+    frame->ExecuteJavaScriptForTests(
+        base::UTF8ToUTF16(script),
+        base::BindOnce(&ScrapeTableAction::OnSemanticFallbackFrameResult,
+                       weak_ptr_factory_.GetWeakPtr(), frame_id),
+        content::ISOLATED_WORLD_ID_CONTENT_END);
+  }
+
+  if (semantic_pending_frames_ == 0) {
+    semantic_fallback_active_ = false;
+    semantic_page_map_.clear();
+    semantic_set_matches_.clear();
+    semantic_fallback_reason_.clear();
+    Callback failed = std::move(semantic_callback_);
+    std::move(failed).Run(false,
+                          "Semantic fallback could not query any live frame");
+  }
+}
+
+void ScrapeTableAction::OnSemanticFallbackFrameResult(
+    const std::string& frame_id,
+    base::Value result) {
+  if (!semantic_fallback_active_) {
+    return;
+  }
+
+  AppendSemanticResultMatchesForFrame(frame_id, result, &semantic_set_matches_);
+
+  if (semantic_pending_frames_ > 0) {
+    --semantic_pending_frames_;
+  }
+  if (semantic_pending_frames_ != 0) {
+    return;
+  }
+
+  semantic_fallback_active_ = false;
+  Callback callback = std::move(semantic_callback_);
+
+  const bool has_row_set = !row_locators_.empty();
+  const size_t field_set_offset = has_row_set ? 1u : 0u;
+
+  std::vector<dashboard::NativePageMapCandidate> rows;
+  if (has_row_set) {
+    rows = SortRows(semantic_set_matches_[0]);
+    if (rows.empty()) {
+      semantic_fallback_reason_.clear();
+      semantic_page_map_.clear();
+      semantic_set_matches_.clear();
+      std::move(callback).Run(
+          false,
+          "No rows matched row locators after semantic fallback. "
+          "Tip: make the row locator target row containers like `tr`.");
+      return;
+    }
+  }
+
+  std::string row_selection_error;
+  if (!ApplyRowSelectionIndices(row_index_mode_, row_indices_zero_based_, &rows,
+                                &row_selection_error)) {
+    semantic_fallback_reason_.clear();
+    semantic_page_map_.clear();
+    semantic_set_matches_.clear();
+    std::move(callback).Run(false, row_selection_error);
+    return;
+  }
+
+  std::vector<std::vector<dashboard::NativePageMapCandidate>> field_matches;
+  field_matches.reserve(fields_.size());
+  for (size_t i = 0; i < fields_.size(); ++i) {
+    const size_t set_index = i + field_set_offset;
+    if (set_index < semantic_set_matches_.size()) {
+      field_matches.push_back(std::move(semantic_set_matches_[set_index]));
+    } else {
+      field_matches.emplace_back();
+    }
+  }
+
+  std::vector<dashboard::ScrapeTableField> effective_fields = fields_;
+  MaybeDeriveAutoFieldNamesFromHeaders(semantic_page_map_, rows, field_matches,
+                                       &effective_fields);
+  base::Value::List rows_json = BuildRowsJsonFromCandidateMatches(
+      effective_fields, rows,
+      dashboard::ExtractPageMapCandidates(semantic_page_map_), field_matches);
+  if (rows_json.empty()) {
+    const std::string reason = semantic_fallback_reason_;
+    semantic_fallback_reason_.clear();
+    semantic_page_map_.clear();
+    semantic_set_matches_.clear();
+    std::move(callback).Run(
+        false,
+        "scrape_table found no values after semantic fallback. Last native "
+        "reason: " +
+            reason);
+    return;
+  }
+
+  semantic_fallback_reason_.clear();
+  semantic_page_map_.clear();
+  semantic_set_matches_.clear();
+  fields_ = std::move(effective_fields);
+  FinalizeRowsPayload(std::move(callback), std::move(rows_json),
+                      /*used_semantic_fallback=*/true);
 }
 
