+def cmd_refresh_headless_tab(script_id: str = "",
+                             target_id: str = "") -> Dict[str, Any]:
+  """Reload a headless page target and force an immediate listener re-check.
+
+  For active listeners this also sets force_poll so the worker diffs the next
+  snapshot against its existing match baseline (seen keys / content ids),
+  rather than waiting for the next sample/refresh interval.
+  """
+  resolved_target = str(target_id or "").strip()
+  sid = str(script_id or "").strip()
+  entry = None
+  state = None
+  listeners = None
+  if sid:
+    _validate_script_id(sid)
+    state = _read_json(STATE_PATH, {"listeners": {}})
+    listeners = state.get("listeners", {})
+    entry = listeners.get(sid) if isinstance(listeners, dict) else None
+    if not isinstance(entry, dict):
+      return {"ok": False, "error": f"No active headless listener for {sid}"}
+    resolved_target = str(entry.get("target_id") or resolved_target or "").strip()
+  if not resolved_target:
+    return {"ok": False, "error": "Missing headless target id to refresh."}
+
+  try:
+    ws_url = _target_ws_url_with_retry(resolved_target, timeout_sec=5.0)
+  except Exception as exc:
+    return {"ok": False, "error": f"Headless target unavailable: {exc}"}
+
+  ws: Optional[WebSocketCDP] = None
+  try:
+    ws = WebSocketCDP(ws_url, timeout=15.0)
+    try:
+      ws.call("Page.enable", {})
+    except Exception:
+      pass
+    ws.call("Page.reload", {"ignoreCache": False})
+  except Exception as exc:
+    return {"ok": False, "error": f"Page.reload failed: {exc}"}
+  finally:
+    if ws is not None:
+      ws.close()
+
+  force_poll = False
+  if sid and isinstance(entry, dict) and isinstance(state, dict):
+    entry["force_poll"] = True
+    entry["force_poll_ms"] = _now_ms()
+    if not isinstance(listeners, dict):
+      listeners = {}
+      state["listeners"] = listeners
+    listeners[sid] = entry
+    _write_json(STATE_PATH, state)
+    force_poll = True
+
+  _append_event({
+      "ts_ms": _now_ms(),
+      "action": "refresh",
+      "listener_script_id": sid,
+      "detail": (
+          f"manual_refresh target={resolved_target} "
+          f"force_poll={1 if force_poll else 0}"
+      ),
+  })
+  return {
+      "ok": True,
+      "target_id": resolved_target,
+      "script_id": sid,
+      "force_poll": force_poll,
+  }
+
