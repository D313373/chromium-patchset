--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/cdp/cdp_navigate_action.cc
@@ -0,0 +1,295 @@
+#include "chrome/browser/ui/webui/dashboard/actions/cdp/cdp_navigate_action.h"
+
+#include <string>
+#include <vector>
+
+#include "base/logging.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard_devtools_client.h"
+#include "components/url_formatter/url_fixer.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/common/referrer.h"
+#include "net/base/net_errors.h"
+#include "services/network/public/mojom/referrer_policy.mojom.h"
+#include "ui/base/page_transition_types.h"
+
+namespace {
+
+constexpr base::TimeDelta kNavigationTimeout = base::Seconds(120);
+constexpr int kAttachRetryLimit = 6;
+constexpr base::TimeDelta kAttachRetryDelay = base::Milliseconds(120);
+
+bool SameOriginAndPath(const GURL& lhs, const GURL& rhs) {
+  return lhs.is_valid() && rhs.is_valid() && lhs.scheme() == rhs.scheme() &&
+         lhs.host() == rhs.host() &&
+         lhs.EffectiveIntPort() == rhs.EffectiveIntPort() &&
+         lhs.path() == rhs.path();
+}
+
+bool RedirectChainContainsEquivalent(const std::vector<GURL>& chain,
+                                     const GURL& expected) {
+  for (const auto& url : chain) {
+    if (url == expected || SameOriginAndPath(url, expected)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+class CdpNavigateAction::NavigationWaiter : public content::WebContentsObserver {
+ public:
+  NavigationWaiter(content::WebContents* web_contents,
+                   const GURL& expected_url,
+                   CdpNavigateAction* owner)
+      : content::WebContentsObserver(web_contents),
+        expected_url_(expected_url),
+        owner_(owner) {}
+
+  ~NavigationWaiter() override = default;
+
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (!owner_ || navigation->GetWebContents() != web_contents()) {
+      return;
+    }
+    if (!navigation->IsInPrimaryMainFrame() || !navigation->HasCommitted()) {
+      return;
+    }
+
+    const GURL committed = navigation->GetURL();
+    if (committed != expected_url_ &&
+        !RedirectChainContainsEquivalent(navigation->GetRedirectChain(),
+                                         expected_url_)) {
+      return;
+    }
+
+    CdpNavigateAction* owner = owner_.get();
+    owner_ = nullptr;
+    const int net_error = navigation->GetNetErrorCode();
+    if (net_error != net::OK) {
+      owner->OnNavigationFinished(false, net::ErrorToShortString(net_error));
+      return;
+    }
+    owner->OnNavigationFinished(true, "path=cdp_navigate");
+  }
+
+  void WebContentsDestroyed() override {
+    if (!owner_) {
+      return;
+    }
+    CdpNavigateAction* owner = owner_.get();
+    owner_ = nullptr;
+    owner->OnNavigationFinished(false, "WebContents destroyed");
+  }
+
+ private:
+  GURL expected_url_;
+  raw_ptr<CdpNavigateAction> owner_;
+};
+
+CdpNavigateAction::CdpNavigateAction(Profile* profile) : CdpActionBase(profile) {}
+
+CdpNavigateAction::~CdpNavigateAction() = default;
+
+bool CdpNavigateAction::SetParams(const base::Value::Dict& params) {
+  const std::string* raw_url = params.FindString("url");
+  if (!raw_url) {
+    return false;
+  }
+
+  const GURL fixed =
+      url_formatter::FixupURL(*raw_url, /*desired_tld=*/std::string());
+  // Allow chrome:// and about: for agent/tooling tabs (e.g. chrome://newtab/).
+  if (!fixed.is_valid() ||
+      !(fixed.SchemeIsHTTPOrHTTPS() || fixed.SchemeIs("chrome") ||
+        fixed.SchemeIs("about"))) {
+    return false;
+  }
+  url_ = fixed.spec();
+
+  if (const std::string* referrer = params.FindString("referrer")) {
+    referrer_ = *referrer;
+  } else {
+    referrer_.clear();
+  }
+
+  if (auto wait_for_commit = params.FindBool("waitForCommit")) {
+    wait_for_commit_ = *wait_for_commit;
+  } else {
+    wait_for_commit_ = true;
+  }
+
+  base::Value::Dict serialized = params.Clone();
+  serialized.Set("url", url_);
+  serialized.Set("waitForCommit", wait_for_commit_);
+  SetSerializedAction("navigate", std::move(serialized));
+  return true;
+}
+
+void CdpNavigateAction::Execute(content::WebContents* web_contents,
+                                Callback callback) {
+  if (!web_contents) {
+    std::move(callback).Run(false, "WebContents null");
+    return;
+  }
+  if (url_.empty()) {
+    std::move(callback).Run(false, "No URL provided");
+    return;
+  }
+
+  target_url_ = GURL(url_);
+  if (!target_url_.is_valid()) {
+    std::move(callback).Run(false, "Invalid URL");
+    return;
+  }
+
+  dashboard::DashboardDevToolsClient* client = GetDevToolsClient(web_contents);
+  if (!client) {
+    std::move(callback).Run(false, "CDP client unavailable");
+    return;
+  }
+
+  web_contents_ = web_contents;
+  pending_callback_ = std::move(callback);
+  attach_retry_count_ = 0;
+  native_fallback_attempted_ = false;
+  native_fallback_reason_.clear();
+  navigation_waiter_.reset();
+  navigation_timeout_.Stop();
+
+  if (wait_for_commit_) {
+    navigation_waiter_ =
+        std::make_unique<NavigationWaiter>(web_contents, target_url_, this);
+    navigation_timeout_.Start(FROM_HERE, kNavigationTimeout,
+                              base::BindOnce(&CdpNavigateAction::OnNavigationTimeout,
+                                             weak_ptr_factory_.GetWeakPtr()));
+  }
+
+  DispatchNavigate(web_contents);
+}
+
+void CdpNavigateAction::DispatchNavigate(content::WebContents* web_contents) {
+  dashboard::DashboardDevToolsClient* client = GetDevToolsClient(web_contents);
+  if (!client) {
+    if (attach_retry_count_ < kAttachRetryLimit) {
+      ++attach_retry_count_;
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&CdpNavigateAction::DispatchNavigate,
+                         weak_ptr_factory_.GetWeakPtr(), web_contents),
+          kAttachRetryDelay);
+      return;
+    }
+    StartNativeLoadFallback("CDP client unavailable");
+    return;
+  }
+
+  base::Value::Dict params;
+  params.Set("url", url_);
+  if (!referrer_.empty()) {
+    params.Set("referrer", referrer_);
+  }
+  ExecuteCdpCommand(
+      client, "Page.navigate", std::move(params),
+      base::BindOnce(&CdpNavigateAction::OnNavigateDispatched,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void CdpNavigateAction::OnNavigateDispatched(bool success,
+                                             const std::string& error) {
+  if (!pending_callback_) {
+    return;
+  }
+
+  if (!success) {
+    StartNativeLoadFallback("CDP navigate failed: " + error);
+    return;
+  }
+
+  if (!wait_for_commit_) {
+    OnNavigationFinished(true, "path=cdp_navigate");
+    return;
+  }
+
+  if (web_contents_ && web_contents_->GetLastCommittedURL() == target_url_) {
+    OnNavigationFinished(true, "path=cdp_navigate");
+    return;
+  }
+}
+
+void CdpNavigateAction::OnNavigationFinished(bool success,
+                                             const std::string& error) {
+  navigation_timeout_.Stop();
+  navigation_waiter_.reset();
+  auto callback = std::move(pending_callback_);
+  if (callback) {
+    if (success && native_fallback_attempted_) {
+      std::string detail = "path=native_fallback_after_cdp_navigate";
+      if (!native_fallback_reason_.empty()) {
+        detail += " reason=" + native_fallback_reason_;
+      }
+      std::move(callback).Run(true, detail);
+      return;
+    }
+    std::move(callback).Run(success, error);
+  }
+}
+
+void CdpNavigateAction::OnNavigationTimeout() {
+  if (!native_fallback_attempted_) {
+    StartNativeLoadFallback("CDP navigate timed out");
+    return;
+  }
+  OnNavigationFinished(false, "CDP/native navigate timed out");
+}
+
+void CdpNavigateAction::StartNativeLoadFallback(const std::string& reason) {
+  if (!pending_callback_ || !web_contents_) {
+    return;
+  }
+  if (native_fallback_attempted_) {
+    OnNavigationFinished(false, reason);
+    return;
+  }
+
+  native_fallback_attempted_ = true;
+  native_fallback_reason_ = reason;
+  LOG(WARNING) << "[CdpNavigateAction] Falling back to native load. target="
+               << target_url_.spec() << " reason=" << reason;
+
+  content::NavigationController::LoadURLParams load_params(target_url_);
+  if (!referrer_.empty()) {
+    const GURL referrer_url(referrer_);
+    if (referrer_url.is_valid()) {
+      load_params.referrer =
+          content::Referrer(referrer_url,
+                            network::mojom::ReferrerPolicy::kStrictOriginWhenCrossOrigin);
+      load_params.transition_type = ui::PAGE_TRANSITION_LINK;
+    } else {
+      load_params.transition_type = ui::PAGE_TRANSITION_TYPED;
+    }
+  } else {
+    load_params.transition_type = ui::PAGE_TRANSITION_TYPED;
+  }
+
+  if (!wait_for_commit_) {
+    web_contents_->GetController().LoadURLWithParams(load_params);
+    OnNavigationFinished(true, "path=native_navigate_no_wait_fallback");
+    return;
+  }
+
+  if (!navigation_waiter_) {
+    navigation_waiter_ =
+        std::make_unique<NavigationWaiter>(web_contents_, target_url_, this);
+  }
+  navigation_timeout_.Start(
+      FROM_HERE, kNavigationTimeout,
+      base::BindOnce(&CdpNavigateAction::OnNavigationTimeout,
+                     weak_ptr_factory_.GetWeakPtr()));
+  web_contents_->GetController().LoadURLWithParams(load_params);
+}
