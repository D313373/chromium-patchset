+bool ContainsAuthNeedle(std::string_view haystack,
+                        std::initializer_list<std::string_view> needles) {
+  for (std::string_view needle : needles) {
+    if (haystack.find(needle) != std::string_view::npos) {
+      return true;
+    }
+  }
+  return false;
