+
+bool SchedulerService::SetScriptSchedule(const std::string& script_id,
+                                          const ScheduleConfig& config,
+                                          std::string* error) {
+  if (!ValidateSchedule(config, error)) {
+    return false;
+  }
+
+  // Get script name
+  std::string script_name = GetScriptName(script_id);
+  if (script_name.empty()) {
+    if (error) {
+      *error = "Script not found: " + script_id;
+    }
+    return false;
+  }
+
+  // Create or update scheduled script
+  ScheduledScript& scheduled = scheduled_scripts_[script_id];
+  scheduled.info.script_id = script_id;
+  scheduled.info.script_name = script_name;
+  scheduled.info.schedule = config;
+  scheduled.info.is_paused = false;
+  scheduled.info.has_error = false;
+  scheduled.info.last_error.clear();
+
+  // Schedule next run
+  if (config.enabled) {
+    ScheduleNextRun(script_id);
+  } else {
+    // Disable timer if exists
+    if (scheduled.timer) {
+      scheduled.timer->Stop();
+    }
+  }
+
+  SaveSchedulesToDisk();
+  return true;
+}
+
+std::vector<ScheduledScriptInfo> SchedulerService::GetScheduledScripts() const {
+  std::vector<ScheduledScriptInfo> result;
+  for (const auto& [script_id, scheduled] : scheduled_scripts_) {
+    result.push_back(scheduled.info);
+  }
+  return result;
+}
+
+bool SchedulerService::PauseScheduledScript(const std::string& script_id,
+                                             std::string* error) {
+  auto it = scheduled_scripts_.find(script_id);
+  if (it == scheduled_scripts_.end()) {
+    if (error) {
+      *error = "Script not scheduled: " + script_id;
+    }
+    return false;
+  }
+
+  it->second.info.is_paused = true;
+  if (it->second.timer) {
+    it->second.timer->Stop();
+  }
+
+  SaveSchedulesToDisk();
+  return true;
+}
+
+bool SchedulerService::ResumeScheduledScript(const std::string& script_id,
+                                              std::string* error) {
+  auto it = scheduled_scripts_.find(script_id);
+  if (it == scheduled_scripts_.end()) {
+    if (error) {
+      *error = "Script not scheduled: " + script_id;
+    }
+    return false;
+  }
+
+  it->second.info.is_paused = false;
+  if (it->second.info.schedule.enabled) {
+    ScheduleNextRun(script_id);
+  }
+
+  SaveSchedulesToDisk();
+  return true;
+}
+
+bool SchedulerService::RunScheduledScriptNow(const std::string& script_id,
+                                              std::string* error) {
+  auto it = scheduled_scripts_.find(script_id);
+  if (it == scheduled_scripts_.end()) {
+    if (error) {
+      *error = "Script not scheduled: " + script_id;
+    }
+    return false;
+  }
+
+  // Trigger execution immediately
+  OnTimerFired(script_id);
+  return true;
+}
+
+bool SchedulerService::ClearScriptSchedule(const std::string& script_id,
+                                            std::string* error) {
+  auto it = scheduled_scripts_.find(script_id);
+  if (it == scheduled_scripts_.end()) {
+    if (error) {
+      *error = "Script not scheduled: " + script_id;
+    }
+    return false;
+  }
+
+  // Stop timer and remove from map
+  if (it->second.timer) {
+    it->second.timer->Stop();
+  }
+  scheduled_scripts_.erase(it);
+
+  SaveSchedulesToDisk();
+  return true;
+}
+
+void SchedulerService::OnTimerFired(const std::string& script_id) {
+  auto it = scheduled_scripts_.find(script_id);
+  if (it == scheduled_scripts_.end()) {
+    return;
+  }
+
+  LOG(INFO) << "[SchedulerService] Executing scheduled script: " << script_id;
+
+  // TODO: Implement actual script execution
+  // For now, just log and schedule next run
+
+  // Update last run time
+  it->second.info.last_run = base::Time::Now();
+
+  // Schedule next run
+  ScheduleNextRun(script_id);
+}
+
+void SchedulerService::OnScriptExecutionComplete(const std::string& script_id,
+                                                  bool success,
+                                                  const std::string& error) {
+  auto it = scheduled_scripts_.find(script_id);
+  if (it == scheduled_scripts_.end()) {
+    return;
+  }
+
+  it->second.info.has_error = !success;
+  it->second.info.last_error = error;
+
+  SaveSchedulesToDisk();
+}
+
+void SchedulerService::ScheduleNextRun(const std::string& script_id) {
+  auto it = scheduled_scripts_.find(script_id);
+  if (it == scheduled_scripts_.end()) {
+    return;
+  }
+
+  ScheduledScript& scheduled = it->second;
+
+  // Don't schedule if paused or disabled
+  if (scheduled.info.is_paused || !scheduled.info.schedule.enabled) {
+    return;
+  }
+
+  // Calculate next run time
+  base::Time next_run = CalculateNextRunTime(scheduled.info.schedule);
+  scheduled.info.schedule.next_run = next_run;
+
+  // Calculate delay from now
+  base::TimeDelta delay = next_run - base::Time::Now();
+  if (delay.is_negative()) {
+    delay = base::Milliseconds(0);
+  }
+
+  // Create or restart timer
+  if (!scheduled.timer) {
+    scheduled.timer = std::make_unique<base::RepeatingTimer>();
+  }
+
+  scheduled.timer->Start(
+      FROM_HERE,
+      delay,
+      base::BindRepeating(&SchedulerService::OnTimerFired,
+                          weak_ptr_factory_.GetWeakPtr(),
+                          script_id));
+
+  LOG(INFO) << "[SchedulerService] Scheduled next run for " << script_id
+            << " at " << TimeToIso8601(next_run);
+}
+
+base::Time SchedulerService::CalculateNextRunTime(const ScheduleConfig& config) const {
+  base::Time now = base::Time::Now();
+  int64_t interval_ms = config.GetIntervalMs();
+  return now + base::Milliseconds(interval_ms);
+}
+
 std::string SchedulerService::GetScriptName(const std::string& script_id) const {
   base::Value::Dict script = dashboard_->LoadScript(script_id);
   const std::string* name = script.FindString("name");
   return name ? *name : "";
 }
 
+bool SchedulerService::ValidateSchedule(const ScheduleConfig& config,
+                                         std::string* error) const {
+  if (!config.enabled) {
+    return true;  // Disabled schedules are always valid
+  }
+
+  if (!config.IsValid()) {
+    if (error) {
+      int64_t interval = config.GetIntervalMs();
+      if (interval < kMinIntervalMs) {
+        *error = "Interval too short (minimum 5 minutes)";
+      } else if (interval > kMaxIntervalMs) {
+        *error = "Interval too long (maximum 365 days)";
+      } else {
+        *error = "Invalid interval";
+      }
+    }
+    return false;
+  }
+
+  return true;
+}
