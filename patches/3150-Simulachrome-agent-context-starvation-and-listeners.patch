+std::optional<base::Value> ExtractRuntimeValue(const std::string& res_json) {
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      res_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed || !parsed->is_dict())
+    return std::nullopt;
+  const base::Value::Dict& root = parsed->GetDict();
+  const base::Value::Dict* result = root.FindDict("result");
+  if (!result)
+    return std::nullopt;
+  const base::Value::Dict* inner = result->FindDict("result");
+  const base::Value* value =
+      inner ? inner->Find("value") : result->Find("value");
+  if (!value)
+    return std::nullopt;
+  return value->Clone();
