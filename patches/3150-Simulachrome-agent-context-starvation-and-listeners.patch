+void AppendSemanticResultMatchesForFrame(
+    const std::string& frame_id,
+    const base::Value& result_value,
+    std::vector<std::vector<dashboard::NativePageMapCandidate>>* set_matches) {
+  if (!set_matches) {
+    return;
+  }
+  const base::Value::Dict* result_dict = result_value.GetIfDict();
+  if (!result_dict) {
+    return;
+  }
+  const base::Value::List* sets = result_dict->FindList("sets");
+  if (!sets) {
+    return;
+  }
+  for (size_t set_index = 0;
+       set_index < sets->size() && set_index < set_matches->size();
+       ++set_index) {
+    const base::Value::List* matches = (*sets)[set_index].GetIfList();
+    if (!matches) {
+      continue;
+    }
+    for (const auto& match_value : *matches) {
+      const base::Value::Dict* match_dict = match_value.GetIfDict();
+      if (!match_dict) {
+        continue;
+      }
+      std::optional<dashboard::NativePageMapCandidate> candidate =
+          CandidateFromSemanticResultDict(*match_dict, frame_id);
+      if (candidate.has_value()) {
+        (*set_matches)[set_index].push_back(std::move(*candidate));
+      }
+    }
+  }
+}
