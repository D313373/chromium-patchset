+void RecorderController::SetGuidedScrapeOverlayEnabled(bool enabled) {
+  const std::string js = base::StringPrintf(
+      R"JS((function() {
+            try {
+              const key = '__dash_guided_selection_boxes__';
+              const state = window[key] || (window[key] = {
+                enabled: false,
+                root: null,
+                boxes: [],
+              });
+              const ensureRoot = function() {
+                if (state.root && state.root.isConnected) {
+                  return;
+                }
+                const root = document.createElement('div');
+                root.id = '__dash_guided_selection_boxes_root__';
+                root.style.position = 'fixed';
+                root.style.inset = '0';
+                root.style.pointerEvents = 'none';
+                root.style.zIndex = '2147483646';
+                root.style.display = 'none';
+                document.documentElement.appendChild(root);
+                state.root = root;
+              };
+              const clearBoxes = function() {
+                if (!state.root) {
+                  state.boxes = [];
+                  return;
+                }
+                for (const box of state.boxes) {
+                  try { box.remove(); } catch (_) {}
+                }
+                state.boxes = [];
+              };
+              ensureRoot();
+              state.enabled = !!(%s);
+              if (!state.root) {
+                return false;
+              }
+              state.root.style.display = state.enabled ? 'block' : 'none';
+              if (!state.enabled) {
+                clearBoxes();
+              }
+              return true;
+            } catch (_) {}
+            return false;
+          })())JS",
+      enabled ? "true" : "false");
+  EvaluateJS(js, base::BindOnce([](std::string, std::string) {}));
+}
+
+void RecorderController::ToggleGuidedScrapeOverlayAtPoint(
+    const gfx::Point& point) {
+  const std::string js = base::StringPrintf(
+      R"JS((function() {
+            try {
+              const key = '__dash_guided_selection_boxes__';
+              const state = window[key] || (window[key] = {
+                enabled: true,
+                root: null,
+                boxes: [],
+                nextToken: 0,
+              });
+              const ensureRoot = function() {
+                if (state.root && state.root.isConnected) {
+                  return;
+                }
+                const root = document.createElement('div');
+                root.id = '__dash_guided_selection_boxes_root__';
+                root.style.position = 'fixed';
+                root.style.inset = '0';
+                root.style.pointerEvents = 'none';
+                root.style.zIndex = '2147483646';
+                root.style.display = 'block';
+                document.documentElement.appendChild(root);
+                state.root = root;
+              };
+              const resolveElementAtPoint = function(x, y) {
+                let currentDoc = document;
+                let currentX = Number(x || 0);
+                let currentY = Number(y || 0);
+                let offsetLeft = 0;
+                let offsetTop = 0;
+                let target = currentDoc.elementFromPoint(currentX, currentY);
+                while (target &&
+                       ((target.tagName || '').toLowerCase() === 'iframe' ||
+                        (target.tagName || '').toLowerCase() === 'frame')) {
+                  let childDoc = null;
+                  try {
+                    childDoc = target.contentDocument ||
+                        (target.contentWindow ? target.contentWindow.document :
+                                                null);
+                  } catch (_) {
+                    childDoc = null;
+                  }
+                  if (!childDoc ||
+                      typeof childDoc.elementFromPoint !== 'function') {
+                    break;
+                  }
+                  const frameRect = target.getBoundingClientRect();
+                  offsetLeft += frameRect.left;
+                  offsetTop += frameRect.top;
+                  currentX -= frameRect.left;
+                  currentY -= frameRect.top;
+                  const childTarget = childDoc.elementFromPoint(currentX, currentY);
+                  if (!childTarget || childTarget === target) {
+                    break;
+                  }
+                  currentDoc = childDoc;
+                  target = childTarget;
+                }
+                return {target, offsetLeft, offsetTop};
+              };
+              const drawBox = function(target, offsetLeft, offsetTop) {
+                if (!state.root || !target || target.nodeType !== 1) {
+                  return false;
+                }
+                const rect = target.getBoundingClientRect();
+                if (!rect || rect.width < 2 || rect.height < 2) {
+                  return false;
+                }
+                let token = '';
+                try {
+                  token = String(
+                      target.getAttribute('data-dash-guided-select-token') || '');
+                } catch (_) {}
+                if (!token) {
+                  state.nextToken = Number(state.nextToken || 0) + 1;
+                  token = String(state.nextToken);
+                  try {
+                    target.setAttribute('data-dash-guided-select-token', token);
+                  } catch (_) {}
+                }
+                const existingIndex = state.boxes.findIndex(
+                    (entry) => entry && entry.token === token);
+                if (existingIndex >= 0) {
+                  try { state.boxes[existingIndex].node.remove(); } catch (_) {}
+                  state.boxes.splice(existingIndex, 1);
+                  return true;
+                }
+                const box = document.createElement('div');
+                box.style.position = 'fixed';
+                box.style.left =
+                    `${Math.max(0, Math.round(rect.left + Number(offsetLeft || 0)))}px`;
+                box.style.top =
+                    `${Math.max(0, Math.round(rect.top + Number(offsetTop || 0)))}px`;
+                box.style.width = `${Math.max(1, Math.round(rect.width))}px`;
+                box.style.height = `${Math.max(1, Math.round(rect.height))}px`;
+                box.style.border = '2px solid rgba(48,200,255,0.95)';
+                box.style.background = 'rgba(48,200,255,0.08)';
+                box.style.borderRadius = '4px';
+                box.style.boxSizing = 'border-box';
+                box.style.pointerEvents = 'none';
+                state.root.appendChild(box);
+                state.boxes.push({token, node: box});
+                return true;
+              };
+              ensureRoot();
+              state.enabled = true;
+              if (state.root) {
+                state.root.style.display = 'block';
+              }
+              const hit = resolveElementAtPoint(%d, %d);
+              return !!drawBox(hit && hit.target ? hit.target : null,
+                               hit ? hit.offsetLeft : 0,
+                               hit ? hit.offsetTop : 0);
+            } catch (_) {}
+            return false;
+          })())JS",
+      point.x(), point.y());
+  EvaluateJS(js, base::BindOnce([](std::string, std::string) {}));
+}
+
+void RecorderController::PopGuidedScrapeOverlaySelection() {
+  const std::string js = R"JS((function() {
+        try {
+          const state = window.__dash_guided_selection_boxes__;
+          if (!state || !Array.isArray(state.boxes) || !state.boxes.length) {
+            return {ok:true, remaining:0};
+          }
+          const entry = state.boxes[state.boxes.length - 1];
+          state.boxes.pop();
+          if (entry && entry.node) {
+            try { entry.node.remove(); } catch (_) {}
+          }
+          return {ok:true, remaining: state.boxes.length};
+        } catch (_) {}
+        return {ok:false};
+      })())JS";
+  EvaluateJS(js, base::BindOnce([](std::string, std::string) {}));
+}
