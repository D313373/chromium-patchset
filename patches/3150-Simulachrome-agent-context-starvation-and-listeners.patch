+
+void RecorderController::OnGuidedScrapeSelectionCaptureResult(
+    const gfx::Point& point,
+    base::Value::Dict result) {
+  gfx::Point overlay_point = point;
+  if (const std::optional<int> x = ReadIntLike(result, "x"),
+      y = ReadIntLike(result, "y");
+      x && y) {
+    overlay_point = gfx::Point(*x, *y);
+  }
+
+  base::Value::List locators =
+      SanitizeGuidedScrapeSelectionLocators(
+          result.FindList("locators") ? result.FindList("locators")->Clone()
+                                      : base::Value::List(),
+          /*allow_visual_fallback=*/false);
+  if (HasMeaningfulRecordedLocator(locators)) {
+    const std::string js = base::StringPrintf(
+        R"JS((function(){
+              try {
+                const fn =
+                    window.__dashResolveGuidedScrapeSelectionAtPointFallback;
+                if (typeof fn !== 'function') {
+                  return {locators: []};
+                }
+                return fn(%d, %d);
+              } catch (_) {
+                return {locators: []};
+              }
+            })())JS",
+        overlay_point.x(), overlay_point.y());
+    EvaluateJS(
+        js,
+        base::BindOnce(
+            &RecorderController::OnGuidedScrapeSelectionLocatorsResolved,
+            weak_factory_.GetWeakPtr(), overlay_point, std::move(locators)));
+    return;
+  }
+
+  OnGuidedScrapeSelectionPageMapCaptured(overlay_point, base::Value::Dict());
+}
+
+void RecorderController::OnGuidedScrapeSelectionPageMapCaptured(
+    const gfx::Point& point,
+    base::Value::Dict /*pagemap*/) {
+  base::Value::List locators =
+      SanitizeGuidedScrapeSelectionLocators(
+          BuildLocatorBundleForPoint(point),
+          /*allow_visual_fallback=*/false);
+  if (HasMeaningfulRecordedLocator(locators)) {
+    if (!ToggleGuidedScrapeSelectionLocators(std::move(locators)))
+      return;
+    ToggleGuidedScrapeOverlayAtPoint(point);
+    NotifyStateChanged();
+    return;
+  }
+
+  const std::string js = base::StringPrintf(
+      R"JS((function(){
+            try {
+              const fn =
+                  window.__dashResolveGuidedScrapeSelectionAtPointFallback;
+              if (typeof fn !== 'function') {
+                return {locators: []};
+              }
+              return fn(%d, %d);
+            } catch (_) {
+              return {locators: []};
+            }
+          })())JS",
+      point.x(), point.y());
+  EvaluateJS(
+      js,
+      base::BindOnce(
+          &RecorderController::OnGuidedScrapeSelectionLocatorsResolved,
+          weak_factory_.GetWeakPtr(), point, std::move(locators)));
+}
+
+void RecorderController::OnGuidedScrapeSelectionLocatorsResolved(
+    const gfx::Point& point,
+    base::Value::List fallback_locators,
+    std::string result_json,
+    std::string error_json) {
+  base::Value::List locators;
+  std::optional<base::Value::Dict> resolved_model;
+  gfx::Point overlay_point = point;
+  if (error_json.empty() || error_json == "{}") {
+    std::optional<base::Value> parsed = ExtractRuntimeValue(result_json);
+    if (parsed && parsed->is_dict()) {
+      const base::Value::Dict& resolved = parsed->GetDict();
+      if (const base::Value::Dict* model = resolved.FindDict("model")) {
+        resolved_model = model->Clone();
+      } else if (resolved.FindList("selections") ||
+                 resolved.FindList("rowLocators")) {
+        resolved_model = resolved.Clone();
+      }
+      if (const base::Value::List* selections = resolved.FindList("selections")) {
+        bool changed = false;
+        for (const base::Value& selection_value : *selections) {
+          const base::Value::Dict* selection = selection_value.GetIfDict();
+          const base::Value::List* raw_locators =
+              selection ? selection->FindList("locators") : nullptr;
+          if (!raw_locators) {
+            continue;
+          }
+          base::Value::List selection_locators =
+              SanitizeGuidedScrapeSelectionLocators(
+                  raw_locators->Clone(),
+                  /*allow_visual_fallback=*/false);
+          if (!HasMeaningfulRecordedLocator(selection_locators)) {
+            continue;
+          }
+          changed |= ToggleGuidedScrapeSelectionLocators(
+              std::move(selection_locators));
+        }
+        if (resolved_model.has_value()) {
+          std::string model_json;
+          if (base::JSONWriter::Write(base::Value(resolved_model->Clone()),
+                                      &model_json)) {
+            guided_scrape_selection_model_json_ = std::move(model_json);
+          }
+        }
+        if (changed) {
+          NotifyStateChanged();
+          return;
+        }
+      }
+      if (const base::Value::List* raw_locators = resolved.FindList("locators")) {
+        locators = SanitizeGuidedScrapeSelectionLocators(
+            raw_locators->Clone(),
+            /*allow_visual_fallback=*/false);
+      }
+      const base::Value::Dict* center = resolved.FindDict("center");
+      const std::optional<int> cx =
+          center ? center->FindInt("x") : std::nullopt;
+      const std::optional<int> cy =
+          center ? center->FindInt("y") : std::nullopt;
+      if (cx && cy) {
+        overlay_point = gfx::Point(*cx, *cy);
+      }
+    } else if (parsed && parsed->is_list()) {
+      locators = SanitizeGuidedScrapeSelectionLocators(
+          parsed->GetList().Clone(),
+          /*allow_visual_fallback=*/false);
+    }
+  }
+
+  if (locators.empty()) {
+    locators = std::move(fallback_locators);
+  }
+  if (locators.empty()) {
+    locators = SanitizeGuidedScrapeSelectionLocators(
+        BuildLocatorBundleForPoint(overlay_point),
+        /*allow_visual_fallback=*/true);
+  }
+  if (!HasMeaningfulRecordedLocator(locators)) {
+    locators.clear();
+    base::Value::Dict visual;
+    visual.Set("type", "VISUAL_COORDS");
+    visual.Set(
+        "value",
+        base::StringPrintf("{\"x\":%d,\"y\":%d}", overlay_point.x(),
+                           overlay_point.y()));
+    locators.Append(std::move(visual));
+  }
+  if (locators.empty()) {
+    LOG(INFO) << "[GuidedScrape] Ignoring selection with no stable locators at "
+              << point.x() << "," << point.y();
+    return;
+  }
+  if (!HasMeaningfulRecordedLocator(locators)) {
+    LOG(INFO) << "[GuidedScrape] Using VISUAL_COORDS fallback for selection at "
+              << overlay_point.x() << "," << overlay_point.y();
+  }
+  if (!ToggleGuidedScrapeSelectionLocators(std::move(locators)))
+    return;
+  guided_scrape_selection_model_json_.clear();
+  ToggleGuidedScrapeOverlayAtPoint(overlay_point);
+  NotifyStateChanged();
+}
