+import {
+  applySecretReplacementsToScript,
+  buildSecretMigrationPlan,
+  extractTokenReferencesFromScript,
+  scanScriptForExportRisks,
+} from './script_export_guard.js';
+
+function sanitizeFilename(name) {
+  const cleaned = String(name || 'script')
+      .trim()
+      .replace(/[^\w.-]+/g, '_')
+      .replace(/_+/g, '_')
+      .replace(/^_+|_+$/g, '');
+  return cleaned || 'script';
+}
+
+function stripInternalScriptFields(script) {
+  const clone = JSON.parse(JSON.stringify(script || {}));
+  delete clone.__localUnsavedChanges;
+  delete clone.__agent_next_insert_index;
+  return clone;
+}
+
+export function buildScriptExportPackage(script, scriptId, meta = {}) {
+  const cleanedScript = stripInternalScriptFields(script);
+  return {
+    format: 'simulachrome.script-package',
+    version: 1,
+    exportedAt: new Date().toISOString(),
+    scriptId: scriptId || null,
+    name: cleanedScript.name || 'script',
+    script: cleanedScript,
+    requiredTokens: extractTokenReferencesFromScript(cleanedScript),
+    exportRiskAcknowledged: !!meta.exportRiskAcknowledged,
+    secretsMigrated: !!meta.secretsMigrated,
+  };
+}
+
+export function downloadScriptPackage(pkg, filename) {
+  const safeName = sanitizeFilename(filename);
+  const blob = new Blob([JSON.stringify(pkg, null, 2)], {
+    type: 'application/json',
+  });
+  const url = URL.createObjectURL(blob);
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = safeName.endsWith('.json') ? safeName :
+      `${safeName}.simulachrome.json`;
+  anchor.click();
+  URL.revokeObjectURL(url);
+}
+
+function formatFindingReason(reason) {
+  switch (reason) {
+    case 'email':
+      return 'email address';
+    case 'phone_number':
+      return 'phone number';
+    case 'ssn':
+      return 'SSN';
+    case 'api_key':
+      return 'API key';
+    case 'high_entropy_secret':
+      return 'secret-like value';
+    case 'password_field_literal':
+      return 'password/credential field literal';
+    default:
+      return reason;
+  }
+}
+
+function escapeHtml(value) {
+  return String(value || '')
+      .replaceAll('&', '&amp;')
+      .replaceAll('<', '&lt;')
+      .replaceAll('>', '&gt;')
+      .replaceAll('"', '&quot;')
+      .replaceAll("'", '&#039;');
+}
+
+function renderMigrationRows(plan) {
+  return plan.map((entry, index) => {
+    const sampleFinding = entry.findings[0] || {};
+    const reasons = (sampleFinding.reasons || [])
+        .map((reason) => formatFindingReason(reason))
+        .join(', ');
+    const steps = entry.findings
+        .map((finding) => finding.path)
+        .slice(0, 2)
+        .join('; ');
+    const extra = entry.findings.length > 2 ?
+        ` (+${entry.findings.length - 2} more)` :
+        '';
+    return `
+      <tr>
+        <td>${escapeHtml(steps)}${escapeHtml(extra)}<div class="data-subtle">${escapeHtml(reasons)}</div></td>
+        <td><code>${escapeHtml(sampleFinding.textPreview || '…')}</code></td>
+        <td>
+          <input class="input-field export-secret-name" data-plan-index="${index}"
+                 value="${escapeHtml(entry.secretName)}" />
+          <div class="data-subtle">becomes <code>{${escapeHtml(entry.secretName)}}</code></div>
+        </td>
+      </tr>
+    `;
+  }).join('');
+}
+
+async function loadExistingSecretKeys(dashboardHandler) {
+  if (!dashboardHandler?.getDataSecrets) {
+    return [];
+  }
+  const res = await dashboardHandler.getDataSecrets();
+  return Array.isArray(res?.secrets) ?
+      res.secrets.map((entry) => String(entry?.key || '').trim()).filter(Boolean) :
+      [];
+}
+
+async function upsertSecrets(dashboardHandler, secretEntries) {
+  if (!dashboardHandler?.saveDataSecrets) {
+    throw new Error('Secrets API unavailable');
+  }
+  const existing = await dashboardHandler.getDataSecrets?.() ?? {secrets: []};
+  const keys = new Set(
+      (existing.secrets || []).map((entry) => String(entry?.key || '').trim())
+          .filter(Boolean));
+  const updates = [];
+  for (const entry of secretEntries) {
+    const key = String(entry?.key || '').trim();
+    const value = String(entry?.value ?? '');
+    if (!key || !value.trim()) {
+      continue;
+    }
+    keys.add(key);
+    updates.push({key, value});
+  }
+  if (!updates.length) {
+    return {ok: false, error: 'No secret values to save'};
+  }
+  return dashboardHandler.saveDataSecrets({
+    keys: Array.from(keys).sort((a, b) => a.localeCompare(b)),
+    updates,
+  });
+}
+
+function collectPlanFromModal(modal, plan) {
+  const rows = modal.querySelectorAll('.export-secret-name');
+  const used = new Set();
+  const out = [];
+  rows.forEach((input) => {
+    const index = Number(input.dataset.planIndex);
+    const entry = plan[index];
+    if (!entry) {
+      return;
+    }
+    let secretName = String(input.value || '').trim()
+        .replace(/[{}]/g, '')
+        .replace(/[^A-Za-z0-9_#.-]+/g, '');
+    if (!secretName) {
+      secretName = entry.secretName;
+    }
+    let candidate = secretName;
+    let suffix = 2;
+    while (used.has(candidate)) {
+      candidate = `${secretName}${suffix++}`;
+    }
+    used.add(candidate);
+    out.push({
+      secretName: candidate,
+      literal: entry.literal,
+      token: `{${candidate}}`,
+      actionPaths: entry.actionPaths,
+    });
+  });
+  return out;
+}
+
+function buildReplacementsFromPlan(plan) {
+  const replacements = [];
+  for (const entry of plan) {
+    for (const actionPath of entry.actionPaths || []) {
+      replacements.push({
+        actionPath,
+        secretName: entry.secretName,
+        literal: entry.literal,
+      });
+    }
+  }
+  return replacements;
+}
+
+export function promptScriptExport({
+  script,
+  scriptId,
+  dashboardHandler = null,
+  onScriptUpdated = null,
+  documentRef = document,
+  modalId = 'export-script-modal',
+}) {
+  const scan = scanScriptForExportRisks(script);
+  const defaultName = sanitizeFilename(script?.name || scriptId || 'script');
+
+  if (!scan.hasRisks) {
+    const pkg = buildScriptExportPackage(script, scriptId);
+    downloadScriptPackage(pkg, `${defaultName}.simulachrome.json`);
+    return Promise.resolve({ok: true, exported: true, acknowledged: false});
+  }
+
+  return new Promise((resolve) => {
+    let modal = documentRef.getElementById(modalId);
+    if (!modal) {
+      modal = documentRef.createElement('div');
+      modal.id = modalId;
+      modal.className = 'modal-overlay hidden';
+      documentRef.body.appendChild(modal);
+    }
+
+    let migrationPlan = [];
+
+    const renderModal = async () => {
+      const existingSecretKeys = await loadExistingSecretKeys(dashboardHandler);
+      migrationPlan = buildSecretMigrationPlan(scan.findings, existingSecretKeys);
+
+      modal.innerHTML = `
+        <div class="modal-content" style="max-width: 860px;">
+          <h3 class="modal-header">Sensitive data in export</h3>
+          <p>
+            We found type actions with values that look like PII or credentials.
+            Create local secrets and replace them with tokens before sharing.
+          </p>
+          <table class="data-table" style="width:100%; margin: 12px 0;">
+            <thead>
+              <tr>
+                <th>Step</th>
+                <th>Preview</th>
+                <th>Suggested secret</th>
+              </tr>
+            </thead>
+            <tbody>
+              ${renderMigrationRows(migrationPlan)}
+            </tbody>
+          </table>
+          <div class="modal-actions" style="margin-top: 16px; gap: 8px; flex-wrap: wrap;">
+            <button class="btn" id="export-risk-cancel">Cancel</button>
+            <button class="btn btn-primary" id="export-create-secrets">
+              Create secrets &amp; export safely
+            </button>
+          </div>
+          <details style="margin-top: 16px;">
+            <summary>Export with sensitive literals anyway</summary>
+            <div style="margin-top: 12px;">
+              <label style="display:flex; gap:8px; align-items:flex-start;">
+                <input type="checkbox" id="export-risk-ack" />
+                <span>OK, I understand I'm sharing this info. It's intentional.</span>
+              </label>
+              <div class="modal-actions" style="margin-top: 12px;">
+                <button class="btn btn-danger" id="export-risk-confirm" disabled>
+                  Export anyway
+                </button>
+              </div>
+            </div>
+          </details>
+          <div class="data-status" id="export-risk-status"></div>
+        </div>
+      `;
+
+      const ack = modal.querySelector('#export-risk-ack');
+      const confirmBtn = modal.querySelector('#export-risk-confirm');
+      const cancelBtn = modal.querySelector('#export-risk-cancel');
+      const createBtn = modal.querySelector('#export-create-secrets');
+      const statusEl = modal.querySelector('#export-risk-status');
+
+      ack?.addEventListener('change', () => {
+        if (confirmBtn) {
+          confirmBtn.disabled = !ack.checked;
+        }
+      });
+      cancelBtn?.addEventListener('click', () => {
+        cleanup({ok: false, exported: false, cancelled: true});
+      });
+      confirmBtn?.addEventListener('click', () => {
+        if (!ack?.checked) {
+          return;
+        }
+        const pkg = buildScriptExportPackage(script, scriptId, {
+          exportRiskAcknowledged: true,
+        });
+        downloadScriptPackage(pkg, `${defaultName}.simulachrome.json`);
+        cleanup({ok: true, exported: true, acknowledged: true});
+      });
+      createBtn?.addEventListener('click', async () => {
+        if (!dashboardHandler) {
+          statusEl.textContent = 'Secrets API unavailable.';
+          return;
+        }
+        createBtn.disabled = true;
+        statusEl.textContent = 'Creating secrets and preparing export...';
+        try {
+          const plan = collectPlanFromModal(modal, migrationPlan);
+          const secretEntries = plan.map((entry) => ({
+            key: entry.secretName,
+            value: entry.literal,
+          }));
+          const saveRes = await upsertSecrets(dashboardHandler, secretEntries);
+          if (!saveRes?.ok) {
+            statusEl.textContent = String(saveRes?.error || 'Failed to save secrets.');
+            createBtn.disabled = false;
+            return;
+          }
+
+          const replacements = buildReplacementsFromPlan(plan);
+          const migratedScript = applySecretReplacementsToScript(script, replacements);
+          if (typeof onScriptUpdated === 'function') {
+            await onScriptUpdated(migratedScript, replacements);
+          }
+
+          const pkg = buildScriptExportPackage(migratedScript, scriptId, {
+            secretsMigrated: true,
+          });
+          downloadScriptPackage(pkg, `${defaultName}.simulachrome.json`);
+          cleanup({
+            ok: true,
+            exported: true,
+            secretsMigrated: true,
+            replacements,
+          });
+        } catch (error) {
+          statusEl.textContent = `Export failed: ${error?.message || error}`;
+          createBtn.disabled = false;
+        }
+      });
+    };
+
+    const cleanup = (result) => {
+      modal.classList.add('hidden');
+      modal.innerHTML = '';
+      resolve(result);
+    };
+
+    renderModal().then(() => {
+      modal.classList.remove('hidden');
+    });
+  });
+}
