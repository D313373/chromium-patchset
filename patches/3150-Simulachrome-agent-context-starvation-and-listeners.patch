+import { renderWaitEditor } from './waitEditor';
+
+// We recommend installing an extension to run jasmine tests.
+
+describe('renderWaitEditor', () => {
+    let container;
+    let onChangeSpy;
+
+    beforeEach(() => {
+        container = document.createElement('div');
+        onChangeSpy = jasmine.createSpy('onChange');
+    });
+
+    it('does nothing if container is null', () => {
+        expect(() => renderWaitEditor(null, {}, onChangeSpy)).not.toThrow();
+    });
+
+    it('renders input with correct initial value from action.params', () => {
+        renderWaitEditor(container, { params: { seconds: 5 } }, onChangeSpy);
+        const input = container.querySelector('#wait-seconds');
+        expect(input).not.toBeNull();
+        expect(input.value).toBe('5');
+    });
+
+    it('renders input with empty value if params.seconds is not a number', () => {
+        renderWaitEditor(container, { params: { seconds: 'abc' } }, onChangeSpy);
+        const input = container.querySelector('#wait-seconds');
+        expect(input.value).toBe('');
+    });
+
+    it('renders input with empty value if action is undefined', () => {
+        renderWaitEditor(container, undefined, onChangeSpy);
+        const input = container.querySelector('#wait-seconds');
+        expect(input.value).toBe('');
+    });
+
+    it('calls onChange with updated params on input event', () => {
+        renderWaitEditor(container, { params: { seconds: 2 }, foo: 'bar' }, onChangeSpy);
+        const input = container.querySelector('#wait-seconds');
+        input.value = '7';
+        input.dispatchEvent(new Event('input', { bubbles: true }));
+        expect(onChangeSpy).toHaveBeenCalledWith(jasmine.objectContaining({
+            foo: 'bar',
+            params: { seconds: 7 }
+        }));
+    });
+
+    it('calls onChange with seconds=0 if input is not a number', () => {
+        renderWaitEditor(container, { params: { seconds: 2 } }, onChangeSpy);
+        const input = container.querySelector('#wait-seconds');
+        input.value = '';
+        input.dispatchEvent(new Event('input', { bubbles: true }));
+        expect(onChangeSpy).toHaveBeenCalledWith(jasmine.objectContaining({
+            params: { seconds: 0 }
+        }));
+    });
+
+    it('calls onChange on change event as well', () => {
+        renderWaitEditor(container, { params: { seconds: 2 } }, onChangeSpy);
+        const input = container.querySelector('#wait-seconds');
+        input.value = '3';
+        input.dispatchEvent(new Event('change', { bubbles: true }));
+        expect(onChangeSpy).toHaveBeenCalledWith(jasmine.objectContaining({
+            params: { seconds: 3 }
+        }));
+    });
+
+    it('does not throw if onChange is not a function', () => {
+        renderWaitEditor(container, { params: { seconds: 1 } }, null);
+        const input = container.querySelector('#wait-seconds');
+        input.value = '4';
+        expect(() => {
+            input.dispatchEvent(new Event('input', { bubbles: true }));
+        }).not.toThrow();
+    });
