--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/cdp/cdp_listen_action.cc
@@ -0,0 +1,420 @@
+#include "chrome/browser/ui/webui/dashboard/actions/cdp/cdp_listen_action.h"
+
+#include <optional>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard_automation_controller.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard_devtools_client.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/re2/src/re2/re2.h"
+#include "url/gurl.h"
+
+namespace {
+
+bool IsSupportedCdpCondition(std::string_view condition) {
+  const std::string lowered = base::ToLowerASCII(condition);
+  return lowered == "new_child" || lowered == "new_child_contains" ||
+         lowered == "child_count_increases";
+}
+
+bool ContainsCaseInsensitive(std::string_view haystack,
+                             std::string_view needle) {
+  return base::ToLowerASCII(haystack).find(base::ToLowerASCII(needle)) !=
+         std::string::npos;
+}
+
+void AppendHttpUrlsFromSource(const std::string& source,
+                              size_t max_urls,
+                              base::flat_set<std::string>* dedupe,
+                              std::vector<std::string>* out) {
+  if (source.empty() || !dedupe || !out) {
+    return;
+  }
+  if (max_urls == 0u || out->size() >= max_urls) {
+    return;
+  }
+  const std::string kTerminators = " \t\r\n\"'<>)]}";
+  size_t cursor = 0;
+  while (cursor < source.size() && out->size() < max_urls) {
+    size_t start_https = source.find("https://", cursor);
+    size_t start_http = source.find("http://", cursor);
+    size_t start = std::string::npos;
+    if (start_https == std::string::npos) {
+      start = start_http;
+    } else if (start_http == std::string::npos) {
+      start = start_https;
+    } else {
+      start = std::min(start_https, start_http);
+    }
+    if (start == std::string::npos) {
+      break;
+    }
+    size_t end = source.find_first_of(kTerminators, start);
+    if (end == std::string::npos) {
+      end = source.size();
+    }
+    std::string candidate = source.substr(start, end - start);
+    while (!candidate.empty() &&
+           (candidate.back() == '.' || candidate.back() == ',' ||
+            candidate.back() == ';' || candidate.back() == ':' ||
+            candidate.back() == '!')) {
+      candidate.pop_back();
+    }
+    const GURL url(candidate);
+    if (url.is_valid() && url.SchemeIsHTTPOrHTTPS()) {
+      const std::string normalized = url.spec();
+      if (!normalized.empty() && !dedupe->contains(normalized)) {
+        dedupe->insert(normalized);
+        out->push_back(normalized);
+      }
+    }
+    cursor = start + 1;
+  }
+}
+
+std::vector<std::string> ExtractUrlsFromNode(const base::Value::Dict& node) {
+  constexpr size_t kMaxUrls = 12u;
+  base::flat_set<std::string> dedupe;
+  std::vector<std::string> urls;
+  if (const std::string* node_value = node.FindString("nodeValue")) {
+    AppendHttpUrlsFromSource(*node_value, kMaxUrls, &dedupe, &urls);
+  }
+  if (const base::Value::List* attrs = node.FindList("attributes")) {
+    for (const auto& value : *attrs) {
+      if (!value.is_string()) {
+        continue;
+      }
+      AppendHttpUrlsFromSource(value.GetString(), kMaxUrls, &dedupe, &urls);
+      if (urls.size() >= kMaxUrls) {
+        break;
+      }
+    }
+  }
+  return urls;
+}
+
+std::string BuildNodeHaystack(const base::Value::Dict& node) {
+  std::string haystack;
+  auto append_piece = [&haystack](const std::string* value) {
+    if (!value || value->empty()) {
+      return;
+    }
+    if (!haystack.empty()) {
+      haystack.push_back(' ');
+    }
+    haystack.append(*value);
+  };
+  append_piece(node.FindString("nodeName"));
+  append_piece(node.FindString("localName"));
+  append_piece(node.FindString("nodeValue"));
+  if (const base::Value::List* attrs = node.FindList("attributes")) {
+    for (const auto& value : *attrs) {
+      if (!value.is_string()) {
+        continue;
+      }
+      const std::string& text = value.GetString();
+      if (text.empty()) {
+        continue;
+      }
+      if (!haystack.empty()) {
+        haystack.push_back(' ');
+      }
+      haystack.append(text);
+    }
+  }
+  return haystack;
+}
+
+}  // namespace
+
+CdpListenAction::CdpListenAction(Profile* profile) : ListenAction(profile) {}
+
+CdpListenAction::~CdpListenAction() {
+  CleanupCdpState();
+}
+
+bool CdpListenAction::SetParams(const base::Value::Dict& params) {
+  if (!ListenAction::SetParams(params)) {
+    return false;
+  }
+
+  const base::Value::List* locators_list = params.FindList("locators");
+  locators_.clear();
+  if (locators_list) {
+    locators_ = dashboard::ConvertLocators(*locators_list);
+  }
+
+  condition_ = params.FindString("condition") ? *params.FindString("condition")
+                                              : std::string("visible");
+  text_ =
+      params.FindString("text") ? *params.FindString("text") : std::string();
+  text_use_regex_ = params.FindBool("textUseRegex").value_or(false);
+  timeout_ms_ = params.FindInt("timeout_ms").value_or(60000);
+  if (timeout_ms_ <= 0) {
+    timeout_ms_ = 60000;
+  }
+
+  scope_css_selector_.clear();
+  for (const auto& locator : locators_) {
+    if (locator.type == dashboard::LocatorType::CSS_SELECTOR &&
+        !locator.value.empty()) {
+      scope_css_selector_ = locator.value;
+      break;
+    }
+  }
+  return true;
+}
+
+void CdpListenAction::Execute(content::WebContents* web_contents,
+                              Callback callback) {
+  CleanupCdpState();
+
+  if (!web_contents) {
+    std::move(callback).Run(false, "No web contents");
+    return;
+  }
+
+  if (!IsSupportedCdpCondition(condition_) || scope_css_selector_.empty()) {
+    FailCdpListen(std::move(callback),
+                  "condition/scope unsupported for CDP stream");
+    return;
+  }
+
+  dashboard::DashboardDevToolsClient* client =
+      GetOrCreateDashboardDevToolsClientForTab(web_contents);
+  if (!client) {
+    FailCdpListen(std::move(callback), "DevTools client unavailable");
+    return;
+  }
+
+  active_web_contents_ = web_contents;
+  active_client_ = client;
+
+  base::Value::Dict params;
+  params.Set("includeWhitespace", "none");
+  client->SendCommand("DOM.enable", std::move(params),
+                      base::BindOnce(&CdpListenAction::OnDomDomainEnabled,
+                                     weak_ptr_factory_.GetWeakPtr(),
+                                     web_contents, std::move(callback)));
+}
+
+void CdpListenAction::FailCdpListen(Callback callback,
+                                    const std::string& reason) {
+  CleanupCdpState();
+  LOG(WARNING) << "[CdpListenAction] CDP listen failed: " << reason;
+  std::move(callback).Run(false, reason);
+}
+
+void CdpListenAction::OnDomDomainEnabled(content::WebContents* web_contents,
+                                         Callback callback,
+                                         bool success,
+                                         const std::string& error) {
+  if (!success || !active_client_) {
+    FailCdpListen(std::move(callback),
+                  success ? "DevTools client unavailable after DOM.enable"
+                          : "DOM.enable failed: " + error);
+    return;
+  }
+
+  base::Value::Dict params;
+  params.Set("depth", 1);
+  params.Set("pierce", true);
+  active_client_->SendCommandForResult(
+      "DOM.getDocument", std::move(params),
+      base::BindOnce(&CdpListenAction::OnDocumentFetched,
+                     weak_ptr_factory_.GetWeakPtr(), web_contents,
+                     std::move(callback)));
+}
+
+void CdpListenAction::OnDocumentFetched(content::WebContents* web_contents,
+                                        Callback callback,
+                                        bool success,
+                                        const std::string& error,
+                                        base::Value::Dict result) {
+  if (!success || !active_client_) {
+    FailCdpListen(std::move(callback),
+                  success
+                      ? "DevTools client unavailable after getDocument"
+                      : "DOM.getDocument failed: " + error);
+    return;
+  }
+
+  const base::Value::Dict* root = result.FindDict("root");
+  if (!root) {
+    FailCdpListen(std::move(callback), "DOM.getDocument missing root");
+    return;
+  }
+  const std::optional<int> root_node_id = root->FindInt("nodeId");
+  if (!root_node_id) {
+    FailCdpListen(std::move(callback), "DOM.getDocument missing root nodeId");
+    return;
+  }
+
+  base::Value::Dict params;
+  params.Set("nodeId", *root_node_id);
+  params.Set("selector", scope_css_selector_);
+  active_client_->SendCommandForResult(
+      "DOM.querySelectorAll", std::move(params),
+      base::BindOnce(&CdpListenAction::OnScopeNodesResolved,
+                     weak_ptr_factory_.GetWeakPtr(), web_contents,
+                     std::move(callback)));
+}
+
+void CdpListenAction::OnScopeNodesResolved(content::WebContents* web_contents,
+                                           Callback callback,
+                                           bool success,
+                                           const std::string& error,
+                                           base::Value::Dict result) {
+  if (!success || !active_client_) {
+    FailCdpListen(std::move(callback),
+                  success ? "DevTools client unavailable after querySelectorAll"
+                          : "DOM.querySelectorAll failed: " + error);
+    return;
+  }
+
+  const base::Value::List* node_ids = result.FindList("nodeIds");
+  if (!node_ids || node_ids->empty()) {
+    FailCdpListen(std::move(callback),
+                  "CDP scope locator resolved no nodes");
+    return;
+  }
+
+  watched_parent_node_ids_.clear();
+  for (const auto& value : *node_ids) {
+    if (!value.is_int()) {
+      continue;
+    }
+    watched_parent_node_ids_.insert(value.GetInt());
+  }
+  if (watched_parent_node_ids_.empty()) {
+    FailCdpListen(std::move(callback),
+                  "CDP scope locator had no integer nodeIds");
+    return;
+  }
+
+  pending_callback_ = std::move(callback);
+  event_observer_id_ = active_client_->AddEventObserver(base::BindRepeating(
+      &CdpListenAction::OnDomEvent, weak_ptr_factory_.GetWeakPtr()));
+  if (event_observer_id_ == 0) {
+    Callback cb = std::move(pending_callback_);
+    FailCdpListen(std::move(cb), "Failed to register CDP event observer");
+    return;
+  }
+
+  timeout_timer_.Start(FROM_HERE, base::Milliseconds(timeout_ms_),
+                       base::BindOnce(&CdpListenAction::OnTimeout,
+                                      weak_ptr_factory_.GetWeakPtr()));
+}
+
+void CdpListenAction::OnDomEvent(const std::string& method,
+                                 const base::Value::Dict& params) {
+  if (!pending_callback_) {
+    return;
+  }
+  if (method != "DOM.childNodeInserted") {
+    return;
+  }
+
+  const std::optional<int> parent_node_id = params.FindInt("parentNodeId");
+  if (!parent_node_id || !watched_parent_node_ids_.contains(*parent_node_id)) {
+    return;
+  }
+
+  const base::Value::Dict* node = params.FindDict("node");
+  if (!node) {
+    return;
+  }
+
+  const std::string condition_lower = base::ToLowerASCII(condition_);
+  std::string haystack = BuildNodeHaystack(*node);
+  bool satisfied = condition_lower == "new_child" ||
+                   condition_lower == "child_count_increases";
+  std::string match_value;
+  if (condition_lower == "new_child_contains") {
+    if (text_.empty()) {
+      return;
+    }
+    if (text_use_regex_) {
+      RE2 re(text_);
+      if (!re.ok()) {
+        return;
+      }
+      re2::StringPiece match_piece;
+      if (!re2::RE2::PartialMatch(haystack, re, &match_piece)) {
+        return;
+      }
+      satisfied = true;
+      match_value = std::string(match_piece.data(), match_piece.size());
+    } else {
+      satisfied = ContainsCaseInsensitive(haystack, text_);
+      if (satisfied) {
+        match_value = text_;
+      }
+    }
+  }
+
+  if (!satisfied) {
+    return;
+  }
+
+  base::Value::Dict payload;
+  payload.Set("ok", true);
+  payload.Set("satisfied", true);
+  payload.Set("path", "cdp_event_stream");
+  payload.Set("condition", condition_lower);
+  payload.Set("parentNodeId", *parent_node_id);
+  if (!haystack.empty()) {
+    payload.Set("text", haystack.substr(0, 512));
+  }
+
+  std::vector<std::string> match_urls = ExtractUrlsFromNode(*node);
+  if (!match_urls.empty()) {
+    base::Value::List url_list;
+    for (const auto& url : match_urls) {
+      url_list.Append(url);
+    }
+    payload.Set("matchUrls", std::move(url_list));
+    payload.Set("matchValue", match_urls.front());
+  } else if (!match_value.empty()) {
+    payload.Set("matchValue", match_value);
+  }
+
+  CompleteCdpMatch(std::move(payload));
+}
+
+void CdpListenAction::OnTimeout() {
+  if (!pending_callback_) {
+    return;
+  }
+  Callback callback = std::move(pending_callback_);
+  CleanupCdpState();
+  std::move(callback).Run(false, "cdp_listen timed out");
+}
+
+void CdpListenAction::CompleteCdpMatch(base::Value::Dict payload) {
+  if (!pending_callback_) {
+    return;
+  }
+  std::string serialized;
+  if (!base::JSONWriter::Write(payload, &serialized)) {
+    serialized = "path=cdp_event_stream";
+  }
+  Callback callback = std::move(pending_callback_);
+  CleanupCdpState();
+  std::move(callback).Run(true, serialized);
+}
+
+void CdpListenAction::CleanupCdpState() {
+  timeout_timer_.Stop();
+  if (active_client_ && event_observer_id_ != 0) {
+    active_client_->RemoveEventObserver(event_observer_id_);
+  }
+  event_observer_id_ = 0;
+  watched_parent_node_ids_.clear();
+  active_web_contents_ = nullptr;
+  active_client_ = nullptr;
+  pending_callback_.Reset();
+}
