+
+void KeyPressAction::PressKeyNativeAsync(content::WebContents* web_contents,
+                                         content::RenderWidgetHost* rwh,
+                                         content::RenderWidgetHostView* rwhv,
+                                         const KeySpec& spec,
+                                         int press_index,
+                                         Callback callback) {
+  if (!web_contents || !rwh || !rwhv || !rwhv->GetNativeView()) {
+    std::move(callback).Run(false, "Lost native input target during key press");
+    return;
+  }
+
+  SendNativeKeyEvent(rwh, rwhv, spec, blink::WebInputEvent::Type::kRawKeyDown);
+  if (spec.send_char_event && spec.text_char != 0) {
+    SendNativeKeyEvent(rwh, rwhv, spec, blink::WebInputEvent::Type::kChar,
+                       spec.text_char);
+  }
+  SendNativeKeyEvent(rwh, rwhv, spec, blink::WebInputEvent::Type::kKeyUp);
+  if (press_index + 1 < count_) {
+    const int delay_ms = base::RandInt(60, 110);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&KeyPressAction::PressKeyNativeAsync,
+                       weak_ptr_factory_.GetWeakPtr(), web_contents, rwh, rwhv,
+                       spec, press_index + 1, std::move(callback)),
+        base::Milliseconds(delay_ms));
+    return;
+  }
+
+  std::move(callback).Run(true, "path=native_key_press");
+}
+
+void KeyPressAction::PressKeyCdpAsync(content::WebContents* web_contents,
+                                      dashboard::DashboardDevToolsClient* client,
+                                      const KeySpec& spec,
+                                      int press_index,
+                                      Callback callback) {
+  if (!web_contents || !client) {
+    std::move(callback).Run(false, "CDP client unavailable");
+    return;
+  }
+
+  base::Value::Dict down;
+  down.Set("type", spec.send_char_event ? "keyDown" : "rawKeyDown");
+  down.Set("key", spec.key);
+  down.Set("code", spec.code);
+  down.Set("windowsVirtualKeyCode", spec.key_code);
+  down.Set("nativeVirtualKeyCode", spec.key_code);
+  if (spec.send_char_event && spec.text_char != 0) {
+    const std::string text(1, spec.text_char);
+    down.Set("text", text);
+    down.Set("unmodifiedText", text);
+  }
+  client->SendCommand(
+      "Input.dispatchKeyEvent", std::move(down),
+      base::BindOnce(&KeyPressAction::OnCdpKeyDownComplete,
+                     weak_ptr_factory_.GetWeakPtr(), web_contents, client, spec,
+                     press_index, std::move(callback)));
+}
+
+void KeyPressAction::OnCdpKeyDownComplete(
+    content::WebContents* web_contents,
+    dashboard::DashboardDevToolsClient* client,
+    const KeySpec& spec,
+    int press_index,
+    Callback callback,
+    bool success,
+    const std::string& error) {
+  if (!success) {
+    std::move(callback).Run(false, "CDP keyDown failed: " + error);
+    return;
+  }
+  base::Value::Dict up;
+  up.Set("type", "keyUp");
+  up.Set("key", spec.key);
+  up.Set("code", spec.code);
+  up.Set("windowsVirtualKeyCode", spec.key_code);
+  up.Set("nativeVirtualKeyCode", spec.key_code);
+  client->SendCommand(
+      "Input.dispatchKeyEvent", std::move(up),
+      base::BindOnce(&KeyPressAction::OnCdpKeyUpComplete,
+                     weak_ptr_factory_.GetWeakPtr(), web_contents, client, spec,
+                     press_index, std::move(callback)));
+}
+
+void KeyPressAction::OnCdpKeyUpComplete(
+    content::WebContents* web_contents,
+    dashboard::DashboardDevToolsClient* client,
+    const KeySpec& spec,
+    int press_index,
+    Callback callback,
+    bool success,
+    const std::string& error) {
+  if (!success) {
+    std::move(callback).Run(false, "CDP keyUp failed: " + error);
+    return;
+  }
+
+  if (press_index + 1 < count_) {
+    const int delay_ms = base::RandInt(60, 110);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&KeyPressAction::PressKeyCdpAsync,
+                       weak_ptr_factory_.GetWeakPtr(), web_contents, client,
+                       spec, press_index + 1, std::move(callback)),
+        base::Milliseconds(delay_ms));
+    return;
+  }
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[KeyPressAction] Executed key press via CDP key=" << key_
+              << " count=" << count_;
+  }
+  std::move(callback).Run(true, "path=cdp_key_press");
+}
