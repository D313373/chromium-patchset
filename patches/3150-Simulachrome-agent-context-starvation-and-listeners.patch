new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/listener_watch_controller.cc
@@ -0,0 +1,130 @@
+#include "chrome/browser/ui/webui/dashboard/listener_watch_controller.h"
+
+#include "base/containers/flat_map.h"
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/service_manager/public/cpp/interface_provider.h"
+
+namespace dashboard {
+
+namespace {
+
+BASE_FEATURE(kDashboardListenerWatch,
+             "DashboardListenerWatch",
+             base::FEATURE_ENABLED_BY_DEFAULT);
+
+constexpr base::TimeDelta kNotifyDebounce = base::Milliseconds(75);
+
+}  // namespace
+
+ListenerWatchController::ListenerWatchController(
+    content::WebContents* web_contents)
+    : content::WebContentsUserData<ListenerWatchController>(*web_contents),
+      content::WebContentsObserver(web_contents) {}
+
+ListenerWatchController::~ListenerWatchController() = default;
+
+// static
+uint64_t ListenerWatchController::Register(content::WebContents* web_contents,
+                                           ChangeCallback callback) {
+  if (!web_contents || !callback || !base::FeatureList::IsEnabled(kDashboardListenerWatch)) {
+    return 0;
+  }
+  auto* controller = ListenerWatchController::FromWebContents(web_contents);
+  if (!controller) {
+    ListenerWatchController::CreateForWebContents(web_contents);
+    controller = ListenerWatchController::FromWebContents(web_contents);
+  }
+  if (!controller) {
+    return 0;
+  }
+  const uint64_t id = controller->next_registration_id_++;
+  controller->callbacks_[id] = std::move(callback);
+  controller->EnsureBlinkObserver();
+  return id;
+}
+
+// static
+void ListenerWatchController::Unregister(content::WebContents* web_contents,
+                                           uint64_t registration_id) {
+  if (!web_contents || registration_id == 0) {
+    return;
+  }
+  auto* controller = ListenerWatchController::FromWebContents(web_contents);
+  if (!controller) {
+    return;
+  }
+  controller->callbacks_.erase(registration_id);
+  if (controller->callbacks_.empty()) {
+    controller->dom_observer_.reset();
+    controller->blink_observer_bound_ = false;
+  }
+}
+
+void ListenerWatchController::EnsureBlinkObserver() {
+  if (blink_observer_bound_ || callbacks_.empty()) {
+    return;
+  }
+  content::RenderFrameHost* rfh = web_contents()->GetPrimaryMainFrame();
+  if (!rfh || !rfh->IsRenderFrameLive()) {
+    return;
+  }
+
+  mojo::Remote<blink::mojom::ListenerWatchRegistry> registry;
+  rfh->GetRemoteInterfaces()->GetInterface(
+      registry.BindNewPipeAndPassReceiver());
+  if (!registry) {
+    return;
+  }
+
+  dom_observer_.reset();
+  mojo::PendingRemote<blink::mojom::ListenerDomChangeObserver> remote;
+  dom_observer_.Bind(remote.InitWithNewPipeAndPassReceiver());
+  registry->AddDomChangeObserver(std::move(remote));
+  blink_observer_bound_ = true;
+}
+
+void ListenerWatchController::OnDomChanged() {
+  ScheduleNotify("blink_dom");
+}
+
+void ListenerWatchController::PrimaryPageChanged(content::Page& page) {
+  blink_observer_bound_ = false;
+  EnsureBlinkObserver();
+  ScheduleNotify("primary_page");
+}
+
+void ListenerWatchController::DidStopLoading() {
+  ScheduleNotify("stop_loading");
+}
+
+void ListenerWatchController::ScheduleNotify(const char* /*reason*/) {
+  if (notify_pending_) {
+    return;
+  }
+  notify_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ListenerWatchController::NotifyChange,
+                     weak_ptr_factory_.GetWeakPtr()),
+      kNotifyDebounce);
+}
+
+void ListenerWatchController::NotifyChange() {
+  notify_pending_ = false;
+  for (const auto& [id, callback] : callbacks_) {
+    if (!callback.is_null()) {
+      callback.Run();
+    }
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ListenerWatchController);
+
+}  // namespace dashboard
