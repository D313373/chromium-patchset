+
+std::vector<NativePageMapCandidate> ExtractPageMapCandidates(
+    const base::Value::Dict& page_map,
+    int max_candidates) {
+  std::vector<NativePageMapCandidate> out;
+  const base::Value::List* frames = page_map.FindList("frames");
+  if (!frames) {
+    return out;
+  }
+  for (const auto& frame_value : *frames) {
+    if (max_candidates > 0 &&
+        static_cast<int>(out.size()) >= max_candidates) {
+      break;
+    }
+    const base::Value::Dict* frame = frame_value.GetIfDict();
+    if (!frame) {
+      continue;
+    }
+    const std::string frame_id =
+        frame->FindString("frameId") ? *frame->FindString("frameId")
+                                      : std::string();
+    AppendCandidatesFromElementList(frame->FindList("elements"), frame_id,
+                                    max_candidates, &out);
+    if (const base::Value::List* shadow_roots = frame->FindList("shadowRoots")) {
+      for (const auto& shadow_value : *shadow_roots) {
+        if (max_candidates > 0 &&
+            static_cast<int>(out.size()) >= max_candidates) {
+          break;
+        }
+        const base::Value::Dict* shadow = shadow_value.GetIfDict();
+        if (!shadow) {
+          continue;
+        }
+        AppendCandidatesFromElementList(shadow->FindList("elements"), frame_id,
+                                        max_candidates, &out);
+      }
+    }
+  }
+  return out;
+}
+
+std::vector<NativePageMapCandidate> FindMatchingPageMapCandidates(
+    const base::Value::Dict& page_map,
+    const std::vector<Locator>& locators,
+    const PageMapMatchOptions& options,
+    int max_candidates) {
+  std::vector<NativePageMapCandidate> candidates =
+      ExtractPageMapCandidates(page_map, /*max_candidates=*/0);
+  const PageMapMatchOptions merged_options = MergeMatchOptions(locators, options);
+  const std::vector<size_t> filtered_indices =
+      ApplyWaterfallFilters(candidates, locators, merged_options);
+
+  std::vector<std::pair<int, NativePageMapCandidate>> ranked;
+  ranked.reserve(filtered_indices.size());
+  for (size_t index : filtered_indices) {
+    if (index >= candidates.size()) {
+      continue;
+    }
+    NativePageMapCandidate& candidate = candidates[index];
+    const int score = ScoreCandidate(candidate, locators);
+    if (score < 0) {
+      continue;
+    }
+    ranked.emplace_back(score, std::move(candidate));
+  }
+  std::sort(ranked.begin(), ranked.end(),
+            [](const auto& a, const auto& b) {
+              return std::tie(std::get<0>(a), std::get<1>(a).visible,
+                              std::get<1>(a).clickable,
+                              std::get<1>(a).focusable) >
+                     std::tie(std::get<0>(b), std::get<1>(b).visible,
+                              std::get<1>(b).clickable,
+                              std::get<1>(b).focusable);
+            });
+  std::vector<NativePageMapCandidate> out;
+  for (auto& entry : ranked) {
+    if (max_candidates > 0 &&
+        static_cast<int>(out.size()) >= max_candidates) {
+      break;
+    }
+    out.push_back(std::move(entry.second));
+  }
+  return out;
+}
+
+std::vector<NativePageMapCandidate> FindMatchingPageMapCandidates(
+    const base::Value::Dict& page_map,
+    const std::vector<Locator>& locators,
+    int max_candidates) {
+  return FindMatchingPageMapCandidates(page_map, locators, PageMapMatchOptions(),
+                                       max_candidates);
+}
+
+std::optional<NativePageMapCandidate> FindBestMatchingPageMapCandidate(
+    const base::Value::Dict& page_map,
+    const std::vector<Locator>& locators,
+    const PageMapMatchOptions& options) {
+  std::vector<NativePageMapCandidate> candidates =
+      FindMatchingPageMapCandidates(page_map, locators, options,
+                                    /*max_candidates=*/1);
+  if (candidates.empty()) {
+    return std::nullopt;
+  }
+  return std::move(candidates.front());
+}
+
+std::optional<NativePageMapCandidate> FindBestMatchingPageMapCandidate(
+    const base::Value::Dict& page_map,
+    const std::vector<Locator>& locators) {
+  return FindBestMatchingPageMapCandidate(page_map, locators,
+                                          PageMapMatchOptions());
+}
+
