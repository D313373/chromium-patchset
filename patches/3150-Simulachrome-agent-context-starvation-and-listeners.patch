+  int key_code = 0;
+  bool send_char = false;
+  char char_payload = c;
+
+  if (c == '\n' || c == '\r') {
+    key_code = ui::VKEY_RETURN;
+  } else if (c == '\t') {
+    key_code = ui::VKEY_TAB;
+  } else if (c == '\b') {
+    key_code = ui::VKEY_BACK;
+  } else {
+    const unsigned char uc = static_cast<unsigned char>(c);
+    if (std::isalpha(uc)) {
+      const char upper = static_cast<char>(std::toupper(uc));
+      key_code = static_cast<int>(ui::VKEY_A + (upper - 'A'));
+    } else if (std::isdigit(uc)) {
+      key_code = static_cast<int>(ui::VKEY_0 + (c - '0'));
+    } else {
+      key_code = static_cast<int>(uc);
+    }
+    send_char = (uc >= 32 && uc != 127);
+  }
+
+  auto forward = [&](blink::WebInputEvent::Type type, char ch = 0) {
+    blink::WebKeyboardEvent event(type, blink::WebInputEvent::kNoModifiers,
+                                  base::TimeTicks::Now());
+    event.windows_key_code = key_code;
+    event.native_key_code = key_code;
+    if (type == blink::WebInputEvent::Type::kChar && ch != 0) {
+      event.text[0] = ch;
+      event.unmodified_text[0] = ch;
+    }
+    input::NativeWebKeyboardEvent native_event(event, rwhv->GetNativeView());
+    rwh->ForwardKeyboardEvent(native_event);
+  };
+
+  forward(blink::WebInputEvent::Type::kRawKeyDown);
+  if (send_char) {
+    forward(blink::WebInputEvent::Type::kChar, char_payload);
+  }
+  forward(blink::WebInputEvent::Type::kKeyUp);
+  return true;
+}
