+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_CDP_CDP_LISTEN_ACTION_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_CDP_CDP_LISTEN_ACTION_H_
+
+#include <string>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/webui/dashboard/actions/action_types.h"
+#include "chrome/browser/ui/webui/dashboard/actions/listen_action.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace dashboard {
+class DashboardDevToolsClient;
+}
+
+class CdpListenAction : public ListenAction {
+ public:
+  explicit CdpListenAction(Profile* profile);
+  ~CdpListenAction() override;
+
+  CdpListenAction(const CdpListenAction&) = delete;
+  CdpListenAction& operator=(const CdpListenAction&) = delete;
+
+  bool SetParams(const base::Value::Dict& params) override;
+  void Execute(content::WebContents* web_contents, Callback callback) override;
+
+ private:
+  void FailCdpListen(Callback callback, const std::string& reason);
+  void OnDomDomainEnabled(content::WebContents* web_contents,
+                          Callback callback,
+                          bool success,
+                          const std::string& error);
+  void OnDocumentFetched(content::WebContents* web_contents,
+                         Callback callback,
+                         bool success,
+                         const std::string& error,
+                         base::Value::Dict result);
+  void OnScopeNodesResolved(content::WebContents* web_contents,
+                            Callback callback,
+                            bool success,
+                            const std::string& error,
+                            base::Value::Dict result);
+  void OnDomEvent(const std::string& method, const base::Value::Dict& params);
+  void OnTimeout();
+  void CompleteCdpMatch(base::Value::Dict payload);
+  void CleanupCdpState();
+
+  std::vector<dashboard::Locator> locators_;
+  std::string condition_;
+  std::string text_;
+  bool text_use_regex_ = false;
+  int timeout_ms_ = 60000;
+  std::string scope_css_selector_;
+
+  raw_ptr<content::WebContents> active_web_contents_ = nullptr;
+  raw_ptr<dashboard::DashboardDevToolsClient> active_client_ = nullptr;
+  int event_observer_id_ = 0;
+  base::flat_set<int> watched_parent_node_ids_;
+  Callback pending_callback_;
+  base::OneShotTimer timeout_timer_;
+
+  base::WeakPtrFactory<CdpListenAction> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_CDP_CDP_LISTEN_ACTION_H_
diff --git a/chrome/browser/ui/webui/dashboard/actions/cdp/cdp_navigate_action.cc b/chrome/browser/ui/webui/dashboard/actions/cdp/cdp_navigate_action.cc
