+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_LISTENER_WATCH_CONTROLLER_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_LISTENER_WATCH_CONTROLLER_H_
+
+#include <cstdint>
+
+#include "base/containers/flat_map.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "third_party/blink/public/mojom/content_extraction/listener_watch.mojom.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace dashboard {
+
+// Bridges Blink-internal DOM mutation notifications (no page JS injection) and
+// coarse WebContents lifecycle signals to native listen re-match callbacks.
+class ListenerWatchController
+    : public content::WebContentsUserData<ListenerWatchController>,
+      public content::WebContentsObserver,
+      public blink::mojom::ListenerDomChangeObserver {
+ public:
+  using ChangeCallback = base::RepeatingClosure;
+
+  ~ListenerWatchController() override;
+
+  ListenerWatchController(const ListenerWatchController&) = delete;
+  ListenerWatchController& operator=(const ListenerWatchController&) = delete;
+
+  static uint64_t Register(content::WebContents* web_contents,
+                           ChangeCallback callback);
+  static void Unregister(content::WebContents* web_contents,
+                         uint64_t registration_id);
+
+ private:
+  friend class content::WebContentsUserData<ListenerWatchController>;
+  explicit ListenerWatchController(content::WebContents* web_contents);
+
+  void EnsureBlinkObserver();
+  void NotifyChange();
+  void ScheduleNotify(const char* reason);
+
+  // blink::mojom::ListenerDomChangeObserver:
+  void OnDomChanged() override;
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+  void DidStopLoading() override;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+
+  uint64_t next_registration_id_ = 1;
+  base::flat_map<uint64_t, ChangeCallback> callbacks_;
+  mojo::Receiver<blink::mojom::ListenerDomChangeObserver> dom_observer_{this};
+  bool blink_observer_bound_ = false;
+  bool notify_pending_ = false;
+  base::WeakPtrFactory<ListenerWatchController> weak_ptr_factory_{this};
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_LISTENER_WATCH_CONTROLLER_H_
