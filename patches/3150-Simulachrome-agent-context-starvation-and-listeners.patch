+    const std::string* text = part ? part->FindString("text") : nullptr;
+    if (!text || text->empty()) {
+      continue;
+    }
+    if (!combined.empty()) {
+      combined.push_back('\n');
+    }
+    combined.append(*text);
+  }
+  return combined;
+}
