diff --git a/chrome/browser/ui/webui/dashboard/actions/drag_action.cc b/chrome/browser/ui/webui/dashboard/actions/drag_action.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/drag_action.cc
@@ -0,0 +1,260 @@
+#include "chrome/browser/ui/webui/dashboard/actions/drag_action.h"
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+#include "base/logging.h"
+#include "chrome/browser/ui/webui/dashboard/click_handler.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+std::optional<std::pair<int, int>> ReadXYPair(const base::Value::Dict& params,
+                                              const char* dict_key_a,
+                                              const char* dict_key_b,
+                                              const char* x_key,
+                                              const char* y_key) {
+  const base::Value::Dict* dict = params.FindDict(dict_key_a);
+  if (!dict && dict_key_b) {
+    dict = params.FindDict(dict_key_b);
+  }
+  std::optional<int> x;
+  std::optional<int> y;
+  if (dict) {
+    if (auto v = dict->FindInt("x")) {
+      x = *v;
+    } else if (auto dv = dict->FindDouble("x")) {
+      x = static_cast<int>(std::lround(*dv));
+    }
+    if (auto v = dict->FindInt("y")) {
+      y = *v;
+    } else if (auto dv = dict->FindDouble("y")) {
+      y = static_cast<int>(std::lround(*dv));
+    }
+  }
+  if (!x.has_value()) {
+    if (auto v = params.FindInt(x_key)) {
+      x = *v;
+    } else if (auto dv = params.FindDouble(x_key)) {
+      x = static_cast<int>(std::lround(*dv));
+    }
+  }
+  if (!y.has_value()) {
+    if (auto v = params.FindInt(y_key)) {
+      y = *v;
+    } else if (auto dv = params.FindDouble(y_key)) {
+      y = static_cast<int>(std::lround(*dv));
+    }
+  }
+  if (!x.has_value() || !y.has_value()) {
+    return std::nullopt;
+  }
+  return std::make_pair(*x, *y);
+}
+
+std::vector<dashboard::Locator> ReadLocatorList(const base::Value::Dict& params,
+                                                const char* key_a,
+                                                const char* key_b) {
+  const base::Value::List* list = params.FindList(key_a);
+  if (!list && key_b) {
+    list = params.FindList(key_b);
+  }
+  if (!list || list->empty()) {
+    return {};
+  }
+  return dashboard::ConvertLocators(*list);
+}
+
+dashboard::ResolvedElement NormalizeResolvedDragElement(
+    dashboard::ResolvedElement element) {
+  if (element.center_x == 0 && element.center_y == 0) {
+    if (element.width > 0 || element.height > 0) {
+      element.center_x = element.left + element.width / 2;
+      element.center_y = element.top + element.height / 2;
+    } else if (element.left != 0 || element.top != 0) {
+      element.center_x = element.left;
+      element.center_y = element.top;
+    }
+  }
+  return element;
+}
+
+}  // namespace
+
+DragAction::DragAction(Profile* profile) : dashboard::actions::Action(profile) {}
+
+DragAction::~DragAction() = default;
+
+bool DragAction::SetParams(const base::Value::Dict& params) {
+  from_locators_ = ReadLocatorList(params, "fromLocators", "from_locators");
+  to_locators_ = ReadLocatorList(params, "toLocators", "to_locators");
+  if (from_locators_.empty()) {
+    from_locators_ = ReadLocatorList(params, "locators", nullptr);
+  }
+
+  has_from_coords_ = false;
+  has_to_coords_ = false;
+  has_resolved_from_ = false;
+  has_resolved_to_ = false;
+  if (auto from_xy = ReadXYPair(params, "fromCoordinates", "from_coordinates",
+                                "fromX", "fromY")) {
+    has_from_coords_ = true;
+    from_x_ = from_xy->first;
+    from_y_ = from_xy->second;
+  }
+  if (auto to_xy =
+          ReadXYPair(params, "toCoordinates", "to_coordinates", "toX", "toY")) {
+    has_to_coords_ = true;
+    to_x_ = to_xy->first;
+    to_y_ = to_xy->second;
+  }
+
+  if (!has_from_coords_ && from_locators_.empty()) {
+    return false;
+  }
+  if (!has_to_coords_ && to_locators_.empty()) {
+    return false;
+  }
+
+  wait_timeout_ms_ = params.FindInt("waitTimeout").value_or(15000);
+  wait_timeout_ms_ = std::clamp(wait_timeout_ms_, 1000, 30000);
+  use_human_offset_ = params.FindBool("humanOffset").value_or(true);
+  steps_ = std::clamp(params.FindInt("steps").value_or(12), 2, 80);
+
+  base::Value::Dict out = params.Clone();
+  base::Value::List from_locs;
+  for (const auto& locator : from_locators_) {
+    from_locs.Append(dashboard::LocatorToValue(locator));
+  }
+  base::Value::List to_locs;
+  for (const auto& locator : to_locators_) {
+    to_locs.Append(dashboard::LocatorToValue(locator));
+  }
+  out.Set("fromLocators", std::move(from_locs));
+  out.Set("toLocators", std::move(to_locs));
+  if (has_from_coords_) {
+    base::Value::Dict coords;
+    coords.Set("x", from_x_);
+    coords.Set("y", from_y_);
+    out.Set("fromCoordinates", std::move(coords));
+  }
+  if (has_to_coords_) {
+    base::Value::Dict coords;
+    coords.Set("x", to_x_);
+    coords.Set("y", to_y_);
+    out.Set("toCoordinates", std::move(coords));
+  }
+  out.Set("waitTimeout", wait_timeout_ms_);
+  out.Set("humanOffset", use_human_offset_);
+  out.Set("steps", steps_);
+  SetSerializedAction("drag", std::move(out));
+  return true;
+}
+
+void DragAction::Execute(content::WebContents* web_contents, Callback callback) {
+  if (!web_contents) {
+    std::move(callback).Run(false, "WebContents null");
+    return;
+  }
+
+  from_checker_.reset();
+  to_checker_.reset();
+  has_resolved_from_ = false;
+  has_resolved_to_ = false;
+
+  if (!has_from_coords_) {
+    from_checker_ = std::make_unique<ElementReadinessChecker>(web_contents);
+    from_checker_->WaitForElementReadyAsync(
+        from_locators_, dashboard::SearchScope::kAll, wait_timeout_ms_,
+        base::BindOnce(&DragAction::OnFromReady, weak_ptr_factory_.GetWeakPtr(),
+                       web_contents, std::move(callback)));
+    return;
+  }
+
+  ResolveToOrExecute(web_contents, std::move(callback));
+}
+
+void DragAction::ResolveToOrExecute(content::WebContents* web_contents,
+                                    Callback callback) {
+  if (!has_to_coords_) {
+    to_checker_ = std::make_unique<ElementReadinessChecker>(web_contents);
+    to_checker_->WaitForElementReadyAsync(
+        to_locators_, dashboard::SearchScope::kAll, wait_timeout_ms_,
+        base::BindOnce(&DragAction::OnToReady, weak_ptr_factory_.GetWeakPtr(),
+                       web_contents, std::move(callback)));
+    return;
+  }
+  ExecuteResolvedDrag(web_contents, std::move(callback));
+}
+
+void DragAction::OnFromReady(content::WebContents* web_contents,
+                             Callback callback,
+                             bool ready,
+                             const dashboard::ResolvedElement& element,
+                             const std::string& error) {
+  const dashboard::ResolvedElement element_copy = element;
+  from_checker_.reset();
+  if (!ready) {
+    std::move(callback).Run(false, error);
+    return;
+  }
+  resolved_from_ = NormalizeResolvedDragElement(element_copy);
+  has_resolved_from_ = true;
+  ResolveToOrExecute(web_contents, std::move(callback));
+}
+
+void DragAction::OnToReady(content::WebContents* web_contents,
+                           Callback callback,
+                           bool ready,
+                           const dashboard::ResolvedElement& element,
+                           const std::string& error) {
+  const dashboard::ResolvedElement element_copy = element;
+  to_checker_.reset();
+  if (!ready) {
+    std::move(callback).Run(false, error);
+    return;
+  }
+  resolved_to_ = NormalizeResolvedDragElement(element_copy);
+  has_resolved_to_ = true;
+  ExecuteResolvedDrag(web_contents, std::move(callback));
+}
+
+void DragAction::ExecuteResolvedDrag(content::WebContents* web_contents,
+                                     Callback callback) {
+  resolved_from_ = NormalizeResolvedDragElement(resolved_from_);
+  resolved_to_ = NormalizeResolvedDragElement(resolved_to_);
+  int from_x = has_from_coords_ ? from_x_ : resolved_from_.center_x;
+  int from_y = has_from_coords_ ? from_y_ : resolved_from_.center_y;
+  int to_x = has_to_coords_ ? to_x_ : resolved_to_.center_x;
+  int to_y = has_to_coords_ ? to_y_ : resolved_to_.center_y;
+
+  dashboard::ClickHandler handler(web_contents);
+  bool success = false;
+
+  const bool resolved_frames_valid = has_resolved_from_ && has_resolved_to_ &&
+                                     resolved_from_.frame_id.frame_routing_id !=
+                                         -1 &&
+                                     resolved_to_.frame_id.frame_routing_id != -1;
+  if (resolved_frames_valid && resolved_from_.frame_id == resolved_to_.frame_id) {
+    if (content::RenderFrameHost* frame =
+            content::RenderFrameHost::FromID(resolved_from_.frame_id)) {
+      success = handler.ExecuteDragAtInFrame(frame, from_x, from_y, to_x, to_y,
+                                             use_human_offset_, steps_);
+    } else {
+      LOG(WARNING) << "[DragAction] Resolved frame id no longer maps to a live "
+                      "frame; falling back to primary frame drag";
+    }
+  }
+  if (!success) {
+    success = handler.ExecuteDragAt(from_x, from_y, to_x, to_y,
+                                    use_human_offset_, steps_);
+  }
+
+  if (!success) {
+    std::move(callback).Run(false, "Failed to execute drag");
+    return;
+  }
+  std::move(callback).Run(true, "");
+}
