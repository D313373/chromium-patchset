+#include "chrome/browser/ui/webui/dashboard/actions/cdp/cdp_click_action.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.h"
+#include "chrome/browser/ui/webui/dashboard/click_handler.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard_devtools_client.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard_handler.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/devtools_agent_host.h"
+
+namespace {
+
+bool ResolveClickPointToRoot(content::WebContents* web_contents,
+                             const dashboard::ResolvedElement& element,
+                             int* x,
+                             int* y) {
+  if (!web_contents || !x || !y) {
+    return false;
+  }
+  content::RenderFrameHost* frame =
+      content::RenderFrameHost::FromID(element.frame_id);
+  if (!frame) {
+    return false;
+  }
+  int root_x = *x;
+  int root_y = *y;
+  if (!dashboard::ConvertFramePointToRootCoordinates(web_contents, frame, *x,
+                                                     *y, &root_x, &root_y)) {
+    return false;
+  }
+  *x = root_x;
+  *y = root_y;
+  return true;
+}
+
+}  // namespace
+
+CdpClickAction::CdpClickAction(Profile* profile) : CdpActionBase(profile) {}
+CdpClickAction::~CdpClickAction() = default;
+
+bool CdpClickAction::SetParams(const base::Value::Dict& params) {
+  locators_.clear();
+  has_direct_coords_ = false;
+  direct_x_ = 0;
+  direct_y_ = 0;
+
+  const base::Value::List* locators_list = params.FindList("locators");
+  if (locators_list) {
+    locators_ = dashboard::ConvertLocators(*locators_list);
+  }
+
+  const base::Value::Dict* coords = params.FindDict("coordinates");
+  if (!coords) {
+    coords = params.FindDict("coordinate");
+  }
+  int x = params.FindInt("x").value_or(0);
+  int y = params.FindInt("y").value_or(0);
+  if (coords) {
+    x = coords->FindInt("x").value_or(x);
+    y = coords->FindInt("y").value_or(y);
+  }
+  const bool has_coord_values =
+      (coords &&
+       (coords->FindInt("x").has_value() || coords->FindInt("y").has_value()));
+  if (has_coord_values || params.FindInt("x") || params.FindInt("y")) {
+    has_direct_coords_ = true;
+    direct_x_ = x;
+    direct_y_ = y;
+  }
+
+  wait_timeout_ms_ = params.FindInt("waitTimeout").value_or(5000);
+  click_count_ = params.FindInt("clickCount")
+                     .value_or(params.FindInt("click_count").value_or(1));
+
+  base::Value::Dict serialized = params.Clone();
+  base::Value::List locator_values;
+  for (const auto& locator : locators_) {
+    locator_values.Append(dashboard::LocatorToValue(locator));
+  }
+  serialized.Set("locators", std::move(locator_values));
+  serialized.Set("waitTimeout", wait_timeout_ms_);
+  serialized.Set("clickCount", click_count_);
+  if (has_direct_coords_) {
+    base::Value::Dict c;
+    c.Set("x", direct_x_);
+    c.Set("y", direct_y_);
+    serialized.Set("coordinates", std::move(c));
+  }
+  SetSerializedAction(click_count_ <= 0 ? "hover" : "click",
+                      std::move(serialized));
+  return has_direct_coords_ || !locators_.empty();
+}
+
+void CdpClickAction::Execute(content::WebContents* web_contents,
+                             Callback callback) {
+  if (locators_.empty()) {
+    if (!has_direct_coords_) {
+      std::move(callback).Run(false,
+                              "CdpClickAction requires locators or coordinates");
+      return;
+    }
+    dashboard::DashboardDevToolsClient* client = GetDevToolsClient(web_contents);
+    if (!client) {
+      std::move(callback).Run(false, "CDP Client Unavailable");
+      return;
+    }
+    MoveAndClick(client, web_contents, direct_x_, direct_y_, std::move(callback));
+    return;
+  }
+
+  checker_ = std::make_unique<ElementReadinessChecker>(web_contents);
+  checker_->WaitForElementReadyAsync(
+      locators_, dashboard::SearchScope::kAll, wait_timeout_ms_,
+      base::BindOnce(&CdpClickAction::OnElementReady,
+                     weak_ptr_factory_.GetWeakPtr(), web_contents,
+                     std::move(callback)));
+}
+
+void CdpClickAction::OnElementReady(content::WebContents* web_contents,
+                                    Callback callback,
+                                    bool ready,
+                                    const dashboard::ResolvedElement& element,
+                                    const std::string& error) {
+  if (!ready) {
+    if (has_direct_coords_) {
+      dashboard::DashboardDevToolsClient* client = GetDevToolsClient(web_contents);
+      if (!client) {
+        std::move(callback).Run(false, "CDP Client Unavailable");
+        return;
+      }
+      MoveAndClick(client, web_contents, direct_x_, direct_y_,
+                   std::move(callback));
+      return;
+    }
+    std::move(callback).Run(false, "Element not ready: " + error);
+    return;
+  }
+
+  dashboard::DashboardDevToolsClient* client = GetDevToolsClient(web_contents);
+  if (!client) {
+    std::move(callback).Run(false, "CDP Client Unavailable");
+    return;
+  }
+
+  // Determine target with slight endpoint variation.
+  int target_x = element.center_x + GetRandomRange(-2, 2);
+  int target_y = element.center_y + GetRandomRange(-2, 2);
+  ResolveClickPointToRoot(web_contents, element, &target_x, &target_y);
+  MoveAndClick(client, web_contents, target_x, target_y, std::move(callback));
+}
+
+void CdpClickAction::MoveAndClick(dashboard::DashboardDevToolsClient* client,
+                                  content::WebContents* web_contents,
+                                  int final_x,
+                                  int final_y,
+                                  Callback callback) {
+  SessionState& state = GetSessionState(web_contents);
+  gfx::PointF start(state.cursor_x, state.cursor_y);
+  gfx::PointF end(static_cast<float>(final_x), static_cast<float>(final_y));
+  auto path = std::make_shared<std::vector<gfx::PointF>>(
+      GenerateBezierPath(start, end, 25));
+  DispatchMoveStep(client, web_contents, path, 0, final_x, final_y,
+                   std::move(callback));
+}
+
+std::vector<gfx::PointF> CdpClickAction::GenerateBezierPath(
+    const gfx::PointF& start,
+    const gfx::PointF& end,
+    int steps) const {
+  std::vector<gfx::PointF> path;
+  if (steps <= 0) {
+    return path;
+  }
+
+  const double dx = end.x() - start.x();
+  const double dy = end.y() - start.y();
+  const double distance = std::sqrt((dx * dx) + (dy * dy));
+  const double safe_distance = std::max(1.0, distance);
+  const double unit_x = dx / safe_distance;
+  const double unit_y = dy / safe_distance;
+  const double perp_x = -unit_y;
+  const double perp_y = unit_x;
+  const double curvature_sign = RollProbability(50.0) ? 1.0 : -1.0;
+
+  const double control_distance_1 = safe_distance * GetRandomDouble(0.22, 0.4);
+  const double control_distance_2 = safe_distance * GetRandomDouble(0.58, 0.82);
+  const double curve_amount =
+      std::max(4.0, safe_distance * GetRandomDouble(0.08, 0.18));
+
+  const gfx::PointF control_1(
+      start.x() + static_cast<float>(unit_x * control_distance_1 +
+                                     perp_x * curve_amount * curvature_sign),
+      start.y() + static_cast<float>(unit_y * control_distance_1 +
+                                     perp_y * curve_amount * curvature_sign));
+  const gfx::PointF control_2(
+      start.x() + static_cast<float>(unit_x * control_distance_2 -
+                                     perp_x * curve_amount * curvature_sign *
+                                         GetRandomDouble(0.4, 0.9)),
+      start.y() + static_cast<float>(unit_y * control_distance_2 -
+                                     perp_y * curve_amount * curvature_sign *
+                                         GetRandomDouble(0.4, 0.9)));
+
+  path.reserve(steps);
+  for (int i = 1; i <= steps; ++i) {
+    const double t = static_cast<double>(i) / steps;
+    const double inv = 1.0 - t;
+    const double x = (inv * inv * inv * start.x()) +
+                     (3.0 * inv * inv * t * control_1.x()) +
+                     (3.0 * inv * t * t * control_2.x()) +
+                     (t * t * t * end.x()) + GetRandomDouble(-0.45, 0.45);
+    const double y = (inv * inv * inv * start.y()) +
+                     (3.0 * inv * inv * t * control_1.y()) +
+                     (3.0 * inv * t * t * control_2.y()) +
+                     (t * t * t * end.y()) + GetRandomDouble(-0.45, 0.45);
+    path.emplace_back(static_cast<float>(x), static_cast<float>(y));
+  }
+  if (!path.empty()) {
+    path.back().set_x(end.x());
+    path.back().set_y(end.y());
+  }
+  return path;
+}
+
+void CdpClickAction::DispatchMoveStep(
+    dashboard::DashboardDevToolsClient* client,
+    content::WebContents* web_contents,
+    std::shared_ptr<std::vector<gfx::PointF>> path,
+    size_t index,
+    int final_x,
+    int final_y,
+    Callback callback) {
+  if (index >= path->size()) {
+    SessionState& state = GetSessionState(web_contents);
+    state.cursor_x = final_x;
+    state.cursor_y = final_y;
+    if (click_count_ <= 0) {
+      dashboard::UpdatePlaybackOverlayCursor(web_contents, final_x, final_y,
+                                             /*click_pulse=*/false);
+      std::move(callback).Run(true, "");
+      return;
+    }
+    PressMouse(client, web_contents, final_x, final_y, std::move(callback));
+    return;
+  }
+
+  const gfx::PointF& point = (*path)[index];
+  SessionState& state = GetSessionState(web_contents);
+  state.cursor_x = point.x();
+  state.cursor_y = point.y();
+
+  base::Value::Dict move;
+  move.Set("type", "mouseMoved");
+  move.Set("x", point.x());
+  move.Set("y", point.y());
+  move.Set("button", "none");
+  client->SendCommand("Input.dispatchMouseEvent", std::move(move));
+  dashboard::UpdatePlaybackOverlayCursor(
+      web_contents, static_cast<int>(std::lround(point.x())),
+      static_cast<int>(std::lround(point.y())), /*click_pulse=*/false);
+
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&CdpClickAction::DispatchMoveStep,
+                     weak_ptr_factory_.GetWeakPtr(), client, web_contents, path,
+                     index + 1, final_x, final_y, std::move(callback)),
+      base::Milliseconds(GetRandomRange(2, 8)));
+}
+
+void CdpClickAction::PressMouse(dashboard::DashboardDevToolsClient* client,
+                                content::WebContents* web_contents,
+                                int final_x,
+                                int final_y,
+                                Callback callback) {
+  base::Value::Dict d;
+  d.Set("type", "mousePressed");
+  d.Set("button", "left");
+  d.Set("x", (double)final_x);
+  d.Set("y", (double)final_y);
+  d.Set("clickCount", click_count_);
+  client->SendCommand("Input.dispatchMouseEvent", std::move(d));
+  dashboard::UpdatePlaybackOverlayCursor(web_contents, final_x, final_y,
+                                         /*click_pulse=*/true);
+
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&CdpClickAction::OnMouseReleased,
+                     weak_ptr_factory_.GetWeakPtr(), client, web_contents,
+                     final_x, final_y, std::move(callback)),
+      base::Milliseconds(GetRandomRange(60, 120)));
+}
+
+void CdpClickAction::OnMouseReleased(dashboard::DashboardDevToolsClient* client,
+                                     content::WebContents* web_contents,
+                                     int final_x,
+                                     int final_y,
+                                     Callback callback) {
+  base::Value::Dict u;
+  u.Set("type", "mouseReleased");
+  u.Set("button", "left");
+  u.Set("x", static_cast<double>(final_x));
+  u.Set("y", static_cast<double>(final_y));
+  u.Set("clickCount", click_count_);
+  client->SendCommand("Input.dispatchMouseEvent", std::move(u));
+  dashboard::UpdatePlaybackOverlayCursor(web_contents, final_x, final_y,
+                                         /*click_pulse=*/true);
+  std::move(callback).Run(true, "");
+}
