+base::Value::Dict StopHeadlessInvestigateTask(Profile* profile,
+                                              const std::string& task_id,
+                                              bool close_target,
+                                              const std::string& reason) {
+  base::Value::Dict out;
+  out.Set("entrypoint", "StopTask");
+  out.Set("task_id", task_id);
+  out.Set("taskId", task_id);
+
+  auto& by_profile = HeadlessInvestigateTasks();
+  auto profile_it = by_profile.find(profile);
+  if (profile_it == by_profile.end()) {
+    out.Set("ok", false);
+    out.Set("error", "Task profile scope not found.");
+    return out;
+  }
+  auto task_it = profile_it->second.find(task_id);
+  if (task_it == profile_it->second.end() || !task_it->second) {
+    out.Set("ok", false);
+    out.Set("error", "Task not found.");
+    return out;
+  }
+
+  std::unique_ptr<HeadlessTaskState> state = std::move(task_it->second);
+  profile_it->second.erase(task_it);
+  if (profile_it->second.empty()) {
+    by_profile.erase(profile_it);
+  }
+
+  bool stopped_run = false;
+  if (!state->active_execution_id.empty()) {
+    if (ScriptExecutionService* exec_service =
+            ScriptExecutionServiceFactory::GetForProfile(profile)) {
+      stopped_run = exec_service->StopRun(state->active_execution_id, reason);
+    }
+  }
+
+  bool closed_tab = false;
+  if (close_target && state->owns_tab && state->browser && state->web_contents) {
+    TabStripModel* tabs = state->browser->tab_strip_model();
+    if (tabs) {
+      const int index = tabs->GetIndexOfWebContents(state->web_contents);
+      if (index >= 0) {
+        tabs->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+        closed_tab = true;
+      }
+    }
+  }
+
+  out.Set("ok", true);
+  out.Set("stopped_run", stopped_run);
+  out.Set("closed_tab", closed_tab);
+  return out;
+}
+
+void RunHeadlessInvestigatePage(Profile* profile,
+                                base::Value::Dict payload,
+                                HeadlessInvestigationCallback callback) {
+  std::string task_id;
+  base::Value::Dict create_result = CreateHeadlessTask(profile, payload, &task_id);
+  if (!create_result.FindBool("ok").value_or(false) || task_id.empty()) {
+    base::Value::Dict out = std::move(create_result);
+    if (!out.FindString("error")) {
+      out.Set("error", "Failed to create investigation task.");
+    }
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+
+  const bool close_target =
+      payload.FindBool("close_target")
+          .value_or(payload.FindBool("closeTarget").value_or(true));
+  base::Value::List actions = BuildInvestigateActions(payload);
+  const ScriptExecutionService::RunOptions run_options =
+      BuildInvestigateRunOptions(payload);
+  PerformHeadlessTaskActions(
+      profile, task_id, std::move(actions), run_options,
+      base::BindOnce(
+          [](Profile* profile, std::string task_id, bool close_target,
+             base::Value::Dict request_payload, base::Value::Dict create_result,
+             HeadlessInvestigationCallback callback,
+             base::Value::Dict action_result) {
+            CaptureHeadlessTaskContext(
+                profile, task_id, request_payload,
+                base::BindOnce(
+                    [](Profile* profile, std::string task_id, bool close_target,
+                       base::Value::Dict request_payload,
+                       base::Value::Dict create_result,
+                       base::Value::Dict action_result,
+                       HeadlessInvestigationCallback callback,
+                       base::Value::Dict context) {
+                      base::Value::Dict stop_result =
+                          StopHeadlessInvestigateTask(
+                              profile, task_id, close_target,
+                              "dashboard_investigate_page completed");
+
+                      base::Value::Dict out = std::move(context);
+                      out.Set("command", "investigate_page");
+                      out.Set("transport", "task_entrypoints");
+                      out.Set("target_id", task_id);
+                      out.Set("create_result", std::move(create_result));
+                      out.Set("action_result", std::move(action_result));
+                      out.Set("stop_result", std::move(stop_result));
+
+                      const bool include_screenshot =
+                          request_payload.FindBool("include_screenshot")
+                              .value_or(request_payload.FindBool(
+                                            "includeScreenshot")
+                                            .value_or(false));
+                      if (include_screenshot) {
+                        out.Set("warning",
+                                "include_screenshot is not implemented yet for "
+                                "task entrypoint mode.");
+                      }
+
+                      const bool context_ok =
+                          out.FindBool("ok").value_or(false);
+                      const base::Value::Dict* action_dict =
+                          out.FindDict("action_result");
+                      const bool actions_ok =
+                          action_dict &&
+                          action_dict->FindBool("ok").value_or(false);
+                      out.Set("ok", context_ok && actions_ok);
+
+                      if (!actions_ok) {
+                        if (action_dict) {
+                          if (const std::string* err =
+                                  action_dict->FindString("error")) {
+                            out.Set("error", *err);
+                          }
+                        }
+                      } else if (!context_ok) {
+                        if (!out.FindString("error")) {
+                          out.Set("error", "Failed to collect task context.");
+                        }
+                      }
+
+                      std::move(callback).Run(std::move(out));
+                    },
+                    profile, task_id, close_target, std::move(request_payload),
+                    std::move(create_result), std::move(action_result),
+                    std::move(callback)));
+          },
+          profile, task_id, close_target, std::move(payload),
+          std::move(create_result), std::move(callback)));
+}
