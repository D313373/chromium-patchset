+  kUnknown,
+  kTargetDetached,
+  kTargetHidden,
+  kTargetDisabled,
+  kTargetEditable,
+  kTargetFocused,
+  kExpectedElementAppeared,
+  kExpectedElementMissing,
+  kNavigationCommitted,
+  kNavigationFailed,
+  kDomMutationBurst,
+  kValueChanged,
+  kDialogOpened,
+};
+
+struct BlinkAgentWatchTarget {
+  string frame_id;
+  int32 dom_node_id;
+  array<Locator> locators;
+  string role;
+  string accessibility_name;
