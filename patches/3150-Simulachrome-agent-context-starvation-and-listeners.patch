+    const base::Value::List* locators =
+        area ? area->FindList("locators") : nullptr;
+    if (!locators) {
+      continue;
+    }
+    for (const base::Value& locator_value : *locators) {
+      flattened.Append(locator_value.Clone());
+    }
+  }
+  return flattened;
+}
