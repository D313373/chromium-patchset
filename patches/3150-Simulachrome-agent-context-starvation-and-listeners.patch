+export function renderWaitEditor(container, action, onChange) {
+  if (!container) return;
+  const params = (action && action.params) || { waitType: 'time', time: 1000 };
+
+  container.innerHTML = `
+    <div class="p-2">
+      <label style="display:block;margin-bottom:8px;">Wait Type</label>
+      <select id="wait-type" style="width:100%;margin-bottom:12px;">
+        <option value="time">Time (milliseconds)</option>
