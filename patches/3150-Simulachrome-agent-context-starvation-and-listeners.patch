+def cmd_warm_headless(profile_dir: Path, browser_bin: str = "") -> Dict[str, Any]:
+  """Ensure the singleton headless browser is running with about:blank."""
+  pid = _ensure_headless_instance(profile_dir, browser_bin)
+  # Guarantee at least one page target so later listeners/investigate attach fast.
+  try:
+    targets = _list_targets()
+    has_page = False
+    for target in targets:
+      if isinstance(target, dict) and str(target.get("type") or "") == "page":
+        has_page = True
+        break
+    if not has_page:
+      _cdp_create_target("about:blank")
+  except Exception as exc:
+    return {
+        "ok": False,
+        "error": f"Headless prewarm created process but CDP failed: {exc}",
+        "browser_pid": pid,
+    }
+  return {"ok": True, "browser_pid": pid}
