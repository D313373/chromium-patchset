+#include "chrome/browser/ui/webui/dashboard/recorder_devtools_client.h"
+
+#include <string>
+#include "content/public/browser/devtools_agent_host.h"
+
+
+#include "base/json/json_reader.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+
+RecorderDevToolsClient::RecorderDevToolsClient(PayloadCallback on_payload,
+                                               ResponseCallback on_response,
+                                               EventCallback on_event)
+    : on_payload_(std::move(on_payload)),
+      on_response_(std::move(on_response)),
+      on_event_(std::move(on_event)) {}
+RecorderDevToolsClient::~RecorderDevToolsClient() = default;
+
+void RecorderDevToolsClient::DispatchProtocolMessage(
+    content::DevToolsAgentHost* agent_host,
+    base::span<const uint8_t> message) {
+  std::string json(reinterpret_cast<const char*>(message.data()),
+                   message.size());
+  auto parsed = base::JSONReader::Read(
+      json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed || !parsed->is_dict())
+    return;
+  const base::Value::Dict& dict = parsed->GetDict();
+
+  // Forward all DevTools events to optional event callback, and specially handle
+  // Runtime.bindingCalled for the recorder pipeline.
+  if (const std::string* method = dict.FindString("method")) {
+    // Fire generic event callback first
+    if (on_event_) {
+      const base::Value::Dict* params = dict.FindDict("params");
+      base::Value::Dict params_copy = params ? params->Clone() : base::Value::Dict();
+      on_event_.Run(*method, std::move(params_copy));
+    }
+
+    // Special-case the recorder binding payload
+    if (*method == "Runtime.bindingCalled") {
+      const base::Value::Dict* params = dict.FindDict("params");
+      if (params) {
+        const std::string* name = params->FindString("name");
+        const std::string* payload = params->FindString("payload");
+        if (name && payload && *name == "scRecord" && on_payload_)
+          on_payload_.Run(*payload);
+      }
+    }
+  }
+
+  // Also surface generic command responses matched by id.
+  if (on_response_) {
+    const base::Value* idv = dict.Find("id");
+    if (idv && idv->is_int()) {
+      int id = idv->GetInt();
+      const base::Value::Dict* res = dict.FindDict("result");
+      const base::Value::Dict* err = dict.FindDict("error");
+      base::Value::Dict res_copy = res ? res->Clone() : base::Value::Dict();
+      base::Value::Dict err_copy = err ? err->Clone() : base::Value::Dict();
+      on_response_.Run(id, std::move(res_copy), std::move(err_copy));
+    }
+  }
+}
+
+void RecorderDevToolsClient::AgentHostClosed(
+    content::DevToolsAgentHost* agent_host) {
+  // No-op; caller should detach and destroy us.
+}
+
+bool RecorderDevToolsClient::IsTrusted() { return true; }
+bool RecorderDevToolsClient::UsesBinaryProtocol() { return false; }
+std::string RecorderDevToolsClient::GetTypeForMetrics() { return "Other"; }
