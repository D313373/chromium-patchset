+#include "chrome/browser/ui/webui/dashboard/actions/navigate_action.h"
+#include "chrome/browser/ui/webui/dashboard/actions/scrape_element_action.h"
+#include "chrome/browser/ui/webui/dashboard/actions/scroll_action.h"
+#include "chrome/browser/ui/webui/dashboard/actions/type_action.h"
+
+namespace dashboard {
+namespace actions {
+
+ActionFactory::ActionFactory(Profile* profile) : profile_(profile) {}
+ActionFactory::~ActionFactory() = default;
+
+std::unique_ptr<Action> ActionFactory::CreateAction(
+    const base::Value::Dict& action_data) {
+  // Accept either canonical {action, params} or engine {type, <params at top-level>}
+  const std::string* type = action_data.FindString("type");
+  const std::string* action_name = action_data.FindString("action");
+  std::string kind = type ? *type : (action_name ? *action_name : std::string());
+  if (kind.empty()) return nullptr;
+
+  std::unique_ptr<Action> action;
+  if (kind == "navigate") {
+    action = std::make_unique<NavigateAction>(profile_);
+    } else if (kind == "scrape_element") {
+      action = std::make_unique<ScrapeElementAction>(profile_);
+    } else if (kind == "loop") {
+      action = std::make_unique<LoopAction>(profile_);
+    } else if (kind == "click") {
+      action = std::make_unique<ClickAction>(profile_);
+    } else if (kind == "type") {
+      action = std::make_unique<TypeAction>(profile_);
+    } else if (kind == "key_down") {
+      action = std::make_unique<KeyDownAction>(profile_);
+    } else if (kind == "key_press" || kind == "keypress") {
+      action = std::make_unique<KeyPressAction>(profile_);
+    } else if (kind == "wait") {
+      action = std::make_unique<WaitAction>(profile_);
+    } else if (kind == "if_condition") {
+      action = std::make_unique<IfConditionAction>(profile_);
+    } else if (kind == "scrape_table") {
+      action = std::make_unique<ScrapeTableAction>(profile_);
+    } else if (kind == "scroll") {
+      action = std::make_unique<ScrollAction>(profile_);
+    }
+
+  if (!action) {
+    LOG(ERROR) << "[ActionFactory] Unknown action kind='" << kind << "'";
+    return nullptr;
+  }
+
+  // Prefer nested params for canonical schema; fallback to engine-style
+  // top-level. Some actions (loop, scrape_table) also expect certain fields to
+  // live inside the params dict even when the UI/editor stores them at the
+  // top level, so we build a mutable copy for those kinds.
+  const base::Value::Dict* params = action_data.FindDict("params");
+  if (!params)
+    params = action_data.FindDict("parameters");
+
+  base::Value::Dict bridged_params;
+  const base::Value::Dict* to_pass = nullptr;
+
+  if (kind == "loop") {
+    // LoopAction::SetParams expects `variable` and `nestedActions` inside the
+    // params dict. The editor historically wrote `steps` and sometimes stored
+    // `variable` / `nestedActions` at the top level, so bridge those shapes.
+    bridged_params = params ? params->Clone() : base::Value::Dict();
+
+    if (!bridged_params.FindString("variable")) {
+      if (const std::string* var = action_data.FindString("variable")) {
+        bridged_params.Set("variable", *var);
+      }
+    }
+
+    if (!bridged_params.FindList("nestedActions")) {
+      // Prefer explicit nestedActions on the action itself.
+      const base::Value::List* nested_in_action =
+          action_data.FindList("nestedActions");
+      if (nested_in_action) {
+        bridged_params.Set("nestedActions", nested_in_action->Clone());
+      } else if (const base::Value::List* steps_in_params =
+                     bridged_params.FindList("steps")) {
+        // Legacy spelling in serialized scripts.
+        bridged_params.Set("nestedActions", steps_in_params->Clone());
+      } else if (const base::Value::List* steps_in_action =
+                     action_data.FindList("steps")) {
+        bridged_params.Set("nestedActions", steps_in_action->Clone());
+      }
+    }
+
+    to_pass = &bridged_params;
+  } else if (kind == "scrape_table") {
+    // ScrapeTableAction::SetParams consumes `columns` + `variableName`. Older
+    // scripts may still use `fields`, so bridge those into `columns`.
+    bridged_params = params ? params->Clone() : base::Value::Dict();
+
+    if (!bridged_params.FindString("variableName")) {
+      if (const std::string* var = action_data.FindString("variableName")) {
+        bridged_params.Set("variableName", *var);
+      }
+    }
+
+    if (!bridged_params.FindList("columns")) {
+      const base::Value::List* columns_in_params =
+          bridged_params.FindList("fields");
+      if (columns_in_params) {
+        bridged_params.Set("columns", columns_in_params->Clone());
+      } else if (const base::Value::List* columns_in_action =
+                     action_data.FindList("fields")) {
+        bridged_params.Set("columns", columns_in_action->Clone());
+      } else if (const base::Value::List* columns_in_action_params =
+                     action_data.FindList("columns")) {
+        bridged_params.Set("columns", columns_in_action_params->Clone());
+      }
+    }
+
+    to_pass = &bridged_params;
+  } else {
+    // Pass-through for all other actions.
+    to_pass = params ? params : &action_data;
+  }
+
+  if (!action->SetParams(*to_pass)) {
+    LOG(ERROR) << "[ActionFactory] SetParams failed for kind='" << kind << "'";
+    return nullptr;
+  }
+
+  LOG(INFO) << "[ActionFactory] Created action kind='" << kind << "'";
+  return action;
+}
+
+std::vector<std::unique_ptr<Action>> ActionFactory::CreateActionSequence(
+    const base::Value::List& timeline) {
+  std::vector<std::unique_ptr<Action>> sequence;
+  for (const auto& action_value : timeline) {
+    if (action_value.is_dict()) {
+      auto action = CreateAction(action_value.GetDict());
+      if (action) {
+        sequence.push_back(std::move(action));
+      }
+    }
+  }
+  return sequence;
+}
+
+}  // namespace actions
+}  // namespace dashboard
