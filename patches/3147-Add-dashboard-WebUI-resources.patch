+void RecorderController::PositionOverlayNearTopRight(BrowserView* browser_view) {
+  if (!overlay_widget_ || !browser_view)
+    return;
+  gfx::Rect browser_bounds = browser_view->GetBoundsInScreen();
+  gfx::Size size = overlay_widget_->GetWindowBoundsInScreen().size();
+  int x = browser_bounds.right() - size.width() - kOverlayMargin;
+
+  // Compute Y to be exactly the bottom of the toolbar in screen coordinates when
+  // a tab strip/toolbar is present. This guarantees no overlap even in modes
+  // where the top container overlays the web contents on macOS.
+  int y = browser_bounds.y();
+  if (browser_view->GetTabStripVisible()) {
+    if (auto* toolbar = browser_view->toolbar()) {
+      if (toolbar->GetVisible()) {
+        const gfx::Rect tb = toolbar->GetBoundsInScreen();
+        y = tb.bottom();
+      }
+    }
+  }
+
+  // Fallback: if we couldn't resolve the toolbar bounds (popup/app windows),
+  // use the client top inset which corresponds to the top of the client area.
+  if (y == browser_bounds.y()) {
+    if (auto* frame_view = browser_view->browser_widget()->GetFrameView())
+      y += frame_view->GetTopInset(false);
+  }
+
+  overlay_widget_->SetBounds(gfx::Rect(gfx::Point(x, y), size));
+}
+
+void RecorderController::ResizeOverlay(int width, int height) {
+  if (!overlay_widget_) return;
+  gfx::Rect old_bounds = overlay_widget_->GetWindowBoundsInScreen();
+  gfx::Rect new_bounds = old_bounds;
+  new_bounds.set_width(width);
+  new_bounds.set_height(height);
+  // Preserve the right edge anchor.
+  new_bounds.set_x(old_bounds.right() - width);
+  overlay_widget_->SetBounds(new_bounds);
+}
