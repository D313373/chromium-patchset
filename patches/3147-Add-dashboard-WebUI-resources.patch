diff --git a/chrome/browser/ui/webui/dashboard/anti_detection_controller.cc b/chrome/browser/ui/webui/dashboard/anti_detection_controller.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6b766bf699ac51fadc1c40e27328483d563858c2
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/anti_detection_controller.cc
@@ -0,0 +1,202 @@
+#include "chrome/browser/ui/webui/dashboard/anti_detection_controller.h"
+
+#include <optional>
+
+#include "base/json/json_writer.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "chrome/browser/ui/webui/dashboard/anti_detection_injector.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace dashboard {
+
+AntiDetectionController::AntiDetectionController(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents) {
+  DCHECK(web_contents);
+}
+
+AntiDetectionController::~AntiDetectionController() {
+  DetachFromDevTools();
+}
+
+void AntiDetectionController::InjectAntiDetectionScripts(
+    const base::Value::Dict& anti_detection_settings) {
+  current_settings_ = anti_detection_settings.Clone();
+
+  // If not attached to DevTools yet, attach now
+  if (!agent_host_) {
+    AttachToDevTools();
+  }
+
+  // Generate the injection script
+  AntiDetectionInjector injector;
+  std::string script = injector.GenerateInjectionScript(anti_detection_settings);
+
+  // Inject via CDP
+  InjectScript(script);
+}
+
+// Compatibility overload: accept generic base::Value and forward if it's a dict.
+void AntiDetectionController::InjectAntiDetectionScripts(
+    const base::Value& anti_detection_settings) {
+  if (anti_detection_settings.is_dict()) {
+    InjectAntiDetectionScripts(anti_detection_settings.GetDict());
+  } else {
+    VLOG(1) << "[AntiDetectionController] Expected Dict for settings; got type "
+            << anti_detection_settings.type();
+  }
+}
+
+void AntiDetectionController::AttachToDevTools() {
+  if (!web_contents()) {
+    return;
+  }
+
+  agent_host_ = content::DevToolsAgentHost::GetOrCreateFor(web_contents());
+  if (agent_host_) {
+    agent_host_->AttachClient(this);
+
+    // Enable the Page domain for script injection in the root session
+    SendCommand("Page.enable", base::Value::Dict());
+
+    // Ensure all future targets/frames auto-attach so we can pre-register
+    // the script for document_start in each session.
+    EnableAutoAttach();
+  }
+}
+
+void AntiDetectionController::DetachFromDevTools() {
+  if (agent_host_) {
+    agent_host_->DetachClient(this);
+    agent_host_ = nullptr;
+  }
+}
+
+void AntiDetectionController::SendCommand(const std::string& method,
+                                          base::Value::Dict params) {
+  if (!agent_host_) {
+    return;
+  }
+
+  base::Value::Dict cmd;
+  cmd.Set("id", next_command_id_++);
+  cmd.Set("method", method);
+  cmd.Set("params", std::move(params));
+
+  std::string json;
+  base::JSONWriter::Write(cmd, &json);
+
+  agent_host_->DispatchProtocolMessage(
+      this, base::as_bytes(base::span(json)));
+}
+
+void AntiDetectionController::SendCommandToSession(const std::string& method,
+                                                   base::Value::Dict params,
+                                                   const std::string& session_id) {
+  if (!agent_host_) {
+    return;
+  }
+  base::Value::Dict cmd;
+  cmd.Set("id", next_command_id_++);
+  cmd.Set("sessionId", session_id);
+  cmd.Set("method", method);
+  cmd.Set("params", std::move(params));
+
+  std::string json;
+  base::JSONWriter::Write(cmd, &json);
+  agent_host_->DispatchProtocolMessage(
+      this, base::as_bytes(base::span(json)));
+}
+
+void AntiDetectionController::InjectScript(const std::string& script) {
+  base::Value::Dict params;
+  params.Set("source", script);
+  // Do not run immediately on the current document to avoid mid-page mutations
+  // being recorded by detectors (e.g., Pixelscan). Register for future documents
+  // only, so it executes at document_start on next navigation.
+  params.Set("runImmediately", false);
+
+  SendCommand("Page.addScriptToEvaluateOnNewDocument", std::move(params));
+}
+
+void AntiDetectionController::EnableAutoAttach() {
+  if (auto_attach_enabled_) return;
+  base::Value::Dict params;
+  params.Set("autoAttach", true);
+  // Pause new targets on start so we can register our document_start script
+  // before any page script executes, then resume immediately.
+  params.Set("waitForDebuggerOnStart", true);
+  params.Set("flatten", true);
+  SendCommand("Target.setAutoAttach", std::move(params));
+  auto_attach_enabled_ = true;
+}
+
+void AntiDetectionController::RegisterScriptForSession(const std::string& session_id) {
+  if (current_settings_.empty()) return;
+  AntiDetectionInjector injector;
+  std::string script = injector.GenerateInjectionScript(current_settings_);
+  base::Value::Dict p;
+  p.Set("source", script);
+  p.Set("runImmediately", false);
+  SendCommandToSession("Page.addScriptToEvaluateOnNewDocument", std::move(p), session_id);
+}
+
+void AntiDetectionController::DidFinishLoad(
+    content::RenderFrameHost* render_frame_host,
+    const GURL& validated_url) {
+  // Intentionally do nothing: reinjecting after load causes mid-page patches
+  // that some detectors record as suspicious. Scripts are registered for the
+  // next navigation via Page.addScriptToEvaluateOnNewDocument.
+}
+
+void AntiDetectionController::WebContentsDestroyed() {
+  DetachFromDevTools();
+}
+
+void AntiDetectionController::DispatchProtocolMessage(
+    content::DevToolsAgentHost* agent_host,
+    base::span<const uint8_t> message) {
+  std::string msg_str(message.begin(), message.end());
+  VLOG(2) << "[AntiDetectionController] CDP Response: " << msg_str;
+
+  // Parse to detect Target.attachedToTarget events and register the script for
+  // that new session so it runs at document_start.
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      msg_str, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed || !parsed->is_dict()) return;
+  const base::Value::Dict& dict = parsed->GetDict();
+  const std::string* method = dict.FindString("method");
+  if (!method) return;
+  if (*method == "Target.attachedToTarget") {
+    const base::Value::Dict* params = dict.FindDict("params");
+    if (!params) return;
+    const std::string* session_id = params->FindString("sessionId");
+    if (!session_id) return;
+
+    // Only handle page/frame-like targets to avoid Page.* on workers.
+    const base::Value::Dict* target_info = params->FindDict("targetInfo");
+    const std::string* type = target_info ? target_info->FindString("type") : nullptr;
+    if (type && *type != "page" && *type != "iframe" && *type != "frame") {
+      return;
+    }
+
+    // Enable Page domain in the new session and register our script.
+    base::Value::Dict enable_params;
+    SendCommandToSession("Page.enable", std::move(enable_params), *session_id);
+    RegisterScriptForSession(*session_id);
+
+    // Resume execution if the target was paused on start.
+    SendCommandToSession("Runtime.runIfWaitingForDebugger", base::Value::Dict(), *session_id);
+  }
+}
+
+void AntiDetectionController::AgentHostClosed(
+    content::DevToolsAgentHost* agent_host) {
+  if (agent_host == agent_host_.get()) {
+    agent_host_ = nullptr;
+  }
+}
+
+}  // namespace dashboard
