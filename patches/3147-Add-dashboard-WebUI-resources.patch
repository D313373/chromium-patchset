@@ -0,0 +1,54 @@
+#include "chrome/browser/ui/webui/dashboard/script_context_manager.h"
+#include "chrome/browser/ui/webui/dashboard/script_context.h"
+#include "base/no_destructor.h"
+#include <utility>
+#include <memory>
+#include <string>
+
+namespace dashboard {
+
+ScriptContextManager::ScriptContextManager() = default;
+
+ScriptContextManager::~ScriptContextManager() = default;
+
+ScriptContextManager* ScriptContextManager::GetInstance() {
+  static base::NoDestructor<ScriptContextManager> instance;
+  return instance.get();
+}
+
+ScriptContext* ScriptContextManager::CreateContext(
+    const std::string& script_id,
+    content::WebContents* web_contents) {
+  auto ctx = std::make_unique<ScriptContext>(script_id, web_contents);
+  ScriptContext* out = ctx.get();
+  contexts_[script_id] = std::move(ctx);
+  return out;
+}
+
+ScriptContext* ScriptContextManager::GetContext(const std::string& script_id) {
+  auto it = contexts_.find(script_id);
+  return it == contexts_.end() ? nullptr : it->second.get();
+}
+
+ScriptContext* ScriptContextManager::FindContextByWebContents(content::WebContents* web_contents) {
+  for (auto& kv : contexts_) {
+    if (kv.second && kv.second->ContainsWebContents(web_contents))
+      return kv.second.get();
+  }
+  return nullptr;
+}
+
+void ScriptContextManager::RegisterPopupForWebContents(content::WebContents* owner, content::WebContents* popup) {
+  auto* ctx = FindContextByWebContents(owner);
+  if (ctx && popup) {
+    ctx->RegisterPopup(popup);
+  }
+}
+
+void ScriptContextManager::RemoveContext(const std::string& script_id) {
+  auto it = contexts_.find(script_id);
+  if (it != contexts_.end())
+    contexts_.erase(it);
+}
