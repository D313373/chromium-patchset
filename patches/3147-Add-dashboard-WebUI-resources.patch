+void RecorderController::HandlePageMapFailure(const std::string& reason) {
+  LOG(WARNING) << "[Recorder] PageMap capture failed: " << reason;
+  base::Value::Dict empty;
+  empty.Set("url", current_url_);
+  empty.Set("timestamp", static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  empty.Set("frames", base::Value::List());
+  base::Value::Dict meta;
+  meta.Set("error", reason);
+  empty.Set("metadata", std::move(meta));
+  // Surface the failure to the overlay / AI consumers so the operator can see
+  // that a snapshot was attempted even if it did not succeed.
+  base::Value::Dict payload;
+  payload.Set("type", "pagemap");
+  payload.Set("detail", base::Value(empty.Clone()));
+  std::string json;
+  base::JSONWriter::Write(payload, &json);
+  UpdateOverlayWithPayload(json);
+  ResolvePageMapCallbacks(empty);
+  ResetPageMapState();
+}
+
+void RecorderController::OnUserClickFromRenderer(base::Value::Dict click) {
+  // Gate on globalSiteMap; if overlay isn’t initialized, ignore.
+  if (!is_recording_ && !global_site_map_initialized_) {
+    LOG(INFO) << "[Recorder] Ignoring user_click (not recording / no globalSiteMap)";
+    return;
+  }
+  dashboard::PageMapExtractor extractor;
+  dashboard::PageElementSnapshot snap;
+  if (const std::string* css = click.FindString("css")) snap.css_selector = *css;
+  if (const std::string* xp = click.FindString("xpath")) snap.xpath = *xp;
+  if (const base::Value::List* locs = click.FindList("locators")) {
+    snap.locator_bundle = locs->Clone();
+  }
+  if (const std::string* acc = click.FindString("accessibility_name"))
+    snap.accessibility_name = *acc;
+  if (const std::string* role = click.FindString("role"))
+    snap.role = *role;
+  if (auto disabled = click.FindBool("is_disabled"))
+    snap.disabled = *disabled;
+  if (const std::string* sh = click.FindString("shadow_chain")) {
+    snap.shadow_chain_selector = *sh;
+    snap.in_shadow_dom = !sh->empty();
+  }
+  if (const std::string* fid = click.FindString("frame_id")) snap.frame_id = *fid;
+  if (auto xi = click.FindInt("x")) if (auto yi = click.FindInt("y")) {
+    snap.bounds = gfx::RectF(static_cast<float>(*xi), static_cast<float>(*yi), 1.0f, 1.0f);
+  }
+  snap.type = "clickable";
+  snap.clickable = true;
+  extractor.AddElement(std::move(snap));
+  base::Value::Dict pagemap = extractor.BuildPageMap();
+  // Tag for overlay context
+  pagemap.Set("url", current_url_);
+  DispatchPageMapResult(std::move(pagemap));
+
+  // Also append a simple 'click' action to the timeline when recording.
+  if (is_recording_) {
+    base::Value::Dict action;
+    action.Set("action", "click");
+    base::Value::Dict params;
+    // Prefer locator bundle if present
+    if (const base::Value::List* locs = click.FindList("locators")) {
+      params.Set("locators", locs->Clone());
+    } else {
+      base::Value::List locs2;
+      if (const std::string* css = click.FindString("css")) {
+        base::Value::Dict l; l.Set("type", "CSS_SELECTOR"); l.Set("value", *css); locs2.Append(std::move(l));
+      }
+      if (const std::string* xp = click.FindString("xpath")) {
+        base::Value::Dict l; l.Set("type", "XPATH"); l.Set("value", *xp); locs2.Append(std::move(l));
+      }
+      if (!locs2.empty()) params.Set("locators", std::move(locs2));
+    }
+    if (auto xi = click.FindInt("x")) params.Set("x", *xi);
+    if (auto yi = click.FindInt("y")) params.Set("y", *yi);
+    if (auto xi = click.FindInt("x"))
+      if (auto yi = click.FindInt("y"))
+        last_user_click_point_ = gfx::Point(*xi, *yi);
+    if (const std::string* fid = click.FindString("frame_id"))
+      params.Set("frame_id", *fid);
+    if (auto dom_node_id = click.FindInt("dom_node_id"))
+      params.Set("dom_node_id", *dom_node_id);
+    if (const std::string* acc = click.FindString("accessibility_name"))
+      params.Set("accessibility_name", *acc);
+    if (const std::string* role = click.FindString("role"))
+      params.Set("role", *role);
+    if (auto disabled = click.FindBool("is_disabled"))
+      params.Set("disabled", *disabled);
+    AugmentClickParamsFromAgentSnapshot(params, click);
+    action.Set("params", std::move(params));
+    AppendRecordedAction(std::move(action));
+  }
+}
+
+void RecorderController::OnAgentStateSnapshotFromRenderer(
+    dashboard::mojom::AgentStateSnapshotPtr snapshot) {
+  if (!snapshot)
+    return;
+  LOG(INFO) << "[Recorder] AgentStateSnapshot url=" << snapshot->url
+            << " elements=" << snapshot->elements.size();
+
+  // Ignore snapshots coming from the overlay/newtab itself; we only want the
+  // active target page. This prevents the overlay DOM from replacing the
+  // usable PageMap/agent context.
+  if (base::StartsWith(snapshot->url, "chrome://dashboard",
+                       base::CompareCase::INSENSITIVE_ASCII) ||
+      base::StartsWith(snapshot->url, "chrome://new-tab-page",
+                       base::CompareCase::INSENSITIVE_ASCII) ||
+      base::StartsWith(snapshot->url, "chrome://newtab",
+                       base::CompareCase::INSENSITIVE_ASCII)) {
+    LOG(INFO) << "[Recorder] Ignoring overlay/newtab snapshot";
+    return;
+  }
+
+  if (!target_main_frame_token_.empty() &&
+      snapshot->frame_token != target_main_frame_token_) {
+    LOG(INFO) << "[Recorder] Ignoring snapshot from non-target frame token="
+              << snapshot->frame_token;
+    return;
+  }
+
+  auto snapshot_value = AgentSnapshotToValue(*snapshot);
+  last_agent_state_snapshot_value_ = snapshot_value.Clone();
+  last_agent_state_snapshot_ = snapshot->Clone();
+  if (!snapshot->url.empty())
+    current_url_ = snapshot->url;
+
+  base::Value::Dict payload;
+  payload.Set("type", "agent_snapshot");
+  payload.Set("detail", std::move(snapshot_value));
+  std::string json;
+  base::JSONWriter::Write(payload, &json);
+  UpdateOverlayWithPayload(json);
+
+  // Also surface a lightweight PageMap-style snapshot derived from the
+  // AgentStateSnapshot so the overlay PageMap tab has data even when the full
+  // DevTools-based PageMap extraction is not available.
+  base::Value::Dict pagemap;
+  pagemap.Set("url", last_agent_state_snapshot_->url);
+  pagemap.Set("timestamp",
+              static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  base::Value::List frames;
+  base::Value::Dict frame;
+  frame.Set("url", last_agent_state_snapshot_->url);
+  if (last_agent_state_snapshot_value_) {
+    if (const base::Value::List* els =
+            last_agent_state_snapshot_value_->FindList("elements")) {
+      // Keep the overlay compact: show only the first N elements while the
+      // agent still receives the full snapshot.
+      constexpr size_t kOverlayMaxElements = 30;
+      if (els->size() > kOverlayMaxElements) {
+        base::Value::List trimmed;
+        size_t count = 0;
+        for (const auto& el : *els) {
+          trimmed.Append(el.Clone());
+          if (++count >= kOverlayMaxElements)
+            break;
+        }
+        frame.Set("elements", std::move(trimmed));
+      } else {
+        frame.Set("elements", els->Clone());
+      }
+    }
+  }
+  frame.Set("shadowRoots", base::Value::List());
+  frames.Append(std::move(frame));
+  pagemap.Set("frames", std::move(frames));
+  base::Value::Dict meta;
+  if (last_agent_state_snapshot_) {
+    meta.Set("viewport_width", last_agent_state_snapshot_->viewport_width);
+    meta.Set("viewport_height", last_agent_state_snapshot_->viewport_height);
+    meta.Set("scroll_x", last_agent_state_snapshot_->scroll_x);
+    meta.Set("scroll_y", last_agent_state_snapshot_->scroll_y);
+  }
+  meta.Set("source", "agent_snapshot");
+  pagemap.Set("metadata", std::move(meta));
+  DispatchPageMapResult(std::move(pagemap));
+}
+
+const dashboard::mojom::AgentElementInfo*
+RecorderController::FindMatchingAgentElement(
+    const base::Value::Dict& click) const {
+  return FindBestElementMatch(last_agent_state_snapshot_.get(), click);
+}
+
+void RecorderController::AugmentClickParamsFromAgentSnapshot(
+    base::Value::Dict& params,
+    const base::Value::Dict& click) {
+  const auto* element = FindMatchingAgentElement(click);
+  if (!element)
+    return;
+  if (!element->frame_token.empty())
+    params.Set("frame_id", element->frame_token);
+  if (!element->shadow_chain_selector.empty())
+    params.Set("shadow_chain", element->shadow_chain_selector);
+  if (!element->resource_path.empty())
+    params.Set("resource_path", element->resource_path);
+  if (!element->tag.empty())
+    params.Set("tag", element->tag);
+  if (!element->role.empty())
+    params.Set("role", element->role);
+  base::Value::Dict flags;
+  flags.Set("visible", element->visible);
+  flags.Set("clickable", element->clickable);
+  flags.Set("focusable", element->focusable);
+  flags.Set("editable", element->editable);
+  flags.Set("disabled", element->disabled);
+  flags.Set("in_shadow_tree", element->in_shadow_tree);
+  params.Set("agent_flags", std::move(flags));
+  params.Set("agent_element_id", element->id);
+}
+
+std::optional<base::Value::Dict>
+RecorderController::BuildElementReportForIndex(int index) const {
+  if (index < 0)
+    return std::nullopt;
+  if (!last_agent_state_snapshot_value_)
+    return std::nullopt;
+
+  const base::Value::Dict& snapshot = *last_agent_state_snapshot_value_;
+  const base::Value::List* elements = snapshot.FindList("elements");
+  if (!elements)
+    return std::nullopt;
+
+  if (index >= static_cast<int>(elements->size()))
+    return std::nullopt;
+
+  const base::Value& el_value = (*elements)[index];
+  if (!el_value.is_dict())
+    return std::nullopt;
+
+  base::Value::Dict report;
+  if (const std::string* url = snapshot.FindString("url"))
+    report.Set("url", *url);
+  report.Set("index", index);
+  report.Set("element", el_value.GetDict().Clone());
+  return report;
+}
+
+void RecorderController::RequestActionSnapshotAtPoint(int x_css,
+                                                      int y_css,
+                                                      bool mark_hovered) {
+  if (!target_web_contents_)
+    return;
+  content::RenderFrameHost* rfh = target_web_contents_->GetPrimaryMainFrame();
+  if (!rfh)
+    return;
+  mojo::AssociatedRemote<dashboard::mojom::StealthyElementResolver> stealth;
+  rfh->GetRemoteAssociatedInterfaces()->GetInterface(&stealth);
+  if (!stealth.is_bound())
+    return;
+  auto weak = weak_factory_.GetWeakPtr();
+  stealth->CollectActionSnapshot(
+      x_css, y_css, mark_hovered,
+      base::BindOnce(
+          [](base::WeakPtr<RecorderController> weak,
+             dashboard::mojom::AgentStateSnapshotPtr snapshot) {
+            if (weak && snapshot)
+              weak->OnAgentStateSnapshotFromRenderer(std::move(snapshot));
+          },
+          weak));
+}
+
+void RecorderController::EvaluateJS(
+    const std::string& expression,
+    base::OnceCallback<void(std::string /*result_json*/,
+                            std::string /*error_json*/)> cb) {
+  if (!agent_host_ || !devtools_client_) {
+    std::move(cb).Run(std::string(), std::string("{\"message\":\"not attached\"}"));
+    return;
+  }
+  base::Value::Dict params;
+  params.Set("expression", expression);
+  params.Set("includeCommandLineAPI", true);
+  SendCommandExpectResponse(
+      "Runtime.evaluate", std::move(params),
+      base::BindOnce(
+          [](base::OnceCallback<void(std::string, std::string)> cb,
+             std::string res_json, std::string err_json) {
+            std::move(cb).Run(std::move(res_json), std::move(err_json));
+          },
+          std::move(cb)));
+}
+
+void RecorderController::CaptureScreenshot(
+    base::OnceCallback<void(std::string /*base64_png*/)> cb) {
+  if (!agent_host_ || !devtools_client_) {
+    std::move(cb).Run(std::string());
+    return;
+  }
+
+  // Compute a square clip region based on the current viewport so that
+  // screenshots are normalized to 448x448 while still reflecting the
+  // desktop layout (no forced window resize here).
+  int vw = 0;
+  int vh = 0;
+  if (target_web_contents_) {
+    if (auto* view = target_web_contents_->GetRenderWidgetHostView()) {
+      gfx::Rect bounds = view->GetViewBounds();
+      vw = bounds.width();
+      vh = bounds.height();
+    }
+  }
+
+  base::Value::Dict params;
+  params.Set("format", "png");
+  params.Set("fromSurface", true);
+
+  const int side = (vw > 0 && vh > 0) ? std::min(vw, vh) : 0;
+  if (side > 0) {
+    const int clip_x = (vw > side) ? (vw - side) / 2 : 0;
+    const int clip_y = 0;  // focus on above-the-fold content
+    const double scale = 448.0 / static_cast<double>(side);
+
+    base::Value::Dict clip;
+    clip.Set("x", clip_x);
+    clip.Set("y", clip_y);
+    clip.Set("width", side);
+    clip.Set("height", side);
+    clip.Set("scale", scale);
+    params.Set("clip", std::move(clip));
+  }
+
+  SendCommandExpectResponse(
+      "Page.captureScreenshot", std::move(params),
+      base::BindOnce(
+          [](base::OnceCallback<void(std::string)> cb,
+             std::string res_json, std::string /*err_json*/) {
+            std::string out;
+            if (!res_json.empty()) {
+              std::optional<base::Value> v = base::JSONReader::Read(
+                  res_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+              if (v && v->is_dict()) {
+                const base::Value::Dict& d = v->GetDict();
+                if (const std::string* data = d.FindString("data"))
+                  out = *data;
+              }
+            }
+            std::move(cb).Run(std::move(out));
+          },
+          std::move(cb)));
+}
+
+void RecorderController::SendCommand(const std::string& method,
+                                     base::Value::Dict params) {
+  if (!agent_host_ || !devtools_client_)
+    return;
+  const int id = next_command_id_++;
+  base::Value::Dict msg;
+  msg.Set("id", id);
+  msg.Set("method", method);
+  msg.Set("params", std::move(params));
+  std::string json;
+  base::JSONWriter::Write(msg, &json);
+  agent_host_->DispatchProtocolMessage(devtools_client_.get(), base::as_byte_span(json));
+}
+
+int RecorderController::SendCommandExpectResponse(
+    const std::string& method,
+    base::Value::Dict params,
+    base::OnceCallback<void(std::string, std::string)> cb) {
+  if (!agent_host_ || !devtools_client_) {
+    std::move(cb).Run(std::string(), std::string("{\"message\":\"not attached\"}"));
+    return -1;
+  }
+  const int id = next_command_id_++;
+  pending_eval_[id] = std::move(cb);
+  base::Value::Dict msg;
+  msg.Set("id", id);
+  msg.Set("method", method);
+  msg.Set("params", std::move(params));
+  std::string json;
+  base::JSONWriter::Write(msg, &json);
+  agent_host_->DispatchProtocolMessage(devtools_client_.get(), base::as_byte_span(json));
+  return id;
+}
+
+void RecorderController::OnDevToolsResponse(int id,
+                                            base::Value::Dict result,
+                                            base::Value::Dict error) {
+  auto it = pending_eval_.find(id);
+  if (it == pending_eval_.end())
+    return;
+  auto cb = std::move(it->second);
+  pending_eval_.erase(it);
+  std::string res_json;
+  std::string err_json;
+  base::JSONWriter::Write(result, &res_json);
+  base::JSONWriter::Write(error, &err_json);
+  if (cb)
+    std::move(cb).Run(std::move(res_json), std::move(err_json));
+}
+
+void RecorderController::StartPageMapCaptureDevTools(content::WebContents* wc) {
+  if (!wc) {
+    HandlePageMapFailure("no_web_contents");
+    return;
+  }
+  if (!agent_host_ || !devtools_client_) {
+    HandlePageMapFailure("not_attached");
+    return;
+  }
+
+  // Quick JS-based sweep for interactive nodes; avoids DevTools accessibility
+  // domain and works even when AX events are empty.
+  std::string js = R"( (function(){
+    const sels = 'a,button,input,textarea,select,[role=\"button\"],[role=\"link\"],[onclick]';
+    const arr = [];
+    const now = Date.now();
+    document.querySelectorAll(sels).forEach(el=>{
+      try{
+        const r = el.getBoundingClientRect();
+        if (!r || r.width<=0 || r.height<=0) return;
+        const role = (el.getAttribute && el.getAttribute('role')) || '';
+        const tag = (el.tagName||'').toLowerCase();
+        const name = (el.getAttribute && el.getAttribute('aria-label')) || '';
+        const txt = (el.innerText||el.value||'').trim();
+        arr.push({tag, role, name, text: txt,
+                  x:Math.round(r.left), y:Math.round(r.top),
+                  w:Math.round(r.width), h:Math.round(r.height)});
+      }catch(_){}
+    });
+    return { ok:true, url: location.href, timestamp: now, elements: arr };
+  })() )";
+
+  base::Value::Dict params;
+  params.Set("expression", js);
+  params.Set("includeCommandLineAPI", true);
+  params.Set("returnByValue", true);
+  SendCommandExpectResponse(
+      "Runtime.evaluate", std::move(params),
+      base::BindOnce(&RecorderController::OnRuntimePageMapEval,
+                     weak_factory_.GetWeakPtr()));
+  LOG(INFO) << "[Recorder] PageMap DevTools fallback dispatched";
+}
+
+void RecorderController::OnRuntimePageMapEval(std::string res_json,
+                                              std::string err_json) {
+  dashboard::PageMapExtractor ext;
+  int added = 0;
+  std::optional<base::Value> val = ExtractRuntimeValue(res_json);
+  if (!val && !err_json.empty()) {
+    LOG(WARNING) << "[Recorder] Runtime PageMap eval error: " << err_json;
+  }
+  if (val && val->is_string()) {
+    val = base::JSONReader::Read(val->GetString(),
+                                 base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  }
+  if (val && val->is_dict()) {
+    const base::Value::Dict& inner_dict = val->GetDict();
+    if (const std::string* url = inner_dict.FindString("url"))
+      ext.set_url(GURL(*url));
+    if (auto ts_double = inner_dict.FindDouble("timestamp"))
+      ext.set_timestamp_ms(static_cast<int64_t>(*ts_double));
+    if (const base::Value::List* els = inner_dict.FindList("elements")) {
+      for (const auto& v : *els) {
+        if (!v.is_dict())
+          continue;
+        const base::Value::Dict& e = v.GetDict();
+        dashboard::PageElementSnapshot s;
+        if (const std::string* tag = e.FindString("tag")) s.tag = *tag;
+        if (const std::string* role = e.FindString("role")) s.role = *role;
+        if (const std::string* name = e.FindString("name")) s.accessibility_name = *name;
+        if (const std::string* text = e.FindString("text")) s.text = *text;
+        int x = e.FindInt("x").value_or(0), y = e.FindInt("y").value_or(0);
+        int w = e.FindInt("w").value_or(0), h = e.FindInt("h").value_or(0);
+        s.bounds = gfx::RectF(x, y, w, h);
+        s.clickable = true;
+        base::Value::List locs;
+        if (s.accessibility_name.size()) { base::Value::Dict l; l.Set("type","ACCESSIBILITY_NAME"); l.Set("value", s.accessibility_name); locs.Append(std::move(l)); }
+        if (s.text.size()) { base::Value::Dict l; l.Set("type","TEXT_CONTENT"); l.Set("value", s.text); locs.Append(std::move(l)); }
+        if (s.tag.size()) { base::Value::Dict l; l.Set("type","TAG_NAME"); l.Set("value", s.tag); locs.Append(std::move(l)); }
+        if (!locs.empty()) s.locator_bundle = std::move(locs);
+        ext.AddElement(std::move(s));
+        ++added;
+      }
+    }
+  }
+
+  base::Value::Dict pagemap = ext.BuildPageMap();
+  size_t frames_count =
+      pagemap.FindList("frames") ? pagemap.FindList("frames")->size() : 0;
+  LOG(INFO) << "[Recorder] Runtime PageMap frames=" << frames_count
+            << " elements=" << added;
+  DispatchPageMapResult(std::move(pagemap));
+  DashboardUIMessageHandler::BroadcastAiDone("pagemap_stream", true, "");
+  ResetPageMapState();
+}
