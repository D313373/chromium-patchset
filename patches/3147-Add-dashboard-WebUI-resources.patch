+      }
+      case 'VISUAL_AI': return [];
+      case 'FRAME_ID': return [];
+      case 'RESOURCE_TREE': return [];
+      default: return [];
+    }
+  }
+  let elem=null;
+  for (const loc of locators) {
+    // Direct coordinate click support: {type:'VISUAL_COORDS', value:'{"x":100,"y":200}'}
+    if (loc.type === 'VISUAL_COORDS') {
