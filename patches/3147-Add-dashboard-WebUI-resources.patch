+function initAiConsole(config) {
+  const historyEl = $(config.historyElId);
+  const inputEl = $(config.inputElId);
+  const sendBtn = $(config.sendBtnElId);
+
+  // API Key inputs are no longer used
+  if (!historyEl || !inputEl || !sendBtn) {
+    return;
+  }
+  
+  // Shared chat session ID (enables overlay/dashboard mirroring)
+  const sessionId = String(config.mirrorSessionId || window.__DASHBOARD_SHARED_CHAT_ID || 'dashboard_shared_chat');
+
+  // Persist message history per-session using localStorage so the overlay and
+  // dashboard share the same conversation context.
+  const historyKey = `dash.chat.${sessionId}`;
+  let messageHistory = [];
+  try {
+    const stored = localStorage.getItem(historyKey);
+    if (stored) messageHistory = JSON.parse(stored) || [];
+  } catch (_) {}
+  const persistHistory = () => {
+    try { localStorage.setItem(historyKey, JSON.stringify(messageHistory)); } catch (_) {}
+  };
+
+  // Simple cubby helpers for cross-session memory.
+  const cubbyKey = 'dash.agent.cubby';
+  const Cubby = {
+    read: () => { try { return localStorage.getItem(cubbyKey) || ''; } catch (_) { return ''; } },
+    write: (text) => { try { localStorage.setItem(cubbyKey, String(text || '')); return true; } catch (_) { return false; } }
+  };
+
+  const appendMessage = (role, text) => {
+    const box = document.createElement('div');
+    if (config.historyElId.startsWith('ov-')) {
+      // Overlay styles
+      box.style.cssText = 'white-space:pre-wrap;margin:4px 0;padding:6px;border-radius:4px;color:#00ff7f;text-shadow:0 0 6px rgba(0,255,170,0.6),0 0 12px rgba(0,255,170,0.3)';
+    } else {
+      // Dashboard styles
+      box.className = 'msg';
+      box.style.cssText = 'padding:8px;margin:6px 0;border-radius:6px;white-space:pre-wrap;';
+      box.style.background = role === 'user' ? 'rgba(80,181,255,0.12)' : 'rgba(255,255,255,0.06)';
+    }
+    box.textContent = text;
+    historyEl.appendChild(box);
+    historyEl.scrollTop = historyEl.scrollHeight;
+    return box; // Return the element so we can stream into it
+  };
+  
+  // This is the "drivetrain" - sends JSON commands to the C++ backend,
+  // enforcing a single in-flight command to avoid multi-tab confusion.
+  const commandQueue = [];
+  let commandInFlight = false;
+  const dispatchNext = (command) => {
+    if (!command) return;
+    commandInFlight = true;
+    const finish = () => {
+      commandInFlight = false;
+      const next = commandQueue.shift();
+      if (next)
+        dispatchNext(next);
+    };
+
+    if (!command || !command.command || !command.payload) {
+      console.warn('AI tried to send invalid command:', command);
+      finish();
+      return;
+    }
+    
+    // Bridge the C++ ResolveCallback(cb_id, ...) result back into this JS
+    // context using a dynamically-registered window callback name.
+    const cbToken =
+        'dashCmd_' + Date.now() + Math.random().toString(36).slice(2);
+    const cb = (res) => {
+      console.log(`[Agent] Command '${command.command}' executed:`, res);
+      appendMessage('assistant', `[Agent] Command '${command.command}' executed.`);
+      try {
+        if (res && res.image) {
+          const img = document.createElement('img');
+          img.src = res.image;
+          img.style.maxWidth = '100%';
+          img.style.borderRadius = '6px';
+          const box = document.createElement('div');
+          box.style.margin = '6px 0';
+          box.appendChild(img);
+          const historyEl = $(config.historyElId);
+          if (historyEl) { historyEl.appendChild(box); historyEl.scrollTop = historyEl.scrollHeight; }
+        }
+      } catch (_) {}
+      try { delete window[cbToken]; } catch (_) {}
+      finish();
+    };
+    // Expose the callback entry point for the C++ side to call.
+    window[cbToken] = cb;
+
+    try {
+      switch (command.command) {
+        // Co-pilot helpers for Blink agent
+        case 'store_memento': {
+          const ok = Cubby.write(command.payload && command.payload.text);
+          cb({ ok });
+          return;
+        }
+        case 'read_memento': {
+          cb({ ok: true, text: Cubby.read() });
+          return;
+        }
+        case 'reset_agent': {
+          if (typeof window.__resetSharedAgentChat === 'function') window.__resetSharedAgentChat();
+          cb({ ok: true });
+          return;
+        }
+        case 'run_timeline':
+          console.log('[AI] Sending command: dashboardAgentRunTimeline', command.payload);
+          chrome.send('dashboardAgentRunTimeline', [cbToken, command.payload]);
+          break;
+        case 'call_action': {
+          // Normalize params before sending so that older or slightly
+          // inconsistent JSON shapes still map cleanly onto the C++ action
+          // schema used by ScriptExecutor.
+          const action = command.payload.action;
+          const rawParams = command.payload.params || {};
+          const params = normalizeAgentActionParams(action, rawParams);
+          console.log('[AI] Sending command: dashboardAgentCallAction', action, params);
+          chrome.send('dashboardAgentCallAction', [cbToken, action, params]);
+          break;
+        }
+        case 'eval_js':
+          console.log('[AI] Sending command: dashboardAgentEval', command.payload);
+          chrome.send('dashboardAgentEval', [cbToken, command.payload]);
+          break;
+        case 'refresh_pagemap':
+          console.log('[AI] Sending command: dashboardAgentRefreshPageMap');
+          chrome.send('dashboardAgentRefreshPageMap', [cbToken, command.payload || {}]);
+          break;
+        case 'reload_page':
+          console.log('[AI] Sending command: dashboardAgentReloadPage', command.payload || {});
+          chrome.send('dashboardAgentReloadPage', [cbToken, command.payload || {}]);
+          break;
+        case 'screenshot':
+          console.log('[AI] Sending command: dashboardAgentScreenshot');
+          chrome.send('dashboardAgentScreenshot', [cbToken, {}]);
+          break;
+        default:
+          console.warn('AI sent an unknown command:', command.command);
+          finish();
+          return;
+      }
+    } catch (e) {
+      console.error('Failed to send command to agent:', e);
+      appendMessage('assistant', `[Agent] Error sending command: ${e.message}`);
+      finish();
