diff --git a/chrome/browser/ui/webui/dashboard/actions/navigate_action.cc b/chrome/browser/ui/webui/dashboard/actions/navigate_action.cc
new file mode 100644
index 0000000000000000000000000000000000000000..fba149c4808c6e8d9fe858f26ef4d442fc32c475
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/navigate_action.cc
@@ -0,0 +1,212 @@
+#include "chrome/browser/ui/webui/dashboard/actions/navigate_action.h"
+
+#include <string>
+
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "net/base/net_errors.h"
+#include "net/base/url_util.h"
+#include "content/public/common/referrer.h"
+#include "services/network/public/mojom/referrer_policy.mojom.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "base/strings/utf_string_conversions.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace dashboard {
+namespace actions {
+
+namespace {
+
+constexpr char kDirectoryLinkId[] = "navigate-link";
+// External hosted directory page to avoid chrome:// execution restrictions.
+constexpr char kDirectoryPageUrl[] = "chrome://dashboard/directory.html";
+
+}  // namespace
+
+NavigateAction::NavigateAction(Profile* profile) : Action(profile) {}
+NavigateAction::~NavigateAction() = default;
+
+bool NavigateAction::SetParams(const base::Value::Dict& params) {
+  const std::string* url = params.FindString("url");
+  if (!url || !GURL(*url).is_valid())
+    return false;
+  url_ = *url;
+  // Optional: allow disabling spoofing or overriding referrer
+  if (auto spoof = params.FindBool("spoofReferrer")) spoof_referrer_ = *spoof;
+  if (const std::string* ref = params.FindString("referrer")) referrer_override_ = *ref;
+  // Enable timeline serialization for Navigate
+  base::Value::Dict p = params.Clone();
+  p.Set("url", url_);
+  SetSerializedAction("navigate", std::move(p));
+  return true;
+}
+
+class NavigateAction::NavigationWaiter : public content::WebContentsObserver {
+ public:
+  NavigationWaiter(content::WebContents* contents,
+                   const GURL& target_url,
+                   NavigateAction* owner)
+      : content::WebContentsObserver(contents),
+        target_url_(target_url),
+        owner_(owner) {}
+
+  ~NavigationWaiter() override = default;
+
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (!owner_ || navigation->GetWebContents() != web_contents())
+      return;
+    if (!navigation->IsInPrimaryMainFrame())
+      return;
+    if (!navigation->HasCommitted())
+      return;
+    if (navigation->GetURL() != target_url_)
+      return;
+
+    NavigateAction* owner = owner_.get();
+    owner_ = nullptr;
+    int net_error = navigation->GetNetErrorCode();
+    if (!navigation->HasCommitted() || net_error != net::OK) {
+      const std::string error_str =
+          net_error == net::OK ? "Navigation did not commit"
+                               : net::ErrorToShortString(net_error);
+      owner->OnNavigationFinished(false, error_str);
+      return;
+    }
+    owner->OnNavigationFinished(true, "");
+  }
+
+  void WebContentsDestroyed() override {
+    if (owner_) {
+      NavigateAction* owner = owner_.get();
+      owner_ = nullptr;
+      owner->OnNavigationFinished(false, "WebContents destroyed");
+    }
+  }
+
+ private:
+  GURL target_url_;
+  raw_ptr<NavigateAction> owner_;
+};
+
+void NavigateAction::Execute(content::WebContents* web_contents,
+                             Callback callback) {
+  if (!web_contents) {
+    std::move(callback).Run(false, "WebContents null");
+    return;
+  }
+  web_contents_ = web_contents;
+
+  if (url_.empty()) {
+    std::move(callback).Run(false, "No URL provided");
+    return;
+  }
+
+  GURL target(url_);
+  if (!target.is_valid()) {
+    std::move(callback).Run(false, "Invalid URL");
+    return;
+  }
+
+  link_id_ = kDirectoryLinkId;
+  directory_url_ = net::AppendQueryParameter(GURL(kDirectoryPageUrl), "url",
+                                             target.spec());
+  directory_url_ =
+      net::AppendQueryParameter(directory_url_, "id", link_id_);
+
+  LOG(INFO) << "[Action] Navigate::Execute directory loader url="
+            << directory_url_.spec();
+
+  navigation_waiter_.reset();
+  pending_callback_ = std::move(callback);
+
+  content::NavigationController::LoadURLParams load_params(directory_url_);
+  // Spoof a realistic referrer chain: Google Search -> directory page -> target
+  if (spoof_referrer_) {
+    GURL ref_url;
+    if (!referrer_override_.empty() && GURL(referrer_override_).is_valid()) {
+      ref_url = GURL(referrer_override_);
+    } else {
+      GURL google("https://www.google.com/search");
+      std::string q = target.host().empty() ? target.spec()
+                                            : std::string(target.host());
+      ref_url = net::AppendQueryParameter(google, "q", q);
+    }
+    load_params.referrer = content::Referrer(ref_url, network::mojom::ReferrerPolicy::kStrictOriginWhenCrossOrigin);
+    load_params.transition_type = ui::PAGE_TRANSITION_LINK;
+  } else {
+    load_params.transition_type = ui::PAGE_TRANSITION_TYPED;
+  }
+  web_contents->GetController().LoadURLWithParams(load_params);
+
+  navigation_waiter_ =
+      std::make_unique<NavigationWaiter>(web_contents, directory_url_, this);
+}
+
+void NavigateAction::OnNavigationFinished(bool success,
+                                          const std::string& error) {
+  navigation_waiter_.reset();
+  if (!success) {
+    auto cb = std::move(pending_callback_);
+    if (cb) std::move(cb).Run(false, error);
+    return;
+  }
+
+  if (phase_ == Phase::kDirectory) {
+    LOG(INFO) << "[Action] Navigate directory committed for link id=" << link_id_;
+    // After 2s, click the link (for UX) and navigate programmatically with a spoofed referrer
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&NavigateAction::ClickDirectoryLinkAndNavigate,
+                       weak_factory_.GetWeakPtr()),
+        base::Milliseconds(2000));
+    return;  // do not fulfill callback yet; wait for final target commit
+  }
+
+  // Phase: target page committed after programmatic navigation
+  auto cb = std::move(pending_callback_);
+  if (cb) std::move(cb).Run(true, "");
+}
+
+void NavigateAction::ClickDirectoryLinkAndNavigate() {
+  if (!web_contents_) {
+    auto cb = std::move(pending_callback_);
+    if (cb) std::move(cb).Run(false, "WebContents lost");
+    return;
+  }
+  // Best-effort visual click on the directory link
+  std::string js = "(function(){try{var e=document.getElementById('" + std::string(kDirectoryLinkId) + "'); if(e){e.click(); return true;} }catch(_){ } return false; })();";
+  if (auto* rf = web_contents_->GetPrimaryMainFrame()) {
+    rf->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
+  }
+
+  // Now navigate to the target URL with a spoofed referrer (Google search)
+  GURL target(url_);
+  content::NavigationController::LoadURLParams load_params(target);
+  if (spoof_referrer_) {
+    GURL ref_url;
+    if (!referrer_override_.empty() && GURL(referrer_override_).is_valid()) {
+      ref_url = GURL(referrer_override_);
+    } else {
+      GURL google("https://www.google.com/search");
+      std::string q = target.host().empty() ? target.spec()
+                                            : std::string(target.host());
+      ref_url = net::AppendQueryParameter(google, "q", q);
+    }
+    load_params.referrer = content::Referrer(ref_url, network::mojom::ReferrerPolicy::kStrictOriginWhenCrossOrigin);
+    load_params.transition_type = ui::PAGE_TRANSITION_LINK;
+  } else {
+    load_params.transition_type = ui::PAGE_TRANSITION_TYPED;
+  }
+  web_contents_->GetController().LoadURLWithParams(load_params);
+  phase_ = Phase::kTargetAfterClick;
+  navigation_waiter_ = std::make_unique<NavigationWaiter>(web_contents_, target, this);
+}
+
+}  // namespace actions
+}  // namespace dashboard
