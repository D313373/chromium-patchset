+// chrome/browser/ui/webui/dashboard/click_handler.h
+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_CLICK_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_CLICK_HANDLER_H_
+
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/webui/dashboard/actions/action_types.h"  // for Locator, Element
+#include "content/public/browser/web_contents.h"
+
+namespace dashboard {
+
+class ClickHandler {
+ public:
+  explicit ClickHandler(content::WebContents* web_contents);
+  ~ClickHandler();
+
+  // High-level entry points used by ClickAction/others.
+  // These return true when the injection sequence was performed (not necessarily that
+  // the page responded to it).
+  bool ExecuteClick(const std::vector<dashboard::Locator>& locators,
+                    int wait_timeout_ms,
+                    bool use_human_offset,
+                    int click_count);
+
+  bool ExecuteClickAt(int center_x,
+                      int center_y,
+                      bool use_human_offset,
+                      int click_count);
+
+ private:
+  // Move the synthetic cursor from (x0,y0) to (x1,y1) in a human-like fashion
+  // by emitting a small number of intermediate mousemove events. This is
+  // synchronous but non-blocking (no sleeps).
+  void MoveCursorHumanLike(int x0, int y0, int x1, int y1);
+
+  // Resolve the element coordinates via JS or other mechanisms.
+  bool ResolveElement(const std::vector<dashboard::Locator>& locators,
+                      dashboard::Element& outElement);
+
+  bool ResolveElementWithJavaScript(const std::vector<dashboard::Locator>& locators,
+                                    dashboard::Element& outElement);
+  bool ResolveElementWithCDP(const std::vector<dashboard::Locator>& locators,
+                             dashboard::Element& outElement);
+
+  // cached WebContents (not owned)
+  raw_ptr<content::WebContents, DanglingUntriaged> web_contents_;
+
+  // cached cursor position — preserved across clicks. Negative values mean "not initialized yet".
+  int cursorX_;
+  int cursorY_;
+};
