diff --git a/chrome/browser/ui/webui/dashboard/actions/scrape_table_action.cc b/chrome/browser/ui/webui/dashboard/actions/scrape_table_action.cc
new file mode 100644
index 0000000000000000000000000000000000000000..ead5762fa4c2c7ba02586772cda5a5aead958fc2
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/scrape_table_action.cc
@@ -0,0 +1,215 @@
+#include "chrome/browser/ui/webui/dashboard/actions/scrape_table_action.h"
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/run_loop.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/webui/dashboard/actions/locator_resolver.h"
+#include "chrome/browser/ui/webui/dashboard/debug_config.h"
+
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/isolated_world_ids.h"
+
+namespace {
+// Helper function to convert the JSON-like 'fields' list into our C++ struct
+// vector. This is based on the data structure from scrapeTableEditor.js.
+std::vector<dashboard::ScrapeTableField> ConvertFields(
+    const base::Value::List& fields_list) {
+  std::vector<dashboard::ScrapeTableField> result;
+  for (const auto& field_value : fields_list) {
+    if (const base::Value::Dict* field_dict = field_value.GetIfDict()) {
+      dashboard::ScrapeTableField field;
+      const std::string* name = field_dict->FindString("name");
+      const base::Value::List* locators = field_dict->FindList("locators");
+      if (name && locators) {
+        field.name = *name;
+        field.locators = dashboard::ConvertLocators(*locators);
+
+        const base::Value::List* rules = field_dict->FindList("findReplace");
+        if (rules) {
+          field.find_replace_rules = dashboard::ConvertFindReplace(*rules);
+        }
+        result.push_back(std::move(field));
+      }
+    }
+  }
+  return result;
+}
+}  // namespace
+
+ScrapeTableAction::ScrapeTableAction(Profile* profile)
+    : dashboard::actions::Action(profile) {}
+ScrapeTableAction::~ScrapeTableAction() = default;
+
+bool ScrapeTableAction::SetParams(const base::Value::Dict& params) {
+  const std::string* variableName = params.FindString("variableName");
+  const base::Value::List* fieldsList = params.FindList("fields");
+  if (!variableName || !fieldsList) {
+    return false;
+  }
+  variable_name_ = *variableName;
+  fields_ = ConvertFields(*fieldsList);
+  SetSerializedAction("scrape_table", params.Clone());
+  return true;
+}
+
+void ScrapeTableAction::Execute(content::WebContents* web_contents,
+                                Callback callback) {
+  // This JS function will be executed on the page to scrape the table.
+  // It iterates through all `tr` elements. For each row, it finds the data
+  // for each column using the provided locators and returns a JSON string
+  // of the resulting data array.
+  const std::string js_function = R"(
+     function scrapeTable(fields) {
+       const rows = Array.from(document.querySelectorAll('tr'));
+       const results = [];
+
+       function findElement(contextNode, locators) {
+         for (const locator of locators) {
+           let element = null;
+           try {
+             switch (locator.type) {
+               case 'CSS_SELECTOR': element = contextNode.querySelector(locator.value); break;
+               case 'XPATH': element = document.evaluate(locator.value, contextNode, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue; break;
+               // Add other locator types as needed
+             }
+           } catch(e) { continue; }
+           if (element) return element;
+         }
+         return null;
+       }
+
+       for (const row of rows) {
+         const rowData = {};
+         let hasData = false;
+         for (const field of fields) {
+           const cellElement = findElement(row, field.locators);
+           if (cellElement) {
+             rowData[field.name] = cellElement.innerText;
+             hasData = true;
+           } else {
+             rowData[field.name] = null;
+           }
+         }
+         if (hasData) {
+           results.push(rowData);
+         }
+       }
+       return JSON.stringify(results);
+     }
+   )";
+
+  base::Value::List fields_json;
+  for (const auto& field : fields_) {
+    base::Value::Dict field_dict;
+    field_dict.Set("name", field.name);
+    base::Value::List locators_list;
+    for (const auto& loc : field.locators) {
+      locators_list.Append(dashboard::LocatorToValue(loc));
+    }
+    field_dict.Set("locators", std::move(locators_list));
+    fields_json.Append(std::move(field_dict));
+  }
+  std::string fields_json_str;
+  base::JSONWriter::Write(fields_json, &fields_json_str);
+
+  std::string final_script = js_function + "scrapeTable(" + fields_json_str + ");";
+
+  // Choose a representative frame asynchronously by resolving the first field's locators.
+  if (!fields_.empty() && !fields_.front().locators.empty()) {
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "[ScrapeTable] resolving representative field in any frame (" << fields_.front().locators.size() << ")";
+    }
+    resolver_ = std::make_unique<dashboard::LocatorResolver>(web_contents);
+    resolver_->ResolveUniqueAsync(
+        fields_.front().locators,
+        dashboard::SearchScope::kAll,
+        /*timeout_ms=*/2000,
+        base::BindOnce(&ScrapeTableAction::OnRepresentativeResolved,
+                       weak_ptr_factory_.GetWeakPtr(),
+                       web_contents,
+                       final_script,
+                       std::move(callback)));
+    return;
+  }
+
+  // No representative locators; run in primary frame
+  content::RenderFrameHost* target_rfh = web_contents->GetPrimaryMainFrame();
+  target_rfh->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(final_script),
+      base::BindOnce(&ScrapeTableAction::OnJavaScriptExecuted,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)),
+      content::ISOLATED_WORLD_ID_CONTENT_END);
+}
+
+void ScrapeTableAction::OnJavaScriptExecuted(Callback callback,
+                                             base::Value result) {
+  if (!result.is_string()) {
+    std::move(callback).Run(false, "Failed to scrape table: JS did not return a string.");
+    return;
+  }
+
+  // At this point, `result` is a JSON string of the scraped data.
+  // Now, we apply the find-and-replace rules.
+  std::optional<base::Value> parsed_json = base::JSONReader::Read(
+      result.GetString(), base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed_json || !parsed_json->is_list()) {
+    std::move(callback).Run(false, "Failed to parse scraped table data.");
+    return;
+  }
+
+  base::Value::List& rows = parsed_json->GetList();
+  for (auto& row_value : rows) {
+    if (row_value.is_dict()) {
+      base::Value::Dict& row_dict = row_value.GetDict();
+      for(const auto& field : fields_) {
+        std::string* cell_value = row_dict.FindString(field.name);
+        if (cell_value) {
+          for(const auto& rule : field.find_replace_rules) {
+            base::ReplaceSubstringsAfterOffset(cell_value, 0, rule.find, rule.replace);
+          }
+        }
+      }
+    }
+  }
+
+  std::string final_json_string;
+  base::JSONWriter::Write(*parsed_json, &final_json_string);
+
+  std::move(callback).Run(true, final_json_string);
+}
+
+void ScrapeTableAction::OnRepresentativeResolved(content::WebContents* web_contents,
+                                                 const std::string& final_script,
+                                                 Callback callback,
+                                                 bool success,
+                                                 const dashboard::ResolvedElement& el,
+                                                 const std::string& error) {
+  // Release resolver now that we have a decision
+  resolver_.reset();
+
+  content::RenderFrameHost* target_rfh = web_contents ? web_contents->GetPrimaryMainFrame() : nullptr;
+  if (success) {
+    if (content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(el.frame_id)) {
+      if (rfh->IsRenderFrameLive()) target_rfh = rfh;
+    }
+  } else {
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(WARNING) << "[ScrapeTable] representative resolution failed: " << error << "; falling back to primary frame";
+    }
+  }
+  if (!target_rfh) {
+    std::move(callback).Run(false, "No target frame available");
+    return;
+  }
+
+  target_rfh->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(final_script),
+      base::BindOnce(&ScrapeTableAction::OnJavaScriptExecuted,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)),
+      content::ISOLATED_WORLD_ID_CONTENT_END);
+}
