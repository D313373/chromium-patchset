+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_LOCATOR_RESOLVER_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_LOCATOR_RESOLVER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/dashboard/actions/action_types.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/web_contents.h"
+
+namespace dashboard {
+
+// Scope for TEXT_CONTENT search, etc.
+enum class SearchScope { kInteractiveOnly, kAll };
+
+struct ResolvedElement {
+  int center_x = 0;
+  int center_y = 0;
+  content::GlobalRenderFrameHostId frame_id;
+};
+
+// Resolves a unique element based on a list of locators using a single JS batch
+// per frame. JS runs read-only (no mutations) to minimize detection surface.
+class LocatorResolver {
+ public:
+  using ResolveCallback = base::OnceCallback<void(bool success,
+                                                   const ResolvedElement& element,
+                                                   const std::string& error)>;
+
+  explicit LocatorResolver(content::WebContents* web_contents);
+  ~LocatorResolver();
+
+  // Async version: Attempts to resolve a unique element without blocking.
+  // Calls callback with (success, element, error) when complete or timeout.
+  // If timeout_ms > 0, will poll every ~100ms until timeout.
+  void ResolveUniqueAsync(const std::vector<Locator>& locators,
+                          SearchScope scope,
+                          int timeout_ms,
+                          ResolveCallback callback);
+
+  // Cancel any pending async resolution
+  void Cancel();
+
+ private:
+  // Async helpers
+  void TryResolveOnceAsync(const std::vector<Locator>& locators,
+                           SearchScope scope);
+  void OnFrameSelectComplete(size_t frame_index,
+                             const std::vector<Locator>& locators,
+                             SearchScope scope,
+                             base::Value result);
+  void CheckTimeout();
+  void ScheduleNextPoll();
+
+  // Quick ID path result handler and full query starter
+  void OnQuickIdResult(base::Value v);
+  void StartFullQuery(const std::vector<Locator>& locators,
+                      SearchScope scope);
+
+  raw_ptr<content::WebContents> web_contents_ = nullptr;
+
+  // Async state
+  ResolveCallback async_callback_;
+  base::TimeTicks async_start_time_;
+  base::TimeDelta async_timeout_;
+  std::vector<Locator> async_locators_;
+  SearchScope async_scope_ = SearchScope::kAll;
+  bool cancelled_ = false;
+  int pending_frame_queries_ = 0;
+  std::vector<content::RenderFrameHost*> frames_to_query_;
+  ResolvedElement best_candidate_;
+  bool found_candidate_ = false;
+  int best_rank_ = 0;
+
+  base::WeakPtrFactory<LocatorResolver> weak_ptr_factory_{this};
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_LOCATOR_RESOLVER_H_
