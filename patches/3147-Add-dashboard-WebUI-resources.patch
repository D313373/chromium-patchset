diff --git a/chrome/browser/resources/dashboard/actions/waitEditor.js b/chrome/browser/resources/dashboard/actions/waitEditor.js
new file mode 100644
index 0000000000000000000000000000000000000000..e670a4a2d142afeeecfb7e434c05fa71abb99fe2
--- /dev/null
+++ b/chrome/browser/resources/dashboard/actions/waitEditor.js
@@ -0,0 +1,112 @@
+// Wait action editor - aligns with wait_action.cc expectations
+// params: { waitType: "time"|"element", time: number, locators: [...], timeout: number, randomDelay: boolean }
+import { renderLocatorEditor } from '../components/locatorEditor.js';
+
+export function renderWaitEditor(container, action, onChange) {
+  if (!container) return;
+  const params = (action && action.params) || { waitType: 'time', time: 1000 };
+
+  container.innerHTML = `
+    <div class="p-2">
+      <label style="display:block;margin-bottom:8px;">Wait Type</label>
+      <select id="wait-type" style="width:100%;margin-bottom:12px;">
+        <option value="time">Time (milliseconds)</option>
+        <option value="element">Element Ready</option>
+      </select>
+
+      <div id="time-options" style="display:none;">
+        <label style="display:block;margin-bottom:4px;">Time (ms) — 1000 ms = 1 s</label>
+        <input id="wait-time" type="number" min="0" step="100" placeholder="1000 (≈1s)" style="width:160px;"/>
+      </div>
+
+      <div id="element-options" style="display:none;">
+        <div id="wait-locators-container"></div>
+        <label style="display:block;margin-top:8px;margin-bottom:4px;">Timeout (ms)</label>
+        <input id="wait-timeout" type="number" min="0" step="100" placeholder="5000" style="width:120px;"/>
+      </div>
+
+      <label style="display:block;margin-top:12px;">
+        <input id="wait-random" type="checkbox"/> Random Delay
+      </label>
+      <label style="display:block;margin-top:8px;">
+        <input id="wait-noncritical" type="checkbox"/> Non-critical (skip on failure)
+      </label>
+    </div>
+  `;
+
+  const typeSelect = container.querySelector('#wait-type');
+  const timeOptions = container.querySelector('#time-options');
+  const elementOptions = container.querySelector('#element-options');
+  const timeInput = container.querySelector('#wait-time');
+  const locatorsContainer = container.querySelector('#wait-locators-container');
+  const timeoutInput = container.querySelector('#wait-timeout');
+  const randomCheckbox = container.querySelector('#wait-random');
+  const nonCriticalCheckbox = container.querySelector('#wait-noncritical');
+
+  let locatorEditor = null;
+
+  // Set initial values
+  typeSelect.value = params.waitType || 'time';
+  if (params.waitType === 'time') {
+    timeOptions.style.display = 'block';
+    timeInput.value = params.time || 1000;
+  } else if (params.waitType === 'element') {
+    elementOptions.style.display = 'block';
+    locatorEditor = renderLocatorEditor(
+      locatorsContainer,
+      params.locators,
+      (locators) => {
+        params.locators = locators;
+        if (onChange) onChange({ ...action, params });
+      }
+    );
+    timeoutInput.value = params.timeout || 5000;
+  }
+  randomCheckbox.checked = params.randomDelay || false;
+  if (action && typeof action.nonCritical === 'boolean') {
+    nonCriticalCheckbox.checked = !!action.nonCritical;
+  }
+
+  // Handle wait type change
+  typeSelect.addEventListener('change', () => {
+    if (typeSelect.value === 'time') {
+      timeOptions.style.display = 'block';
+      elementOptions.style.display = 'none';
+    } else {
+      timeOptions.style.display = 'none';
+      elementOptions.style.display = 'block';
+      if (!locatorEditor) {
+        locatorEditor = renderLocatorEditor(
+          locatorsContainer,
+          params.locators,
+          (locators) => {
+            params.locators = locators;
+            if (onChange) onChange({ ...action, params });
+          }
+        );
+      }
+    }
+    commit();
+  });
+
+  const commit = () => {
+    const newParams = { waitType: typeSelect.value, randomDelay: randomCheckbox.checked };
+
+    if (typeSelect.value === 'time') {
+      newParams.time = parseInt(timeInput.value, 10) || 1000;
+    } else if (typeSelect.value === 'element') {
+      newParams.locators = locatorEditor ? locatorEditor.getValue() : [];
+      newParams.timeout = parseInt(timeoutInput.value, 10) || 5000;
+    }
+
+    const updated = { ...(action || {}), params: newParams, nonCritical: !!nonCriticalCheckbox.checked };
+    if (typeof onChange === 'function') onChange(updated);
+  };
+
+  timeInput.addEventListener('input', commit);
+  timeInput.addEventListener('change', commit);
+  timeoutInput.addEventListener('input', commit);
+  timeoutInput.addEventListener('change', commit);
+  randomCheckbox.addEventListener('change', commit);
+  nonCriticalCheckbox.addEventListener('change', commit);
+}
