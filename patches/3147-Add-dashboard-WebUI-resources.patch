+#include "chrome/browser/ui/webui/dashboard/type_handler.h"
+
+#include "base/logging.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/webui/dashboard/actions/locator_resolver.h"
+#include "chrome/browser/ui/webui/dashboard/click_handler.h"
+#include "chrome/browser/ui/webui/dashboard/debug_config.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_keyboard_event.h"
+
+TypeHandler::TypeHandler(content::WebContents* web_contents)
+    : web_contents_(web_contents) {}
+
+TypeHandler::~TypeHandler() = default;
+
+void TypeHandler::ExecuteTypeAsync(const std::vector<dashboard::Locator>& locators,
+                                    const std::string& text_to_type,
+                                    TypeCallback callback) {
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[TypeHandler] Typing text with " << locators.size() << " locators";
+  }
+
+  if (!web_contents_) {
+    std::move(callback).Run(false, "No web contents");
+    return;
+  }
+
+  // Fully async resolution + readiness
+  checker_ = std::make_unique<ElementReadinessChecker>(web_contents_);
+  checker_->WaitForElementReadyAsync(
+      locators,
+      dashboard::SearchScope::kInteractiveOnly,
+      /*timeout_ms=*/5000,
+      base::BindOnce(&TypeHandler::OnTypeTargetReady,
+                     weak_ptr_factory_.GetWeakPtr(),
+                     text_to_type,
+                     std::move(callback)));
+}
+
+void TypeHandler::OnTypeTargetReady(const std::string& text,
+                                    TypeCallback callback,
+                                    bool ready,
+                                    const dashboard::ResolvedElement& element,
+                                    const std::string& error) {
+  // Release checker memory ASAP
+  checker_.reset();
+
+  if (!ready) {
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(ERROR) << "[TypeHandler] Target not ready: " << error;
+    }
+    std::move(callback).Run(false, "Element not ready: " + error);
+    return;
+  }
+
+  // Focus the element before typing
+  dashboard::ClickHandler clicker(web_contents_);
+  if (!clicker.ExecuteClickAt(element.center_x, element.center_y,
+                              /*use_human_offset=*/false,
+                              /*click_count=*/1)) {
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(ERROR) << "[TypeHandler] Focus click failed";
+    }
+    std::move(callback).Run(false, "Focus click failed");
+    return;
+  }
+
+  content::RenderWidgetHost* rwh =
+      web_contents_->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  if (!rwh) {
+    std::move(callback).Run(false, "No render widget host");
+    return;
+  }
+  content::RenderWidgetHostView* rwhv = rwh->GetView();
+  if (!rwhv) {
+    std::move(callback).Run(false, "No render widget host view");
+    return;
+  }
+
+  // Begin async typing loop
+  TypeCharacterAsync(rwh, rwhv, text, 0, std::move(callback));
+}
+
+void TypeHandler::TypeCharacterAsync(content::RenderWidgetHost* rwh,
+                                      content::RenderWidgetHostView* rwhv,
+                                      const std::string& text,
+                                      size_t char_index,
+                                      TypeCallback callback) {
+  if (!rwh || !rwhv) {
+    std::move(callback).Run(false, "RWH or RWHV became invalid");
+    return;
+  }
+
+  if (char_index >= text.length()) {
+    // All characters typed successfully
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "[TypeHandler] Successfully typed " << text.length() << " characters";
+    }
+    std::move(callback).Run(true, "");
+    return;
+  }
+
+  // Type current character
+  char c = text[char_index];
+  int key_code = static_cast<unsigned char>(c);
+
+  auto send_key = [&](blink::WebInputEvent::Type type, char ch = 0) {
+    blink::WebKeyboardEvent e(type, blink::WebInputEvent::kNoModifiers, base::TimeTicks::Now());
+    e.windows_key_code = key_code;
+    e.native_key_code = key_code;
+    if (type == blink::WebInputEvent::Type::kChar) {
+      e.text[0] = ch;
+      e.unmodified_text[0] = ch;
+    }
+    input::NativeWebKeyboardEvent ne(e, rwhv->GetNativeView());
+    rwh->ForwardKeyboardEvent(ne);
+  };
+
+  send_key(blink::WebInputEvent::Type::kRawKeyDown);
+  send_key(blink::WebInputEvent::Type::kChar, c);
+  send_key(blink::WebInputEvent::Type::kKeyUp);
+
+  // Schedule next character with delay (50-130ms)
+  int delay_ms = 50 + (rand() % 80);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&TypeHandler::TypeCharacterAsync,
+                     weak_ptr_factory_.GetWeakPtr(),
+                     rwh,
+                     rwhv,
+                     text,
+                     char_index + 1,
+                     std::move(callback)),
+      base::Milliseconds(delay_ms));
+}
+
+// Synchronous ExecuteType removed; use ExecuteTypeAsync.
