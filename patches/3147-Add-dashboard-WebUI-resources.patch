+      }
+    } catch (_) {}
+
+    const parts = trimmed.split(/[,\s]+/).filter(Boolean);
+    if (parts.length >= 2) {
+      const x = ensureNumber(Number(parts[0]));
+      const y = ensureNumber(Number(parts[1]));
+      return JSON.stringify({ x, y });
+    }
+
+    const numeric = Number(trimmed);
+    if (Number.isFinite(numeric)) {
