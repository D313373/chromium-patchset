+        note: ctx?.note || undefined,
+        actions: Array.isArray(ctx?.actions) ? ctx.actions.map(a => (a && typeof a === 'object') ? coerceWaitParams(a) : null).filter(Boolean) : []
+      }));
+      out[id] = {
+        name: script.name,
+        url_contexts,
+        actions: [], // optional legacy compat; primary source is url_contexts
+        settings: script.settings || {},
+        settingsOverrides: script.settingsOverrides || script.overrides || {}
+      };
+      continue;
+    }
+    // Legacy: flat actions or older demo schema
+    if (script && script.name && Array.isArray(script.actions)) {
+      out[id] = {
+        name: script.name,
+        actions: (script.actions || []).map(a => {
+          if (a && typeof a === 'object' && 'comment' in a) return a;
+          return coerceWaitParams(a);
+        }),
+        settings: script.settings || {},
+        settingsOverrides: script.settingsOverrides || script.overrides || {}
+      };
+      continue;
+    }
+    const name = script?.scriptName || script?.name || `Script ${id}`;
+    const settings = script?.settings || {};
+    const legacyActions = Array.isArray(script?.actions) ? script.actions : [];
