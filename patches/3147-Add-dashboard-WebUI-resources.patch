+// Build a concise, high-signal title for a timeline card including key params
+function formatActionTitle(action) {
+  const name = String(action?.action || 'action').toUpperCase();
+  const p = action?.params || {};
+  const formatTopLocators = (locs, count = 2) => {
+    const arr = Array.isArray(locs) ? locs.slice() : [];
+    const sorted = arr
+      .map(l => ({...l, priority: (typeof l?.priority === 'number' ? l.priority : 999)}))
+      .sort((a,b) => a.priority - b.priority)
+      .slice(0, count);
+    return sorted.map(l => {
+      const val = String(l?.value ?? '').slice(0, 60);
+      return `${l?.type}:${val}`;
+    }).join(' | ');
+  };
+  let details = '';
+  switch (action?.action) {
+    case 'click': {
+      const tag = p.tag || (Array.isArray(p.locators) ? 'element' : '');
+      const text = p.text ? String(p.text).slice(0, 40) : '';
+      const xy = (p.x != null && p.y != null) ? `@(${p.x},${p.y})` : '';
+      const locStr = formatTopLocators(p.locators, 2);
+      details = [tag && `<${tag}>`, text && `"${text}"`, locStr, xy].filter(Boolean).join(' ');
+      break;
+    }
+    case 'right_click': {
+      const locStr = formatTopLocators(p.locators, 2);
+      const xy = (p.x != null && p.y != null) ? `@(${p.x},${p.y})` : '';
+      details = [locStr, xy].filter(Boolean).join(' ');
+      break;
+    }
+    case 'type': {
+      const field = p.name || p.selector || '';
+      const t = p.type || '';
+      let val = p.text || '';
+      if (p.sensitive) val = '••••';
+      else if (val) val = `"${String(val).slice(0, 40)}"`;
+      details = [field && `name=${field}`, t && `type=${t}`, val].filter(Boolean).join(' ');
+      break;
+    }
+    case 'navigate':
+    case 'url_change': {
+      details = p.url ? String(p.url).slice(0, 80) : '';
+      break;
+    }
+    case 'wait': {
+      if (p && p.time != null && Number.isFinite(Number(p.time))) {
+        details = `${Number(p.time)}ms`;
+      } else if (p && p.seconds != null && Number.isFinite(Number(p.seconds))) {
+        details = `${Number(p.seconds)}s`;
+      } else {
+        details = '';
+      }
+      break;
+    }
+    default: {
+      const keys = Object.entries(p)
+        .filter(([k]) => k !== 'locators' && k !== 'iframePath')
+        .slice(0, 3)
+        .map(([k, v]) => `${k}=${typeof v === 'string' ? v.slice(0,40) : JSON.stringify(v)}`);
+      details = keys.join(' ');
+    }
+  }
+  return details ? `${name} — ${details}` : name;
+}
