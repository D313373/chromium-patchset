@@ -0,0 +1,34 @@
+#include "chrome/browser/ui/webui/dashboard/actions/action_base.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+#include "chrome/browser/profiles/profile.h"
+
+namespace dashboard {
+namespace actions {
+
+Action::Action(Profile* profile) : profile_(profile) {}
+
+Action::~Action() = default;
+
+void Action::SerializeInto(base::Value::Dict* out) const {
+  if (!out)
+    return;
+  const std::string action_name =
+      serialized_action_name_.empty() ? std::string("unknown")
+                                      : serialized_action_name_;
+  out->Set("action", action_name);
+  out->Set("params", serialized_params_.Clone());
+  out->Set("executedAt", static_cast<double>(
+                       base::Time::Now().InMillisecondsSinceUnixEpoch()));
+}
+
+void Action::SetSerializedAction(const std::string& action,
+                                 base::Value::Dict params) {
+  serialized_action_name_ = action;
+  serialized_params_ = std::move(params);
+}
+
+}  // namespace actions
+}  // namespace dashboard
+
