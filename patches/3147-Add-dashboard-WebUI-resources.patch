+}
+
+export class LocatorEditor {
+  constructor(container) {
+    if (!container) throw new Error('A container element must be provided.');
+    this.container = container;
+    this.locators = [];
+    this.onChange = null;
+  }
+
+  render() {
+    const c = this.container;
+    c.innerHTML = '';
+    c.style.cssText = 'display:flex;flex-direction:column;gap:12px;font-family:sans-serif;padding:12px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;margin-bottom:12px;';
+
+    // Header with help text
+    const header = document.createElement('div');
+    header.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;';
+
+    const title = document.createElement('label');
+    title.textContent = 'Element Locators';
+    title.style.cssText = 'font-size:14px;color:#111827;font-weight:600;';
+
+    const helpToggle = document.createElement('button');
+    helpToggle.textContent = '? DevTools Guide';
+    helpToggle.style.cssText = 'padding:6px 12px;font-size:12px;background:#3b82f6;color:white;border:none;border-radius:4px;cursor:pointer;font-weight:500;';
+    helpToggle.onmouseenter = (e) => e.target.style.background = '#2563eb';
+    helpToggle.onmouseleave = (e) => e.target.style.background = '#3b82f6';
+    helpToggle.onclick = () => this._toggleHelp();
+
+    header.append(title, helpToggle);
+
+    // Help panel (initially hidden)
+    const helpPanel = document.createElement('div');
+    helpPanel.id = 'locatorHelpPanel';
+    helpPanel.style.cssText = 'display:none;padding:16px;background:#eff6ff;border:2px solid #3b82f6;border-radius:6px;font-size:13px;color:#1e40af;line-height:1.6;margin-bottom:12px;';
+    helpPanel.innerHTML = `
+      <strong style="font-size:14px;color:#1e3a8a;">📖 How to Find Locators Using Browser DevTools:</strong><br><br>
+      <strong>1. CSS Selector / XPath:</strong><br>
+      • Right-click element on page → "Inspect"<br>
+      • In DevTools, right-click the highlighted element<br>
+      • Copy → "Copy selector" (CSS) or "Copy XPath"<br><br>
+      <strong>2. ID / Name / Class:</strong><br>
+      • Inspect element, look at attributes in DevTools<br>
+      • id="submit-button" → use "submit-button" as ID locator<br>
+      • name="email" → use "email" as Name locator<br><br>
+      <strong>3. Multiple Locators (Fallback):</strong><br>
+      • Add multiple locators for the same element<br>
+      • System tries each in order until one succeeds<br>
+      • Useful for dynamic pages or A/B tests
+    `;
+
+    // Locators container
+    const locatorsContainer = document.createElement('div');
+    locatorsContainer.id = 'locatorsContainer';
+    locatorsContainer.style.cssText = 'display:flex;flex-direction:column;gap:8px;';
+
+    // Add locator button
+    const addBtn = document.createElement('button');
+    addBtn.textContent = '+ Add Locator';
+    addBtn.style.cssText = 'padding:10px 16px;background:#10b981;color:white;border:none;border-radius:6px;cursor:pointer;font-size:14px;font-weight:600;align-self:flex-start;';
+    addBtn.onmouseenter = (e) => e.target.style.background = '#059669';
+    addBtn.onmouseleave = (e) => e.target.style.background = '#10b981';
+    addBtn.onclick = () => this._addLocator();
+
+    c.append(header, helpPanel, locatorsContainer, addBtn);
+
+    // Store references
+    this.helpPanel = helpPanel;
+    this.locatorsContainer = locatorsContainer;
+
+    // Render existing locators
+    this.locators.forEach((loc, idx) => this._renderLocatorEntry(loc, idx));
+
+    // Add first locator if empty
+    if (this.locators.length === 0) {
+      this._addLocator();
+    }
+  }
+
+  _toggleHelp() {
+    const isHidden = this.helpPanel.style.display === 'none';
+    this.helpPanel.style.display = isHidden ? 'block' : 'none';
+  }
+
+  _addLocator(locator = { type: 'CSS_SELECTOR', value: '' }) {
+    this.locators.push(locator);
+    this._renderLocatorEntry(locator, this.locators.length - 1);
+    this._notifyChange();
+  }
+
+  _removeLocator(index) {
+    this.locators.splice(index, 1);
+    this._rerender();
+    this._notifyChange();
+  }
+
+  _updateLocator(index, field, value) {
+    if (!this.locators[index]) {
+      return;
+    }
+
+    if (field === 'type') {
+      const canonicalType = canonicalizeLocatorTypeJS(value);
+      this.locators[index].type = canonicalType;
+      // Ensure a sane default when switching to XY Coordinates
+      if (canonicalType === 'VISUAL_COORDS' && (!this.locators[index].value || !this.locators[index].value.trim())) {
