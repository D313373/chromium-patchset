@@ -0,0 +1,86 @@
+// KeyDownEditor.js
+export function renderKeyDownEditor(container, action, onSave, onCancel) {
+  container.innerHTML = `
+    <h3>Key Down Configuration</h3>
+    <div>
+      <label>Modifier Key:</label>
+      <select id="modifierKey">
+        <option value="Control">Ctrl</option>
+        <option value="Shift">Shift</option>
+        <option value="Alt">Alt</option>
+        <option value="Meta">Meta</option>
+      </select>
+    </div>
+    <div>
+      <label>Nested Actions:</label>
+      <div id="nestedActionsContainer">
+        <!-- Nested type or key press actions go here -->
+      </div>
+      <button id="addNestedAction">Add Nested Action</button>
+    </div>
+    <div class="editor-actions">
+      <button id="saveKeyDown">Save</button>
+      <button id="cancelKeyDown">Cancel</button>
+    </div>
+  `;
+
+  const modifierEl = document.getElementById('modifierKey');
+  const nestedContainer = document.getElementById('nestedActionsContainer');
+  const addNestedBtn = document.getElementById('addNestedAction');
+
+  action.modifier = action.modifier ?? 'Control';
+  action.nested = action.nested ?? [];
+
+  modifierEl.value = action.modifier;
+  modifierEl.addEventListener('change', e => action.modifier = e.target.value);
+
+  function addNestedEditor(nestedAction, index) {
+    const div = document.createElement('div');
+    div.className = 'nestedAction';
+    div.dataset.index = index;
+    div.innerHTML = `
+      <label>Action Type:</label>
+      <select class="nestedType">
+        <option value="type">Type</option>
+        <option value="keyPress">Key Press</option>
+      </select>
+      <smart-input class="nestedValue" data-type="string" placeholder="Enter value"></smart-input>
+      <button class="removeNested">Remove</button>
+    `;
+    nestedContainer.appendChild(div);
+
+    const typeEl = div.querySelector('.nestedType');
+    const valueEl = div.querySelector('.nestedValue');
+    const removeBtn = div.querySelector('.removeNested');
+
+    typeEl.value = nestedAction.type ?? 'type';
+    typeEl.addEventListener('change', e => nestedAction.type = e.target.value);
+    // Set initial value if provided
+    if (nestedAction.value) {
+      valueEl.value = nestedAction.value;
+    }
+
+    valueEl.addEventListener('input', e => nestedAction.value = e.target.value);
+
+    removeBtn.addEventListener('click', () => {
+      nestedContainer.removeChild(div);
+      action.nested.splice(index, 1);
+      refreshNestedIndexes();
+    });
+  }
+
+  action.nested.forEach((n, i) => addNestedEditor(n, i));
+
+  addNestedBtn.addEventListener('click', () => {
+    const newNested = { type: 'type', value: '' };
+    action.nested.push(newNested);
+    addNestedEditor(newNested, action.nested.length - 1);
+  });
+
+  function refreshNestedIndexes() {
+    Array.from(nestedContainer.children).forEach((child, i) => child.dataset.index = i);
+  }
+
+  document.getElementById('saveKeyDown').addEventListener('click', () => onSave(action));
+  document.getElementById('cancelKeyDown').addEventListener('click', () => onCancel());
+}
diff --git a/chrome/browser/resources/dashboard/actions/keyEditor.js b/chrome/browser/resources/dashboard/actions/keyEditor.js
