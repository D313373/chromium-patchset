new file mode 100644
index 0000000000000000000000000000000000000000..4a8ad56f6048677212bb43d720440bf6f47ec27b
--- /dev/null
+++ b/chrome/browser/resources/dashboard/variables.js
@@ -0,0 +1,87 @@
+// dashboard/variables.js
+export function renderVariablesTab(container) {
+  container.innerHTML = `
+    <h2>Variables & Tables</h2>
+    <div class="variable-controls">
+      <input type="file" id="uploadFile" accept=".csv,.ini"/>
+      <button id="clearTables">Clear All</button>
+    </div>
+    <div id="variableTables"></div>
+  `;
+
+  const uploadInput = document.getElementById('uploadFile');
+  const clearBtn = document.getElementById('clearTables');
+  const tablesContainer = document.getElementById('variableTables');
+
+  uploadInput.addEventListener('change', handleFileUpload);
+  clearBtn.addEventListener('click', () => {
+    appState.tables = {};
+    renderTables();
+  });
+
+  function handleFileUpload(event) {
+    const file = event.target.files[0];
+    if (!file) return;
+
+    const reader = new FileReader();
+    reader.onload = (e) => {
+      const text = e.target.result;
+      if (file.name.endsWith('.csv')) {
+        parseCSV(file.name, text);
+      } else if (file.name.endsWith('.ini')) {
+        parseINI(file.name, text);
+      }
+      renderTables();
+    };
+    reader.readAsText(file);
+  }
+
+  function parseCSV(name, text) {
+    const rows = text.split('\n').map(r => r.split(','));
+    const headers = rows.shift();
+    const table = rows.map(row => {
+      const obj = {};
+      headers.forEach((h, i) => obj[h] = row[i] ?? '');
+      return obj;
+    });
+    appState.tables[name] = table;
+  }
+
+  function parseINI(name, text) {
+    const obj = {};
+    text.split('\n').forEach(line => {
+      const [key, value] = line.split('=');
+      if (key && value) obj[key.trim()] = value.trim();
+    });
+    appState.tables[name] = obj;
+  }
+
+  function renderTables() {
+    tablesContainer.innerHTML = '';
+    Object.entries(appState.tables).forEach(([name, table]) => {
+      const tableEl = document.createElement('table');
+      tableEl.classList.add('dashboard-table');
+      if (Array.isArray(table)) {
+        // CSV table
+        const headers = Object.keys(table[0] || {});
+        tableEl.innerHTML = `
+          <thead><tr>${headers.map(h => `<th>${h}</th>`).join('')}</tr></thead>
+          <tbody>
+            ${table.map(row => `<tr>${headers.map(h => `<td>${row[h]}</td>`).join('')}</tr>`).join('')}
+          </tbody>
+        `;
+      } else {
+        // INI key/value table
+        tableEl.innerHTML = `
+          <thead><tr><th>Key</th><th>Value</th></tr></thead>
+          <tbody>
+            ${Object.entries(table).map(([k,v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('')}
+          </tbody>
+        `;
+      }
+      tablesContainer.appendChild(tableEl);
+    });
+  }
+
+  renderTables();
+}
