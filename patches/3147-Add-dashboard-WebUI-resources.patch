+// ----------------------------------------------------------------------
+// Global-settings helpers (in-memory cache + default values)
+// ----------------------------------------------------------------------
+base::Value::Dict& GlobalSettingsStore() {
+  static base::NoDestructor<base::Value::Dict> store;
+  return *store;
+}
+
+
+base::Value::Dict DefaultGlobalSettings() {
+  base::Value::Dict s;
+  base::Value::Dict anti;
+  anti.Set("removeWebdriver", true);
+  anti.Set("userAgent", "");
+  anti.Set("platform", "");
+  anti.Set("languages", base::Value::List().Append("en-US"));
+  anti.Set("hardwareConcurrency", 8);
+
+  // Plugin spoofing defaults (disabled by default; modern Chrome often has 0 plugins)
+  base::Value::Dict pluginSpoof;
+  pluginSpoof.Set("enabled", false);
+  pluginSpoof.Set("randomSelection", false);
+  // No default selection; users can opt-in explicitly
+  base::Value::List defaultPlugins;
+  pluginSpoof.Set("selectedPlugins", std::move(defaultPlugins));
+  anti.Set("pluginSpoofing", std::move(pluginSpoof));
+
+  s.Set("antiDetection", std::move(anti));
+  base::Value::Dict input;
+  input.Set("clickPathJitterPx", 1.5);
+  input.Set("clickHoverRadiusPx", 2.0);
+  input.Set("clickHoverMoves", 3);
+  s.Set("inputBehavior", std::move(input));
+  return s;
+}
+
+// ----------------------------------------------------------------------
+// Helper to return the path where scripts are stored.
+// ----------------------------------------------------------------------
+base::FilePath ScriptsDir(const Profile* profile) {
+  // Allow overriding via env var for local testing.
+  const char* env = std::getenv("DASHBOARD_SCRIPTS_DIR");
+  if (env && *env) {
+    base::FilePath custom = base::FilePath::FromUTF8Unsafe(env);
+    if (!custom.empty())
+      return custom;
+  }
+  return profile->GetPath().AppendASCII("SimulachromeScripts");
+}
+
+// ----------------------------------------------------------------------
+// Ensure the script directory exists.
+// ----------------------------------------------------------------------
+void EnsureScriptsDir(const Profile* profile) {
+  const base::FilePath dir = ScriptsDir(profile);
+  bool ok = base::CreateDirectory(dir);
+  LOG(INFO) << "[Dashboard] EnsureScriptsDir path=" << dir.AsUTF8Unsafe()
+            << " created?=" << ok;
+}
+
+// ----------------------------------------------------------------------
+// Write a script to disk (atomic write, JSON format).
+// ----------------------------------------------------------------------
+bool WriteScriptToDisk(const Profile* profile,
+                       const std::string& id,
+                       const base::Value::Dict& script) {
+  const base::FilePath path = ScriptsDir(profile).AppendASCII(id + ".json");
+  std::string json;
+  base::JSONWriter::Write(script, &json);
+  int rv = base::WriteFile(path, base::as_byte_span(json));
+  if (rv <= 0) {
+    PLOG(ERROR) << "[Dashboard] WriteScriptToDisk FAILED id=" << id
+                << " path=" << path.AsUTF8Unsafe();
+    return false;
+  }
+  LOG(INFO) << "[Dashboard] WriteScriptToDisk OK id=" << id
+            << " path=" << path.AsUTF8Unsafe();
+  return true;
+}
+
+// ----------------------------------------------------------------------
+// Delete a script from disk.
+// ----------------------------------------------------------------------
+bool DeleteScriptFromDisk(const Profile* profile, const std::string& id) {
+  const base::FilePath path = ScriptsDir(profile).AppendASCII(id + ".json");
+  LOG(INFO) << "[Dashboard] DeleteScriptFromDisk path=" << path.AsUTF8Unsafe();
+  return base::DeleteFile(path);
+}
