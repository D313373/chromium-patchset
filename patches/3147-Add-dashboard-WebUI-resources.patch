+namespace content {
+class WebContents;
+}
+
+namespace dashboard {
+namespace actions {
+
+// NavigateAction performs a navigation operation within the dashboard.
+class NavigateAction : public Action {
+ public:
+  using Callback = base::OnceCallback<void(bool, const std::string&)>;
+
+  explicit NavigateAction(Profile* profile);
