+void DashboardUIMessageHandler::HandleSetGlobalSettings(const base::Value::List& args) {
+  const std::string cb =
+      (args.size() > 0 && args[0].is_string()) ? args[0].GetString()
+                                              : std::string();
+  const base::Value::Dict* payload =
+      (args.size() > 1 && args[1].is_dict()) ? &args[1].GetDict() : nullptr;
+  if (!payload) {
+    LOG(ERROR) << "[Dashboard] SetGlobalSettings: missing payload.";
+    base::Value::Dict res;
+    res.Set("ok", false);
+    ResolveCallback(cb, res); // FIX
+    return;
+  }
+
+  base::Value::Dict new_settings = payload->Clone();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(),
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&DashboardUIMessageHandler::SaveGlobalSettingsToDisk,
+                     base::Unretained(this), std::move(new_settings)),
+      base::BindOnce(&DashboardUIMessageHandler::OnSetGlobalSettingsDone,
+                     weak_ptr_factory_.GetWeakPtr(), cb));
+}
+
+bool DashboardUIMessageHandler::SaveGlobalSettingsToDisk(const base::Value::Dict& settings) {
+  const base::FilePath path = ::ScriptsDir(profile_).AppendASCII("global_settings.json");
+  std::string json;
+  base::JSONWriter::Write(settings, &json);
+  int rv = base::WriteFile(path, base::as_byte_span(json));
+  if (rv <= 0) {
+    PLOG(ERROR) << "[Dashboard] Write global settings FAILED.";
+    return false;
+  }
+  LOG(INFO) << "[Dashboard] Global settings saved to " << path.AsUTF8Unsafe()
+            << " (" << rv << " bytes).";
+  return true;
+}
