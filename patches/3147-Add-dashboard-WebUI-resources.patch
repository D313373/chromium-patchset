+  VISUAL_AI: {
+    label: 'Visual AI (Future)',
+    placeholder: 'AI-based element matching (not yet implemented)',
+    help: 'Placeholder for future AI-powered element detection.'
+  },
+  FRAME_ID: {
+    label: 'Frame ID',
+    placeholder: 'e.g., GlobalRenderFrameHostId string or known frame token',
+    help: 'Advanced: Target a specific frame by its global ID during playback. Typically combined with an element locator inside that frame.'
+  },
+  RESOURCE_TREE: {
+    label: 'Resource Tree Path',
+    placeholder: 'e.g., /frames/0/frames/2 or shadow:host>>inner',
+    help: 'Advanced diagnostics: Provide a resource-tree path or chain to disambiguate elements across nested frames/shadow roots.'
+  }
