+// ==============================================
+// File: dashboard_handler_click.cpp
+// ==============================================
+#include "dashboard_handler.h"
+#include <random>
+#include <chrono>
+#include <thread>
+#include <cmath>
+
+namespace {
+
+// Helper: generate a random float between min and max
+double RandomDouble(double min, double max) {
+    static std::mt19937 rng(std::random_device{}());
+    std::uniform_real_distribution<double> dist(min, max);
+    return dist(rng);
+}
+
+// Helper: linear interpolation
+double Lerp(double a, double b, double t) {
+    return a + (b - a) * t;
+}
+
+// Helper: move cursor along a "human-like" path from (x0,y0) -> (x1,y1)
+void MoveCursorHumanLike(int x0, int y0, int x1, int y1) {
+    int steps = 20 + static_cast<int>(RandomDouble(0, 10));  // small randomness
+    for (int i = 1; i <= steps; ++i) {
+        double t = static_cast<double>(i) / steps;
+        // Add subtle curve/randomness
+        int xi = static_cast<int>(Lerp(x0, x1, t) + RandomDouble(-2, 2));
+        int yi = static_cast<int>(Lerp(y0, y1, t) + RandomDouble(-2, 2));
+        // TODO: call OS/browser API to move cursor to (xi, yi)
+        // e.g., WebDriver mouse move or platform-specific API
+        std::this_thread::sleep_for(std::chrono::milliseconds(5 + static_cast<int>(RandomDouble(0, 5))));
+    }
+}
+
+}  // anonymous namespace
+
+bool DashboardHandler::ExecuteClickAction(const ClickAction& action) {
+    // 1. Resolve the element using prioritized locators
+    Element element;
+    bool found = ResolveElement(action.locators, element);
+    if (!found) {
+        Log("ClickAction: Unable to locate element");
+        return false;
+    }
+
+    // 2. Cross-reference multiple locators if duplicate/multiple elements
+    std::vector<Element> candidates = FindElements(action.locators);
+    if (candidates.size() > 1) {
+        element = CrossReferenceLocators(candidates, action.locators);
+    }
+
+    // 3. Human-like cursor movement
+    int currentX = cursorX_;
+    int currentY = cursorY_;
+    int targetX = element.positionX + static_cast<int>(RandomDouble(-5, 5));  // offset from center
+    int targetY = element.positionY + static_cast<int>(RandomDouble(-5, 5));
+
+    MoveCursorHumanLike(currentX, currentY, targetX, targetY);
+
+    // Update cursor position
+    cursorX_ = targetX;
+    cursorY_ = targetY;
+
+    // 4. Optional small pause before click
+    std::this_thread::sleep_for(std::chrono::milliseconds(50 + static_cast<int>(RandomDouble(0, 100))));
+
+    // 5. Perform click (platform/browser-specific)
+    bool clicked = ClickElement(element);
+    if (!clicked) {
+        Log("ClickAction: Failed to click element");
+        return false;
+    }
+
+    Log("ClickAction: Successfully clicked element");
+    return true;
+}
+
+// Resolve element using locator priority
+bool DashboardHandler::ResolveElement(const std::vector<Locator>& locators, Element& outElement) {
+    for (const auto& loc : locators) {
+        if (TryLocateElement(loc, outElement)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Find multiple elements matching locators
+std::vector<Element> DashboardHandler::FindElements(const std::vector<Locator>& locators) {
+    std::vector<Element> results;
+    for (const auto& loc : locators) {
+        auto elems = FindAllMatchingElements(loc);
+        results.insert(results.end(), elems.begin(), elems.end());
+    }
+    return results;
+}
+
+// Cross-reference multiple locators for duplicates
+Element DashboardHandler::CrossReferenceLocators(const std::vector<Element>& candidates,
+                                                 const std::vector<Locator>& locators) {
+    // Basic example: pick the element that matches the most locators
+    size_t bestScore = 0;
+    Element bestElem = candidates.front();
+    for (const auto& el : candidates) {
+        size_t score = 0;
+        for (const auto& loc : locators) {
+            if (ElementMatchesLocator(el, loc)) score++;
+        }
+        if (score > bestScore) {
+            bestScore = score;
+            bestElem = el;
+        }
+    }
+    return bestElem;
+}
