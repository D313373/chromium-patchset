+namespace dashboard {
+
+// Default constructors/destructors for your structs
+ActionLog::ActionLog() = default;
+ActionLog::~ActionLog() = default;
+
+// Manual implementation of the copy constructor for ActionLog.
+// This is required because base::Value::Dict is a move-only type.
+ActionLog::ActionLog(const ActionLog& other)
+    : url(other.url), errors(other.errors) {
+  actions.reserve(other.actions.size());
+  for (const auto& action : other.actions) {
+    actions.push_back(action.Clone());
+  }
+}
+
+// Manual implementation of the copy assignment operator for ActionLog.
+ActionLog& ActionLog::operator=(const ActionLog& other) {
+  if (this == &other) {
+    return *this;
+  }
+  url = other.url;
+  errors = other.errors;
+  actions.clear();
+  actions.reserve(other.actions.size());
+  for (const auto& action : other.actions) {
+    actions.push_back(action.Clone());
+  }
+  return *this;
+}
+
+ListenerScript::ListenerScript() = default;
