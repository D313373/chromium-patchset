+
+namespace dashboard {
+
+LocatorResolver::LocatorResolver(content::WebContents* web_contents)
+    : web_contents_(web_contents) {}
+LocatorResolver::~LocatorResolver() = default;
+
+// Removed synchronous resolution path to avoid UI thread blocking.
+
+// ============================================================================
+// ASYNC IMPLEMENTATION
+// ============================================================================
+
+void LocatorResolver::ResolveUniqueAsync(const std::vector<Locator>& locators,
+                                         SearchScope scope,
+                                         int timeout_ms,
+                                         ResolveCallback callback) {
+  async_callback_ = std::move(callback);
+  async_start_time_ = base::TimeTicks::Now();
+  async_timeout_ = base::Milliseconds(timeout_ms);
+  async_locators_ = locators;
+  async_scope_ = scope;
+  cancelled_ = false;
+  found_candidate_ = false;
+  best_rank_ = 0;
+
+  std::ostringstream loc_stream;
+  loc_stream << "[LocatorResolver] Resolve start locators=";
+  for (size_t i = 0; i < locators.size(); ++i) {
+    if (i) loc_stream << ", ";
+    loc_stream << LocatorTypeToString(locators[i].type) << "='" << locators[i].value << "'";
+  }
+  LOG(INFO) << loc_stream.str();
+
+  TryResolveOnceAsync(locators, scope);
+}
+
+void LocatorResolver::Cancel() {
+  cancelled_ = true;
+  if (async_callback_) {
+    std::move(async_callback_).Run(false, ResolvedElement(), "Cancelled");
+  }
+}
+
+void LocatorResolver::TryResolveOnceAsync(const std::vector<Locator>& locators,
+                                          SearchScope scope) {
+  if (cancelled_) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, ResolvedElement(), "Cancelled");
+    }
+    return;
+  }
+
+  if (!web_contents_) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, ResolvedElement(), "No web contents");
+    }
+    return;
+  }
+
+  // Quick path for ID locator and full probe configured below.
+
+  // Quick path for ID locator: try primary frame immediately while we continue
+  // with the broader multi-frame probe.
+  {
+    std::string id_quick;
+    for (const auto& loc : locators) {
+      if (loc.type == LocatorType::ID && !loc.value.empty()) { id_quick = loc.value; break; }
+    }
+    if (!id_quick.empty()) {
+      if (content::RenderFrameHost* primary = web_contents_->GetPrimaryMainFrame()) {
+        std::string id_json; base::EscapeJSONString(id_quick, /*put_in_quotes=*/true, &id_json);
+        std::string quick_js =
+            "(function(i){var e=document.getElementById(i); if(e){var r=e.getBoundingClientRect(); return {ok:true,cx:Math.round((r.left+r.right)/2),cy:Math.round((r.top+r.bottom)/2),left:Math.round(r.left),top:Math.round(r.top),width:Math.round(r.width),height:Math.round(r.height)};} return {ok:false};})(" +
+            id_json + ");";
+        GURL url = primary->GetLastCommittedURL();
+        if (url.SchemeIs("chrome")) {
+          primary->ExecuteJavaScript(
+              base::UTF8ToUTF16(quick_js),
+              base::BindOnce(&LocatorResolver::OnQuickIdResult,
+                             weak_ptr_factory_.GetWeakPtr()));
+        } else {
+          primary->ExecuteJavaScriptInIsolatedWorld(
+              base::UTF8ToUTF16(quick_js),
+              base::BindOnce(&LocatorResolver::OnQuickIdResult,
+                             weak_ptr_factory_.GetWeakPtr()),
+              content::ISOLATED_WORLD_ID_CONTENT_END);
+        }
+      }
+    }
+  }
+
+  // Proceed with the full multi-frame query in parallel
+  StartFullQuery(locators, scope);
+}
+
+void LocatorResolver::OnQuickIdResult(base::Value v) {
+  bool ok = false; int cx = 0, cy = 0;
+  if (v.is_dict()) {
+    const base::Value::Dict& d = v.GetDict();
+    ok = d.FindBool("ok").value_or(false);
+    if (ok) { cx = d.FindInt("cx").value_or(0); cy = d.FindInt("cy").value_or(0); }
+  }
+  if (ok && async_callback_) {
+    // Log quick-ID result with frame URL if possible (primary frame)
+    if (web_contents_) {
+      if (auto* rfh = web_contents_->GetPrimaryMainFrame()) {
+        GURL u = rfh->GetLastCommittedURL();
+        std::optional<int> left; std::optional<int> top; std::optional<int> width; std::optional<int> height;
+        if (v.is_dict()) {
+          const base::Value::Dict& d = v.GetDict();
+          left = d.FindInt("left"); top = d.FindInt("top"); width = d.FindInt("width"); height = d.FindInt("height");
+        }
+        LOG(INFO) << "[LocatorResolver] quick-id result cx=" << cx << " cy=" << cy << " in frame=" << u.spec();
+        if (left || top || width || height) {
+          LOG(INFO) << "[LocatorResolver] element rect L=" << (left ? *left : 0)
+                    << " T=" << (top ? *top : 0)
+                    << " W=" << (width ? *width : 0)
+                    << " H=" << (height ? *height : 0);
+        }
+      }
+    }
+    found_candidate_ = true; best_rank_ = 100;
+    dashboard::ResolvedElement out;
+    out.center_x = cx; out.center_y = cy;
+    if (web_contents_) {
+      if (auto* rfh = web_contents_->GetPrimaryMainFrame()) out.frame_id = rfh->GetGlobalId();
+    }
+    auto cb = std::move(async_callback_);
+    std::move(cb).Run(true, out, "");
+  }
+}
+
+void LocatorResolver::StartFullQuery(const std::vector<Locator>& locators,
+                                     SearchScope scope) {
+  // Prepare JSON list for JS
+  base::Value::List locators_list;
+  for (const auto& loc : locators)
+    locators_list.Append(LocatorToValue(loc));
+
+  // Collect all frames to query
+  frames_to_query_.clear();
+  content::RenderFrameHost* primary = web_contents_->GetPrimaryMainFrame();
+  if (primary)
+    frames_to_query_.push_back(primary);
+
+  web_contents_->ForEachRenderFrameHost(
+      [this, primary](content::RenderFrameHost* rfh){
+        if (!rfh) return;
+        if (primary && rfh == primary) return;
+        frames_to_query_.push_back(rfh);
+      });
+
+  if (frames_to_query_.empty()) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, ResolvedElement(), "No frames available");
+    }
+    return;
+  }
+
+  // Query all frames asynchronously
+  pending_frame_queries_ = frames_to_query_.size();
+  found_candidate_ = false;
+  best_rank_ = 0;
+
+  // Debug: log the frames being queried (first few for brevity)
+  size_t log_count = std::min<size_t>(frames_to_query_.size(), 5);
+  for (size_t li = 0; li < log_count; ++li) {
+    content::RenderFrameHost* fr = frames_to_query_[li];
+    if (!fr) continue;
+    GURL u = fr->GetLastCommittedURL();
+    LOG(INFO) << "[LocatorResolver] Query frame[" << li << "] url=" << u.spec();
+  }
+
+  for (size_t i = 0; i < frames_to_query_.size(); ++i) {
+    content::RenderFrameHost* rfh = frames_to_query_[i];
+    if (!rfh) { --pending_frame_queries_; continue; }
+
+    std::string loc_json;
+    base::JSONWriter::Write(locators_list, &loc_json);
+    const char* scope_str = (scope == SearchScope::kInteractiveOnly) ? "interactive" : "all";
+
+    std::string script;
+    script.reserve(256 + loc_json.size());
+    script.append(kSelectByPriorityJs);
+    script.append("(\n");
+    script.append(loc_json);
+    script.append(", '");
+    script.append(scope_str);
+    script.append("')");
+
+    GURL frame_url = rfh->GetLastCommittedURL();
+    if (frame_url.SchemeIs("chrome")) {
+      rfh->ExecuteJavaScript(
+          base::UTF8ToUTF16(script),
+          base::BindOnce(&LocatorResolver::OnFrameSelectComplete,
+                         weak_ptr_factory_.GetWeakPtr(),
+                         i, locators, scope));
+    } else {
+      rfh->ExecuteJavaScriptInIsolatedWorld(
+          base::UTF8ToUTF16(script),
+          base::BindOnce(&LocatorResolver::OnFrameSelectComplete,
+                         weak_ptr_factory_.GetWeakPtr(),
+                         i, locators, scope),
+          content::ISOLATED_WORLD_ID_CONTENT_END);
+    }
+  }
+}
+
+void LocatorResolver::OnFrameSelectComplete(size_t frame_index,
+                                            const std::vector<Locator>& /*locators*/,
+                                            SearchScope /*scope*/,
+                                            base::Value result) {
+  if (cancelled_) {
+    return;
+  }
+
+  if (frame_index < frames_to_query_.size()) {
+    content::RenderFrameHost* frame = frames_to_query_[frame_index];
+    if (frame && frame->IsRenderFrameLive() && result.is_dict()) {
+      const base::Value::Dict& d = result.GetDict();
+      bool ok = d.FindBool("ok").value_or(false);
+      if (ok) {
+        std::optional<int> cx = d.FindInt("cx");
+        std::optional<int> cy = d.FindInt("cy");
+        std::optional<int> left = d.FindInt("left");
+        std::optional<int> top = d.FindInt("top");
+        std::optional<int> width = d.FindInt("width");
+        std::optional<int> height = d.FindInt("height");
+        // Log select result for diagnosis
+        GURL u = frame->GetLastCommittedURL();
+        LOG(INFO) << "[LocatorResolver] select result cx=" << (cx ? *cx : 0)
+                  << " cy=" << (cy ? *cy : 0)
+                  << " in frame=" << u.spec();
+        if (left || top || width || height) {
+          LOG(INFO) << "[LocatorResolver] element rect L=" << (left ? *left : 0)
+                    << " T=" << (top ? *top : 0)
+                    << " W=" << (width ? *width : 0)
+                    << " H=" << (height ? *height : 0);
+        }
+        if (cx && cy) {
+          found_candidate_ = true;
+          best_candidate_.center_x = *cx;
+          best_candidate_.center_y = *cy;
+          best_candidate_.frame_id = frame->GetGlobalId();
+          LOG(INFO) << "[LocatorResolver] select result cx=" << *cx << " cy=" << *cy
+                    << " rect=(" << (left.value_or(0)) << "," << (top.value_or(0)) << ","
+                    << (width.value_or(0)) << "x" << (height.value_or(0)) << ") in frame="
+                    << frame->GetLastCommittedURL();
+        }
+      }
+    }
+  }
+
+  --pending_frame_queries_;
+  CheckTimeout();
+}
+
+void LocatorResolver::CheckTimeout() {
+  if (cancelled_) {
+    return;
+  }
+
+  // If all frames have responded, check if we found something
+  if (pending_frame_queries_ == 0) {
+    if (found_candidate_) {
+      LOG(INFO) << "[LocatorResolver] Resolve success";
+      if (async_callback_) {
+        dashboard::ResolvedElement out = best_candidate_;
+        std::move(async_callback_).Run(true, out, "");
+      }
+    } else {
+      // No match found; no polling — fail fast.
+      if (async_callback_) {
+        std::move(async_callback_).Run(false, ResolvedElement(), "No matching element found");
+      }
+    }
+  }
+}
+
+void LocatorResolver::ScheduleNextPoll() {
+  if (cancelled_) {
+    return;
+  }
+
+  base::TimeDelta elapsed = base::TimeTicks::Now() - async_start_time_;
+  if (elapsed >= async_timeout_) {
+    // Timeout reached
+    if (async_callback_) {
+      LOG(WARNING) << "[LocatorResolver] Resolve timeout after "
+                   << elapsed.InMilliseconds() << " ms";
+      std::move(async_callback_).Run(false, ResolvedElement(),
+                                     "No matching element found within timeout");
+    }
+  } else {
+    // Schedule next poll in 100ms
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&LocatorResolver::TryResolveOnceAsync,
+                       weak_ptr_factory_.GetWeakPtr(),
+                       async_locators_,
+                       async_scope_),
+        base::Milliseconds(100));
+  }
+}
+
+}  // namespace dashboard
