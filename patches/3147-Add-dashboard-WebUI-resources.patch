+void DashboardUIMessageHandler::HandleAgentConsoleProbe(
+    const base::Value::List& args) {
+  std::string cb;
+  std::string expression;
+  if (args.size() > 0 && args[0].is_string())
+    cb = args[0].GetString();
+  if (args.size() > 1 && args[1].is_string())
+    expression = args[1].GetString();
+
+  base::Value::Dict out;
+  if (expression.empty()) {
+    out.Set("ok", false);
+    out.Set("error", "Missing probe expression");
+    ResolveCallback(cb, out);
+    return;
+  }
+
+  RecorderController* rc = RecorderController::GetActive();
+  if (!rc && recorder_)
+    rc = recorder_.get();
+  if (!rc) {
+    out.Set("ok", false);
+    out.Set("error", "recorder not active");
+    ResolveCallback(cb, out);
+    return;
+  }
+
+  base::Value::Dict eval_params;
+  eval_params.Set("expression", expression);
+  eval_params.Set("includeCommandLineAPI", true);
+
+  rc->EvaluateJS(
+      expression,
+      base::BindOnce(
+          [](base::WeakPtr<DashboardUIMessageHandler> self,
+             std::string cb_id,
+             std::string res_json,
+             std::string err_json) {
+            if (!self)
+              return;
+            base::Value::Dict result;
+            const bool ok = err_json.empty();
+            result.Set("ok", ok);
+            if (!res_json.empty())
+              result.Set("result", res_json);
+            if (!ok)
+              result.Set("error", err_json);
+            self->ResolveCallback(cb_id, result);
+          },
+          weak_ptr_factory_.GetWeakPtr(), cb));
+}
