+#include "ui/gfx/geometry/rect_f.h"
+
+namespace dashboard {
+
+// Lightweight snapshot of a single interactive element on the page.
+struct PageElementSnapshot {
+  // Explicit out-of-line constructor/destructor to satisfy style.
+  PageElementSnapshot();
+  PageElementSnapshot(const PageElementSnapshot&) = delete;
+  PageElementSnapshot(PageElementSnapshot&&) noexcept;
+  PageElementSnapshot& operator=(const PageElementSnapshot&) = delete;
+  PageElementSnapshot& operator=(PageElementSnapshot&&) noexcept;
+  ~PageElementSnapshot();
+
+  // Optional stable id from your resolver (hash, node id, etc.).
+  std::string element_id;
+
+  // DevTools / frame tree id for the frame this element lives in.
+  std::string frame_id;
+
+  // HTML tag, e.g. "button", "input".
+  std::string tag;
+
+  // Optional accessibility role + name.
+  std::string role;
+  std::string accessibility_name;
+
+  // High-level semantic type for the agent ("clickable", "input", "link", etc.).
+  std::string type;
+
+  // Visible text / label (truncated by caller if desired).
+  std::string text;
+
+  // Selector bundle from StealthyLocatorResolver.
+  std::string css_selector;
+  std::string xpath;
+  std::string shadow_chain_selector;  // e.g. "my-host >> div.btn"
+  std::string resource_path;          // e.g. "/frames/0/shadow:host>>inner"
+  // Optional richer locator bundle for downstream consumers.
+  base::Value::List locator_bundle;
+
+  // Shadow DOM / frame placement.
+  bool in_shadow_dom = false;
+  std::string shadow_host_selector;   // CSS selector for host, if any.
+
+  bool clickable = false;
+  bool focusable = false;
+  bool disabled = false;
+
+  // Viewport coordinates in CSS pixels.
+  gfx::RectF bounds;
+
+  // Serialize this element into the pagemap JSON format.
+  base::Value::Dict ToValueDict() const;
+};
+
+// Aggregates PageElementSnapshot objects into an AI-friendly "pagemap".
+class PageMapExtractor {
+ public:
+  PageMapExtractor();
+  ~PageMapExtractor();
+
+  PageMapExtractor(const PageMapExtractor&) = delete;
+  PageMapExtractor& operator=(const PageMapExtractor&) = delete;
+
+  // Basic metadata.
+  void set_url(const GURL& url) { url_ = url; }
+  void set_timestamp_ms(int64_t timestamp_ms) { timestamp_ms_ = timestamp_ms; }
+
+  // Optional currently focused element id.
+  void set_focused_element_id(const std::string& id) {
+    focused_element_id_ = id;
+  }
+  base::WeakPtr<PageMapExtractor> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+  using PageMapReadyCallback = base::OnceCallback<void(base::Value::Dict)>;
+  using PageMapStreamCallback = base::RepeatingCallback<void(const base::Value::Dict&)>;
+  void Run(content::WebContents* web_contents,
+           PageMapReadyCallback callback,
+           bool greedy = false,
+           bool is_agent_mode = false,
+           int timeout_ms = 2500);
+
+  // Streaming overload: emits intermediate snapshots via stream_cb after each
+  // async collector finishes, and finally invokes callback with the final map.
+  void Run(content::WebContents* web_contents,
+           PageMapReadyCallback callback,
+           PageMapStreamCallback stream_cb,
+           bool greedy = false,
+           bool is_agent_mode = false,
+           int timeout_ms = 2500);
+
+  // Add a single element snapshot (usually from StealthyLocatorResolver /
+  // DevTools snapshot).
+  void AddElement(PageElementSnapshot element);
+
+  // Build a normalized pagemap JSON:
+  //
+  // {
+  //   "url": "...",
+  //   "timestamp": 123456,
+  //   "frames": [ ... ],
+  //   "metadata": { ... }
+  // }
+  //
+  base::Value::Dict BuildPageMap() const;
+
+ private:
+  struct ShadowBucket {
+    std::string host_selector;
+    base::Value::List elements;  // of PageElementSnapshot::ToValueDict()
+  };
+
+  struct FrameBucket {
+    FrameBucket();
+    FrameBucket(const FrameBucket&) = delete;
+    FrameBucket(FrameBucket&&) noexcept;
+    FrameBucket& operator=(const FrameBucket&) = delete;
+    FrameBucket& operator=(FrameBucket&&) noexcept;
+    ~FrameBucket();
+
+    std::string frame_id;
+    base::Value::List elements;  // top-level frame elements
+    std::map<std::string, ShadowBucket> shadow_buckets;  // key = host selector
+  };
+
+  GURL url_;
+  int64_t timestamp_ms_ = 0;
+
+  std::vector<PageElementSnapshot> elements_;
+  std::string focused_element_id_;
+
+  base::WeakPtrFactory<PageMapExtractor> weak_factory_{this};
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_PAGE_MAP_EXTRACTOR_H_
diff --git a/chrome/browser/ui/webui/dashboard/page_map_js.h b/chrome/browser/ui/webui/dashboard/page_map_js.h
new file mode 100644
index 0000000000000000000000000000000000000000..291396d1cd411394996d972d8c6ed89ef35bcfbc
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/page_map_js.h
@@ -0,0 +1,221 @@
+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_PAGE_MAP_JS_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_PAGE_MAP_JS_H_
+
+namespace dashboard {
+
+constexpr char kPageMapSnapshotScript[] = R"JS(
+(() => {
+  const result = {
+    url: window.location ? String(window.location.href || "") : "",
+    timestamp: Date.now(),
+    frameId: (() => {
+      try {
+        if (self === top)
+          return "root";
+        if (window.frameElement) {
+          const fe = window.frameElement;
+          if (fe.id)
+            return fe.id;
+          const nameAttr = fe.getAttribute && fe.getAttribute("name");
+          if (nameAttr)
+            return `frame:${nameAttr}`;
+        }
+      } catch (e) {}
+      return "frame";
+    })(),
+    focusedElementId: (() => {
+      try {
+        const active = document.activeElement;
+        if (!active)
+          return "";
+        if (active.id)
+          return active.id;
+        if (active.getAttribute) {
+          const nameAttr = active.getAttribute("name");
+          if (nameAttr)
+            return `name:${nameAttr}`;
+        }
+      } catch (e) {}
+      return "";
+    })(),
+    elements: []
+  };
+
+  const interactiveSelectors = [
+    'a[href]',
+    'button',
+    'input',
+    'textarea',
+    'select',
+    '[role="button"]',
+    '[role="link"]',
+    '[contenteditable="true"]'
+  ].join(',');
+
+  const nodes = Array.from(document.querySelectorAll(interactiveSelectors));
+
+  const toSelector = (el) => {
+    if (!el || !el.tagName)
+      return '';
+    if (el.id)
+      return `#${el.id}`;
+    if (el.getAttribute) {
+      const dataAttr = el.getAttribute('data-testid') || el.getAttribute('data-qa');
+      if (dataAttr)
+        return `[data-testid="${dataAttr}"]`;
+      const nameAttr = el.getAttribute('name');
+      if (nameAttr)
+        return `[name="${nameAttr}"]`;
+    }
+    const className = (el.className || '').toString().trim();
+    if (className) {
+      const parts = className.split(/\s+/).filter(Boolean).slice(0, 3);
+      if (parts.length)
+        return `${el.tagName.toLowerCase()}.${parts.join('.')}`;
+    }
+    return el.tagName.toLowerCase();
+  };
+
+  const toXPath = (el) => {
+    if (!el)
+      return '';
+    const segments = [];
+    let node = el;
+    while (node && node.nodeType === Node.ELEMENT_NODE) {
+      let index = 1;
+      let sibling = node.previousElementSibling;
+      while (sibling) {
+        if (sibling.tagName === node.tagName)
+          ++index;
+        sibling = sibling.previousElementSibling;
+      }
+      segments.unshift(`${node.tagName.toLowerCase()}[${index}]`);
+      node = node.parentElement;
+    }
+    return '/' + segments.join('/');
+  };
+
+  const getShadowChain = (el) => {
+    const chain = [];
+    try {
+      let current = el;
+      while (current) {
+        const root = current.getRootNode && current.getRootNode();
+        if (!root || !root.host)
+          break;
+        const host = root.host;
+        chain.unshift(toSelector(host));
+        current = host;
+      }
+    } catch (e) {}
+    return chain.join(' >> ');
+  };
+
+  const getShadowHostSelector = (el) => {
+    try {
+      const root = el && el.getRootNode && el.getRootNode();
+      if (!root || !root.host)
+        return '';
+      const host = root.host;
+      if (host.id)
+        return `#${host.id}`;
+      if (host.getAttribute) {
+        const dataAttr = host.getAttribute('data-testid') || host.getAttribute('data-qa');
+        if (dataAttr)
+          return `[data-testid="${dataAttr}"]`;
+        const nameAttr = host.getAttribute('name');
+        if (nameAttr)
+          return `[name="${nameAttr}"]`;
+      }
+      return host.tagName ? host.tagName.toLowerCase() : '';
+    } catch (e) {
+      return '';
+    }
+  };
+
+  const isFocusable = (el) => {
+    if (!el)
+      return false;
+    if (typeof el.tabIndex === 'number' && el.tabIndex >= 0)
+      return true;
+    const tag = el.tagName ? el.tagName.toLowerCase() : '';
+    return ['input', 'select', 'textarea', 'button', 'a'].includes(tag);
+  };
+
+  const isClickable = (el) => {
+    if (!el)
+      return false;
+    const tag = el.tagName ? el.tagName.toLowerCase() : '';
+    if (['button', 'a'].includes(tag))
+      return true;
+    if (el.onclick)
+      return true;
+    const role = el.getAttribute ? el.getAttribute('role') : '';
+    if (role && ['button', 'link', 'menuitem'].includes(role.toLowerCase()))
+      return true;
+    return false;
+  };
+
+  const toText = (el) => {
+    try {
+      const txt = (el.innerText || el.textContent || '').trim();
+      return txt.length > 200 ? txt.slice(0, 200) : txt;
+    } catch (e) {
+      return '';
+    }
+  };
+
+  const getElementId = (el) => {
+    if (!el)
+      return '';
+    if (el.id)
+      return el.id;
+    if (el.getAttribute) {
+      const testId = el.getAttribute('data-testid') || el.getAttribute('data-qa');
+      if (testId)
+        return `data-testid:${testId}`;
+      const nameAttr = el.getAttribute('name');
+      if (nameAttr)
+        return `name:${nameAttr}`;
+    }
+    return '';
+  };
+
+  nodes.forEach((el) => {
+    if (!el)
+      return;
+    const rect = el.getBoundingClientRect();
+    const bounds = {
+      x: Number.isFinite(rect.x) ? rect.x : 0,
+      y: Number.isFinite(rect.y) ? rect.y : 0,
+      w: Number.isFinite(rect.width) ? rect.width : 0,
+      h: Number.isFinite(rect.height) ? rect.height : 0
+    };
+
+    result.elements.push({
+      elementId: getElementId(el),
+      frameId: 'root',
+      tag: el.tagName ? el.tagName.toLowerCase() : '',
+      role: el.getAttribute ? (el.getAttribute('role') || '') : '',
+      type: el.getAttribute ? (el.getAttribute('type') || '') : '',
+      text: toText(el),
+      accessibilityName: el.getAttribute ? (el.getAttribute('aria-label') || '') : '',
+      cssSelector: toSelector(el),
+      xpath: toXPath(el),
+      shadowChainSelector: getShadowChain(el),
+      resourcePath: '',
+      inShadowDom: !!(el.getRootNode && el.getRootNode().host),
+      shadowHostSelector: getShadowHostSelector(el),
+      clickable: isClickable(el),
+      focusable: isFocusable(el),
+      bounds: bounds
+    });
+  });
+
+  return result;
+})();
+)JS";
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_PAGE_MAP_JS_H_
