+void DashboardUIMessageHandler::HandleOverlayReady(
+    const base::Value::List& args) {
+  const std::string cb =
+      (args.size() > 0 && args[0].is_string()) ? args[0].GetString() : std::string();
+  // Flush any pending AI stream messages now that JS is ready.
+  if (web_ui()->CanCallJavascript()) {
+    if (!pending_ai_calls_.empty()) {
+      for (auto& call : pending_ai_calls_) {
+        const std::string& method = call.first;
+        auto& a = call.second;
+        if (a.size() == 0) {
+          web_ui()->CallJavascriptFunctionUnsafe(method);
+        } else if (a.size() == 1) {
+          web_ui()->CallJavascriptFunctionUnsafe(method, a[0]);
+        } else if (a.size() == 2) {
+          web_ui()->CallJavascriptFunctionUnsafe(method, a[0], a[1]);
+        } else {
+          web_ui()->CallJavascriptFunctionUnsafe(method, a[0], a[1], a[2]);
+        }
+      }
+      pending_ai_calls_.clear();
+    }
+  }
+  base::Value::Dict out; out.Set("ok", true);
+  ResolveCallback(cb, out);
+}
