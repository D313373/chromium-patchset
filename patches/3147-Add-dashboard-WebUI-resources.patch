+ListenerScript::ListenerScript(const ListenerScript&) = default;
+ListenerScript& ListenerScript::operator=(const ListenerScript&) = default;
+
+Dashboard::Dashboard() = default;
+Dashboard::~Dashboard() = default;
+
+// --- Script Storage ---
+void Dashboard::SaveScript(const std::string& id, base::Value::Dict script) {
+  scripts_[id] = std::move(script);
+  // TODO: Persist to disk as JSON file per script
+}
+
+void Dashboard::AddScript(const std::string& id, base::Value::Dict script) {
+  scripts_[id] = std::move(script);
+}
+
+void Dashboard::DeleteScript(const std::string& id) {
+  scripts_.erase(id);
+}
+
+base::Value::Dict Dashboard::LoadScript(const std::string& id) {
+  if (scripts_.count(id)) {
+    return scripts_[id].Clone();
+  }
+  return base::Value::Dict();
+}
+
+base::Value::Dict Dashboard::LoadAllScripts() {
+  base::Value::Dict all_scripts;
+  for (auto& [id, script] : scripts_) {
+    all_scripts.Set(id, script.Clone());
+  }
+  return all_scripts;
+}
+
+// --- Variables Storage ---
+void Dashboard::LoadVariables(const std::string& filepath) {
+  // This is a placeholder for loading from a persistent source.
+  // For now, it will just use in-memory variables.
+}
+
+base::Value::Dict Dashboard::LoadVariables() {
+  base::Value::Dict dict;
+  for (const auto& [key, value] : variables_) {
+    dict.Set(key, value);
+  }
+  return dict;
+}
+
+void Dashboard::SaveVariables(base::Value::Dict variables) {
+  variables_.clear();
+  for (auto [key, value] : variables) {
+    if (value.is_string()) {
+      variables_[key] = value.GetString();
+    }
+  }
+  // TODO: Persist to disk
+}
+
+// --- Table Storage ---
+void Dashboard::StoreTableData(
+    const std::string& table_name,
+    const std::vector<std::vector<std::string>>& data) {
+  tables_[table_name] = data;
+}
+
+std::vector<std::vector<std::string>> Dashboard::GetTableSlice(
+    const std::string& table_name,
+    size_t start_row,
+    size_t end_row) {
+  std::vector<std::vector<std::string>> slice;
+  if (!tables_.count(table_name))
+    return slice;
+
+  auto& table = tables_[table_name];
+  end_row = std::min(end_row, table.size());
+  for (size_t i = start_row; i < end_row; ++i) {
+    slice.push_back(table[i]);
+  }
+  return slice;
+}
