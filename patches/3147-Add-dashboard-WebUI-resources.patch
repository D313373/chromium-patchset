+// TypeEditor.js
+import { renderLocatorEditor } from '../components/locatorEditor.js';
+
+export function renderTypeEditor(container, action, onSave, onCancel) {
+  container.innerHTML = `
+    <h3>Type Configuration</h3>
+    <div id="locatorsContainer"></div>
+    <div>
+      <label>Text to Type:</label>
+      <smart-input id="typeText" data-type="string"></smart-input>
+    </div>
+    <div class="editor-actions">
+      <button id="saveType">Save</button>
+      <button id="cancelType">Cancel</button>
+    </div>
+  `;
+
+  const locatorsContainer = document.getElementById('locatorsContainer');
+  const textEl = document.getElementById('typeText');
+
+  action.text = action.text || '';
+  textEl.value = action.text;
+
+  // Initialize LocatorEditor
+  const locatorEditor = renderLocatorEditor(
+    locatorsContainer,
+    action.locators,
+    (locators) => {
+      action.locators = locators;
+    }
+  );
+
+  textEl.addEventListener('input', e => {
+    action.text = e.target.value;
+  });
+
+  document.getElementById('saveType').addEventListener('click', () => {
+    const locators = locatorEditor.getValue();
+    if (!locators || locators.length === 0) {
+      alert("Please provide at least one valid locator.");
+      return;
+    }
+    if (!action.text) {
+      alert("Please provide text to type.");
+      return;
+    }
+    action.locators = locators;
+    onSave(action);
+  });
+
+  document.getElementById('cancelType').addEventListener('click', () => onCancel());
