+#include "ui/gfx/geometry/point.h"
+
+namespace {
+
+std::optional<tabs::TabHandle> GetActiveTabHandleForProfile(Profile* profile) {
+  if (!profile) {
+    return std::nullopt;
+  }
+
+  Browser* browser = chrome::FindBrowserWithProfile(profile);
+  if (!browser) {
+    browser = chrome::FindLastActive();
+  }
+  if (!browser) {
+    return std::nullopt;
+  }
+
+  tabs::TabInterface* tab = browser->tab_strip_model()->GetActiveTab();
+  if (!tab) {
+    return std::nullopt;
+  }
+  return tab->GetHandle();
+}
+
+std::optional<gfx::Point> ExtractPointFromParams(const base::Value::Dict& p) {
+  const std::optional<int> x = p.FindInt("x");
+  const std::optional<int> y = p.FindInt("y");
+  if (!x || !y) {
+    return std::nullopt;
+  }
+  return gfx::Point(*x, *y);
+}
+
+std::string GetDashboardActionKind(const base::Value::Dict& action_dict) {
+  if (const std::string* a = action_dict.FindString("action")) {
+    return *a;
+  }
+  if (const std::string* t = action_dict.FindString("type")) {
+    return *t;
+  }
+  return std::string();
+}
+
+const base::Value::Dict* GetDashboardActionParams(const base::Value::Dict& d) {
+  if (const base::Value::Dict* p = d.FindDict("params")) {
+    return p;
+  }
+  if (const base::Value::Dict* p = d.FindDict("parameters")) {
+    return p;
+  }
+  return nullptr;
+}
+
+std::vector<std::unique_ptr<actor::ToolRequest>> BuildActorRequestsFromTimeline(
+    const base::Value::List& timeline,
+    tabs::TabHandle tab_handle) {
+  std::vector<std::unique_ptr<actor::ToolRequest>> out;
+
+  std::optional<gfx::Point> last_point;
+
+  for (const auto& item : timeline) {
+    const base::Value::Dict* d = item.GetIfDict();
+    if (!d) {
+      continue;
+    }
+
+    const std::string kind = GetDashboardActionKind(*d);
+    const base::Value::Dict* params = GetDashboardActionParams(*d);
+
+    if (kind == "click" || kind == "Click") {
+      if (!params) {
+        continue;
+      }
+      std::optional<gfx::Point> p = ExtractPointFromParams(*params);
+      if (!p) {
+        continue;
+      }
+      last_point = p;
+      out.push_back(std::make_unique<actor::ClickToolRequest>(
+          tab_handle, actor::PageTarget(*p), actor::MouseClickType::kLeft,
+          actor::MouseClickCount::kSingle));
+      continue;
+    }
+
+    if (kind == "type" || kind == "Type" || kind == "type_text") {
+      if (!params) {
+        continue;
+      }
+      const std::string* text = params->FindString("text");
+      if (!text) {
+        // Some older action formats use different field names.
+        text = params->FindString("text_to_type");
+      }
+      if (!text) {
+        continue;
+      }
+
+      std::optional<gfx::Point> p = ExtractPointFromParams(*params);
+      if (!p) {
+        p = last_point;
+      }
+      if (!p) {
+        continue;
+      }
+
+      out.push_back(std::make_unique<actor::TypeToolRequest>(
+          tab_handle, actor::PageTarget(*p), *text,
+          /*follow_by_enter=*/false, actor::TypeToolRequest::Mode::kAppend));
+      continue;
+    }
+
+    if (kind == "key_press") {
+      if (!params) {
+        continue;
+      }
+      const std::string* key = params->FindString("key");
+      if (!key) {
+        continue;
+      }
+      if (*key != "Enter") {
+        continue;
+      }
+      if (!last_point) {
+        continue;
+      }
+      out.push_back(std::make_unique<actor::TypeToolRequest>(
+          tab_handle, actor::PageTarget(*last_point), std::string_view(),
+          /*follow_by_enter=*/true, actor::TypeToolRequest::Mode::kAppend));
+      continue;
+    }
+
+    if (kind == "navigate" || kind == "Navigate") {
+      if (!params) {
+        continue;
+      }
+      const std::string* url = params->FindString("url");
+      if (!url) {
+        continue;
+      }
+      out.push_back(std::make_unique<actor::NavigateToolRequest>(tab_handle,
+                                                                 GURL(*url)));
+      continue;
+    }
+
+    if (kind == "wait" || kind == "Wait") {
+      if (!params) {
+        continue;
+      }
+      int ms = 0;
+      std::optional<int> wait_ms = params->FindInt("wait_time_ms");
+      if (!wait_ms) {
+        wait_ms = params->FindInt("duration_ms");
+      }
+      if (wait_ms) {
+        ms = *wait_ms;
+      }
+      if (ms <= 0) {
+        ms = 300;
+      }
+      out.push_back(std::make_unique<actor::WaitToolRequest>(
+          base::Milliseconds(ms), tabs::TabHandle::Null()));
+      continue;
+    }
+  }
+
+  return out;
+}
+
+}  // namespace
+
+DashboardHandler::DashboardHandler(
+    mojo::PendingReceiver<dashboard::mojom::DashboardHandler> receiver,
+    Profile* profile,
+    dashboard::Dashboard* dashboard)
+    : profile_(profile),
+      dashboard_(dashboard),
+      script_executor_(std::make_unique<ScriptExecutor>(profile)),
+      scheduler_service_(std::make_unique<dashboard::SchedulerService>(profile, dashboard)),
+      listener_manager_(std::make_unique<dashboard::ListenerManager>(profile, dashboard)),
+      receiver_(this, std::move(receiver)) {}
+
+DashboardHandler::~DashboardHandler() = default;
+
+void DashboardHandler::Initialize(InitializeCallback callback) {
+  // This can be used for any one-time setup. For now, it just completes.
+  std::move(callback).Run();
+}
+
+void DashboardHandler::GetScripts(GetScriptsCallback callback) {
+  std::move(callback).Run(dashboard::ScriptStore::LoadAll(profile_));
+}
+
+void DashboardHandler::CreateNewScript(base::Value::Dict payload,
+                                       CreateNewScriptCallback callback) {
+  std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  std::string name = payload.Find("name") ? payload.Find("name")->GetString() : "New Script";
+
+  base::Value::Dict script;
+  script.Set("name", name);
+  script.Set("actions", base::Value::List());
+  script.Set("settings", base::Value::Dict());
+
+  dashboard_->AddScript(id, std::move(script));
+
+  base::Value::Dict result;
+  result.Set("scriptId", id);
+  std::move(callback).Run(std::move(result));
+}
+
+void DashboardHandler::SaveScript(const std::string& id,
+                                  base::Value::Dict script_dict) {
+  auto canonical = dashboard::ScriptSchema::CanonicalizeForSave(std::move(script_dict), id, base::Time::Now());
+  dashboard::ScriptStore::Write(profile_, id, canonical);
+  dashboard_->SaveScript(id, canonical.Clone());
+  DashboardUIMessageHandler::NotifyScriptsChanged();
+}
+
+void DashboardHandler::AppendToScript(const std::string& id, base::Value::Dict delta) {
+  // Load existing (disk is source of truth)
+  base::Value::Dict existing;
+  dashboard::ScriptStore::Read(profile_, id, &existing);
+  // Canonicalize existing to ensure url_contexts present
+  auto existing_canon = dashboard::ScriptSchema::CanonicalizeForSave(std::move(existing), id, base::Time::Now());
+
+  // Build groups from delta
+  base::Value::List new_groups;
+  if (const base::Value::List* url_ctx = delta.FindList("url_contexts")) {
+    new_groups = url_ctx->Clone();
+  } else if (const base::Value::List* acts = delta.FindList("actions")) {
+    base::Value::Dict tmp;
+    tmp.Set("actions", acts->Clone());
+    auto tmp_canon = dashboard::ScriptSchema::CanonicalizeForSave(std::move(tmp), id, base::Time::Now());
+    if (const base::Value::List* g = tmp_canon.FindList("url_contexts")) new_groups = g->Clone();
+  }
+
+  // Merge groups: if last existing url == first new url, append actions to last; else push groups
+  base::Value* ex_ctx_any = existing_canon.Find("url_contexts");
+  if (!ex_ctx_any || !ex_ctx_any->is_list()) existing_canon.Set("url_contexts", base::Value::List());
+  base::Value::List* ex_ctxs = existing_canon.FindList("url_contexts");
+
+  if (!new_groups.empty()) {
+    if (ex_ctxs && !ex_ctxs->empty()) {
+      base::Value& last = ex_ctxs->back();
+      const base::Value& first = new_groups.front();
+      if (last.is_dict() && first.is_dict()) {
+        const base::Value::Dict& ld = last.GetDict();
+        const base::Value::Dict& fd = first.GetDict();
+        const std::string* lurl = ld.FindString("url");
+        const std::string* furl = fd.FindString("url");
+        if (lurl && furl && *lurl == *furl) {
+          // Append actions
+          // mutate last group's actions list via non-const access
+          base::Value::Dict& ldm = last.GetDict();
+          base::Value::List* la = ldm.FindList("actions");
+          const base::Value::List* fa = fd.FindList("actions");
+          if (la && fa) {
+            for (const auto& a : *fa) la->Append(a.Clone());
+            // Erase first group from new_groups
+            new_groups.erase(new_groups.begin());
+          }
+        }
+      }
+    }
+    if (ex_ctxs) {
+      for (auto& g : new_groups) ex_ctxs->Append(g.Clone());
+    }
+  }
+
+  // Persist
+  existing_canon = dashboard::ScriptSchema::CanonicalizeForSave(std::move(existing_canon), id, base::Time::Now());
+  dashboard::ScriptStore::Write(profile_, id, existing_canon);
+  dashboard_->SaveScript(id, existing_canon.Clone());
+  DashboardUIMessageHandler::NotifyScriptsChanged();
+}
+
+void DashboardHandler::DeleteScript(const std::string& id) {
+  dashboard_->DeleteScript(id);
+}
+
+void DashboardHandler::PlayScript(const std::string& id,
+                                  PlayScriptCallback callback) {
+  LOG(INFO) << "[Dashboard] PlayScript called id=" << id;
+  base::Value::Dict script = dashboard_->LoadScript(id);
+  if (const base::Value::List* ctxs = script.FindList("url_contexts")) {
+    LOG(INFO) << "[Dashboard] Loaded script url_contexts=" << ctxs->size();
+  } else if (const base::Value::List* acts = script.FindList("actions")) {
+    LOG(INFO) << "[Dashboard] Loaded legacy flat actions=" << acts->size();
+  } else {
+    LOG(WARNING) << "[Dashboard] Loaded script has no actions";
+  }
+
+  auto flatten_from_script = [&](const base::Value::Dict& s,
+                                 auto& flatten_from_script_ref) -> base::Value::List {
+    base::Value::List flat;
+    // Prefer url_contexts if present
+    if (const base::Value::List* ctxs = s.FindList("url_contexts")) {
+      for (const auto& c : *ctxs) {
+        if (!c.is_dict()) continue;
+        const base::Value::Dict& cd = c.GetDict();
+        if (const base::Value::List* acts = cd.FindList("actions")) {
+          for (const auto& a : *acts) flat.Append(a.Clone());
+        }
+      }
+    } else if (const base::Value::List* acts = s.FindList("actions")) {
+      for (const auto& a : *acts) flat.Append(a.Clone());
+    }
+    return flat;
+  };
+
+  // Recursively expand call_script actions inline by scriptId
+  base::flat_set<std::string> visiting;
+  std::function<base::Value::List(const base::Value::List&)> expand_calls;
+  expand_calls = [&](const base::Value::List& in) -> base::Value::List {
+    base::Value::List out;
+    for (const auto& v : in) {
+      if (!v.is_dict()) { out.Append(v.Clone()); continue; }
+      const base::Value::Dict& d = v.GetDict();
+      // Support both normalized UI {action, params} and engine {type, parameters}
+      const std::string* action = d.FindString("action");
+      const std::string* type = d.FindString("type");
+      const base::Value::Dict* params = d.FindDict("params");
+      const base::Value::Dict* parameters = d.FindDict("parameters");
+      std::string kind = action ? *action : (type ? *type : "");
+      if (kind == "call_script") {
+        const base::Value::Dict* p = params ? params : parameters;
+        std::string sid;
+        if (p) { if (const std::string* s = p->FindString("scriptId")) sid = *s; }
+        if (!sid.empty() && !visiting.contains(sid)) {
+          visiting.insert(sid);
+          base::Value::Dict callee = dashboard_->LoadScript(sid);
+          base::Value::List flat = flatten_from_script(callee, flatten_from_script);
+          base::Value::List expanded = expand_calls(flat);
+          for (auto& e : expanded) out.Append(std::move(e));
+          visiting.erase(sid);
+          continue;  // skip original call_script node
+        }
+      }
+      out.Append(v.Clone());
+    }
+    return out;
+  };
+
+  base::Value::List initial = flatten_from_script(script, flatten_from_script);
+  LOG(INFO) << "[Dashboard] PlayScript flatten size=" << initial.size();
+  base::Value::List final_seq = expand_calls(initial);
+  LOG(INFO) << "[Dashboard] PlayScript expanded size=" << final_seq.size();
+
+  std::optional<tabs::TabHandle> tab_handle = GetActiveTabHandleForProfile(profile_);
+  if (!tab_handle) {
+    std::move(callback).Run();
+    return;
+  }
+
+  auto actions = BuildActorRequestsFromTimeline(final_seq, *tab_handle);
+  if (actions.empty()) {
+    std::move(callback).Run();
+    return;
+  }
+
+  auto* actor_service = actor::ActorKeyedService::Get(profile_);
+  if (!actor_service) {
+    std::move(callback).Run();
+    return;
+  }
+
+  if (!actor_task_id_.is_null()) {
+    actor_service->StopTask(actor_task_id_,
+                            actor::ActorTask::StoppedReason::kStoppedByUser);
+    actor_task_id_ = actor::TaskId();
+  }
+
+  actor_task_id_ = actor_service->CreateTask();
+  actor::ActorTask* task = actor_service->GetTask(actor_task_id_);
+  if (!task) {
+    actor_task_id_ = actor::TaskId();
+    std::move(callback).Run();
+    return;
+  }
+
+  task->AddTab(*tab_handle,
+               base::BindOnce(
+                   [](base::WeakPtr<actor::ActorKeyedService> actor_service,
+                      actor::TaskId task_id,
+                      std::vector<std::unique_ptr<actor::ToolRequest>> actions,
+                      DashboardHandler::PlayScriptCallback callback,
+                      actor::mojom::ActionResultPtr add_tab_result) {
+                     if (!actor_service) {
+                       std::move(callback).Run();
+                       return;
+                     }
+                     actor::ActorTask* task = actor_service->GetTask(task_id);
+                     if (!task || !add_tab_result ||
+                         !actor::IsOk(*add_tab_result)) {
+                       actor_service->StopTask(
+                           task_id,
+                           actor::ActorTask::StoppedReason::kChromeFailure);
+                       std::move(callback).Run();
+                       return;
+                     }
+
+                     actor_service->PerformActions(
+                         task_id, std::move(actions), actor::ActorTaskMetadata(),
+                         base::BindOnce(
+                             [](base::WeakPtr<actor::ActorKeyedService>
+                                    actor_service,
+                                actor::TaskId task_id,
+                                actor::mojom::ActionResultCode,
+                                std::optional<size_t>,
+                                std::vector<actor::ActionResultWithLatencyInfo>) {
+                               if (!actor_service) {
+                                 return;
+                               }
+                               actor_service->StopTask(
+                                   task_id,
+                                   actor::ActorTask::StoppedReason::kTaskComplete);
+                             },
+                             actor_service->GetWeakPtr(), task_id));
+
+                     std::move(callback).Run();
+                   },
+                   actor_service->GetWeakPtr(), actor_task_id_,
+                   std::move(actions), std::move(callback)));
+}
