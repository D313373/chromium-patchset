+                newParams[paramKey] = selectInput.value;
+            } else if (textInput) {
+                // This will be null if smart-input was used, which is correct
+                newParams[paramKey] = textInput.value;
+            }
+        });
+
+        return newParams;
+    }
+
+    function saveActionEditor() {
+        const { action } = appState.editingActionData;
+        action.params = readActionParamsFromDOM();
+        console.log("Saved action:", action);
+        appState.isEditingAction = false;
+        appState.editingActionData = null;
+        renderAll();
+    }
+
+    function renderLocatorListEditor(container, locators) {
+        // This container is the form-group div
+        container.innerHTML = '';
+
+        // Create a host element to mount the LocatorEditor into
+        const listContainer = document.createElement('div');
+        listContainer.className = 'locator-list'; // keep old class for CSS compatibility
+        container.appendChild(listContainer);
+
+        // Use the shared LocatorEditor (SmartInput-based)
+        const editor = renderLocatorEditor(
+          listContainer,
+          locators || [],
+          // onChange callback: we don't *need* to update action.params live,
+          // because readActionParamsFromDOM will pull from editor.getValue().
+          () => {}
+        );
+
+        // Stash the editor instance on the group so we can read it later
+        container.__locatorEditor = editor;
+    }
+
+    // REMOVED: Legacy readLocatorsFromDOM function
+
+    function renderFieldListEditor(container, fields) {
+        const listContainer = document.createElement('div');
+        listContainer.className = 'field-list';
+
+        (fields || []).forEach((field, index) => {
+            const itemEl = document.createElement('div');
+            itemEl.className = 'field-item';
+
+            // REFACTOR: Changed to smart-input
+            const nameInput = document.createElement('smart-input');
+            nameInput.className = 'input-field field-name-input mb-2';
+            nameInput.placeholder = 'Field Name (e.g., product_name)';
+            nameInput.value = field.name || '';
+            // No listener needed, value is read on save via .value property
+
+            const locatorsLabel = document.createElement('label');
+            locatorsLabel.textContent = 'Locators for this field:';
+            locatorsLabel.className = 'text-xs text-gray-400 mb-1';
+
+            const locatorsContainer = document.createElement('div');
+            locatorsContainer.dataset.fieldName = field.name || '';
+
+            // ⬇️ Mount a LocatorEditor for this field’s locators
+            const editorHost = document.createElement('div');
+            locatorsContainer.appendChild(editorHost);
+            const editor = renderLocatorEditor(
+                editorHost,
+                field.locators || [],
+                () => {} // we’ll read values on save
+            );
+
+            // Store the editor instance on the item so readFieldsFromDOM can find it
+            itemEl.__locatorEditor = editor;
+
+            const removeBtn = document.createElement('button');
+            removeBtn.className = 'btn btn-danger w-full mt-2';
+            removeBtn.textContent = 'Remove Field';
+            removeBtn.onclick = () => {
+                const currentFields = readFieldsFromDOM(listContainer);
+                currentFields.splice(index, 1);
+                renderFieldListEditor(container, currentFields);
+            };
+
+            itemEl.appendChild(nameInput);
+            itemEl.appendChild(locatorsLabel);
+            itemEl.appendChild(locatorsContainer);
+            itemEl.appendChild(removeBtn);
+            listContainer.appendChild(itemEl);
+        });
+
+        const addBtn = document.createElement('button');
+        addBtn.className = 'btn mt-2';
+        addBtn.textContent = '+ Add Field';
+        addBtn.onclick = () => {
+            const currentFields = readFieldsFromDOM(listContainer);
+            currentFields.push({ name: '', locators: [] });
+            renderFieldListEditor(container, currentFields);
+        };
+
+        container.innerHTML = '';
+        container.appendChild(listContainer);
+        container.appendChild(addBtn);
+    }
+
+    function readFieldsFromDOM(listContainer) {
+        const fields = [];
+        listContainer.querySelectorAll('.field-item').forEach(item => {
+            // This works because <smart-input> exposes a .value property
+            const name = item.querySelector('.field-name-input')?.value || '';
+
+            // Prefer the LocatorEditor attached in renderFieldListEditor
+            let locators = [];
+            if (item.__locatorEditor) {
+                locators = item.__locatorEditor.getValue();
+            }
+            // REMOVED: Legacy fallback for readLocatorsFromDOM
+
+            fields.push({ name, locators });
+        });
+        return fields;
+    }
+
+// Normalize helpers for saving scripts in a canonical, validated format
+function canonicalizeLocatorType(t) {
+  if (!t) return 'CSS_SELECTOR';
+  const u = String(t).toUpperCase();
+  switch (u) {
+    case 'ID': case 'CSS_SELECTOR': case 'NAME': case 'ACCESSIBILITY_NAME':
+    case 'CLASS_NAME': case 'JS_EVAL': case 'SHADOW_DOM': case 'LINK_TEXT':
+    case 'PARTIAL_LINK_TEXT': case 'TAG_NAME': case 'XPATH': case 'TEXT_CONTENT':
+    case 'VISUAL_COORDS': case 'VISUAL_AI':
+      return u;
+  }
+  if (u === 'CSS' || u === 'SELECTOR' || u === 'CSS-SELECTOR') return 'CSS_SELECTOR';
+  if (u === 'CLASS' || u === 'CLASS-NAME') return 'CLASS_NAME';
+  if (u === 'A11Y' || u === 'ARIA' || u === 'ACCESSIBILITY') return 'ACCESSIBILITY_NAME';
+  if (u === 'LINK' || u === 'LINKTEXT' || u === 'LINK-TEXT') return 'LINK_TEXT';
+  if (u === 'TAG') return 'TAG_NAME';
+  if (u === 'TEXT' || u === 'INNER_TEXT' || u === 'INNERTEXT') return 'TEXT_CONTENT';
+  if (u === 'JS' || u === 'JAVASCRIPT') return 'JS_EVAL';
+  if (u === 'SHADOW' || u === 'SHADOW-DOM') return 'SHADOW_DOM';
+  if (u === 'COORDS' || u === 'COORDINATES') return 'VISUAL_COORDS';
+  if (u === 'AI' || u === 'VISUAL-AI') return 'VISUAL_AI';
+  return 'CSS_SELECTOR';
+}
+
+function normalizeLocators(locs) {
+  if (!Array.isArray(locs)) return [];
+  return locs
+    .map(l => {
+      const type = canonicalizeLocatorType(l?.type);
+      if (type === 'VISUAL_COORDS') {
+        const coords = parseVisualCoords(l?.value);
+        const value = coords ? formatVisualCoords(coords) : '';
+        return { type, value };
+      }
+      return { type, value: String(l?.value || '').trim() };
+    })
+    .filter(l => !!l.value)
+    .map(l => {
+      // If type is ID and value starts with '#', strip it
+      if (l.type === 'ID' && l.value.startsWith('#')) l.value = l.value.slice(1);
+      return l;
+    });
+}
+
+function normalizeAction(a) {
+  if (!a || typeof a !== 'object') return null;
+  const type = String(a.action || a.type || '').toLowerCase();
+  const params = a.params && typeof a.params === 'object' ? { ...a.params } : {};
+  const out = { action: type, params, nonCritical: !!a.nonCritical, comment: a.comment || '' };
+  switch (type) {
+    case 'navigate': {
+      params.url = String(params.url || '').trim();
+      if (!params.url) return null; // refuse invalid
+      break;
+    }
+    case 'click': {
+      params.locators = normalizeLocators(params.locators);
+      if (!params.locators.length) {
+        const coords = parseVisualCoords(params.coordinates);
+        const fromXY = parseVisualCoords({
+          x: params.x,
+          y: params.y
+        });
+        const merged = coords || fromXY;
+        if (merged) {
+          params.locators = [{
+            type: 'VISUAL_COORDS',
+            value: formatVisualCoords(merged)
+          }];
+        }
+      }
+      delete params.coordinates;
+      delete params.x;
+      delete params.y;
+      if (!params.locators.length) return null;
+      params.waitTimeout = Number.isFinite(params.waitTimeout) ? params.waitTimeout : 5000;
+      params.humanOffset = !!params.humanOffset;
+      params.clickCount = Math.min(3, Math.max(1, parseInt(params.clickCount || 1, 10)));
+      break;
+    }
+    case 'type': {
+      params.text = String(params.text || '');
+      if (!params.text) return null;
+      break;
+    }
+    case 'wait': {
+      // Normalize to {waitType,time/locators,timeout}
+      let waitType = params.waitType || (params.seconds != null ? 'time' : (Array.isArray(params.locators) ? 'element' : 'time'));
+      waitType = String(waitType).toLowerCase();
+      if (waitType === 'time') {
+        const secs = params.seconds != null ? parseInt(params.seconds, 10) : 0;
+        params.waitType = 'time';
+        params.time = Number.isFinite(params.time) ? params.time : Math.max(0, secs * 1000);
+        delete params.seconds;
+      } else if (waitType === 'element') {
+        params.waitType = 'element';
+        params.locators = normalizeLocators(params.locators);
+        params.timeout = Number.isFinite(params.timeout) ? params.timeout : 5000;
+        if (!params.locators.length) return null;
+      } else {
+        // default 1s
+        params.waitType = 'time';
+        params.time = 1000;
+      }
+      break;
+    }
+    case 'scrape_element': {
+      params.locators = normalizeLocators(params.locators);
+      if (!params.locators.length) return null;
+      params.variableName = String(params.variableName || 'result');
+      break;
+    }
+    case 'scroll': {
+      // Keep as-is; locators optional
+      if (Array.isArray(params.locators)) params.locators = normalizeLocators(params.locators);
+      params.percentY = Math.max(0, Math.min(100, parseInt(params.percentY || 0, 10)));
+      params.percentX = Math.max(0, Math.min(100, parseInt(params.percentX || 0, 10)));
+      break;
+    }
+    default:
+      break;
+  }
+  return out;
+}
+
+function normalizeScriptForSave(script) {
+  const s = script ? JSON.parse(JSON.stringify(script)) : { name: 'Untitled', actions: [] };
+  const normalizeList = (list) => (Array.isArray(list) ? list.map(normalizeAction).filter(Boolean) : []);
+  // Flat actions list
+  s.actions = normalizeList(s.actions);
+  // url_contexts list if present
+  if (Array.isArray(s.url_contexts)) {
+    s.url_contexts = s.url_contexts.map(ctx => ({
+      url: String(ctx?.url || ''),
+      name: ctx?.name || undefined,
+      note: ctx?.note || undefined,
+      actions: normalizeList(ctx?.actions || [])
+    }));
+  }
+  return s;
+}
+});
