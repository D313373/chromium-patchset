+// ----------------------------------------------------------------------
+// Build the built-in default “welcome demo” script.
+// ----------------------------------------------------------------------
+base::Value::Dict BuildDefaultScript() {
+  base::Value::Dict script;
+  const std::string id = "welcome_demo";
+  script.Set("id", id);
+  script.Set("scriptName", "Welcome to Automation Studio!");
+  script.Set("description",
+             "Learn the basics of creating and running automations. This script "
+             "demonstrates navigation, clicking, typing, and data scraping.");
+
+  base::Value::Dict settings;
+  settings.Set("startUrl", "https://www.google.com");
+  settings.Set("timeoutMs", 30000);
+  settings.Set("headless", false);
+  settings.Set("userAgent", "Default");
+  script.Set("settings", std::move(settings));
+
+  base::Value::List actions;
+
+  // Navigate
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_001");
+    a.Set("type", "Navigate");
+    base::Value::Dict p;
+    p.Set("url", "https://www.google.com");
+    p.Set("timeout_ms", 15000);
+    a.Set("parameters", std::move(p));
+    a.Set("notes",
+          "The 'Navigate' action tells the browser to go to a specific URL. "
+          "Here, we start on Google.com.");
+    actions.Append(std::move(a));
+  }
+
+  // Wait 2s
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_002");
+    a.Set("type", "Wait");
+    base::Value::Dict p;
+    p.Set("duration_ms", 2000);
+    a.Set("parameters", std::move(p));
+    a.Set("notes", "A short pause to let the page finish loading.");
+    actions.Append(std::move(a));
+  }
+
+  // Type text
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_003");
+    a.Set("type", "Type Text");
+    base::Value::Dict p;
+    p.Set("selector", "textarea[name='q']");
+    p.Set("text_to_type", "Automation Studio Chromium");
+    p.Set("keystroke_delay_ms", 50);
+    a.Set("parameters", std::move(p));
+    a.Set("notes", "Type a search query into the Google search box.");
+    actions.Append(std::move(a));
+  }
+
+  // Wait 1s
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_004");
+    a.Set("type", "Wait");
+    base::Value::Dict p;
+    p.Set("duration_ms", 1000);
+    a.Set("parameters", std::move(p));
+    a.Set("notes", "Give the UI a moment after typing.");
+    actions.Append(std::move(a));
+  }
+
+  // Click the search button
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_005");
+    a.Set("type", "Click");
+    base::Value::Dict p;
+    p.Set("selector",
+          "input[name='btnK'], button[aria-label='Google Search']");
+    p.Set("wait_for_navigation", true);
+    a.Set("parameters", std::move(p));
+    a.Set("notes", "Submit the search query.");
+    actions.Append(std::move(a));
+  }
+
+  // Wait for results
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_006");
+    a.Set("type", "Wait");
+    base::Value::Dict p;
+    p.Set("duration_ms", 2000);
+    a.Set("parameters", std::move(p));
+    a.Set("notes", "Let the results page settle.");
+    actions.Append(std::move(a));
+  }
+
+  // Scrape first result title
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_007");
+    a.Set("type", "Scrape Element");
+    base::Value::Dict p;
+    p.Set("selector", "h3");
+    p.Set("attribute_to_scrape", "innerText");
+    p.Set("target_variable_name", "first_search_result_title");
+    a.Set("parameters", std::move(p));
+    a.Set("notes", "Extract the title of the first result.");
+    actions.Append(std::move(a));
+  }
+
+  // Click the first result
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_008");
+    a.Set("type", "Click");
+    base::Value::Dict p;
+    p.Set("selector", "h3");
+    p.Set("wait_for_navigation", true);
+    a.Set("parameters", std::move(p));
+    a.Set("notes", "Open the first result.");
+    actions.Append(std::move(a));
+  }
+
+  // Final wait
+  {
+    base::Value::Dict a;
+    a.Set("id", "action_009");
+    a.Set("type", "Wait");
+    base::Value::Dict p;
+    p.Set("duration_ms", 3000);
+    a.Set("parameters", std::move(p));
+    a.Set("notes", "Pause before ending the script.");
+    actions.Append(std::move(a));
+  }
+
+  script.Set("actions", std::move(actions));
+  return script;
+}
