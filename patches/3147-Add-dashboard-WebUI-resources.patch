@@ -0,0 +1,34 @@
+module blink.mojom;
+
+// Stores current agent state as a debug-friendly string.
+struct AgentStatus {
+  string status_text;
+  uint32 step_index;
+  bool is_running;
+};
+
+// Events emitted by agent execution (Renderer → Browser).
+interface SimulachromeAgentEvents {
+  OnStarted(string goal);
+  OnStep(uint32 step_index, string description);
+  OnStopped(string reason);
+  OnDebug(string debug_message);
+};
+
+// Primary control interface for the agent (Browser → Renderer).
+interface SimulachromeAgent {
+  // Start with a specific goal.
+  Start(string goal);
+
+  // Stop immediately.
+  Stop();
+
+  // Perform one inference/action step.
+  Tick();
+
+  // Request status.
+  GetStatus() => (AgentStatus status);
+
+  // Subscribe to events.
+  BindEvents(SimulachromeAgentEvents event_pipe);
+};
