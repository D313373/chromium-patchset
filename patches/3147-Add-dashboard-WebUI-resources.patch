+#include "ui/base/page_transition_types.h"
+#include "base/files/file_util.h"
+
+namespace dashboard {
+namespace actions {
+
+// Convert URL to a safe ID string (alphanumeric + underscores only)
+std::string MakeSafeIdFromUrl(const std::string& url) {
+    std::string id = url;
+    std::replace_if(id.begin(), id.end(), [](char c) {
+        return !(std::isalnum(static_cast<unsigned char>(c)) || c == '_');
+    }, '_');
+
+    // Optional: truncate to max 32 chars
+    if (id.size() > 32)
+        id.resize(32);
+
+    return id;
+}
+
+NavigateHandler::NavigateHandler(Profile* profile) : profile_(profile) {}
+NavigateHandler::~NavigateHandler() = default;
+
+bool NavigateHandler::SetUrl(const std::string& url) {
+    if (!GURL(url).is_valid())
+        return false;
+    url_ = url;
+    return true;
+}
+
+void NavigateHandler::Execute(content::WebContents* web_contents, Callback callback) {
+    if (!web_contents) {
+        std::move(callback).Run(false, "WebContents is null");
+        return;
+    }
+
+    // Create a safe ID for the link
+    std::string link_id = MakeSafeIdFromUrl(url_);
+
+    // Create a temporary directory.html file in the profile path
+    base::FilePath dir_html = profile_->GetPath().AppendASCII("directory.html");
+
+    std::string html_content = "<!DOCTYPE html><html><body>"
+                               "<a id=\"" + link_id + "\" href=\"" + url_ + "\">go</a>"
+                               "</body></html>";
+
+    if (!base::WriteFile(dir_html, html_content)) {
+        std::move(callback).Run(false, "Failed to write directory.html");
+        return;
+    }
+
+        // Navigate WebContents to directory.html. Ensure file URL is well-formed
+        // (file:///absolute/path). Use AsUTF8Unsafe() and ensure a leading '/'.
+        std::string path_utf8 = dir_html.AsUTF8Unsafe();
+        std::string file_url_str = std::string("file://") + path_utf8;
+        // If path_utf8 doesn't start with '/', add one to form file:///path
+        if (!path_utf8.empty() && path_utf8[0] != '/')
+            file_url_str = std::string("file:///") + path_utf8;
+
+        LOG(INFO) << "NavigateHandler loading local file: " << file_url_str;
+
+        web_contents->GetController().LoadURL(
+                GURL(file_url_str),
+                content::Referrer(), ui::PAGE_TRANSITION_TYPED, std::string());
+
+    // Wait for the link element to be ready
+    Locator locator;
+    // Use ID locator to directly target element by id rather than a CSS selector
+    // (avoids having to escape IDs that start with digits).
+    locator.type = LocatorType::ID;
+    locator.value = link_id;
+
+    ElementReadinessChecker readiness_checker(web_contents);
+    ResolvedElement resolved;
+    std::string err;
+
+    if (!readiness_checker.WaitForElementReady({locator}, SearchScope::kAll,
+                                               15000, &resolved, &err)) {
+        std::move(callback).Run(false, "Link not ready: " + err);
+        return;
+    }
+
+    LOG(ERROR) << "Resolved element: (" << resolved.center_x << ", " << resolved.center_y << ")";
+
+    // Diagnostic: print element info in renderer console before clicking
+    std::string info_js = "(function(){\n"
+                          "  var el = document.elementFromPoint(" + std::to_string(resolved.center_x) + ", " + std::to_string(resolved.center_y) + ");\n"
+                          "  if (!el) { console.error('[NavigateHandler][Diag] elementFromPoint returned null'); return; }\n"
+                          "  try { console.info('[NavigateHandler][Diag] element tag=', el.tagName, 'id=', el.id, 'href=', el.href); } catch(e) { console.error('[NavigateHandler][Diag] element logging failed', e); }\n"
+                          "})();";
+    web_contents->GetPrimaryMainFrame()->ExecuteJavaScript(base::UTF8ToUTF16(info_js), base::NullCallback());
+
+    // Small delay to allow renderer finalization in some flaky cases.
+    base::RunLoop delay;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, delay.QuitClosure(), base::Milliseconds(50));
+    delay.Run();
+
+    bool clicked = click_handler.ExecuteClickAt(resolved.center_x, resolved.center_y, true, 1);
+    LOG(INFO) << "ClickHandler::ExecuteClickAt returned=" << clicked;
+    if (!clicked) {
+        // Try JS click fallback with diagnostics
+        LOG(ERROR) << "Synthetic click failed, trying JS fallback for id=" << link_id;
+        std::string js = "(function(){ try { var e=document.getElementById('" + link_id + "'); console.info('[NavigateHandler][Diag] fallback element=', e); if (e && e.click) { e.click(); console.info('[NavigateHandler][Diag] called e.click()'); } } catch(err) { console.error('[NavigateHandler][Diag] fallback error', err); } })();";
+        web_contents->GetPrimaryMainFrame()->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
+        LOG(ERROR) << "Click attempted on link_id: " << link_id;
+    } else {
+        LOG(INFO) << "Synthetic click reported success in NavigateHandler.";
+    }
+
+    // Wait for the final page to load (top-level body)
+    Locator body_locator;
+    body_locator.type = LocatorType::CSS_SELECTOR;
+    body_locator.value = "body";
+
+        if (!readiness_checker.WaitForElementReady({body_locator}, SearchScope::kAll,
+                                                                                             15000, &resolved, &err)) {
+                LOG(ERROR) << "Initial target page body not detected: " << err;
+
+                // Try deterministic fallback: read the href from the link and navigate
+                // the WebContents directly in case clicks didn't trigger navigation.
+                std::string get_href_js = "(function(){var e=document.getElementById('" + link_id + "'); return e?e.href:''; })();";
+                base::Value result;
+                base::RunLoop runLoop;
+        web_contents->GetPrimaryMainFrame()->ExecuteJavaScriptForTests(
+            base::UTF8ToUTF16(get_href_js),
+            base::BindOnce(
+                [](base::RunLoop* loop, base::Value* out, base::Value v) { *out = std::move(v); loop->Quit(); },
+                &runLoop, &result),
+            0 /* world_id */);
+                runLoop.Run();
+
+                std::string href;
+                if (result.is_string())
+                    href = result.GetString();
+
+                if (!href.empty() && GURL(href).is_valid()) {
+                    LOG(INFO) << "Fallback navigating directly to href: " << href;
+                    web_contents->GetController().LoadURL(
+                            GURL(href), content::Referrer(), ui::PAGE_TRANSITION_LINK, std::string());
+
+                    // Try waiting for body again
+                    if (!readiness_checker.WaitForElementReady({body_locator}, SearchScope::kAll,
+                                                                                                         15000, &resolved, &err)) {
+                        std::move(callback).Run(false, "Target page did not load after direct navigation: " + err);
+                        return;
+                    }
+
+                    std::move(callback).Run(true, "");
+                    return;
+                }
+
+                std::move(callback).Run(false, "Target page did not load: " + err);
+                return;
+        }
+
+        std::move(callback).Run(true, "");
+}
+
+}  // namespace actions
+}  // namespace dashboard
