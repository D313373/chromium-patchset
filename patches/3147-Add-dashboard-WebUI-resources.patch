@@ -0,0 +1,53 @@
+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ACTION_BASE_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ACTION_BASE_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+namespace dashboard {
+namespace actions {
+
+// Base class for all actions that can be executed in the dashboard.
+class Action {
+ public:
+  // The callback reports success/failure and returns an optional string,
+  // which is useful for actions that need to return data (e.g., scraping).
+  using Callback = base::OnceCallback<void(bool, const std::string&)>;
+
+  explicit Action(Profile* profile);
+  virtual ~Action();
+
+  // Executes the action using its internal state.
+  virtual void Execute(content::WebContents* web_contents,
+                       Callback callback) = 0;
+
+  // The factory will call this to set the parameters from the JSON.
+  virtual bool SetParams(const base::Value::Dict& params) = 0;
+
+  // Emit a structured timeline representation after execution. Subclasses
+  // should override and populate |out| with an "action" string and "params"
+  // object matching the canonical dashboard schema.
+  virtual void SerializeInto(base::Value::Dict* out) const;
+
+ protected:
+  void SetSerializedAction(const std::string& action, base::Value::Dict params);
+
+  raw_ptr<Profile> profile_;
+  std::string serialized_action_name_;
+  base::Value::Dict serialized_params_;
+};
+
+}  // namespace actions
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ACTION_BASE_H_
+
