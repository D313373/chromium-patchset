+// 2. PRESERVE YOUR CUSTOM NORMALIZATION LOGIC
+function normalizeScriptsDict(raw) {
+  const out = {};
+  if (!raw || typeof raw !== 'object') return out;
+  const coerceWaitParams = (a) => {
+    try {
+      if (!a || typeof a !== 'object') return a;
+      const t = String(a.action || a.type || '').toLowerCase();
+      if (t !== 'wait') return a;
+      const p = a.params || a.parameters || {};
+      // If only time (ms) is present, synthesize seconds for UI
+      if ((p.seconds == null || Number.isNaN(p.seconds)) && (p.time != null)) {
+        const ms = Number(p.time);
+        if (Number.isFinite(ms) && ms >= 0) {
+          const secs = Math.round(ms / 1000);
+          if (!a.params) a.params = {};
+          a.params.seconds = secs;
+        }
+      }
+    } catch(_) {}
+    return a;
+  };
+  for (const [id, script] of Object.entries(raw)) {
+    // Preferred: canonical url_contexts schema
