+// Compatibility wrapper for existing action editors
+export function renderLocatorEditor(container, locators, onChange) {
+  const editor = new LocatorEditor(container);
+  editor.render();
+  
+  if (locators) {
+    editor.setValue(locators);
+  }
+  
+  if (onChange) {
+    editor.setOnChange(onChange);
+  }
+  
+  return editor;
+}
