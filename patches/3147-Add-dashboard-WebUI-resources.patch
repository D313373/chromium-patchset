+#include "content/public/browser/render_frame_host.h"
+#include "chrome/browser/ui/webui/dashboard/recorder_controller.h"
+
+// static
+void RecorderAgentImpl::Create(
+    content::RenderFrameHost* rfh,
+    mojo::PendingReceiver<dashboard::mojom::RecorderAgent> receiver) {
+  // Lifetime is tied to the pipe; the object deletes itself when disconnected.
+  new RecorderAgentImpl(rfh, std::move(receiver));
+}
+
+RecorderAgentImpl::RecorderAgentImpl(
+    content::RenderFrameHost* rfh,
+    mojo::PendingReceiver<dashboard::mojom::RecorderAgent> receiver)
+    : rfh_(rfh), receiver_(this, std::move(receiver)) {}
+
+RecorderAgentImpl::~RecorderAgentImpl() = default;
+
+void RecorderAgentImpl::OnUserClick(dashboard::mojom::UserClickPtr click) {
+  RecorderController* rc = RecorderController::GetActive();
+  if (!rc)
+    return;
+  base::Value::Dict dict;
+  dict.Set("css", click->css);
+  dict.Set("xpath", click->xpath);
+  dict.Set("shadow_chain", click->shadow_chain);
+  dict.Set("x", click->x);
+  dict.Set("y", click->y);
+  dict.Set("frame_id", click->frame_id);
+   dict.Set("accessibility_name", click->accessibility_name);
+   dict.Set("role", click->role);
+   dict.Set("is_disabled", click->is_disabled);
+  rc->OnUserClickFromRenderer(std::move(dict));
+}
+
+void RecorderAgentImpl::OnAgentStateSnapshot(
+    dashboard::mojom::AgentStateSnapshotPtr snapshot) {
+  RecorderController* rc = RecorderController::GetActive();
+  if (!rc || !snapshot)
+    return;
+  rc->OnAgentStateSnapshotFromRenderer(std::move(snapshot));
+}
