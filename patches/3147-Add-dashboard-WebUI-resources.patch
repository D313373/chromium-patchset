diff --git a/chrome/browser/resources/dashboard/components/smartInput.js b/chrome/browser/resources/dashboard/components/smartInput.js
new file mode 100644
index 0000000000000000000000000000000000000000..b8aa440400d65c788909710372848cfca51ae133
--- /dev/null
+++ b/chrome/browser/resources/dashboard/components/smartInput.js
@@ -0,0 +1,276 @@
+// ==============================================
+// File: SmartInput.js
+// ==============================================
+
+class SmartInput extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+
+    this.value = this.getAttribute('value') || '';
+    this.variables = {}; // { varName: value }
+    this.tables = {};    // { tableName: { fieldName: value } }
+    this.autocompleteActive = false;
+
+    this._render();
+    this._setupEvents();
+  }
+
+  static get observedAttributes() {
+    return ['placeholder', 'title', 'type', 'value'];
+  }
+
+  // Render the input and dropdown
+  _render() {
+    const style = document.createElement('style');
+    style.textContent = `
+      .smart-input-container { position: relative; display: inline-block; width: 100%; }
+      input { width: 100%; box-sizing: border-box; padding: 4px; }
+      ul.dropdown { position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #ccc; list-style: none; margin: 0; padding: 0; max-height: 200px; overflow-y: auto; z-index: 1000; display: none; }
+      ul.dropdown li { padding: 4px; cursor: pointer; }
+      ul.dropdown li.selected { background-color: #0078d4; color: white; }
+      .settings-icon { position: absolute; top: 4px; right: 4px; cursor: pointer; display: none; }
+    `;
+
+    this.container = document.createElement('div');
+    this.container.className = 'smart-input-container';
+
+    this.inputEl = document.createElement('input');
+    this.inputEl.type = this.getAttribute('type') || 'text';
+    this.inputEl.value = this.value;
+    this.inputEl.placeholder = this.getAttribute('placeholder') || '';
+    this.inputEl.title = this.getAttribute('title') || '';
+
+    this.dropdown = document.createElement('ul');
+    this.dropdown.className = 'dropdown';
+
+    this.settingsIcon = document.createElement('span');
+    this.settingsIcon.className = 'settings-icon';
+    this.settingsIcon.textContent = '⚙️';
+
+    this.container.appendChild(this.inputEl);
+    this.container.appendChild(this.dropdown);
+    this.container.appendChild(this.settingsIcon);
+
+    this.shadowRoot.appendChild(style);
+    this.shadowRoot.appendChild(this.container);
+  }
+
+  // Event bindings
+  _setupEvents() {
+    this.inputEl.addEventListener('input', e => {
+      this.value = e.target.value;
+      this._updateAutocomplete();
+      this._updateSettingsIcon();
+      // Notify host form of changed value
+      this.dispatchEvent(new CustomEvent('input-change', { detail: this.value }));
+    });
+
+    this.inputEl.addEventListener('blur', () => {
+      setTimeout(() => this._hideDropdown(), 200);
+    });
+
+    this.inputEl.addEventListener('keydown', e => this._handleKeyDown(e));
+    this.settingsIcon.addEventListener('click', () => this._toggleSettings());
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (!this.inputEl) return;
+    switch (name) {
+      case 'placeholder':
+        this.inputEl.placeholder = newValue || '';
+        break;
+      case 'title':
+        this.inputEl.title = newValue || '';
+        break;
+      case 'type':
+        this.inputEl.type = newValue || 'text';
+        break;
+      case 'value':
+        this.value = newValue || '';
+        break;
+      default:
+        break;
+    }
+  }
+
+  _handleKeyDown(e) {
+    if (!this.autocompleteActive) return;
+
+    const items = Array.from(this.dropdown.children);
+    let selected = this.dropdown.querySelector('.selected');
+    if (!selected && items.length) selected = items[0];
+
+    switch(e.key) {
+      case 'ArrowDown':
+        if (selected) {
+          let next = selected.nextElementSibling ?? items[0];
+          selected.classList.remove('selected');
+          next.classList.add('selected');
+        }
+        e.preventDefault();
+        break;
+      case 'ArrowUp':
+        if (selected) {
+          let prev = selected.previousElementSibling ?? items[items.length - 1];
+          selected.classList.remove('selected');
+          prev.classList.add('selected');
+        }
+        e.preventDefault();
+        break;
+      case 'Enter':
+        if (selected) {
+          this._selectAutocomplete(selected.dataset.value);
+          e.preventDefault();
+        }
+        break;
+      case 'Escape':
+        this._hideDropdown();
+        break;
+    }
+  }
+
+  // Show suggestions based on cursor position
+  _updateAutocomplete() {
+    const cursorPos = this.inputEl.selectionStart;
+    const textBeforeCursor = this.value.substring(0, cursorPos);
+    const match = /({[\w.:]*|#[\w-]*)$/.exec(textBeforeCursor);
+
+    if (!match) {
+      this._hideDropdown();
+      return;
+    }
+
+    const prefix = match[1].replace(/[{}#]/, '').toLowerCase();
+    const suggestions = this._getSuggestions(prefix);
+
+    if (!suggestions.length) {
+      this._hideDropdown();
+      return;
+    }
+
+    this._showDropdown(suggestions);
+  }
+
+  _getSuggestions(prefix) {
+    const suggestions = [];
+    const usesColon = prefix.includes(":");
+
+    // Variables {var}
+    for (let v in this.variables) {
+      const vn = v.toLowerCase();
+      if (!usesColon && vn.startsWith(prefix)) suggestions.push(`{${v}}`);
+    }
+
+    // Tables and fields
+    for (let t in this.tables) {
+      const tn = t.toLowerCase();
+      const fields = this.tables[t];
+
+      if (!usesColon) {
+        // Dot style
+        if (tn.startsWith(prefix)) suggestions.push(`{${t}}`);
+        for (let f in fields) {
+          const fullDot = `${t}.${f}`;
+          if (fullDot.toLowerCase().startsWith(prefix)) suggestions.push(`{${fullDot}}`);
+        }
+        // Also offer colon-style starters
+        if (tn.startsWith(prefix)) suggestions.push(`{${t}:`);
+        for (let f in fields) {
+          const fullColon = `${t}:${f}`;
+          if (fullColon.toLowerCase().startsWith(prefix)) suggestions.push(`{${fullColon}}`);
+        }
+      } else {
+        // Colon style parsing: table:field(:row?)
+        if (prefix.startsWith(tn + ":")) {
+          const rest = prefix.slice(tn.length + 1);
+          const parts = rest.split(":");
+          const fieldPrefix = (parts[0] || "").toLowerCase();
+          for (let f in fields) {
+            const fn = f.toLowerCase();
+            if (!fieldPrefix || fn.startsWith(fieldPrefix)) {
+              // Suggest up to field, and a hint for row index
+              suggestions.push(`{${t}:${f}}`);
+              suggestions.push(`{${t}:${f}:}`);
+            }
+          }
+        }
+      }
+    }
+
+    // Tags: #tag
+    if (window.globalTags) {
+      for (let tag in window.globalTags) {
+        if (tag.toLowerCase().startsWith(prefix)) suggestions.push(`#${tag}`);
+      }
+    }
+
+    return suggestions;
+  }
+
+  _showDropdown(suggestions) {
+    this.dropdown.innerHTML = '';
+    suggestions.forEach((s, idx) => {
+      const li = document.createElement('li');
+      li.textContent = s;
+      li.dataset.value = s;
+      li.className = idx === 0 ? 'selected' : '';
+      li.addEventListener('mousedown', () => this._selectAutocomplete(s));
+      this.dropdown.appendChild(li);
+    });
+
+    const rect = this.inputEl.getBoundingClientRect();
+    this.dropdown.style.top = `${rect.bottom + window.scrollY}px`;
+    this.dropdown.style.left = `${rect.left + window.scrollX}px`;
+    this.dropdown.style.display = 'block';
+    this.autocompleteActive = true;
+  }
+
+  _hideDropdown() {
+    this.dropdown.style.display = 'none';
+    this.autocompleteActive = false;
+  }
+
+  _selectAutocomplete(value) {
+    const cursorPos = this.inputEl.selectionStart;
+    const textBeforeCursor = this.value.substring(0, cursorPos);
+    const match = /({[\w.]*|#[\w-]*)$/.exec(textBeforeCursor);
+    if (!match) return;
+
+    const newText = textBeforeCursor.substring(0, match.index) + value + this.value.substring(cursorPos);
+    this.inputEl.value = newText;
+    this.value = newText;
+    this._hideDropdown();
+    this.inputEl.setSelectionRange(match.index + value.length, match.index + value.length);
+    this.inputEl.focus();
+  }
+
+  _updateSettingsIcon() {
+    if (/{[\w.]+|#[\w-]+/.test(this.value)) {
+      this.settingsIcon.style.display = 'inline';
+    } else {
+      this.settingsIcon.style.display = 'none';
+    }
+  }
+
+  _toggleSettings() {
+    // For example: multi-line toggle
+    alert('Settings panel would open here for multi-line / other options');
+  }
+
+  // Public API
+  getValue() { return this.value; }
+  setValue(val) { this.value = val; }
+  updateVariables(vars) { this.variables = vars; }
+  updateTables(tables) { this.tables = tables; }
+
+  // Value property accessors to keep DOM property and internal state in sync
+  get value() { return this._value ?? ''; }
+  set value(val) {
+    this._value = String(val ?? '');
+    if (this.inputEl) this.inputEl.value = this._value;
+  }
+}
+
+customElements.define('smart-input', SmartInput);
