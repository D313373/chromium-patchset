+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_RECORDER_DEVTOOLS_CLIENT_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_RECORDER_DEVTOOLS_CLIENT_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+
+namespace content { class DevToolsAgentHost; }
+
+// Lightweight DevTools client that receives protocol events and forwards
+// Runtime.bindingCalled payloads to a callback. Also forwards generic
+// command responses (matched by "id") via a response callback.
+class RecorderDevToolsClient : public content::DevToolsAgentHostClient {
+ public:
+  using PayloadCallback = base::RepeatingCallback<void(const std::string&)>;
+  using ResponseCallback = base::RepeatingCallback<void(int, base::Value::Dict, base::Value::Dict)>;
+  using EventCallback = base::RepeatingCallback<void(const std::string&, base::Value::Dict)>;
+
+  explicit RecorderDevToolsClient(PayloadCallback on_payload,
+                                  ResponseCallback on_response,
+                                  EventCallback on_event);
+  ~RecorderDevToolsClient() override;
+
+  // content::DevToolsAgentHostClient
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+
+  bool IsTrusted() override;
+  bool UsesBinaryProtocol() override;
+  std::string GetTypeForMetrics() override;
+
+ private:
+  PayloadCallback on_payload_;
+  ResponseCallback on_response_;
+  EventCallback on_event_;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_RECORDER_DEVTOOLS_CLIENT_H_
