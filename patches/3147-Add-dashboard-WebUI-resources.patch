+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_ANTI_DETECTION_CONTROLLER_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_ANTI_DETECTION_CONTROLLER_H_
+
+#include <memory>
+#include <string>
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "url/gurl.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace dashboard {
+
+// Manages anti-detection script injection into web pages via DevTools Protocol
+class AntiDetectionController : public content::WebContentsObserver,
+                                public content::DevToolsAgentHostClient {
+ public:
+  explicit AntiDetectionController(content::WebContents* web_contents);
+  ~AntiDetectionController() override;
+
+  // Load anti-detection settings and inject scripts into the current page
+  void InjectAntiDetectionScripts(
+      const base::Value::Dict& anti_detection_settings);
+  // Compatibility overload (accepts generic base::Value)
+  void InjectAntiDetectionScripts(const base::Value& anti_detection_settings);
+
+  // WebContentsObserver overrides
+  void DidFinishLoad(content::RenderFrameHost* render_frame_host,
+                     const GURL& validated_url) override;
+  void WebContentsDestroyed() override;
+
+  // DevToolsAgentHostClient overrides
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+
+ private:
+  // Attach to DevTools for the current WebContents
+  void AttachToDevTools();
+
+  // Detach from DevTools
+  void DetachFromDevTools();
+
+  // Send a Chrome DevTools Protocol command
+  void SendCommand(const std::string& method, base::Value::Dict params);
+  // Send a CDP command to a specific session (flattened session)
+  void SendCommandToSession(const std::string& method,
+                            base::Value::Dict params,
+                            const std::string& session_id);
+
+  // Enable auto-attach so we can register scripts for all frames/targets
+  void EnableAutoAttach();
+  // Register the new-document script for a given session
+  void RegisterScriptForSession(const std::string& session_id);
+
+  // Inject the anti-detection script via CDP (root session)
+  void InjectScript(const std::string& script);
+
+  scoped_refptr<content::DevToolsAgentHost> agent_host_;
+  base::Value::Dict current_settings_;
+  int next_command_id_ = 1;
+  bool auto_attach_enabled_ = false;
+
+  base::WeakPtrFactory<AntiDetectionController> weak_ptr_factory_{this};
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ANTI_DETECTION_CONTROLLER_H_
+
diff --git a/chrome/browser/ui/webui/dashboard/anti_detection_injector.cc b/chrome/browser/ui/webui/dashboard/anti_detection_injector.cc
