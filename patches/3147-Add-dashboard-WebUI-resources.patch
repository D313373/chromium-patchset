+    base::Value::Dict out;
+    out.Set("ok", false);
+    ResolveCallback(cb, out); // FIX
+    return;
+  }
+
+  BrowserView* bv = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!bv) {
+    LOG(ERROR) << "[Dashboard] ShowOverlay: no BrowserView.";
+    base::Value::Dict out;
+    out.Set("ok", false);
+    ResolveCallback(cb, out); // FIX
+    return;
+  }
+  // Ensure a recorder controller exists but do not start passive mode.
+  RecorderController* rc = RecorderController::GetActive();
+  if (!rc) {
+    if (!recorder_)
+      recorder_ = std::make_unique<RecorderController>();
+    rc = recorder_.get();
+    RecorderController::SetActive(rc);
+  }
+  rc->ShowOverlayOnly(bv);
+  base::Value::Dict out;
+  out.Set("ok", true);
+  ResolveCallback(cb, out);
