--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/anti_detection_injector.cc
@@ -0,0 +1,407 @@
+#include "chrome/browser/ui/webui/dashboard/anti_detection_injector.h"
+
+#include <random>
+#include <utility>
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+
+namespace dashboard {
+
+
+SpoofedPlugin::SpoofedPlugin() = default;
+SpoofedPlugin::SpoofedPlugin(const std::string& name,
+                             const std::string& description,
+                             const std::string& filename,
+                             std::vector<std::string> mime_types)
+    : name(name),
+      description(description),
+      filename(filename),
+      mime_types(std::move(mime_types)) {}
+SpoofedPlugin::SpoofedPlugin(const SpoofedPlugin&) = default;
+SpoofedPlugin& SpoofedPlugin::operator=(const SpoofedPlugin&) = default;
+SpoofedPlugin::SpoofedPlugin(SpoofedPlugin&&) = default;
+SpoofedPlugin& SpoofedPlugin::operator=(SpoofedPlugin&&) = default;
+SpoofedPlugin::~SpoofedPlugin() = default;
+
+AntiDetectionInjector::AntiDetectionInjector() = default;
+AntiDetectionInjector::~AntiDetectionInjector() = default;
+
+std::vector<SpoofedPlugin> AntiDetectionInjector::GetPopularPlugins() {
+  // Modern Chrome typically exposes no NPAPI plugins. If spoofing is enabled,
+  // keep the set minimal and plausible.
+  return {
+      {"Chrome PDF Viewer", "Portable Document Format", "internal-pdf-viewer",
+       {"application/pdf"}},
+  };
+}
+
+std::vector<SpoofedPlugin> AntiDetectionInjector::SelectRandomPlugins(
+    int count) {
+  auto all_plugins = GetPopularPlugins();
+  std::vector<SpoofedPlugin> selected;
+
+  if (count <= 0 || count >= static_cast<int>(all_plugins.size())) {
+    return all_plugins;
+  }
+
+  std::random_device rd;
+  std::mt19937 gen(rd());
+  std::uniform_int_distribution<> dis(0, all_plugins.size() - 1);
+
+  while (selected.size() < static_cast<size_t>(count)) {
+    int idx = dis(gen);
+    auto& plugin = all_plugins[idx];
+    // Avoid duplicates
+    if (std::find_if(selected.begin(), selected.end(),
+                     [&plugin](const SpoofedPlugin& p) {
+                       return p.filename == plugin.filename;
+                     }) == selected.end()) {
+      selected.push_back(plugin);
+    }
+  }
+
+  return selected;
+}
+
+std::vector<SpoofedPlugin> AntiDetectionInjector::SelectPluginsByIndex(
+    const std::vector<int>& indices) {
+  auto all_plugins = GetPopularPlugins();
+  std::vector<SpoofedPlugin> selected;
+
+  for (int idx : indices) {
+    if (idx >= 0 && idx < static_cast<int>(all_plugins.size())) {
+      selected.push_back(all_plugins[idx]);
+    }
+  }
+
+  return selected;
+}
+
+std::string AntiDetectionInjector::GenerateWebdriverSpoof() {
+  // Aim to make both `navigator.webdriver` and `'webdriver' in navigator` falsy by
+  // removing the property from both the instance and the prototype, with fallbacks.
+  return R"(
+    (function(){
+      try {
+        const remove = (obj, key) => { try { return delete obj[key]; } catch(_) { return false; } };
+        // Try to remove from prototype and instance so `'webdriver' in navigator` is false
+        if (typeof Navigator !== 'undefined' && Navigator.prototype) {
+          remove(Navigator.prototype, 'webdriver');
+        }
+        remove(navigator, 'webdriver');
+        // Fallback: if still present, shadow with undefined and try deletion again
+        if ('webdriver' in navigator) {
+          try {
+            Object.defineProperty(navigator, 'webdriver', { get: () => undefined, configurable: true });
+          } catch(_) {}
+          remove(navigator, 'webdriver');
+        }
+      } catch (_) {}
+    })();
+  )";
+}
+
+std::string AntiDetectionInjector::GeneratePluginsSpoof(
+    const std::vector<SpoofedPlugin>& plugins) {
+  // Build JSON for plugin definitions to construct realistic Plugin/PluginArray
+  base::Value::List defs;
+  for (const auto& p : plugins) {
+    base::Value::Dict d;
+    d.Set("name", p.name);
+    d.Set("description", p.description);
+    d.Set("filename", p.filename);
+    base::Value::List mts;
+    for (const auto& mt : p.mime_types) mts.Append(mt);
+    d.Set("mimeTypes", std::move(mts));
+    defs.Append(std::move(d));
+  }
+  std::string defs_json;
+  base::JSONWriter::Write(defs, &defs_json);
+
+  std::string js;
+  js.reserve(4096);
+  js += "(function(){\n";
+  js += "  try {\n";
+  js += "    const defs = " + defs_json + ";\n";
+  js += R"JS(
+    function defineToStringTag(obj, tag) {
+      try { Object.defineProperty(obj, Symbol.toStringTag, { value: tag }); } catch {}
+    }
+    function makePlugin(def) {
+      const plugin = {};
+      Object.defineProperties(plugin, {
+        name: { value: def.name, enumerable: true },
+        description: { value: def.description, enumerable: true },
+        filename: { value: def.filename, enumerable: true }
+      });
+      const mimes = [];
+      def.mimeTypes.forEach((t, i) => {
+        const mt = {};
+        Object.defineProperties(mt, {
+          type: { value: t, enumerable: true },
+          suffixes: { value: '', enumerable: true },
+          description: { value: '', enumerable: true },
+          enabledPlugin: { get: () => plugin }
+        });
+        defineToStringTag(mt, 'MimeType');
+        Object.defineProperty(plugin, i, { value: mt, enumerable: true });
+        mimes.push(mt);
+      });
+      Object.defineProperties(plugin, {
+        length: { get: () => mimes.length, enumerable: true },
+        item: { value: (i) => mimes[i] || null },
+        namedItem: { value: (name) => mimes.find(mt => mt.type === name) || null }
+      });
+      defineToStringTag(plugin, 'Plugin');
+      return { plugin, mimes };
+    }
+    // Build arrays
+    const built = defs.map(makePlugin);
+    const pluginsArr = [];
+    const mimeArr = [];
+    built.forEach(({plugin, mimes}, idx) => {
+      pluginsArr[idx] = plugin;
+      // Also expose by name
+      try { Object.defineProperty(pluginsArr, plugin.name, { value: plugin, enumerable: false }); } catch {}
+      mimes.forEach(mt => mimeArr.push(mt));
+    });
+    // Create array-like PluginArray with correct API and tags
+    const pluginArray = Object.create(Array.prototype);
+    pluginsArr.forEach((p,i)=> Object.defineProperty(pluginArray, i, { value: p, enumerable: true }));
+    Object.defineProperties(pluginArray, {
+      length: { get: () => pluginsArr.length, enumerable: true },
+      item: { value: (i) => pluginsArr[i] || null },
+      namedItem: { value: (name) => pluginsArr.find(p => p && p.name === name) || null },
+      refresh: { value: function(){} }
+    });
+    defineToStringTag(pluginArray, 'PluginArray');
+    // Create array-like MimeTypeArray
+    const mimeTypeArray = Object.create(Array.prototype);
+    mimeArr.forEach((m,i)=> Object.defineProperty(mimeTypeArray, i, { value: m, enumerable: true }));
+    Object.defineProperties(mimeTypeArray, {
+      length: { get: () => mimeArr.length, enumerable: true },
+      item: { value: (i) => mimeArr[i] || null },
+      namedItem: { value: (name) => mimeArr.find(m => m && m.type === name) || null }
+    });
+    defineToStringTag(mimeTypeArray, 'MimeTypeArray');
+    // Install on navigator with getters
+    try { Object.defineProperty(navigator, 'plugins', { get: () => pluginArray, configurable: true }); } catch {}
+    try { Object.defineProperty(navigator, 'mimeTypes', { get: () => mimeTypeArray, configurable: true }); } catch {}
+  )JS";
+  js += "  } catch(_) {}\n";
+  js += "})();\n";
+  return js;
+}
+std::string AntiDetectionInjector::GenerateLanguagesSpoof(
+    const std::vector<std::string>& languages) {
+  std::string langs_json;
+  base::Value::List langs_list;
+  for (const auto& lang : languages) {
+    langs_list.Append(lang);
+  }
+  base::JSONWriter::Write(langs_list, &langs_json);
+
+  return "Object.defineProperty(navigator, 'languages', { get: () => " +
+         langs_json + ", configurable: true });";
+}
+
+std::string AntiDetectionInjector::GeneratePlatformSpoof(
+    const std::string& platform) {
+  if (platform.empty()) return "";
+  return "Object.defineProperty(navigator, 'platform', { get: () => '" +
+         platform + "', configurable: true });";
+}
+
+std::string AntiDetectionInjector::GenerateHardwareConcurrencySpoof(
+    int concurrency) {
+  return "Object.defineProperty(navigator, 'hardwareConcurrency', { get: () => " +
+         std::to_string(concurrency) + ", configurable: true });";
+}
+
+std::string AntiDetectionInjector::GenerateUserAgentSpoof(
+    const std::string& user_agent) {
+  if (user_agent.empty()) return "";
+  return "Object.defineProperty(navigator, 'userAgent', { get: () => '" +
+         user_agent + "', configurable: true });";
+}
+
+std::string AntiDetectionInjector::GenerateDarkReaderMatrixTheme() {
+  return R"(
+    (function() {
+      const MATRIX_COLORS = {
+        bg: '#000000',
+        primary: '#00ff00',
+        secondary: '#00cc00',
+        tertiary: '#009900',
+        accent: '#00ff41',
+        shadow: 'rgba(0, 255, 0, 0.3)'
+      };
+
+      const matrixCSS = `
+        :root {
+          --matrix-bg: ${MATRIX_COLORS.bg};
+          --matrix-primary: ${MATRIX_COLORS.primary};
+          --matrix-secondary: ${MATRIX_COLORS.secondary};
+          --matrix-tertiary: ${MATRIX_COLORS.tertiary};
+          --matrix-accent: ${MATRIX_COLORS.accent};
+          --matrix-shadow: ${MATRIX_COLORS.shadow};
+        }
+        html, body {
+          background-color: var(--matrix-bg) !important;
+          color: var(--matrix-primary) !important;
+          text-shadow: 0 0 10px var(--matrix-shadow) !important;
+        }
+        p, span, div, a, h1, h2, h3, h4, h5, h6, li, td, th {
+          color: var(--matrix-primary) !important;
+          text-shadow: 0 0 5px var(--matrix-shadow) !important;
+        }
+        a { color: var(--matrix-accent) !important; text-decoration: underline !important; }
+        a:visited { color: var(--matrix-secondary) !important; }
+        button, input[type="button"], input[type="submit"] {
+          background-color: var(--matrix-tertiary) !important;
+          color: var(--matrix-accent) !important;
+          border: 2px solid var(--matrix-primary) !important;
+          box-shadow: 0 0 10px var(--matrix-shadow) !important;
+        }
+        input, textarea, select {
+          background-color: var(--matrix-bg) !important;
+          color: var(--matrix-primary) !important;
+          border: 1px solid var(--matrix-secondary) !important;
+        }
+        code, pre {
+          background-color: var(--matrix-bg) !important;
+          color: var(--matrix-accent) !important;
+          border: 1px solid var(--matrix-secondary) !important;
+          font-family: 'Courier New', monospace !important;
+        }
+        table { background-color: var(--matrix-bg) !important; border-color: var(--matrix-secondary) !important; }
+        th { background-color: var(--matrix-tertiary) !important; color: var(--matrix-accent) !important; }
+        ::-webkit-scrollbar { width: 12px; }
+        ::-webkit-scrollbar-track { background: var(--matrix-bg); }
+        ::-webkit-scrollbar-thumb { background: var(--matrix-secondary); border-radius: 6px; }
+        ::selection { background-color: var(--matrix-secondary) !important; color: var(--matrix-bg) !important; }
+        body::before {
+          content: '';
+          position: fixed;
+          top: 0;
+          left: 0;
+          width: 100%;
+          height: 100%;
+          background: repeating-linear-gradient(0deg, rgba(0, 255, 0, 0.03), rgba(0, 255, 0, 0.03) 1px, transparent 1px, transparent 2px);
+          pointer-events: none;
+          z-index: 9999;
+        }
+        @keyframes matrix-glitch {
+          0% { text-shadow: 0 0 5px var(--matrix-shadow); }
+          50% { text-shadow: 0 0 15px var(--matrix-shadow), 2px 2px 0 var(--matrix-accent); }
+          100% { text-shadow: 0 0 5px var(--matrix-shadow); }
+        }
+        a:hover { animation: matrix-glitch 0.3s ease-in-out; }
+        h1, h2, h3 { text-shadow: 0 0 10px var(--matrix-shadow), 0 0 20px var(--matrix-shadow), 0 0 30px var(--matrix-shadow) !important; }
+        * { background-image: none !important; }
+        body { font-family: 'Courier New', 'Courier', monospace !important; letter-spacing: 0.05em !important; }
+      `;
+
+      const style = document.createElement('style');
+      style.id = 'matrix-theme-style';
+      style.textContent = matrixCSS;
+      if (document.head) {
+        document.head.appendChild(style);
+      } else {
+        document.documentElement.appendChild(style);
+      }
+
+      // Simulate Dark Reader detection
+      if (!window.darkReader) {
+        window.darkReader = {
+          isEnabled: true,
+          isReady: true,
+          version: '4.9.68',
+          settings: {
+            brightness: 100,
+            contrast: 100,
+            sepia: 0,
+            grayscale: 0,
+            saturation: 100
+          }
+        };
+      }
+    })();
+  )";
+}
+
+std::string AntiDetectionInjector::GenerateInjectionScript(
+    const base::Value::Dict& anti_detection_settings) {
+  std::string script = "(function() {\n";
+
+  // Remove webdriver
+  if (auto remove_wd = anti_detection_settings.FindBool("removeWebdriver");
+      remove_wd && *remove_wd) {
+    script += GenerateWebdriverSpoof();
+  }
+
+  // Inject Dark Reader Matrix theme
+  if (auto dark_reader = anti_detection_settings.FindBool("darkReaderMatrix");
+      dark_reader && *dark_reader) {
+    script += GenerateDarkReaderMatrixTheme();
+  }
+
+  // Spoof plugins
+  if (auto* plugin_spoof = anti_detection_settings.FindDict("pluginSpoofing")) {
+    if (auto enabled = plugin_spoof->FindBool("enabled"); enabled && *enabled) {
+      std::vector<SpoofedPlugin> plugins_to_spoof;
+
+      if (auto random = plugin_spoof->FindBool("randomSelection"); random && *random) {
+        plugins_to_spoof = SelectRandomPlugins(3);
+      } else if (auto* selected = plugin_spoof->FindList("selectedPlugins")) {
+        std::vector<int> indices;
+        for (const auto& val : *selected) {
+          if (val.is_int()) {
+            indices.push_back(val.GetInt());
+          }
+        }
+        plugins_to_spoof = SelectPluginsByIndex(indices);
+      }
+
+      if (!plugins_to_spoof.empty()) {
+        script += GeneratePluginsSpoof(plugins_to_spoof);
+      }
+    }
+  }
+
+  // Spoof languages
+  if (auto* langs = anti_detection_settings.FindList("languages")) {
+    std::vector<std::string> languages;
+    for (const auto& val : *langs) {
+      if (val.is_string()) {
+        languages.push_back(val.GetString());
+      }
+    }
+    if (!languages.empty()) {
+      script += GenerateLanguagesSpoof(languages);
+    }
+  }
+
+  // Spoof platform
+  if (auto* platform = anti_detection_settings.FindString("platform")) {
+    script += GeneratePlatformSpoof(*platform);
+  }
+
+  // Spoof hardware concurrency
+  if (auto hc = anti_detection_settings.FindInt("hardwareConcurrency")) {
+    script += GenerateHardwareConcurrencySpoof(*hc);
+  }
+
+  // Spoof user agent
+  if (auto* ua = anti_detection_settings.FindString("userAgent")) {
+    script += GenerateUserAgentSpoof(*ua);
+  }
+
+  script += "})();";
+
+  return script;
+}
+
+}  // namespace dashboard
+
