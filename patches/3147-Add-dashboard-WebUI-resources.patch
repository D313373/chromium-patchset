+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_ANTI_DETECTION_INJECTOR_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_ANTI_DETECTION_INJECTOR_H_
+
+#include <string>
+#include <vector>
+#include "base/values.h"
+
+namespace dashboard {
+
+// Represents a spoofed browser plugin
+struct SpoofedPlugin {
+  std::string name;
+  std::string description;
+  std::string filename;
+  std::vector<std::string> mime_types;
+
+  // Constructors and special members (defined out-of-line in .cc)
+  SpoofedPlugin();
+  SpoofedPlugin(const std::string& name,
+                const std::string& description,
+                const std::string& filename,
+                std::vector<std::string> mime_types);
+  SpoofedPlugin(const SpoofedPlugin&);
+  SpoofedPlugin& operator=(const SpoofedPlugin&);
+  SpoofedPlugin(SpoofedPlugin&&);
+  SpoofedPlugin& operator=(SpoofedPlugin&&);
+  ~SpoofedPlugin();
+
+};
+
+// Generates anti-detection JavaScript injection code based on settings
+class AntiDetectionInjector {
+ public:
+  AntiDetectionInjector();
+  ~AntiDetectionInjector();
+
+  // Generate the complete anti-detection injection script
+  std::string GenerateInjectionScript(const base::Value::Dict& anti_detection_settings);
+
+  // Generate JavaScript to spoof navigator.webdriver
+  std::string GenerateWebdriverSpoof();
+
+  // Generate JavaScript to spoof navigator.plugins
+  std::string GeneratePluginsSpoof(const std::vector<SpoofedPlugin>& plugins);
+
+  // Generate JavaScript to spoof navigator.languages
+  std::string GenerateLanguagesSpoof(const std::vector<std::string>& languages);
+
+  // Generate JavaScript to spoof navigator.platform
+  std::string GeneratePlatformSpoof(const std::string& platform);
+
+  // Generate JavaScript to spoof navigator.hardwareConcurrency
+  std::string GenerateHardwareConcurrencySpoof(int concurrency);
+
+  // Generate JavaScript to spoof user agent
+  std::string GenerateUserAgentSpoof(const std::string& user_agent);
+
+  // Generate Dark Reader Matrix theme injection
+  std::string GenerateDarkReaderMatrixTheme();
+
+  // Get the list of popular plugins for spoofing
+  static std::vector<SpoofedPlugin> GetPopularPlugins();
+
+  // Select random plugins from the popular list
+  static std::vector<SpoofedPlugin> SelectRandomPlugins(int count = 3);
+
+  // Select specific plugins by index
+  static std::vector<SpoofedPlugin> SelectPluginsByIndex(
+      const std::vector<int>& indices);
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ANTI_DETECTION_INJECTOR_H_
+
diff --git a/chrome/browser/ui/webui/dashboard/click_handler.cc b/chrome/browser/ui/webui/dashboard/click_handler.cc
