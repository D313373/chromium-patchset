+void DashboardUIMessageHandler::BroadcastAiChunk(const std::string& id,
+                                                const std::string& text) {
+  for (auto* inst : Instances()) {
+    if (!inst)
+      continue;
+    if (inst->web_ui()->CanCallJavascript()) {
+      // Guarded call so we don't throw if the page hasn't defined the handler yet.
+      std::string id_js; base::EscapeJSONString(id, /*put_in_quotes=*/true, &id_js);
+      std::string txt_js; base::EscapeJSONString(text, /*put_in_quotes=*/true, &txt_js);
+      std::string js = base::StrCat({
+          "try{if(window.DashboardOnAiChunk){DashboardOnAiChunk(", id_js, ", ", txt_js, ");}}catch(e){};"
+      });
+      inst->web_ui()->GetWebContents()->GetPrimaryMainFrame()->ExecuteJavaScript(
+          base::UTF8ToUTF16(js), base::NullCallback());
+    } else {
+      std::vector<base::Value> args;
+      args.emplace_back(id);
+      args.emplace_back(text);
+      inst->pending_ai_calls_.emplace_back("DashboardOnAiChunk", std::move(args));
+    }
+  }
+}
+
+// static
+void DashboardUIMessageHandler::BroadcastAiDone(const std::string& id,
+                                                bool ok,
+                                                const std::string& err) {
+  for (auto* inst : Instances()) {
+    if (!inst)
+      continue;
+    if (inst->web_ui()->CanCallJavascript()) {
+      std::string id_js; base::EscapeJSONString(id, /*put_in_quotes=*/true, &id_js);
+      std::string ok_js = ok ? "true" : "false";
+      std::string err_js; base::EscapeJSONString(err, /*put_in_quotes=*/true, &err_js);
+      std::string js = base::StrCat({
+          "try{if(window.DashboardOnAiDone){DashboardOnAiDone(", id_js, ", ", ok_js, ", ", err_js, ");}}catch(e){};"
+      });
+      inst->web_ui()->GetWebContents()->GetPrimaryMainFrame()->ExecuteJavaScript(
+          base::UTF8ToUTF16(js), base::NullCallback());
+    } else {
+      std::vector<base::Value> args;
+      args.emplace_back(id);
+      args.emplace_back(ok);
+      args.emplace_back(err);
+      inst->pending_ai_calls_.emplace_back("DashboardOnAiDone", std::move(args));
+    }
+  }
+}
