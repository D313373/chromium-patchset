+
+void RecorderController::OnUserClick(dashboard::mojom::UserClickPtr click) {
+  base::Value::Dict dict;
+  if (!click) return;
+  if (!click->css.empty()) dict.Set("css", click->css);
+  if (!click->xpath.empty()) dict.Set("xpath", click->xpath);
+  if (!click->shadow_chain.empty()) dict.Set("shadow_chain", click->shadow_chain);
+  dict.Set("x", click->x);
+  dict.Set("y", click->y);
+  if (!click->frame_id.empty()) dict.Set("frame_id", click->frame_id);
+  if (!click->locators.empty()) {
+    base::Value::List locs;
+    for (const auto& l : click->locators) {
+      base::Value::Dict d;
+      d.Set("type", l->type);
+      d.Set("value", l->value);
+      locs.Append(std::move(d));
+    }
+    dict.Set("locators", std::move(locs));
+  }
+  OnUserClickFromRenderer(std::move(dict));
+}
