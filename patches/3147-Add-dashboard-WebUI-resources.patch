@@ -0,0 +1,193 @@
+#include "chrome/browser/ui/webui/dashboard/actions/key_press_action.h"
+
+#include "base/logging.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/dashboard/debug_config.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_keyboard_event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+KeyPressAction::KeyPressAction(Profile* profile)
+    : dashboard::actions::Action(profile) {}
+
+KeyPressAction::~KeyPressAction() = default;
+
+bool KeyPressAction::SetParams(const base::Value::Dict& params) {
+  const std::string* key = params.FindString("key");
+  if (!key) {
+    return false;  // key is required
+  }
+  key_ = *key;
+  count_ = params.FindInt("count").value_or(1);
+  
+  if (count_ < 1) {
+    count_ = 1;
+  }
+
+  base::Value::Dict params_dict = params.Clone();
+  params_dict.Set("key", key_);
+  params_dict.Set("count", count_);
+  SetSerializedAction("key_press", std::move(params_dict));
+
+  return true;
+}
+
+void KeyPressAction::Execute(content::WebContents* web_contents,
+                              Callback callback) {
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[KeyPressAction] Pressing key='" << key_ << "' count=" << count_;
+  }
+
+  if (!web_contents) {
+    std::move(callback).Run(false, "No web contents");
+    return;
+  }
+
+  content::RenderWidgetHost* rwh =
+      web_contents->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  if (!rwh) {
+    std::move(callback).Run(false, "No render widget host");
+    return;
+  }
+
+  content::RenderWidgetHostView* rwhv = rwh->GetView();
+  if (!rwhv) {
+    std::move(callback).Run(false, "No render widget host view");
+    return;
+  }
+
+  // Map key names to key codes
+  int key_code = 0;
+  bool needs_char_event = false;
+
+  if (key_ == "Enter" || key_ == "Return") {
+    key_code = ui::VKEY_RETURN;
+  } else if (key_ == "Tab") {
+    key_code = ui::VKEY_TAB;
+  } else if (key_ == "Space" || key_ == "Spacebar") {
+    key_code = ui::VKEY_SPACE;
+    needs_char_event = true;
+  } else if (key_ == "Escape" || key_ == "Esc") {
+    key_code = ui::VKEY_ESCAPE;
+  } else if (key_ == "Backspace") {
+    key_code = ui::VKEY_BACK;
+  } else if (key_ == "Delete") {
+    key_code = ui::VKEY_DELETE;
+  } else if (key_ == "ArrowUp" || key_ == "Up") {
+    key_code = ui::VKEY_UP;
+  } else if (key_ == "ArrowDown" || key_ == "Down") {
+    key_code = ui::VKEY_DOWN;
+  } else if (key_ == "ArrowLeft" || key_ == "Left") {
+    key_code = ui::VKEY_LEFT;
+  } else if (key_ == "ArrowRight" || key_ == "Right") {
+    key_code = ui::VKEY_RIGHT;
+  } else if (key_ == "Home") {
+    key_code = ui::VKEY_HOME;
+  } else if (key_ == "End") {
+    key_code = ui::VKEY_END;
+  } else if (key_ == "PageUp") {
+    key_code = ui::VKEY_PRIOR;
+  } else if (key_ == "PageDown") {
+    key_code = ui::VKEY_NEXT;
+  } else if (key_ == "F1") {
+    key_code = ui::VKEY_F1;
+  } else if (key_ == "F2") {
+    key_code = ui::VKEY_F2;
+  } else if (key_ == "F3") {
+    key_code = ui::VKEY_F3;
+  } else if (key_ == "F4") {
+    key_code = ui::VKEY_F4;
+  } else if (key_ == "F5") {
+    key_code = ui::VKEY_F5;
+  } else if (key_ == "F6") {
+    key_code = ui::VKEY_F6;
+  } else if (key_ == "F7") {
+    key_code = ui::VKEY_F7;
+  } else if (key_ == "F8") {
+    key_code = ui::VKEY_F8;
+  } else if (key_ == "F9") {
+    key_code = ui::VKEY_F9;
+  } else if (key_ == "F10") {
+    key_code = ui::VKEY_F10;
+  } else if (key_ == "F11") {
+    key_code = ui::VKEY_F11;
+  } else if (key_ == "F12") {
+    key_code = ui::VKEY_F12;
+  } else {
+    std::move(callback).Run(false, "Unknown key: " + key_);
+    return;
+  }
+
+  // Start async key press sequence
+  PressKeyAsync(web_contents, rwh, rwhv, key_code, needs_char_event, 0, std::move(callback));
+}
+
+void KeyPressAction::PressKeyAsync(content::WebContents* web_contents,
+                                    content::RenderWidgetHost* rwh,
+                                    content::RenderWidgetHostView* rwhv,
+                                    int key_code,
+                                    bool needs_char_event,
+                                    int press_index,
+                                    Callback callback) {
+  if (!web_contents || !rwh || !rwhv) {
+    std::move(callback).Run(false, "Web contents or RWH became invalid");
+    return;
+  }
+
+  // Helper to send a key event
+  auto send_key = [&](blink::WebInputEvent::Type type, char ch = 0) {
+    blink::WebKeyboardEvent e(type, blink::WebInputEvent::kNoModifiers,
+                              base::TimeTicks::Now());
+    e.windows_key_code = key_code;
+    e.native_key_code = key_code;
+
+    if (type == blink::WebInputEvent::Type::kChar && ch != 0) {
+      e.text[0] = ch;
+      e.unmodified_text[0] = ch;
+    }
+
+    input::NativeWebKeyboardEvent ne(e, rwhv->GetNativeView());
+    rwh->ForwardKeyboardEvent(ne);
+  };
+
+  // Send key down, char (if needed), and key up
+  send_key(blink::WebInputEvent::Type::kRawKeyDown);
+
+  if (needs_char_event) {
+    send_key(blink::WebInputEvent::Type::kChar, ' ');
+  }
+
+  send_key(blink::WebInputEvent::Type::kKeyUp);
+
+  // Check if we need to press more times
+  if (press_index + 1 < count_) {
+    // Schedule next press with a small delay (50-80ms)
+    int delay_ms = 50 + (rand() % 30);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&KeyPressAction::PressKeyAsync,
+                       weak_ptr_factory_.GetWeakPtr(),
+                       web_contents,
+                       rwh,
+                       rwhv,
+                       key_code,
+                       needs_char_event,
+                       press_index + 1,
+                       std::move(callback)),
+        base::Milliseconds(delay_ms));
+  } else {
+    // All presses complete
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "[KeyPressAction] Successfully pressed key " << count_ << " times";
+    }
+    std::move(callback).Run(true, "");
+  }
+}
+
