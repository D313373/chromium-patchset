+// ----------------------------------------------------------------------
+void DashboardUIMessageHandler::HandleSaveScript(const base::Value::List& args) {
+  const std::string cb =
+      (args.size() > 0 && args[0].is_string()) ? args[0].GetString()
+                                              : std::string();
+  const std::string id = (args.size() > 1 && args[1].is_string())
+                             ? args[1].GetString()
+                             : std::string();
+  const base::Value* data_val = (args.size() > 2) ? &args[2] : nullptr;
+
+  if (!data_val || !data_val->is_dict()) {
+    LOG(ERROR) << "[Dashboard] HandleSaveScript: missing or malformed data.";
+    base::Value::Dict res;
+    res.Set("ok", false);
+    ResolveCallback(cb, res); // FIX: Use member function
+    return;
+  }
+
+  const base::Value::Dict& data = data_val->GetDict();
+  base::Value::Dict script;
+  script.Set("id", id);
+  if (const std::string* n = data.FindString("name"))
+    script.Set("name", *n);
+  else
+    script.Set("name", "Untitled");
+
+  // kind (optional)
+  if (const std::string* k = data.FindString("kind"))
+    script.Set("kind", *k);
+
+  // actions – either a JSON list or a JSON string.
+  if (const std::string* json_actions = data.FindString("actions")) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        *json_actions, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (parsed && parsed->is_list())
+      script.Set("actions", parsed->Clone());
+    else
+      script.Set("actions", base::Value::List());
+  } else if (const base::Value::List* l = data.FindList("actions")) {
+    script.Set("actions", l->Clone());
+  } else {
+    script.Set("actions", base::Value::List());
+  }
+
+  // settings – same pattern.
+  if (const std::string* json_settings = data.FindString("settings")) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        *json_settings, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (parsed && parsed->is_dict())
+      script.Set("settings", parsed->Clone());
+    else
+      script.Set("settings", base::Value::Dict());
+  } else if (const base::Value::Dict* d = data.FindDict("settings")) {
+    script.Set("settings", d->Clone());
+  } else {
+    script.Set("settings", base::Value::Dict());
+  }
+
+  // settingsOverrides (legacy alias “overrides”)
+  if (const std::string* json_ov = data.FindString("settingsOverrides")) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        *json_ov, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (parsed && parsed->is_dict())
+      script.Set("settingsOverrides", parsed->Clone());
+  } else if (const base::Value::Dict* d = data.FindDict("settingsOverrides")) {
+    script.Set("settingsOverrides", d->Clone());
+  } else if (const base::Value::Dict* d_legacy = data.FindDict("overrides")) {
+    script.Set("settingsOverrides", d_legacy->Clone());
+  }
+
+  // url_contexts (optional)
+  if (const base::Value::List* ctx = data.FindList("url_contexts")) {
+    script.Set("url_contexts", ctx->Clone());
+  }
+
+  // If url_contexts missing, derive it from flat actions.
+  if (!script.FindList("url_contexts")) {
+    const base::Value::List* acts = script.FindList("actions");
+    if (acts) {
+      base::Value::List contexts;
+      base::Value::List cur_actions;
+      std::string cur_url;
+      for (const auto& v : *acts) {
+        if (!v.is_dict())
+          continue;
+        const base::Value::Dict& a = v.GetDict();
+        const std::string* act = a.FindString("action");
+        const base::Value::Dict* params = a.FindDict("params");
+        if (act && *act == "url_change") {
+          if (!cur_actions.empty() || !cur_url.empty()) {
+            base::Value::Dict ctx;
+            ctx.Set("url", cur_url);
+            ctx.Set("actions", std::move(cur_actions));
+            contexts.Append(std::move(ctx));
+            cur_actions = base::Value::List();
+          }
+          if (params) {
+            if (const std::string* u = params->FindString("url"))
+              cur_url = *u;
+          }
+          continue;
+        }
+        // If we haven't gotten a URL yet, treat a “navigate” as the first URL.
+        if (act && *act == "navigate" && cur_url.empty() &&
+            contexts.empty()) {
+          if (params) {
+            if (const std::string* u = params->FindString("url"))
+              cur_url = *u;
+          }
+        }
+        cur_actions.Append(a.Clone());
+      }
+      if (!cur_actions.empty() || !cur_url.empty()) {
+        base::Value::Dict ctx;
+        ctx.Set("url", cur_url);
+        ctx.Set("actions", std::move(cur_actions));
+        contexts.Append(std::move(ctx));
+      }
+      script.Set("url_contexts", std::move(contexts));
+    }
+  }
+
+  // Canonicalise (validation, normalisation) and persist.
+  script = dashboard::ScriptSchema::CanonicalizeForSave(std::move(script), id,
+                                                        base::Time::Now());
+
+  base::ThreadPool::PostTaskAndReply(
+      FROM_HERE,
+      {base::MayBlock(),
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&DashboardUIMessageHandler::DoSaveBlocking,
+                     base::Unretained(this), id, script.Clone()),
+      base::BindOnce(&DashboardUIMessageHandler::OnSaveDone,
+                     weak_ptr_factory_.GetWeakPtr(), cb, id,
+                     std::move(script)));
+}
