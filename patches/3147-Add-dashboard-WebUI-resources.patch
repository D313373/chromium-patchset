@@ -0,0 +1,86 @@
+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ACTION_TYPES_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ACTION_TYPES_H_
+
+#include "base/values.h"
+#include <string>
+#include <vector>
+
+namespace dashboard {
+
+// Defines the types of selectors that can be used to find an element on a page.
+enum class LocatorType {
+  ID,
+  CSS_SELECTOR,
+  NAME,
+  ACCESSIBILITY_NAME,  // aria-label, aria-labelledby
+  CLASS_NAME,
+  JS_EVAL,             // custom JS expression that returns an Element
+  SHADOW_DOM,          // chain "host_css >> inner_css" (open shadow root only)
+  LINK_TEXT,
+  PARTIAL_LINK_TEXT,
+  TAG_NAME,
+  XPATH,
+  TEXT_CONTENT,
+  VISUAL_COORDS,       // direct coordinates (x,y); stored in locator.value
+  VISUAL_AI,           // placeholder for future model-based matching
+  FRAME_ID,            // target frame by GlobalRenderFrameHostId string/token
+  RESOURCE_TREE        // advanced diagnostics: resource tree path
+};
+
+// Represents a single method for locating an element on a page.
+struct Locator {
+  Locator();
+  ~Locator();
+  Locator(const Locator& other);
+  Locator& operator=(const Locator& other);
+  Locator(Locator&& other) noexcept;
+  Locator& operator=(Locator&& other) noexcept;
+
+  LocatorType type;
+  std::string value;
+};
+
+// Represents the coordinates of a located element.
+struct Element {
+  int positionX = 0;
+  int positionY = 0;
+};
+
+// Represents a find-and-replace rule for string manipulation.
+struct FindReplace {
+  FindReplace();
+  ~FindReplace();
+  FindReplace(const FindReplace& other);
+  FindReplace& operator=(const FindReplace& other);
+  FindReplace(FindReplace&& other) noexcept;
+  FindReplace& operator=(FindReplace&& other) noexcept;
+
+  std::string find;
+  std::string replace;
+};
+
+// This struct defines a single column/field to be scraped from a table.
+struct ScrapeTableField {
+  ScrapeTableField();
+  ~ScrapeTableField();
+  ScrapeTableField(const ScrapeTableField& other);
+  ScrapeTableField& operator=(const ScrapeTableField& other);
+  ScrapeTableField(ScrapeTableField&& other) noexcept;
+  ScrapeTableField& operator=(ScrapeTableField&& other) noexcept;
+
+  std::string name;
+  std::vector<Locator> locators;
+  std::vector<FindReplace> find_replace_rules;
+};
+
+// Helper functions for converting between JSON-like values and C++ structs.
+LocatorType StringToLocatorType(const std::string& type_str);
+std::string LocatorTypeToString(LocatorType type);
+std::vector<Locator> ConvertLocators(const base::Value::List& locators_list);
+std::vector<FindReplace> ConvertFindReplace(
+    const base::Value::List& rules_list);
+base::Value::Dict LocatorToValue(const Locator& locator);
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ACTION_TYPES_H_
diff --git a/chrome/browser/ui/webui/dashboard/actions/call_script_action.cc b/chrome/browser/ui/webui/dashboard/actions/call_script_action.cc
