@@ -0,0 +1,126 @@
+// ==============================================
+// File: actions/LoopEditor.js
+// ==============================================
+export function renderLoopEditor(container, action, onSave, onCancel) {
+  const tables = window.appState ? Object.keys(window.appState.tables || {}) : [];
+
+  container.innerHTML = `
+    <h3>Loop Configuration</h3>
+    <div>
+      <label>Loop Type:</label>
+      <select id="loopType">
+        <option value="count">Fixed Count</option>
+        <option value="row">For Each Row</option>
+        <option value="column">For Each Column</option>
+      </select>
+    </div>
+    <div>
+      <label>Target Table/List:</label>
+      <select id="targetTable">
+        <option value="">--Select--</option>
+        ${tables.map(t => `<option value="${t}">${t}</option>`).join('')}
+      </select>
+    </div>
+    <div id="columnSelector" style="display:none;">
+      <label>Column:</label>
+      <select id="loopColumn"></select>
+    </div>
+    <div id="fixedCountContainer">
+      <label>Repeat Count:</label>
+      <smart-input id="fixedCount" data-type="number" min="1"></smart-input>
+    </div>
+    <div id="nestedActionsContainer">
+      <h4>Nested Actions:</h4>
+    </div>
+    <button id="addNestedAction">Add Nested Action</button>
+    <div class="editor-actions">
+      <button id="saveLoop">Save</button>
+      <button id="cancelLoop">Cancel</button>
+    </div>
+  `;
+
+  const loopTypeEl = document.getElementById('loopType');
+  const targetTableEl = document.getElementById('targetTable');
+  const columnSelectorEl = document.getElementById('columnSelector');
+  const loopColumnEl = document.getElementById('loopColumn');
+  const fixedCountContainer = document.getElementById('fixedCountContainer');
+  const fixedCountEl = document.getElementById('fixedCount');
+  const nestedContainer = document.getElementById('nestedActionsContainer');
+  const addNestedBtn = document.getElementById('addNestedAction');
+
+  action.loopType = action.loopType ?? 'count';
+  action.targetTable = action.targetTable ?? '';
+  action.loopColumn = action.loopColumn ?? '';
+  action.repeatCount = action.repeatCount ?? 1;
+  action.nestedActions = action.nestedActions || [];
+
+  loopTypeEl.value = action.loopType;
+  targetTableEl.value = action.targetTable;
+  fixedCountEl.value = action.repeatCount;
+
+  fixedCountEl.addEventListener('input', e => {
+    action.repeatCount = parseInt(e.target.value, 10) || 1;
+  });
+
+  updateColumnSelector();
+  loopTypeEl.addEventListener('change', () => {
+    action.loopType = loopTypeEl.value;
+    updateColumnSelector();
+  });
+
+  targetTableEl.addEventListener('change', () => {
+    action.targetTable = targetTableEl.value;
+    updateColumnOptions();
+  });
+
+  function updateColumnSelector() {
+    const type = loopTypeEl.value;
+    columnSelectorEl.style.display = type === 'column' ? 'block' : 'none';
+    fixedCountContainer.style.display = type === 'count' ? 'block' : 'none';
+    if (type === 'column') updateColumnOptions();
+  }
+
+  function updateColumnOptions() {
+    const table = window.appState?.tables[targetTableEl.value];
+    if (!table || !Array.isArray(table) || !table[0]) return;
+    loopColumnEl.innerHTML = Object.keys(table[0])
+      .map(c => `<option value="${c}">${c}</option>`)
+      .join('');
+    loopColumnEl.value = action.loopColumn ?? loopColumnEl.value;
+  }
+
+  function renderNested() {
+    nestedContainer.innerHTML = '';
+    action.nestedActions.forEach((a, idx) => {
+      const div = document.createElement('div');
+      div.className = 'nestedAction';
+      div.innerHTML = `
+        <span>${a.type}: ${a.content ?? a.key ?? ''}</span>
+        <button class="removeNested">Remove</button>
+      `;
+      nestedContainer.appendChild(div);
+      div.querySelector('.removeNested').addEventListener('click', () => {
+        action.nestedActions.splice(idx, 1);
+        renderNested();
+      });
+    });
+  }
+
+  renderNested();
+
+  addNestedBtn.addEventListener('click', () => {
+    const newAction = { type: 'Type', content: '' };
+    action.nestedActions.push(newAction);
+    renderNested();
+  });
+
+  document.getElementById('saveLoop').addEventListener('click', () => {
+    action.loopType = loopTypeEl.value;
+    action.targetTable = targetTableEl.value;
+    action.loopColumn = loopColumnEl.value;
+    action.repeatCount = parseInt(fixedCountEl.value, 10) || 1;
+    onSave(action);
+  });
+
+  document.getElementById('cancelLoop').addEventListener('click', () => onCancel());
+}
