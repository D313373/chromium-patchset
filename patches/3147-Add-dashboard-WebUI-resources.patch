diff --git a/chrome/browser/resources/dashboard/actions/clickEditor.js b/chrome/browser/resources/dashboard/actions/clickEditor.js
new file mode 100644
index 0000000000000000000000000000000000000000..068ae4896be2b96907afa11e81365c6305a1e357
--- /dev/null
+++ b/chrome/browser/resources/dashboard/actions/clickEditor.js
@@ -0,0 +1,103 @@
+// ==============================================
+// File: actions/ClickEditor.js
+// ==============================================
+
+import { renderLocatorEditor } from '../components/locatorEditor.js';
+
+export function renderClickEditor(container, action, onSave, onCancel) {
+  container.innerHTML = `
+    <h3>Click Configuration</h3>
+    <div id="locatorsContainer"></div>
+    <div style="margin:6px 0 12px;">
+      <button id="addCoordsLocator" class="btn" style="padding:6px 10px;">+ Add Coordinates (x,y)</button>
+      <span style="font-size:12px;opacity:0.8;margin-left:6px;">Adds a VISUAL_COORDS locator</span>
+    </div>
+    <div>
+      <label>Wait Timeout (ms):</label>
+      <smart-input id="waitTimeout" data-type="number" min="0"></smart-input>
+    </div>
+    <div>
+      <label>Non-critical (skip on failure):</label>
+      <input type="checkbox" id="nonCritical" ${action.nonCritical ? 'checked' : ''} />
+    </div>
+    <div>
+      <label>Use Human-Like Offset:</label>
+      <input type="checkbox" id="humanOffset" ${action.humanOffset ? 'checked' : ''} />
+    </div>
+    <div>
+      <label>Click Count:</label>
+      <smart-input id="clickCount" data-type="number" min="1" max="3"></smart-input>
+    </div>
+    <div class="editor-actions">
+      <button id="saveClick">Save</button>
+      <button id="cancelClick">Cancel</button>
+    </div>
+  `;
+
+  const locatorsContainer = document.getElementById('locatorsContainer');
+  const addCoordsBtn = document.getElementById('addCoordsLocator');
+  const waitTimeoutEl = document.getElementById('waitTimeout');
+  const humanOffsetEl = document.getElementById('humanOffset');
+  const nonCriticalEl = document.getElementById('nonCritical');
+  const clickCountEl = document.getElementById('clickCount');
+
+  action.humanOffset = action.humanOffset ?? true;
+  action.clickCount = action.clickCount ?? 1;
+  // Increase default to 15000ms for better robustness
+  action.waitTimeout = action.waitTimeout ?? 15000;
+  action.nonCritical = action.nonCritical ?? false;
+
+  // Initialize LocatorEditor
+  const locatorEditor = renderLocatorEditor(
+    locatorsContainer,
+    action.locators,
+    (locators) => {
+      action.locators = locators;
+    }
+  );
+
+  // Quick-add Visual Coordinates locator
+  if (addCoordsBtn) {
+    addCoordsBtn.addEventListener('click', () => {
+      const current = locatorEditor.getValue() || [];
+      const hint = '{"x": 100, "y": 200}';
+      current.push({ type: 'VISUAL_COORDS', value: hint });
+      locatorEditor.setValue(current);
+      action.locators = current;
+    });
+  }
+
+  waitTimeoutEl.addEventListener('input', e => {
+    const v = parseInt(e.target.value, 10);
+    action.waitTimeout = Number.isFinite(v) ? v : 15000;
+  });
+
+  clickCountEl.addEventListener('input', e => {
+    action.clickCount = parseInt(e.target.value, 10) || 1;
+  });
+
+  // Set initial values
+  waitTimeoutEl.value = action.waitTimeout;
+  clickCountEl.value = action.clickCount;
+
+  humanOffsetEl.addEventListener('change', e => {
+    action.humanOffset = e.target.checked;
+  });
+
+  nonCriticalEl.addEventListener('change', e => {
+    action.nonCritical = e.target.checked;
+  });
+
+  // Save / Cancel buttons
+  document.getElementById('saveClick').addEventListener('click', () => {
+    const locators = locatorEditor.getValue();
+    if (!locators || locators.length === 0) {
+      alert("Please provide at least one valid locator.");
+      return;
+    }
+    action.locators = locators;
+    onSave(action);
+  });
+
+  document.getElementById('cancelClick').addEventListener('click', () => onCancel());
+}
diff --git a/chrome/browser/resources/dashboard/actions/ifConditionEditor.js b/chrome/browser/resources/dashboard/actions/ifConditionEditor.js
new file mode 100644
index 0000000000000000000000000000000000000000..e8dd10d7512c25fcd9d977f7b305db0e4ee1e5a8
--- /dev/null
+++ b/chrome/browser/resources/dashboard/actions/ifConditionEditor.js
@@ -0,0 +1,174 @@
+// IfConditionEditor - class-based editor with a simple wrapper used by the actions barrel
+// Produces/consumes params in this shape: { conditionType, locators: [{type,value}], text }
+
+import { LocatorEditor } from '../components/locatorEditor.js';
+
+export class IfConditionEditor {
+  constructor(container) {
+    if (!container) throw new Error('A container element must be provided.');
+    this.container = container;
+    this.dom = {};
+    this.locatorEditor = null;
+  }
+
+  render() {
+    const c = this.container;
+    c.innerHTML = '';
+    c.style.cssText = 'padding:16px;border-radius:8px;background:#f3f4f6;display:flex;flex-direction:column;gap:12px;font-family:sans-serif;';
+
+    const title = document.createElement('h3');
+    title.textContent = 'If Condition';
+    title.style.cssText = 'margin:0 0 4px;color:#111827;font-size:16px;';
+
+    const typeRow = this._row('Condition Type');
+    const type = this._select('conditionType', {
+      element_exists: 'Element exists',
+      text_contains: 'Text contains',
+    });
+    typeRow.appendChild(type);
+
+    const locatorsRow = document.createElement('div');
+    locatorsRow.style.cssText = 'display:flex;flex-direction:column;gap:4px;';
+    const locatorsContainer = document.createElement('div');
+    locatorsRow.appendChild(locatorsContainer);
+
+    const textRow = this._row('Text');
+    const textInput = this._text('text', 'Text to find');
+    textRow.appendChild(textInput);
+
+    // Smart Login Detection Guide (collapsible)
+    const loginGuideHeader = document.createElement('div');
+    loginGuideHeader.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-top:12px;';
+
+    const loginGuideTitle = document.createElement('strong');
+    loginGuideTitle.textContent = '🔐 Smart Login Detection Guide';
+    loginGuideTitle.style.cssText = 'font-size:13px;color:#111827;';
+
+    const loginGuideToggle = document.createElement('button');
+    loginGuideToggle.textContent = 'Show Guide';
+    loginGuideToggle.style.cssText = 'padding:4px 10px;font-size:11px;background:#10b981;color:white;border:none;border-radius:4px;cursor:pointer;font-weight:500;';
+    loginGuideToggle.onclick = () => {
+      const isHidden = loginGuidePanel.style.display === 'none';
+      loginGuidePanel.style.display = isHidden ? 'block' : 'none';
+      loginGuideToggle.textContent = isHidden ? 'Hide Guide' : 'Show Guide';
+    };
+
+    loginGuideHeader.append(loginGuideTitle, loginGuideToggle);
+
+    const loginGuidePanel = document.createElement('div');
+    loginGuidePanel.style.cssText = 'display:none;padding:14px;background:#ecfdf5;border:2px solid #10b981;border-radius:6px;font-size:12px;color:#065f46;line-height:1.6;margin-top:8px;';
+    loginGuidePanel.innerHTML = `
+      <strong style="font-size:13px;color:#064e3b;">Purpose:</strong><br>
+      Use this to check if the user is already logged in before running the main script.<br><br>
+
+      <strong style="font-size:13px;color:#064e3b;">✅ Recommended Pattern (Safest):</strong><br>
+      • Check if <strong>login button is ABSENT</strong> (element_exists condition)<br>
+      • If login button is absent → user is logged in → run main actions in 'then' branch<br>
+      • If login button is present → user is NOT logged in → call login script in 'else' branch<br><br>
+
+      <strong style="font-size:13px;color:#064e3b;">Alternative Pattern:</strong><br>
+      • Check if <strong>profile element is PRESENT</strong> (element_exists condition)<br>
+      • If profile element is present → user is logged in → run main actions in 'then' branch<br>
+      • If profile element is absent → user is NOT logged in → call login script in 'else' branch<br><br>
+
+      <strong style="font-size:13px;color:#064e3b;">Example Selectors:</strong><br>
+      <strong>Positive indicators (logged in):</strong><br>
+      <code style="background:#fff;padding:2px 6px;border-radius:3px;font-family:monospace;">#user-avatar</code>,
+      <code style="background:#fff;padding:2px 6px;border-radius:3px;font-family:monospace;">.profile-menu</code>,
+      <code style="background:#fff;padding:2px 6px;border-radius:3px;font-family:monospace;">[aria-label="Account"]</code><br><br>
+      <strong>Negative indicators (not logged in):</strong><br>
+      <code style="background:#fff;padding:2px 6px;border-radius:3px;font-family:monospace;">#login-button</code>,
+      <code style="background:#fff;padding:2px 6px;border-radius:3px;font-family:monospace;">.sign-in-link</code>,
+      <code style="background:#fff;padding:2px 6px;border-radius:3px;font-family:monospace;">button:contains("Log In")</code>
+    `;
+
+    const thenInfo = document.createElement('div');
+    thenInfo.innerHTML = '<strong>Then</strong><div class="text-sm" style="opacity:.7;">Add actions in the timeline under this IF</div>';
+    thenInfo.style.cssText = 'margin-top:12px;';
+
+    const elseInfo = document.createElement('div');
+    elseInfo.innerHTML = '<strong>Else</strong><div class="text-sm" style="opacity:.7;">Add actions under the ELSE branch</div>';
+
+    c.append(title, typeRow, locatorsRow, textRow, loginGuideHeader, loginGuidePanel, thenInfo, elseInfo);
+
+    // Initialize LocatorEditor
+    this.locatorEditor = new LocatorEditor(locatorsContainer);
+    this.locatorEditor.render();
+
+    // Store handles
+    this.dom = { type, textInput, locatorsRow, textRow };
+
+    // Init visibility
+    this._onTypeChange();
+
+    // Wire
+    type.addEventListener('change', () => this._onTypeChange());
+  }
+
+  getValue() {
+    const conditionType = this.dom.type.value;
+    const locators = this.locatorEditor ? this.locatorEditor.getValue() : [];
+    const text = this.dom.textInput.value || '';
+    return { conditionType, locators, text };
+  }
+
+  setValue(params) {
+    if (!params) return;
+    if (params.conditionType) this.dom.type.value = params.conditionType;
+    if (this.locatorEditor && Array.isArray(params.locators)) {
+      this.locatorEditor.setValue(params.locators);
+    }
+    if (typeof params.text === 'string') this.dom.textInput.value = params.text;
+    this._onTypeChange();
+  }
+
+  _row(labelText) {
+    const row = document.createElement('div');
+    row.style.cssText = 'display:flex;flex-direction:column;gap:4px;';
+    const label = document.createElement('label');
+    label.textContent = labelText; label.style.cssText = 'font-size:14px;color:#4b5563;font-weight:500;';
+    row.appendChild(label);
+    return row;
+  }
+
+  _text(id, placeholder) {
+    const input = document.createElement('input');
+    input.type = 'text'; input.placeholder = placeholder;
+    input.style.cssText = 'padding:8px 12px;border-radius:6px;border:1px solid #d1d5db;font-size:14px;';
+    this.dom[id] = input; return input;
+  }
+
+  _select(id, options) {
+    const sel = document.createElement('select');
+    sel.style.cssText = 'padding:8px 12px;border-radius:6px;border:1px solid #d1d5db;font-size:14px;background:#fff;';
+    for (const value in options) {
+      const opt = document.createElement('option');
+      opt.value = value; opt.textContent = options[value]; sel.appendChild(opt);
+    }
+    this.dom[id] = sel; return sel;
+  }
+
+  _onTypeChange() {
+    const t = this.dom.type.value;
+    this.dom.locatorsRow.style.display = (t === 'element_exists') ? '' : 'none';
+    this.dom.textRow.style.display = (t === 'text_contains') ? '' : 'none';
+  }
+}
+
+// Compatibility wrapper used by the action editor
+export function renderIfConditionEditor(container, action, onChange) {
+  const editor = new IfConditionEditor(container);
+  editor.render();
+  if (action?.params) editor.setValue(action.params);
+  const emit = () => {
+    const params = editor.getValue();
+    const updated = { ...(action || {}), params };
+    if (typeof onChange === 'function') onChange(updated);
+  };
+  ['change','input'].forEach(evt => {
+    editor.dom.type.addEventListener(evt, emit);
+    editor.dom.locatorsInput.addEventListener(evt, emit);
+    editor.dom.textInput.addEventListener(evt, emit);
+  });
+}
+
