+++ b/chrome/browser/resources/dashboard/directory_runtime.js
@@ -0,0 +1,72 @@
+// directory_runtime.js
+// Runtime helper for NavigateAction.
+// Provides a way to dynamically insert clickable links into directory.html
+// so the ClickHandler can resolve and click them using locators.
+
+(function() {
+  // Ensure we don't re-register if injected multiple times.
+  if (window.__dashboardDirectoryRuntimeLoaded) return;
+  window.__dashboardDirectoryRuntimeLoaded = true;
+
+  // Create a container if it doesn't exist.
+  function ensureNavRoot() {
+    let root = document.getElementById('nav-root');
+    if (!root) {
+      root = document.createElement('div');
+      root.id = 'nav-root';
+      // Hidden by default, so we don't affect layout unless needed.
+      root.style.position = 'absolute';
+      root.style.width = '0';
+      root.style.height = '0';
+      root.style.overflow = 'hidden';
+      document.body.appendChild(root);
+    }
+    return root;
+  }
+
+  // Store references in case you need to track or clean up.
+  window.__navLinkRegistry = window.__navLinkRegistry || {};
+
+  /**
+   * Creates (or replaces) a link associated with a random ID.
+   * @param {string} id - Random or unique identifier for the link.
+   * @param {string} url - The target URL or file path.
+   * @param {string=} text - Optional link text; defaults to the URL if omitted.
+   * @returns {string} The ID for reference.
+   */
+  window.createNavLink = function(id, url, text) {
+    const root = ensureNavRoot();
+
+    // If there's already a link for this ID, remove it before creating a new one.
+    if (window.__navLinkRegistry[id]) {
+      root.removeChild(window.__navLinkRegistry[id]);
+      delete window.__navLinkRegistry[id];
+    }
+
+    const a = document.createElement('a');
+    a.href = url;
+    a.textContent = text || url;
+    a.id = id; // So we can use ID or CSS locators on it.
+
+    // Append it to the hidden root container.
+    root.appendChild(a);
+    window.__navLinkRegistry[id] = a;
+
+    return id;
+  };
+
+  /**
+   * Removes a nav link by ID if it exists.
+   * @param {string} id
+   */
+  window.removeNavLink = function(id) {
+    const root = ensureNavRoot();
+    const link = window.__navLinkRegistry[id];
+    if (link) {
+      root.removeChild(link);
+      delete window.__navLinkRegistry[id];
+    }
+  };
+
+  console.log('[directory_runtime.js] Loaded and ready.');
+})();
