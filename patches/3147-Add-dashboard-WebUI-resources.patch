+#include "chrome/browser/ui/webui/dashboard/listener_manager.h"
+
+#include "base/logging.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard.h"
+#include "content/public/browser/web_contents.h"
+
+namespace dashboard {
+
+namespace {
+
+// Default poll interval for listeners: 1 second
+constexpr int kDefaultPollIntervalMs = 1000;
+
+std::string TimeToIso8601(base::Time time) {
+  base::Time::Exploded exploded;
+  time.UTCExplode(&exploded);
+  return base::StringPrintf("%04d-%02d-%02dT%02d:%02d:%02d.%03dZ",
+                            exploded.year, exploded.month, exploded.day_of_month,
+                            exploded.hour, exploded.minute, exploded.second,
+                            exploded.millisecond);
+}
+
+}  // namespace
+
+// ListenerInfo implementation
+
+dashboard::mojom::ListenerInfoPtr ListenerInfo::ToMojo() const {
+  auto mojo = dashboard::mojom::ListenerInfo::New();
+  mojo->script_id = script_id;
+  mojo->script_name = script_name;
+  mojo->is_active = is_active;
+  mojo->started_at_iso = TimeToIso8601(started_at);
+  return mojo;
+}
+
+// ListenerManager::ActiveListener implementation
+
+ListenerManager::ActiveListener::ActiveListener() = default;
+ListenerManager::ActiveListener::~ActiveListener() = default;
+
+// ListenerManager implementation
+
+ListenerManager::ListenerManager(Profile* profile, Dashboard* dashboard)
+    : profile_(profile), dashboard_(dashboard) {}
+
+ListenerManager::~ListenerManager() {
+  // Stop all active listeners
+  for (auto& [script_id, listener] : active_listeners_) {
+    if (listener.poll_timer) {
+      listener.poll_timer->Stop();
+    }
+  }
+}
+
+bool ListenerManager::StartListener(const std::string& script_id,
+                                     std::string* error) {
+  // Check if already active
+  if (IsListenerActive(script_id)) {
+    if (error) {
+      *error = "Listener already active: " + script_id;
+    }
+    return false;
+  }
+
+  // Validate listener script
+  if (!ValidateListenerScript(script_id, error)) {
+    return false;
+  }
+
+  // Get script name
+  std::string script_name = GetScriptName(script_id);
+  if (script_name.empty()) {
+    if (error) {
+      *error = "Script not found: " + script_id;
+    }
+    return false;
+  }
+
+  // Create active listener
+  ActiveListener& listener = active_listeners_[script_id];
+  listener.info.script_id = script_id;
+  listener.info.script_name = script_name;
+  listener.info.is_active = true;
+  listener.info.started_at = base::Time::Now();
+
+  // Create and start poll timer
+  listener.poll_timer = std::make_unique<base::RepeatingTimer>();
+  listener.poll_timer->Start(
+      FROM_HERE,
+      base::Milliseconds(kDefaultPollIntervalMs),
+      base::BindRepeating(&ListenerManager::OnPollTimer,
+                          weak_ptr_factory_.GetWeakPtr(),
+                          script_id));
+
+  LOG(INFO) << "[ListenerManager] Started listener: " << script_id;
+  return true;
+}
+
+bool ListenerManager::StopListener(const std::string& script_id,
+                                    std::string* error) {
+  auto it = active_listeners_.find(script_id);
+  if (it == active_listeners_.end()) {
+    if (error) {
+      *error = "Listener not active: " + script_id;
+    }
+    return false;
+  }
+
+  // Stop timer
+  if (it->second.poll_timer) {
+    it->second.poll_timer->Stop();
+  }
+
+  // Remove from map
+  active_listeners_.erase(it);
+
+  LOG(INFO) << "[ListenerManager] Stopped listener: " << script_id;
+  return true;
+}
+
+std::vector<ListenerInfo> ListenerManager::GetActiveListeners() const {
+  std::vector<ListenerInfo> result;
+  for (const auto& [script_id, listener] : active_listeners_) {
+    result.push_back(listener.info);
+  }
+  return result;
+}
+
+bool ListenerManager::IsListenerActive(const std::string& script_id) const {
+  return active_listeners_.find(script_id) != active_listeners_.end();
+}
+
+void ListenerManager::OnPollTimer(const std::string& script_id) {
+  auto it = active_listeners_.find(script_id);
+  if (it == active_listeners_.end()) {
+    return;
+  }
+
+  // TODO: Implement actual condition checking
+  // For now, this is a placeholder that would:
+  // 1. Load the listener script
+  // 2. Check if the condition is met (e.g., element exists, text contains, etc.)
+  // 3. If condition is met, execute the listener's actions
+
+  LOG(INFO) << "[ListenerManager] Polling listener: " << script_id;
+}
+
+void ListenerManager::ExecuteListenerActions(const std::string& script_id) {
+  LOG(INFO) << "[ListenerManager] Executing listener actions: " << script_id;
+  
+  // TODO: Implement actual action execution
+  // This would:
+  // 1. Load the listener script
+  // 2. Execute the script's actions (likely using ScriptExecutor)
+  // 3. Handle errors and update listener status
+}
+
+std::string ListenerManager::GetScriptName(const std::string& script_id) const {
+  base::Value::Dict script = dashboard_->LoadScript(script_id);
+  const std::string* name = script.FindString("name");
+  if (!name) {
+    name = script.FindString("scriptName");
+  }
+  return name ? *name : "";
+}
+
+bool ListenerManager::ValidateListenerScript(const std::string& script_id,
+                                              std::string* error) const {
+  // Load script
+  base::Value::Dict script = dashboard_->LoadScript(script_id);
+  if (script.empty()) {
+    if (error) {
+      *error = "Script not found: " + script_id;
+    }
+    return false;
+  }
+
+  // TODO: Add more validation
+  // - Check if script has listener-specific configuration
+  // - Validate condition type
+  // - Validate actions
+
+  return true;
+}
+
+}  // namespace dashboard
+
