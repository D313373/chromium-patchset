+/* Matrix-Themed Dark Reader Stylesheet */
+/* Injects a cyberpunk Matrix aesthetic into all web pages */
+
+/* Root color scheme - Matrix green on black */
+:root {
+  --matrix-bg: #000000;
+  --matrix-primary: #00ff00;
+  --matrix-secondary: #00cc00;
+  --matrix-tertiary: #009900;
+  --matrix-accent: #00ff41;
+  --matrix-shadow: rgba(0, 255, 0, 0.3);
+}
+
+/* Global background - pure black */
+html, body {
+  background-color: var(--matrix-bg) !important;
+  color: var(--matrix-primary) !important;
+  text-shadow: 0 0 10px var(--matrix-shadow) !important;
+}
+
+/* Text elements - Matrix green */
+p, span, div, a, h1, h2, h3, h4, h5, h6, li, td, th {
+  color: var(--matrix-primary) !important;
+  text-shadow: 0 0 5px var(--matrix-shadow) !important;
+}
+
+/* Links - bright green with glow */
+a {
+  color: var(--matrix-accent) !important;
+  text-decoration: underline !important;
+  text-shadow: 0 0 10px var(--matrix-shadow) !important;
+}
+
+a:visited {
+  color: var(--matrix-secondary) !important;
+}
+
+a:hover {
+  color: var(--matrix-accent) !important;
+  text-shadow: 0 0 15px var(--matrix-shadow) !important;
+}
+
+/* Buttons - Matrix style */
+button, input[type="button"], input[type="submit"], input[type="reset"] {
+  background-color: var(--matrix-tertiary) !important;
+  color: var(--matrix-accent) !important;
+  border: 2px solid var(--matrix-primary) !important;
+  text-shadow: 0 0 5px var(--matrix-shadow) !important;
+  box-shadow: 0 0 10px var(--matrix-shadow) !important;
+}
+
+button:hover, input[type="button"]:hover, input[type="submit"]:hover {
+  background-color: var(--matrix-secondary) !important;
+  box-shadow: 0 0 20px var(--matrix-shadow) !important;
+}
+
+/* Input fields - Matrix style */
+input, textarea, select {
+  background-color: var(--matrix-bg) !important;
+  color: var(--matrix-primary) !important;
+  border: 1px solid var(--matrix-secondary) !important;
+  text-shadow: 0 0 5px var(--matrix-shadow) !important;
+  box-shadow: inset 0 0 5px var(--matrix-shadow) !important;
+}
+
+input:focus, textarea:focus, select:focus {
+  border-color: var(--matrix-accent) !important;
+  box-shadow: inset 0 0 10px var(--matrix-shadow), 0 0 15px var(--matrix-shadow) !important;
+}
+
+/* Code blocks - Matrix monospace */
+code, pre {
+  background-color: var(--matrix-bg) !important;
+  color: var(--matrix-accent) !important;
+  border: 1px solid var(--matrix-secondary) !important;
+  text-shadow: 0 0 5px var(--matrix-shadow) !important;
+  font-family: 'Courier New', monospace !important;
+}
+
+/* Tables */
+table {
+  background-color: var(--matrix-bg) !important;
+  border-color: var(--matrix-secondary) !important;
+}
+
+tr:nth-child(odd) {
+  background-color: rgba(0, 255, 0, 0.05) !important;
+}
+
+tr:nth-child(even) {
+  background-color: rgba(0, 255, 0, 0.02) !important;
+}
+
+th {
+  background-color: var(--matrix-tertiary) !important;
+  color: var(--matrix-accent) !important;
+  border-color: var(--matrix-primary) !important;
+}
+
+td {
+  border-color: var(--matrix-secondary) !important;
+}
+
+/* Headers */
+header, nav {
+  background-color: var(--matrix-bg) !important;
+  border-bottom: 2px solid var(--matrix-secondary) !important;
+}
+
+/* Sidebar */
+aside {
+  background-color: var(--matrix-bg) !important;
+  border-right: 2px solid var(--matrix-secondary) !important;
+}
+
+/* Images - slight green tint */
+img {
+  opacity: 0.95 !important;
+  filter: hue-rotate(90deg) saturate(1.2) !important;
+}
+
+/* Scrollbar - Matrix style */
+::-webkit-scrollbar {
+  width: 12px;
+  height: 12px;
+}
+
+::-webkit-scrollbar-track {
+  background: var(--matrix-bg);
+}
+
+::-webkit-scrollbar-thumb {
+  background: var(--matrix-secondary);
+  border-radius: 6px;
+}
+
+::-webkit-scrollbar-thumb:hover {
+  background: var(--matrix-accent);
+  box-shadow: 0 0 10px var(--matrix-shadow);
+}
+
+/* Selection highlight */
+::selection {
+  background-color: var(--matrix-secondary) !important;
+  color: var(--matrix-bg) !important;
+}
+
+/* Scanlines effect - subtle horizontal lines */
+body::before {
+  content: '';
+  position: fixed;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  background: repeating-linear-gradient(
+    0deg,
+    rgba(0, 255, 0, 0.03),
+    rgba(0, 255, 0, 0.03) 1px,
+    transparent 1px,
+    transparent 2px
+  );
+  pointer-events: none;
+  z-index: 9999;
+}
+
+/* Glitch effect on hover */
+@keyframes matrix-glitch {
+  0% {
+    text-shadow: 0 0 5px var(--matrix-shadow);
+  }
+  50% {
+    text-shadow: 0 0 15px var(--matrix-shadow), 2px 2px 0 var(--matrix-accent);
+  }
+  100% {
+    text-shadow: 0 0 5px var(--matrix-shadow);
+  }
+}
+
+a:hover {
+  animation: matrix-glitch 0.3s ease-in-out;
+}
+
+/* Digital rain effect on page load */
+@keyframes digital-rain {
+  0% {
+    opacity: 0;
+    transform: translateY(-10px);
+  }
+  100% {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+body {
+  animation: digital-rain 0.5s ease-out;
+}
+
+/* Neon glow effect for headings */
+h1, h2, h3 {
+  text-shadow: 
+    0 0 10px var(--matrix-shadow),
+    0 0 20px var(--matrix-shadow),
+    0 0 30px var(--matrix-shadow) !important;
+}
+
+/* Remove background images for cleaner Matrix look */
+* {
+  background-image: none !important;
+}
+
+/* Ensure text is always readable */
+body {
+  font-family: 'Courier New', 'Courier', monospace !important;
+  letter-spacing: 0.05em !important;
+}
+
