@@ -0,0 +1,68 @@
+#include "chrome/browser/ui/webui/dashboard/actions/loop_action.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/webui/dashboard/actions/action_factory.h"
+
+LoopAction::LoopAction(Profile* profile)
+    : dashboard::actions::Action(profile) {}
+
+LoopAction::~LoopAction() = default;
+
+bool LoopAction::SetParams(const base::Value::Dict& params) {
+  // We'll use your more detailed parameter parsing.
+  const std::string* variable = params.FindString("variable");
+  const base::Value::List* nested = params.FindList("nestedActions");
+  if (!variable || !nested) {
+    return false;
+  }
+
+  loop_variable_ = *variable;
+
+  // Create a factory to build the nested actions.
+  dashboard::actions::ActionFactory factory(profile_);
+  nested_actions_ = factory.CreateActionSequence(*nested);
+
+  SetSerializedAction("loop", params.Clone());
+  return true;
+}
+
+void LoopAction::Execute(content::WebContents* web_contents, Callback callback) {
+  // TODO: Add logic for loop conditions (e.g., iterating over the
+  // `loop_variable_`). For now, it just executes the sequence once.
+  if (nested_actions_.empty()) {
+    std::move(callback).Run(true, "");
+    return;
+  }
+  RunNextAction(0, web_contents, std::move(callback));
+}
+
+void LoopAction::RunNextAction(size_t action_index,
+                               content::WebContents* web_contents,
+                               Callback callback) {
+  if (action_index >= nested_actions_.size()) {
+    // All actions in the loop have completed successfully.
+    std::move(callback).Run(true, "");
+    return;
+  }
+
+  // Execute the current action and bind the callback to OnActionComplete.
+  nested_actions_[action_index]->Execute(
+      web_contents,
+      base::BindOnce(&LoopAction::OnActionComplete, weak_factory_.GetWeakPtr(),
+                     action_index, web_contents, std::move(callback)));
+}
+
+void LoopAction::OnActionComplete(size_t action_index,
+                                  content::WebContents* web_contents,
+                                  Callback callback,
+                                  bool success,
+                                  const std::string& result) {
+  if (!success) {
+    // If any nested action fails, the whole loop fails immediately.
+    std::move(callback).Run(false, "Loop action failed.");
+    return;
+  }
+
+  // Run the next action in the sequence.
+  RunNextAction(action_index + 1, web_contents, std::move(callback));
+}
