+// ----------------------------------------------------------------------
+// Helper to invoke a WebUI callback (JavaScript) with a JSON payload.
+// ----------------------------------------------------------------------
+void ResolveCallback(content::WebUI* web_ui,
+                       const std::string& cb_fn,
+                       const base::Value& payload) {
+  if (cb_fn.empty())
+    return;
+  // Pass the payload directly as an argument, not wrapped in a list
+  web_ui->CallJavascriptFunctionUnsafe(cb_fn, payload);
+}
