+void RecorderController::RemoveRecordedAction(size_t index) {
+  if (index >= recorded_actions_.size()) return;
+  base::Value::List new_list;
+  size_t i = 0;
+  for (const auto& v : recorded_actions_) {
+    if (i++ == index) continue;
+    new_list.Append(v.Clone());
+  }
+  recorded_actions_ = std::move(new_list);
+
+  if (!overlay_web_view_) return;
+  base::Value::Dict out;
+  out.Set("actions", recorded_actions_.Clone());
+  std::string out_json; base::JSONWriter::Write(out, &out_json);
+  std::string escaped; base::EscapeJSONString(out_json, true, &escaped);
+  std::string js = base::StrCat({
+      "try{if(window.__simulachromeRecorder&&window.__simulachromeRecorder.update){",
+
+
+      "window.__simulachromeRecorder.update(JSON.parse(", escaped, "));}}catch(e){}"});
+  content::RenderFrameHost* rf = overlay_web_view_->GetWebContents()->GetPrimaryMainFrame();
+  if (rf) rf->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
+}
+
+
+void RecorderController::AppendRecordedAction(base::Value::Dict action) {
+  // Canonicalize and append
+  dashboard::ScriptSchema::CanonicalizeAction(action);
+  recorded_actions_.Append(std::move(action));
+
+  // Update overlay if present
+  if (!overlay_web_view_) return;
+  base::Value::Dict out;
+  out.Set("actions", recorded_actions_.Clone());
+  std::string out_json; base::JSONWriter::Write(out, &out_json);
+  std::string escaped; base::EscapeJSONString(out_json, /*put_in_quotes=*/true, &escaped);
+  std::string js = base::StrCat({
+      "try{if(window.__simulachromeRecorder&&window.__simulachromeRecorder.update){",
+      "window.__simulachromeRecorder.update(JSON.parse(", escaped, "));}}catch(e){}"});
+  content::RenderFrameHost* rf = overlay_web_view_->GetWebContents()->GetPrimaryMainFrame();
+  if (rf) rf->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
+}
+
+void RecorderController::AppendRecordedTimeline(const base::Value::List& timeline) {
+  for (const auto& it : timeline) {
+    if (!it.is_dict()) continue;
+    base::Value::Dict d = it.GetDict().Clone();
+    dashboard::ScriptSchema::CanonicalizeAction(d);
+    recorded_actions_.Append(std::move(d));
+  }
+  if (!overlay_web_view_) return;
+  base::Value::Dict out;
+  out.Set("actions", recorded_actions_.Clone());
+  std::string out_json; base::JSONWriter::Write(out, &out_json);
+  std::string escaped; base::EscapeJSONString(out_json, /*put_in_quotes=*/true, &escaped);
+  std::string js = base::StrCat({
+      "try{if(window.__simulachromeRecorder&&window.__simulachromeRecorder.update){",
+      "window.__simulachromeRecorder.update(JSON.parse(", escaped, "));}}catch(e){}"});
+  content::RenderFrameHost* rf = overlay_web_view_->GetWebContents()->GetPrimaryMainFrame();
+  if (rf) rf->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
