+// -------------------- Active tab + DevTools attach --------------------
+void RecorderController::AttachToActiveTab(BrowserView* browser_view) {
+  if (!browser_view || !browser_view->browser())
+    return;
+  Browser* browser = browser_view->browser();
+  content::WebContents* wc = browser->tab_strip_model()->GetActiveWebContents();
+  if (!wc)
+    return;
+
+  target_web_contents_ = wc;
+  current_url_ = wc->GetVisibleURL().spec();
+  if (auto* rfh = wc->GetPrimaryMainFrame()) {
+    target_main_frame_token_ = rfh->GetFrameToken().ToString();
+  } else {
+    target_main_frame_token_.clear();
+  }
+
+  agent_host_ = content::DevToolsAgentHost::GetOrCreateFor(wc);
+  if (!agent_host_)
+    return;
+
+  devtools_client_ = std::make_unique<RecorderDevToolsClient>(
+      base::DoNothing(),
+      base::BindRepeating(&RecorderController::OnDevToolsResponse,
+                          base::Unretained(this)),
+      base::DoNothing());
+
+  agent_host_->AttachClient(devtools_client_.get());
+  // Enable domains we rely on.
+  SendCommand("DOM.enable", base::Value::Dict());
+  SendCommand("Runtime.enable", base::Value::Dict());
+}
+
+// -------------------- DevTools-based selector probe --------------------
+void RecorderController::ProbeSelectorsAtPoint(int x_css, int y_css) {
+  if (!agent_host_ || !devtools_client_)
+    return;
+  base::Value::Dict params;
+  params.Set("x", x_css);
+  params.Set("y", y_css);
+  params.Set("includeUserAgentShadowDOM", true);
+  params.Set("pierce", true);
+  SendCommandExpectResponse(
+      "DOM.getNodeForLocation", std::move(params),
+      base::BindOnce(&RecorderController::OnProbeNodeForLocation,
+                     base::Unretained(this)));
+}
+
+bool RecorderController::TryResolveSelectorsViaRenderer(int x_css, int y_css) {
+  if (!target_web_contents_)
+    return false;
+  content::RenderFrameHost* rfh = target_web_contents_->GetPrimaryMainFrame();
+  if (!rfh)
+    return false;
+  // Prepare callbacks to normalize the resolver result.
+  auto make_cb = [this]() {
+    return base::BindOnce(
+      [](base::WeakPtr<RecorderController> weak,
+         dashboard::mojom::ResolvedElementInfoPtr info) {
+        if (!weak)
+          return;
+        base::Value::Dict dict;
+        dict.Set("css", info->css);
+        dict.Set("xpath", info->xpath);
+        dict.Set("x", info->center_x);
+        dict.Set("y", info->center_y);
+        dict.Set("frame_id", info->frame_id);
+        dict.Set("dom_node_id", info->dom_node_id);
+        if (!info->text.empty()) dict.Set("text", info->text);
+        if (!info->locators.empty()) {
+          base::Value::List locs;
+          for (const auto& l : info->locators) {
+            base::Value::Dict d; d.Set("type", l->type); d.Set("value", l->value); locs.Append(std::move(d));
+          }
+          dict.Set("locators", std::move(locs));
+        }
+        weak->OnUserClickFromRenderer(std::move(dict));
+        weak->RequestActionSnapshotAtPoint(info->center_x, info->center_y,
+                                           /*mark_hovered=*/false);
+      },
+      weak_factory_.GetWeakPtr());
+  };
+
+  // 1) Try StealthyElementResolver.
+  {
+    mojo::AssociatedRemote<dashboard::mojom::StealthyElementResolver> stealth;
+    rfh->GetRemoteAssociatedInterfaces()->GetInterface(&stealth);
+    if (stealth.is_bound()) {
+      auto cb1 = make_cb();
+      stealth->ResolveAtPoint(x_css, y_css, std::move(cb1));
+      return true;
+    }
+  }
+  // 2) Fallback to ElementResolver.
+  {
+    mojo::AssociatedRemote<dashboard::mojom::ElementResolver> resolver;
+    rfh->GetRemoteAssociatedInterfaces()->GetInterface(&resolver);
+    if (resolver.is_bound()) {
+      auto cb2 = make_cb();
+      resolver->ResolveAtPoint(x_css, y_css, std::move(cb2));
+      return true;
+    }
+  }
+  return false;
+}
+
+void RecorderController::OnProbeNodeForLocation(std::string res_json,
+                                                std::string err_json) {
+  base::Value::Dict res;
+  if (!res_json.empty()) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        res_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (parsed && parsed->is_dict()) res = parsed->GetDict().Clone();
+  }
+  const base::Value::Dict* node = res.FindDict("node");
+  int node_id = res.FindInt("nodeId").value_or(-1);
+  if (node) {
+    if (auto id = node->FindInt("nodeId")) node_id = *id;
+  }
+  if (node_id <= 0) return;
+
+  base::Value::Dict params;
+  params.Set("nodeId", node_id);
+  params.Set("depth", 0);
+  SendCommandExpectResponse(
+      "DOM.describeNode", std::move(params),
+      base::BindOnce(&RecorderController::OnProbeDescribeNode,
+                     base::Unretained(this), node_id));
+}
+
+void RecorderController::OnProbeDescribeNode(int node_id,
+                                             std::string res_json,
+                                             std::string err_json) {
+  // Fetch attributes to build simple CSS path.
+  base::Value::Dict params;
+  params.Set("nodeId", node_id);
+  SendCommandExpectResponse(
+      "DOM.getAttributes", std::move(params),
+      base::BindOnce(&RecorderController::OnProbeAttributes,
+                     base::Unretained(this), node_id));
+}
+
+void RecorderController::OnProbeAttributes(int node_id,
+                                           std::string res_json,
+                                           std::string err_json) {
+  std::string id, classes, local_name = "";
+  if (!res_json.empty()) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        res_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (parsed && parsed->is_dict()) {
+      const base::Value::List* attrs = parsed->GetDict().FindList("attributes");
+      if (attrs) {
+        for (size_t i = 0; i + 1 < attrs->size(); i += 2) {
+          const base::Value& k = (*attrs)[i];
+          const base::Value& v = (*attrs)[i + 1];
+          if (!k.is_string() || !v.is_string()) continue;
+          std::string ks = k.GetString();
+          if (ks == "id") id = v.GetString();
+          else if (ks == "class") classes = v.GetString();
+        }
+      }
+    }
+  }
+  // Build minimal selector: #id or tag.class1.class2 (tag left empty here).
+  std::string css;
+  if (!id.empty()) css = std::string("#") + id;
+  else if (!classes.empty()) {
+    css = ".";
+    for (char& c : classes) css += (c==' ')?'.':c;
+  } else {
+    css = "*";
+  }
+  base::Value::Dict dict;
+  dict.Set("css", css);
+  dict.Set("xpath", "");
+  dict.Set("shadow_chain", "");
+  dict.Set("x", 0);
+  dict.Set("y", 0);
+  dict.Set("frame_id", "");
+  OnUserClickFromRenderer(std::move(dict));
+}
