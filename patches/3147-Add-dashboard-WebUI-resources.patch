diff --git a/chrome/browser/resources/dashboard/dashboard_overlay_setup.js b/chrome/browser/resources/dashboard/dashboard_overlay_setup.js
new file mode 100644
index 0000000000000000000000000000000000000000..6a1b15fa0aae4984ca7f3c2c09067c90d1a6b86f
--- /dev/null
+++ b/chrome/browser/resources/dashboard/dashboard_overlay_setup.js
@@ -0,0 +1,563 @@
+// dashboard_overlay_setup.js
+
+// Ensure AI streaming handlers exist very early to avoid ReferenceError if
+// the browser streams before the page finishes loading.
+if (!window.DashboardOnAiChunk) {
+  window.__aiSinks = window.__aiSinks || {};
+  window.DashboardOnAiChunk = (id, txt) => {
+    try {
+      const sink = window.__aiSinks[id];
+      if (sink && typeof sink.append === 'function') sink.append(String(txt || ''));
+    } catch (_) {}
+  };
+  window.DashboardOnAiDone = (id, ok, err) => {
+    try {
+      const sink = window.__aiSinks[id];
+      if (sink && typeof sink.done === 'function') sink.done(!!ok, String(err || ''));
+      delete window.__aiSinks[id];
+    } catch (_) {}
+  };
+}
+
+// Overlay UI Tabs
+export function initOverlayTabs() {
+  const tabs = document.querySelectorAll('.overlay-tabs button');
+  if (!tabs.length) return;
+
+  tabs.forEach(btn => {
+    btn.addEventListener('click', () => {
+      const target = btn.dataset.tab;
+      document.querySelectorAll('.tab-view').forEach(view => {
+        view.style.display = 'none';
+      });
+      const targetTab = document.getElementById(`${target}-tab`);
+      if (targetTab) targetTab.style.display = 'block';
+      // Update active state
+      document.querySelectorAll('.overlay-tabs button').forEach(b => b.classList.remove('btn-primary'));
+      btn.classList.add('btn-primary');
+    });
+  });
+}
+
+// Fallback if recorder method is unavailable
+window.appendToTimelineFromAgent = function(action) {
+  if (window.appendRecordedActionToTimeline) {
+    window.appendRecordedActionToTimeline(action);
+  } else {
+    const card = document.createElement('div');
+    card.textContent = `Agent Step: ${action.action || 'unknown'}`;
+    card.style = 'padding: 8px; margin: 6px; background: #222; color: #fff;';
+    document.getElementById('timeline-tab')?.appendChild(card);
+  }
+};
+
+// dashboard_overlay_setup.js
+
+let lastRenderedPagemapSig = '';
+
+function extractPageMap(payload) {
+  if (!payload || typeof payload !== 'object') return null;
+  if (payload.detail && typeof payload.detail === 'object') return payload.detail;
+  if (payload.pagemap && typeof payload.pagemap === 'object') return payload.pagemap;
+  return payload;
+}
+
+function summarizePageMap(snapshot) {
+  const frames = Array.isArray(snapshot?.frames) ? snapshot.frames : [];
+  if (frames.length) {
+    let elements = 0;
+    try {
+      frames.forEach(f => {
+        elements += (f.elements?.length || 0);
+        (f.shadowRoots || []).forEach(sr => { elements += (sr.elements?.length || 0); });
+      });
+    } catch (_) {}
+    return { frames: frames.length, elements };
+  }
+  const elements = Array.isArray(snapshot?.elements) ? snapshot.elements.length : 0;
+  return { frames: frames.length || (elements ? 1 : 0), elements };
+}
+
+function renderOverlayPageMap(type, snapshot, sourceTag) {
+  if (!snapshot || typeof snapshot !== 'object') return;
+  const summary = summarizePageMap(snapshot);
+  const pmStream = document.getElementById('ov-pm-stream');
+  if (pmStream) {
+    const div = document.createElement('div');
+    div.style.cssText = 'font-family:monospace;font-size:11px;opacity:0.85;white-space:pre;';
+    const src = sourceTag ? ` [${sourceTag}]` : '';
+    div.textContent = `${type || 'pagemap'}${src} frames=${summary.frames} elements≈${summary.elements}`;
+    pmStream.appendChild(div);
+    pmStream.scrollTop = pmStream.scrollHeight;
+  }
+  const pmJson = document.getElementById('ov-pm-json');
+  if (pmJson) {
+    try {
+      const pretty = JSON.stringify(snapshot, null, 2);
+      const limit = 8000;
+      pmJson.textContent = pretty.length > limit ? (pretty.slice(0, limit) + '\n… [truncated]') : pretty;
+    } catch (e) {
+      pmJson.textContent = '[Error serializing PageMap JSON: ' + String(e) + ']';
+    }
+  }
+}
+
+function stashPageMapInGlobalState(type, snapshot) {
+  if (!snapshot || typeof snapshot !== 'object') return;
+  window.globalSiteMap = window.globalSiteMap || {};
+  window.globalSiteMap.lastUpdateType = type;
+  if (type === 'pagemap') {
+    window.globalSiteMap.lastSnapshot = snapshot;
+  } else if (type === 'agent_snapshot') {
+    window.globalSiteMap.lastAgentSnapshot = snapshot;
+    // Explicit handle for the agent console so we can still build context even
+    // if globalSiteMap gets reset elsewhere.
+    window.__lastAgentSnapshotFromRecorder = snapshot;
+  }
+  const url = snapshot.url || snapshot.metadata?.url || '';
+  if (url) {
+    window.globalSiteMap.pages = window.globalSiteMap.pages || {};
+    window.globalSiteMap.pages[url] = snapshot;
+  }
+}
+
+const _fallbackProbeCache = new Set();
+function maybeProbeMinimalPageMap(snapshot) {
+  const url = snapshot?.url || snapshot?.metadata?.url || '';
+  const ts = snapshot?.timestamp || snapshot?.metadata?.timestamp || snapshot?.ts || '';
+  const key = `${url}|${ts}`;
+  if (_fallbackProbeCache.has(key)) return;
+  _fallbackProbeCache.add(key);
+  try {
+    const expr = String.raw`(function(){
+      const sels = 'a,button,input,textarea,select,[role="button"],[role="link"],[onclick]';
+      const els = [];
+      document.querySelectorAll(sels).forEach(el => {
+        try{
+          const r = el.getBoundingClientRect();
+          if (!r || r.width<=0 || r.height<=0) return;
+          const role = (el.getAttribute && el.getAttribute('role')) || '';
+          const tag = (el.tagName||'').toLowerCase();
+          const name = (el.getAttribute && el.getAttribute('aria-label')) || '';
+          const txt = (el.innerText||el.value||'').trim().slice(0,120);
+          els.push({tag, role, name, text: txt, bounds:{x:r.left,y:r.top,w:r.width,h:r.height}});
+        }catch(_){}
+      });
+      return JSON.stringify({ url: location.href, timestamp: Date.now(), frames:[{url: location.href, elements: els, shadowRoots: []}], metadata:{source:'overlay_probe', count: els.length}});
+    })()`;
+    const cb = 'ovProbe_' + Date.now() + Math.random().toString(36).slice(2);
+    window[cb] = (res) => {
+      try { delete window[cb]; } catch (_) {}
+      try {
+        const out = (res && res.result) ? res.result : null;
+        let parsed = null;
+        const val = (out && typeof out === 'object' && typeof out.value === 'string') ? out.value : (typeof out === 'string' ? out : null);
+        if (val) {
+          try { parsed = JSON.parse(val); } catch (_) { parsed = null; }
+        }
+        if (parsed) ingestPageMapPayload('pagemap_probe', parsed, 'probe');
+      } catch (e) { console.warn('[Overlay] Probe parse error', e); }
+    };
+    chrome.send('dashboardAgentEval', [cb, expr]);
+  } catch (e) {
+    console.warn('[Overlay] Minimal PageMap probe failed to send', e);
+  }
+}
+
+function ingestPageMapPayload(type, payload, sourceTag) {
+  const snapshot = extractPageMap(payload);
+  if (!snapshot) return;
+  // Keep the on-screen view compact while retaining the full snapshot in
+  // globalSiteMap for agent context / training.
+  let displaySnapshot = snapshot;
+  try {
+    const maxElements = 30;
+    const frames = Array.isArray(snapshot.frames) ? snapshot.frames : [];
+    if (frames.length) {
+      displaySnapshot = {
+        ...snapshot,
+        frames: frames.map((f) => {
+          if (!f || typeof f !== 'object') return f;
+          const els = Array.isArray(f.elements) ? f.elements : [];
+          const trimmed =
+              els.length > maxElements ? els.slice(0, maxElements) : els;
+          return { ...f, elements: trimmed };
+        }),
+      };
+    }
+  } catch (_) {}
+  const sig = `${type || 'pm'}|${snapshot.url || snapshot.metadata?.url || ''}|${snapshot.timestamp || snapshot.metadata?.timestamp || snapshot.ts || ''}`;
+  if (sig && sig === lastRenderedPagemapSig) return;
+  if (sig) lastRenderedPagemapSig = sig;
+  stashPageMapInGlobalState(type, snapshot);
+  renderOverlayPageMap(type, displaySnapshot || snapshot, sourceTag);
+  const frames = Array.isArray(snapshot?.frames) ? snapshot.frames : [];
+  const hasElements = (frames.some(f => (f.elements?.length || 0) > 0) || (Array.isArray(snapshot?.elements) && snapshot.elements.length));
+  if (!hasElements) maybeProbeMinimalPageMap(snapshot);
+}
+
+function installPagemapStreamSink() {
+  window.__aiSinks = window.__aiSinks || {};
+  window.__aiSinks['pagemap_stream'] = {
+    append: (txt) => {
+      let parsed = null;
+      if (typeof txt === 'string') {
+        try { parsed = JSON.parse(txt); } catch (_) {}
+      } else if (txt && typeof txt === 'object') {
+        parsed = txt;
+      }
+      if (parsed) {
+        const type = parsed.type || 'pagemap';
+        ingestPageMapPayload(type, parsed, 'stream');
+      } else {
+        const pmStream = document.getElementById('ov-pm-stream');
+        if (pmStream) {
+          const div = document.createElement('div');
+          div.style.cssText = 'font-family:monospace;font-size:11px;opacity:0.75;white-space:pre;';
+          div.textContent = String(txt || '');
+          pmStream.appendChild(div);
+          pmStream.scrollTop = pmStream.scrollHeight;
+        } else {
+          try { console.debug('[PageMapStream]', txt); } catch (_) {}
+        }
+      }
+    },
+    done: (_ok, _err) => {}
+  };
+}
+
+// Helper to coerce whatever we got into the payload shape the C++ handler expects
+function buildAgentPayload(actionOrPayload) {
+  if (!actionOrPayload || typeof actionOrPayload !== 'object') {
+    return { timeline: [] };
+  }
+
+  // Already in explicit timeline/ actions shape
+  if (Array.isArray(actionOrPayload.timeline) ||
+      Array.isArray(actionOrPayload.actions)) {
+    return actionOrPayload;
+  }
+
+  // Full action object: { action: 'click', params: {...} }
+  if (actionOrPayload.action) {
+    return { action: actionOrPayload };
+  }
+
+  // String → treat as simple action name with no params
+  if (typeof actionOrPayload === 'string') {
+    return { action: { action: actionOrPayload, params: {} } };
+  }
+
+  // Fallback: treat the object itself as `{action:..., params:...}`-ish
+  return { action: actionOrPayload };
+}
+
+window.performAgentAction = function (actionOrPayload) {
+  const payload = buildAgentPayload(actionOrPayload);
+
+  return new Promise((resolve) => {
+    const cb = 'agentPerformCb_' + Date.now() + Math.random().toString(36).slice(2);
+    window[cb] = (res) => {
+      try { delete window[cb]; } catch (_) {}
+      resolve(res || { ok: false });
+    };
+
+    try {
+      chrome.send('dashboard.performAgentAction', [cb, payload]);
+    } catch (e) {
+      console.error('[Agent] performAgentAction chrome.send failed', e);
+      try { delete window[cb]; } catch (_) {}
+      resolve({ ok: false, error: String(e) });
+    }
+  });
+};
+window.initializeGlobalSiteMap = function(snapshot) {
+  window.globalSiteMap = snapshot || {};
+  window.globalSiteMap.startedAt = Date.now();
+  window.globalSiteMap.isRecording = true;
+  window.globalSiteMap.isAgentMode = false;
+  window.globalSiteMap.refreshMode = window.globalSiteMap.isAgentMode ? 'aggressive' : 'lazy';
+  console.log('[Overlay] globalSiteMap initialized', window.globalSiteMap);
+};
+
+// Recorder toggle UI
+const btn = document.getElementById('toggle-recorder-btn');
+if (btn) {
+  btn.addEventListener('click', () => {
+    const recording = !(window.globalSiteMap?.isRecording);
+    // Ensure message name matches C++ registration ("toggleRecording").
+    chrome.send('toggleRecording', [recording]);
+    window.globalSiteMap.isRecording = recording;
+    btn.textContent = recording ? 'Stop Recording' : 'Start Recording';
+  });
+}
+
+
+
+// Dummy LLM call handler for now
+window.runLLM = async function(prompt) {
+  const response = await fetch('/llama3/run', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ prompt })
+  });
+  return await response.json();
+};
+
+
+
+// -----------------------------------------------------------------------------
+// Global Site Map persistence helper
+// -----------------------------------------------------------------------------
+// This allows the overlay to dump large globalSiteMap objects to disk or
+// background storage to avoid growing memory unbounded.  The backend endpoint
+// `/api/save_snapshot` will be implemented in C++ or Node later to actually
+// write the file.
+//
+// In practice, you’ll call window.persistGlobalSiteMap() whenever
+// globalSiteMap exceeds a size threshold or every Nth snapshot.
+//
+  window.persistGlobalSiteMap = function() {
+  return new Promise((resolve) => {
+    const cb = 'snapshotCb_' + Date.now();
+    window[cb] = (res) => {
+      delete window[cb];
+      console.log('[Overlay] Snapshot persisted:', res);
+      resolve(res);
+    };
+    chrome.send('dashboardSaveSnapshot', [cb, window.globalSiteMap]);
+  });
+};
+
+  // Receive updates from the browser overlay pipeline.
+  // type: e.g. 'pagemap', 'timeline', etc.
+  // data: payload object
+  window.onRecorderUpdate = function(type, data) {
+  try { console.log('[Overlay] onRecorderUpdate', type, data); } catch(_){}
+  if (type === 'pagemap' || type === 'agent_snapshot')
+    ingestPageMapPayload(type, data, 'recorder');
+  // Light UI feedback if present
+  const el = document.getElementById('last-update-label');
+  if (el) el.textContent = 'Last update: ' + type + ' @ ' + new Date().toLocaleTimeString();
+
+  // Mirror updates into the main page Agent Console, if visible
+  try {
+    const mainHist = document.getElementById('gemini-console-history');
+    if (mainHist) {
+      const div = document.createElement('div');
+      div.style.cssText = 'font-size:12px; opacity:0.9; margin:4px 0;';
+      if (type === 'pagemap' || type === 'agent_snapshot') {
+        const summary = summarizePageMap(data);
+        const label = type === 'pagemap' ? 'pagemap' : 'agent snapshot';
+        div.textContent = `[overlay] ${label} frames=${summary.frames} elements≈${summary.elements}`;
+      } else {
+        div.textContent = `[overlay] ${type}: ${JSON.stringify(data).slice(0,160)}...`;
+      }
+      mainHist.appendChild(div);
+    }
+  } catch (_) {}
+};
+
+// -----------------------------------------------------------------------------
+// Standalone overlay builder when chrome://dashboard?overlay=1
+// Moves overlay DOM out of dashboard_app.js and keeps this file the owner.
+// -----------------------------------------------------------------------------
+function isOverlayMode() {
+  const v = new URLSearchParams(location.search).get('overlay');
+  return ['1','true','yes'].includes(String(v||'').toLowerCase());
+}
+
+function buildOverlayUI() {
+  document.body.innerHTML = '';
+  document.documentElement.style.background = 'transparent';
+  document.body.style.background = 'transparent';
+  document.body.style.margin = '0';
+
+  const style = document.createElement('style');
+  style.textContent = `
+    html, body { background: rgba(0,0,0,0) !important; margin: 0 !important; padding: 0 !important; }
+    #overlay-root { position: fixed; top: 20px; right: 20px; z-index: 2147483647; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
+    .overlay-card { width: 360px; max-width: 92vw; background: rgba(17,24,39,0.96); border:1px solid rgba(255,255,255,0.12); border-radius:12px; padding:16px; color:#e5e7eb; display:flex; flex-direction:column; gap:12px; box-shadow:0 18px 40px rgba(0,0,0,0.45); font-family: system-ui, sans-serif; }
+    .overlay-title { margin:0; font-size:16px; font-weight:700; letter-spacing:0.3px; }
+    .overlay-hist { height: 180px; overflow-y: auto; font-size:12px; background:rgba(255,255,255,0.06); padding:4px; border-radius:3px; max-width: 100%; word-break: break-word; }
+    .overlay-input { width:100%; margin-top:8px; }
+    #pm-tab { width: 100%; }
+    #pm-tab pre { white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere; max-width: 100%; }
+  `;
+  document.head.appendChild(style);
+
+  const root = document.createElement('div');
+  root.id = 'overlay-root';
+  const card = document.createElement('div');
+  card.className = 'overlay-card';
+
+  const titleBar = document.createElement('div');
+  titleBar.style.cssText = 'display:flex; align-items:center; justify-content:space-between; gap:8px;';
+  const title = document.createElement('h2'); title.className='overlay-title'; title.textContent='Dashboard Overlay';
+  const btns = document.createElement('div'); btns.style.cssText='display:flex; gap:8px; align-items:center;';
+  // Quick local model selector to avoid slow/blocked models.
+  const modelSelect = document.createElement('select');
+  modelSelect.id = 'ov-model-select';
+  modelSelect.className = 'btn';
+  modelSelect.style.cssText = 'background:#111827;color:#e5e7eb;border:1px solid rgba(255,255,255,0.12);padding:6px 8px;border-radius:8px;';
+  const models = ['llama3:70b','llama3:latest','qwen3:0.6b','deepseek-r1:1.5b'];
+  models.forEach(m => { const opt=document.createElement('option'); opt.value=m; opt.textContent=m; modelSelect.appendChild(opt); });
+  const savedModel = localStorage.getItem('dash.model');
+  if (savedModel && models.includes(savedModel)) modelSelect.value = savedModel;
+  window.__DASH_MODEL = modelSelect.value;
+  modelSelect.addEventListener('change', () => {
+    window.__DASH_MODEL = modelSelect.value;
+    try { localStorage.setItem('dash.model', modelSelect.value); } catch (_) {}
+  });
+  const recToggle=document.createElement('button'); recToggle.id='ov-rec-toggle'; recToggle.className='btn'; recToggle.textContent='Start Recording';
+  let recording=false;
+  // Pass a hint to avoid spawning a duplicate native overlay when toggling from the overlay UI.
+  recToggle.addEventListener('click',()=>{ try{ recording=!recording; chrome.send('toggleRecording',[recording, true]); recToggle.textContent= recording?'Stop Recording':'Start Recording'; }catch(e){console.error('toggleRecording failed',e);} });
+  btns.appendChild(modelSelect);
+  btns.appendChild(recToggle);
+  titleBar.appendChild(title);
+  titleBar.appendChild(btns);
+  
+  const tabsBar=document.createElement('div'); tabsBar.className='overlay-tabs'; tabsBar.style.cssText='display:flex; gap:8px; margin-top:6px;';
+  const tabTimeline=document.createElement('button'); tabTimeline.textContent='Timeline'; tabTimeline.dataset.tab='timeline'; tabTimeline.className='btn';
+  const tabAgent=document.createElement('button'); tabAgent.textContent='Agent'; tabAgent.dataset.tab='agent'; tabAgent.className='btn btn-primary';
+  const tabPM=document.createElement('button'); tabPM.textContent='PageMap'; tabPM.dataset.tab='pm'; tabPM.className='btn';
+  tabsBar.appendChild(tabTimeline); tabsBar.appendChild(tabAgent); tabsBar.appendChild(tabPM);
+
+  const viewAgent=document.createElement('div'); viewAgent.id='agent-tab'; viewAgent.className='tab-view';
+  const hist=document.createElement('div'); hist.id='ov-ai-history'; hist.className='overlay-hist';
+  const ta=document.createElement('textarea'); ta.id='ov-ai-input'; ta.rows=3; ta.className='overlay-input';
+  const send=document.createElement('button'); send.id='ov-ai-send'; send.className='btn btn-primary'; send.textContent='Ask Agent';
+  const reset=document.createElement('button'); reset.id='ov-ai-reset'; reset.className='btn'; reset.textContent='Reset'; reset.style.marginLeft='8px';
+  reset.onclick = ()=>{ try{ if (window.__resetSharedAgentChat) window.__resetSharedAgentChat(); }catch(e){ console.warn('reset failed', e);} };
+  const controls = document.createElement('div'); controls.style.cssText='display:flex; gap:8px; align-items:center;'; controls.appendChild(send); controls.appendChild(reset);
+  viewAgent.appendChild(hist); viewAgent.appendChild(ta); viewAgent.appendChild(controls);
+
+  const viewTimeline=document.createElement('div'); viewTimeline.id='timeline-tab'; viewTimeline.className='tab-view';
+  const tlHist=document.createElement('div'); tlHist.id='ov-timeline'; tlHist.className='overlay-hist';
+  viewTimeline.appendChild(tlHist);
+
+  const viewPM=document.createElement('div'); viewPM.id='pm-tab'; viewPM.className='tab-view';
+  const pmWrap=document.createElement('details'); pmWrap.open = true;
+  const pmSummary=document.createElement('summary'); pmSummary.textContent='PageMap Stream';
+  const pmHist=document.createElement('div'); pmHist.id='ov-pm-stream'; pmHist.className='overlay-hist';
+  pmWrap.appendChild(pmSummary); pmWrap.appendChild(pmHist);
+  // Detailed JSON preview of the last PageMap / AgentSnapshot that was sent
+  // through the recorder pipeline so you can inspect exactly what the agent
+  // is seeing during data collection.
+  const pmDetail = document.createElement('pre');
+  pmDetail.id = 'ov-pm-json';
+  pmDetail.style.cssText = 'margin-top:8px; max-height:180px; overflow:auto; font-family:monospace; font-size:11px; white-space:pre;';
+  pmDetail.textContent = '[PageMap JSON will appear here once a snapshot arrives]';
+  viewPM.appendChild(pmWrap);
+  viewPM.appendChild(pmDetail);
+
+  card.appendChild(titleBar);
+  card.appendChild(tabsBar);
+  card.appendChild(viewAgent);
+  card.appendChild(viewTimeline);
+  card.appendChild(viewPM);
+  root.appendChild(card);
+  document.body.appendChild(root);
+
+  const ro=new ResizeObserver(()=>{ try{ const r=card.getBoundingClientRect(); chrome.send('dashboardOverlayResize',[Math.round(r.width+2), Math.round(r.height+2)]);}catch(_){}}); ro.observe(card);
+
+  // Shim overlay timeline updater used by RecorderController when appending actions
+  window.__simulachromeRecorder = window.__simulachromeRecorder || {};
+  window.__simulachromeRecorder.update = (payload) => {
+    try {
+      const target = document.getElementById('ov-timeline');
+      if (!target) return;
+      target.innerHTML = '';
+      const actions = (payload && payload.actions && Array.isArray(payload.actions)) ? payload.actions : [];
+      for (const a of actions) {
+        const div = document.createElement('div');
+        div.style.cssText = 'padding:6px;margin:4px 0;border-radius:6px;background:rgba(255,255,255,0.06);color:#e5e7eb;font-size:12px;';
+        const name = String(a && (a.action || a.type || 'action')).toUpperCase();
+        const params = a && (a.params || a.parameters || {});
+        let brief = '';
+        try {
+          if (params && Array.isArray(params.locators) && params.locators.length) {
+            const l = params.locators[0];
+            brief = `${l.type || 'locator'}=${(l.value || '').toString().slice(0,60)}`;
+          } else if (params && params.url) {
+            brief = String(params.url).slice(0, 80);
+          } else if (params && params.text) {
+            brief = `text=\"${String(params.text).slice(0,40)}\"`;
+          }
+        } catch(_) {}
+        div.textContent = brief ? `${name} — ${brief}` : name;
+        target.appendChild(div);
+      }
+      target.scrollTop = target.scrollHeight;
+    } catch (e) {
+      console.warn('[Overlay] Failed to render timeline', e);
+    }
+  };
+
+  // Bind the overlay agent console once dashboard_app.js has defined initAiConsole.
+  (function bindAiConsoleWithRetry(attempt){
+    if (window.initAiConsole) {
+      try{
+        console.log('[Overlay] Binding initAiConsole (attempt', attempt, ')');
+        window.initAiConsole({
+          historyElId:'ov-ai-history',
+          inputElId:'ov-ai-input',
+          sendBtnElId:'ov-ai-send',
+          mirrorSessionId: (window.__DASHBOARD_SHARED_CHAT_ID || 'dashboard_shared_chat'),
+          getPageInfoFn: window.dashboardRequestActivePageInfo
+        });
+      } catch(e) { console.error('[Overlay] initAiConsole exception', e); }
+      return;
+    }
+    if (attempt < 50) {
+      setTimeout(()=>bindAiConsoleWithRetry(attempt+1), 100);
+    } else {
+      console.warn('[Overlay] initAiConsole not available after retries');
+    }
+  })(0);
+
+  document.querySelectorAll('.tab-view').forEach(v=>v.style.display='none');
+  const agentView=document.getElementById('agent-tab'); if(agentView) agentView.style.display='block';
+  initOverlayTabs();
+}
+
+
+
+document.addEventListener('DOMContentLoaded', () => {
+  const overlayMode = isOverlayMode();
+  if (overlayMode) {
+    buildOverlayUI();
+    installPagemapStreamSink();
+    try {
+      const tlCb = 'ovTimeline_' + Date.now();
+      window[tlCb] = (res) => {
+        try { delete window[tlCb]; } catch (_) {}
+        if (res && Array.isArray(res.actions) && window.__simulachromeRecorder?.update) {
+          window.__simulachromeRecorder.update({ actions: res.actions });
+        }
+      };
+      chrome.send('dashboardRecorderGetActions', [tlCb]);
+    } catch (_) {}
+  }
+  // Provide a real callback function name so C++ ResolveCallback(cb, ...) works.
+  try {
+    const cb = 'ovReady_' + Date.now();
+    window[cb] = (res) => {
+      try { console.log('[Overlay] ready ack', res); } catch(_) {}
+      try { delete window[cb]; } catch(_) {}
+    };
+    chrome.send('dashboardOverlayReady', [cb]);
+  } catch(_) {}
+  // Once the overlay WebUI is ready, ask the browser for a fresh PageMap so
+  // the PageMap tab and globalSiteMap are primed even before recording or
+  // agent interaction begins.
+  try {
+    const pmCb = 'ovPmInit_' + Date.now();
+    window[pmCb] = (res) => {
+      try { delete window[pmCb]; } catch (_) {}
+      if (res && res.pagemap) ingestPageMapPayload('pagemap', res.pagemap, 'refresh');
+    };
+    chrome.send('dashboardAgentRefreshPageMap', [pmCb, {}]);
+  } catch (_) {}
+});
