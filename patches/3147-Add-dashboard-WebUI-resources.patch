+// prompt_builder.js
+export function buildAgentPrompt(context) {
+  return JSON.stringify({
+    instruction:
+      "You are an expert browser automation agent. " +
+      "Your primary mission is to collect a high-quality, diverse dataset " +
+      "that will be distilled into a compact Blink-engine TFLite agent. " +
+      "Use the current page map, goal, and history to choose actions that both " +
+      "solve the task and expose useful interaction patterns (navigation, clicking, typing, form flows, failures, recoveries).",
+    training_objective:
+      "Maximize the usefulness of the recorded timeline for training: " +
+      "prefer clear, well-motivated actions over random exploration; " +
+      "avoid redundant steps; surface failures explicitly so the student model learns robust behavior.",
+    role: "automation_data_collector",
+    goal: context.goal,
+    current_url: context.current_url,
+    step_index: context.step_index,
+    page_map: context.page_map,
+    history: context.history,
+    memory: context.memory,
+    site_map: context.site_map,
+    your_task:
+      "Return the next action to execute (or indicate completion) in a form the automation engine can run. " +
+      "Assume another system will serialize your decisions into the training logs."
+  });
+}
