+    const entry = document.createElement('div');
+    entry.className = 'locator-entry';
+    entry.style.cssText = 'padding:14px;background:#f9fafb;border:2px solid #e5e7eb;border-radius:8px;display:flex;flex-direction:column;gap:10px;';
+
+    // Type dropdown and remove button row
+    const topRow = document.createElement('div');
+    topRow.style.cssText = 'display:flex;gap:8px;align-items:center;';
+
+    const typeSelect = document.createElement('select');
+    typeSelect.className = 'locator-type-select';
+    typeSelect.style.cssText = 'flex:1;padding:8px 12px;border:1px solid #d1d5db;border-radius:4px;font-size:14px;background:white;font-weight:500;';
+    typeSelect.title = 'Choose how this locator finds the element on the page.';
+
+    Object.entries(LOCATOR_TYPES).forEach(([key, info]) => {
+      const option = document.createElement('option');
+      option.value = key;
+      option.textContent = info.label;
+      if (key === typeKey) option.selected = true;
+      typeSelect.appendChild(option);
+    });
+
+    typeSelect.onchange = (e) => this._updateLocator(index, 'type', e.target.value);
+
+    const removeBtn = document.createElement('button');
+    removeBtn.textContent = '✕ Remove';
+    removeBtn.style.cssText = 'padding:8px 14px;background:#ef4444;color:white;border:none;border-radius:4px;cursor:pointer;font-size:13px;font-weight:500;';
+    removeBtn.onmouseenter = (e) => e.target.style.background = '#dc2626';
+    removeBtn.onmouseleave = (e) => e.target.style.background = '#ef4444';
+    removeBtn.onclick = () => this._removeLocator(index);
+
+    topRow.append(typeSelect, removeBtn);
+
+    // Value input (specialized for XY Coordinates)
+    let valueNode;
+
+    // Help text
+    const helpText = document.createElement('div');
+    helpText.className = 'locator-help-text';
+    helpText.style.cssText = 'font-size:12px;color:#6b7280;font-style:italic;line-height:1.5;padding:8px;background:#ffffff;border-left:3px solid #3b82f6;border-radius:4px;';
+
+    if (typeKey === 'VISUAL_COORDS') {
+      const xyRow = document.createElement('div');
+      xyRow.style.cssText = 'display:flex;gap:8px;align-items:center;';
+
+      const xInput = document.createElement('smart-input');
+      xInput.style.width = '120px';
+      xInput.setAttribute('type', 'number');
+      xInput.setAttribute('placeholder', 'X (px)');
+      xInput.setAttribute('title', 'Pixels from the left edge of the viewport (X axis).');
