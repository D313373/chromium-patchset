+// ScrollEditor - class-based editor for scroll actions
+// Produces/consumes params in this shape: { percentY, percentX, element, locators }
+
+import { LocatorEditor } from '../components/locatorEditor.js';
+
+export class ScrollEditor {
+  constructor(container) {
+    if (!container) throw new Error('A container element must be provided.');
+    this.container = container;
+    this.dom = {};
+    this.locatorEditor = null;
+  }
+
+  render() {
+    const c = this.container;
+    c.innerHTML = '';
+    c.style.cssText = 'padding:16px;border-radius:8px;background:#f3f4f6;display:flex;flex-direction:column;gap:12px;font-family:sans-serif;';
+
+    const title = document.createElement('h3');
+    title.textContent = 'Scroll Action';
+    title.style.cssText = 'margin:0 0 4px;color:#111827;font-size:16px;';
+
+    const targetRow = this._row('Scroll Target');
+    const target = this._select('target', {
+      window: 'Window/Document',
+      element: 'Specific Element',
+    });
+    targetRow.appendChild(target);
+
+    const percentYRow = this._row('Vertical Scroll (%)');
+    const percentYInput = this._number('percentY', 0, 100, 0);
+    percentYRow.appendChild(percentYInput);
+
+    const percentXRow = this._row('Horizontal Scroll (%)');
+    const percentXInput = this._number('percentX', 0, 100, 0);
+    percentXRow.appendChild(percentXInput);
+
+    const locatorsRow = document.createElement('div');
+    locatorsRow.style.cssText = 'display:flex;flex-direction:column;gap:4px;';
+    const locatorsContainer = document.createElement('div');
+    locatorsRow.appendChild(locatorsContainer);
+
+    const helpText = document.createElement('div');
+    helpText.style.cssText = 'font-size:12px;color:#6b7280;';
+    helpText.innerHTML = `
+      <strong>Scroll Percentages:</strong><br>
+      • 0% = Top/Left<br>
+      • 50% = Middle<br>
+      • 100% = Bottom/Right
+    `;
+
+    c.append(title, targetRow, percentYRow, percentXRow, locatorsRow, helpText);
+
+    // Initialize LocatorEditor
+    this.locatorEditor = new LocatorEditor(locatorsContainer);
+    this.locatorEditor.render();
+
+    // Store handles
+    this.dom = { target, percentYInput, percentXInput, locatorsRow };
+
+    // Init visibility
+    this._onTargetChange();
+
+    // Wire
+    target.addEventListener('change', () => this._onTargetChange());
+  }
+
+  getValue() {
+    const target = this.dom.target.value;
+    const percentY = parseFloat(this.dom.percentYInput.value) || 0;
+    const percentX = parseFloat(this.dom.percentXInput.value) || 0;
+    const locators = this.locatorEditor ? this.locatorEditor.getValue() : [];
+
+    const params = {
+      percentY,
+      percentX,
+      element: target
+    };
+
+    if (target === 'element' && locators.length > 0) {
+      params.locators = locators;
+    }
+
+    return params;
+  }
+
+  setValue(params) {
+    if (!params) return;
+
+    const element = params.element || 'window';
+    this.dom.target.value = element;
+
+    if (typeof params.percentY === 'number') {
+      this.dom.percentYInput.value = params.percentY;
+    }
+    if (typeof params.percentX === 'number') {
+      this.dom.percentXInput.value = params.percentX;
+    }
+
+    if (this.locatorEditor && Array.isArray(params.locators)) {
+      this.locatorEditor.setValue(params.locators);
+    }
+
+    this._onTargetChange();
+  }
+
+  _row(labelText) {
+    const row = document.createElement('div');
+    row.style.cssText = 'display:flex;flex-direction:column;gap:4px;';
+    const label = document.createElement('label');
+    label.textContent = labelText;
+    label.style.cssText = 'font-size:14px;color:#4b5563;font-weight:500;';
+    row.appendChild(label);
+    return row;
+  }
+
+  _text(id, placeholder) {
+    const input = document.createElement('input');
+    input.type = 'text';
+    input.placeholder = placeholder;
+    input.style.cssText = 'padding:8px 12px;border-radius:6px;border:1px solid #d1d5db;font-size:14px;';
+    this.dom[id] = input;
+    return input;
+  }
+
+  _number(id, min, max, defaultValue) {
+    const input = document.createElement('input');
+    input.type = 'number';
+    input.min = min;
+    input.max = max;
+    input.value = defaultValue;
+    input.step = '0.01';
+    input.style.cssText = 'padding:8px 12px;border-radius:6px;border:1px solid #d1d5db;font-size:14px;';
+    this.dom[id] = input;
+    return input;
+  }
+
+  _select(id, options) {
+    const sel = document.createElement('select');
+    sel.style.cssText = 'padding:8px 12px;border-radius:6px;border:1px solid #d1d5db;font-size:14px;background:#fff;';
+    for (const value in options) {
+      const opt = document.createElement('option');
+      opt.value = value;
+      opt.textContent = options[value];
+      sel.appendChild(opt);
+    }
+    this.dom[id] = sel;
+    return sel;
+  }
+
+  _onTargetChange() {
+    const target = this.dom.target.value;
+    this.dom.locatorsRow.style.display = (target === 'element') ? '' : 'none';
+  }
+}
+
+// Compatibility wrapper used by the action editor
+export function renderScrollEditor(container, action, onChange) {
+  const editor = new ScrollEditor(container);
+  editor.render();
+  if (action?.params) editor.setValue(action.params);
+  
+  const emit = () => {
+    const params = editor.getValue();
+    const updated = { ...(action || {}), params };
+    if (typeof onChange === 'function') onChange(updated);
+  };
+  
+  ['change', 'input'].forEach(evt => {
+    editor.dom.target.addEventListener(evt, emit);
+    editor.dom.percentYInput.addEventListener(evt, emit);
+    editor.dom.percentXInput.addEventListener(evt, emit);
+    editor.dom.locatorsInput.addEventListener(evt, emit);
+  });
+}
+
