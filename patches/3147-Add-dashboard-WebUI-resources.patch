--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/scrape_element_action.cc
@@ -0,0 +1,160 @@
+#include "chrome/browser/ui/webui/dashboard/actions/scrape_element_action.h"
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/run_loop.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/dashboard/actions/locator_resolver.h"
+#include "chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.h"
+#include "chrome/browser/ui/webui/dashboard/debug_config.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/isolated_world_ids.h"
+
+ScrapeElementAction::ScrapeElementAction(Profile* profile)
+    : dashboard::actions::Action(profile) {}
+ScrapeElementAction::~ScrapeElementAction() = default;
+
+bool ScrapeElementAction::SetParams(const base::Value::Dict& params) {
+  const base::Value::List* locators_list = params.FindList("locators");
+  if (!locators_list || locators_list->empty()) {
+    return false;  // Locators are required.
+  }
+  locators_ = dashboard::ConvertLocators(*locators_list);
+
+  const std::string* variable_name_ptr = params.FindString("variableName");
+  if (!variable_name_ptr || variable_name_ptr->empty()) {
+    return false;  // Variable name is required.
+  }
+  variable_name_ = *variable_name_ptr;
+
+  const std::string* data_type_ptr = params.FindString("dataType");
+  data_type_ = data_type_ptr ? *data_type_ptr : "text";
+
+  download_image_ = params.FindBool("download").value_or(false);
+
+  const std::string* download_path_ptr = params.FindString("downloadPath");
+  download_path_ = download_path_ptr ? *download_path_ptr : "";
+
+  // Use the shared helper function to parse the rules.
+  const base::Value::List* rules_list = params.FindList("findReplace");
+  if (rules_list) {
+    find_replace_rules_ = dashboard::ConvertFindReplace(*rules_list);
+  }
+
+  SetSerializedAction("scrape_element", params.Clone());
+  return true;
+}
+
+void ScrapeElementAction::Execute(content::WebContents* web_contents,
+                                    Callback callback) {
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ScrapeElement] Starting async resolution with " << locators_.size()
+              << " locators, timeout=5000ms";
+  }
+
+  // Create heap-allocated resolver that will survive beyond this function
+  resolver_ = std::make_unique<dashboard::LocatorResolver>(web_contents);
+
+  // Use async LocatorResolver to avoid blocking
+  resolver_->ResolveUniqueAsync(
+      locators_,
+      dashboard::SearchScope::kAll,
+      /*timeout_ms=*/5000,
+      base::BindOnce(&ScrapeElementAction::OnElementResolved,
+                     weak_ptr_factory_.GetWeakPtr(),
+                     web_contents,
+                     std::move(callback)));
+}
+
+void ScrapeElementAction::OnElementResolved(
+    content::WebContents* web_contents,
+    Callback callback,
+    bool success,
+    const dashboard::ResolvedElement& element,
+    const std::string& error) {
+
+  // Clean up resolver
+  resolver_.reset();
+
+  if (!success) {
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(ERROR) << "[ScrapeElement] Element resolution failed: " << error;
+    }
+    std::move(callback).Run(false, "Element not ready: " + error);
+    return;
+  }
+
+  content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(element.frame_id);
+  if (!rfh) {
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(ERROR) << "[ScrapeElement] Frame not available for resolved element";
+    }
+    std::move(callback).Run(false, "Frame not available");
+    return;
+  }
+
+  // Build a frame-local JS that uses elementFromPoint at the resolved center.
+  std::string js = R"((function(x,y,kind){
+    const el = document.elementFromPoint(x,y);
+    if (!el) return null;
+    switch(kind){
+      case 'text': return el.innerText;
+      case 'html': return el.innerHTML;
+      case 'attribute_href': return el.getAttribute('href');
+      case 'attribute_src': return el.getAttribute('src');
+      default: return el.innerText;
+    }
+  }))";
+  js.append("(" + std::to_string(element.center_x) + "," + std::to_string(element.center_y) + ",'");
+  js.append(data_type_);
+  js.append("')");
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ScrapeElement] Executing in-frame JS scrape at (" << element.center_x
+              << "," << element.center_y << ")";
+  }
+
+  // Execute JavaScript asynchronously in a dedicated isolated world
+  rfh->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(js),
+      base::BindOnce(&ScrapeElementAction::OnJavaScriptExecuted,
+                     weak_ptr_factory_.GetWeakPtr(),
+                     std::move(callback)),
+      content::ISOLATED_WORLD_ID_CONTENT_END);
+}
+
+void ScrapeElementAction::OnJavaScriptExecuted(Callback callback,
+                                               base::Value result) {
+  std::string scraped_value;
+  if (result.is_string()) {
+    scraped_value = result.GetString();
+  } else {
+    std::move(callback).Run(false, "Failed to scrape data from element");
+    return;
+  }
+
+  // Apply the find_replace_rules_ if they exist.
+  for (const auto& rule : find_replace_rules_) {
+    base::ReplaceSubstringsAfterOffset(&scraped_value, 0, rule.find,
+                                       rule.replace);
+  }
+
+  if (download_image_) {
+    // TODO: A full implementation would check if scraped_value is a valid URL
+    // and use the DownloadManager to initiate a download.
+  }
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[ScrapeElement] Successfully scraped: "
+              << scraped_value.substr(0, 50)
+              << (scraped_value.length() > 50 ? "..." : "");
+  }
+
+  std::move(callback).Run(true, scraped_value);
+}
