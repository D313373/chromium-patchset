diff --git a/chrome/browser/ui/webui/dashboard/actions/type_action.cc b/chrome/browser/ui/webui/dashboard/actions/type_action.cc
new file mode 100644
index 0000000000000000000000000000000000000000..5291f754456c9c9fb6267bb4f53b18acaef66ef7
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/type_action.cc
@@ -0,0 +1,85 @@
+#include "chrome/browser/ui/webui/dashboard/actions/type_action.h"
+
+#include "base/values.h"
+#include "chrome/browser/ui/webui/dashboard/actions/action_types.h"
+#include "chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.h"
+#include "chrome/browser/ui/webui/dashboard/actions/locator_resolver.h"
+#include "chrome/browser/ui/webui/dashboard/type_handler.h"
+
+TypeAction::TypeAction(Profile* profile) : dashboard::actions::Action(profile) {}
+TypeAction::~TypeAction() = default;
+
+bool TypeAction::SetParams(const base::Value::Dict& params) {
+  const std::string* text = params.FindString("text");
+  if (!text) {
+    return false;  // text is required
+  }
+  text_to_type_ = *text;
+
+  // locators are optional - if not provided, type into currently focused element
+  const base::Value::List* locatorsList = params.FindList("locators");
+  if (locatorsList) {
+    locators_ = dashboard::ConvertLocators(*locatorsList);
+  } else {
+    // Use a generic locator that targets the active element
+    dashboard::Locator active_element;
+    active_element.type = dashboard::LocatorType::JS_EVAL;
+    active_element.value = "document.activeElement";
+    locators_.push_back(active_element);
+  }
+
+  base::Value::Dict params_dict = params.Clone();
+  base::Value::List locator_values;
+  for (const auto& locator : locators_) {
+    locator_values.Append(dashboard::LocatorToValue(locator));
+  }
+  params_dict.Set("locators", std::move(locator_values));
+  params_dict.Set("text", text_to_type_);
+  SetSerializedAction("type", std::move(params_dict));
+  return true;
+}
+
+
+
+void TypeAction::Execute(content::WebContents* web_contents,
+                         Callback callback) {
+  checker_ = std::make_unique<ElementReadinessChecker>(web_contents);
+
+  checker_->WaitForElementReadyAsync(
+      locators_,
+      dashboard::SearchScope::kAll,
+      /*timeout_ms=*/15000,
+      base::BindOnce(&TypeAction::OnElementReady,
+                     weak_ptr_factory_.GetWeakPtr(),
+                     web_contents,
+                     std::move(callback)));
+}
+
+void TypeAction::OnElementReady(content::WebContents* web_contents,
+                                Callback callback,
+                                bool ready,
+                                const dashboard::ResolvedElement& element,
+                                const std::string& error) {
+  checker_.reset();
+
+  if (!ready) {
+    std::move(callback).Run(false, error.empty() ? "Element not ready" : error);
+    return;
+  }
+
+  // Focus target and type via TypeHandler (async)
+  type_handler_ = std::make_unique<TypeHandler>(web_contents);
+  type_handler_->ExecuteTypeAsync(
+      locators_,
+      text_to_type_,
+      base::BindOnce(&TypeAction::OnTypeComplete,
+                     weak_ptr_factory_.GetWeakPtr(),
+                     std::move(callback)));
+}
+
+void TypeAction::OnTypeComplete(Callback callback,
+                                 bool success,
+                                 const std::string& error) {
+  type_handler_.reset();
+  std::move(callback).Run(success, error);
+}
