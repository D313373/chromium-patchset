+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ELEMENT_READINESS_CHECKER_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ELEMENT_READINESS_CHECKER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/webui/dashboard/actions/action_types.h"
+#include "chrome/browser/ui/webui/dashboard/actions/locator_resolver.h"
+#include "content/public/browser/web_contents.h"
+
+class ElementReadinessChecker {
+ public:
+  using ReadinessCallback = base::OnceCallback<void(bool ready,
+                                                     const dashboard::ResolvedElement& element,
+                                                     const std::string& error)>;
+
+  explicit ElementReadinessChecker(content::WebContents* web_contents);
+  ~ElementReadinessChecker();
+
+  // DEPRECATED: Synchronous version (blocks UI thread). Use WaitForElementReadyAsync instead.
+  // The main function that checks if an element is ready for interaction.
+  // It will poll the element's state until it's ready or the timeout is
+  // reached.
+  bool WaitForElementToBeClickable(const dashboard::Element& element,
+                                     int timeout_ms);
+
+  // REMOVED: Synchronous version that blocked UI thread.
+  // All code now uses WaitForElementReadyAsync() instead.
+
+  // Async version: Waits for element to be ready without blocking.
+  // Calls callback with (ready, element, error) when complete or timeout.
+  void WaitForElementReadyAsync(const std::vector<dashboard::Locator>& locators,
+                                dashboard::SearchScope scope,
+                                int timeout_ms,
+                                ReadinessCallback callback);
+
+  // Cancel any pending wait
+  void Cancel();
+
+ private:
+  void OnElementResolved(bool success,
+                         const dashboard::ResolvedElement& element,
+                         const std::string& error);
+  void CheckReadiness();
+  void OnReadinessCheckComplete(base::Value result);
+
+  raw_ptr<content::WebContents> web_contents_;
+  std::unique_ptr<dashboard::LocatorResolver> resolver_;
+
+  // Async state
+  ReadinessCallback async_callback_;
+  base::TimeTicks async_start_time_;
+  base::TimeDelta async_timeout_;
+  dashboard::ResolvedElement async_element_;
+  bool cancelled_ = false;
+
+  base::WeakPtrFactory<ElementReadinessChecker> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_ACTIONS_ELEMENT_READINESS_CHECKER_H_
diff --git a/chrome/browser/ui/webui/dashboard/actions/if_condition_action.cc b/chrome/browser/ui/webui/dashboard/actions/if_condition_action.cc
new file mode 100644
index 0000000000000000000000000000000000000000..5e4e701a2001e650670eb27fc1e4ea40aa620a9b
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/if_condition_action.cc
@@ -0,0 +1,173 @@
+#include "chrome/browser/ui/webui/dashboard/actions/if_condition_action.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/dashboard/actions/action_factory.h"
+#include "chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.h"
+#include "chrome/browser/ui/webui/dashboard/debug_config.h"
+
+namespace {
+
+// Helper function to convert string to LocatorType enum.
+dashboard::LocatorType StringToLocatorType(const std::string& type_str) {
+  if (type_str == "ID")
+    return dashboard::LocatorType::ID;
+  if (type_str == "XPATH")
+    return dashboard::LocatorType::XPATH;
+  if (type_str == "CSS_SELECTOR")
+    return dashboard::LocatorType::CSS_SELECTOR;
+  // TODO: Add other conversions as needed.
+  return dashboard::LocatorType::CSS_SELECTOR;  // Default
+}
+
+// Helper function to convert the JSON-like 'locators' list into our C++ struct
+// vector.
+std::vector<dashboard::Locator> ConvertLocators(
+    const base::Value::List& locatorsList) {
+  std::vector<dashboard::Locator> result;
+  for (const auto& locator_value : locatorsList) {
+    if (const base::Value::Dict* locator_dict = locator_value.GetIfDict()) {
+      const std::string* type_str = locator_dict->FindString("type");
+      const std::string* value_str = locator_dict->FindString("value");
+      if (type_str && value_str) {
+        dashboard::Locator locator;
+        locator.type = StringToLocatorType(*type_str);
+        locator.value = *value_str;
+        result.push_back(std::move(locator));
+      }
+    }
+  }
+  return result;
+}
+
+}  // namespace
+
+IfConditionAction::IfConditionAction(Profile* profile)
+    : dashboard::actions::Action(profile) {}
+
+IfConditionAction::~IfConditionAction() = default;
+
+bool IfConditionAction::SetParams(const base::Value::Dict& params) {
+  const std::string* conditionType = params.FindString("conditionType");
+  if (!conditionType) {
+    return false;
+  }
+  condition_type_ = *conditionType;
+
+  if (condition_type_ == "element_exists") {
+    const base::Value::List* locators = params.FindList("locators");
+    if (!locators || locators->empty())
+      return false;
+    locators_ = ConvertLocators(*locators);
+  } else if (condition_type_ == "text_contains") {
+    const std::string* text = params.FindString("text");
+    if (!text)
+      return false;
+    text_to_find_ = *text;
+  }
+
+  dashboard::actions::ActionFactory factory(profile_);
+  const base::Value::List* thenActions = params.FindList("then");
+  if (thenActions) {
+    then_actions_ = factory.CreateActionSequence(*thenActions);
+  }
+
+  const base::Value::List* elseActions = params.FindList("else");
+  if (elseActions) {
+    else_actions_ = factory.CreateActionSequence(*elseActions);
+  }
+
+  SetSerializedAction("if_condition", params.Clone());
+  return true;
+}
+
+void IfConditionAction::Execute(content::WebContents* web_contents,
+                                  Callback callback) {
+  web_contents_ = web_contents;
+  callback_ = std::move(callback);
+  current_action_index_ = 0;
+
+  // Evaluate the condition asynchronously
+  EvaluateCondition();
+}
+
+void IfConditionAction::EvaluateCondition() {
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[IfConditionAction] Evaluating condition type='" << condition_type_ << "'";
+  }
+
+  if (condition_type_ == "element_exists") {
+    // Check if element exists using ElementReadinessChecker
+    checker_ = std::make_unique<ElementReadinessChecker>(web_contents_);
+    checker_->WaitForElementReadyAsync(
+        locators_,
+        dashboard::SearchScope::kAll,  // Check all elements, not just interactive ones
+        1000,  // Short timeout - we just want to know if it exists NOW
+        base::BindOnce(&IfConditionAction::OnElementCheckComplete,
+                       weak_factory_.GetWeakPtr()));
+  } else if (condition_type_ == "text_contains") {
+    // TODO: Implement text_contains condition
+    // For now, default to false
+    OnConditionEvaluated(false);
+  } else {
+    // Unknown condition type, default to false
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(WARNING) << "[IfConditionAction] Unknown condition type: " << condition_type_;
+    }
+    OnConditionEvaluated(false);
+  }
+}
+
+void IfConditionAction::OnElementCheckComplete(
+    bool ready,
+    const dashboard::ResolvedElement& element,
+    const std::string& error) {
+  checker_.reset();
+
+  // Element exists if ready is true
+  bool condition_result = ready;
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[IfConditionAction] Element exists check: " << (condition_result ? "true" : "false");
+  }
+
+  OnConditionEvaluated(condition_result);
+}
+
+void IfConditionAction::OnConditionEvaluated(bool condition_result) {
+  if (condition_result) {
+    actions_to_run_ = &then_actions_;
+  } else {
+    actions_to_run_ = &else_actions_;
+  }
+
+  if (!actions_to_run_ || actions_to_run_->empty()) {
+    std::move(callback_).Run(true, "");
+    return;
+  }
+
+  RunNextAction();
+}
+
+void IfConditionAction::RunNextAction() {
+  if (current_action_index_ >= actions_to_run_->size()) {
+    std::move(callback_).Run(true, "");
+    return;
+  }
+
+  auto& action = (*actions_to_run_)[current_action_index_];
+  action->Execute(web_contents_,
+                  base::BindOnce(&IfConditionAction::OnActionComplete,
+                                 weak_factory_.GetWeakPtr()));
+}
+
+void IfConditionAction::OnActionComplete(bool success,
+                                           const std::string& result) {
+  if (!success) {
+    std::move(callback_).Run(false, result);
+    return;
+  }
+  current_action_index_++;
+  RunNextAction();
+}
