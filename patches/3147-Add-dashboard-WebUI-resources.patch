+#include "base/time/time.h"
+#include "base/strings/stringprintf.h"
+
+namespace dashboard {
+
+namespace {
+
+bool IsList(const base::Value* v) { return v && v->is_list(); }
+
+// ============================================================================
+// Action Schema Definitions
+// ============================================================================
+
+// Helper to create a base::Value for default params
+base::Value MakeDefaultValue(std::string_view type_str) {
+  if (type_str == "string") return base::Value("");
+  if (type_str == "int") return base::Value(0);
+  if (type_str == "bool") return base::Value(false);
+  if (type_str == "list") return base::Value(base::Value::List());
+  if (type_str == "dict") return base::Value(base::Value::Dict());
+  return base::Value();
+}
+
+struct ActionParamSpec {
+  const char* name;
+  const char* type;  // "string", "int", "bool", "list", "dict"
+  bool required;
+  const char* description;
+
+  base::Value GetDefaultValue() const {
+    return MakeDefaultValue(type);
+  }
+};
+
+struct ActionSpec {
+  const char* action_name;
+  const char* display_name;
+  const char* description;
+  std::initializer_list<ActionParamSpec> params;
+};
+
+std::vector<ActionSpec> GetActionSpecs() {
+  std::vector<ActionSpec> s;
+  s.push_back({
+      "click",
+      "Click",
+      "Click an element on the page",
+      {
+          // Locators are preferred; legacy coordinate params are converted into
+          // a VISUAL_COORDS locator if provided.
+          {"locators", "list", false,
+           "Array of locator objects to find the element"},
+          // Legacy explicit coordinates `{x, y}` for click fallback.
+          {"coordinates", "dict", false,
+           "Legacy click coordinates {x,y}; converted into a locator"},
+          {"click_count", "int", false,
+           "Number of clicks (0=hover only, 1=single, 2=double, 3=triple)"},
+          {"clickCount", "int", false,
+           "Alias for click_count (camelCase)"},
+          {"waitTimeout", "int", false,
+           "Wait timeout in ms for element readiness"},
+          {"humanOffset", "bool", false,
+           "Use human-like click jitter"},
+          {"button", "string", false,
+           "Mouse button: 'left', 'right', or 'middle'"},
+          {"iframePath", "list", false,
+           "Path to iframe if element is inside iframe"},
+      }});
+  s.push_back({
+    "type",
+    "Type Text",
+    "Type text into an element",
+    {
+      {"locators", "list", true, "Array of locator objects to find the element"},
+      {"text", "string", true, "Text to type into the element"},
+      {"delay_ms", "int", false, "Delay between keystrokes in milliseconds"}
+    }
+  });
+  s.push_back({
+    "navigate",
+    "Navigate",
+    "Navigate to a URL",
+    {
+      {"url", "string", true, "URL to navigate to"}
+    }
+  });
+  s.push_back({
+    "wait",
+    "Wait",
+    "Wait for a specified duration",
+    {
+      {"duration_ms", "int", false, "Duration to wait in milliseconds (legacy)"},
+      {"waitType", "string", false, "'time' or 'element'"},
+      {"seconds", "int", false, "Duration in seconds (UI)"},
+      {"time", "int", false, "Duration in milliseconds (UI)"},
+      {"locators", "list", false, "Element locators for element wait"},
+      {"timeout", "int", false, "Timeout milliseconds for element wait"},
+      {"randomDelay", "bool", false, "Randomized delay between actions"}
+    }
+  });
+  s.push_back({
+    "call_script",
+    "Call Script",
+    "Execute another stored dashboard script by id",
+    {
+      {"scriptId", "string", true, "ID of the script to call"},
+      {"waitFor", "string", false,
+       "Optional wait mode after call (none|url|selector)"},
+      {"checkSelector", "string", false,
+       "CSS selector used when waitFor=='selector'"},
+    }
+  });
+  s.push_back({
+    "scrape_element",
+    "Scrape Element",
+    "Extract data from an element",
+    {
+      {"locators", "list", true, "Array of locator objects to find the element"},
+      {"variableName", "string", true, "Variable name to store the scraped value"},
+      {"dataType", "string", false, "Data type to scrape ('text','html','attribute_href','attribute_src')"},
+      {"download", "bool", false, "Whether to download scraped resource"},
+      {"downloadPath", "string", false, "Download path"},
+      {"findReplace", "list", false, "Find/replace rules to apply to scraped text"}
+    }
+  });
+  s.push_back({
+    "scrape_table",
+    "Scrape Table",
+    "Extract data from a table",
+    {
+      {"columns", "list", true, "List of columns with locators"},
+      {"variableName", "string", true, "Variable name to store the table data"}
+    }
+  });
+  s.push_back({
+    "if_condition",
+    "If Condition",
+    "Conditional execution based on element presence or value",
+    {
+      {"condition", "string", false, "Condition to evaluate (legacy)"},
+      {"conditionType", "string", false, "'element_exists' or 'text_contains' (UI)"},
+      {"locators", "list", false, "Locators used when checking element_exists"},
+      {"text", "string", false, "Text to match when using text_contains"},
+      {"then", "list", false, "Actions to execute if condition is true"},
+      {"else", "list", false, "Actions to execute if condition is false"}
+    }
+  });
+  s.push_back({
+    "loop",
+    "Loop",
+    "Repeat actions multiple times",
+    {
+      {"count", "int", false, "Number of iterations"},
+      {"nestedActions", "list", true, "Actions to repeat"}
+    }
+  });
+  return s;
+}
+
+const ActionSpec* FindActionSpec(const std::string& action_name) {
+  static base::NoDestructor<std::vector<ActionSpec>> specs(GetActionSpecs());
+  std::string lower = base::ToLowerASCII(action_name);
+  for (const auto& spec : *specs) {
+    if (spec.action_name == lower) {
+      return &spec;
+    }
+  }
+  return nullptr;
+}
+
+// Append a note into the action's "comment" string field.
+void AppendComment(base::Value::Dict& action, const std::string& note) {
+  std::string existing;
+  if (const std::string* c = action.FindString("comment")) existing = *c;
+  if (!existing.empty()) existing.append(" | ");
+  existing.append(note);
+  action.Set("comment", existing);
+}
+
+// JSON stringify helper used when moving invalid content into comments.
+std::string JsonStringify(const base::Value& v) {
+  std::string s; base::JSONWriter::Write(v, &s); return s;
+}
+
+void CanonicalizeNested(base::Value::Dict& d, const char* key) {
+  if (base::Value* v = d.Find(key)) {
+    if (v->is_list()) {
+      auto& lst = v->GetList();
+      for (auto& it : lst) {
+        if (it.is_dict()) {
+          base::Value::Dict dd = it.GetDict().Clone();
+          ScriptSchema::CanonicalizeAction(dd);
+          it = base::Value(std::move(dd));
+        } else {
+          // Move invalid into comment and drop
+        }
+      }
+    } else {
+      AppendComment(d, std::string("invalid ") + key + " moved: " + JsonStringify(*v));
+      d.Remove(key);
+    }
+  }
+}
+
+}  // namespace
+
+base::Value::Dict ScriptSchema::CanonicalizeForSave(base::Value::Dict in,
+                                                    const std::string& id,
+                                                    base::Time now) {
+  // id/name/schema_version
+  in.Set("id", id);
+  if (!in.FindString("name")) in.Set("name", "Untitled");
+  in.Set("schema_version", "1.0.0");
+
+  // timestamps
+  const std::string now_iso = ToIso8601UTC(now);
+  if (!in.FindString("created_at")) in.Set("created_at", now_iso);
+  in.Set("updated_at", now_iso);
+
+  // If url_contexts present, canonicalize nested actions there; otherwise derive from flat actions.
+  if (base::Value* ctxs_any = in.Find("url_contexts"); ctxs_any && ctxs_any->is_list()) {
+    auto& ctxs = ctxs_any->GetList();
+    for (auto& c : ctxs) {
+      if (!c.is_dict()) continue;
+      base::Value::Dict ctx = c.GetDict().Clone();
+      if (base::Value* acts_any = ctx.Find("actions")) {
+        if (acts_any->is_list()) {
+          auto& lst = acts_any->GetList();
+          for (auto& it : lst) {
+            if (it.is_dict()) {
+              base::Value::Dict d = it.GetDict().Clone();
+              CanonicalizeAction(d);
+              it = base::Value(std::move(d));
+            } else {
+              AppendComment(ctx, std::string("invalid action moved: ") + JsonStringify(it));
+              it = base::Value(base::Value::Dict());
+            }
+          }
+        } else {
+          AppendComment(ctx, std::string("invalid actions moved: ") + JsonStringify(*acts_any));
+          ctx.Set("actions", base::Value::List());
+        }
+      } else {
+        ctx.Set("actions", base::Value::List());
+      }
+      c = base::Value(ctx.Clone());
+    }
+  } else {
+    // Build from flat actions array if present.
+    const base::Value* acts_any = in.Find("actions");
+    if (IsList(acts_any)) {
+      base::Value::List flat = acts_any->GetList().Clone();
+      CanonicalizeActionsList(flat);
+      in.Set("url_contexts", BuildUrlContextsFromFlat(flat));
+    } else {
+      in.Set("url_contexts", base::Value::List());
+    }
+  }
+
+  return in;
+}
+
+void ScriptSchema::CanonicalizeActionsList(base::Value::List& list) {
+  for (auto& it : list) {
+    if (!it.is_dict()) continue;
+    base::Value::Dict d = it.GetDict().Clone();
+    CanonicalizeAction(d);
+    it = base::Value(std::move(d));
+  }
+}
+
+void ScriptSchema::CanonicalizeAction(base::Value::Dict& action) {
+  // Lowercase action name and move some invalids to comments.
+  std::string name;
+  if (const std::string* a = action.FindString("action")) name = *a;
+  else if (const std::string* t = action.FindString("type")) name = *t;
+  name = base::ToLowerASCII(name);
+  if (name.empty()) name = "wait";  // safe fallback
+  action.Set("action", name);
+
+  // Params
+  base::Value* params_any = action.Find("params");
+  if (!params_any || !params_any->is_dict()) {
+    // Try legacy "parameters"
+    params_any = action.Find("parameters");
+  }
+  base::Value::Dict params;
+  if (params_any && params_any->is_dict()) {
+    params = params_any->GetDict().Clone();
+  } else if (params_any) {
+    // If params are malformed, drop them silently to avoid polluting comments.
+    params = base::Value::Dict();
+  }
+
+  // Apply schema-based normalization
+  const ActionSpec* spec = FindActionSpec(name);
+  if (spec) {
+    // Apply defaults for missing params
+    for (const auto& param_spec : spec->params) {
+      if (!params.Find(param_spec.name)) {
+        params.Set(param_spec.name, param_spec.GetDefaultValue());
+      }
+    }
+
+    // Do not migrate unknown params into comments anymore. Unknowns are
+    // tolerated and may be ignored by action SetParams.
+  }
+
+  // Specific normalizations (legacy support)
+  if (name == "click") {
+    // click_count allowed 0-3; default 1
+    int count = 1;
+    if (auto v = params.FindInt("click_count")) count = *v;
+    if (count < 0) { AppendComment(action, "click_count<0; set to 0"); count = 0; }
+    if (count > 3) { AppendComment(action, "click_count>3; clamped to 3"); count = 3; }
+    params.Set("click_count", count);
+  }
+
+  // Normalize nested control-flow arrays
+  CanonicalizeNested(action, "steps");
+  CanonicalizeNested(action, "nestedActions");
+  CanonicalizeNested(action, "then");
+  CanonicalizeNested(action, "else");
+
+  // Replace
+  action.Set("params", std::move(params));
+}
+
+base::Value::List ScriptSchema::BuildUrlContextsFromFlat(const base::Value::List& actions) {
+  base::Value::List contexts;
+  base::Value::List current_actions;
+  std::string current_url;
+  for (const auto& v : actions) {
+    if (!v.is_dict()) continue;
+    const base::Value::Dict& a = v.GetDict();
+    const std::string* name = a.FindString("action");
+    const base::Value::Dict* p = a.FindDict("params");
+    if (name && *name == "url_change") {
+      if (!current_actions.empty() || !current_url.empty()) {
+        base::Value::Dict ctx; ctx.Set("url", current_url); ctx.Set("actions", std::move(current_actions));
+        contexts.Append(std::move(ctx));
+        current_actions = base::Value::List();
+      }
+      if (p) { if (const std::string* u = p->FindString("url")) current_url = *u; }
+      continue;
+    }
+    if (name && *name == "navigate" && current_url.empty() && contexts.empty()) {
+      if (p) { if (const std::string* u = p->FindString("url")) current_url = *u; }
+    }
+    current_actions.Append(a.Clone());
+  }
+  if (!current_actions.empty() || !current_url.empty()) {
+    base::Value::Dict ctx; ctx.Set("url", current_url); ctx.Set("actions", std::move(current_actions));
+    contexts.Append(std::move(ctx));
+  }
+  return contexts;
+}
+
+std::string ScriptSchema::ToIso8601UTC(base::Time t) {
+  base::Time::Exploded ex;
+  t.UTCExplode(&ex);
+  // Format as YYYY-MM-DDTHH:MM:SSZ
+  return base::StringPrintf("%04d-%02d-%02dT%02d:%02d:%02dZ",
+                            ex.year, ex.month, ex.day_of_month,
+                            ex.hour, ex.minute, ex.second);
+}
+
+// ============================================================================
+// Schema Introspection API
+// ============================================================================
+
+base::Value::Dict ScriptSchema::GetActionTemplate(const std::string& action_type) {
+  base::Value::Dict action;
+  std::string lower = base::ToLowerASCII(action_type);
+  action.Set("action", lower);
+
+  base::Value::Dict params;
+  const ActionSpec* spec = FindActionSpec(lower);
+  if (spec) {
+    for (const auto& param : spec->params) {
+      params.Set(param.name, param.GetDefaultValue());
+    }
+  }
+
+  action.Set("params", std::move(params));
+  action.Set("comment", "");
+  return action;
+}
+
+bool ScriptSchema::ValidateAction(const base::Value::Dict& action, std::string* error) {
+  const std::string* action_name = action.FindString("action");
+  if (!action_name) {
+    if (error) *error = "Missing 'action' field";
+    return false;
+  }
+
+  const ActionSpec* spec = FindActionSpec(*action_name);
+  if (!spec) {
+    if (error) *error = "Unknown action type: " + *action_name;
+    return false;
+  }
+
+  const base::Value::Dict* params = action.FindDict("params");
+  if (!params) {
+    if (error) *error = "Missing 'params' field";
+    return false;
+  }
+
+  // Check required params
+  for (const auto& param_spec : spec->params) {
+    if (!param_spec.required)
+      continue;
+
+    if (params->Find(param_spec.name))
+      continue;
+
+    // Special handling for loop/nestedActions: treat top-level or param-level
+    // `steps` as satisfying the `nestedActions` requirement.
+    if (spec->action_name == std::string("loop") &&
+        std::string(param_spec.name) == "nestedActions") {
+      const base::Value::List* nested = params->FindList("steps");
+      if (!nested)
+        nested = action.FindList("steps");
+      if (nested)
+        continue;
+    }
+
+    if (error) {
+      *error = std::string("Missing required parameter '") + param_spec.name +
+               "' for action '" + spec->action_name + "'";
+    }
+    return false;
+  }
+
+  // Additional cross-field validation for specific actions.
+  if (*action_name == "click") {
+    // ClickAction requires locators or legacy coordinates/x/y that can be
+    // converted into a VISUAL_COORDS locator.
+    const base::Value::List* locs = params->FindList("locators");
+    bool has_locators = locs && !locs->empty();
+
+    const base::Value::Dict* coords = params->FindDict("coordinates");
+    bool has_coords = coords && coords->FindInt("x").has_value() &&
+                      coords->FindInt("y").has_value();
+    bool has_xy = params->FindInt("x").has_value() &&
+                  params->FindInt("y").has_value();
+
+    if (!has_locators && !has_coords && !has_xy) {
+      if (error) {
+        *error = "click requires 'locators' or legacy coordinates (x,y)";
+      }
+      return false;
+    }
+  }
+
+  return true;
+}
+
+base::Value::List ScriptSchema::GetSupportedActions() {
+  base::Value::List result;
+  static base::NoDestructor<std::vector<ActionSpec>> specs(GetActionSpecs());
+
+  for (const auto& spec : *specs) {
+    base::Value::Dict action_info;
+    action_info.Set("action", spec.action_name);
+    action_info.Set("display_name", spec.display_name);
+    action_info.Set("description", spec.description);
+
+    base::Value::List params_list;
+    for (const auto& param : spec.params) {
+      base::Value::Dict param_info;
+      param_info.Set("name", param.name);
+      param_info.Set("type", param.type);
+      param_info.Set("required", param.required);
+      param_info.Set("default", param.GetDefaultValue());
+      param_info.Set("description", param.description);
+      params_list.Append(std::move(param_info));
+    }
+    action_info.Set("params", std::move(params_list));
+
+    result.Append(std::move(action_info));
+  }
+
+  return result;
+}
+
+}  // namespace dashboard
diff --git a/chrome/browser/ui/webui/dashboard/script_schema.h b/chrome/browser/ui/webui/dashboard/script_schema.h
new file mode 100644
index 0000000000000000000000000000000000000000..aefd3774cf5b5a3f0478a0e0e15ceec427270982
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/script_schema.h
@@ -0,0 +1,50 @@
+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCRIPT_SCHEMA_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCRIPT_SCHEMA_H_
+
+#include <string>
+
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace dashboard {
+
+// Canonicalization/validation utilities for script JSON persisted on disk.
+class ScriptSchema {
+ public:
+  // Produces a canonical script dict suitable for persistence.
+  // Ensures:
+  //  - schema_version, id, name
+  //  - created_at (if absent) and updated_at timestamps (ISO 8601 UTC)
+  //  - actions normalized to {action (lowercase), params {}}
+  //  - click.click_count clamped to [1,3]
+  //  - url_contexts constructed from flat actions when absent
+  //  - invalid params/comments moved into "comment" field rather than lost
+  static base::Value::Dict CanonicalizeForSave(base::Value::Dict in,
+                                               const std::string& id,
+                                               base::Time now);
+
+  // Exposed for helper routines in the same translation unit.
+  static void CanonicalizeAction(base::Value::Dict& action);
+  static void CanonicalizeActionsList(base::Value::List& list);
+
+  // Schema introspection: Get default/template action for a given type.
+  // Returns a canonical action dict with all default params populated.
+  static base::Value::Dict GetActionTemplate(const std::string& action_type);
+
+  // Validate that an action has required params for its type.
+  // Returns true if valid; sets |error| message if invalid.
+  static bool ValidateAction(const base::Value::Dict& action, std::string* error);
+
+  // Get list of all supported action types with metadata.
+  // Each entry: {action, display_name, description, params: [{name, type, required, default}]}
+  static base::Value::List GetSupportedActions();
+
+ private:
+  static base::Value::List BuildUrlContextsFromFlat(const base::Value::List& actions);
+  static std::string ToIso8601UTC(base::Time t);
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCRIPT_SCHEMA_H_
+
diff --git a/chrome/browser/ui/webui/dashboard/script_schema_unittest.cc b/chrome/browser/ui/webui/dashboard/script_schema_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..19090fca18ea03c407478d1dfd3bd490bcd634bf
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/script_schema_unittest.cc
@@ -0,0 +1,236 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/dashboard/script_schema.h"
+
+#include "base/time/time.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace dashboard {
+
+class ScriptSchemaTest : public testing::Test {
+ protected:
+  void SetUp() override {}
+};
+
+// Test GetActionTemplate returns valid structure
+TEST_F(ScriptSchemaTest, GetActionTemplate_Click) {
+  auto tmpl = ScriptSchema::GetActionTemplate("click");
+  
+  EXPECT_EQ("click", *tmpl.FindString("action"));
+  EXPECT_TRUE(tmpl.FindDict("params"));
+  
+  const auto* params = tmpl.FindDict("params");
+  EXPECT_TRUE(params->FindList("locators"));
+  EXPECT_EQ(1, params->FindInt("click_count").value_or(0));
+}
+
+TEST_F(ScriptSchemaTest, GetActionTemplate_Navigate) {
+  auto tmpl = ScriptSchema::GetActionTemplate("navigate");
+  
+  EXPECT_EQ("navigate", *tmpl.FindString("action"));
+  const auto* params = tmpl.FindDict("params");
+  EXPECT_TRUE(params->FindString("url"));
+}
+
+// Test CanonicalizeAction normalizes action names
+TEST_F(ScriptSchemaTest, CanonicalizeAction_LowercasesName) {
+  base::Value::Dict action;
+  action.Set("action", "CLICK");
+  action.Set("params", base::Value::Dict());
+  
+  ScriptSchema::CanonicalizeAction(action);
+  
+  EXPECT_EQ("click", *action.FindString("action"));
+}
+
+// Test CanonicalizeAction handles legacy "type" field
+TEST_F(ScriptSchemaTest, CanonicalizeAction_HandlesTypeField) {
+  base::Value::Dict action;
+  action.Set("type", "Navigate");
+  action.Set("params", base::Value::Dict());
+  
+  ScriptSchema::CanonicalizeAction(action);
+  
+  EXPECT_EQ("navigate", *action.FindString("action"));
+}
+
+// Test CanonicalizeAction applies defaults
+TEST_F(ScriptSchemaTest, CanonicalizeAction_AppliesDefaults) {
+  base::Value::Dict action;
+  action.Set("action", "click");
+  base::Value::Dict params;
+  params.Set("locators", base::Value::List());
+  action.Set("params", std::move(params));
+  
+  ScriptSchema::CanonicalizeAction(action);
+  
+  const auto* result_params = action.FindDict("params");
+  EXPECT_EQ(1, result_params->FindInt("click_count").value_or(0));
+  EXPECT_EQ("left", *result_params->FindString("button"));
+}
+
+// Test CanonicalizeAction clamps click_count
+TEST_F(ScriptSchemaTest, CanonicalizeAction_ClampsClickCount) {
+  base::Value::Dict action;
+  action.Set("action", "click");
+  base::Value::Dict params;
+  params.Set("click_count", 5);  // Too high
+  action.Set("params", std::move(params));
+  
+  ScriptSchema::CanonicalizeAction(action);
+  
+  const auto* result_params = action.FindDict("params");
+  EXPECT_EQ(3, result_params->FindInt("click_count").value_or(0));
+  
+  // Check comment was added
+  const std::string* comment = action.FindString("comment");
+  EXPECT_TRUE(comment && comment->find("clamped") != std::string::npos);
+}
+
+// Test CanonicalizeAction moves unknown params to comment
+TEST_F(ScriptSchemaTest, CanonicalizeAction_MovesUnknownParams) {
+  base::Value::Dict action;
+  action.Set("action", "click");
+  base::Value::Dict params;
+  params.Set("locators", base::Value::List());
+  params.Set("unknown_param", "some_value");
+  action.Set("params", std::move(params));
+  
+  ScriptSchema::CanonicalizeAction(action);
+  
+  const auto* result_params = action.FindDict("params");
+  EXPECT_FALSE(result_params->Find("unknown_param"));
+  
+  const std::string* comment = action.FindString("comment");
+  EXPECT_TRUE(comment && comment->find("unknown param") != std::string::npos);
+}
+
+// Test ValidateAction accepts valid actions
+TEST_F(ScriptSchemaTest, ValidateAction_AcceptsValid) {
+  base::Value::Dict action;
+  action.Set("action", "click");
+  base::Value::Dict params;
+  params.Set("locators", base::Value::List());
+  action.Set("params", std::move(params));
+  
+  std::string error;
+  bool valid = ScriptSchema::ValidateAction(action, &error);
+  
+  EXPECT_TRUE(valid);
+  EXPECT_TRUE(error.empty());
+}
+
+// Test ValidateAction rejects missing action field
+TEST_F(ScriptSchemaTest, ValidateAction_RejectsMissingAction) {
+  base::Value::Dict action;
+  action.Set("params", base::Value::Dict());
+  
+  std::string error;
+  bool valid = ScriptSchema::ValidateAction(action, &error);
+  
+  EXPECT_FALSE(valid);
+  EXPECT_FALSE(error.empty());
+}
+
+// Test ValidateAction rejects missing required params
+TEST_F(ScriptSchemaTest, ValidateAction_RejectsMissingRequiredParams) {
+  base::Value::Dict action;
+  action.Set("action", "type");
+  base::Value::Dict params;
+  params.Set("locators", base::Value::List());
+  // Missing required "text" param
+  action.Set("params", std::move(params));
+  
+  std::string error;
+  bool valid = ScriptSchema::ValidateAction(action, &error);
+  
+  EXPECT_FALSE(valid);
+  EXPECT_TRUE(error.find("text") != std::string::npos);
+}
+
+// Test GetSupportedActions returns all action types
+TEST_F(ScriptSchemaTest, GetSupportedActions_ReturnsAll) {
+  auto actions = ScriptSchema::GetSupportedActions();
+  
+  EXPECT_GT(actions.size(), 0u);
+  
+  // Check that click action is present
+  bool found_click = false;
+  for (const auto& action_value : actions) {
+    if (const auto* action_dict = action_value.GetIfDict()) {
+      if (const std::string* name = action_dict->FindString("action")) {
+        if (*name == "click") {
+          found_click = true;
+          EXPECT_TRUE(action_dict->FindString("display_name"));
+          EXPECT_TRUE(action_dict->FindString("description"));
+          EXPECT_TRUE(action_dict->FindList("params"));
+          break;
+        }
+      }
+    }
+  }
+  EXPECT_TRUE(found_click);
+}
+
+// Test CanonicalizeForSave creates complete script
+TEST_F(ScriptSchemaTest, CanonicalizeForSave_CreatesCompleteScript) {
+  base::Value::Dict script;
+  script.Set("name", "Test Script");
+  base::Value::List actions;
+  base::Value::Dict action;
+  action.Set("action", "wait");
+  action.Set("params", base::Value::Dict());
+  actions.Append(std::move(action));
+  script.Set("actions", std::move(actions));
+  
+  auto result = ScriptSchema::CanonicalizeForSave(
+      std::move(script), "test-id", base::Time::Now());
+  
+  EXPECT_EQ("test-id", *result.FindString("id"));
+  EXPECT_EQ("Test Script", *result.FindString("name"));
+  EXPECT_EQ("1.0.0", *result.FindString("schema_version"));
+  EXPECT_TRUE(result.FindString("created_at"));
+  EXPECT_TRUE(result.FindString("updated_at"));
+  EXPECT_TRUE(result.FindList("url_contexts"));
+}
+
+// Test CanonicalizeForSave builds url_contexts from flat actions
+TEST_F(ScriptSchemaTest, CanonicalizeForSave_BuildsUrlContexts) {
+  base::Value::Dict script;
+  base::Value::List actions;
+  
+  // Add navigate action
+  base::Value::Dict nav;
+  nav.Set("action", "navigate");
+  base::Value::Dict nav_params;
+  nav_params.Set("url", "https://example.com");
+  nav.Set("params", std::move(nav_params));
+  actions.Append(std::move(nav));
+  
+  // Add click action
+  base::Value::Dict click;
+  click.Set("action", "click");
+  click.Set("params", base::Value::Dict());
+  actions.Append(std::move(click));
+  
+  script.Set("actions", std::move(actions));
+  
+  auto result = ScriptSchema::CanonicalizeForSave(
+      std::move(script), "test-id", base::Time::Now());
+  
+  const auto* url_contexts = result.FindList("url_contexts");
+  EXPECT_TRUE(url_contexts);
+  EXPECT_EQ(1u, url_contexts->size());
+  
+  const auto* first_context = (*url_contexts)[0].GetIfDict();
+  EXPECT_EQ("https://example.com", *first_context->FindString("url"));
+  
+  const auto* context_actions = first_context->FindList("actions");
+  EXPECT_EQ(2u, context_actions->size());
+}
+
+}  // namespace dashboard
+
diff --git a/chrome/browser/ui/webui/dashboard/script_store.cc b/chrome/browser/ui/webui/dashboard/script_store.cc
new file mode 100644
index 0000000000000000000000000000000000000000..4fe7e0f87bced3139cbf012d86232d30b00723e8
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/script_store.cc
@@ -0,0 +1,88 @@
+#include "chrome/browser/ui/webui/dashboard/script_store.h"
+
+#include <string>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "chrome/browser/profiles/profile.h"
+
+namespace dashboard {
+
+// Mirrors DashboardUIMessageHandler::ScriptsDir() default.
+base::FilePath ScriptStore::ScriptsDir(Profile* profile) {
+  if (!profile)
+    return base::FilePath();
+  return profile->GetPath().AppendASCII("SimulachromeScripts");
+}
+
+bool ScriptStore::Read(Profile* profile, const std::string& id, base::Value::Dict* out) {
+  if (!out) return false;
+  const base::FilePath dir = ScriptsDir(profile);
+  const base::FilePath path = dir.AppendASCII(id + ".json");
+  std::string json;
+  if (!base::PathExists(path)) {
+    VLOG(1) << "[ScriptStore] Read missing: " << path.AsUTF8Unsafe();
+    return false;
+  }
+  if (!base::ReadFileToString(path, &json)) {
+    PLOG(ERROR) << "[ScriptStore] Read failed: " << path.AsUTF8Unsafe();
+    return false;
+  }
+  auto val = base::JSONReader::Read(
+      json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!val || !val->is_dict()) {
+    LOG(ERROR) << "[ScriptStore] JSON not a dict: " << path.AsUTF8Unsafe();
+    return false;
+  }
+  *out = val->GetDict().Clone();
+  return true;
+}
+
+bool ScriptStore::Write(Profile* profile, const std::string& id, const base::Value::Dict& in) {
+  const base::FilePath dir = ScriptsDir(profile);
+  if (!base::CreateDirectory(dir)) {
+    PLOG(ERROR) << "[ScriptStore] CreateDirectory failed: " << dir.AsUTF8Unsafe();
+    return false;
+  }
+  const base::FilePath path = dir.AppendASCII(id + ".json");
+  std::string json;
+  base::JSONWriter::Write(in, &json);
+  int rv = base::WriteFile(path, base::as_byte_span(json));
+  if (rv <= 0) {
+    PLOG(ERROR) << "[ScriptStore] Write failed: " << path.AsUTF8Unsafe() << ", rv=" << rv;
+    return false;
+  }
+  VLOG(1) << "[ScriptStore] Wrote: " << path.AsUTF8Unsafe() << ", bytes=" << rv;
+  return true;
+}
+
+base::Value::Dict ScriptStore::LoadAll(Profile* profile) {
+  base::Value::Dict out;
+  const base::FilePath dir = ScriptsDir(profile);
+  if (!base::PathExists(dir))
+    return out;
+  base::FileEnumerator it(dir, /*recursive=*/false, base::FileEnumerator::FILES,
+                          FILE_PATH_LITERAL("*.json"));
+  for (base::FilePath path = it.Next(); !path.empty(); path = it.Next()) {
+    std::string id = path.BaseName().RemoveExtension().MaybeAsASCII();
+    std::string json;
+    if (!base::ReadFileToString(path, &json)) {
+      PLOG(ERROR) << "[ScriptStore] ReadAll failed: " << path.AsUTF8Unsafe();
+      continue;
+    }
+    auto val = base::JSONReader::Read(
+        json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (!val || !val->is_dict()) {
+      LOG(ERROR) << "[ScriptStore] ReadAll not dict: " << path.AsUTF8Unsafe();
+      continue;
+    }
+    out.Set(id, val->GetDict().Clone());
+  }
+  return out;
+}
+
+}  // namespace dashboard
