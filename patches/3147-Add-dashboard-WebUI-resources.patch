+void DashboardDataSource::StartDataRequest(
+    const GURL& url,
+    const content::WebContents::Getter& wc_getter,
+    GotDataCallback callback) {
+  const std::string raw_path = content::URLDataSource::URLToRequestPath(url);
+
+  // Strip query string from path (e.g., "directory.html?url=..." -> "directory.html")
+  std::string path = raw_path;
+  size_t query_pos = path.find('?');
+  if (query_pos != std::string::npos) {
+    path = path.substr(0, query_pos);
+  }
+
+  // Normalize: treat query-only (e.g., "?overlay=1") as the main page path
+  if (!path.empty() && path.front() == '?')
+    path.clear();
+
+  const ui::ResourceBundle& rb = ui::ResourceBundle::GetSharedInstance();
+
+  // Handle the main dashboard page
+  if (path.empty() || path == "dashboard.html") {
+    std::move(callback).Run(rb.LoadDataResourceBytes(IDR_DASHBOARD_HTML));
+    return;
+  }
+
+  // Overlay-only entrypoint: bare bones page that just runs overlay setup.
+  if (path == "overlay.html") {
+    std::move(callback).Run(rb.LoadDataResourceBytes(IDR_DASHBOARD_OVERLAY_HTML));
+    return;
+  }
+
+  // Handle directory.html (for navigation)
+  if (path == "directory.html") {
+    std::move(callback).Run(rb.LoadDataResourceBytes(IDR_DASHBOARD_DIRECTORY_HTML));
+    return;
+  }
+
+  // Look for the exact resource in our resource map
+  for (const auto& resource : base::span(kDashboardResources)) {
+    if (resource.path == path) {
+      std::move(callback).Run(rb.LoadDataResourceBytes(resource.id));
+      return;
+    }
+  }
+
+  // Resource not found - return appropriate 404 response
+  LOG(ERROR) << "DashboardDataSource: Resource not found: " << raw_path;
+  std::move(callback).Run(CreateNotFoundResponse());
+}
+
+std::string DashboardDataSource::GetMimeType(const GURL& url) {
+  const std::string raw_path = content::URLDataSource::URLToRequestPath(url);
+
+  // Strip query string from path
+  std::string path = raw_path;
+  size_t query_pos = path.find('?');
+  if (query_pos != std::string::npos) {
+    path = path.substr(0, query_pos);
+  }
+
+  // Query-only requests or HTML files should get the HTML MIME type
+  const bool query_only = (!raw_path.empty() && raw_path.front() == '?');
+  if (path.empty() || path == "dashboard.html" || path == "directory.html" || query_only)
+    return "text/html";
+  return GetMimeTypeForUrl(url);
+}
+
+
+bool DashboardDataSource::ShouldServeMimeTypeAsContentTypeHeader() {
+  // Required for ES modules: the Content-Type header must be explicit.
+  return true;
+}
+
+bool DashboardDataSource::ShouldAddContentSecurityPolicy() {
+  return true;
+}
+
+std::string DashboardDataSource::GetContentSecurityPolicy(
+    network::mojom::CSPDirectiveName directive) {
+  switch (directive) {
+    case network::mojom::CSPDirectiveName::DefaultSrc:
+      return "default-src 'self';";
+    case network::mojom::CSPDirectiveName::ScriptSrc:
+      return "script-src 'self' chrome://resources 'unsafe-inline' 'unsafe-eval';";
+    case network::mojom::CSPDirectiveName::StyleSrc:
+      return "style-src 'self' 'unsafe-inline';";
+    case network::mojom::CSPDirectiveName::FrameSrc:
+      return "frame-src 'self';";
+    case network::mojom::CSPDirectiveName::ImgSrc:
+      return "img-src 'self' data:;";
+    case network::mojom::CSPDirectiveName::ConnectSrc:
+      return "connect-src 'self' http://127.0.0.1:11434;";
+    case network::mojom::CSPDirectiveName::ObjectSrc:
+      return "object-src 'none';";
+    default:
+      return "";
+  }
+}
+
+bool DashboardDataSource::ShouldServiceRequest(
+    const GURL& url,
+    content::BrowserContext* /*browser_context*/,
+    int /*render_process_id*/) {
+  // Allow requests to simulachrome://dashboard/* and chrome://dashboard/*
+  // to be serviced by this data source.
+  const bool is_dashboard_host = url.host() == chrome::kChromeUIDashboardHost;
+  const bool is_simulachrome = url.SchemeIs(content::kChromeSimulachromeScheme);
+  const bool is_chrome = url.SchemeIs(content::kChromeUIScheme);
+  return is_dashboard_host && (is_simulachrome || is_chrome);
+}
