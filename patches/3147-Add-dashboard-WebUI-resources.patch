+        if (t === 'type text' || t === 'type') return { action: 'type', params: { text: p.text_to_type || p.text || '' }, comment };
+        if (t === 'click') {
+          const selectors = (p.selector || '').split(',').map(s => s.trim()).filter(Boolean);
+          const locators = selectors.map(sel => ({ type: 'css', value: sel }));
+          return { action: 'click', params: { locators }, comment };
+        }
+        if (t === 'scrape element') {
