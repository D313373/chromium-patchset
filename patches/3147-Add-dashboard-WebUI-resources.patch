+// ----------------------------------------------------------------------
+void DashboardUIMessageHandler::HandlePlayScript(const base::Value::List& args) {
+  const std::string cb =
+      (args.size() > 0 && args[0].is_string()) ? args[0].GetString()
+                                              : std::string();
+  const std::string id = (args.size() > 1 && args[1].is_string())
+                             ? args[1].GetString()
+                             : std::string();
+
+  if (id.empty()) {
+    LOG(ERROR) << "[Dashboard] HandlePlayScript: empty id.";
+    base::Value::Dict res;
+    res.Set("ok", false);
+    ResolveCallback(cb, res); // FIX
+    return;
+  }
+
+  base::Value::Dict script = dashboard_->LoadScript(id);
+  if (script.empty()) {
+    LOG(ERROR) << "[Dashboard] HandlePlayScript: script not found id=" << id;
+    base::Value::Dict res;
+    res.Set("ok", false);
+    ResolveCallback(cb, res); // FIX
+    return;
+  }
+
+  // 1) Flatten
+  auto flatten = [&](const base::Value::Dict& s,
+                     auto& self_ref) -> base::Value::List {
+    base::Value::List flat;
+    if (const base::Value::List* ctxs = s.FindList("url_contexts")) {
+      for (const auto& c : *ctxs) {
+        if (!c.is_dict()) continue;
+        const base::Value::Dict& cd = c.GetDict();
+        if (const base::Value::List* acts = cd.FindList("actions")) {
+          for (const auto& a : *acts)
+            flat.Append(a.Clone());
+        }
+      }
+    } else if (const base::Value::List* acts = s.FindList("actions")) {
+      for (const auto& a : *acts)
+        flat.Append(a.Clone());
+    }
+    return flat;
+  };
+
+  // 2) Expand
+  base::flat_set<std::string> visiting;
+  std::function<base::Value::List(const base::Value::List&)> expand;
+  expand = [&](const base::Value::List& in) -> base::Value::List {
+    base::Value::List out;
+    for (const auto& v : in) {
+      if (!v.is_dict())
+        continue;
+      const base::Value::Dict& d = v.GetDict();
+      const std::string* act = d.FindString("action");
+      const std::string* typ = d.FindString("type");
+      const std::string kind = act ? *act : (typ ? *typ : std::string());
+
+      if (kind == "call_script") {
+        const base::Value::Dict* params = d.FindDict("params");
+        if (!params) params = d.FindDict("parameters");
+        std::string sid;
+        if (params) {
+          if (const std::string* s = params->FindString("scriptId")) sid = *s;
+        }
+        if (!sid.empty() && !visiting.contains(sid)) {
+          visiting.insert(sid);
+          base::Value::Dict callee = dashboard_->LoadScript(sid);
+          base::Value::List flat = flatten(callee, flatten);
+          base::Value::List expanded = expand(flat);
+          for (auto& e : expanded)
+            out.Append(std::move(e));
+          visiting.erase(sid);
+          continue;
+        }
+      }
+      out.Append(v.Clone());
+    }
+    return out;
+  };
+
+  base::Value::List flat = flatten(script, flatten);
+  LOG(INFO) << "[Dashboard] HandlePlayScript flat size=" << flat.size();
+  base::Value::List final_seq = expand(flat);
+  LOG(INFO) << "[Dashboard] HandlePlayScript expanded size="
+            << final_seq.size();
+
+  // 3) Execute
+  content::WebContents* target_wc = nullptr;
+  if (Browser* browser = chrome::FindLastActiveWithProfile(profile_)) {
+    NavigateParams np(browser, GURL("about:blank"),
+                      ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    np.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&np);
+    target_wc = np.navigated_or_inserted_contents;
+  } else {
+    LOG(ERROR) << "[Dashboard] No active browser to open a new tab.";
+  }
+
+  dashboard::ScriptContext* script_ctx = nullptr;
+  if (dashboard::ScriptContextManager* mgr = dashboard::ScriptContextManager::GetInstance()) {
+    mgr->RemoveContext(id);
+    if (target_wc)
+      script_ctx = mgr->CreateContext(id, target_wc);
+  }
+
+  if (script_executor_)
+    script_executor_->ExecuteScript(final_seq, target_wc, script_ctx);
+  else
+    LOG(ERROR) << "[Dashboard] ScriptExecutor not initialised.";
+
+  base::Value::Dict ok;
+  ok.Set("ok", true);
+  ResolveCallback(cb, ok); // FIX
+}
