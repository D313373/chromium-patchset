@@ -0,0 +1,59 @@
+// agent_context.js
+export class AgentContext {
+  constructor(goal, page_map, current_url = window.location.href) {
+    this.goal = goal;
+    this.page_map = page_map;
+    this.current_url = current_url;
+    this.step_index = 0;
+    this.history = [];
+    this.memory = {};
+    this.site_map = {};
+  }
+
+  logStep(action, status, error = null) {
+    this.history.push({
+      step: this.step_index,
+      action,
+      status,
+      error,
+      page_map: this.page_map
+    });
+    this.step_index += 1;
+  }
+}
+
+// Shared global snapshot container mirrored to the overlay UI.
+window.globalSiteMap = {
+  pages: {},
+  lastSnapshot: {},
+  context: {},
+  currentStep: 0,
+  scriptId: null,
+};
+
+// Merge the latest context/page_map into the shared globalSiteMap so the
+// overlay/LLM view stays in sync.
+export function updateGlobalSiteMapFromContext(ctx) {
+  if (!window.globalSiteMap)
+    window.globalSiteMap = {pages: {}, lastSnapshot: {}, context: {}, currentStep: 0, scriptId: null};
+
+  const snapshot = (ctx && ctx.page_map) ? ctx.page_map : {};
+  window.globalSiteMap.lastSnapshot = snapshot;
+
+  const url = ctx && ctx.current_url;
+  if (url) {
+    if (!window.globalSiteMap.pages)
+      window.globalSiteMap.pages = {};
+    window.globalSiteMap.pages[url] = snapshot;
+  }
+
+  window.globalSiteMap.context = {
+    goal: ctx && ctx.goal,
+    current_url: url,
+    step_index: ctx && ctx.step_index,
+    history: ctx && ctx.history,
+  };
+  window.globalSiteMap.currentStep = ctx && typeof ctx.step_index === 'number'
+      ? ctx.step_index
+      : (window.globalSiteMap.currentStep || 0);
+}
diff --git a/chrome/browser/resources/dashboard/agent/agent_loop.js b/chrome/browser/resources/dashboard/agent/agent_loop.js
new file mode 100644
index 0000000000000000000000000000000000000000..c9199c460efa11f4adf95c895c0d7c57f449dc19
--- /dev/null
+++ b/chrome/browser/resources/dashboard/agent/agent_loop.js
@@ -0,0 +1,103 @@
+// agent_loop.js
+import { buildAgentPrompt } from './prompt_builder.js';
+import { updateGlobalSiteMapFromContext } from './agent_context.js';
+
+export class AgentLoop {
+  constructor(context, runLLMFn) {
+    this.context = context;
+    this.runLLM = runLLMFn;
+    this.running = false;
+  }
+
+  async start() {
+    if (this.running) return;
+    this.running = true;
+
+    while (this.running) {
+      // Refresh context.page_map/current_url from the latest globalSiteMap
+      // snapshot so the agent always reasons over fresh state.
+      try {
+        const gsm = window.globalSiteMap;
+        if (gsm) {
+          const snap = gsm.lastAgentSnapshot || gsm.lastSnapshot;
+          if (snap && typeof snap === 'object') {
+            this.context.page_map = snap;
+            if (snap.url) {
+              this.context.current_url = snap.url;
+            }
+          }
+        }
+      } catch (e) {
+        console.warn('[AgentLoop] Failed to sync from globalSiteMap', e);
+      }
+
+      const prompt = buildAgentPrompt(this.context);
+
+      let result;
+      try {
+        result = await this.runLLM(prompt);
+      } catch (e) {
+        console.warn('[AgentLoop] LLM call failed', e);
+        this.context.logStep({ type: 'internal_error', error: String(e) }, 'fail', e);
+        break;
+      }
+
+      // Contract: result.done === true means stop
+      if (!result || result.done) {
+        this.context.logStep({ type: 'done' }, 'success', null);
+        this.running = false;
+        this.saveScriptIfNeeded();
+        break;
+      }
+
+      const action = result.action || result.step || null;
+      if (!action) {
+        this.context.logStep({ type: 'no_action' }, 'fail', 'LLM returned no action');
+        break;
+      }
+
+      const ok = await this.performAction(action, result);
+      this.context.logStep(action, ok ? 'success' : 'fail', ok ? null : (result.error || null));
+
+      if (result.stop === true) {
+        this.running = false;
+        break;
+      }
+    }
+
+    updateGlobalSiteMapFromContext(this.context);
+  }
+
+  async performAction(action /*, llmResult */) {
+    try {
+      if (typeof window.performAgentAction !== 'function') {
+        console.warn('[AgentLoop] window.performAgentAction is not defined');
+        return false;
+      }
+      const res = await window.performAgentAction(action);
+      const ok = !!(res && res.ok);
+
+      if (ok && typeof window.appendToTimelineFromAgent === 'function') {
+        window.appendToTimelineFromAgent(action);
+      }
+      return ok;
+    } catch (err) {
+      console.warn('[AgentLoop] Agent action failed:', err);
+      return false;
+    }
+  }
+
+  stop() {
+    this.running = false;
+  }
+
+  saveScriptIfNeeded() {
+    if (typeof window.saveCurrentScriptToDisk === 'function') {
+      try {
+        window.saveCurrentScriptToDisk();
+      } catch (e) {
+        console.warn('[AgentLoop] saveCurrentScriptToDisk failed', e);
+      }
+    }
+  }
+}
