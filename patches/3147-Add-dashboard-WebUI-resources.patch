+    help: 'Text content of any element (not just links). Case-sensitive.'
+  },
+  ACCESSIBILITY_NAME: {
+    label: 'Accessibility Name',
+    placeholder: 'aria-label value, aria-labelledby reference',
+    help: 'ARIA label for accessibility. Find aria-label or aria-labelledby in DevTools.'
+  },
+  SHADOW_DOM: {
