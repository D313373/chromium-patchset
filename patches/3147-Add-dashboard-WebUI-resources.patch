@@ -0,0 +1,66 @@
+// KeyEditor.js
+
+export function renderKeyEditor(container, action, onSave, onCancel) {
+  container.innerHTML = `
+    <h3>Keyboard Action</h3>
+    <div>
+      <label>Action Description:</label>
+      <smart-input id="actionDesc" data-type="string"></smart-input>
+    </div>
+    <div class="editor-actions">
+      <button id="saveKey">Save</button>
+      <button id="cancelKey">Cancel</button>
+    </div>
+  `;
+
+  const descEl = document.getElementById('actionDesc');
+  // Set initial value if provided
+  if (action.description) descEl.value = action.description;
+
+  // Key consolidation buffer
+  action.typeBuffer = action.typeBuffer || '';
+
+  // Example: user is typing and we record visible characters
+  function addKeyPress(keyEvent) {
+    if (isShortcutKey(keyEvent)) {
+      // If it's a shortcut, create a KeyDown action with nested keys
+      action.shortcut = action.shortcut || { modifiers: [], keys: [] };
+      if (!action.shortcut.modifiers.includes(keyEvent.modifier)) {
+        action.shortcut.modifiers.push(keyEvent.modifier);
+      }
+      action.shortcut.keys.push(keyEvent.key);
+    } else if (isVisibleCharacter(keyEvent)) {
+      // Add to type buffer
+      action.typeBuffer += keyEvent.key;
+    } else {
+      // Handle navigation keys separately
+      action.navigation = action.navigation || [];
+      action.navigation.push(keyEvent.key);
+    }
+  }
+
+  function isShortcutKey(e) {
+    return e.ctrlKey || e.metaKey || e.altKey;
+  }
+
+  function isVisibleCharacter(e) {
+    const code = e.key.length === 1; // single character keys
+    const notNav = !['Tab', 'Enter', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key);
+    return code && notNav;
+  }
+
+  document.getElementById('saveKey').addEventListener('click', () => {
+    if (action.typeBuffer) {
+      action.description = action.typeBuffer; // consolidated typed text
+    } else if (action.shortcut) {
+      action.description = `Shortcut: ${action.shortcut.modifiers.join('+')}+${action.shortcut.keys.join('+')}`;
+    } else if (action.navigation) {
+      action.description = `Navigation: ${action.navigation.join(', ')}`;
+    }
+    onSave(action);
+  });
+
+  document.getElementById('cancelKey').addEventListener('click', () => {
+    onCancel();
+  });
+}
