+// ==============================================
+// File: actions/ScrapeTableEditor.js
+// ==============================================
+
+export function renderScrapeTableEditor(container, action, onSave, onCancel) {
+  const tables = window.appState ? Object.keys(window.appState.tables || {}) : [];
+
+  container.innerHTML = `
+    <h3>Scrape Table Configuration</h3>
+    <div>
+      <label>Target Table/List:</label>
+      <select id="targetTable">
+        <option value="">--Select--</option>
+        ${tables.map(t => `<option value="${t}">${t}</option>`).join('')}
+      </select>
+    </div>
+    <div id="fieldsContainer">
+      <!-- Fields will be dynamically added here -->
+    </div>
+    <button id="addField">Add Field</button>
+    <div class="editor-actions">
+      <button id="saveScrapeTable">Save</button>
+      <button id="cancelScrapeTable">Cancel</button>
+    </div>
+  `;
+
+  const targetTableEl = document.getElementById('targetTable');
+  const fieldsContainer = document.getElementById('fieldsContainer');
+  const addFieldBtn = document.getElementById('addField');
+
+  const maxFields = 20;
+  action.fields = action.fields || [];
+
+  // Initialize existing fields
+  action.fields.forEach((f, idx) => addFieldEditor(f, idx));
+  updateAddButtonState();
+
+  addFieldBtn.addEventListener('click', () => {
+    if (action.fields.length >= maxFields) return;
+    const newField = { name: '', findReplace: [] };
+    action.fields.push(newField);
+    addFieldEditor(newField, action.fields.length - 1);
+    updateAddButtonState();
+  });
+
+  targetTableEl.value = action.targetTable ?? '';
+  targetTableEl.addEventListener('change', () => {
+    action.targetTable = targetTableEl.value;
+  });
+
+  function addFieldEditor(field, idx) {
+    const fieldDiv = document.createElement('div');
+    fieldDiv.className = 'scrape-field';
+    fieldDiv.dataset.index = idx;
+
+    fieldDiv.innerHTML = `
+      <label>Field Name:</label>
+      <smart-input class="fieldName" data-type="string"></smart-input>
+      <div class="findReplaceContainer"></div>
+      <button class="addFindReplace">Add Find/Replace</button>
+      <button class="removeField">Remove Field</button>
+    `;
+
+    fieldsContainer.appendChild(fieldDiv);
+
+    const fieldNameEl = fieldDiv.querySelector('.fieldName');
+    const findReplaceContainer = fieldDiv.querySelector('.findReplaceContainer');
+    const addFRBtn = fieldDiv.querySelector('.addFindReplace');
+    const removeFieldBtn = fieldDiv.querySelector('.removeField');
+
+    // Set initial value if provided
+    if (field.name) fieldNameEl.value = field.name;
+
+    fieldNameEl.addEventListener('input', e => field.name = e.target.value);
+    field.findReplace = field.findReplace || [];
+    field.findReplace.forEach((fr, i) => addFindReplaceEditor(fr, i, findReplaceContainer, field));
+
+    addFRBtn.addEventListener('click', () => {
+      if (field.findReplace.length >= 3) return;
+      const newFR = { find: '', replace: '', regex: false };
+      field.findReplace.push(newFR);
+      addFindReplaceEditor(newFR, field.findReplace.length - 1, findReplaceContainer, field);
+    });
+
+    removeFieldBtn.addEventListener('click', () => {
+      fieldsContainer.removeChild(fieldDiv);
+      action.fields.splice(idx, 1);
+      refreshFieldIndexes();
+      updateAddButtonState();
+    });
+  }
+
+  function addFindReplaceEditor(fr, idx, container, field) {
+    const frDiv = document.createElement('div');
+    frDiv.className = 'findReplaceEntry';
+    frDiv.dataset.index = idx;
+    frDiv.innerHTML = `
+      <smart-input class="findText" data-type="string" placeholder="Find"></smart-input>
+      <smart-input class="replaceText" data-type="string" placeholder="Replace"></smart-input>
+      <label>
+        <input type="checkbox" class="regexToggle" ${fr.regex ? 'checked' : ''}/> Regex
+      </label>
+      <button class="removeFR">Remove</button>
+    `;
+    container.appendChild(frDiv);
+
+    const findEl = frDiv.querySelector('.findText');
+    const replaceEl = frDiv.querySelector('.replaceText');
+    const regexEl = frDiv.querySelector('.regexToggle');
+    const removeBtn = frDiv.querySelector('.removeFR');
+
+    // Set initial values if provided
+    if (fr.find) findEl.value = fr.find;
+    if (fr.replace) replaceEl.value = fr.replace;
+
+    findEl.addEventListener('input', e => fr.find = e.target.value);
+    replaceEl.addEventListener('input', e => fr.replace = e.target.value);
+    regexEl.addEventListener('change', e => fr.regex = e.target.checked);
+
+    removeBtn.addEventListener('click', () => {
+      container.removeChild(frDiv);
+      field.findReplace.splice(idx, 1);
+      refreshFindReplaceIndexes(container, field);
+    });
+  }
+
+  function refreshFieldIndexes() {
+    Array.from(fieldsContainer.children).forEach((child, i) => child.dataset.index = i);
+  }
+
+  function refreshFindReplaceIndexes(container, field) {
+    Array.from(container.children).forEach((child, i) => child.dataset.index = i);
+  }
+
+  function updateAddButtonState() {
+    addFieldBtn.disabled = action.fields.length >= maxFields;
+  }
+
+  // Hover detection & loop candidate suggestion
+  container.addEventListener('mousemove', e => {
+    const target = e.target.closest('.loopCandidate');
+    if (!target) return;
+    highlightLoopCandidates(target);
+  });
+
+  function highlightLoopCandidates(el) {
+    document.querySelectorAll('.loopCandidate').forEach(c => c.style.outline = '');
+    const sequence = detectSequence(el);
+    sequence.forEach(node => node.style.outline = '2px solid green');
+  }
+
+  function detectSequence(el) {
+    // Placeholder: implement sequence detection based on attributes, siblings, iteration patterns
+    return [el]; // Return array of nodes forming the detected loop
+  }
+
+  // Save / Cancel
+  document.getElementById('saveScrapeTable').addEventListener('click', () => onSave(action));
+  document.getElementById('cancelScrapeTable').addEventListener('click', () => onCancel());
+}
