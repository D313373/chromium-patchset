+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCRIPT_STORE_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCRIPT_STORE_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+
+class Profile;
+
+namespace dashboard {
+
+// Centralized script persistence utilities used by both Mojo and WebUI paths.
+class ScriptStore {
+ public:
+  // Returns the scripts directory for the given profile. Defaults to
+  // <profile>/SimulachromeScripts, matching existing WebUI path logic.
+  static base::FilePath ScriptsDir(Profile* profile);
+
+  // Reads a script JSON file into |out|. Returns true on success.
+  static bool Read(Profile* profile, const std::string& id, base::Value::Dict* out);
+
+  // Writes |in| as JSON for the given script id. Returns true on success.
+  static bool Write(Profile* profile, const std::string& id, const base::Value::Dict& in);
+
+  // Loads all scripts { id -> Dict } from disk.
+  static base::Value::Dict LoadAll(Profile* profile);
+};
+
+}  // namespace dashboard
