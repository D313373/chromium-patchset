+// ScrapeEditor.js
+
+import { renderLocatorEditor } from '../components/locatorEditor.js';
+
+export function renderScrapeEditor(container, action, onSave, onCancel) {
+  const tables = window.appState ? Object.keys(window.appState.tables || {}) : [];
+
+  container.innerHTML = `
+    <h3>Scrape Configuration</h3>
+    <div id="locatorsContainer"></div>
+    <div>
+      <label>Variable Name:</label>
+      <smart-input id="variableName" data-type="string" placeholder="Variable name to store result"></smart-input>
+    </div>
+    <div>
+      <label>Data Type:</label>
+      <select id="dataType">
+        <option value="text">Text</option>
+        <option value="html">HTML</option>
+        <option value="attribute_href">Attribute: href</option>
+        <option value="attribute_src">Attribute: src</option>
+      </select>
+    </div>
+    <div id="downloadOptions" style="display:none;">
+      <label>Download Image:</label>
+      <input type="checkbox" id="downloadImage" />
+      <label>Save Path:</label>
+      <smart-input id="imagePath" data-type="string" placeholder="e.g., /Users/You/Downloads"></smart-input>
+    </div>
+    <div id="findReplaceContainer">
+      <h4>Find/Replace (optional)</h4>
+      <div id="findReplaceList"></div>
+      <button id="addFindReplace">Add Find/Replace</button>
+    </div>
+    <div class="editor-actions">
+      <button id="saveScrape">Save</button>
+      <button id="cancelScrape">Cancel</button>
+    </div>
+  `;
+
+  const locatorsContainer = document.getElementById('locatorsContainer');
+  const variableNameEl = document.getElementById('variableName');
+  const dataTypeEl = document.getElementById('dataType');
+  const downloadOptionsEl = document.getElementById('downloadOptions');
+  const downloadImageEl = document.getElementById('downloadImage');
+  const imagePathEl = document.getElementById('imagePath');
+  const findReplaceContainer = document.getElementById('findReplaceList');
+  const addFRBtn = document.getElementById('addFindReplace');
+
+  action.variableName = action.variableName ?? '';
+  action.dataType = action.dataType ?? 'text';
+  action.download = action.download ?? false;
+  action.downloadPath = action.downloadPath ?? '';
+  action.findReplace = action.findReplace || [];
+
+  variableNameEl.value = action.variableName;
+  dataTypeEl.value = action.dataType;
+  downloadImageEl.checked = action.download;
+  imagePathEl.value = action.downloadPath;
+
+  // Initialize LocatorEditor
+  const locatorEditor = renderLocatorEditor(
+    locatorsContainer,
+    action.locators,
+    (locators) => {
+      action.locators = locators;
+    }
+  );
+
+  variableNameEl.addEventListener('input', e => {
+    action.variableName = e.target.value;
+  });
+
+  updateVisibility();
+
+  dataTypeEl.addEventListener('change', () => {
+    action.dataType = dataTypeEl.value;
+    updateVisibility();
+  });
+
+  downloadImageEl.addEventListener('change', () => action.download = downloadImageEl.checked);
+  imagePathEl.addEventListener('input', e => action.downloadPath = e.target.value);
+
+  function updateVisibility() {
+    if (action.dataType === 'attribute_src') {
+      downloadOptionsEl.style.display = 'block';
+      findReplaceContainer.parentElement.style.display = 'block';
+    } else {
+      downloadOptionsEl.style.display = 'none';
+      findReplaceContainer.parentElement.style.display = 'block';
+    }
+  }
+
+  function renderFindReplace() {
+    findReplaceContainer.innerHTML = '';
+    action.findReplace.forEach((fr, idx) => {
+      const frDiv = document.createElement('div');
+      frDiv.className = 'findReplaceEntry';
+      frDiv.dataset.index = idx;
+      frDiv.innerHTML = `
+        <smart-input class="findText" data-type="string" placeholder="Find"></smart-input>
+        <smart-input class="replaceText" data-type="string" placeholder="Replace"></smart-input>
+        <label>
+          <input type="checkbox" class="regexToggle" ${fr.regex ? 'checked' : ''}/> Regex
+        </label>
+        <button class="removeFR">Remove</button>
+      `;
+      findReplaceContainer.appendChild(frDiv);
+
+      const findEl = frDiv.querySelector('.findText');
+      const replaceEl = frDiv.querySelector('.replaceText');
+      const regexEl = frDiv.querySelector('.regexToggle');
+      const removeBtn = frDiv.querySelector('.removeFR');
+
+      // Set initial values if provided
+      if (fr.find) findEl.value = fr.find;
+      if (fr.replace) replaceEl.value = fr.replace;
+
+      findEl.addEventListener('input', e => fr.find = e.target.value);
+      replaceEl.addEventListener('input', e => fr.replace = e.target.value);
+      regexEl.addEventListener('change', e => fr.regex = e.target.checked);
+
+      removeBtn.addEventListener('click', () => {
+        action.findReplace.splice(idx, 1);
+        renderFindReplace();
+      });
+    });
+  }
+
+  renderFindReplace();
+
+  addFRBtn.addEventListener('click', () => {
+    if (action.findReplace.length >= 3) return;
+    action.findReplace.push({ find: '', replace: '', regex: false });
+    renderFindReplace();
+  });
+
+  document.getElementById('saveScrape').addEventListener('click', () => {
+    const locators = locatorEditor.getValue();
+    if (!locators || locators.length === 0) {
+      alert("Please provide at least one valid locator.");
+      return;
+    }
+    if (!action.variableName) {
+      alert("Please provide a variable name.");
+      return;
+    }
+    action.locators = locators;
+    onSave(action);
+  });
+  document.getElementById('cancelScrape').addEventListener('click', () => onCancel());
+}
