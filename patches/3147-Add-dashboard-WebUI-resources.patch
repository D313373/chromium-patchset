+    help: 'Right-click element → Inspect → Right-click in DevTools → Copy → Copy XPath'
+  },
+  ID: {
+    label: 'Element ID',
+    placeholder: 'submit-button, user-profile',
+    help: 'The "id" attribute value (without #). Find in DevTools Elements panel.'
+  },
+  NAME: {
+    label: 'Element Name',
+    placeholder: 'username, email, search',
+    help: 'The "name" attribute value. Common in form inputs. Find in DevTools.'
+  },
+  CLASS_NAME: {
+    label: 'Class Name',
+    placeholder: 'btn-primary, nav-item',
+    help: 'Single class name (without .). Find in DevTools class attribute.'
+  },
+  TAG_NAME: {
+    label: 'Tag Name',
+    placeholder: 'button, input, div, a',
+    help: 'HTML tag name. Use when element is unique by tag (e.g., only one <form>).'
+  },
+  LINK_TEXT: {
+    label: 'Link Text (Exact)',
+    placeholder: 'Click Here, Learn More, Sign Up',
+    help: 'Exact text content of a link (<a> tag). Case-sensitive.'
+  },
+  PARTIAL_LINK_TEXT: {
