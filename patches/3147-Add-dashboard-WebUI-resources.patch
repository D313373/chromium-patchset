+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCRIPT_CONTEXT_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCRIPT_CONTEXT_H_
+
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "base/values.h"
+#include "base/memory/raw_ptr.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/common/referrer.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace dashboard {
+
+// Tracks the WebContents associated with a script execution, including popups.
+class ScriptContext {
+ public:
+  ScriptContext(const std::string& script_id, content::WebContents* main_contents);
+  ~ScriptContext();
+
+  ScriptContext(const ScriptContext&) = delete;
+  ScriptContext& operator=(const ScriptContext&) = delete;
+  base::Value::Dict* mutable_script_data();
+
+  const std::string& script_id() const { return script_id_; }
+
+  // Primary WebContents the script started in.
+  content::WebContents* main_web_contents() const { return main_web_contents_; }
+
+  // Current target WebContents actions should run against.
+  content::WebContents* current_target() const { return current_target_; }
+  void SwitchToTarget(content::WebContents* target);
+
+  // Popup management -------------------------------------------------------
+  void RegisterPopup(content::WebContents* popup);
+  void CloseAllPopups();
+  bool ContainsWebContents(content::WebContents* contents) const;
+
+  const std::vector<content::WebContents*>& popups() const { return popups_; }
+
+  const std::string& current_url() const { return current_url_; }
+  void set_current_url(const std::string& url) { current_url_ = url; }
+
+  bool is_loaded() const { return is_loaded_; }
+  void set_is_loaded(bool loaded) { is_loaded_ = loaded; }
+    // Attempt to pre-inject automation id into the given RenderFrameHost.
+    // This is a no-op placeholder by default; a real injection can be implemented
+    // later. Declaration added to satisfy references from .cc.
+
+    
+  void OnNavigationFinished(content::WebContents* source,
+                            content::NavigationHandle* navigation);
+  void OnWebContentsDestroyed(content::WebContents* contents);
+  void OnPopupOpened(content::WebContents* new_contents);
+
+ private:
+  class Observer : public content::WebContentsObserver {
+   public:
+    Observer(content::WebContents* contents, ScriptContext* owner);
+    ~Observer() override;
+
+    // content::WebContentsObserver:
+    void DidFinishNavigation(content::NavigationHandle* navigation) override;
+    void WebContentsDestroyed() override;
+    void DidOpenRequestedURL(content::WebContents* new_contents,
+                             content::RenderFrameHost* source_render_frame_host,
+                             const GURL& url,
+                             const content::Referrer& referrer,
+                             WindowOpenDisposition disposition,
+                             ui::PageTransition transition,
+                             bool started_from_context_menu,
+                             bool renderer_initiated) override;
+
+   private:
+    raw_ptr<ScriptContext, DanglingUntriaged> owner_;
+  };
+
+  void TryPreInjectAutomationId(content::RenderFrameHost* rfh);
+  void AttachObserver(content::WebContents* contents);
+  void DetachObserver(content::WebContents* contents);
+  void EnsurePrimaryTarget();
+
+  std::string script_id_;
+  base::raw_ptr<content::WebContents> main_web_contents_ = nullptr;
+  base::raw_ptr<content::WebContents> current_target_ = nullptr;
+  std::vector<content::WebContents*> popups_;
+  std::unordered_map<content::WebContents*, std::unique_ptr<Observer>> observers_;
+  std::string current_url_;
+  bool is_loaded_ = false;
+  base::Value::Dict script_data_;
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCRIPT_CONTEXT_H_
diff --git a/chrome/browser/ui/webui/dashboard/script_context_manager.cc b/chrome/browser/ui/webui/dashboard/script_context_manager.cc
