diff --git a/chrome/browser/ui/webui/dashboard/actions/wait_action.cc b/chrome/browser/ui/webui/dashboard/actions/wait_action.cc
new file mode 100644
index 0000000000000000000000000000000000000000..0cbdd8dc5e2081920d87794e5ca90cff985f422f
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/wait_action.cc
@@ -0,0 +1,171 @@
+#include "chrome/browser/ui/webui/dashboard/actions/wait_action.h"
+
+#include "base/logging.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.h"
+#include "chrome/browser/ui/webui/dashboard/actions/locator_resolver.h"
+#include "chrome/browser/ui/webui/dashboard/debug_config.h"
+
+WaitAction::WaitAction(Profile* profile) : dashboard::actions::Action(profile) {}
+WaitAction::~WaitAction() = default;
+
+bool WaitAction::SetParams(const base::Value::Dict& params) {
+  // Be flexible: support {seconds}, {waitType:'time', time}, {duration_ms}, etc.
+  const std::string* waitType = params.FindString("waitType");
+  std::optional<int> time_val = params.FindInt("time");
+  std::optional<int> duration_ms_val = params.FindInt("duration_ms");
+  std::optional<int> milliseconds_val = params.FindInt("milliseconds");
+  std::optional<int> seconds = params.FindInt("seconds");
+
+  LOG(INFO) << "[WaitAction::SetParams] waitType=" << (waitType ? *waitType : "null")
+            << " time=" << (time_val.has_value() ? std::to_string(*time_val) : "null")
+            << " duration_ms=" << (duration_ms_val.has_value() ? std::to_string(*duration_ms_val) : "null")
+            << " seconds=" << (seconds.has_value() ? std::to_string(*seconds) : "null");
+
+  // Priority: time > duration_ms > milliseconds > seconds (prefer non-zero values)
+  // Check for non-zero time first (from UI)
+  if (time_val.has_value() && *time_val > 0) {
+    wait_type_ = "time";
+    time_ms_ = *time_val;
+    random_delay_ = params.FindBool("randomDelay").value_or(false);
+    LOG(INFO) << "[WaitAction::SetParams] Using time: time_ms_=" << time_ms_;
+    return true;
+  }
+
+  // Check for non-zero duration_ms (legacy)
+  if (duration_ms_val.has_value() && *duration_ms_val > 0) {
+    wait_type_ = "time";
+    time_ms_ = *duration_ms_val;
+    random_delay_ = params.FindBool("randomDelay").value_or(false);
+    LOG(INFO) << "[WaitAction::SetParams] Using duration_ms: time_ms_=" << time_ms_;
+    return true;
+  }
+
+  // Check for non-zero milliseconds
+  if (milliseconds_val.has_value() && *milliseconds_val > 0) {
+    wait_type_ = "time";
+    time_ms_ = *milliseconds_val;
+    random_delay_ = params.FindBool("randomDelay").value_or(false);
+    LOG(INFO) << "[WaitAction::SetParams] Using milliseconds: time_ms_=" << time_ms_;
+    return true;
+  }
+
+  // Check for non-zero seconds (UI fallback)
+  if (seconds.has_value() && *seconds > 0) {
+    wait_type_ = "time";
+    time_ms_ = *seconds * 1000;  // Convert seconds to milliseconds
+    random_delay_ = params.FindBool("randomDelay").value_or(false);
+    LOG(INFO) << "[WaitAction::SetParams] Using seconds: time_ms_=" << time_ms_;
+    SetSerializedAction("wait", params.Clone());
+    return true;
+  }
+
+  // If explicit waitType missing, infer from available keys
+  std::string inferred;
+  if (!waitType) {
+    if (params.FindInt("time").has_value() || params.FindInt("duration_ms").has_value() || params.FindInt("milliseconds").has_value()) {
+      inferred = "time";
+    } else if (params.FindList("locators")) {
+      inferred = "element";
+    }
+    if (!inferred.empty()) waitType = &inferred;
+  }
+
+  if (!waitType) {
+    // Default to 1s time-based wait rather than failing
+    wait_type_ = "time";
+    time_ms_ = 1000;
+    random_delay_ = params.FindBool("randomDelay").value_or(false);
+    LOG(INFO) << "[WaitAction::SetParams] No waitType, defaulting to 1s";
+    SetSerializedAction("wait", params.Clone());
+    return true;
+  }
+
+  wait_type_ = *waitType;
+  LOG(INFO) << "[WaitAction::SetParams] wait_type_=" << wait_type_;
+
+  if (wait_type_ == "time") {
+    // Accept multiple key names for milliseconds
+    time_ms_ = params.FindInt("time").value_or(
+        params.FindInt("duration_ms").value_or(
+            params.FindInt("milliseconds").value_or(1000)));
+    LOG(INFO) << "[WaitAction::SetParams] Time-based wait: time_ms_=" << time_ms_;
+  } else if (wait_type_ == "element") {
+    const base::Value::List* locatorsList = params.FindList("locators");
+    if (!locatorsList) {
+      // Treat as no-op 1s wait rather than hard-fail to keep scripts running
+      wait_type_ = "time";
+      time_ms_ = 1000;
+      random_delay_ = params.FindBool("randomDelay").value_or(false);
+      LOG(INFO) << "[WaitAction::SetParams] No locators, defaulting to 1s";
+      return true;
+    }
+    locators_ = dashboard::ConvertLocators(*locatorsList);
+    // Accept alternate timeout keys
+    timeout_ms_ = params.FindInt("timeout").value_or(
+        params.FindInt("timeoutMs").value_or(5000));
+    LOG(INFO) << "[WaitAction::SetParams] Element-based wait: timeout_ms_=" << timeout_ms_;
+  } else {
+    // Unknown type -> default to 1s
+    wait_type_ = "time";
+    time_ms_ = 1000;
+    LOG(INFO) << "[WaitAction::SetParams] Unknown type, defaulting to 1s";
+  }
+
+  random_delay_ = params.FindBool("randomDelay").value_or(false);
+  SetSerializedAction("wait", params.Clone());
+  return true;
+}
+
+void WaitAction::Execute(content::WebContents* web_contents,
+                         Callback callback) {
+  LOG(INFO) << "[WaitAction::Execute] type='" << wait_type_ << "' time_ms_=" << time_ms_;
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "WaitAction: type='" << wait_type_ << "'";
+  }
+  if (wait_type_ == "time") {
+    LOG(INFO) << "[WaitAction::Execute] Posting delayed task for " << time_ms_ << "ms";
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "WaitAction: sleeping " << time_ms_ << "ms";
+    }
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(std::move(callback), true, ""),
+        base::Milliseconds(time_ms_));
+    return;
+  }
+
+  if (wait_type_ == "element") {
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(INFO) << "[WaitAction] Waiting for element readiness (timeout=" << timeout_ms_ << "ms)";
+    }
+    checker_ = std::make_unique<ElementReadinessChecker>(web_contents);
+    checker_->WaitForElementReadyAsync(
+        locators_,
+        dashboard::SearchScope::kAll,
+        timeout_ms_,
+        base::BindOnce(&WaitAction::OnElementReady,
+                       weak_ptr_factory_.GetWeakPtr(),
+                       std::move(callback)));
+    return;
+  }
+
+  // Default to failure if type is unknown
+  LOG(ERROR) << "[WaitAction] Invalid wait type";
+  std::move(callback).Run(false, "Wait condition failed");
+}
+
+void WaitAction::OnElementReady(Callback callback,
+                                bool ready,
+                                const dashboard::ResolvedElement& element,
+                                const std::string& error) {
+  checker_.reset();
+
+  if (!ready) {
+    if (dashboard::IsVerboseLoggingEnabled()) {
+      LOG(ERROR) << "[WaitAction] Element not ready: " << error;
+    }
+  }
+
+  std::move(callback).Run(ready, ready ? "" : ("Wait failed: " + error));
+}
