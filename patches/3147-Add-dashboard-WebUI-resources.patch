+// static
+void RecorderController::SetActive(RecorderController* rc) {
+  g_active_recorder = rc;
+}
+
+void RecorderController::Start(BrowserView* browser_view) {
+  StartPassiveMode(browser_view);
+}
+
+void RecorderController::Stop() {
+  StopPassiveMode();
+}
+void RecorderController::CreateOverlay(BrowserView* browser_view) {
+  // If an overlay already exists, just reshow/position it instead of
+  // creating a second widget that stacks on top of the first.
+  if (overlay_widget_ && overlay_web_view_) {
+    overlay_widget_->ShowInactive();
+    PositionOverlayNearTopRight(
+        browser_view
+            ? browser_view
+            : BrowserView::GetBrowserViewForBrowser(
+                  GetLastActiveBrowserWindowInterfaceWithAnyProfile()));
+    return;
+  }
+
+  if (!browser_view) {
+    // Fall back to last active browser view so calls from overlay-only mode
+    // (or agent console) still succeed.
+    if (BrowserWindowInterface* browser =
+            GetLastActiveBrowserWindowInterfaceWithAnyProfile()) {
+      browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+    }
+  }
+  if (!browser_view) {
+    LOG(ERROR) << "[Recorder] CreateOverlay: no BrowserView";
+    return;
+  }
+  views::Widget::InitParams params(views::Widget::InitParams::WIDGET_OWNS_NATIVE_WIDGET,
+                                   views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.accept_events = true;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.z_order = ui::ZOrderLevel::kFloatingWindow;
+  params.name = "SimulachromeRecorderOverlay";
+  params.SetParent(browser_view->GetWidget());
+
+  auto* widget = new views::Widget;
+  widget->Init(std::move(params));
+
+  // WebView hosts chrome://dashboard/overlay.html?overlay=1; dedicated overlay
+  // entrypoint avoids rendering the full dashboard UI in this widget.
+  auto* profile = browser_view->GetProfile();
+  auto* web_view = widget->SetContentsView(std::make_unique<views::WebView>(profile));
+  overlay_web_view_ = web_view;
+  overlay_web_view_->LoadInitialURL(GURL("chrome://dashboard/overlay.html?overlay=1"));
+  // Make the web contents background fully transparent so the widget
+  // doesn't show a white gutter behind our overlay card.
+  if (overlay_web_view_->GetWebContents())
+    overlay_web_view_->GetWebContents()->SetPageBaseBackgroundColor(SK_ColorTRANSPARENT);
+  // Also ensure the widget's layer does not fill opaquely.
+  if (overlay_widget_ && overlay_widget_->GetLayer())
+    overlay_widget_->GetLayer()->SetFillsBoundsOpaquely(false);
+
+  // Size/position relative to BrowserView.
+  widget->SetSize(gfx::Size(kOverlayWidth, kOverlayHeight));
+  overlay_widget_ = widget;
+  LOG(INFO) << "[Recorder] CreateOverlay: widget=" << overlay_widget_ << ", web_view=" << overlay_web_view_;
+  PositionOverlayNearTopRight(browser_view);
+}
+
+void RecorderController::DestroyOverlay() {
+  LOG(INFO) << "[Recorder] DestroyOverlay: widget=" << overlay_widget_ << ", web_view=" << overlay_web_view_;
+  if (overlay_widget_) {
+    overlay_widget_->CloseNow();
+    overlay_widget_ = nullptr;
+    overlay_web_view_ = nullptr;
+  }
+}
+
+void RecorderController::CloseOverlay() {
+  // Hide and destroy overlay, and clear the active pointer.
+  LOG(INFO) << "[Recorder] CloseOverlay called";
+  if (overlay_widget_)
+    overlay_widget_->Hide();
+  DestroyOverlay();
+}
+
+void RecorderController::UpdateOverlayWithPayload(const std::string& json_payload) {
+  if (!overlay_web_view_)
+    return;
+  content::RenderFrameHost* rf = overlay_web_view_->GetWebContents()->GetPrimaryMainFrame();
+  if (!rf)
+    return;
+  std::string escaped;
+  base::EscapeJSONString(json_payload, /*put_in_quotes=*/true, &escaped);
+  std::string js = base::StrCat({
+      "try{ if(window.onRecorderUpdate){",
+      "const p = JSON.parse(", escaped, ");",
+      "window.onRecorderUpdate(p.type, p.detail);} }catch(e){console.error(e)};"
+  });
+  rf->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
+}
+
+
+void RecorderController::StartPassiveMode(BrowserView* browser_view,
+                                          bool skip_overlay_creation) {
+  if (is_recording_) {
+
+    LOG(INFO) << "[Recorder] StartPassiveMode ignored: already recording";
+    return;
+  }
+  LOG(INFO) << "[Recorder] Passive recording mode ON";
+  recorded_actions_.clear();
+
+  // 1. Create or show overlay if not already present
+  if (!overlay_widget_ && !skip_overlay_creation)
+    CreateOverlay(browser_view);
+  if (overlay_widget_) {
+    overlay_widget_->ShowInactive();
+  }
+
+  // 2. Attach to the active tab, observe it, and enable DevTools domains
+  AttachToActiveTab(browser_view);
+  if (target_web_contents_)
+    Observe(target_web_contents_);
+
+  // 3. Capture initial site map snapshot
+  RequestPageMapSnapshot(
+      "initial",
+      base::BindOnce(&RecorderController::OnInitialPageMapReady,
+                     base::Unretained(this)));
+
+  is_recording_ = true;
+  SetActive(this);
+  AttachInputObserver();
+}
+
+void RecorderController::OnInitialPageMapReady(base::Value::Dict pagemap) {
+  // Build or reset globalSiteMap in JS overlay
+  base::Value::Dict init;
+  init.Set("type", "initialize_global_site_map");
+  init.Set("detail", base::Value(pagemap.Clone()));
+
+  std::string json;
+  base::JSONWriter::Write(init, &json);
+  std::string escaped;
+  base::EscapeJSONString(json, /*put_in_quotes=*/true, &escaped);
+
+  std::string js = base::StrCat({
+      "try{ if(window.initializeGlobalSiteMap){",
+      "window.initializeGlobalSiteMap(JSON.parse(", escaped, "));",
+      "} }catch(e){console.error(e)};"
+  });
+
+  if (overlay_web_view_) {
+    content::RenderFrameHost* rf = overlay_web_view_->GetWebContents()->GetPrimaryMainFrame();
+    if (rf)
+      rf->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
+  }
+
+  LOG(INFO) << "[Recorder] Initialized globalSiteMap";
+  global_site_map_initialized_ = true;
+}
+
+void RecorderController::StopPassiveMode() {
+  if (!is_recording_) return;
+
+  LOG(INFO) << "[Recorder] Passive recording mode OFF";
+  FlushPendingTypeBuffer();
+  is_recording_ = false;
+  DashboardUIMessageHandler::NotifyRecordingStopped();
+  DetachInputObserver();
+  CloseOverlay();
+}
+
+void RecorderController::ShowOverlayOnly(BrowserView* browser_view) {
+  // Ensure overlay exists and is visible; do not change recording state.
+  if (!overlay_widget_)
+    CreateOverlay(browser_view);
+  if (overlay_widget_)
+    overlay_widget_->ShowInactive();
+  // Ask the overlay DOM to clear hidden state if present.
+  if (overlay_web_view_) {
+    std::string js =
+        "try{var r=document.getElementById('overlay-root');"
+        "if(r){r.style.opacity='1.0';r.style.pointerEvents='auto';r.dataset.hidden='0';}}catch(e){}";
+    if (auto* rf = overlay_web_view_->GetWebContents()->GetPrimaryMainFrame())
+      rf->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
+  }
+  overlay_soft_hidden_ = false;
+
+  // In overlay-only mode, ensure we are attached to the active tab so that
+  // PageMap capture and JS probes work even before recording starts.
+  if (!target_web_contents_ || !agent_host_ || !devtools_client_) {
+    AttachToActiveTab(browser_view);
+    if (target_web_contents_)
+      Observe(target_web_contents_);
+  }
+  // Kick an initial snapshot so the PageMap tab isn't empty on first show.
+  RequestPageMapSnapshot("overlay_show", base::BindOnce(
+      [](base::WeakPtr<RecorderController> self, base::Value::Dict pagemap){
+        if (!self) return;
+        self->DispatchPageMapResult(std::move(pagemap));
+      }, weak_factory_.GetWeakPtr()));
+}
+
+void RecorderController::HideOverlayOnly() {
+  if (!overlay_widget_ || !overlay_web_view_)
+    return;
+  // Hide the native widget so it no longer intercepts clicks over the page.
+  overlay_widget_->Hide();
+  std::string js =
+      "try{var r=document.getElementById('overlay-root');"
+      "if(r){r.style.opacity='0.0';r.style.pointerEvents='none';r.dataset.hidden='1';}}catch(e){}";
+  if (auto* rf = overlay_web_view_->GetWebContents()->GetPrimaryMainFrame())
+    rf->ExecuteJavaScript(base::UTF8ToUTF16(js), base::NullCallback());
+  overlay_soft_hidden_ = true;
+}
+
+void RecorderController::ToggleOverlayVisibility(BrowserView* browser_view) {
+  if (!overlay_widget_ || !overlay_web_view_) {
+    ShowOverlayOnly(browser_view);
+    return;
+  }
+  if (overlay_soft_hidden_) {
+    ShowOverlayOnly(browser_view);
+  } else {
+    HideOverlayOnly();
+  }
+}
+
+void RecorderController::CapturePageMap(PageMapCallback cb) {
+  // Public shim used by WebUI to capture a snapshot on demand.
+  // Lazily attach to the currently active tab if we are not already bound to
+  // a WebContents / DevTools target, so PageMap capture works even when the
+  // recorder was never put into full recording mode.
+  if (!target_web_contents_ || !agent_host_ || !devtools_client_) {
+    if (BrowserWindowInterface* browser =
+            GetLastActiveBrowserWindowInterfaceWithAnyProfile()) {
+      BrowserView* bv = BrowserView::GetBrowserViewForBrowser(browser);
+      if (bv) {
+        AttachToActiveTab(bv);
+        if (target_web_contents_)
+          Observe(target_web_contents_);
+      }
+    }
+  }
+  RequestPageMapSnapshot("ui_capture", std::move(cb));
+}
+void RecorderController::RequestPageMapSnapshot(const std::string& reason,
+                                                PageMapCallback cb) {
+  if (cb)
+    pending_page_map_callbacks_.push_back(std::move(cb));
+
+  if (!agent_host_ || !devtools_client_ || !target_web_contents_) {
+    if (!pending_page_map_callbacks_.empty())
+      HandlePageMapFailure("not_attached");
+    return;
+  }
+
+  if (page_map_capture_in_progress_)
+    return;
+
+  page_map_capture_reason_ = reason;
+  StartPageMapCapture();
+}
+
+// ... (rest of the code remains the same)
+
+void RecorderController::DispatchPageMapResult(
+    base::Value::Dict raw_snapshot) {
+  // Fast-path: if the snapshot already has a frames array (e.g. from renderer
+  // AgentStateSnapshot or DevTools JSON), reuse it and just normalize
+  // metadata/timestamp.
+  if (raw_snapshot.FindList("frames") && !raw_snapshot.FindList("frames")->empty() &&
+      !raw_snapshot.FindList("elements")) {
+    // Ensure timestamp.
+    if (!raw_snapshot.Find("timestamp")) {
+      raw_snapshot.Set(
+          "timestamp",
+          static_cast<double>(
+              base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    }
+
+    // Ensure metadata with interactive counts.
+    base::Value::Dict* meta = raw_snapshot.FindDict("metadata");
+    if (!meta) {
+      raw_snapshot.Set("metadata", base::Value::Dict());
+      meta = raw_snapshot.FindDict("metadata");
+    }
+    int element_count = 0;
+    int shadow_count = 0;
+    if (const base::Value::List* frames = raw_snapshot.FindList("frames")) {
+      for (const auto& f : *frames) {
+        if (!f.is_dict())
+          continue;
+        const base::Value::Dict& fd = f.GetDict();
+        if (const base::Value::List* els = fd.FindList("elements"))
+          element_count += static_cast<int>(els->size());
+        if (const base::Value::List* shadows = fd.FindList("shadowRoots")) {
+          for (const auto& sh : *shadows) {
+            if (!sh.is_dict())
+              continue;
+            const base::Value::Dict& sd = sh.GetDict();
+            if (const base::Value::List* sh_els = sd.FindList("elements")) {
+              int sz = static_cast<int>(sh_els->size());
+              element_count += sz;
+              shadow_count += sz;
+            }
+          }
+        }
+      }
+    }
+    meta->Set("interactiveCount", element_count);
+    meta->Set("shadowDomElementCount", shadow_count);
+
+    StoreAutoCapturedPageMap(raw_snapshot);
+    ResolvePageMapCallbacks(raw_snapshot);
+    ResetPageMapState();
+    return;
+  }
+
+  dashboard::PageMapExtractor extractor;
+
+  if (const std::string* url = raw_snapshot.FindString("url"))
+    extractor.set_url(GURL(*url));
+
+  if (auto ts_double = raw_snapshot.FindDouble("timestamp")) {
+    extractor.set_timestamp_ms(static_cast<int64_t>(*ts_double));
+  } else if (auto ts_int = raw_snapshot.FindInt("timestamp")) {
+    extractor.set_timestamp_ms(static_cast<int64_t>(*ts_int));
+  }
+
+  if (const std::string* focused =
+          raw_snapshot.FindString("focusedElementId")) {
+    extractor.set_focused_element_id(*focused);
+  }
+
+  if (const base::Value::List* elements = raw_snapshot.FindList("elements")) {
+    for (const auto& element_value : *elements) {
+      if (!element_value.is_dict())
+        continue;
+      const base::Value::Dict& elem_dict = element_value.GetDict();
+
+      dashboard::PageElementSnapshot snapshot;
+      if (const std::string* id = elem_dict.FindString("elementId"))
+        snapshot.element_id = *id;
+      if (const std::string* frame_id = elem_dict.FindString("frameId"))
+        snapshot.frame_id = *frame_id;
+      if (const std::string* tag = elem_dict.FindString("tag"))
+        snapshot.tag = *tag;
+      if (const std::string* role = elem_dict.FindString("role"))
+        snapshot.role = *role;
+      if (const std::string* type = elem_dict.FindString("type"))
+        snapshot.type = *type;
+      if (const std::string* text = elem_dict.FindString("text"))
+        snapshot.text = *text;
+      if (const std::string* acc = elem_dict.FindString("accessibilityName"))
+        snapshot.accessibility_name = *acc;
+      if (const std::string* css = elem_dict.FindString("cssSelector"))
+        snapshot.css_selector = *css;
+      if (const std::string* xpath = elem_dict.FindString("xpath"))
+        snapshot.xpath = *xpath;
+      if (const std::string* shadow_chain =
+              elem_dict.FindString("shadowChainSelector"))
+        snapshot.shadow_chain_selector = *shadow_chain;
+      if (const std::string* resource = elem_dict.FindString("resourcePath"))
+        snapshot.resource_path = *resource;
+      snapshot.in_shadow_dom = MaybeBool(elem_dict, "inShadowDom");
+      if (const std::string* shadow_host =
+              elem_dict.FindString("shadowHostSelector"))
+        snapshot.shadow_host_selector = *shadow_host;
+      snapshot.clickable = MaybeBool(elem_dict, "clickable");
+      snapshot.focusable = MaybeBool(elem_dict, "focusable");
+
+      if (const base::Value::Dict* bounds = elem_dict.FindDict("bounds")) {
+        float x = MaybeFloat(*bounds, "x");
+        float y = MaybeFloat(*bounds, "y");
+        float w = MaybeFloat(*bounds, "w");
+        float h = MaybeFloat(*bounds, "h");
+        snapshot.bounds = gfx::RectF(x, y, w, h);
+      }
+
+      extractor.AddElement(std::move(snapshot));
+    }
+  }
+
+  base::Value::Dict pagemap = extractor.BuildPageMap();
+  StoreAutoCapturedPageMap(pagemap);
+//     if (global_site_map_snapshots_.size() > 10) {
+//     PersistOldSnapshots();
+//     global_site_map_snapshots_.erase(global_site_map_snapshots_.begin(),
+//                                      global_site_map_snapshots_.end() - 1);
+// }
+
+
+  ResolvePageMapCallbacks(pagemap);
+  ResetPageMapState();
+}
+
+void RecorderController::StartPageMapCapture() {
+  page_map_capture_in_progress_ = true;
+  LOG(INFO) << "[Recorder] PageMap capture reason=" << page_map_capture_reason_;
+  content::WebContents* wc = target_web_contents_;
+  if (!wc) {
+    HandlePageMapFailure("no_web_contents");
+    return;
+  }
+
+  // Prefer renderer-side accessibility snapshot via StealthyElementResolver to
+  // avoid DevTools Accessibility domain flakiness. If unavailable, fall back to
+  // the DevTools/JS-based extractor.
+  content::RenderFrameHost* rfh = wc->GetPrimaryMainFrame();
+  if (rfh) {
+    mojo::AssociatedRemote<dashboard::mojom::StealthyElementResolver> resolver;
+    rfh->GetRemoteAssociatedInterfaces()->GetInterface(&resolver);
+    if (resolver.is_bound()) {
+      resolver->CollectAllRelevantElements(
+          dashboard::mojom::SearchScope::kInteractiveOnly,
+          base::BindOnce(&RecorderController::OnRendererElementsCollected,
+                         weak_factory_.GetWeakPtr()));
+      return;
+    }
+  }
+
+  StartPageMapCaptureDevTools(wc);
+}
+
+void RecorderController::OnPageMapStreamChunk(const base::Value::Dict& pagemap) {
+  base::Value::Dict payload;
+  payload.Set("type", "pagemap");
+  payload.Set("detail", base::Value(pagemap.Clone()));
+  std::string json;
+  base::JSONWriter::Write(payload, &json);
+  UpdateOverlayWithPayload(json);
+  DashboardUIMessageHandler::BroadcastAiChunk("pagemap_stream", json);
+}
+
+void RecorderController::OnPageMapExtractionFinished(base::Value::Dict pagemap) {
+  StoreAutoCapturedPageMap(pagemap);
+  ResolvePageMapCallbacks(pagemap);
+  DashboardUIMessageHandler::BroadcastAiDone("pagemap_stream", true, "");
+  ResetPageMapState();
+}
+
+void RecorderController::OnRendererElementsCollected(
+    std::vector<dashboard::mojom::ResolvedElementInfoPtr> elements) {
+  page_map_capture_in_progress_ = false;
+  LOG(INFO) << "[Recorder] OnRendererElementsCollected count="
+            << elements.size();
+
+  if (elements.empty()) {
+    if (target_web_contents_)
+      StartPageMapCaptureDevTools(target_web_contents_);
+    else
+      HandlePageMapFailure("renderer_empty");
+    return;
+  }
+
+  dashboard::PageMapExtractor extractor;
+  extractor.set_url(current_url_.empty() ? GURL() : GURL(current_url_));
+  extractor.set_timestamp_ms(
+      base::Time::Now().InMillisecondsSinceUnixEpoch());
+
+  for (auto& info : elements) {
+    if (!info)
+      continue;
+    dashboard::PageElementSnapshot snap;
+    snap.element_id = info->node_id ? base::NumberToString(info->node_id) : "";
+    snap.frame_id = info->frame_id;
+    snap.tag = info->tag;
+    snap.text = info->text;
+    snap.accessibility_name =
+        !info->accessibility_name.empty() ? info->accessibility_name
+                                          : info->aria_label;
+    snap.role = info->role;
+    snap.css_selector = info->css;
+    snap.xpath = info->xpath;
+    snap.locator_bundle = LocatorBundleToList(info->locators);
+    snap.clickable = info->clickable;
+    snap.focusable = info->focusable;
+    snap.disabled = info->is_disabled;
+    snap.bounds = gfx::RectF(info->x, info->y, info->width, info->height);
+    extractor.AddElement(std::move(snap));
+  }
+
+  base::Value::Dict pagemap = extractor.BuildPageMap();
+  DispatchPageMapResult(std::move(pagemap));
+  DashboardUIMessageHandler::BroadcastAiDone("pagemap_stream", true, "");
+}
+
+void RecorderController::OnAXTreeReady(ui::AXTreeUpdate& update) {
+  dashboard::PageMapExtractor extractor;
+  // Traverse nodes and pick interesting ones.
+  auto is_interesting_role = [](ax::mojom::Role role) {
+    using R = ax::mojom::Role;
+    switch (role) {
+      case R::kButton:
+      case R::kLink:
+      case R::kTextField:
+      case R::kCheckBox:
+      case R::kMenuItem:
+      case R::kRadioButton:
+      case R::kListBoxOption:
+      case R::kSwitch:
+        return true;
+      default:
+        return false;
+    }
+  };
+
+  int streamed = 0;
+  bool found_any = false;
+  for (const ui::AXNodeData& node : update.nodes) {
+    if (!is_interesting_role(node.role))
+      continue;
+    dashboard::PageElementSnapshot snap;
+    // Role and name
+    switch (node.role) {
+      case ax::mojom::Role::kButton: snap.role = "button"; break;
+      case ax::mojom::Role::kLink: snap.role = "link"; break;
+      case ax::mojom::Role::kTextField: snap.role = "textfield"; break;
+      case ax::mojom::Role::kCheckBox: snap.role = "checkbox"; break;
+      case ax::mojom::Role::kRadioButton: snap.role = "radio"; break;
+      default: snap.role = "control"; break;
+    }
+    if (node.HasStringAttribute(ax::mojom::StringAttribute::kName))
+      snap.accessibility_name = node.GetStringAttribute(ax::mojom::StringAttribute::kName);
+    // Basic type mapping
+    if (node.role == ax::mojom::Role::kButton) snap.type = "button";
+    if (node.role == ax::mojom::Role::kLink) snap.type = "link";
+    if (node.role == ax::mojom::Role::kTextField) snap.type = "input";
+    // Bounds (in screen coords) may be present in offset container; use relative rect if available
+    gfx::RectF rect;
+    if (node.relative_bounds.bounds.width() > 0 && node.relative_bounds.bounds.height() > 0) {
+      rect = gfx::RectF(node.relative_bounds.bounds);
+    }
+    snap.bounds = rect;
+    // Flags
+    snap.clickable = (node.role == ax::mojom::Role::kButton || node.role == ax::mojom::Role::kLink);
+    snap.focusable = node.HasState(ax::mojom::State::kFocusable);
+
+    // Lightweight locator bundle synthesis so the agent gets something useful
+    // immediately without a round-trip probe.
+    base::Value::List locators;
+    if (!snap.accessibility_name.empty()) {
+      base::Value::Dict loc1; loc1.Set("type", "ACCESSIBILITY_NAME"); loc1.Set("value", snap.accessibility_name);
+      locators.Append(std::move(loc1));
+    }
+    if (!snap.text.empty()) {
+      base::Value::Dict loc2; loc2.Set("type", "TEXT_CONTENT"); loc2.Set("value", snap.text);
+      locators.Append(std::move(loc2));
+    }
+    if (!snap.tag.empty()) {
+      base::Value::Dict loc3; loc3.Set("type", "TAG_NAME"); loc3.Set("value", snap.tag);
+      locators.Append(std::move(loc3));
+    }
+    if (node.role == ax::mojom::Role::kLink && !snap.text.empty()) {
+      base::Value::Dict loc4; loc4.Set("type", "LINK_TEXT"); loc4.Set("value", snap.text);
+      locators.Append(std::move(loc4));
+    }
+    if (!locators.empty()) snap.locator_bundle = std::move(locators);
+
+    extractor.AddElement(std::move(snap));
+    found_any = true;
+    // Periodically stream a partial snapshot to the overlay for responsiveness.
+    if ((++streamed % 150) == 0) {
+      base::Value::Dict partial = extractor.BuildPageMap();
+      base::Value::Dict payload;
+      payload.Set("type", "pagemap");
+      payload.Set("detail", base::Value(partial.Clone()));
+      std::string json;
+      base::JSONWriter::Write(payload, &json);
+      UpdateOverlayWithPayload(json);
+      // Also stream to any open AI consoles as a pagemap stream channel.
+      DashboardUIMessageHandler::BroadcastAiChunk("pagemap_stream", json);
+    }
+  }
+
+  if (!found_any && agent_host_) {
+    // Fallback: quick DOM scan via Runtime.evaluate to surface a minimal map.
+    std::string js = R"( (function(){
+      const sels = 'a,button,input,textarea,select,[role=\"button\"],[role=\"link\"],[onclick]';
+      const arr = [];
+      document.querySelectorAll(sels).forEach(el=>{
+        try{
+          const r = el.getBoundingClientRect();
+          if (!r || r.width<=0 || r.height<=0) return;
+          const role = (el.getAttribute && el.getAttribute('role')) || '';
+          const tag = (el.tagName||'').toLowerCase();
+          const name = (el.getAttribute && el.getAttribute('aria-label')) || '';
+          const txt = (el.innerText||el.value||'').trim();
+          arr.push({tag, role, name, text: txt, x:Math.round(r.left), y:Math.round(r.top), w:Math.round(r.width), h:Math.round(r.height)});
+        }catch(_){ }
+      });
+      return { ok:true, url: location.href, ts: Date.now(), elements: arr };
+    })() )";
+    base::Value::Dict params;
+    params.Set("expression", js);
+    params.Set("includeCommandLineAPI", true);
+    params.Set("returnByValue", true);
+    SendCommandExpectResponse(
+        "Runtime.evaluate", std::move(params),
+        base::BindOnce(
+            [](base::WeakPtr<RecorderController> self, std::string res_json, std::string /*err_json*/){
+              if (!self) return;
+              dashboard::PageMapExtractor ext;
+              std::optional<base::Value> val = ExtractRuntimeValue(res_json);
+              if (val && val->is_dict()) {
+                const base::Value::List* els = val->GetDict().FindList("elements");
+                if (els) {
+                  for (const auto& v : *els) {
+                    if (!v.is_dict()) continue;
+                    const base::Value::Dict& e = v.GetDict();
+                    dashboard::PageElementSnapshot s;
+                    if (const std::string* tag = e.FindString("tag")) s.tag = *tag;
+                    if (const std::string* role = e.FindString("role")) s.role = *role;
+                    if (const std::string* name = e.FindString("name")) s.accessibility_name = *name;
+                    if (const std::string* text = e.FindString("text")) s.text = *text;
+                    int x = e.FindInt("x").value_or(0), y = e.FindInt("y").value_or(0), w = e.FindInt("w").value_or(0), h = e.FindInt("h").value_or(0);
+                    s.bounds = gfx::RectF(x, y, w, h);
+                    s.clickable = true;
+                    // Provide a basic locator bundle
+                    base::Value::List locs;
+                    if (s.accessibility_name.size()) { base::Value::Dict l; l.Set("type","ACCESSIBILITY_NAME"); l.Set("value", s.accessibility_name); locs.Append(std::move(l)); }
+                    if (s.text.size()) { base::Value::Dict l; l.Set("type","TEXT_CONTENT"); l.Set("value", s.text); locs.Append(std::move(l)); }
+                    if (s.tag.size()) { base::Value::Dict l; l.Set("type","TAG_NAME"); l.Set("value", s.tag); locs.Append(std::move(l)); }
+                    if (!locs.empty()) s.locator_bundle = std::move(locs);
+                    ext.AddElement(std::move(s));
+                  }
+                }
+              }
+              base::Value::Dict map = ext.BuildPageMap();
+              self->DispatchPageMapResult(std::move(map));
+              DashboardUIMessageHandler::BroadcastAiDone("pagemap_stream", true, "");
+            },
+            weak_factory_.GetWeakPtr()));
+    return;
+  }
+
+  base::Value::Dict pagemap = extractor.BuildPageMap();
+  DispatchPageMapResult(std::move(pagemap));
+  DashboardUIMessageHandler::BroadcastAiDone("pagemap_stream", true, "");
+}
