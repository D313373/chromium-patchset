+
+      const yInput = document.createElement('smart-input');
+      yInput.style.width = '120px';
+      yInput.setAttribute('type', 'number');
+      yInput.setAttribute('placeholder', 'Y (px)');
+      yInput.setAttribute('title', 'Pixels from the top edge of the viewport (Y axis).');
+      yInput.setAttribute('aria-label', 'Y coordinate in pixels from the top edge');
+
+      const comma = document.createElement('span');
+      comma.textContent = ',';
+      comma.style.cssText = 'font-size:18px;color:#6b7280;align-self:center;';
