+
+  _rerender() {
+    this.locatorsContainer.innerHTML = '';
+    this.locators.forEach((loc, idx) => this._renderLocatorEntry(loc, idx));
+  }
+
+  _notifyChange() {
+    if (typeof this.onChange === 'function') {
