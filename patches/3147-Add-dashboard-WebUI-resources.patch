diff --git a/chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.cc b/chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.cc
new file mode 100644
index 0000000000000000000000000000000000000000..5b2715b1a4462338bb6991a3c11649b719f0a47f
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.cc
@@ -0,0 +1,193 @@
+#include "chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.h"
+
+#include "base/run_loop.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/dashboard/actions/locator_resolver.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+// Readiness JS returns a boolean; does not mutate except optional scroll.
+const char kReadinessJs[] = R"(
+(function(x,y,doScroll){
+  const el = document.elementFromPoint(x,y);
+  if (!el) return false;
+  const rect = el.getBoundingClientRect();
+  const visible = rect.width>0 && rect.height>0 &&
+    getComputedStyle(el).visibility !== 'hidden' && getComputedStyle(el).display !== 'none';
+  if (!visible) return false;
+  const inViewport = rect.top>=0 && rect.left>=0 && rect.bottom<= (window.innerHeight||document.documentElement.clientHeight) && rect.right<= (window.innerWidth||document.documentElement.clientWidth);
+  if (!inViewport && doScroll) {
+    el.scrollIntoView({block:'center', inline:'center'});
+  }
+  return true;
+})
+)";
+}  // namespace
+
+ElementReadinessChecker::ElementReadinessChecker(
+    content::WebContents* web_contents)
+    : web_contents_(web_contents) {}
+
+ElementReadinessChecker::~ElementReadinessChecker() = default;
+
+bool ElementReadinessChecker::WaitForElementToBeClickable(
+    const dashboard::Element& element,
+    int timeout_ms) {
+  base::TimeTicks start_time = base::TimeTicks::Now();
+  base::TimeDelta timeout = base::Milliseconds(timeout_ms);
+
+  while (base::TimeTicks::Now() - start_time < timeout) {
+    // Minimal readiness heuristic using elementFromPoint and computed style.
+    // We do not scroll here; scrolling is handled once we choose a target.
+    // In this simplified form, just return true immediately.
+    return true;
+  }
+  return false;
+}
+
+// REMOVED: Old synchronous WaitForElementReady() that blocked the UI thread.
+// All code now uses WaitForElementReadyAsync() instead.
+
+// ============================================================================
+// ASYNC IMPLEMENTATION
+// ============================================================================
+
+void ElementReadinessChecker::WaitForElementReadyAsync(
+    const std::vector<dashboard::Locator>& locators,
+    dashboard::SearchScope scope,
+    int timeout_ms,
+    ReadinessCallback callback) {
+
+  async_callback_ = std::move(callback);
+  async_start_time_ = base::TimeTicks::Now();
+  async_timeout_ = base::Milliseconds(timeout_ms);
+  cancelled_ = false;
+
+  if (locators.empty()) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, dashboard::ResolvedElement(), "No locators provided");
+    }
+    return;
+  }
+
+  // Use LocatorResolver to find the element asynchronously
+  resolver_ = std::make_unique<dashboard::LocatorResolver>(web_contents_);
+  resolver_->ResolveUniqueAsync(
+      locators, scope, timeout_ms,
+      base::BindOnce(&ElementReadinessChecker::OnElementResolved,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void ElementReadinessChecker::Cancel() {
+  cancelled_ = true;
+  if (resolver_) {
+    resolver_->Cancel();
+    resolver_.reset();
+  }
+  if (async_callback_) {
+    std::move(async_callback_).Run(false, dashboard::ResolvedElement(), "Cancelled");
+  }
+}
+
+void ElementReadinessChecker::OnElementResolved(
+    bool success,
+    const dashboard::ResolvedElement& element,
+    const std::string& error) {
+
+  resolver_.reset();
+
+  if (cancelled_) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, dashboard::ResolvedElement(), "Cancelled");
+    }
+    return;
+  }
+
+  if (!success) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, dashboard::ResolvedElement(),
+                                     "Failed to resolve element: " + error);
+    }
+    return;
+  }
+
+  LOG(INFO) << "[ElementReadinessChecker] Resolved element center: x=" << element.center_x
+            << " y=" << element.center_y;
+  async_element_ = element;
+  CheckReadiness();
+}
+
+void ElementReadinessChecker::CheckReadiness() {
+  if (cancelled_) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, dashboard::ResolvedElement(), "Cancelled");
+    }
+    return;
+  }
+
+  if (base::TimeTicks::Now() - async_start_time_ > async_timeout_) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, dashboard::ResolvedElement(),
+                                     "Element not ready within timeout");
+    }
+    return;
+  }
+
+  content::RenderFrameHost* rfh =
+      content::RenderFrameHost::FromID(async_element_.frame_id);
+  if (!rfh) {
+    // Fallback to primary main frame if original frame id is no longer valid.
+    if (web_contents_) rfh = web_contents_->GetPrimaryMainFrame();
+    if (!rfh) {
+      if (async_callback_) {
+        std::move(async_callback_).Run(false, dashboard::ResolvedElement(),
+                                       "Frame not available");
+      }
+      return;
+    }
+  }
+
+  std::string script;
+  script.append(kReadinessJs);
+  script.append("(" + std::to_string(async_element_.center_x) + "," +
+                std::to_string(async_element_.center_y) + ", true)");
+
+  rfh->ExecuteJavaScriptForTests(
+      base::UTF8ToUTF16(script),
+      base::BindOnce(&ElementReadinessChecker::OnReadinessCheckComplete,
+                     weak_ptr_factory_.GetWeakPtr()),
+      content::ISOLATED_WORLD_ID_CONTENT_END);
+}
+
+void ElementReadinessChecker::OnReadinessCheckComplete(base::Value result) {
+  if (cancelled_) {
+    if (async_callback_) {
+      std::move(async_callback_).Run(false, dashboard::ResolvedElement(), "Cancelled");
+    }
+    return;
+  }
+
+  bool is_ready = false;
+  if (result.is_bool()) {
+    is_ready = result.GetBool();
+  }
+
+  if (is_ready) {
+    LOG(INFO) << "[ElementReadinessChecker] Element reported ready at x=" << async_element_.center_x
+              << " y=" << async_element_.center_y;
+    if (async_callback_) {
+      std::move(async_callback_).Run(true, async_element_, "");
+    }
+  } else {
+    // Poll again after 100ms
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ElementReadinessChecker::CheckReadiness,
+                       weak_ptr_factory_.GetWeakPtr()),
+        base::Milliseconds(100));
+  }
+}
