+/**
+ * Dark Reader Matrix Theme Injector
+ * Injects a cyberpunk Matrix aesthetic into web pages
+ * Simulates Dark Reader extension behavior with green-on-black theme
+ */
+
+(function() {
+  'use strict';
+
+  // Matrix color palette
+  const MATRIX_COLORS = {
+    bg: '#000000',
+    primary: '#00ff00',
+    secondary: '#00cc00',
+    tertiary: '#009900',
+    accent: '#00ff41',
+    shadow: 'rgba(0, 255, 0, 0.3)'
+  };
+
+  /**
+   * Inject the Matrix theme stylesheet
+   */
+  function injectMatrixStylesheet() {
+    // Check if already injected
+    if (document.getElementById('matrix-theme-style')) {
+      return;
+    }
+
+    const style = document.createElement('style');
+    style.id = 'matrix-theme-style';
+    style.textContent = getMatrixCSS();
+    
+    // Inject into document head
+    if (document.head) {
+      document.head.appendChild(style);
+    } else {
+      document.documentElement.appendChild(style);
+    }
+  }
+
+  /**
+   * Get the Matrix theme CSS
+   */
+  function getMatrixCSS() {
+    return `
+      :root {
+        --matrix-bg: ${MATRIX_COLORS.bg};
+        --matrix-primary: ${MATRIX_COLORS.primary};
+        --matrix-secondary: ${MATRIX_COLORS.secondary};
+        --matrix-tertiary: ${MATRIX_COLORS.tertiary};
+        --matrix-accent: ${MATRIX_COLORS.accent};
+        --matrix-shadow: ${MATRIX_COLORS.shadow};
+      }
+
+      html, body {
+        background-color: var(--matrix-bg) !important;
+        color: var(--matrix-primary) !important;
+        text-shadow: 0 0 10px var(--matrix-shadow) !important;
+      }
+
+      p, span, div, a, h1, h2, h3, h4, h5, h6, li, td, th {
+        color: var(--matrix-primary) !important;
+        text-shadow: 0 0 5px var(--matrix-shadow) !important;
+      }
+
+      a {
+        color: var(--matrix-accent) !important;
+        text-decoration: underline !important;
+      }
+
+      a:visited {
+        color: var(--matrix-secondary) !important;
+      }
+
+      button, input[type="button"], input[type="submit"] {
+        background-color: var(--matrix-tertiary) !important;
+        color: var(--matrix-accent) !important;
+        border: 2px solid var(--matrix-primary) !important;
+        box-shadow: 0 0 10px var(--matrix-shadow) !important;
+      }
+
+      input, textarea, select {
+        background-color: var(--matrix-bg) !important;
+        color: var(--matrix-primary) !important;
+        border: 1px solid var(--matrix-secondary) !important;
+      }
+
+      code, pre {
+        background-color: var(--matrix-bg) !important;
+        color: var(--matrix-accent) !important;
+        border: 1px solid var(--matrix-secondary) !important;
+        font-family: 'Courier New', monospace !important;
+      }
+
+      table {
+        background-color: var(--matrix-bg) !important;
+        border-color: var(--matrix-secondary) !important;
+      }
+
+      th {
+        background-color: var(--matrix-tertiary) !important;
+        color: var(--matrix-accent) !important;
+      }
+
+      ::-webkit-scrollbar {
+        width: 12px;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: var(--matrix-bg);
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background: var(--matrix-secondary);
+        border-radius: 6px;
+      }
+
+      ::selection {
+        background-color: var(--matrix-secondary) !important;
+        color: var(--matrix-bg) !important;
+      }
+
+      body::before {
+        content: '';
+        position: fixed;
+        top: 0;
+        left: 0;
+        width: 100%;
+        height: 100%;
+        background: repeating-linear-gradient(
+          0deg,
+          rgba(0, 255, 0, 0.03),
+          rgba(0, 255, 0, 0.03) 1px,
+          transparent 1px,
+          transparent 2px
+        );
+        pointer-events: none;
+        z-index: 9999;
+      }
+
+      @keyframes matrix-glitch {
+        0% { text-shadow: 0 0 5px var(--matrix-shadow); }
+        50% { text-shadow: 0 0 15px var(--matrix-shadow), 2px 2px 0 var(--matrix-accent); }
+        100% { text-shadow: 0 0 5px var(--matrix-shadow); }
+      }
+
+      a:hover {
+        animation: matrix-glitch 0.3s ease-in-out;
+      }
+
+      h1, h2, h3 {
+        text-shadow: 
+          0 0 10px var(--matrix-shadow),
+          0 0 20px var(--matrix-shadow),
+          0 0 30px var(--matrix-shadow) !important;
+      }
+
+      * {
+        background-image: none !important;
+      }
+
+      body {
+        font-family: 'Courier New', 'Courier', monospace !important;
+        letter-spacing: 0.05em !important;
+      }
+    `;
+  }
+
+  /**
+   * Simulate Dark Reader extension detection
+   * Adds properties that bot detectors look for
+   */
+  function simulateDarkReaderDetection() {
+    // Add Dark Reader global object
+    if (!window.darkReader) {
+      window.darkReader = {
+        isEnabled: true,
+        isReady: true,
+        version: '4.9.68',
+        settings: {
+          brightness: 100,
+          contrast: 100,
+          sepia: 0,
+          grayscale: 0,
+          saturation: 100
+        }
+      };
+    }
+
+    // Add Dark Reader to navigator.plugins (for bot detection)
+    if (navigator.plugins && !Array.from(navigator.plugins).some(p => p.name.includes('Dark Reader'))) {
+      // This would be handled by the extension spoofing system
+    }
+  }
+
+  /**
+   * Initialize Matrix theme injection
+   */
+  function initialize() {
+    // Inject stylesheet
+    injectMatrixStylesheet();
+
+    // Simulate Dark Reader detection
+    simulateDarkReaderDetection();
+
+    // Handle dynamic content
+    observeDOM();
+  }
+
+  /**
+   * Observe DOM changes and reapply theme to new elements
+   */
+  function observeDOM() {
+    const observer = new MutationObserver(function(mutations) {
+      // Reapply theme to new elements if needed
+      // This ensures dynamically loaded content also gets the Matrix theme
+    });
+
+    observer.observe(document.documentElement, {
+      childList: true,
+      subtree: true,
+      attributes: false,
+      characterData: false
+    });
+  }
+
+  // Initialize when DOM is ready
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initialize);
+  } else {
+    initialize();
+  }
+
+  // Also initialize on page load to catch everything
+  window.addEventListener('load', initialize);
+
+})();
+
