diff --git a/chrome/browser/ui/webui/dashboard/actions/action_types.cc b/chrome/browser/ui/webui/dashboard/actions/action_types.cc
new file mode 100644
index 0000000000000000000000000000000000000000..cc51f1241b0e9dc89725e048e2a5914dff382847
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/action_types.cc
@@ -0,0 +1,162 @@
+#include "chrome/browser/ui/webui/dashboard/actions/action_types.h"
+
+namespace dashboard {
+
+// By defining these out-of-line, we adhere to the Chromium style guide for
+// complex structs (those with members like std::string or std::vector).
+
+Locator::Locator() = default;
+Locator::~Locator() = default;
+Locator::Locator(const Locator& other) = default;
+Locator& Locator::operator=(const Locator& other) = default;
+Locator::Locator(Locator&& other) noexcept = default;
+Locator& Locator::operator=(Locator&& other) noexcept = default;
+
+FindReplace::FindReplace() = default;
+FindReplace::~FindReplace() = default;
+FindReplace::FindReplace(const FindReplace& other) = default;
+FindReplace& FindReplace::operator=(const FindReplace& other) = default;
+FindReplace::FindReplace(FindReplace&& other) noexcept = default;
+FindReplace& FindReplace::operator=(FindReplace&& other) noexcept = default;
+
+ScrapeTableField::ScrapeTableField() = default;
+ScrapeTableField::~ScrapeTableField() = default;
+ScrapeTableField::ScrapeTableField(const ScrapeTableField& other) = default;
+ScrapeTableField& ScrapeTableField::operator=(
+    const ScrapeTableField& other) = default;
+ScrapeTableField::ScrapeTableField(ScrapeTableField&& other) noexcept = default;
+ScrapeTableField& ScrapeTableField::operator=(
+    ScrapeTableField&& other) noexcept = default;
+
+LocatorType StringToLocatorType(const std::string& type_str) {
+  // Be forgiving about case and common synonyms coming from UI/legacy importers.
+  std::string t;
+  t.reserve(type_str.size());
+  for (char c : type_str) t.push_back(static_cast<char>(::toupper(static_cast<unsigned char>(c))));
+
+  // Direct exact matches
+  if (t == "ID") return LocatorType::ID;
+  if (t == "CSS_SELECTOR") return LocatorType::CSS_SELECTOR;
+  if (t == "NAME") return LocatorType::NAME;
+  if (t == "ACCESSIBILITY_NAME") return LocatorType::ACCESSIBILITY_NAME;
+  if (t == "CLASS_NAME") return LocatorType::CLASS_NAME;
+  if (t == "JS_EVAL") return LocatorType::JS_EVAL;
+  if (t == "SHADOW_DOM") return LocatorType::SHADOW_DOM;
+  if (t == "LINK_TEXT") return LocatorType::LINK_TEXT;
+  if (t == "PARTIAL_LINK_TEXT") return LocatorType::PARTIAL_LINK_TEXT;
+  if (t == "TAG_NAME") return LocatorType::TAG_NAME;
+  if (t == "XPATH") return LocatorType::XPATH;
+  if (t == "TEXT_CONTENT") return LocatorType::TEXT_CONTENT;
+  if (t == "VISUAL_COORDS") return LocatorType::VISUAL_COORDS;
+  if (t == "VISUAL_AI") return LocatorType::VISUAL_AI;
+  if (t == "FRAME_ID") return LocatorType::FRAME_ID;
+  if (t == "RESOURCE_TREE") return LocatorType::RESOURCE_TREE;
+
+  // Common synonyms
+  if (t == "CSS" || t == "SELECTOR" || t == "CSS-SELECTOR") return LocatorType::CSS_SELECTOR;
+  if (t == "CLASS" || t == "CLASS-NAME") return LocatorType::CLASS_NAME;
+  if (t == "A11Y" || t == "ARIA" || t == "ACCESSIBILITY" || t == "ACCESSIBILITY-NAME")
+    return LocatorType::ACCESSIBILITY_NAME;
+  if (t == "LINK" || t == "LINKTEXT" || t == "LINK-TEXT") return LocatorType::LINK_TEXT;
+  if (t == "PARTIAL_LINK" || t == "PARTIAL-LINK" || t == "PARTIAL" || t == "PARTIAL_LINKTEXT")
+    return LocatorType::PARTIAL_LINK_TEXT;
+  if (t == "TAG" || t == "TAG-NAME") return LocatorType::TAG_NAME;
+  if (t == "TEXT" || t == "TEXT-CONTENT" || t == "INNER_TEXT" || t == "INNERTEXT")
+    return LocatorType::TEXT_CONTENT;
+  if (t == "JS" || t == "JAVASCRIPT" || t == "JS-EVAL") return LocatorType::JS_EVAL;
+  if (t == "SHADOW" || t == "SHADOW-DOM") return LocatorType::SHADOW_DOM;
+  if (t == "COORDS" || t == "VISUAL-COORDS" || t == "COORDINATES") return LocatorType::VISUAL_COORDS;
+  if (t == "AI" || t == "VISUAL-AI") return LocatorType::VISUAL_AI;
+  if (t == "FRAME" || t == "FRAME-ID" || t == "FRAME_ID") return LocatorType::FRAME_ID;
+  if (t == "RESOURCE" || t == "RESOURCE-TREE" || t == "RESOURCE_TREE") return LocatorType::RESOURCE_TREE;
+
+  // Default to CSS selector to keep prior behavior, but this function now
+  // tolerates lowercase and synonymous values to avoid accidental fallbacks.
+  return LocatorType::CSS_SELECTOR;
+}
+
+std::string LocatorTypeToString(LocatorType type) {
+  switch (type) {
+    case LocatorType::ID:
+      return "ID";
+    case LocatorType::CSS_SELECTOR:
+      return "CSS_SELECTOR";
+    case LocatorType::NAME:
+      return "NAME";
+    case LocatorType::ACCESSIBILITY_NAME:
+      return "ACCESSIBILITY_NAME";
+    case LocatorType::CLASS_NAME:
+      return "CLASS_NAME";
+    case LocatorType::JS_EVAL:
+      return "JS_EVAL";
+    case LocatorType::SHADOW_DOM:
+      return "SHADOW_DOM";
+    case LocatorType::LINK_TEXT:
+      return "LINK_TEXT";
+    case LocatorType::PARTIAL_LINK_TEXT:
+      return "PARTIAL_LINK_TEXT";
+    case LocatorType::TAG_NAME:
+      return "TAG_NAME";
+    case LocatorType::XPATH:
+      return "XPATH";
+    case LocatorType::TEXT_CONTENT:
+      return "TEXT_CONTENT";
+    case LocatorType::VISUAL_COORDS:
+      return "VISUAL_COORDS";
+    case LocatorType::VISUAL_AI:
+      return "VISUAL_AI";
+    case LocatorType::FRAME_ID:
+      return "FRAME_ID";
+    case LocatorType::RESOURCE_TREE:
+      return "RESOURCE_TREE";
+  }
+  return "";
+}
+
+std::vector<Locator> ConvertLocators(const base::Value::List& locators_list) {
+  std::vector<Locator> result;
+  for (const auto& locator_value : locators_list) {
+    if (locator_value.is_dict()) {
+      const base::Value::Dict& locator_dict = locator_value.GetDict();
+      const std::string* type_str = locator_dict.FindString("type");
+      const std::string* value_str = locator_dict.FindString("value");
+      if (type_str && value_str) {
+        Locator locator;
+        locator.type = StringToLocatorType(*type_str);
+        locator.value = *value_str;
+        result.push_back(std::move(locator));
+      }
+    }
+  }
+  return result;
+}
+
+// Converts a Locator struct into a base::Value::Dict for Mojo/JS communication.
+base::Value::Dict LocatorToValue(const Locator& locator) {
+  base::Value::Dict locator_dict;
+  locator_dict.Set("type", LocatorTypeToString(locator.type));
+  locator_dict.Set("value", locator.value);
+  return locator_dict;
+}
+
+// Converts a base::Value::List of find/replace pairs into a vector of structs.
+std::vector<FindReplace> ConvertFindReplace(
+    const base::Value::List& rules_list) {
+  std::vector<FindReplace> result;
+  for (const auto& item : rules_list) {
+    if (item.is_dict()) {
+      const base::Value::Dict& dict = item.GetDict();
+      const std::string* find = dict.FindString("find");
+      const std::string* replace = dict.FindString("replace");
+      if (find && replace) {
+        FindReplace fr;
+        fr.find = *find;
+        fr.replace = *replace;
+        result.push_back(std::move(fr));
+      }
+    }
+  }
+  return result;
+}
+
+}  // namespace dashboard
