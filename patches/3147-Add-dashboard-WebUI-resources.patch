+#ifndef CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCHEDULER_SERVICE_H_
+#define CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCHEDULER_SERVICE_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/webui/dashboard/dashboard.mojom.h"
+
+class Profile;
+
+namespace dashboard {
+
+class Dashboard;
+class ScriptExecutor;
+
+// Configuration for a scheduled script
+struct ScheduleConfig {
+  bool enabled = false;
+  int interval_days = 0;
+  int interval_hours = 0;
+  int interval_minutes = 0;
+  base::Time next_run;
+
+  // Convert to Mojo struct
+  dashboard::mojom::ScheduleConfigPtr ToMojo() const;
+  
+  // Create from Mojo struct
+  static ScheduleConfig FromMojo(const dashboard::mojom::ScheduleConfig& mojo);
+
+  // Calculate total interval in milliseconds
+  int64_t GetIntervalMs() const;
+
+  // Check if schedule is valid (has non-zero interval)
+  bool IsValid() const;
+};
+
+// Information about a scheduled script
+struct ScheduledScriptInfo {
+  ScheduledScriptInfo();
+  ~ScheduledScriptInfo();
+
+  ScheduledScriptInfo(const ScheduledScriptInfo&);
+  ScheduledScriptInfo& operator=(const ScheduledScriptInfo&);
+
+  std::string script_id;
+  std::string script_name;
+  ScheduleConfig schedule;
+  bool is_paused = false;
+  bool has_error = false;
+  std::string last_error;
+  base::Time last_run;
+
+  // Convert to Mojo struct
+  dashboard::mojom::ScheduledScriptInfoPtr ToMojo() const;
+};
+
+// Manages scheduled script execution
+class SchedulerService {
+ public:
+  using ExecutionCallback = base::OnceCallback<void(bool success, const std::string& error)>;
+
+  explicit SchedulerService(Profile* profile, Dashboard* dashboard);
+  ~SchedulerService();
+
+  SchedulerService(const SchedulerService&) = delete;
+  SchedulerService& operator=(const SchedulerService&) = delete;
+
+  // Schedule management
+  bool SetScriptSchedule(const std::string& script_id,
+                         const ScheduleConfig& config,
+                         std::string* error);
+  std::vector<ScheduledScriptInfo> GetScheduledScripts() const;
+  bool PauseScheduledScript(const std::string& script_id, std::string* error);
+  bool ResumeScheduledScript(const std::string& script_id, std::string* error);
+  bool RunScheduledScriptNow(const std::string& script_id, std::string* error);
+  bool ClearScriptSchedule(const std::string& script_id, std::string* error);
+
+  // Persistence
+  void LoadSchedulesFromDisk();
+  void SaveSchedulesToDisk();
+
+ private:
+  struct ScheduledScript {
+    ScheduledScript();
+    ~ScheduledScript();
+
+    ScheduledScript(const ScheduledScript&) = delete;
+    ScheduledScript& operator=(const ScheduledScript&) = delete;
+
+    ScheduledScriptInfo info;
+    std::unique_ptr<base::RepeatingTimer> timer;
+  };
+
+  // Timer callback - executes the scheduled script
+  void OnTimerFired(const std::string& script_id);
+
+  // Execution completion callback
+  void OnScriptExecutionComplete(const std::string& script_id,
+                                  bool success,
+                                  const std::string& error);
+
+  // Schedule the next run for a script
+  void ScheduleNextRun(const std::string& script_id);
+
+  // Calculate next run time based on interval
+  base::Time CalculateNextRunTime(const ScheduleConfig& config) const;
+
+  // Get script name from dashboard
+  std::string GetScriptName(const std::string& script_id) const;
+
+  // Validate schedule configuration
+  bool ValidateSchedule(const ScheduleConfig& config, std::string* error) const;
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<Dashboard> dashboard_;
+  // TODO: Add ScriptExecutor when needed for actual execution
+
+  // Map of script_id -> ScheduledScript
+  std::map<std::string, ScheduledScript> scheduled_scripts_;
+
+  base::WeakPtrFactory<SchedulerService> weak_ptr_factory_{this};
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_SCHEDULER_SERVICE_H_
+
diff --git a/chrome/browser/ui/webui/dashboard/script_context.cc b/chrome/browser/ui/webui/dashboard/script_context.cc
new file mode 100644
index 0000000000000000000000000000000000000000..4d23dac2c37c69c0c8bfe5779122429eb22331de
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/script_context.cc
@@ -0,0 +1,208 @@
+#include "chrome/browser/ui/webui/dashboard/script_context.h"
+
+#include <algorithm>
+
+#include "base/logging.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/public/common/isolated_world_ids.h"
+#include "url/origin.h"
+
+namespace dashboard {
+
+// ---------------------------------------------------------------------------
+// ScriptContext::Observer
+// ---------------------------------------------------------------------------
+
+ScriptContext::Observer::Observer(content::WebContents* contents,
+                                  ScriptContext* owner)
+    : content::WebContentsObserver(contents), owner_(owner) {}
+
+ScriptContext::Observer::~Observer() = default;
+
+void ScriptContext::Observer::DidFinishNavigation(
+    content::NavigationHandle* navigation) {
+  if (!owner_)
+    return;
+  owner_->OnNavigationFinished(web_contents(), navigation);
+}
+
+void ScriptContext::Observer::WebContentsDestroyed() {
+  if (!owner_)
+    return;
+  owner_->OnWebContentsDestroyed(web_contents());
+}
+
+void ScriptContext::Observer::DidOpenRequestedURL(
+    content::WebContents* new_contents,
+    content::RenderFrameHost* source_render_frame_host,
+    const GURL& url,
+    const content::Referrer& referrer,
+    WindowOpenDisposition disposition,
+    ui::PageTransition transition,
+    bool started_from_context_menu,
+    bool renderer_initiated) {
+  if (!owner_ || !new_contents)
+    return;
+  owner_->OnPopupOpened(new_contents);
+}
+
+// ---------------------------------------------------------------------------
+// ScriptContext
+// ---------------------------------------------------------------------------
+
+ScriptContext::ScriptContext(const std::string& script_id,
+                             content::WebContents* main_contents)
+    : script_id_(script_id),
+      main_web_contents_(main_contents),
+      current_target_(main_contents) {
+  if (main_contents)
+    AttachObserver(main_contents);
+  if (current_target_) {
+    current_url_ = current_target_->GetLastCommittedURL().spec();
+    is_loaded_ = !current_url_.empty();
+  }
+}
+
+ScriptContext::~ScriptContext() {
+  popups_.clear();
+  observers_.clear();
+}
+
+void ScriptContext::AttachObserver(content::WebContents* contents) {
+  if (!contents || observers_.find(contents) != observers_.end())
+    return;
+  observers_.emplace(contents,
+                     std::make_unique<Observer>(contents, /*owner=*/this));
+}
+
+void ScriptContext::DetachObserver(content::WebContents* contents) {
+  if (!contents)
+    return;
+  observers_.erase(contents);
+}
+
+
+base::Value::Dict* ScriptContext::mutable_script_data() {
+  return &script_data_;
+}
+bool ScriptContext::ContainsWebContents(content::WebContents* contents) const {
+  if (!contents)
+    return false;
+  if (contents == main_web_contents_)
+    return true;
+  return std::find(popups_.begin(), popups_.end(), contents) != popups_.end();
+}
+
+void ScriptContext::SwitchToTarget(content::WebContents* target) {
+  if (!target)
+    return;
+  AttachObserver(target);
+  current_target_ = target;
+  current_url_ = target->GetLastCommittedURL().spec();
+  is_loaded_ = !current_url_.empty();
+  LOG(INFO) << "[ScriptContext] switch target to "
+            << (current_url_.empty() ? "<pending>" : current_url_);
+}
+
+void ScriptContext::RegisterPopup(content::WebContents* popup) {
+  if (!popup)
+    return;
+  if (!ContainsWebContents(popup))
+    popups_.push_back(popup);
+  AttachObserver(popup);
+  SwitchToTarget(popup);
+}
+
+void ScriptContext::CloseAllPopups() {
+  for (auto* popup : popups_) {
+    if (popup && !popup->IsBeingDestroyed()) {
+      popup->ClosePage();
+    }
+    DetachObserver(popup);
+  }
+  popups_.clear();
+  if (current_target_ && current_target_ != main_web_contents_)
+    current_target_ = nullptr;
+  EnsurePrimaryTarget();
+}
+
+// Minimal placeholder implementation to satisfy linker.
+// Later this may become the place to inject an automation id script into same-origin frames.
+void ScriptContext::TryPreInjectAutomationId(content::RenderFrameHost* rfh) {
+  if (!rfh)
+    return;
+
+  // Avoid heavy logic here: just log a diagnostic. If you want to implement
+  // real JS injection, do it here (run in isolated world, check same-origin, etc.)
+  LOG(INFO) << "[ScriptContext] TryPreInjectAutomationId called for RFH="
+            << reinterpret_cast<void*>(rfh);
+
+  // Example future implementation outline (commented):
+  // 1) Verify rfh->GetLastCommittedURL().IsStandard() && same-origin as main_web_contents_
+  // 2) Use content::ExecJs or frame->ExecuteJavaScript to set window.__automationId = <id>
+  // 3) Use isolated world if needed to avoid polluting page JS context
+}
+
+void ScriptContext::OnNavigationFinished(content::WebContents* source,
+                                         content::NavigationHandle* navigation) {
+  if (!navigation || !navigation->HasCommitted())
+    return;
+
+  // Pre-inject automation id for same-origin frames at commit time
+  if (content::RenderFrameHost* rfh = navigation->GetRenderFrameHost()) {
+    TryPreInjectAutomationId(rfh);
+  }
+
+  const std::string url_spec = navigation->GetURL().spec();
+  if (source == current_target_) {
+    current_url_ = url_spec;
+    is_loaded_ = true;
+    LOG(INFO) << "[ScriptContext] navigation committed for current target: "
+              << url_spec;
+  } else if (!ContainsWebContents(source)) {
+    // If we see a commit for an untracked WebContents, treat it as popup.
+    RegisterPopup(source);
+    current_url_ = url_spec;
+  }
+}
+
+void ScriptContext::OnWebContentsDestroyed(content::WebContents* contents) {
+  if (!contents)
+    return;
+
+  DetachObserver(contents);
+
+  if (contents == main_web_contents_) {
+    main_web_contents_ = nullptr;
+  } else {
+    auto it = std::remove(popups_.begin(), popups_.end(), contents);
+    if (it != popups_.end())
+      popups_.erase(it, popups_.end());
+  }
+
+  if (contents == current_target_) {
+    current_target_ = nullptr;
+    EnsurePrimaryTarget();
+  }
+}
+
+void ScriptContext::OnPopupOpened(content::WebContents* new_contents) {
+  RegisterPopup(new_contents);
+}
+
+void ScriptContext::EnsurePrimaryTarget() {
+  if (current_target_)
+    return;
+
+  if (main_web_contents_) {
+    SwitchToTarget(main_web_contents_);
+    return;
+  }
+
+  if (!popups_.empty()) {
+    SwitchToTarget(popups_.back());
+  }
+}
+
+}  // namespace dashboard
