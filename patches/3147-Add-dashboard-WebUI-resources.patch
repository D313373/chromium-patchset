+bool MaybeBool(const base::Value::Dict& dict, const std::string& key) {
+  return dict.FindBool(key).value_or(false);
+}
+// (moved active-pointer and methods out of anonymous namespace below)
+
+float MaybeFloat(const base::Value::Dict& dict, const std::string& key) {
+  return static_cast<float>(dict.FindDouble(key).value_or(0.0));
+}
+
+base::Value::List LocatorBundleToList(
+    const std::vector<dashboard::mojom::LocatorPtr>& locators) {
+  base::Value::List list;
+  for (const auto& l : locators) {
+    base::Value::Dict d;
+    d.Set("type", l->type);
+    d.Set("value", l->value);
+    list.Append(std::move(d));
+  }
+  return list;
+}
+
+base::Value::Dict AgentElementToValue(
+    const dashboard::mojom::AgentElementInfo& info) {
+  base::Value::Dict d;
+  d.Set("id", info.id);
+  if (!info.frame_token.empty())
+    d.Set("frameToken", info.frame_token);
+  if (!info.tag.empty())
+    d.Set("tag", info.tag);
+  if (!info.role.empty())
+    d.Set("role", info.role);
+  if (!info.accessibility_name.empty())
+    d.Set("accessibilityName", info.accessibility_name);
+  if (!info.text.empty())
+    d.Set("text", info.text);
+  if (!info.id_attr.empty())
+    d.Set("idAttr", info.id_attr);
+  if (!info.class_attr.empty())
+    d.Set("classAttr", info.class_attr);
+  if (!info.name_attr.empty())
+    d.Set("nameAttr", info.name_attr);
+  if (!info.css_selector.empty())
+    d.Set("cssSelector", info.css_selector);
+  if (!info.xpath.empty())
+    d.Set("xpath", info.xpath);
+  if (!info.shadow_chain_selector.empty())
+    d.Set("shadowChainSelector", info.shadow_chain_selector);
+  if (!info.resource_path.empty())
+    d.Set("resourcePath", info.resource_path);
+  d.Set("x", info.x);
+  d.Set("y", info.y);
+  d.Set("width", info.width);
+  d.Set("height", info.height);
+  d.Set("visible", info.visible);
+  d.Set("clickable", info.clickable);
+  d.Set("focusable", info.focusable);
+  d.Set("editable", info.editable);
+  d.Set("disabled", info.disabled);
+  d.Set("inShadowTree", info.in_shadow_tree);
+  return d;
+}
+
+base::Value::Dict AgentSnapshotToValue(
+    const dashboard::mojom::AgentStateSnapshot& snapshot) {
+  base::Value::Dict out;
+  if (!snapshot.url.empty())
+    out.Set("url", snapshot.url);
+  if (!snapshot.frame_token.empty())
+    out.Set("frame_token", snapshot.frame_token);
+  out.Set("timestamp", snapshot.timestamp_ms);
+  out.Set("viewportWidth", snapshot.viewport_width);
+  out.Set("viewportHeight", snapshot.viewport_height);
+  out.Set("scrollX", snapshot.scroll_x);
+  out.Set("scrollY", snapshot.scroll_y);
+  base::Value::List elements;
+  for (const auto& element : snapshot.elements) {
+    if (element)
+      elements.Append(AgentElementToValue(*element));
+  }
+  out.Set("elements", std::move(elements));
+  return out;
+}
+
+std::optional<base::Value> ExtractRuntimeValue(const std::string& res_json) {
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      res_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed || !parsed->is_dict())
+    return std::nullopt;
+  const base::Value::Dict& root = parsed->GetDict();
+  const base::Value::Dict* result = root.FindDict("result");
+  if (!result)
+    return std::nullopt;
+  const base::Value::Dict* inner = result->FindDict("result");
+  const base::Value* value =
+      inner ? inner->Find("value") : result->Find("value");
+  if (!value)
+    return std::nullopt;
+  return value->Clone();
+}
+
+const dashboard::mojom::AgentElementInfo* FindBestElementMatch(
+    const dashboard::mojom::AgentStateSnapshot* snapshot,
+    const base::Value::Dict& click) {
+  if (!snapshot)
+    return nullptr;
+
+  const std::string* frame_id = click.FindString("frame_id");
+  const std::string* shadow = click.FindString("shadow_chain");
+  const std::string* css = click.FindString("css");
+  const std::string* xpath = click.FindString("xpath");
+  std::optional<double> x = click.FindDouble("x");
+  std::optional<double> y = click.FindDouble("y");
+
+  int best_score = -1;
+  const dashboard::mojom::AgentElementInfo* best = nullptr;
+  for (const auto& el_ptr : snapshot->elements) {
+    if (!el_ptr)
+      continue;
+    const auto& el = *el_ptr;
+    int score = 0;
+    if (frame_id && !frame_id->empty() && el.frame_token == *frame_id)
+      score += 5;
+    if (shadow && !shadow->empty() && el.shadow_chain_selector == *shadow)
+      score += 4;
+    if (css && !css->empty() && el.css_selector == *css)
+      score += 3;
+    if (xpath && !xpath->empty() && el.xpath == *xpath)
+      score += 2;
+    if (x && y) {
+      gfx::RectF bounds(el.x, el.y, el.width, el.height);
+      if (bounds.Contains(static_cast<float>(*x), static_cast<float>(*y)))
+        score += 3;
+    }
+    if (score > best_score && score > 0) {
+      best_score = score;
+      best = el_ptr.get();
+    }
+  }
+  return best;
+}
+// Make overlay 20% wider and ~3x taller to host timeline + AI panel.
+// Align initial widget size with overlay card CSS (360px wide) to avoid a
+// visible resize jump after DOM loads.
+constexpr int kOverlayWidth = 360;
+constexpr int kOverlayHeight = 520;
+constexpr int kOverlayMargin = 12;  // Distance from window edges.
+}  // namespace
+
+// Static singleton pointer for the active recorder.
+static RecorderController* g_active_recorder = nullptr;
+
+RecorderController::RecorderController() = default;
+RecorderController::~RecorderController() {
+  // Ensure overlay WebContents/widgets are torn down before profile shutdown.
+  CloseOverlay();
+}
