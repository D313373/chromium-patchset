+                            const std::string& status);
+  void ExecuteListenerScript(const std::string& listener_script_id);
+  std::vector<base::Value::Dict> GetListenerScripts();
+
+ private:
+  friend class DashboardHandler;
+
+  // Data members restored from your original design
+  std::unordered_map<std::string, base::Value::Dict> scripts_;
+  std::unordered_map<std::string, std::string> variables_;
+  std::unordered_map<std::string, std::vector<std::vector<std::string>>>
+      tables_;
+  std::unordered_map<std::string, ListenerScript> listener_scripts_;
+  std::unordered_map<std::string, std::vector<ActionLog>> script_action_logs_;
+};
+
+}  // namespace dashboard
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DASHBOARD_DASHBOARD_H_
+
