diff --git a/chrome/browser/ui/webui/dashboard/actions/key_down_action.cc b/chrome/browser/ui/webui/dashboard/actions/key_down_action.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e64728f067aea89df53dc30d26a67bb4344819c4
--- /dev/null
+++ b/chrome/browser/ui/webui/dashboard/actions/key_down_action.cc
@@ -0,0 +1,211 @@
+#include "chrome/browser/ui/webui/dashboard/actions/key_down_action.h"
+
+#include "base/logging.h"
+#include "chrome/browser/ui/webui/dashboard/debug_config.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_keyboard_event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+KeyDownAction::KeyDownAction(Profile* profile) 
+    : dashboard::actions::Action(profile) {}
+
+KeyDownAction::~KeyDownAction() = default;
+
+bool KeyDownAction::SetParams(const base::Value::Dict& params) {
+  const std::string* key = params.FindString("key");
+  if (!key) {
+    return false;  // key is required
+  }
+  key_ = *key;
+  
+  // Get modifiers array
+  const base::Value::List* mods = params.FindList("modifiers");
+  if (mods) {
+    for (const auto& mod : *mods) {
+      if (mod.is_string()) {
+        modifiers_.push_back(mod.GetString());
+      }
+    }
+  }
+  
+  // Optional explicit key code
+  std::optional<int> kc = params.FindInt("keyCode");
+  if (kc.has_value()) {
+    key_code_ = *kc;
+  }
+  SetSerializedAction("key_down", params.Clone());
+  return true;
+}
+
+void KeyDownAction::Execute(content::WebContents* web_contents,
+                              Callback callback) {
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[KeyDownAction] Executing key='" << key_ << "' with " 
+              << modifiers_.size() << " modifiers";
+  }
+
+  if (!web_contents) {
+    std::move(callback).Run(false, "No web contents");
+    return;
+  }
+
+  content::RenderWidgetHost* rwh =
+      web_contents->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  if (!rwh) {
+    std::move(callback).Run(false, "No render widget host");
+    return;
+  }
+
+  content::RenderWidgetHostView* rwhv = rwh->GetView();
+  if (!rwhv) {
+    std::move(callback).Run(false, "No render widget host view");
+    return;
+  }
+
+  // Convert modifiers to blink modifier flags
+  int modifier_flags = blink::WebInputEvent::kNoModifiers;
+  for (const auto& mod : modifiers_) {
+    if (mod == "ctrl") {
+      modifier_flags |= blink::WebInputEvent::kControlKey;
+    } else if (mod == "shift") {
+      modifier_flags |= blink::WebInputEvent::kShiftKey;
+    } else if (mod == "alt") {
+      modifier_flags |= blink::WebInputEvent::kAltKey;
+    } else if (mod == "meta") {
+      modifier_flags |= blink::WebInputEvent::kMetaKey;
+    }
+  }
+
+  // Map key string to virtual key code
+  int vkey = 0;
+  
+  if (key_code_ != 0) {
+    // Use explicit key code if provided
+    vkey = key_code_;
+  } else if (key_.length() == 1) {
+    // Single character key
+    char ch = key_[0];
+    if (ch >= 'a' && ch <= 'z') {
+      vkey = ui::VKEY_A + (ch - 'a');
+    } else if (ch >= 'A' && ch <= 'Z') {
+      vkey = ui::VKEY_A + (ch - 'A');
+    } else if (ch >= '0' && ch <= '9') {
+      vkey = ui::VKEY_0 + (ch - '0');
+    } else {
+      // Special single characters
+      switch (ch) {
+        case ' ': vkey = ui::VKEY_SPACE; break;
+        case '-': vkey = ui::VKEY_OEM_MINUS; break;
+        case '=': vkey = ui::VKEY_OEM_PLUS; break;
+        case '[': vkey = ui::VKEY_OEM_4; break;
+        case ']': vkey = ui::VKEY_OEM_6; break;
+        case '\\': vkey = ui::VKEY_OEM_5; break;
+        case ';': vkey = ui::VKEY_OEM_1; break;
+        case '\'': vkey = ui::VKEY_OEM_7; break;
+        case ',': vkey = ui::VKEY_OEM_COMMA; break;
+        case '.': vkey = ui::VKEY_OEM_PERIOD; break;
+        case '/': vkey = ui::VKEY_OEM_2; break;
+        case '`': vkey = ui::VKEY_OEM_3; break;
+        default:
+          std::move(callback).Run(false, "Unknown key character: " + key_);
+          return;
+      }
+    }
+  } else {
+    // Named keys
+    if (key_ == "Enter" || key_ == "Return") {
+      vkey = ui::VKEY_RETURN;
+    } else if (key_ == "Tab") {
+      vkey = ui::VKEY_TAB;
+    } else if (key_ == "Escape" || key_ == "Esc") {
+      vkey = ui::VKEY_ESCAPE;
+    } else if (key_ == "Backspace") {
+      vkey = ui::VKEY_BACK;
+    } else if (key_ == "Delete") {
+      vkey = ui::VKEY_DELETE;
+    } else if (key_ == "ArrowUp") {
+      vkey = ui::VKEY_UP;
+    } else if (key_ == "ArrowDown") {
+      vkey = ui::VKEY_DOWN;
+    } else if (key_ == "ArrowLeft") {
+      vkey = ui::VKEY_LEFT;
+    } else if (key_ == "ArrowRight") {
+      vkey = ui::VKEY_RIGHT;
+    } else if (key_ == "Home") {
+      vkey = ui::VKEY_HOME;
+    } else if (key_ == "End") {
+      vkey = ui::VKEY_END;
+    } else if (key_ == "PageUp") {
+      vkey = ui::VKEY_PRIOR;
+    } else if (key_ == "PageDown") {
+      vkey = ui::VKEY_NEXT;
+    } else if (key_ == "F1") {
+      vkey = ui::VKEY_F1;
+    } else if (key_ == "F2") {
+      vkey = ui::VKEY_F2;
+    } else if (key_ == "F3") {
+      vkey = ui::VKEY_F3;
+    } else if (key_ == "F4") {
+      vkey = ui::VKEY_F4;
+    } else if (key_ == "F5") {
+      vkey = ui::VKEY_F5;
+    } else if (key_ == "F6") {
+      vkey = ui::VKEY_F6;
+    } else if (key_ == "F7") {
+      vkey = ui::VKEY_F7;
+    } else if (key_ == "F8") {
+      vkey = ui::VKEY_F8;
+    } else if (key_ == "F9") {
+      vkey = ui::VKEY_F9;
+    } else if (key_ == "F10") {
+      vkey = ui::VKEY_F10;
+    } else if (key_ == "F11") {
+      vkey = ui::VKEY_F11;
+    } else if (key_ == "F12") {
+      vkey = ui::VKEY_F12;
+    } else {
+      std::move(callback).Run(false, "Unknown key name: " + key_);
+      return;
+    }
+  }
+
+  // Create keyboard event
+  blink::WebKeyboardEvent event(
+      blink::WebInputEvent::Type::kRawKeyDown,
+      modifier_flags,
+      base::TimeTicks::Now());
+  
+  event.windows_key_code = vkey;
+  event.native_key_code = vkey;
+  
+  // Set the text field for printable characters (needed for some shortcuts)
+  if (key_.length() == 1 && key_[0] >= 32 && key_[0] <= 126) {
+    event.text[0] = key_[0];
+    event.unmodified_text[0] = key_[0];
+  }
+
+  // Send the keyboard event
+  input::NativeWebKeyboardEvent native_event(event, rwhv->GetNativeView());
+  rwh->ForwardKeyboardEvent(native_event);
+
+  // Also send KeyUp event to complete the key press
+  blink::WebKeyboardEvent up_event(
+      blink::WebInputEvent::Type::kKeyUp,
+      modifier_flags,
+      base::TimeTicks::Now());
+  up_event.windows_key_code = vkey;
+  up_event.native_key_code = vkey;
+  
+  input::NativeWebKeyboardEvent native_up_event(up_event, rwhv->GetNativeView());
+  rwh->ForwardKeyboardEvent(native_up_event);
+
+  if (dashboard::IsVerboseLoggingEnabled()) {
+    LOG(INFO) << "[KeyDownAction] Successfully sent keyboard shortcut";
+  }
+
+  std::move(callback).Run(true, "");
+}
