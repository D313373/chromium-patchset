+// chrome/browser/ui/webui/dashboard/click_handler.cc
+#include "chrome/browser/ui/webui/dashboard/click_handler.h"
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/run_loop.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/webui/dashboard/actions/element_readiness_checker.h"
+#include "chrome/browser/ui/webui/dashboard/click_handler.h"  // header
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/public/common/input/web_gesture_event.h"
+#include "content/public/common/isolated_world_ids.h"
+#include "base/time/time.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "chrome/browser/ui/webui/dashboard/debug_config.h"
+
+#include <random>
+#include <algorithm>
+
+namespace dashboard {
+
+namespace {
+
+// Random helpers
+double RandomDouble(double min, double max) {
+  static std::mt19937 rng(std::random_device{}());
+  std::uniform_real_distribution<double> dist(min, max);
+  return dist(rng);
+}
+
+double Lerp(double a, double b, double t) {
+  return a + (b - a) * t;
+}
+
+// Base jitter is now runtime-configurable via debug_config getters.
+
+}  // namespace
+
+ClickHandler::ClickHandler(content::WebContents* web_contents)
+    : web_contents_(web_contents), cursorX_(-1), cursorY_(-1) {}
+
+ClickHandler::~ClickHandler() = default;
+
+bool ClickHandler::ExecuteClick(
+    const std::vector<dashboard::Locator>& locators,
+    int wait_timeout_ms,
+    bool use_human_offset,
+    int click_count) {
+  dashboard::Element element;
+  if (!ResolveElement(locators, element)) {
+    return false;
+  }
+
+  ElementReadinessChecker checker(web_contents_);
+  if (!checker.WaitForElementToBeClickable(element, wait_timeout_ms)) {
+    return false;
+  }
+
+  // Obtain RenderWidgetHost for injection
+  content::RenderWidgetHost* rwh =
+      web_contents_->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  if (!rwh)
+    return false;
+
+  // Compute target center (client coordinates from JS)
+  int clientX = element.positionX + (use_human_offset ? static_cast<int>(RandomDouble(-5, 5)) : 0);
+  int clientY = element.positionY + (use_human_offset ? static_cast<int>(RandomDouble(-5, 5)) : 0);
+  // Clamp to non-negative to avoid injecting off-screen
+  clientX = std::max(0, clientX);
+  clientY = std::max(0, clientY);
+
+  // Transform to root/screen coordinates for SetPositionInScreen; keep widget
+  // coordinates aligned with the view (client) space for SetPositionInWidget.
+  int targetX = clientX;
+  int targetY = clientY;
+  if (auto* rwhv = rwh->GetView()) {
+    gfx::PointF root_point = rwhv->TransformPointToRootCoordSpaceF(gfx::PointF(clientX, clientY));
+    // Update screen position variables if transformation is supported.
+    targetX = static_cast<int>(clientX);
+    targetY = static_cast<int>(clientY);
+
+    // We'll use root_point for screen coordinates below.
+    // Note: widget coords remain in the view's coordinate space (client).
+
+    // Initialize cursor if needed before movement using widget coords
+    if (cursorX_ < 0 || cursorY_ < 0) {
+      cursorX_ = targetX;
+      cursorY_ = targetY;
+    }
+
+    LOG(INFO) << "[ClickHandler] Inject mouse at widget=(" << targetX << "," << targetY
+              << ") screen=(" << static_cast<int>(root_point.x()) << "," << static_cast<int>(root_point.y()) << ")";
+    // Clamp to non-negative widget coords to avoid off-screen injection.
+    if (targetX < 0) targetX = 0;
+    if (targetY < 0) targetY = 0;
+    LOG(INFO) << "[ClickHandler] Inject mouse at widget=(" << targetX << "," << targetY
+              << ") screen=(" << static_cast<int>(root_point.x()) << "," << static_cast<int>(root_point.y()) << ")";
+    MoveCursorHumanLike(cursorX_, cursorY_, targetX, targetY);
+
+    // Micro hover jitter near the target to avoid always pressing at the exact
+    // same coordinate and to emulate human settle before clicking.
+    {
+      int base = dashboard::GetClickMicroHoverMoves();
+      int micro_moves = std::max(0, base + static_cast<int>(RandomDouble(-1.0, 1.0)));
+      double radius = dashboard::GetClickMicroHoverRadiusPx();
+      for (int i = 0; i < micro_moves; ++i) {
+        int jx = targetX + static_cast<int>(RandomDouble(-radius, radius));
+        int jy = targetY + static_cast<int>(RandomDouble(-radius, radius));
+        gfx::PointF j_root = rwhv->TransformPointToRootCoordSpaceF(gfx::PointF(jx, jy));
+        blink::WebMouseEvent move_event(
+            blink::WebInputEvent::Type::kMouseMove, blink::WebInputEvent::kNoModifiers,
+            base::TimeTicks::Now());
+        move_event.SetPositionInWidget(jx, jy);
+        move_event.SetPositionInScreen(static_cast<int>(j_root.x()), static_cast<int>(j_root.y()));
+        rwh->ForwardMouseEvent(move_event);
+      }
+    }
+
+    cursorX_ = targetX;
+    cursorY_ = targetY;
+
+    blink::WebMouseEvent mouse_event_down(
+        blink::WebInputEvent::Type::kMouseDown, blink::WebInputEvent::kNoModifiers,
+        base::TimeTicks::Now());
+    mouse_event_down.button = blink::WebMouseEvent::Button::kLeft;
+    mouse_event_down.SetPositionInWidget(targetX, targetY);
+    mouse_event_down.SetPositionInScreen(static_cast<int>(root_point.x()), static_cast<int>(root_point.y()));
+    mouse_event_down.click_count = click_count;
+
+    rwh->ForwardMouseEvent(mouse_event_down);
+
+    blink::WebMouseEvent mouse_event_up = mouse_event_down;
+    mouse_event_up.SetType(blink::WebInputEvent::Type::kMouseUp);
+    rwh->ForwardMouseEvent(mouse_event_up);
+
+    // Note: avoid injecting synthetic gesture tap events to prevent potential
+    // gesture-router state mismatches in debug builds (DCHECKs around scroll state).
+
+    return true;
+  }
+
+  // Initialize cursor position if we don't have one yet. To avoid huge jumps from uninitialized memory,
+  // we set the first "current cursor" to the element center. After this, cursorX_/cursorY_ persist.
+  return false;
+}
+
+bool ClickHandler::ExecuteClickAt(int center_x,
+                                  int center_y,
+                                  bool use_human_offset,
+                                  int click_count) {
+  if (!web_contents_)
+    return false;
+
+  content::RenderWidgetHost* rwh =
+      web_contents_->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  if (!rwh)
+    return false;
+
+  int clientX = center_x + (use_human_offset ? static_cast<int>(RandomDouble(-5, 5)) : 0);
+  int clientY = center_y + (use_human_offset ? static_cast<int>(RandomDouble(-5, 5)) : 0);
+  // Clamp to non-negative to avoid injecting off-screen
+  clientX = std::max(0, clientX);
+  clientY = std::max(0, clientY);
+  auto* rwhv = rwh->GetView();
+  if (!rwhv) return false;
+  gfx::PointF root_point = rwhv->TransformPointToRootCoordSpaceF(gfx::PointF(clientX, clientY));
+
+  int targetX = clientX;
+  int targetY = clientY;
+
+  if (cursorX_ < 0 || cursorY_ < 0) {
+    cursorX_ = targetX;
+    cursorY_ = targetY;
+  }
+
+  // Ensure the view has focus before pointer injection
+  if (auto* view = web_contents_->GetRenderWidgetHostView()) {
+    view->Focus();
+  } else {
+    web_contents_->Focus();
+  }
+
+  LOG(INFO) << "[ClickHandler] Inject mouse at widget=(" << targetX << "," << targetY
+            << ") screen=(" << static_cast<int>(root_point.x()) << "," << static_cast<int>(root_point.y()) << ")";
+  if (targetX < 0) targetX = 0;
+  if (targetY < 0) targetY = 0;
+  LOG(INFO) << "[ClickHandler] Inject mouse at widget=(" << targetX << "," << targetY
+            << ") screen=(" << static_cast<int>(root_point.x()) << "," << static_cast<int>(root_point.y()) << ")";
+  MoveCursorHumanLike(cursorX_, cursorY_, targetX, targetY);
+
+  // Micro hover jitter near the target prior to press to avoid deterministic
+  // center clicks.
+  {
+    int base = dashboard::GetClickMicroHoverMoves();
+    int micro_moves = std::max(0, base + static_cast<int>(RandomDouble(-1.0, 1.0)));
+    double radius = dashboard::GetClickMicroHoverRadiusPx();
+    for (int i = 0; i < micro_moves; ++i) {
+      int jx = targetX + static_cast<int>(RandomDouble(-radius, radius));
+      int jy = targetY + static_cast<int>(RandomDouble(-radius, radius));
+      gfx::PointF j_root = rwhv->TransformPointToRootCoordSpaceF(gfx::PointF(jx, jy));
+      blink::WebMouseEvent move_event(
+          blink::WebInputEvent::Type::kMouseMove, blink::WebInputEvent::kNoModifiers,
+          base::TimeTicks::Now());
+      move_event.SetPositionInWidget(jx, jy);
+      move_event.SetPositionInScreen(static_cast<int>(j_root.x()), static_cast<int>(j_root.y()));
+      // movementX/Y to aid sites relying on these values
+      move_event.movement_x = jx - cursorX_;
+      move_event.movement_y = jy - cursorY_;
+      rwh->ForwardMouseEvent(move_event);
+      cursorX_ = jx; cursorY_ = jy;
+    }
+  }
+
+  // If the caller requested zero clicks, stop after moving / hovering.
+  // This supports hover-only semantics using ClickAction with click_count == 0
+  // without injecting any mouse down/up events.
+  if (click_count <= 0) {
+    cursorX_ = targetX;
+    cursorY_ = targetY;
+    return true;
+  }
+
+  // Final down/up at the target
+  blink::WebMouseEvent mouse_event_down(
+      blink::WebInputEvent::Type::kMouseDown, blink::WebInputEvent::kNoModifiers,
+      base::TimeTicks::Now());
+  mouse_event_down.button = blink::WebMouseEvent::Button::kLeft;
+  mouse_event_down.SetPositionInWidget(targetX, targetY);
+  mouse_event_down.SetPositionInScreen(static_cast<int>(root_point.x()), static_cast<int>(root_point.y()));
+  mouse_event_down.click_count = click_count;
+
+  rwh->ForwardMouseEvent(mouse_event_down);
+
+  blink::WebMouseEvent mouse_event_up = mouse_event_down;
+  mouse_event_up.SetType(blink::WebInputEvent::Type::kMouseUp);
+  rwh->ForwardMouseEvent(mouse_event_up);
+
+  return true;
+}
+
+void ClickHandler::MoveCursorHumanLike(int x0, int y0, int x1, int y1) {
+  content::RenderWidgetHost* rwh =
+      web_contents_ ? web_contents_->GetPrimaryMainFrame()->GetRenderWidgetHost()
+                    : nullptr;
+  if (!rwh)
+    return;
+
+  // Compute distance and steps; vary steps by distance (humans take more steps for longer moves).
+  const double dx = static_cast<double>(x1 - x0);
+  const double dy = static_cast<double>(y1 - y0);
+  const double dist = std::hypot(dx, dy);
+  int steps = std::clamp(static_cast<int>(dist / 15.0), 5, 15);
+
+  auto ease = [](double t) { return (t < 0.5) ? (2.0 * t * t) : (1.0 - std::pow(-2.0 * t + 2.0, 2.0) / 2.0); };
+
+  auto* view = rwh->GetView();
+  if (!view) return;
+  int prev_x = x0;
+  int prev_y = y0;
+  for (int i = 1; i <= steps; ++i) {
+    const double t = static_cast<double>(i) / steps;
+    const double et = ease(t);
+    // Micro tremor ~ 10Hz-like at small amplitude
+    const double tremor = 0.4 * std::sin(i * 0.9);
+    double step_jitter = dashboard::GetClickPathJitterPx();
+    int xi = static_cast<int>(Lerp(x0, x1, et) + RandomDouble(-step_jitter, step_jitter) + tremor);
+    int yi = static_cast<int>(Lerp(y0, y1, et) + RandomDouble(-step_jitter, step_jitter) + tremor);
+
+    gfx::PointF root = view->TransformPointToRootCoordSpaceF(gfx::PointF(xi, yi));
+
+    blink::WebMouseEvent move_event(
+        blink::WebInputEvent::Type::kMouseMove, blink::WebInputEvent::kNoModifiers,
+        base::TimeTicks::Now());
+    move_event.SetPositionInWidget(xi, yi);
+    move_event.SetPositionInScreen(static_cast<int>(root.x()), static_cast<int>(root.y()));
+    move_event.movement_x = xi - prev_x;
+    move_event.movement_y = yi - prev_y;
+    rwh->ForwardMouseEvent(move_event);
+    prev_x = xi; prev_y = yi;
+  }
+}
+
+bool ClickHandler::ResolveElement(
+    const std::vector<dashboard::Locator>& locators,
+    dashboard::Element& outElement) {
+  if (ResolveElementWithJavaScript(locators, outElement))
+    return true;
+  if (ResolveElementWithCDP(locators, outElement))
+    return true;
+  return false;
+}
+
+bool ClickHandler::ResolveElementWithJavaScript(
+    const std::vector<dashboard::Locator>& locators,
+    dashboard::Element& outElement) {
+  if (!web_contents_)
+    return false;
+
+  base::Value::List standardLocatorsList;
+  for (const auto& loc : locators) {
+    standardLocatorsList.Append(dashboard::LocatorToValue(loc));
+  }
+  if (standardLocatorsList.empty())
+    return false;
+
+  std::string locatorsJson;
+  base::JSONWriter::Write(standardLocatorsList, &locatorsJson);
+
+  // JS: finds first matching element, calls scrollIntoView, returns center coords.
+  const std::string jsFunction = R"(
+    (function(locators) {
+      function findFirstElement() {
+        for (const locator of locators) {
+          try {
+            let element = null;
+            switch (locator.type) {
+              case 'CSS_SELECTOR':
+                element = document.querySelector(locator.value);
+                break;
+              case 'XPATH':
+                element = document.evaluate(locator.value, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;
+                break;
+              case 'ID':
+                element = document.getElementById(locator.value);
+                break;
+              case 'LINK_TEXT':
+                element = document.evaluate(`//a[text()=\"${locator.value}\"]`, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;
+                break;
+              default:
+                break;
+            }
+            if (element) {
+              // Ensure element is in view
+              try { element.scrollIntoView({ block: 'center', inline: 'center', behavior: 'instant' }); } catch(e) {}
+              const rect = element.getBoundingClientRect();
+              const cx = rect.left + rect.width / 2;
+              const cy = rect.top + rect.height / 2;
+              return JSON.stringify({ x: cx, y: cy, left: rect.left, top: rect.top, width: rect.width, height: rect.height, tag: (element.tagName||''), id: (element.id||'') });
+            }
+          } catch(e) { continue; }
+        }
+        return null;
+      }
+      return findFirstElement();
+    })
+  )";
+
+  std::string finalScript = jsFunction + "(" + locatorsJson + ");";
+
+  base::Value result;
+  base::RunLoop runLoop;
+  content::RenderFrameHost* rfh = web_contents_->GetPrimaryMainFrame();
+  if (!rfh) return false;
+  GURL frame_url = rfh->GetLastCommittedURL();
+  if (frame_url.SchemeIs("chrome")) {
+    rfh->ExecuteJavaScript(
+        base::UTF8ToUTF16(finalScript),
+        base::BindOnce(
+            [](base::RunLoop* loop, base::Value* out_result,
+               base::Value script_result) {
+              *out_result = std::move(script_result);
+              loop->Quit();
+            },
+            &runLoop, &result));
+  } else {
+    rfh->ExecuteJavaScriptInIsolatedWorld(
+        base::UTF8ToUTF16(finalScript),
+        base::BindOnce(
+            [](base::RunLoop* loop, base::Value* out_result,
+               base::Value script_result) {
+              *out_result = std::move(script_result);
+              loop->Quit();
+            },
+            &runLoop, &result),
+        content::ISOLATED_WORLD_ID_CONTENT_END);
+  }
+  runLoop.Run();
+
+  if (!result.is_string())
+    return false;
+
+  std::optional<base::Value> parsedJson = base::JSONReader::Read(
+      result.GetString(), base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsedJson || !parsedJson->is_dict())
+    return false;
+
+  const base::Value::Dict& dict = parsedJson->GetDict();
+  std::optional<double> x = dict.FindDouble("x");
+  std::optional<double> y = dict.FindDouble("y");
+  std::optional<double> left = dict.FindDouble("left");
+  std::optional<double> top = dict.FindDouble("top");
+  std::optional<double> width = dict.FindDouble("width");
+  std::optional<double> height = dict.FindDouble("height");
+  const std::string* tag = dict.FindString("tag");
+  const std::string* id = dict.FindString("id");
+  if (x.has_value() && y.has_value()) {
+    outElement.positionX = static_cast<int>(x.value());
+    outElement.positionY = static_cast<int>(y.value());
+    LOG(INFO) << "[ClickHandler] Resolved center=(" << outElement.positionX << "," << outElement.positionY
+              << ") rect=(" << (left.value_or(0)) << "," << (top.value_or(0)) << ","
+              << (width.value_or(0)) << "x" << (height.value_or(0)) << ") tag=" << (tag?*tag:std::string())
+              << " id=" << (id?*id:std::string());
+    return true;
+  }
+  return false;
+}
+
+bool ClickHandler::ResolveElementWithCDP(
+    const std::vector<dashboard::Locator>& /*locators*/,
+    dashboard::Element& /*outElement*/) {
+  // Intentionally disabled to avoid synthetic/CDP input paths.
+  return false;
+}
+
+}  // namespace dashboard
