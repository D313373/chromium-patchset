# Vendored llama.cpp under third_party/llama_cpp/src (clone / symlink required).
# Multimodal: tools/mtmd (successor to examples/llava).

import("//build/config/compiler/compiler.gni")

declare_args() {
  llama_cpp_enabled = true
  llama_cpp_use_metal = false
  llama_cpp_use_vulkan = false
}

config("llama_cpp_config") {
  include_dirs = [
    "src/include",
    "src/ggml/include",
    "src/ggml/src",  # ggml-common.h, ggml-backend-impl.h, ggml-impl.h
    "src/ggml/src/ggml-cpu",
    "src/common",
    "src/tools/mtmd",
    "src/tools/mtmd/models",
    "src/vendor",
    "src",
    "src/src",
  ]
  defines = [
    "GGML_USE_CPU",
    "NDEBUG",
    # cmake normally injects these; provide stubs for Chromium GN builds.
    "GGML_VERSION=\"0.0.0-simulachrome\"",
    "GGML_COMMIT=\"simulachrome-vendor\"",
  ]
  if (is_mac && llama_cpp_use_metal) {
    defines += [ "GGML_USE_METAL" ]
  }
  if (llama_cpp_use_vulkan) {
    defines += [ "GGML_USE_VULKAN" ]
  }
}

config("llama_cpp_warnings") {
  # Disabling libc++ modules (via :exceptions) drops transitive stdlib
  # visibility; force-include so getenv/atoi resolve in llama headers.
  cflags = [
    "-include",
    "stdlib.h",
    "-include",
    "errno.h",
    "-include",
    "string.h",
    "-Wno-error",
  ]
  cflags_cc = [
    "-include",
    "cstdlib",
    "-include",
    "cerrno",
    "-include",
    "cstring",
  ]
  if (is_clang) {
    cflags += [
      "-Wno-unused-function",
      "-Wno-unused-variable",
      "-Wno-unused-but-set-variable",
      "-Wno-unused-parameter",
      "-Wno-conversion",
      "-Wno-sign-compare",
      "-Wno-shadow",
      "-Wno-thread-safety-analysis",
      "-Wno-implicit-fallthrough",
      "-Wno-unreachable-code-break",
      "-Wno-format",
      "-Wno-c++11-narrowing",
      "-Wno-exit-time-destructors",
      "-Wno-deprecated-declarations",
      "-Wno-deprecated",
    ]
  }
}

# llama.cpp uses throw + static locals; Chromium defaults forbid both.
# exceptions also disables libc++ modules (fixes Darwin getenv visibility).
template("llama_source_set") {
  source_set(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                             "public_configs",
                           ])
    configs -= [
      "//build/config/compiler:chromium_code",
      "//build/config/compiler:no_exceptions",
    ]
    configs += [
      "//build/config/compiler:no_chromium_code",
      "//build/config/compiler:exceptions",
      ":llama_cpp_warnings",  # includes -Wno-error after nested -Werror
    ]
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
    public_configs = [ ":llama_cpp_config" ]
    if (defined(invoker.public_configs)) {
      public_configs += invoker.public_configs
    }
  }
}

