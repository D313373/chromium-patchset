# Unit tests for dashboard schema
source_set("unit_tests") {
  testonly = true
  sources = [
    "agent_model_contract_unittest.cc",
    "script_schema_unittest.cc",
  ]
  deps = [
    ":dashboard",
    "//base",
    "//base/test:test_support",
