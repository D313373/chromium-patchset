import("//build/config/features.gni")
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "dashboard.mojom" ]
  webui_module_path = "/"

  # This line was missing. It tells the build system that your Mojo file
  # is allowed to import and use base types like ValueDict.
  public_deps = [ "//mojo/public/mojom/base" ]
}

